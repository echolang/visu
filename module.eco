/*
 * visu - game framework for Echo.
 *
 * Windowing and a compile-time GPU state protocol. OpenGL is the default
 * backend; --define VISU_BACKEND_METAL selects the Metal arm (Darwin).
 */

#[module: "visu"]
#[version: "0.1.0"]
#[requires: "echolang/libopengl" { version: "^0.1", source: git "https://github.com/echolang/libopengl" }]
#[requires: "echolang/libglfw" { version: "^0.1", source: git "https://github.com/echolang/libglfw" }]
#[requires: "echolang/libmetal" { version: "^0.1", source: git "https://github.com/echolang/libmetal" }]
#[requires: "echolang/libvulkan" { version: "^0.1", source: git "https://github.com/echolang/libvulkan" }]
#[epm::license: "MIT"]
#[epm::description: "VISU Game Framework for Echolang"]

#[sources: [
    "src/finite.eco",
    "src/math/*.eco",
    "src/geo/*.eco",
    "src/geo/primitive/*.eco",
    "src/os/*.eco",
    "src/app/*.eco",
    "src/runtime/*.eco",
    "src/quickstart/*.eco",
    "src/ecs/*.eco",
    "src/signal/*.eco",
    "src/graphics/*.eco",
    "src/graphics/renderer/*.eco",
    "src/graphics/pipeline/*.eco",
    "src/graphics/pipeline/pass/*.eco",
    "src/graphics/shader/*.eco",
    "src/graphics/shader/include/*.eco",
    "src/graphics/shader/include/functions/*.eco",
    "src/graphics/shader/include/pbr/*.eco"
]]

#[if: VISU_BACKEND_METAL]
#[sources: "src/graphics/metal/*.eco"]
#[cc: sources "src/graphics/metal/vsync.m"]
#[cc: flag "-fobjc-arc"]
#[link: framework "QuartzCore"]
#[else]
#[sources: "src/graphics/opengl/*.eco"]
#[end]

#[target: test] {
    #[sources: "tests/**/*.eco"]
}
