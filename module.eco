/*
 * visu - game framework for Echo.
 *
 * Windowing and a compile-time GPU device protocol. Metal is the
 * default on Darwin; --define VISU_BACKEND_VULKAN forces MoltenVK
 * there. Elsewhere Vulkan.
 */

#[module: "visu"]
#[version: "0.2.0"]
#[requires: "echolang/libglfw" { version: "^0.1", source: git "https://github.com/echolang/libglfw" }]
#[requires: "echolang/libmetal" { version: "^0.1", source: git "https://github.com/echolang/libmetal" }]
#[requires: "echolang/libvulkan" { version: "^0.1", source: git "https://github.com/echolang/libvulkan" }]
#[epm::license: "MIT"]
#[epm::description: "VISU Game Framework for Echolang"]

#[sources: [
    "src/finite.eco",
    "src/math/*.eco",
    "src/geo/*.eco",
    "src/geo/primitive/*.eco",
    "src/os/*.eco",
    "src/app/*.eco",
    "src/runtime/*.eco",
    "src/quickstart/*.eco",
    "src/ecs/*.eco",
    "src/signal/*.eco",
    "src/graphics/*.eco",
    "src/graphics/device/*.eco",
    "src/graphics/renderer/*.eco",
    "src/graphics/pipeline/*.eco",
    "src/graphics/pipeline/pass/*.eco",
    "src/graphics/shader/*.eco"
]]

#[if: os == darwin && !VISU_BACKEND_VULKAN]
#[sources: "src/graphics/metal/*.eco"]
#[cc: sources "src/graphics/metal/vsync.m"]
#[cc: flag "-fobjc-arc"]
#[link: framework "QuartzCore"]
#[else]
#[sources: "src/graphics/vulkan/*.eco"]
#[end]

#[target: test] {
    #[sources: [
        "tests/app/**/*.eco",
        "tests/ecs/*.eco",
        "tests/finite.eco",
        "tests/geo/**/*.eco",
        "tests/math/*.eco",
        "tests/os/*.eco",
        "tests/runtime/*.eco",
        "tests/signal/*.eco",
        "tests/graphics/adapter.eco",
        "tests/graphics/layout.eco",
        "tests/graphics/viewport.eco",
        "tests/graphics/gpucontext.eco",
        "tests/graphics/pipeline_create.eco",
        "tests/graphics/pipeline/pipeline.eco",
        "tests/graphics/pipeline/frame.eco",
        "tests/graphics/pipeline/clear.eco",
        "tests/graphics/pipeline/context.eco",
        "tests/graphics/pipeline/pool.eco",
        "tests/graphics/shader/collection.eco",
        "tests/graphics/shader/module.eco",
        "tests/graphics/uniformbuffer.eco",
        "tests/gpu/checks/*.eco",
        "tests/quickstart/*.eco"
    ]]
}
