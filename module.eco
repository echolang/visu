/*
 * visu - game framework for Echo.
 *
 * Windowing and a compile-time GPU device protocol. Metal is the
 * default on Darwin; --define VISU_BACKEND_VULKAN forces MoltenVK
 * there. Elsewhere Vulkan.
 */

#[module: "visu"]
#[version: "0.2.0"]
#[if: os != ios]
#[requires: "echolang/libglfw" { version: "^0.1", source: git "https://github.com/echolang/libglfw" }]
#[end]
#[if: os == ios || os == darwin]
#[requires: "echolang/libmetal" { version: "^0.2", source: git "https://github.com/echolang/libmetal" }]
#[end]
#[if: os != ios]
#[requires: "echolang/libvulkan" { version: "^0.1", source: git "https://github.com/echolang/libvulkan" }]
#[end]
#[requires: "echolang/libminiaudio" { version: "^0.1", source: git "https://github.com/echolang/libminiaudio" }]
#[depends: "../libjson"]
#[epm::license: "MIT"]
#[epm::description: "VISU Game Framework for Echolang"]

#[sources: [
    "src/finite.eco",
    "src/math/*.eco",
    "src/geo/*.eco",
    "src/geo/primitive/*.eco",
    "src/os/*.eco",
    "src/os/input/*.eco",
    "src/os/protocol/*.eco",
    "src/app/*.eco",
    "src/dcapture/*.eco",
    "src/asset/*.eco",
    "src/runtime/*.eco",
    "src/quickstart/*.eco",
    "src/ecs/*.eco", "src/components/*.eco", "src/system/*.eco", "src/scene/*.eco",
    "src/console/*.eco",
    "src/signal/*.eco",
    "src/graphics/*.eco", "src/graphics/camera/*.eco", "src/graphics/dca/*.eco", "src/graphics/deferred/*.eco",
    "src/graphics/gpu/*.eco",
    "src/graphics/device/*.eco",
    "src/graphics/device/protocol/*.eco",
    "src/graphics/image/*.eco",
    "src/graphics/renderer/*.eco",
    "src/graphics/pipeline/*.eco",
    "src/graphics/pipeline/pass/*.eco",
    "src/graphics/debug/*.eco",
    "src/graphics/model/*.eco",
    "src/graphics/shader/*.eco",
    "src/vg/*.eco",
    "src/vg/tess/*.eco",
    "src/vg/font/*.eco",
    "src/ui/*.eco",
    "src/instrument/*.eco",
    "src/instrument/font/*.eco",
    "src/profile/*.eco"
]]

#[sources: "src/audio/*.eco"]

#[cc: sources "src/vg/font/vgfont.c"]
#[cc: include "src/vg/font"]
#[cc: sources "src/instrument/font/debugfont.c"]
#[cc: include "src/instrument/font"]
#[cc: sources "src/graphics/image/image.c"]
#[cc: sources "src/graphics/image/compress.c"]
#[cc: include "src/graphics/image"]

#[if: os == ios]
#[sources: "src/os/ios/*.eco"]
#[cc: sources "src/os/ios/host.m"]
#[cc: sources "src/os/ios/boot.m"]
#[cc: flag "-fobjc-arc"]
#[link: framework "UIKit"]
#[link: framework "QuartzCore"]
#[link: framework "Metal"]
#[else]
#[sources: "src/os/glfw/*.eco"]
#[end]

#[if: os == darwin]
#[cc: sources "src/os/glfw/display.m"]
#[cc: flag "-fobjc-arc"]
#[link: framework "QuartzCore"]
#[link: framework "AppKit"]
#[link: framework "Metal"]
#[end]

#[if: os == ios || (os == darwin && !VISU_BACKEND_VULKAN)]
#[sources: "src/graphics/metal/*.eco"]
#[cc: flag "-fobjc-arc"]
#[link: framework "QuartzCore"]
#[link: framework "Metal"]
#[else]
#[sources: "src/graphics/vulkan/*.eco"]
#[end]

#[target: test] {
    #[sources: [
        "tests/app/**/*.eco",
        "tests/asset/*.eco",
        "tests/ecs/*.eco",
        "tests/finite.eco",
        "tests/geo/**/*.eco",
        "tests/dcapture/*.eco",
        "tests/math/*.eco",
        "tests/os/*.eco",
        "tests/os/input/*.eco",
        "tests/runtime/*.eco",
        "tests/scene/*.eco",
        "tests/signal/*.eco",
        "tests/system/*.eco",
        "tests/console/*.eco",
        "tests/components/*.eco",
        "tests/graphics/adapter.eco",
        "tests/graphics/resources.eco",
        "tests/graphics/psoevict.eco",
        "tests/graphics/texture_recycle.eco",
        "tests/graphics/material.eco",
        "tests/graphics/model/*.eco",
        "tests/graphics/deferred_view.eco",
        "tests/graphics/gbuffer_id.eco",
        "tests/graphics/sky.eco",
        "tests/graphics/fog.eco",
        "tests/graphics/shadow.eco",
        "tests/graphics/camera/*.eco",
        "tests/graphics/dca/*.eco",
        "tests/graphics/debug/*.eco",
        "tests/graphics/pixels.eco",
        "tests/graphics/hdrpixels.eco",
        "tests/graphics/layout.eco",
        "tests/graphics/viewport.eco",
        "tests/graphics/gpucontext.eco",
        "tests/graphics/pipeline_create.eco",
        "tests/graphics/pipeline/pipeline.eco",
        "tests/graphics/pipeline/frame.eco",
        "tests/graphics/pipeline/clear.eco",
        "tests/graphics/pipeline/context.eco",
        "tests/graphics/pipeline/pool.eco",
        "tests/graphics/shader/collection.eco",
        "tests/graphics/shader/module.eco",
        "tests/graphics/gpupass.eco",
        "tests/graphics/gpu_union.eco",
        "tests/graphics/uniformbuffer.eco",
        "tests/gpu/checks/*.eco",
        "tests/quickstart/*.eco",
        "tests/vg/*.eco",
        "tests/ui/*.eco",
        "tests/instrument/*.eco",
        "tests/profile/*.eco"
    ]]
    #[sources: "tests/audio/*.eco"]
}
