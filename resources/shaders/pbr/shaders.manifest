tonemap+filmic_local TONEMAP_METHOD=4 TONEMAP_LOCAL=1
tonemap+local TONEMAP_LOCAL=1
tonemap+neutral TONEMAP_METHOD=1
tonemap+neutral_local TONEMAP_METHOD=1 TONEMAP_LOCAL=1
tonemap+reinhard TONEMAP_METHOD=3
tonemap+reinhard_local TONEMAP_METHOD=3 TONEMAP_LOCAL=1
tonemap_blur+base TONEMAP_BLUR_BASE=1
tonemap_exposure+probe TONEMAP_PROBE=1
