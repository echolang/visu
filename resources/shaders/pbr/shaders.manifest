lightpass+env_cubemap USE_ENV_CUBEMAP=1
lightpass+env_cubemap_spot USE_ENV_CUBEMAP=1 VISU_SPOTS=1
lightpass+ibl USE_IBL=1
lightpass+ibl_spot USE_IBL=1 VISU_SPOTS=1
lightpass+spot VISU_SPOTS=1
model+parallax MODEL_PARALLAX=1
