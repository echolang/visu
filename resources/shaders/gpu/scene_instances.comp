#version 450

// visu::graphics::GpuScene, stage one: every (instance, view) pair whose world box meets the
// view and whose material casts. Picks the level from the play eye exactly as
// ModelSystem.levelAt does, then appends the level's cluster range as a pair
layout(local_size_x = 64, local_size_y = 1) in;

#include "visu/scenecull.glsl"

layout(std430, set = 2, binding = 0) readonly buffer Statics {
    SceneInstance statics[];
};

layout(std430, set = 2, binding = 1) readonly buffer Movers {
    SceneInstance movers[];
};

layout(std430, set = 2, binding = 2) readonly buffer Models {
    SceneModel models[];
};

layout(std430, set = 2, binding = 3) readonly buffer Views {
    SceneView views[];
};

layout(std430, set = 2, binding = 4) writeonly buffer Pairs {
    uvec4 pairs[];
};

layout(std430, set = 2, binding = 5) buffer Counters {
    uint counters[];
};

void main()
{
    uint row = gl_GlobalInvocationID.x;
    uint view = gl_GlobalInvocationID.y;
    if (row >= u_rows.x + u_rows.y || view >= u_rows.z) {
        return;
    }

    if (views[view].meta.x == SCENE_PASS_NONE) {
        return;
    }

    SceneInstance inst;
    uint id;
    if (row < u_rows.x) {
        inst = statics[row];
        id = row;
    } else {
        inst = movers[row - u_rows.x];
        id = (row - u_rows.x) | SCENE_MOVER_BIT;
    }

    uint need = SCENE_INSTANCE_LIVE | SCENE_INSTANCE_CASTS;
    if ((inst.meta.y & need) != need) {
        return;
    }

    if (!scene_box_visible(views[view], inst.lo.xyz, inst.hi.xyz)) {
        return;
    }

    SceneModel m = models[inst.meta.x];
    vec3 eye = u_eye.xyz;
    float dist = length(clamp(eye, inst.lo.xyz, inst.hi.xyz) - eye);
    if (m.bias.y > 0.0 && dist > m.bias.y) {
        return;
    }

    float d = dist * (m.bias.x * inst.lo.w * u_eye.w);
    uint levels = m.head.x;
    uint level = 0u;
    for (uint i = 1u; i < levels; i++) {
        if (d < scene_lod_distance(m, i)) {
            break;
        }
        level = i;
    }

    uint first = scene_lod_start(m, level);
    uint end = scene_lod_start(m, level + 1u);
    if (end <= first) {
        return;
    }

    uint slot = atomicAdd(counters[SCENE_COUNTER_PAIRS], 1u);
    if (slot >= u_limits.x) {
        atomicAdd(counters[SCENE_COUNTER_PAIRS_DROPPED], 1u);
        return;
    }

    pairs[slot] = uvec4(id, view, first, end - first);
}
