#version 450

// visu::graphics::GpuScene, the cluster dispatch: one workgroup per pair stage one wrote
layout(local_size_x = 1) in;

#include "visu/scenecull.glsl"

layout(std430, set = 2, binding = 0) readonly buffer Counters {
    uint counters[];
};

layout(std430, set = 2, binding = 1) writeonly buffer Args {
    uint args[];
};

void main()
{
    args[0] = min(counters[SCENE_COUNTER_PAIRS], u_limits.x);
    args[1] = 1u;
    args[2] = 1u;
    args[3] = 0u;
}
