#version 450

// visu::graphics::GpuTable: rows the CPU changed this frame land in a persistent table on the
// GPU's timeline, so a frame in flight never sees a torn row. The transient source holds
// records of one destination row index followed by that row's words; one thread per word
layout(local_size_x = 64) in;

layout(std140, set = 0, binding = 0) uniform ScatterParams {
    // x words per row, y records
    uvec4 u_scatter;
};

layout(std430, set = 2, binding = 0) writeonly buffer Table {
    uint table[];
};

layout(std430, set = 2, binding = 1) readonly buffer Records {
    uint records[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint rowWords = u_scatter.x;
    if (i >= rowWords * u_scatter.y) {
        return;
    }

    uint record = i / rowWords;
    uint word = i % rowWords;
    uint base = record * (rowWords + 1u);
    uint row = records[base];
    table[row * rowWords + word] = records[base + 1u + word];
}
