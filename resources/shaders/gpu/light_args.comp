#version 450

// visu::graphics::LightCull: the bins dispatch, one workgroup per visible light
layout(local_size_x = 1) in;

#include "visu/lightcull.glsl"

layout(std430, set = 2, binding = 0) readonly buffer Counters {
    uint counters[];
};

layout(std430, set = 2, binding = 1) writeonly buffer Args {
    uint args[];
};

void main()
{
    args[0] = min(counters[LIGHT_COUNTER_VISIBLE], u_counts.y);
    args[1] = 1u;
    args[2] = 1u;
    args[3] = 0u;
}
