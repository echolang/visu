/**
 * Host session bag. Construct is cheap; initialize needs a window.
 */

use visu::app::{Host, HostConfig, HostError, Services};

test host_config_defaults
{
    HostConfig $cfg = HostConfig();
    assert($cfg->title->equals('visu'), 'title');
    assert($cfg->width == 1280, 'width');
    assert($cfg->height == 720, 'height');
    assert($cfg->vsync, 'vsync');
    assert(!$cfg->headless, 'shown');
    assert($cfg->instrumentOverlay, 'overlay');
    assert(!$cfg->debugConsole, 'no console');
    assert(!$cfg->ui, 'no ui');
    assert($cfg->targetName->equals('scene'), 'target');
    assert($cfg->colorName->equals('color'), 'color');
}

test host_construct_fills_the_bag
{
    Services $s = Services();
    Host $host = Host(HostConfig(), $s);
    assert($host->frameIndex == 0, 'frames');
    assert(!$host->fail->failed(), 'ok');
    assert($host->services == $s, 'services');
}

test host_error_none_is_not_failed
{
    HostError $e = .none;
    assert(!$e->failed(), 'none');
    assert($e->message()->empty(), 'empty');
}
