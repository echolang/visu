/**
 * WindowEventHandler dispatch. setHandler works before initialize.
 */

use visu::os::{Window, WindowHints};
use visu::os::input::{InputHub, Key, MouseButton};
use visu::signal::Dispatcher;

test window_handler_receives_injected_key
{
    Window $window = Window('tap', 64, 64, WindowHints());
    InputHub $in = InputHub($window, Dispatcher());
    $window->setHandler($in);
    $in->handleKey($window, .space, 0, .press, 0);
    assert($in->down(.space), 'held');
}

#[if: os == ios]
test window_post_flushes_to_input
{
    Window $window = Window('tap', 64, 64, WindowHints());
    InputHub $in = InputHub($window, Dispatcher());
    $window->setHandler($in);
    $window->post(visu::os::HostEvent::key(.space, 0, .press, 0));
    $window->flush();
    assert($in->down(.space), 'held');
}
#[end]

#[if: os != ios]
test key_constants_are_glfw
{
    assert(Key::space->glfw() == glfw::KEY_SPACE, 'space');
    assert(Key::escape->glfw() == glfw::KEY_ESCAPE, 'escape');
    assert(MouseButton::left->glfw() == glfw::MOUSE_BUTTON_LEFT, 'left');
}

test cursor_mode_values_are_glfw
{
    visu::os::CursorMode $mode = .normal;
    assert(visu::os::glfwCursorMode($mode) == glfw::CURSOR_NORMAL, 'normal');
    assert(visu::os::glfwCursorMode(.hidden) == glfw::CURSOR_HIDDEN, 'hidden');
    assert(visu::os::glfwCursorMode(.disabled) == glfw::CURSOR_DISABLED, 'disabled');
}
#[end]
