/**
 * Real GLFW window. Hidden, so it can run without a click.
 * Skip on machines without a display via --filter group:glfw.
 */

use visu::os::{Window, WindowHints, init, terminate, WindowError, WindowAttrib};
use visu::graphics::{AdapterInfo, Device};
use visu::app::{Logger, installLogger, uninstallLogger};

#[if: os != ios]
test window_safe_area_is_zero_on_desktop
{
    Window $window = Window('tap', 64, 64, WindowHints());
    visu::os::Insets $area = $window->safeArea();
    assert($area->left == 0.0f, 'l');
    assert($area->top == 0.0f, 't');
    assert($area->right == 0.0f, 'r');
    assert($area->bottom == 0.0f, 'b');
}
#[end]

test device_headless_construct_is_safe
{
    Device $device = Device();
    assert(!$device->surfaceLost(), 'fresh');
    $device->shutdown();
    assert(!$device->surfaceLost(), 'no instance, no vk calls');
}

#[if: os != ios]
#[group: "glfw"]
test window_initialize_sets_title_and_size
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('Test Window', 640, 480, $hints);
    Device $state = Device();
    guard $window->initialize($state) else ($e) {
        $state->shutdown();
        terminate();
        die($e->message());
    }

    assert($window->title() == 'Test Window', 'title');
    assert($window->width() == 640, 'width');
    assert($window->height() == 480, 'height');
    AdapterInfo $gpu = $state->adapterInfo();
    assert(!$gpu->api->empty(), 'api');
    assert(!$gpu->name->empty(), 'gpu name');
    assert($window->framebufferWidth() >= 640, 'fb width');
    assert($window->framebufferHeight() >= 480, 'fb height');
    visu::graphics::RenderTarget $rt = $window->renderTarget();
    assert($rt->width >= 640, 'render target width');
    assert($rt->height >= 480, 'render target height');
    assert(!$window->shouldClose(), 'open');
    $window->setShouldClose(true);
    assert($window->shouldClose(), 'close requested');
    $window->destroy();
    assert($window->shouldClose(), 'destroyed');
    $state->shutdown();
    terminate();
}
#[end]

#[if: os != ios]
#[group: "glfw"]
test window_initialize_twice_is_already_initialized
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('twice', 320, 240, $hints);
    Device $state = Device();
    guard $window->initialize($state) else ($e) {
        $state->shutdown();
        terminate();
        die($e->message());
    }

    status<WindowError> $again = $window->initialize($state);
    assert($again->failed(), 'second initialize fails');
    $window->destroy();
    $state->shutdown();
    terminate();
}

#[group: "glfw"]
test window_resize_logs_backbuffer
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('resize', 320, 240, $hints);
    Device $state = Device();
    guard $window->initialize($state) else ($e) {
        $state->shutdown();
        terminate();
        die($e->message());
    }

    Logger $log = Logger();
    installLogger($log);
    $window->noteFramebuffer(800, 600);
    array<string> $msgs = $log->messages();
    assert($msgs->count() == 1, 'once');
    assert($msgs[0] == 'backbuffer: 800x600', 'line');
    $window->noteFramebuffer(800, 600);
    assert($log->messages()->count() == 1, 'duplicate skipped');
    $window->noteFramebuffer(1024, 768);
    $msgs = $log->messages();
    assert($msgs->count() == 2, 'changed');
    assert($msgs[1] == 'backbuffer: 1024x768', 'second');
    uninstallLogger();
    $window->destroy();
    $state->shutdown();
    terminate();
}

#[group: "glfw"]
test window_set_attribute_visible
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('attr', 320, 240, $hints);
    Device $state = Device();
    guard $window->initialize($state) else ($e) {
        $state->shutdown();
        terminate();
        die($e->message());
    }

    $window->setAttribute(.visible, false);
    assert(!$window->attribute(.visible), 'hidden');
    $window->destroy();
    $state->shutdown();
    terminate();
}

#[group: "glfw"]
test window_cursor_mode_and_key_state
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('cursor', 320, 240, $hints);
    Device $state = Device();
    guard $window->initialize($state) else ($e) {
        $state->shutdown();
        terminate();
        die($e->message());
    }

    $window->setCursorMode(.normal);
    assert($window->cursorMode() == visu::os::CursorMode::normal, 'normal');
    assert($window->keyState(.space) == visu::os::input::KeyPhase::release, 'key up');
    assert($window->buttonState(.left) == visu::os::input::KeyPhase::release, 'button up');
    $window->cursor();
    $window->destroy();
    $state->shutdown();
    terminate();
}
#[end]
