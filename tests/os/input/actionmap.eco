/**
 * ActionMap bindings and ContextMap switching. No GLFW.
 */

use visu::math::Vec2;
use visu::os::{Window, WindowHints};
use visu::os::input::{ActionMap, ContextMap, InputError, InputHub};
use visu::signal::{ClickSignal, Dispatcher, Flow, KeySignal, MouseButtonSignal};

class MapHits
{
    public int32 $n;

    public constructor()
    {
        $this->n = 0;
    }
}

test action_map_key_press_release
{
    ActionMap $map = ActionMap();
    guard $map->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    Flow $flow = $map->handle(KeySignal(.space, 0, .press, 0));
    assert($flow == Flow::stop, 'consumed');
    assert($map->hasBeenPressed('jump'), 'pressed');
    assert($map->down('jump'), 'down');
    assert(!$map->up('jump'), 'not up');
    $map->handle(KeySignal(.space, 0, .release, 0));
    assert($map->hasBeenReleased('jump'), 'released');
    assert(!$map->down('jump'), 'up');
}

test action_map_repeat_is_down_not_pressed
{
    ActionMap $map = ActionMap();
    guard $map->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    $map->handle(KeySignal(.space, 0, .repeat, 0));
    assert(!$map->hasBeenPressed('jump'), 'not edge');
    assert($map->down('jump'), 'held');
}

test action_map_reset_clears_edges
{
    ActionMap $map = ActionMap();
    guard $map->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    $map->handle(KeySignal(.space, 0, .press, 0));
    $map->reset();
    assert(!$map->hasBeenPressed('jump'), 'cleared');
    assert($map->down('jump'), 'held');
}

test action_map_unbound_proceeds
{
    ActionMap $map = ActionMap();
    Flow $flow = $map->handle(KeySignal(.a, 0, .press, 0));
    assert($flow == Flow::proceed, 'unbound');
    assert(!$map->hasBeenPressed('jump'), 'none');
    assert($map->up('jump'), 'up');
}

test action_map_button_and_click
{
    ActionMap $map = ActionMap();
    guard $map->bind('fire', .button(.left)) else ($e) {
        die($e->message());
    }
    guard $map->bind('select', .click) else ($e) {
        die($e->message());
    }
    $map->handle(MouseButtonSignal(.left, .press, 0));
    assert($map->hasBeenPressed('fire'), 'fire');
    Flow $click = $map->handle(ClickSignal(0, Vec2(0.0f), Vec2(0.0f), 0.0f));
    assert($click == Flow::stop, 'consumed');
    assert($map->hasBeenReleased('select'), 'click is a release');
    assert(!$map->down('select'), 'no held click');
}

test action_map_duplicate_bind_is_taken
{
    ActionMap $map = ActionMap();
    guard $map->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    status<InputError> $again = $map->bind('other', .key(.space));
    assert($again->failed(), 'dup');
    InputError $e = $again->failure();
    bool $taken = match ($e) {
        InputError::taken($binding, $action) => $action == 'jump',
        else => false,
    };
    assert($taken, 'jump');
}

test context_map_switch_and_next
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    ActionMap $ui = ActionMap();
    guard $game->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    guard $ui->bind('click', .click) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $ctx->register('ui', $ui) else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.space, 0, .press, 0));
    assert($ctx->actions()->hasBeenPressed('jump'), 'game');
    guard $ctx->switch(next: 'ui') else ($e) {
        die($e->message());
    }
    assert($ctx->actions()->hasBeenPressed('jump'), 'still game this tick');
    $ctx->reset();
    assert(!$ctx->actions()->hasBeenPressed('jump'), 'switched');
    $d->dispatch(ClickSignal(0, Vec2(0.0f), Vec2(0.0f), 0.0f));
    assert($ctx->actions()->hasBeenReleased('click'), 'ui click');
}

test context_map_matching_key_stops_later_handlers
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    guard $game->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    MapHits $hits = MapHits();
    $d->register<KeySignal>(function(const KeySignal& $k) : Flow {
        $hits->n = $hits->n + 1;
        return .proceed;
    }, 1);
    $d->dispatch(KeySignal(.space, 0, .press, 0));
    assert($hits->n == 0, 'stopped');
    $d->dispatch(KeySignal(.a, 0, .press, 0));
    assert($hits->n == 1, 'unbound proceeds');
}

test context_map_switch_next_to_current_cancels_pending
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    ActionMap $ui = ActionMap();
    guard $game->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    guard $ui->bind('click', .click) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $ctx->register('ui', $ui) else ($e) {
        die($e->message());
    }
    guard $ctx->switch(next: 'ui') else ($e) {
        die($e->message());
    }
    guard $ctx->switch(next: 'game') else ($e) {
        die($e->message());
    }
    $ctx->reset();
    $d->dispatch(KeySignal(.space, 0, .press, 0));
    assert($ctx->actions()->hasBeenPressed('jump'), 'still game');
}

test context_map_release_while_inactive_clears_down
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    ActionMap $ui = ActionMap();
    guard $game->bind('walk', .key(.w)) else ($e) {
        die($e->message());
    }
    guard $ui->bind('click', .click) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $ctx->register('ui', $ui) else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.w, 0, .press, 0));
    assert($game->down('walk'), 'held');
    guard $ctx->switch('ui') else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.w, 0, .release, 0));
    guard $ctx->switch('game') else ($e) {
        die($e->message());
    }
    assert(!$game->down('walk'), 'released off-context');
}

test context_map_held_key_stays_down_across_switch
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    ActionMap $ui = ActionMap();
    guard $game->bind('walk', .key(.w)) else ($e) {
        die($e->message());
    }
    guard $ui->bind('click', .click) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $ctx->register('ui', $ui) else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.w, 0, .press, 0));
    guard $ctx->switch('ui') else ($e) {
        die($e->message());
    }
    guard $ctx->switch('game') else ($e) {
        die($e->message());
    }
    assert($game->down('walk'), 'still held');
}

test context_map_switch_clears_inactive_pressed
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    ActionMap $ui = ActionMap();
    guard $game->bind('walk', .key(.w)) else ($e) {
        die($e->message());
    }
    guard $ui->bind('click', .click) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $ctx->register('ui', $ui) else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.w, 0, .press, 0));
    assert($game->hasBeenPressed('walk'), 'edge');
    guard $ctx->switch('ui') else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.w, 0, .release, 0));
    $ctx->reset();
    guard $ctx->switch('game') else ($e) {
        die($e->message());
    }
    assert(!$game->hasBeenPressed('walk'), 'stale edge');
    assert(!$game->down('walk'), 'up');
}

test context_map_skips_handle_when_input_claimed
{
    Dispatcher $d = Dispatcher();
    Window $w = Window('ctx', 64, 64, WindowHints());
    InputHub $in = InputHub($w, $d);
    ContextMap $ctx = ContextMap($d, $in);
    ActionMap $game = ActionMap();
    guard $game->bind('jump', .key(.space)) else ($e) {
        die($e->message());
    }
    guard $ctx->activate('game', $game) else ($e) {
        die($e->message());
    }
    guard $in->claim('console') else ($e) {
        die($e->message());
    }
    $d->dispatch(KeySignal(.space, 0, .press, 0));
    assert(!$game->hasBeenPressed('jump'), 'claimed');
    assert($game->down('jump'), 'track');
    guard $in->release('console') else ($e) {
        die($e->message());
    }
    $ctx->reset();
    $d->dispatch(KeySignal(.space, 0, .press, 0));
    assert($game->hasBeenPressed('jump'), 'free');
}

test context_map_duplicate_and_missing
{
    Dispatcher $d = Dispatcher();
    ContextMap $ctx = ContextMap($d);
    ActionMap $game = ActionMap();
    guard $ctx->register('game', $game) else ($e) {
        die($e->message());
    }
    status<InputError> $dup = $ctx->register('game', ActionMap());
    assert($dup->failed(), 'dup');
    status<InputError> $miss = $ctx->switch('missing');
    assert($miss->failed(), 'miss');
}
