/**
 * Graph bar stack height: measure and paint must agree so bars stay inside the panel.
 */

use visu::instrument::{PassTiming, passBarStack};

test pass_bar_stack_cpu_only
{
    PassTiming $p = PassTiming();
    $p->cpuNs = 1000000.0;
    assert(passBarStack($p) == 4.0f, 'cpu');
}

test pass_bar_stack_cpu_and_gpu
{
    PassTiming $p = PassTiming();
    $p->cpuNs = 1000000.0;
    $p->gpuNs = 2000000.0;
    assert(passBarStack($p) == 10.0f, 'cpu+gap+gpu');
}
