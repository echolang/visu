/**
 * Headless Device.memory() is zeros until initialize.
 */

use visu::graphics::{Device, MemoryStats};

test device_memory_headless_is_zero
{
    Device $device = Device();
    MemoryStats $stats = $device->memory();
    assert($stats->used == 0, 'used');
    assert($stats->budget == 0, 'budget');
    assert(!$stats->unified, 'unified');
    $device->shutdown();
}
