/**
 * OrbitCamera place helper. No window, no GPU.
 */

use visu::components::OrbitCamera;
use visu::geo::Transform;
use visu::math::{Vec3, equal};

test orbit_camera_place_sits_on_the_sphere
{
    OrbitCamera $orbit = OrbitCamera(Vec3(1.0f, 2.0f, 3.0f), 10.0f);
    Transform $transform = Transform();
    $orbit->place($transform);
    assert(equal($transform->position->x, 1.0f), 'eye x');
    assert(equal($transform->position->y, 2.0f), 'eye y');
    assert(equal($transform->position->z, 13.0f), 'eye z');
    Vec3 $forward = $transform->forward();
    assert(equal($forward->x, 0.0f), 'look x');
    assert(equal($forward->y, 0.0f), 'look y');
    assert(equal($forward->z, -1.0f), 'look -z');
}
