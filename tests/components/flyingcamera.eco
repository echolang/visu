/**
 * FlyingCamera pose helper. No window, no GPU.
 */

use visu::components::FlyingCamera;
use visu::ecs::Entities;
use visu::geo::Transform;
use visu::graphics::Camera;
use visu::math::{Quat, Vec3, equal};

test flying_camera_aim_identity_euler_is_identity
{
    FlyingCamera $fly = FlyingCamera();
    Transform $transform = Transform();
    $fly->aim($transform);
    assert(equal($transform->orientation, Quat()), 'identity');
}

test flying_camera_step_is_speed
{
    FlyingCamera $fly = FlyingCamera();
    assert($fly->step(false) == 0.5f, 'walk');
}

test flying_camera_step_sprinting_is_fifty_times
{
    FlyingCamera $fly = FlyingCamera();
    assert($fly->sprint == 50.0f, 'default');
    assert($fly->step(true) == 25.0f, 'sprint');
}

test flying_camera_step_uses_custom_sprint
{
    FlyingCamera $fly = FlyingCamera();
    $fly->speed = 2.0f;
    $fly->sprint = 3.0f;
    assert($fly->step(true) == 6.0f, 'custom');
}

test spawn_flying_camera_attaches_the_controller
{
    Entities $world = Entities();
    $entity = Camera::spawn($world, Vec3(5.4f, 2.4f, 14.4f));
    $world->attach($entity, FlyingCamera());
    assert($world->has<FlyingCamera>($entity), 'flying');
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->x == 5.4f, 'position x');
    assert($transform->position->z == 14.4f, 'position z');
}
