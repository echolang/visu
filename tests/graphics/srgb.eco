/**
 * The sRGB transfer curve on the CPU against the one the texture cook averages mips with.
 */

use visu::graphics::{linearToSrgb, srgbByte, srgbToLinear, srgbToLinearRgb};
use visu::math::Vec3;

function nearly(float32 $a, float32 $b, float32 $eps) : bool
{
    float32 $d = $a - $b;
    return $d < $eps && $d > -$eps;
}

test srgb_round_trips
{
    int32 $i = 0;
    while ($i <= 100) {
        float32 $x = ($i as float32) / 100.0f;
        assert(nearly(linearToSrgb(srgbToLinear($x)), $x, 0.00001f), 'encode undoes decode');
        $i = $i + 1;
    }
}

test srgb_known_values
{
    assert(srgbToLinear(0.0f) == 0.0f && nearly(srgbToLinear(1.0f), 1.0f, 0.000001f), 'ends');
    assert(nearly(srgbToLinear(0.5f), 0.21404f, 0.00001f), 'mid grey code');
    assert(nearly(srgbToLinear(0.02f), 0.02f / 12.92f, 0.0000001f), 'linear toe');
    Vec3 $red = srgbToLinearRgb(Vec3(0.62f, 0.08f, 0.07f));
    assert(nearly($red->x, 0.3424f, 0.0001f) && nearly($red->y, 0.0072f, 0.0001f), 'a paint');
}

test srgb_byte_is_the_nearest_code
{
    assert(srgbByte(-1.0f) == 0 && srgbByte(2.0f) == 255, 'clamped');
    int32 $i = 0;
    while ($i < 256) {
        float32 $code = ($i as float32) / 255.0f;
        assert(srgbByte(srgbToLinear($code)) as int32 == $i, 'every byte comes back');
        $i = $i + 1;
    }
}
