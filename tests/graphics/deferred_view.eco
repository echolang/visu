/**
 * DeferredView parse / label / needsSsao. No GPU.
 */

use visu::graphics::{DeferredView, DeferredViewError, PixelDump};

test deferred_view_parse_and_label
{
    array<string> $names = [
        'scene',
        'albedo',
        'normal',
        'roughness',
        'metallic',
        'ao',
        'emissive',
        'position',
        'ssao',
        'id',
    ];
    foreach ($names as $name) {
        DeferredView $view = guard DeferredView::parse($name) else ($e) {
            assert(false, 'parse');
            return;
        }
        assert($view->label() == $name, 'label');
    }
}

test deferred_view_parse_unknown
{
    result<DeferredView, DeferredViewError> $r = DeferredView::parse('depth');
    assert($r->failed(), 'failed');
    DeferredViewError $e = $r->failure();
    assert($e->message() == 'unknown view: depth', 'message');
}

test deferred_view_scene_and_ssao
{
    DeferredView $scene = .scene;
    assert($scene->isScene(), 'scene');
    assert(!$scene->needsSsao(), 'scene ssao');
    DeferredView $ssao = .ssao;
    assert(!$ssao->isScene(), 'ssao scene');
    assert($ssao->needsSsao(), 'ssao');
    DeferredView $albedo = .albedo;
    assert(!$albedo->isScene(), 'albedo scene');
    assert(!$albedo->needsSsao(), 'albedo ssao');
}

test deferred_view_pixel_dump
{
    assert(dumpIsNormal(.normal), 'normal');
    assert(dumpIsGray(.roughness, 0), 'rough');
    assert(dumpIsGray(.metallic, 1), 'metal');
    assert(dumpIsGray(.ao, 2), 'ao');
    assert(dumpIsGray(.id, 0), 'id');
    assert(dumpIsColor(.albedo), 'albedo');
    assert(dumpIsColor(.ssao), 'ssao');
}

internal function dumpIsNormal(DeferredView $view) : bool
{
    return match ($view->pixelDump()) {
        PixelDump::normal => true,
        else => false,
    };
}

internal function dumpIsGray(DeferredView $view, int32 $channel) : bool
{
    return match ($view->pixelDump()) {
        PixelDump::gray($c) => $c == $channel,
        else => false,
    };
}

internal function dumpIsColor(DeferredView $view) : bool
{
    return match ($view->pixelDump()) {
        PixelDump::color => true,
        else => false,
    };
}
