/**
 * Metal raster bits libmetal cannot bake into a PSO yet.
 */

use visu::graphics::{Gpu, Raster};

#[if: VISU_BACKEND_METAL]
test metal_default_raster_is_ok
{
    Gpu $gpu = Gpu();
    $gpu->applyRaster(Raster::none());
    $gpu->applyRaster(Raster::opaque());
}

#[tests: expects death]
test metal_alpha_blend_is_unimplemented
{
    Gpu $gpu = Gpu();
    $gpu->applyRaster(Raster::alpha());
}

#[tests: expects death]
test metal_color_write_off_is_unimplemented
{
    Gpu $gpu = Gpu();
    Raster $r = Raster::none();
    $r->colorWrite = false;
    $gpu->applyRaster($r);
}
#[end]
