/**
 * AdapterInfo is filled at initialize; headless construct names the compiled arm only.
 */

use visu::graphics::{AdapterInfo, Device};

test adapter_headless_names_the_compiled_arm
{
    Device $device = Device();
    AdapterInfo $info = $device->adapterInfo();
    assert($info->name == '', 'no gpu yet');
    assert(!$info->api->empty(), 'compiled arm');
    assert($info->line() == $info->api, 'api only');
    $device->shutdown();
}

test adapter_headless_memory_is_zero
{
    Device $device = Device();
    assert($device->memoryStats()->used == 0, 'used');
    $device->shutdown();
}

test adapter_info_line_joins_version_and_name
{
    AdapterInfo $info = AdapterInfo();
    $info->api = 'Vulkan';
    $info->version = '1.2';
    $info->name = 'Apple M4 Pro';
    assert($info->line() == 'Vulkan 1.2 — Apple M4 Pro', 'line');
}