/**
 * Point-light gather and tile coverage. The shader shades a pixel only when
 * its tile count is above zero, so an empty tile is the no-shade case.
 */

use visu::geo::{Ray, Transform};
use visu::graphics::{
    Camera, CameraData, POINT_LIGHT_MAX, POINT_SHADOW_MAX, POINT_TILE, PointCandidate, PointPack,
    PointRect, pointGather, pointRect, pointSplat, pointTileCount, pointTiles
};
use visu::math::{Vec2, Vec3, dot, equal, length, normalize};

function pointCamera() : CameraData
{
    Camera $lens = Camera(.perspective);
    $lens->fov = 90.0f;
    $lens->near = 0.1f;
    $lens->far = 100.0f;
    Transform $pose = Transform();
    $pose->position = Vec3(0.0f, 0.0f, 0.0f);
    return $lens->data($pose->mix(0.0f), 160, 160, 1.0f, 1.0f, 0.0f);
}

function pointLamp(Vec3 $at, float32 $radius, bool $shadow) : PointCandidate
{
    return PointCandidate($at, $radius, Vec3(1.0f, 0.2f, 0.0f), 4.0f, 0.04f, $shadow);
}

test point_gather_keeps_the_closest_64
{
    CameraData $cam = pointCamera();
    array<PointCandidate> $in = array<PointCandidate>();
    int32 $i = 0;
    while ($i < 70) {
        float32 $z = -10.0f - ($i as float32);
        $in[] = pointLamp(Vec3(0.0f, 0.0f, $z), 0.5f, false);
        $i = $i + 1;
    }

    PointPack $pack = pointGather($in, $cam->position, $cam->frustum);
    assert($pack->count == POINT_LIGHT_MAX, 'cap is 64');
    assert(equal($pack->gpu[0]->positionRadius->z, -10.0f), 'nearest stays first');
    assert(equal($pack->gpu[63]->positionRadius->z, -73.0f), '64th closest is kept');
}

test point_sphere_behind_the_camera_is_dropped
{
    CameraData $cam = pointCamera();
    array<PointCandidate> $in = array<PointCandidate>();
    $in[] = pointLamp(Vec3(0.0f, 0.0f, 5.0f), 0.4f, true);
    PointPack $pack = pointGather($in, $cam->position, $cam->frustum);
    assert($pack->count == 0, 'fully behind the eye');
}

test point_zero_radius_or_intensity_is_dropped
{
    CameraData $cam = pointCamera();
    array<PointCandidate> $in = array<PointCandidate>();
    PointCandidate $dark = pointLamp(Vec3(0.0f, 0.0f, -8.0f), 2.0f, true);
    $dark->intensity = 0.0f;
    $in[] = $dark;
    $in[] = pointLamp(Vec3(0.0f, 0.0f, -8.0f), 0.0f, true);
    PointPack $pack = pointGather($in, $cam->position, $cam->frustum);
    assert($pack->count == 0, 'nothing to shade');
}

test point_shadow_slots_are_the_closest_four
{
    CameraData $cam = pointCamera();
    array<PointCandidate> $in = array<PointCandidate>();
    $in[] = pointLamp(Vec3(0.0f, 0.0f, -6.0f), 3.0f, false);
    int32 $i = 0;
    while ($i < 6) {
        float32 $z = -8.0f - ($i as float32);
        $in[] = pointLamp(Vec3(0.0f, 0.0f, $z), 3.0f, true);
        $i = $i + 1;
    }

    PointPack $pack = pointGather($in, $cam->position, $cam->frustum);
    assert($pack->shadows == POINT_SHADOW_MAX, 'four shadow lamps');
    assert($pack->gpu[0]->sourceShadow->y < 0.0f, 'the nearest does not cast');
    assert(equal($pack->gpu[1]->sourceShadow->y, 0.0f), 'next caster is slot 0');
    assert(equal($pack->gpu[4]->sourceShadow->y, 3.0f), 'fourth caster is slot 3');
    assert($pack->gpu[5]->sourceShadow->y < 0.0f, 'fifth caster is unshadowed');
}

/**
 * True when the ray through the centre of tile `($tx, $ty)` meets the sphere.
 * That ray is the coverage the tile grid has to include; the rect may be larger.
 */
function pointTileHitsSphere(
    const CameraData& $cam,
    Vec3 $center,
    float32 $radius,
    int32 $tx,
    int32 $ty
) : bool
{
    float32 $w = $cam->resolutionX as float32;
    float32 $h = $cam->resolutionY as float32;
    float32 $tile = POINT_TILE as float32;
    float32 $px = ($tx as float32) * $tile + $tile * 0.5f;
    float32 $py = ($ty as float32) * $tile + $tile * 0.5f;
    float32 $ndcX = ($px / $w) * 2.0f - 1.0f;
    float32 $ndcY = 1.0f - ($py / $h) * 2.0f;
    Ray $ray = $cam->ray(Vec2($ndcX, $ndcY));
    Vec3 $dir = normalize($ray->direction);
    Vec3 $to = $center - $ray->origin;
    float32 $along = dot($to, $dir);
    if ($along <= 0.0f) {
        return false;
    }

    Vec3 $closest = $ray->origin + $dir * $along;
    return length($center - $closest) <= $radius;
}

/**
 * Every tile whose centre ray hits `$at` is shaded, and some tile is not.
 */
function assertPointTilesCoverHits(CameraData $cam, Vec3 $at, float32 $radius) : void
{
    array<PointCandidate> $in = array<PointCandidate>();
    $in[] = pointLamp($at, $radius, false);
    PointPack $pack = pointGather($in, $cam->position, $cam->frustum);
    assert($pack->count == 1, 'lamp kept');
    PointRect $rect = pointRect($cam, $at, $radius);
    assert($rect->full == false, 'a finite lamp is a rect');
    int32 $tilesX = pointTiles($cam->resolutionX);
    int32 $tilesY = pointTiles($cam->resolutionY);
    array<uint8> $grid = array<uint8>();
    int32 $bytes = $tilesX * $tilesY * 9;
    $grid->reserve($bytes as usize);
    int32 $n = 0;
    while ($n < $bytes) {
        $grid[] = 0;
        $n = $n + 1;
    }

    pointSplat($cam, $pack, $grid, $tilesX, $tilesY);
    int32 $hits = 0;
    int32 $misses = 0;
    int32 $ty = 0;
    while ($ty < $tilesY) {
        int32 $tx = 0;
        while ($tx < $tilesX) {
            int32 $count = pointTileCount($grid, $tilesX, $tx, $ty);
            if (pointTileHitsSphere($cam, $at, $radius, $tx, $ty)) {
                assert($count == 1, 'a tile the sphere covers is shaded');
                $hits = $hits + 1;
            } else {
                $misses = $misses + 1;
            }

            $tx = $tx + 1;
        }

        $ty = $ty + 1;
    }

    assert($hits > 0, 'some tile centre hits the sphere');
    assert($misses > 0, 'some tile is outside the sphere');
    assert(pointTileCount($grid, $tilesX, 0, 0) == 0, 'a corner tile with no lamp does no shade');
}

test point_known_camera_covers_the_expected_tiles
{
    CameraData $cam = pointCamera();
    Vec3 $at = Vec3(0.0f, 0.0f, -10.0f);
    assertPointTilesCoverHits($cam, $at, 2.0f);
    PointRect $rect = pointRect($cam, $at, 2.0f);
    // tangent cone: half-ndc = 2/sqrt(96), half of 160 px is 16.33, edges 63.67 and 96.33
    assert($rect->x0 > 63.6f && $rect->x0 < 63.75f, 'left edge is the silhouette');
    assert($rect->x1 > 96.25f && $rect->x1 < 96.4f, 'right edge is the silhouette');
    assert($rect->y0 > 63.6f && $rect->y0 < 63.75f, 'top edge is the silhouette');
    assert($rect->y1 > 96.25f && $rect->y1 < 96.4f, 'bottom edge is the silhouette');
}

test point_close_lamp_covers_the_silhouette
{
    assertPointTilesCoverHits(pointCamera(), Vec3(0.0f, 0.0f, -10.0f), 5.0f);
}

test point_off_center_lamp_covers_the_silhouette
{
    assertPointTilesCoverHits(pointCamera(), Vec3(4.0f, -2.0f, -10.0f), 5.0f);
}

test point_eye_inside_the_sphere_covers_the_viewport
{
    CameraData $cam = pointCamera();
    assert(pointRect($cam, Vec3(0.0f, 0.0f, -1.0f), 5.0f)->full, 'inside');
    assert(pointRect($cam, Vec3(0.0f, 0.0f, -10.0f), 2.0f)->full == false, 'a small lamp is a rect');
    assert(POINT_TILE == 16, 'tile is 16 pixels');
}
