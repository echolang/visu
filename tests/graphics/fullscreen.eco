/**
 * FullscreenTextureRenderer blits an offscreen colour onto the
 * backbuffer.
 */

use visu::graphics::{
    Pool, Frame, Pipeline, Backbuffer, ClearPass, ClearPassOptions,
    FullscreenTextureRenderer, TextureOptions, COLOR_BUFFER_BIT
};
use visu::math::Vec4;

#[if: VISU_BACKEND_METAL]
#[else]
#[group: "glfw"]
test fullscreen_blit_copies_offscreen_clear
{
    GlContext $gl = glHidden('fullscreen-blit');
    FullscreenTextureRenderer $blit = FullscreenTextureRenderer();
    guard $blit->load($gl->gpu) else ($e) {
        $blit->destroy();
        $gl->end();
        die($e->message());
    }

    Pool $pool = Pool($gl->gpu);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $gl->window->renderTarget());
    Backbuffer $back = $frame->get<Backbuffer>();
    $scene = $pipeline->createTargetLike('quickstartTarget', $gl->window->renderTarget());
    $scene->rboDepthStencil = true;
    $color = $pipeline->createColor($scene, 'quickstartColor', TextureOptions());
    $pipeline->add(ClearPass($scene, ClearPassOptions(color: Vec4(0.5f, 0.0f, 0.0f, 1.0f))));
    $pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.0f, 1.0f, 0.0f, 1.0f))));
    $blit->pass($pipeline, $back->target, $color);
    guard $pipeline->execute(0) else ($e) {
        $blit->destroy();
        $pool->destroy();
        $gl->end();
        die($e->message());
    }

    $gl->window->renderTarget()->preparePass();
    array<uint8> $pixels = readRgba($gl->window);
    uint8 $r = $pixels[0];
    uint8 $g = $pixels[1];

    $blit->destroy();
    $pool->destroy();
    $gl->end();

    assert($r > 100 && $r < 160, 'blit r');
    assert($g < 16, 'blit g');
}
#[end]
