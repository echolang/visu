/**
 * Sky parameters, their GPU mirror, the sun light they cast, and the probe face cameras.
 */

use visu::graphics::{
    DirectionalLight, IblBlend, Moon, Sky, SkyUniforms, keyLight, moonKeyed, nightAmbient, probeCamera, skyUniforms
};
use visu::math::{Mat4, Vec3, Vec4, normalize};

test sky_equality
{
    Sky $a = Sky();
    Sky $b = Sky();
    assert($a == $b, 'defaults equal');
    $b->mieScale = 2.0f;
    assert($a != $b, 'mie differs');
}

test sky_same_atmosphere_ignores_direction
{
    Sky $a = Sky();
    Sky $b = $a->withDirection(Vec3(0.0f, -1.0f, 0.0f));
    assert($a != $b, 'direction differs');
    assert($a->sameAtmosphere($b), 'same atmosphere');
    $b->exposure = 0.5f;
    assert(!$a->sameAtmosphere($b), 'exposure differs');
}

test sky_uniforms_pack
{
    assert(mem::size<SkyUniforms>() == 160, 'std140 size');
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, -2.0f, 0.0f);
    $sky->sunIntensity = 4.0f;
    SkyUniforms $u = skyUniforms($sky, Vec3(1.0f, 300.0f, 2.0f), true, 16.0f, 8.0f);
    assert($u->sun->y > 0.999f, 'towards the sun');
    assert($u->sun->w == 4.0f, 'intensity');
    assert($u->origin->y == 300.0f, 'origin');
    assert($u->origin->w == 1.0f, 'disk on');
    assert($u->params->x == 16.0f, 'view samples');
    SkyUniforms $bake = skyUniforms($sky, Vec3(0.0f, 0.0f, 0.0f), false, 32.0f, 8.0f);
    assert($bake->origin->w == 0.0f, 'disk off');
    assert($bake->moon->w == 0.0f, 'no moon in the bake');
    assert($bake->moonColor->w == 0.0f, 'no moon disc in the bake');
}

test sky_ozone_takes_the_green
{
    Sky $sky = Sky();
    SkyUniforms $u = skyUniforms($sky, Vec3(0.0f, 300.0f, 0.0f), false, 16.0f, 8.0f);
    assert($u->ozone->y > $u->ozone->x && $u->ozone->y > $u->ozone->z, 'ozone takes the green');
    $sky->ozoneScale = 0.0f;
    SkyUniforms $none = skyUniforms($sky, Vec3(0.0f, 300.0f, 0.0f), false, 16.0f, 8.0f);
    assert($none->ozone->y == 0.0f, 'no ozone');
    Sky $fresh = Sky();
    assert(!$fresh->sameAtmosphere($sky), 'another ozone rebakes the probes');
}

test sky_ozone_pinks_the_low_sun
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, -0.03f, -1.0f);
    DirectionalLight $now = $sky->sunLight(300.0f);
    $sky->ozoneScale = 0.0f;
    DirectionalLight $bare = $sky->sunLight(300.0f);
    // the sun's colour is normalised to its brightest channel, red, so green is what moves
    assert($now->color->y < $bare->color->y, 'less green through the ozone');
}

test sky_uniforms_pack_moon
{
    Sky $sky = Sky();
    Moon $moon = Moon();
    $moon->enabled = true;
    $moon->direction = Vec3(0.0f, -1.0f, 0.0f);
    $moon->illumination = 0.5f;
    $moon->light = $sky->moonLight($moon, 300.0f);
    SkyUniforms $u = skyUniforms($sky, Vec3(0.0f, 300.0f, 0.0f), true, 16.0f, 8.0f, $moon);
    assert($u->moon->y > 0.999f, 'towards the moon');
    assert($u->moon->w == $moon->light->intensity, 'scattered light');
    assert($u->moonParams->x == 0.5f, 'illumination');
    assert($u->moonColor->w == 1.0f, 'disc on');
    $moon->enabled = false;
    SkyUniforms $off = skyUniforms($sky, Vec3(0.0f, 300.0f, 0.0f), true, 16.0f, 8.0f, $moon);
    assert($off->moon->w == 0.0f && $off->moonColor->w == 0.0f, 'a disabled moon packs nothing');
}

test moon_light_follows_phase_and_horizon
{
    Sky $sky = Sky();
    Moon $moon = Moon();
    $moon->direction = Vec3(0.0f, -1.0f, 0.0f);
    $moon->illumination = 1.0f;
    assert($sky->moonLight($moon, 300.0f)->intensity == 0.0f, 'a disabled moon is dark');
    $moon->enabled = true;
    DirectionalLight $full = $sky->moonLight($moon, 300.0f);
    assert($full->intensity > 0.3f && $full->intensity <= $moon->intensity, 'full moon overhead');
    assert($full->color->z > $full->color->x, 'cool tint');
    $moon->illumination = 0.5f;
    DirectionalLight $quarter = $sky->moonLight($moon, 300.0f);
    assert($quarter->intensity < $full->intensity * 0.5f, 'a quarter is well under half');
    $moon->illumination = 0.0f;
    assert($sky->moonLight($moon, 300.0f)->intensity == 0.0f, 'new moon is dark');
    $moon->illumination = 1.0f;
    $moon->direction = Vec3(0.0f, 1.0f, 0.0f);
    assert($sky->moonLight($moon, 300.0f)->intensity == 0.0f, 'set moon is dark');
}

test key_light_is_the_brighter
{
    Sky $sky = Sky();
    Moon $moon = Moon();
    $moon->enabled = true;
    $moon->direction = Vec3(0.0f, -1.0f, 0.0f);
    $moon->light = $sky->moonLight($moon, 300.0f);
    $sky->direction = Vec3(0.0f, 1.0f, 0.0f);
    DirectionalLight $night = $sky->sunLight(300.0f);
    assert(moonKeyed($night, $moon), 'the moon owns a night');
    assert(keyLight($night, $moon)->intensity == $moon->light->intensity, 'moon key');
    $sky->direction = Vec3(0.0f, -1.0f, 0.0f);
    DirectionalLight $noon = $sky->sunLight(300.0f);
    assert(!moonKeyed($noon, $moon), 'the sun owns a day');
    // a low evening sun dimmer than the moon keeps its shadows until it sets
    DirectionalLight $evening = DirectionalLight(Vec3(0.0f, -0.1f, 1.0f), Vec3(1.0f, 0.5f, 0.3f), 0.05f);
    assert($evening->intensity < $moon->light->intensity, 'the moon is brighter');
    assert(!moonKeyed($evening, $moon), 'the sun keeps the cascades while it is up');
    assert(keyLight($evening, $moon)->intensity == 0.05f, 'sun key at dusk');
}

test disabled_moon_leaves_night_alone
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, 1.0f, 0.0f);
    Moon $moon = Moon();
    Vec4 $ambient = nightAmbient($moon, $sky);
    assert($ambient->x == 0.0f && $ambient->y == 0.0f && $ambient->z == 0.0f, 'no night ambient');
    $moon->enabled = true;
    assert(nightAmbient($moon, $sky)->z > 0.0f, 'starlight once enabled');
}

test sun_light_reddens_low
{
    Sky $sky = Sky();
    // five degrees above the horizon, travelling west to east
    float32 $elevation = 0.0872665f;
    Vec3 $toSun = Vec3(std::math::cos($elevation), std::math::sin($elevation), 0.0f);
    $sky->direction = -$toSun;
    DirectionalLight $low = $sky->sunLight(300.0f);
    assert($low->intensity > 0.0f, 'still lit');
    assert($low->color->x > $low->color->z, 'red survives longer than blue');
    $sky->direction = Vec3(0.0f, -1.0f, 0.0f);
    DirectionalLight $noon = $sky->sunLight(300.0f);
    assert($noon->color->z > 0.7f, 'noon stays close to white');
    assert($noon->intensity > $low->intensity, 'noon is brighter');
}

test sun_light_zero_below_horizon
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, 1.0f, 0.0f);
    DirectionalLight $night = $sky->sunLight(300.0f);
    assert($night->intensity == 0.0f, 'no sun at night');
}

test ibl_blend_defaults
{
    IblBlend $b = IblBlend();
    assert($b->from == 0 && $b->to == 0 && $b->weight == 0.0f, 'zero blend');
    IblBlend $c = IblBlend(3, 4, 0.25f);
    assert($c->to == 4, 'to');
}

test probe_camera_faces
{
    Vec3 $eye = Vec3(10.0f, 20.0f, 30.0f);
    $cam = probeCamera(0, $eye, 256, 0.5f, 1000.0f);
    assert($cam->position == $eye, 'position');
    assert($cam->resolutionX == 256, 'resolution');
    // a point ahead along +x lands in front of the camera (negative view z)
    Vec4 $ahead = $cam->view * Vec4(11.0f, 20.0f, 30.0f, 1.0f);
    assert($ahead->z < 0.0f, 'face 0 looks down +x');
    Vec4 $clip = $cam->projectionView * Vec4(11.0f, 20.0f, 30.0f, 1.0f);
    assert($clip->w > 0.0f, 'in front');
    $up = probeCamera(2, $eye, 256, 0.5f, 1000.0f);
    Vec4 $above = $up->view * Vec4(10.0f, 21.0f, 30.0f, 1.0f);
    assert($above->z < 0.0f, 'face 2 looks up');
}
