/**
 * Height fog defaults, GPU packing, and the CPU twin of shader transmittance.
 */

use std::math;
use visu::graphics::{
    AERIAL_SLICE_WIDTH, AERIAL_SLICES, AERIAL_WIDTH, AerialPerspective, DirectionalLight,
    FogLighting, FogUniforms, HeightFog, Moon, Sky, fogAmbient, fogLighting, fogTransmittance, fogUniforms,
    skyDomeRadiance
};
use visu::math::{Vec3, equal};

test fog_defaults_off_and_equal
{
    HeightFog $a = HeightFog();
    HeightFog $b = HeightFog();
    assert($a == $b, 'defaults equal');
    assert(!$a->enabled, 'off');
    assert($a->density == 0.00012f, 'density');
    assert($a->heightFalloff == 0.008f, 'falloff');
    $b->density = 0.001f;
    assert($a != $b, 'density differs');
}

test fog_uniforms_pack
{
    assert(mem::size<FogUniforms>() == 208, 'std140 size');
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->density = 0.00012f;
    $fog->heightFalloff = 0.008f;
    $fog->height = 0.0f;
    $fog->startDistance = 5.0f;
    Vec3 $camera = Vec3(0.0f, 50.0f, 0.0f);
    FogLighting $lit = FogLighting();
    FogUniforms $u = fogUniforms($fog, $camera, $lit);
    assert($u->density->w == 1.0f, 'enabled');
    assert($u->params->x == 5.0f && $u->params->z == 100000.0f, 'start and sky distance');
    float32 $d0 = 0.00012f * math::exp(-0.4f);
    float32 $delta = $u->density->x - $d0;

    if ($delta < 0.0f) {
        $delta = -$delta;
    }

    assert($delta < 0.0000001f, 'D0 at camera');
    assert($u->shafts->w == 0.0f, 'no shafts unless a god-ray frame binds them');
    assert($u->shaftLight->w == 0.0f, 'shaft light unset');
}

test fog_lighting_is_the_frame_lights
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, -1.0f, 0.0f);
    DirectionalLight $sun = $sky->sunLight(300.0f);
    Moon $moon = Moon();
    $moon->enabled = false;
    AerialPerspective $aerial = AerialPerspective();
    Vec3 $ambient = Vec3(0.1f, 0.2f, 0.3f);
    FogLighting $lit = fogLighting($sun, $moon, $sky, $aerial, $ambient);
    assert(equal($lit->toSun->y, 1.0f), 'towards the sun');
    assert(equal($lit->sun->x, $sun->color->x * $sun->intensity), 'the sun the light pass shades with');
    assert($lit->moon->x == 0.0f && $lit->toMoon->y == -1.0f, 'no moon');
    assert($lit->aerialScale == 1.0f, 'the aerial perspective on');
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    FogUniforms $u = fogUniforms($fog, Vec3(0.0f, 0.0f, 0.0f), $lit);
    assert(equal($u->model->y, 1.0f), 'towards the sun');
    assert($u->ambient->z == 0.3f, 'the ambient');
    assert($u->aerial->w == 1.0f, 'the distance scale');
    assert($u->moonLight->w == 0.0f, 'the moon casts nothing');
    $aerial->enabled = false;
    FogLighting $off = fogLighting($sun, $moon, $sky, $aerial, $ambient);
    assert($off->aerialScale == 0.0f, 'off');
}

test fog_sky_dome_is_blue_by_day_and_dark_by_night
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, -1.0f, 0.0f);
    Vec3 $noon = skyDomeRadiance($sky, 600.0f);
    assert($noon->z > $noon->x, 'the noon sky is blue');
    assert($noon->z > 0.0f, 'and lit');
    $sky->direction = Vec3(0.0f, 1.0f, 0.0f);
    Vec3 $night = skyDomeRadiance($sky, 600.0f);
    assert($night->z < $noon->z * 0.001f, 'the sun is under the planet');
}

test fog_ambient_greys_the_ground
{
    Sky $sky = Sky();
    $sky->direction = Vec3(0.0f, -1.0f, 0.0f);
    DirectionalLight $sun = $sky->sunLight(300.0f);
    Moon $moon = Moon();
    $moon->enabled = false;
    Vec3 $dome = Vec3(0.0f, 0.0f, 0.0f);
    Vec3 $ambient = fogAmbient($dome, $sun, $moon, $sky);
    // a white sun off brown ground stays white: only the ground's brightness counts
    float32 $sunTint = $sun->color->x / $sun->color->z;
    float32 $fogTint = $ambient->x / $ambient->z;
    assert(equal($sunTint, $fogTint), 'the ground adds no colour');
}

test aerial_atlas_holds_every_slice
{
    assert(AERIAL_SLICE_WIDTH * AERIAL_SLICES == AERIAL_WIDTH, 'slices side by side');
}

test fog_transmittance_one_when_disabled
{
    HeightFog $fog = HeightFog();
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3(1000.0f, 0.0f, 0.0f));
    assert($t == 1.0f, 'disabled');
}

test fog_horizontal_matches_exp
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->height = 0.0f;
    float32 $len = 1000.0f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3($len, 0.0f, 0.0f));
    float32 $expect = math::exp(-$fog->density * $len);
    float32 $delta = $t - $expect;

    if ($delta < 0.0f) {
        $delta = -$delta;
    }

    assert($delta < 0.0001f, 'exp(-D0 len)');
}

test fog_upward_tends_to_column
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->height = 0.0f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3(0.0f, 100000.0f, 0.0f));
    float32 $expect = math::exp(-$fog->density / $fog->heightFalloff);
    float32 $delta = $t - $expect;

    if ($delta < 0.0f) {
        $delta = -$delta;
    }

    assert($delta < 0.0001f, 'exp(-D0/k)');
}

test fog_start_distance_excludes_near
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->startDistance = 100.0f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3(50.0f, 0.0f, 0.0f));
    assert($t == 1.0f, 'inside start');
}

test fog_max_opacity_floor
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->density = 1.0f;
    $fog->maxOpacity = 0.25f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3(10000.0f, 0.0f, 0.0f));
    assert($t == 0.75f, 'opacity floor');
}

test fog_cutoff_untouched
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->cutoffDistance = 100.0f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, 0.0f, 0.0f), Vec3(200.0f, 0.0f, 0.0f));
    assert($t == 1.0f, 'past cutoff');
}

test fog_camera_below_height_finite
{
    HeightFog $fog = HeightFog();
    $fog->enabled = true;
    $fog->heightFalloff = 1.0f;
    $fog->height = 0.0f;
    float32 $t = fogTransmittance($fog, Vec3(0.0f, -100.0f, 0.0f), Vec3(1000.0f, 0.0f, 0.0f));
    assert($t >= 0.0f && $t <= 1.0f, 'finite');
    assert($t == $t, 'not nan');
}
