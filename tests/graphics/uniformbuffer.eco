/**
 * UniformBuffer payload sizes. GPU cases live in checks/uniform.eco.
 */

use visu::math::Vec4;

struct SmallParams
{
    public Vec4 $color;
}

struct BigParams
{
    public Vec4 $a;
    public Vec4 $b;
    public Vec4 $c;
    public Vec4 $d;
}

test uniform_payload_sizes
{
    assert(mem::size<SmallParams>() == 16, 'small');
    assert(mem::size<BigParams>() == 64, 'big');
}
