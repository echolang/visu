/**
 * CPU-side Pixels swizzle and PNG roundtrip. No GPU.
 */

use std::env;
use std::io;
use visu::graphics::{DumpError, PixelFormat, Pixels, RenderTarget};

test pixels_rgba8_is_identity
{
    array<uint8> $raw = [10, 20, 30, 255, 40, 50, 60, 255];
    Pixels $px = guard Pixels::from(PixelFormat::rgba8, 2, 1, $raw) else ($e) {
        die($e->message());
    }
    assert($px->width == 2, 'w');
    assert($px->height == 1, 'h');
    assert($px->rgba[0] == 10, 'r');
    assert($px->rgba[2] == 30, 'b');
}

test pixels_opaque_forces_alpha
{
    array<uint8> $raw = [10, 20, 30, 0, 40, 50, 60, 0];
    Pixels $px = guard Pixels::from(PixelFormat::rgba8, 2, 1, $raw) else ($e) {
        die($e->message());
    }
    Pixels $out = $px->opaque();
    assert($out->rgba[3] == 255, 'a0');
    assert($out->rgba[7] == 255, 'a1');
    assert($out->rgba[0] == 10, 'r');
}

test pixels_bgra8_swaps_rb
{
    array<uint8> $raw = [10, 20, 30, 255];
    Pixels $px = guard Pixels::from(PixelFormat::bgra8, 1, 1, $raw) else ($e) {
        die($e->message());
    }
    assert($px->rgba[0] == 30, 'r');
    assert($px->rgba[1] == 20, 'g');
    assert($px->rgba[2] == 10, 'b');
    assert($px->rgba[3] == 255, 'a');
}

test pixels_r8_expands_gray
{
    array<uint8> $raw = [77];
    Pixels $px = guard Pixels::from(PixelFormat::r8, 1, 1, $raw) else ($e) {
        die($e->message());
    }
    assert($px->rgba[0] == 77, 'r');
    assert($px->rgba[1] == 77, 'g');
    assert($px->rgba[2] == 77, 'b');
    assert($px->rgba[3] == 255, 'a');
}

test pixels_depth_is_unsupported
{
    array<uint8> $raw = [0, 0, 0, 0];
    result<Pixels, DumpError> $got = Pixels::from(PixelFormat::depth32f, 1, 1, $raw);
    assert($got->failed(), 'depth');
}

test pixels_png_roundtrip
{
    array<uint8> $raw = [
        255, 0, 0, 255,
        0, 255, 0, 255,
        0, 0, 255, 255,
        255, 255, 255, 255
    ];
    Pixels $px = guard Pixels::from(PixelFormat::rgba8, 2, 2, $raw) else ($e) {
        die($e->message());
    }
    $tmp = env::tmp();
    $ds = env::DS;
    $pid = env::pid();
    string $path = "{$tmp}{$ds}visu-pixels-{$pid}.png";
    guard $px->write($path) else ($e) {
        die($e->message());
    }
    string $file = guard io::readfile($path) else ($e) {
        die($e->message());
    }
    assert($file->byte(0) == 137, 'png mag');
    assert($file->byte(1) == 80, 'P');
    Pixels $loaded = guard Pixels::load($path) else ($e) {
        die($e->message());
    }
    io::remove($path);
    assert($loaded->width == 2, 'load w');
    assert($loaded->height == 2, 'load h');
    assert($loaded->rgba[0] == 255, 'load r');
    assert($loaded->rgba[1] == 0, 'load g');
    assert($loaded->rgba[5] == 255, 'load g1');
}

test dump_empty_render_target
{
    RenderTarget $rt = RenderTarget(64, 64);
    status<DumpError> $st = $rt->dump('empty.png');
    assert($st->failed(), 'empty');
    DumpError $e = $st->failure();
    string $msg = $e->message();
    assert($msg == 'dump: no color attachment', 'no color');
}

test pixels_size_mismatch
{
    array<uint8> $raw = [1, 2, 3];
    result<Pixels, DumpError> $got = Pixels::from(PixelFormat::rgba8, 1, 1, $raw);
    assert($got->failed(), 'mismatch');
}

test dump_imported_message
{
    DumpError $e = .imported;
    assert($e->message() == 'dump: imported texture', 'imported');
}
