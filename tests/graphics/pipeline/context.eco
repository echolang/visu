/**
 * RenderContext compensation lerp. No GPU.
 */

use visu::graphics::{Device, Pool, Frame, Pipeline, RenderContext, RenderTarget, TargetRef, TextureRef, TextureOptions};

test context_lerp_uses_compensation
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);

    RenderContext $start = RenderContext($gpu, $pipeline, $frame, $pool);
    assert($start->lerp(10.0f, 20.0f) == 10.0f, 'at tick');

    RenderContext $mid = RenderContext($gpu, $pipeline, $frame, $pool, 0.5f);
    assert($mid->lerp(10.0f, 20.0f) == 15.0f, 'halfway');

    RenderContext $end = RenderContext($gpu, $pipeline, $frame, $pool, 1.0f);
    assert($end->lerp(10.0f, 20.0f) == 20.0f, 'next tick');
}

test target_key_includes_size_and_depth_stencil
{
    TargetRef $t = TargetRef('x', 8, 8);
    visu::graphics::TargetKey $plain = visu::graphics::targetKey($t);
    assert(visu::graphics::targetKeyMatches($plain, $t), 'matches what it was built from');
    $t->depthStencil = true;
    assert(!visu::graphics::targetKeyMatches($plain, $t), 'depth stencil');
    visu::graphics::TargetKey $depth = visu::graphics::targetKey($t);
    $t->width = 16;
    assert(!visu::graphics::targetKeyMatches($depth, $t), 'size');
}

test target_key_includes_attachments_and_options
{
    TargetRef $t = TargetRef('x', 8, 8);
    visu::graphics::TargetKey $bare = visu::graphics::targetKey($t);
    TextureRef $c = TextureRef('x.attachment.color_a', 8, 8, TextureOptions());
    $t->colorAttachments->push($c);
    assert(!visu::graphics::targetKeyMatches($bare, $t), 'an attachment more');
    visu::graphics::TargetKey $rgba8 = visu::graphics::targetKey($t);
    assert(visu::graphics::targetKeyMatches($rgba8, $t), 'same attachment');
    $c->options = TextureOptions($format: .rgba16f);
    assert(!visu::graphics::targetKeyMatches($rgba8, $t), 'format');
}
