/**
 * Context compensation lerp. No GPU.
 */

use visu::graphics::{Pool, Frame, Pipeline, Context, Framebuffer, RenderTarget, TargetRef, TextureRef, TextureOptions};

test context_lerp_uses_compensation
{
    Pool $pool = Pool();
    Frame $frame = Frame();
    Framebuffer $fb = Framebuffer();
    RenderTarget $rt = RenderTarget(64, 64, $fb);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);

    Context $start = Context($pipeline, $frame, $pool);
    assert($start->lerp(10.0f, 20.0f) == 10.0f, 'at tick');

    Context $mid = Context($pipeline, $frame, $pool, 0.5f);
    assert($mid->lerp(10.0f, 20.0f) == 15.0f, 'halfway');

    Context $end = Context($pipeline, $frame, $pool, 1.0f);
    assert($end->lerp(10.0f, 20.0f) == 20.0f, 'next tick');
}

test target_fingerprint_includes_attachments
{
    TargetRef $t = TargetRef('x', 8, 8);
    string $plain = visu::graphics::targetFingerprint($t);
    $t->rboColor = true;
    string $color = visu::graphics::targetFingerprint($t);
    assert($plain != $color, 'rbo color');
    $t->rboDepthStencil = true;
    $t->rboColor = false;
    string $depth = visu::graphics::targetFingerprint($t);
    assert($color != $depth, 'rbo depth stencil');
    $t->width = 16;
    assert($depth != visu::graphics::targetFingerprint($t), 'size');
}

test target_fingerprint_includes_texture_options
{
    TargetRef $t = TargetRef('x', 8, 8);
    TextureRef $c = TextureRef('x.attachment.color_a', 8, 8, TextureOptions());
    $t->colorAttachments->push($c);
    string $linear = visu::graphics::targetFingerprint($t);
    $c->options = TextureOptions($min: .nearest, $mag: .nearest);
    string $nearest = visu::graphics::targetFingerprint($t);
    assert($linear != $nearest, 'filter');
}
