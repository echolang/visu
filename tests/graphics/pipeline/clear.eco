/**
 * ClearPassOptions field defaults. No GPU.
 */

use visu::math::Vec4;
use visu::graphics::ClearPassOptions;

test clear_pass_options_defaults
{
    ClearPassOptions $d = ClearPassOptions();
    assert($d->clearColor, 'color bit');
    assert($d->clearDepth, 'depth bit');
    assert($d->color->x == 0.0f, 'r');
    assert($d->color->y == 0.0f, 'g');
    assert($d->color->z == 0.0f, 'b');
    assert($d->color->w == 1.0f, 'a');
}

test clear_pass_options_with_color
{
    ClearPassOptions $o = ClearPassOptions(color: Vec4(0.25f, 0.5f, 0.75f, 1.0f));
    assert($o->clearColor, 'color bit');
    assert($o->clearDepth, 'depth bit');
    assert($o->color->x == 0.25f, 'r');
    assert($o->color->y == 0.5f, 'g');
    assert($o->color->z == 0.75f, 'b');
    assert($o->color->w == 1.0f, 'a');
}

test clear_pass_options_skip_depth
{
    ClearPassOptions $o = ClearPassOptions($clearDepth: false);
    assert($o->clearColor, 'color bit');
    assert(!$o->clearDepth, 'no depth');
}
