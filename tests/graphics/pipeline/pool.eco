/**
 * Pool allocation and tick GC against a real context.
 */

use visu::graphics::{
    Device, Pipeline, Pool, Frame, CallbackPass, TargetRef, TextureRef, IoSink,
    RenderContext, TextureOptions, RenderTarget, PipelineError, Mesh, Texture, PoolError,
    Pixels
};
use visu::os::{Window, WindowHints, init, terminate};

class Offscreen
{
    public TargetRef $target;

    public constructor(TargetRef $target)
    {
        $this->target = $target;
    }
}

function poolWindow(string $title) : Window
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    return Window($title, 64, 64, $hints);
}

function poolEnd(Pool $pool, Window $window, Device $device) : void
{
    $pool->destroy();
    $window->destroy();
    $device->shutdown();
    terminate();
}

#[group: "glfw"]
test pool_creates_complete_offscreen_target
{
    Window $window = poolWindow('pool');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'gbuffer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('gbuffer', 32, 32);
            $t->depthStencil = true;
            $pipe->createColor($t, 'albedo', TextureOptions());
            $io->writes($t);
            $f->set(Offscreen($t));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Offscreen $off = $ctx->frame->get<Offscreen>();
            RenderTarget $rt = guard $ctx->pool->getTarget($off->target) else ($e) {
                return .error(.pool($e));
            }
            assert($rt->width == 32, 'width');
            assert($rt->colors->count() == 1, 'color');
            assert($rt->depth != null, 'depth');
            assert($ctx->pool->hasTarget('gbuffer'), 'stored');
            assert($ctx->pool->hasTexture('gbuffer.attachment.color_albedo'), 'color name');
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    assert($pool->hasTarget('gbuffer'), 'lived');

    Frame $frame2 = Frame();
    Pipeline $next = Pipeline($pool, $frame2, $window->renderTarget());
    guard $next->execute(1) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    assert(!$pool->hasTarget('gbuffer'), 'collected');
    assert($pool->hasTarget('backbuffer'), 'imported lives');

    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_resizes_when_desc_changes
{
    Window $window = poolWindow('pool-resize');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'scene',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('scene', 16, 16);
            $pipe->createColor($t, 'color', TextureOptions());
            $io->writes($t);
            $f->set(Offscreen($t));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Offscreen $off = $ctx->frame->get<Offscreen>();
            RenderTarget $rt = guard $ctx->pool->getTarget($off->target) else ($e) {
                return .error(.pool($e));
            }
            assert($rt->width == 16, 'first');
            $off->target->width = 48;
            $off->target->height = 24;
            RenderTarget $again = guard $ctx->pool->getTarget($off->target) else ($e) {
                return .error(.pool($e));
            }
            assert($again->width == 48, 'resized');
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_recreates_when_attachments_change
{
    Window $window = poolWindow('pool-fp');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'scene',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('scene', 16, 16);
            $pipe->createColor($t, 'color', TextureOptions());
            $io->writes($t);
            $f->set(Offscreen($t));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Offscreen $off = $ctx->frame->get<Offscreen>();
            RenderTarget $first = guard $ctx->pool->getTarget($off->target) else ($e) {
                return .error(.pool($e));
            }
            string $before = visu::graphics::targetFingerprint($off->target);
            $off->target->depthStencil = true;
            assert($before != visu::graphics::targetFingerprint($off->target), 'fingerprint changed');
            RenderTarget $again = guard $ctx->pool->getTarget($off->target) else ($e) {
                return .error(.pool($e));
            }
            assert($again->depth != null, 'depth after change');
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_caches_quad_by_name
{
    Window $window = poolWindow('pool-cache');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Mesh $a = $pool->cache<Mesh>('quadva', function() : Mesh {
        return .quad($device);
    });
    Mesh $b = $pool->cache<Mesh>('quadva', function() : Mesh {
        return .quad($device);
    });
    assert($a == $b, 'same name same mesh');
    Mesh $c = $pool->cache<Mesh>('ibl_quad_va', function() : Mesh {
        return .quad($device);
    });
    assert($a != $c, 'different name different mesh');
    poolEnd($pool, $window, $device);
}

class ColorTex
{
    public TextureRef $tex;
    public TargetRef $target;

    public constructor(TextureRef $tex, TargetRef $target)
    {
        $this->tex = $tex;
        $this->target = $target;
    }
}

#[group: "glfw"]
test pool_get_texture_does_not_allocate
{
    Window $window = poolWindow('pool-gettex');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'gbuffer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('gbuffer', 16, 16);
            TextureRef $c = $pipe->createColor($t, 'albedo', TextureOptions());
            $io->writes($t);
            $f->set(ColorTex($c, $t));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            ColorTex $held = $ctx->frame->get<ColorTex>();
            result<Texture, PoolError> $before = $ctx->pool->getTexture($held->tex);
            assert($before->failed(), 'not allocated yet');
            RenderTarget $rt = guard $ctx->pool->getTarget($held->target) else ($e) {
                return .error(.pool($e));
            }
            Texture $tex = guard $ctx->pool->getTexture($held->tex) else ($e) {
                return .error(.pool($e));
            }
            assert($tex->desc->width == 16, 'color size');
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_keeps_target_when_attachment_is_read
{
    Window $window = poolWindow('pool-hist');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'write',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('gbuffer', 16, 16);
            TextureRef $c = $pipe->createColor($t, 'albedo', TextureOptions());
            $io->writes($t);
            $f->set(ColorTex($c, $t));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            ColorTex $held = $ctx->frame->get<ColorTex>();
            RenderTarget $rt = guard $ctx->pool->getTarget($held->target) else ($e) {
                return .error(.pool($e));
            }
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }

    $pool->setCurrentTick(1);
    TextureRef $albedo = TextureRef('gbuffer.attachment.color_albedo', 16, 16, TextureOptions());
    Texture $tex = guard $pool->getTexture($albedo) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    $pool->collect();
    assert($tex->desc->width == 16, 'history');
    assert($pool->hasTarget('gbuffer'), 'parent lived');
    assert($pool->hasTexture('gbuffer.attachment.color_albedo'), 'color lived');

    poolEnd($pool, $window, $device);
}

class TwoTargets
{
    public TargetRef $a;
    public TargetRef $b;

    public constructor(TargetRef $a, TargetRef $b)
    {
        $this->a = $a;
        $this->b = $b;
    }
}

#[group: "glfw"]
test pool_two_mrts_both_complete
{
    Window $window = poolWindow('pool-mrt');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    $pipeline->add(CallbackPass(
        'mrts',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $a = $pipe->createTarget('a', 16, 16);
            $pipe->createColor($a, 'c0', TextureOptions());
            $pipe->createColor($a, 'c1', TextureOptions());
            TargetRef $b = $pipe->createTarget('b', 16, 16);
            $pipe->createColor($b, 'c0', TextureOptions());
            $pipe->createColor($b, 'c1', TextureOptions());
            $io->writes($a);
            $io->writes($b);
            $f->set(TwoTargets($a, $b));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            TwoTargets $held = $ctx->frame->get<TwoTargets>();
            RenderTarget $ra = guard $ctx->pool->getTarget($held->a) else ($e) {
                return .error(.pool($e));
            }
            RenderTarget $rb = guard $ctx->pool->getTarget($held->b) else ($e) {
                return .error(.pool($e));
            }
            assert($ra->colors->count() == 2, 'a colors');
            assert($rb->colors->count() == 2, 'b colors');
            return .ok;
        }
    ));

    guard $pipeline->execute(0) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_import_of_owned_attachment_stays_owned
{
    Window $window = poolWindow('pool-owned');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    Frame $sceneFrame = Frame();
    Pipeline $scene = Pipeline($pool, $sceneFrame, $window->renderTarget());
    TargetRef $t = $scene->createTarget('scene', 8, 8);
    TextureRef $c = $scene->createColor($t, 'color', TextureOptions());
    guard $pool->getTarget($t) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    Texture $tex = guard $pool->getTexture($c) else ($e) {
        poolEnd($pool, $window, $device);
        die($e->message());
    }
    Frame $presentFrame = Frame();
    Pipeline $present = Pipeline($pool, $presentFrame, $window->renderTarget());
    $present->importTexture($c->name, $tex);
    assert(!$tex->destroyed(), 'live before reap');
    $pool->reap();
    assert($tex->destroyed(), 'reap destroyed the owned attachment');
    assert(!$pool->hasTexture($c->name), 'name dropped');
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_collect_forgets_import_without_destroy
{
    Window $window = poolWindow('pool-import');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    array<uint8> $rgba = [255, 0, 0, 255];
    Texture $leaf = Texture($device, 'leaf', Pixels(1, 1, $rgba));
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());
    $pipeline->importTexture('leaf', $leaf);
    $pool->setCurrentTick(1);
    $pool->collect();
    assert(!$pool->hasTexture('leaf'), 'forgotten');
    assert(!$leaf->destroyed(), 'caller still owns it');
    $leaf->destroy();
    poolEnd($pool, $window, $device);
}

#[group: "glfw"]
test pool_reap_forgets_imported_target
{
    Window $window = poolWindow('pool-bb');
    Device $device = Device();
    guard $window->initialize($device) else ($e) {
        $device->shutdown();
        terminate();
        die($e->message());
    }

    Pool $pool = Pool($device);
    RenderTarget $rt = $window->renderTarget();
    int32 $w = $rt->width;
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    assert($pool->hasTarget('backbuffer'), 'imported');
    $pool->setCurrentTick(1);
    $pool->collect();
    assert(!$pool->hasTarget('backbuffer'), 'forgotten');
    assert($rt->width == $w, 'window target lived');
    poolEnd($pool, $window, $device);
}
