/**
 * Pipeline setup/execute order and I/O scheduling. No GPU calls.
 */

use visu::graphics::{
    Pipeline, Pool, Frame, CallbackPass, BackbufferData, TargetRef,
    TextureRef, RenderTarget, Device, PipelineError,
    TextureOptions, IoSink, RenderContext
};

class Log
{
    public array<string> $names;

    public constructor()
    {
        $this->names = array<string>();
    }
}

class Marker
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }
}

test pipeline_publishes_backbuffer
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    assert($frame->has<BackbufferData>(), 'backbuffer');
    BackbufferData $bb = $frame->get<BackbufferData>();
    assert($bb->target->name == 'backbuffer', 'name');
    assert($bb->target->imported, 'imported');
}

test pipeline_setup_sees_earlier_mailbox
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);

    $pipeline->add(CallbackPass(
        'producer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $f->set(Marker(9));
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'consumer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            Marker $m = $f->get<Marker>();
            assert($m->n == 9, 'mailbox');
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
}

test pipeline_execute_order
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    Log $log = Log();
    $frame->set($log);

    $pipeline->add(CallbackPass(
        'a',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {},
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('a');
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'b',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {},
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('b');
            return .ok;
        }
    ));

    visu::profile::Profiler $prof = visu::profile::Profiler();
    visu::profile::installProfiler($prof);
    $prof->beginFrame();
    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
    $prof->endFrame();
    Log $out = $frame->get<Log>();
    assert($out->names->count() == 2, 'two');
    assert($out->names[0] == 'a', 'first');
    assert($out->names[1] == 'b', 'second');
    #[if: !VISU_RELEASE]
    visu::profile::FrameProfile $timed = guard $prof->complete() else {
        die('no frame profile');
    }
    visu::profile::ScopeNode $root = $timed->root();
    assert($root->children->count() == 2, 'timed');
    assert($timed->nodes[$root->children[0] as usize]->name == 'a', 'name a');
    assert($timed->nodes[$root->children[1] as usize]->name == 'b', 'name b');
    assert($timed->nodes[$root->children[0] as usize]->cpuNs >= 0.0, 'cpu');
    #[end]
}

test pipeline_unread_created_target_is_an_error
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);

    $pipeline->add(CallbackPass(
        'orphan',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            TargetRef $t = $pipe->createTarget('orphan', 8, 8);
            $io->reads( $t);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    status<PipelineError> $r = $pipeline->execute( 0);
    assert($r->failed(), 'unread');
}

test pipeline_imported_backbuffer_readable_without_writer
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);

    $pipeline->add(CallbackPass(
        'sample',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            BackbufferData $bb = $f->get<BackbufferData>();
            $io->reads( $bb->target);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
}

test pipeline_reader_of_shared_target_waits_for_writer
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    $frame->set(Log());
    TargetRef $x = $pipeline->createTarget('x', 8, 8);

    $pipeline->add(CallbackPass(
        'reader',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->reads( $x);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('reader');
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'writer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->writes( $x);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('writer');
            return .ok;
        }
    ));

    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
    Log $out = $frame->get<Log>();
    assert($out->names->count() == 2, 'two');
    assert($out->names[0] == 'writer', 'writer first');
    assert($out->names[1] == 'reader', 'reader second');
}

test pipeline_two_writers_keep_add_order
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    $frame->set(Log());

    $pipeline->add(CallbackPass(
        'clear',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            BackbufferData $bb = $f->get<BackbufferData>();
            $io->writes( $bb->target);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('clear');
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'draw',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            BackbufferData $bb = $f->get<BackbufferData>();
            $io->writes( $bb->target);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('draw');
            return .ok;
        }
    ));

    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
    Log $out = $frame->get<Log>();
    assert($out->names[0] == 'clear', 'clear first');
    assert($out->names[1] == 'draw', 'draw second');
}

test pipeline_cycle_is_an_error
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    TargetRef $x = $pipeline->createTarget('x', 8, 8);
    TargetRef $y = $pipeline->createTarget('y', 8, 8);

    $pipeline->add(CallbackPass(
        'a',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->reads( $x);
            $io->writes( $y);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'b',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->reads( $y);
            $io->writes( $x);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            return .ok;
        }
    ));

    status<PipelineError> $r = $pipeline->execute( 0);
    assert($r->failed(), 'cycle');
}

test pipeline_writing_target_happens_before_reading_color
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    $frame->set(Log());
    TargetRef $g = $pipeline->createTarget('gbuffer', 8, 8);
    TextureRef $color = $pipeline->createColor($g, 'albedo', TextureOptions());

    $pipeline->add(CallbackPass(
        'reader',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->reads( $color);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('reader');
            return .ok;
        }
    ));

    $pipeline->add(CallbackPass(
        'writer',
        setup: function(Pipeline $pipe, Frame $f, IoSink $io) : void {
            $io->writes( $g);
        },
        execute: function(RenderContext $ctx) : status<PipelineError> {
            Log $log = $ctx->frame->get<Log>();
            $log->names->push('writer');
            return .ok;
        }
    ));

    guard $pipeline->execute( 0) else ($e) {
        die($e->message());
    }
    Log $out = $frame->get<Log>();
    assert($out->names[0] == 'writer', 'target write first');
    assert($out->names[1] == 'reader', 'color read second');
}

#[tests: expects death]
test pipeline_duplicate_name_dies
{
    Device $gpu = Device();
    Pool $pool = Pool($gpu);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    TargetRef $a = $pipeline->createTarget('same', 8, 8);
    TargetRef $b = $pipeline->createTarget('same', 8, 8);
}
