/**
 * GBufferId codes lock to the shader constants in gbuffer_id.glsl.
 */

use visu::graphics::GBufferId;

test gbuffer_id_codes
{
    assert(GBufferId::none->code() == 0, 'none');
    assert(GBufferId::opaque->code() == 1, 'opaque');
    assert(GBufferId::terrain->code() == 2, 'terrain');
    assert(GBufferId::grass->code() == 3, 'grass');
    assert(GBufferId::foliage->code() == 4, 'foliage');
    assert(GBufferId::unlit->code() == 5, 'unlit');
}
