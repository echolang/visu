/**
 * Hidden window + Gpu for glfw-group tests. One init/teardown pair
 * per test; call end() before the function returns.
 */

use visu::os::{Window, WindowHints, init, terminate};
use visu::graphics::Gpu;

class GlContext
{
    public Window $window;
    public Gpu $gpu;

    public constructor(Window $window)
    {
        $this->window = $window;
        $this->gpu = Gpu();
        guard $this->window->initialize($this->gpu) else ($e) {
            terminate();
            die($e->message());
        }
    }

    public function end() : void
    {
        $this->window->destroy();
        terminate();
    }
}

function glHidden(string $title, int32 $width = 64, int32 $height = 64) : GlContext
{
    guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window($title, $width, $height, $hints);
    return GlContext($window);
}

function readRgba(Window $window) : array<uint8>
{
    int32 $w = $window->framebufferWidth();
    int32 $h = $window->framebufferHeight();
    usize $n = ($w * $h * 4) as usize;
    array<uint8> $pixels = array<uint8>();
    $pixels->reserve($n);
    usize $i = 0;

    while ($i < $n) {
        $pixels[] = 0;
        $i = $i + 1;
    }

    gl::Finish();
    gl::ReadPixels(0, 0, $w, $h, gl::RGBA, gl::UNSIGNED_BYTE, ptr<uint8>(&$pixels[0]));
    return $pixels;
}
