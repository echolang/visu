/**
 * ShaderLoader: includes and define injection. No GL context.
 */

use visu::graphics::{ShaderLoader, ShaderError, Define};

function testShaderDir() : string
{
    return 'tests/resources/shaders';
}

test loader_expands_include
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    string $src = "#version 330 core\n\n#include \"random.glsl\"\n\nvoid main()\n{\n}\n";
    string $out = guard $loader->process($src) else ($e) {
        die($e->message());
    }

    assert($out->contains('random(vec2 st)'), 'expanded random');
    assert(!$out->contains('#include'), 'no leftover include');
}

test loader_missing_include
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    string $src = "#version 330 core\n#include \"does_not_exist.glsl\"\n";
    result<string, ShaderError> $r = $loader->process($src);
    assert($r->failed(), 'missing include is an error');
}

test loader_extra_include_path
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    $loader->addInclude('tests/resources/shaders/extra_include');
    string $src = "#version 330 core\n#include \"hash.glsl\"\n";
    string $out = guard $loader->process($src) else ($e) {
        die($e->message());
    }

    assert($out->contains('vec3 hash_color(uint x)'), 'hash from extra path');
    assert(!$out->contains('#include'), 'no leftover include');
}

test loader_include_recursion
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    $loader->addInclude('tests/resources/shaders/extra_include');
    string $src = "#version 330 core\n#include \"recursive_include.glsl\"\n";
    string $out = guard $loader->process($src) else ($e) {
        die($e->message());
    }

    assert($out->contains('vec3 hash_color(uint x)'), 'nested hash');
    assert($out->contains('// Testing recusion'), 'outer comment');
    assert(!$out->contains('#include'), 'no leftover include');
}

test loader_define_injection
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    array<Define> $defs = [Define('NUM_OF_ITERATIONS', 42)];
    string $src = "#version 330 core\nfor(int i = 0; i < NUM_OF_ITERATIONS; i++){\n    // something\n}\n";
    string $out = guard $loader->process($src, $defs) else ($e) {
        die($e->message());
    }

    assert($out->contains("#version 330 core\n#define NUM_OF_ITERATIONS 42"), 'define after version');
}

#[if: VISU_BACKEND_METAL]
test loader_define_without_version
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    array<Define> $defs = [Define('NUM_OF_ITERATIONS', 42)];
    string $out = guard $loader->process('foo', $defs) else ($e) {
        die($e->message());
    }
    assert($out->contains("#define NUM_OF_ITERATIONS 42\nfoo"), 'define at start');
}
#[else]
test loader_define_without_version
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    array<Define> $defs = [Define('NUM_OF_ITERATIONS', 42)];
    result<string, ShaderError> $r = $loader->process('foo', $defs);
    assert($r->failed(), 'no version is an error');
}
#[end]

test loader_define_version_without_newline
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    array<Define> $defs = [Define('NUM_OF_ITERATIONS', 42)];
    string $out = guard $loader->process('#version 330 core', $defs) else ($e) {
        die($e->message());
    }

    assert($out->contains("#version 330 core\n#define NUM_OF_ITERATIONS 42"), 'define after version at eof');
}

test loader_include_cycle
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    $loader->addBuiltin('loop.glsl', "#include \"loop.glsl\"\n");
    string $src = "#version 330 core\n#include \"loop.glsl\"\n";
    result<string, ShaderError> $r = $loader->process($src);
    assert($r->failed(), 'cycle is an error');
    ShaderError $e = $r->failure();
    bool $cycle = match ($e) {
        ShaderError::includeCycle($path) => true,
        else => false,
    };
    assert($cycle, 'includeCycle case');
}

test loader_unterminated_include
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    string $src = "#version 330 core\n#include \"no-end\n";
    result<string, ShaderError> $r = $loader->process($src);
    assert($r->failed(), 'unterminated is an error');
    ShaderError $e = $r->failure();
    bool $bad = match ($e) {
        ShaderError::unterminatedInclude => true,
        else => false,
    };
    assert($bad, 'unterminatedInclude case');
}

test loader_builtin_visu_constants
{
    ShaderLoader $loader = ShaderLoader(testShaderDir());
    $loader->addBuiltin('visu/constants.glsl', 'const float PI = 3.14159265359;');
    string $src = "#version 330 core\n#include \"visu/constants.glsl\"\n";
    string $out = guard $loader->process($src) else ($e) {
        die($e->message());
    }

    assert($out->contains('const float PI'), 'builtin resolved');
}
