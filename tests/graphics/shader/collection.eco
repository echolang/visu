/**
 * ShaderCollection bookkeeping (no GPU) and permutation load (glfw).
 */

use std::env;
use std::io;
use visu::graphics::{
    Device, ShaderCollection, ShaderFile, ShaderError, Define, ShaderKind,
    ShaderStem, shaderStem, shaderSuffix
};

function mkdirOk(string $dir) : void
{
    guard io::mkdir($dir) else ($e) {
        if ($e->exists()) {
            return;
        }

        die($e->message());
    }
}

function mkdirScan(string $tag) : string
{
    $tmp = env::tmp();
    string $ds = env::DS;
    string $dir = "{$tmp}{$ds}visu-ss-{$tag}";
    mkdirOk($dir);
    return $dir;
}

function writeStage(string $dir, string $stem, string $stage) : void
{
    string $ext = shaderSuffix();
    string $ds = env::DS;
    string $path = "{$dir}{$ds}{$stem}.{$stage}.{$ext}";
    usize $n = guard io::writefile($path, "// scan fixture\n") else ($e) {
        die("{$path}: {$e->message()}");
    }
}

function writeFile(string $dir, string $name, string $text) : void
{
    string $ds = env::DS;
    string $path = "{$dir}{$ds}{$name}";
    usize $n = guard io::writefile($path, $text) else ($e) {
        die($e->message());
    }
}

test collection_define_permutations
{
    string $dir = mkdirScan('defineperm');
    writeStage($dir, 'prog', 'vert');
    writeStage($dir, 'prog', 'frag');
    writeStage($dir, 'prog+basic', 'vert');
    writeStage($dir, 'prog+basic', 'frag');
    writeStage($dir, 'prog+advanced', 'vert');
    writeStage($dir, 'prog+advanced', 'frag');
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, $dir);
    guard $shaders->scan() else ($e) {
        die($e->message());
    }

    array<Define> $basic = [Define('DEFINE_A', 1), Define('DEFINE_B', 0)];
    array<Define> $advanced = [Define('DEFINE_A', 1), Define('DEFINE_B', 1), Define('DEFINE_C', 'test')];
    $basicRef = $shaders->definePermutation('prog', 'basic', $basic);
    $advancedRef = $shaders->definePermutation('prog', 'advanced', $advanced);

    assert($basicRef->name == 'prog', 'basic name');
    string $basicVar = guard $basicRef->variant else {
        die('basic variant');
    }
    assert($basicVar == 'basic', 'basic variant');
    string $advVar = guard $advancedRef->variant else {
        die('advanced variant');
    }
    assert($advVar == 'advanced', 'advanced variant');

    assert($shaders->hasPermutations('prog'), 'has');
    assert(!$shaders->hasPermutations('nonexistent'), 'missing shader');

    array<string> $names = $shaders->permutations('prog');
    assert($names->count() == 2, 'two variants');

    $looked = guard $shaders->permutation('prog', 'basic') else ($e) {
        die($e->message());
    }
    assert($looked == $basicRef, 'same slot');

    $base = guard $shaders->shader('prog') else ($e) {
        die($e->message());
    }
    $fromBase = guard $base->permutation('basic') else ($e) {
        die($e->message());
    }
    assert($fromBase == $basicRef, 'from base');

    $nested = $basicRef->permutation('advanced');
    assert($nested->failed(), 'no nested variants');
}

test collection_empty_permutations
{
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, 'tests/resources/shaders');
    assert(!$shaders->hasPermutations('empty'), 'none');
    array<string> $none = $shaders->permutations('nonexistent');
    assert($none->empty(), 'unknown shader');
}

test collection_duplicate_register
{
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, 'tests/resources/shaders');
    array<ShaderFile> $files = [
        ShaderFile(ShaderKind::vertex, 'triangle.vert.spv'),
        ShaderFile(ShaderKind::fragment, 'triangle.frag.spv')
    ];
    $first = guard $shaders->register('triangle', $files) else ($e) {
        die($e->message());
    }
    assert($first->name == 'triangle', 'name');
    $looked = guard $shaders->shader('triangle') else ($e) {
        die($e->message());
    }
    assert($looked == $first, 'same slot');
    $again = $shaders->register('triangle', $files);
    assert($again->failed(), 'duplicate');
    $missing = $shaders->shader('nope');
    assert($missing->failed(), 'missing');
}

test collection_scan_registers_named_programs
{
    string $dir = mkdirScan('prog');
    writeStage($dir, 'a', 'vert');
    writeStage($dir, 'a', 'frag');
    writeFile($dir, 'notes.txt', "skip\n");
    writeFile($dir, 'lib.inc', "skip\n");
    string $ds = env::DS;
    string $nested = "{$dir}{$ds}nested";
    mkdirOk($nested);
    writeStage($nested, 'b', 'vert');
    writeStage($nested, 'b', 'frag');
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, $dir);
    guard $shaders->scan() else ($e) {
        die($e->message());
    }
    $a = guard $shaders->shader('a') else ($e) {
        die($e->message());
    }
    assert($a->name == 'a', 'stem name');
    assert($a->files->count() == 2, 'vert+frag');
    $nestedRef = guard $shaders->shader('nested/b') else ($e) {
        die($e->message());
    }
    assert($nestedRef->name == 'nested/b', 'nested name');
    assert($nestedRef->files->count() == 2, 'nested stages');
    $notes = $shaders->shader('notes');
    assert($notes->failed(), 'notes skipped');
    $lib = $shaders->shader('lib');
    assert($lib->failed(), 'include skipped');
}

test collection_scan_skips_registered
{
    string $dir = mkdirScan('skipreg');
    writeStage($dir, 'a', 'vert');
    writeStage($dir, 'a', 'frag');
    string $ds = env::DS;
    string $nested = "{$dir}{$ds}nested";
    mkdirOk($nested);
    writeStage($nested, 'b', 'vert');
    writeStage($nested, 'b', 'frag');
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, $dir);
    array<ShaderFile> $files = [ShaderFile(ShaderKind::vertex, 'already.vert.spv')];
    $first = guard $shaders->register('a', $files) else ($e) {
        die($e->message());
    }
    guard $shaders->scan() else ($e) {
        die($e->message());
    }
    $looked = guard $shaders->shader('a') else ($e) {
        die($e->message());
    }
    assert($looked == $first, 'same slot');
    assert($first->files->count() == 1, 'explicit files kept');
    assert($first->files[0]->path == 'already.vert.spv', 'path kept');
    $nestedRef = guard $shaders->shader('nested/b') else ($e) {
        die($e->message());
    }
    assert($nestedRef->files->count() == 2, 'unregistered still scanned');
}

test collection_scan_missing_directory
{
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, 'tests/resources/shaders');
    status<ShaderError> $r = $shaders->scan('definitely-missing-visu-shader-scan');
    assert($r->failed(), 'missing scan dir');
    ShaderError $e = $r->failure();
    assert($e->message()->contains('could not scan'), 'scan message');
}

test collection_scan_optional_root
{
    string $dir = mkdirScan('optroot');
    writeStage($dir, 'a', 'vert');
    writeStage($dir, 'a', 'frag');
    string $ds = env::DS;
    string $nested = "{$dir}{$ds}nested";
    mkdirOk($nested);
    writeStage($nested, 'b', 'vert');
    writeStage($nested, 'b', 'frag');
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, $dir);
    guard $shaders->scan($nested) else ($e) {
        die($e->message());
    }
    $b = guard $shaders->shader('b') else ($e) {
        die($e->message());
    }
    assert($b->name == 'b', 'scan root is the name root');
    $nestedName = $shaders->shader('nested/b');
    assert($nestedName->failed(), 'prefix is the scan root');
    $a = $shaders->shader('a');
    assert($a->failed(), 'parent not scanned');
}

test shader_stem_parses_compute
{
    string $ext = shaderSuffix();
    ShaderStem? $maybe = shaderStem("terrain_lod.comp.{$ext}", $ext);
    ShaderStem $stem = guard $maybe else {
        die('compute stem');
    }
    assert($stem->kind == ShaderKind::compute, 'kind');
    assert($stem->name == 'terrain_lod', 'name');
    assert($stem->variant == null, 'no variant');
}

test collection_scan_compute_only_is_skipped_by_load
{
    string $dir = mkdirScan('componly');
    writeStage($dir, 'lod', 'comp');
    Device $device = Device();
    ShaderCollection $shaders = ShaderCollection($device, $dir);
    guard $shaders->scan() else ($e) {
        die($e->message());
    }
    $ref = guard $shaders->shader('lod') else ($e) {
        die($e->message());
    }
    assert($ref->name == 'lod', 'name');
    assert($ref->files->count() == 1, 'one stage');
    assert($ref->files[0]->kind == ShaderKind::compute, 'kind');
    guard $shaders->load() else ($e) {
        die($e->message());
    }
}

#[if: os != darwin || VISU_BACKEND_VULKAN]
#[group: "glfw"]
test collection_get_and_permutations
{
    GpuContext $gpu = gpuHidden('shader-col');
    ShaderCollection $shaders = ShaderCollection($gpu->device, shaderDir());
    guard $shaders->scan() else ($e) {
        $gpu->end();
        die($e->message());
    }

    $tri = guard $shaders->shader('triangle') else ($e) {
        $gpu->end();
        die($e->message());
    }

    $base = guard $shaders->load('triangle') else ($e) {
        $gpu->end();
        die($e->message());
    }
    assert(!$base->destroyed(), 'base linked');
    $hot = $shaders->program('triangle');
    assert($hot->id == $base->id, 'program');
    $viaLoad = guard $tri->load() else ($e) {
        $gpu->end();
        die($e->message());
    }
    assert($viaLoad->id == $base->id, 'load');

    array<Define> $a = [Define('TEST', 1)];
    array<Define> $b = [Define('TEST', 2)];
    $ra = $shaders->definePermutation('triangle', 'a', $a);
    $rb = $shaders->definePermutation('triangle', 'b', $b);

    $pa = guard $ra->load() else ($e) {
        $shaders->destroy();
        $gpu->end();
        die($e->message());
    }
    $pb = guard $rb->load() else ($e) {
        $shaders->destroy();
        $gpu->end();
        die($e->message());
    }

    assert($pa->id != $pb->id, 'distinct programs');
    assert(!$pa->destroyed() && !$pb->destroyed(), 'variants linked');

    $missing = $shaders->permutation('triangle', 'nope');
    assert($missing->failed(), 'unknown variant');

    $noDef = $shaders->permutation('ghost', 'a');
    assert($noDef->failed(), 'unknown shader permutation');

    $tri->forget();
    assert($base->destroyed(), 'old program dead');
    assert($pa->destroyed(), 'variant dropped with base');
    $again = guard $tri->load() else ($e) {
        $shaders->destroy();
        $gpu->end();
        die($e->message());
    }
    assert(!$again->destroyed(), 'new program');

    $pa2 = guard $ra->load() else ($e) {
        $shaders->destroy();
        $gpu->end();
        die($e->message());
    }
    assert(!$pa2->destroyed(), 'variant recompiled');
    assert($pa2 != $pa, 'variant new object');

    $shaders->destroy();
    $gpu->end();
}
#[end]
