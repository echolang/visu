/**
 * ShaderStage and ShaderProgram against a real GL context.
 */

use visu::os::{Window, WindowHints, init, terminate};
use visu::graphics::{
    Gpu, ShaderStage, ShaderProgram, ShaderKind, ShaderError,
    Mesh, VertexLayout, Raster, GpuPass, COLOR_BUFFER_BIT
};
use visu::math::Vec4;

#[if: VISU_BACKEND_METAL]
#[else]
#[group: "glfw"]
test stage_compile
{
    bool $booted = guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('stage', 64, 64, $hints);
    Gpu $state = Gpu();
    bool $ready = guard $window->initialize($state) else ($e) {
        terminate();
        die($e->message());
    }

    ShaderStage $shader = ShaderStage($state, .vertex);
    assert(!$shader->compiled(), 'not compiled');
    $shader->source("#version 330\nvoid main() { }\n");
    bool $ok = guard $shader->compile() else ($e) {
        $shader->destroy();
        $window->destroy();
        terminate();
        die($e->message());
    }
    assert($shader->compiled(), 'compiled');
    $shader->destroy();
    $window->destroy();
    terminate();
}

#[group: "glfw"]
test program_link
{
    bool $booted = guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('program', 64, 64, $hints);
    Gpu $state = Gpu();
    bool $ready = guard $window->initialize($state) else ($e) {
        terminate();
        die($e->message());
    }

    ShaderProgram $program = ShaderProgram($state);
    ShaderStage $vs = ShaderStage($state, .vertex, "#version 330 core\nlayout (location = 0) in vec3 position;\nlayout (location = 1) in vec3 color;\nout vec4 pcolor;\nvoid main()\n{\n    pcolor = vec4(color, 1.0);\n    gl_Position = vec4(position, 1.0);\n}\n");
    ShaderStage $fs = ShaderStage($state, .fragment, "#version 330 core\nout vec4 fragment_color;\nin vec4 pcolor;\nvoid main()\n{\n    fragment_color = pcolor;\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('triangle') else ($e) {
        $program->destroy();
        $window->destroy();
        terminate();
        die($e->message());
    }
    assert($program->linked(), 'linked');
    $program->bind();
    $program->set('u_unused', Vec4(1.0f, 0.0f, 0.0f, 1.0f));
    $program->destroy();
    $window->destroy();
    terminate();
}

struct UploadParams
{
    public Vec4 $color;
}

#[group: "glfw"]
test program_upload_vec4_array
{
    GlContext $gl = glHidden('program-upload');
    $gl->window->renderTarget()->preparePass();

    ShaderProgram $program = ShaderProgram($gl->gpu);
    ShaderStage $vs = ShaderStage($gl->gpu, .vertex, "#version 330 core\nlayout (location = 0) in vec3 aPos;\nlayout (location = 1) in vec2 aUv;\nout vec2 vUv;\nvoid main()\n{\n    gl_Position = vec4(aPos, 1.0);\n    vUv = aUv;\n}\n");
    ShaderStage $fs = ShaderStage($gl->gpu, .fragment, "#version 330 core\nin vec2 vUv;\nout vec4 FragColor;\nuniform vec4 QuadParams[1];\nvoid main()\n{\n    FragColor = vec4(vUv, QuadParams[0].b, 1.0);\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('upload') else ($e) {
        $program->destroy();
        $gl->end();
        die($e->message());
    }

    GpuPass $pipe = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
    Mesh $quad = .quad($gl->gpu);
    $gl->gpu->clearColor(0.0f, 1.0f, 0.0f, 1.0f);
    $gl->gpu->clear(COLOR_BUFFER_BIT);
    $pipe->bind();
    $program->bindSlot(0, 'QuadParams');
    $program->upload(UploadParams(Vec4(0.0f, 0.0f, 0.5f, 1.0f)));
    $quad->draw($pipe->layout);

    array<uint8> $pixels = readRgba($gl->window);
    uint32 $err = gl::GetError();
    uint8 $r = $pixels[0];
    uint8 $g = $pixels[1];
    uint8 $b = $pixels[2];

    $quad->destroy();
    $program->destroy();
    $gl->end();

    assert($err == gl::NO_ERROR, 'gl error');
    assert($r < 16, 'bottom-left r');
    assert($g < 16, 'bottom-left g');
    assert($b > 100 && $b < 160, 'bottom-left b');
}

struct ExtraParams
{
    public Vec4 $color;
}

#[if: os != darwin]
#[group: "glfw"]
test program_upload_two_slots
{
    GlContext $gl = glHidden('program-two-slots');
    $gl->window->renderTarget()->preparePass();

    ShaderProgram $program = ShaderProgram($gl->gpu);
    ShaderStage $vs = ShaderStage($gl->gpu, .vertex, "#version 330 core\nlayout (location = 0) in vec3 aPos;\nlayout (location = 1) in vec2 aUv;\nout vec2 vUv;\nvoid main()\n{\n    gl_Position = vec4(aPos, 1.0);\n    vUv = aUv;\n}\n");
    ShaderStage $fs = ShaderStage($gl->gpu, .fragment, "#version 330 core\nin vec2 vUv;\nout vec4 FragColor;\nuniform vec4 QuadParams[1];\nuniform vec4 ExtraParams[1];\nvoid main()\n{\n    FragColor = vec4(ExtraParams[0].r, 0.0, QuadParams[0].b, 1.0);\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('two-slots') else ($e) {
        $program->destroy();
        $gl->end();
        die($e->message());
    }

    GpuPass $pipe = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
    Mesh $quad = .quad($gl->gpu);
    $gl->gpu->clearColor(0.0f, 1.0f, 0.0f, 1.0f);
    $gl->gpu->clear(COLOR_BUFFER_BIT);
    $pipe->bind();
    $program->bindSlot(0, 'QuadParams');
    $program->bindSlot(1, 'ExtraParams');
    $program->upload(UploadParams(Vec4(0.0f, 0.0f, 0.5f, 1.0f)));
    $program->upload(ExtraParams(Vec4(0.5f, 0.0f, 0.0f, 1.0f)), slot: 1);
    $quad->draw($pipe->layout);

    array<uint8> $pixels = readRgba($gl->window);
    uint32 $err = gl::GetError();
    uint8 $r = $pixels[0];
    uint8 $g = $pixels[1];
    uint8 $b = $pixels[2];

    $quad->destroy();
    $program->destroy();
    $gl->end();

    assert($err == gl::NO_ERROR, 'gl error');
    assert($r > 100 && $r < 160, 'bottom-left r');
    assert($g < 16, 'bottom-left g');
    assert($b > 100 && $b < 160, 'bottom-left b');
}
#[end]

#[if: os != darwin]
#[group: "glfw"]
test program_upload_std140_block
{
    GlContext $gl = glHidden('program-std140');
    $gl->window->renderTarget()->preparePass();

    ShaderProgram $program = ShaderProgram($gl->gpu);
    ShaderStage $vs = ShaderStage($gl->gpu, .vertex, "#version 330 core\nlayout (location = 0) in vec3 aPos;\nlayout (location = 1) in vec2 aUv;\nout vec2 vUv;\nvoid main()\n{\n    gl_Position = vec4(aPos, 1.0);\n    vUv = aUv;\n}\n");
    ShaderStage $fs = ShaderStage($gl->gpu, .fragment, "#version 330 core\nin vec2 vUv;\nout vec4 FragColor;\nlayout (std140) uniform QuadParams {\n    vec4 color;\n};\nvoid main()\n{\n    FragColor = vec4(vUv, color.b, 1.0);\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('std140') else ($e) {
        $program->destroy();
        $gl->end();
        die($e->message());
    }

    GpuPass $pipe = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
    Mesh $quad = .quad($gl->gpu);
    $gl->gpu->clearColor(0.0f, 1.0f, 0.0f, 1.0f);
    $gl->gpu->clear(COLOR_BUFFER_BIT);
    $pipe->bind();
    $program->bindSlot(0, 'QuadParams');
    $program->upload(UploadParams(Vec4(0.0f, 0.0f, 0.5f, 1.0f)));
    $quad->draw($pipe->layout);

    array<uint8> $pixels = readRgba($gl->window);
    uint32 $err = gl::GetError();
    uint8 $r = $pixels[0];
    uint8 $g = $pixels[1];
    uint8 $b = $pixels[2];

    $quad->destroy();
    $program->destroy();
    $gl->end();

    assert($err == gl::NO_ERROR, 'gl error');
    assert($r < 16, 'bottom-left r');
    assert($g < 16, 'bottom-left g');
    assert($b > 100 && $b < 160, 'bottom-left b');
}
#[end]

#[if: os == darwin]
#[group: "glfw"]
test program_link_mismatch
{
    bool $booted = guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('program-mismatch', 64, 64, $hints);
    Gpu $state = Gpu();
    bool $ready = guard $window->initialize($state) else ($e) {
        terminate();
        die($e->message());
    }

    ShaderProgram $program = ShaderProgram($state);
    ShaderStage $vs = ShaderStage($state, .vertex, "#version 330 core\nlayout (location = 0) in vec3 position;\nlayout (location = 1) in vec3 color;\nout vec4 pcolor_wrong;\nvoid main()\n{\n    pcolor_wrong = vec4(color, 1.0);\n    gl_Position = vec4(position, 1.0);\n}\n");
    ShaderStage $fs = ShaderStage($state, .fragment, "#version 330 core\nout vec4 fragment_color;\nin vec4 pcolor;\nvoid main()\n{\n    fragment_color = pcolor;\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    result<bool, ShaderError> $r = $program->link('mismatch');
    assert($r->failed(), 'link mismatch');
    $program->destroy();
    $window->destroy();
    terminate();
}
#[end]

#[group: "glfw"]
#[tests: expects death]
test program_attach_duplicate_kind_dies
{
    bool $booted = guard init() else ($e) {
        die($e->message());
    }

    WindowHints $hints = WindowHints::defaults();
    $hints->visible = false;
    Window $window = Window('program-dup', 64, 64, $hints);
    Gpu $state = Gpu();
    bool $ready = guard $window->initialize($state) else ($e) {
        terminate();
        die($e->message());
    }

    ShaderProgram $program = ShaderProgram($state);
    $program->attach(ShaderStage($state, .vertex, "#version 330\nvoid main() { }\n"));
    $program->attach(ShaderStage($state, .vertex, "#version 330\nvoid main() { }\n"));
}
#[end]



