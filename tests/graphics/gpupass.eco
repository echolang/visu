/**
 * GpuPass PSO key includes tessellation spacing.
 */

use visu::graphics::{
    Device, GpuPass, Raster, ShaderModuleHandle, ShaderProgram, VertexAttr, VertexLayout
};

test gpupass_spacing_is_in_key
{
    Device $device = Device();
    ShaderProgram $prog = ShaderProgram(
        $device,
        'dummy',
        ShaderModuleHandle::none(),
        ShaderModuleHandle::none(),
        ShaderModuleHandle::none(),
        ShaderModuleHandle::none(),
        false
    );
    array<VertexAttr> $attrs = array<VertexAttr>();
    VertexLayout $layout = VertexLayout($attrs);
    GpuPass $integer = GpuPass($prog, $layout, Raster::none(), spacing: .integer);
    GpuPass $pow2 = GpuPass($prog, $layout, Raster::none(), spacing: .pow2);
    assert($integer->key() != $pow2->key(), 'spacing');
    $prog->destroy();
}
