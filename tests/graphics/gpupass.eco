/**
 * GpuPass: std140 payload size, and a draw that paints pixels.
 */

use visu::graphics::{
    GpuPass, Mesh, VertexLayout, Raster,
    ShaderProgram, ShaderStage, COLOR_BUFFER_BIT
};
use visu::math::Vec4;

#[if: VISU_BACKEND_METAL]
#[else]
public struct QuadParams
{
    public Vec4 $color;
}

public struct ColorAndTime
{
    public Vec4 $color;
    public float32 $time;
    public float32 $pad0;
    public float32 $pad1;
    public float32 $pad2;
}

test quad_params_std140_size
{
    assert(mem::size<QuadParams>() == 16, 'quad params');
    assert(mem::size<ColorAndTime>() == 32, 'padded');
}

#[group: "glfw"]
test pipeline_mesh_draw_without_ubo
{
    GlContext $gl = glHidden('pipe-mesh');
    $gl->window->renderTarget()->preparePass();

    ShaderProgram $program = ShaderProgram($gl->gpu);
    ShaderStage $vs = ShaderStage($gl->gpu, .vertex, "#version 330 core\nlayout (location = 0) in vec3 aPos;\nlayout (location = 1) in vec2 aUv;\nout vec2 vUv;\nvoid main()\n{\n    gl_Position = vec4(aPos, 1.0);\n    vUv = aUv;\n}\n");
    ShaderStage $fs = ShaderStage($gl->gpu, .fragment, "#version 330 core\nin vec2 vUv;\nout vec4 FragColor;\nuniform vec4 u_color;\nvoid main()\n{\n    FragColor = vec4(vUv, u_color.b, 1.0);\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('quad') else ($e) {
        $program->destroy();
        $gl->end();
        die($e->message());
    }
    GpuPass $pass = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
    Mesh $quad = .quad($gl->gpu);

    $gl->gpu->clearColor(0.0f, 1.0f, 0.0f, 1.0f);
    $gl->gpu->clear(COLOR_BUFFER_BIT);
    $pass->bind();
    $program->set('u_color', Vec4(0.0f, 0.0f, 0.5f, 1.0f));
    $quad->draw($pass->layout);

    array<uint8> $pixels = readRgba($gl->window);
    uint8 $g = $pixels[1];
    $quad->destroy();
    $program->destroy();
    $gl->end();
    assert($g < 16, 'bottom-left g');
}

#[group: "glfw"]
test gpupass_draw_overwrites_clear_color
{
    GlContext $gl = glHidden('gpupass');
    $gl->window->renderTarget()->preparePass();

    ShaderProgram $program = ShaderProgram($gl->gpu);
    ShaderStage $vs = ShaderStage($gl->gpu, .vertex, "#version 330 core\nlayout (location = 0) in vec3 aPos;\nlayout (location = 1) in vec2 aUv;\nout vec2 vUv;\nvoid main()\n{\n    gl_Position = vec4(aPos, 1.0);\n    vUv = aUv;\n}\n");
    ShaderStage $fs = ShaderStage($gl->gpu, .fragment, "#version 330 core\nin vec2 vUv;\nout vec4 FragColor;\nuniform vec4 QuadParams[1];\nvoid main()\n{\n    FragColor = vec4(vUv, QuadParams[0].b, 1.0);\n}\n");
    $program->attach($vs);
    $program->attach($fs);
    bool $ok = guard $program->link('quad') else ($e) {
        $program->destroy();
        $gl->end();
        die($e->message());
    }

    QuadParams $params = QuadParams(Vec4(0.0f, 0.0f, 0.5f, 1.0f));
    GpuPass $pass = GpuPass($program, VertexLayout::pos3uv2(), Raster::none(), block: 'QuadParams');
    Mesh $quad = .quad($gl->gpu);

    $gl->gpu->clearColor(0.0f, 1.0f, 0.0f, 1.0f);
    $gl->gpu->clear(COLOR_BUFFER_BIT);
    $pass->draw($quad, $params);

    array<uint8> $pixels = readRgba($gl->window);
    uint32 $err = gl::GetError();
    uint8 $r = $pixels[0];
    uint8 $g = $pixels[1];
    uint8 $b = $pixels[2];

    $quad->destroy();
    $program->destroy();
    $gl->end();

    assert($err == gl::NO_ERROR, 'gl error');
    assert($r < 16, 'bottom-left r');
    assert($g < 16, 'bottom-left g');
    assert($b > 100 && $b < 160, 'bottom-left b');
}
#[end]
