/**
 * Kitchen with the model cooker: a glTF plus `.vmod` cooks to one VMDL per part and an assembly.
 */

use std::env;
use std::io;
use json;
use visu::asset::{
    Assembly, AssemblyPart, Assets, CookedModel, KIND_ASSEMBLY, KIND_MODEL, Kitchen, PackItem, Vmat,
    decodeAssembly, decodeCookedModel, parseAssembly
};
use visu::graphics::{Device, Material, Pixels};
use visu::math::{Vec3, equal};

internal function cookTmp(string $tag) : string
{
    $tmp = env::tmp();
    string $ds = env::DS;
    return "{$tmp}{$ds}visu-modelcook-{$tag}";
}

internal function cookMkdir(string $dir) : void
{
    guard io::mkdir($dir) else ($e) {
        if ($e->exists()) {
            return;
        }

        die($e->message());
    }
}

internal function cookDot(const string& $path) : void
{
    array<uint8> $rgba = array<uint8>();
    $rgba[] = 200;
    $rgba[] = 100;
    $rgba[] = 50;
    $rgba[] = 255;
    Pixels $px = Pixels(1, 1, $rgba);
    guard $px->write($path) else ($e) {
        die($e->message());
    }
}

internal function cookFind(const array<PackItem>& $items, string $id) : PackItem?
{
    foreach ($items as $item) {
        if ($item->id->equals($id)) {
            return $item;
        }
    }

    return null;
}

test kitchen_cooks_gltf_objects_with_sheet_lods_and_binds
{
    string $src = cookTmp('src-vmod');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}props";
    cookMkdir($folder);
    string $inner = "{$folder}{$ds}crate_01";
    cookMkdir($inner);
    // the glTF fixture from tests/asset/gltf.eco, written next to its textures
    gltfWriteFixture($inner);
    cookDot("{$inner}{$ds}wood.png");
    cookDot("{$inner}{$ds}wood_n.png");
    guard io::writefile("{$inner}{$ds}paint.vmat", '{"albedo":"wood","normal":"wood_n","roughnessFactor":0.4}') else ($e) {
        die($e->message());
    }
    guard io::writefile("{$inner}{$ds}metal.vmat", '{"alpha":"wood","backfaceCull":false}') else ($e) {
        die($e->message());
    }
    guard io::writefile("{$inner}{$ds}wood_n.vtex", '{"srgb":false}') else ($e) {
        die($e->message());
    }
    string $vmod = '';
    $vmod->append('{"parts":{');
    $vmod->append('"crate":{"lod":[12.5],"lodBias":2.0,"cullDistance":300,');
    $vmod->append('"slots":{"model.wood":"props/crate_01/paint","model.metal":"props/crate_01/metal"}},');
    $vmod->append('"pot":{"slots":{"model.metal":"props/crate_01/metal"}}},');
    $vmod->append('"nodes":[{"name":"crate","part":"crate","position":[9,8,7]},{"name":"pot","part":"pot"}]}');
    guard io::writefile("{$inner}{$ds}fixture.vmod", $vmod) else ($e) {
        die($e->message());
    }

    string $out = cookTmp('out-vmod');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    array<PackItem> $items = guard $k->cook($src, $out) else ($e) {
        die($e->message());
    }
    PackItem $crate = guard cookFind($items, 'props/crate_01/crate') else {
        die('crate item missing');
    }
    PackItem $pot = guard cookFind($items, 'props/crate_01/pot') else {
        die('pot item missing');
    }
    assert($crate->kind->equals(KIND_MODEL), 'crate kind');
    assert($pot->kind->equals(KIND_MODEL), 'pot kind');
    assert(cookFind($items, 'props/crate_01/wood') != null, 'texture cooked beside the model');
    PackItem $assembly = guard cookFind($items, 'props/crate_01') else {
        die('assembly missing');
    }
    assert($assembly->kind->equals(KIND_ASSEMBLY), 'assembly kind');

    Device $device = Device();
    Assets $assets = Assets($device);
    CookedModel $model = guard decodeCookedModel($assets, $crate->blob) else ($e) {
        die($e->message());
    }
    assert($model->lods->count() == 2, 'two levels');
    assert(equal($model->lods[1]->distance, 12.5f), 'lod distance from the part');
    assert(equal($model->lodBias, 2.0f), 'lod bias from the part');
    assert(equal($model->cullDistance, 300.0f), 'cull distance from the part');
    assert($model->slots[0]->equals('props/crate_01/paint'), 'wood slot is a material id');
    assert(equal($model->bounds->min->x, 0.0f) && equal($model->bounds->max->x, 1.0f), 'part-local x');
    CookedModel $potModel = guard decodeCookedModel($assets, $pot->blob) else ($e) {
        die($e->message());
    }
    assert(equal($potModel->lodBias, 1.0f) && equal($potModel->cullDistance, 0.0f), 'pot has defaults');
    Assembly $tree = guard decodeAssembly($assets, $assembly->blob) else ($e) {
        die($e->message());
    }
    assert($tree->parts->count() == 2, 'two parts');
    assert($tree->nodes->count() == 2, 'two nodes');
    assert(equal($tree->nodes[0]->position, Vec3(9.0f, 8.0f, 7.0f)), 'vmod node TRS is canonical');
}

test kitchen_default_slots_keep_dotted_material_names
{
    string $src = cookTmp('src-dots');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}props";
    cookMkdir($folder);
    string $inner = "{$folder}{$ds}crate_01";
    cookMkdir($inner);
    gltfWriteFixture($inner);
    cookDot("{$inner}{$ds}wood.png");

    string $out = cookTmp('out-dots');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    array<PackItem> $items = guard $k->cook($src, $out) else ($e) {
        die($e->message());
    }
    PackItem $crate = guard cookFind($items, 'props/crate_01/crate') else {
        die('crate item missing');
    }
    Device $device = Device();
    Assets $assets = Assets($device);
    CookedModel $model = guard decodeCookedModel($assets, $crate->blob) else ($e) {
        die($e->message());
    }
    assert($model->slots->count() == 2, 'two slots');
    assert($model->slots[0]->equals('props/crate_01/model.wood'), 'wood keeps the dots');
    assert($model->slots[1]->equals('props/crate_01/model.metal'), 'metal keeps the dots');
}

test vmod_shorthand_is_one_part
{
    json::Value $root = guard json::parse('{"lod":[6,14],"cullDistance":60,"slots":{"skin":"props/ball/skin"}}') else ($e) {
        die($e->message());
    }
    Assembly $doc = guard parseAssembly('props/ball', $root, 'ball') else ($e) {
        die($e->message());
    }
    assert($doc->parts->count() == 1, 'one part');
    assert($doc->parts[0]->name->equals('ball'), 'part name is the stem');
    assert($doc->nodes->count() == 1 && $doc->nodes[0]->part->equals('ball'), 'one node');
    assert(equal($doc->cullDistance, 0.0f), 'shorthand cull is on the part');
    assert(equal($doc->parts[0]->cullDistance, 60.0f), 'part cull from shorthand');
    assert($doc->parts[0]->slots['skin']->equals('props/ball/skin'), 'slot map');
}

test material_file_binds_against_its_folder
{
    json::Value $root = guard json::parse('{"albedo":"wood","normal":"wood_n","roughnessFactor":0.4}') else ($e) {
        die($e->message());
    }
    Vmat $vmat = Vmat('props/crate_01/wood', $root);
    Material $woodMat = Material($vmat);
    assert($woodMat->mapId('wood')->equals('props/crate_01/wood'), 'bare stem is the folder plus the name');
    assert($woodMat->mapId('other/thing')->equals('other/thing'), 'a full id is left alone');
    assert(equal($woodMat->roughnessFactor, 0.4f), 'scalar');
    assert($woodMat->id->equals('props/crate_01/wood'), 'material id is the catalog id');
}

test kitchen_refuses_two_sources_for_one_id
{
    string $src = cookTmp('dup-src');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}dup";
    cookMkdir($folder);
    gltfWriteFixture($folder);
    // a texture named like one of the glTF objects collides with it
    cookDot("{$folder}{$ds}crate.png");
    string $out = cookTmp('dup-out');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    assert($k->cook($src, $out)->failed(), 'duplicate id is refused');
}

test kitchen_shorthand_vmod_without_lod_still_remaps_slots
{
    string $src = cookTmp('src-short');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}props";
    cookMkdir($folder);
    string $inner = "{$folder}{$ds}spin_01";
    cookMkdir($inner);
    gltfWriteSpinFixture($inner);
    guard io::writefile("{$inner}{$ds}spin.vmod", '{"slots":{"default":"props/spin_01/skin"}}') else ($e) {
        die($e->message());
    }
    string $out = cookTmp('out-short');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    array<PackItem> $items = guard $k->cook($src, $out) else ($e) {
        die($e->message());
    }
    PackItem $modelItem = guard cookFind($items, 'props/spin_01/spin') else {
        die('spin model');
    }
    Device $device = Device();
    Assets $assets = Assets($device);
    CookedModel $model = guard decodeCookedModel($assets, $modelItem->blob) else ($e) {
        die($e->message());
    }
    assert($model->slots->count() == 1, 'one slot');
    assert($model->slots[0]->equals('props/spin_01/skin'), 'shorthand slots reached remap');
}

test kitchen_cooks_clips_and_marks_dynamic
{
    string $src = cookTmp('src-spin');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}props";
    cookMkdir($folder);
    string $inner = "{$folder}{$ds}spin_01";
    cookMkdir($inner);
    gltfWriteSpinFixture($inner);
    string $out = cookTmp('out-spin');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    array<PackItem> $items = guard $k->cook($src, $out) else ($e) {
        die($e->message());
    }
    PackItem $assembly = guard cookFind($items, 'props/spin_01') else {
        die('assembly missing');
    }
    Device $device = Device();
    Assets $assets = Assets($device);
    Assembly $tree = guard decodeAssembly($assets, $assembly->blob) else ($e) {
        die($e->message());
    }
    assert($tree->clips->count() == 1, 'cooked clip');
    assert($tree->clips[0]->name->equals('turn'), 'clip name');
    AssemblyPart? $spin = $tree->findPart('spin');
    AssemblyPart $spinPart = guard $spin else {
        die('spin part');
    }
    assert($spinPart->dynamic, 'animated child is dynamic');
    AssemblyPart? $base = $tree->findPart('base');
    AssemblyPart $basePart = guard $base else {
        die('base part');
    }
    assert(!$basePart->dynamic, 'static parent stays static');
}

test kitchen_retargets_parent_action_to_mesh_node
{
    string $src = cookTmp('src-arm');
    cookMkdir($src);
    string $ds = env::DS;
    string $folder = "{$src}{$ds}props";
    cookMkdir($folder);
    string $inner = "{$folder}{$ds}arm_01";
    cookMkdir($inner);
    gltfWriteArmFixture($inner);
    guard io::writefile("{$inner}{$ds}arm.vmod", '{"parts":{"arm_mesh":{}},"nodes":[{"name":"arm_mesh","part":"arm_mesh"}]}') else ($e) {
        die($e->message());
    }
    string $out = cookTmp('out-arm');
    cookMkdir($out);
    Kitchen $k = Kitchen::defaults();
    array<PackItem> $items = guard $k->cook($src, $out) else ($e) {
        die($e->message());
    }
    PackItem $assembly = guard cookFind($items, 'props/arm_01') else {
        die('assembly missing');
    }
    Device $device = Device();
    Assets $assets = Assets($device);
    Assembly $tree = guard decodeAssembly($assets, $assembly->blob) else ($e) {
        die($e->message());
    }
    assert($tree->clips->count() == 1, 'one clip');
    assert($tree->clips[0]->tracks[0]->node->equals('arm_mesh'), 'retargeted to the mesh node');
    assert($tree->nodes->count() == 1, 'vmod node');
    assert(equal($tree->nodes[0]->position->y, 2.0f), 'glTF rest pose filled identity vmod TRS');
}
