/**
 * Demo swap cap is off unless --define VISU_FINITE.
 */

test finite_done_is_unlimited_without_the_define
{
    assert(!visu::finiteDone(0), 'zero');
    assert(!visu::finiteDone(120), 'at cap');
    assert(!visu::finiteDone(100000), 'way over');
    assert(visu::finiteFrames() == null, 'no cap');
}
