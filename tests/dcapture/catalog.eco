/**
 * Built-in providers over a headless frame: names and glob resolve. No GPU work.
 */

use visu::app::HostPassData;
use visu::graphics::{
    Device, Frame, GBufferData, Pipeline, Pool, RenderTarget, SsaoData, TargetRef,
    TextureOptions, TextureRef
};
use visu::dcapture::{DumpCatalog, DumpEntry, DumpProvider, builtinProviders};

internal function describeAll(Frame $frame, Pool $pool) : DumpCatalog
{
    DumpCatalog $catalog = DumpCatalog();
    array<DumpProvider> $providers = builtinProviders();
    foreach ($providers as $provider) {
        $provider->describe($frame, $pool, $catalog);
    }

    return $catalog;
}

test catalog_lists_host_and_deferred_names
{
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    TargetRef $scene = $pipeline->createTarget('scene', 64, 64);
    TextureRef $color = $pipeline->createColor($scene, 'color', TextureOptions());
    $frame->set(HostPassData($scene, $color));
    TargetRef $gb = $pipeline->createTarget('gbuffer', 64, 64);
    TextureRef $position = $pipeline->createColor($gb, 'position', TextureOptions());
    TextureRef $normal = $pipeline->createColor($gb, 'normal', TextureOptions());
    TextureRef $albedo = $pipeline->createColor($gb, 'albedo', TextureOptions());
    TextureRef $material = $pipeline->createColor($gb, 'material', TextureOptions());
    TextureRef $emissive = $pipeline->createColor($gb, 'emissive', TextureOptions());
    TextureRef $id = $pipeline->createColor($gb, 'id', TextureOptions());
    TextureRef $depth = $pipeline->createDepth($gb);
    $frame->set(GBufferData($gb, $position, $normal, $albedo, $material, $emissive, $id, $depth));
    TargetRef $blur = $pipeline->createTarget('ssaoBlur', 64, 64);
    TextureRef $blurred = $pipeline->createColor($blur, 'output', TextureOptions());
    $frame->set(SsaoData($blur, $blurred));

    DumpCatalog $catalog = describeAll($frame, $pool);
    array<DumpEntry> $scenes = $catalog->resolve('scene');
    assert($scenes->count() == 1, 'scene');
    assert($catalog->resolve('backbuffer')->count() == 1, 'backbuffer alias');
    assert($catalog->resolve('pbr.gbuffer.*')->count() == 9, 'eight views plus material');
    assert($catalog->resolve('pbr.gbuffer.albedo')->count() == 1, 'exact');
    assert($catalog->resolve('pbr.ssao')->count() == 1, 'ssao blurred');
    assert($catalog->resolve('pbr.ssao.raw')->empty(), 'no raw ssao this frame');
    assert($catalog->resolve('pbr.light')->empty(), 'no light pass this frame');
    assert($catalog->resolve('nope')->empty(), 'unknown');
    assert($catalog->resolve('pool:*')->empty(), 'headless pool holds nothing');
    array<string> $names = $catalog->names();
    assert($names->count() == 12, 'two host plus nine gbuffer plus ssao');
    assert($names[0] == 'scene', 'insertion order');
}

test catalog_add_replaces_same_name
{
    DumpCatalog $catalog = DumpCatalog();
    TextureRef $a = TextureRef('a', 1, 1, TextureOptions());
    TextureRef $b = TextureRef('b', 1, 1, TextureOptions());
    $catalog->add('x', .texture($a, .color));
    $catalog->add('x', .texture($b, .normal));
    assert($catalog->count() == 1, 'one');
    array<DumpEntry> $found = $catalog->resolve('x');
    assert($found->count() == 1, 'found');
}

test catalog_empty_frame_has_no_names
{
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    DumpCatalog $catalog = describeAll($frame, $pool);
    assert($catalog->count() == 0, 'nothing');
}
