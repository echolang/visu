/**
 * Uploads made inside a frame: a texture larger than a staging chunk, and a buffer written into a
 * readback buffer, both read back once the frame is done. Every byte is counted in the frame's
 * draw stats.
 */

use visu::graphics::{
    BUFFER_READBACK, BUFFER_STORAGE, Buffer, BufferDesc, Pipeline, Texture, TextureDesc,
    TEXTURE_SAMPLED, TEXTURE_TRANSFER_DST, TEXTURE_TRANSFER_SRC
};

/**
 * 2048 x 2048 rgba8 twice in one frame: 32 MiB, past a staging chunk and past the uniform ring,
 * so the belt has to grow.
 */
public function checkInFrameTextureUpload(GpuContext $gpu) : void
{
    int32 $side = 2048;
    TextureDesc $desc = TextureDesc($width: $side, $height: $side);
    $desc->usage = TEXTURE_SAMPLED | TEXTURE_TRANSFER_DST | TEXTURE_TRANSFER_SRC;
    Texture $a = Texture($gpu->device, 'upload.a', $desc);
    Texture $b = Texture($gpu->device, 'upload.b', $desc);
    usize $n = (($side * $side) as usize) * 4;
    array<uint8> $red = arr::room<uint8>($n);
    $red->commit($n);
    array<uint8> $blue = arr::room<uint8>($n);
    $blue->commit($n);
    usize $i = 0;
    while ($i < $n) {
        $red[$i] = 255;
        $red[$i + 1] = 0;
        $red[$i + 2] = 0;
        $red[$i + 3] = 255;
        $blue[$i] = 0;
        $blue[$i + 1] = 0;
        $blue[$i + 2] = 255;
        $blue[$i + 3] = 255;
        $i = $i + 4;
    }

    $gpu->runFrame(function(Pipeline $p) : void {
        $a->upload(0, ptr<const uint8>(&$red[0]), $n as uint64, $side * 4);
        $b->upload(0, ptr<const uint8>(&$blue[0]), $n as uint64, $side * 4);
    });

    assert($gpu->device->draws->last->uploads == 2, 'two uploads counted');
    assert($gpu->device->draws->last->uploadBytes == (($n * 2) as int64), 'upload bytes counted');
    array<uint8> $ra = readRgba($gpu->device, $a);
    array<uint8> $rb = readRgba($gpu->device, $b);
    usize $last = $n - 4;
    assert($ra[0] == 255 && $ra[2] == 0, 'a first texel red');
    assert($ra[$last] == 255 && $ra[$last + 2] == 0, 'a last texel red');
    assert($rb[0] == 0 && $rb[2] == 255, 'b first texel blue');
    assert($rb[$last] == 0 && $rb[$last + 2] == 255, 'b last texel blue');
    $a->destroy();
    $b->destroy();
}

/**
 * A buffer upload inside a frame is recorded on the frame, not waited for: it lands once the frame
 * has run, at its offset, and the mapped readback buffer it lands in reads it back.
 */
public function checkInFrameBufferUpload(GpuContext $gpu) : void
{
    Buffer $buf = Buffer($gpu->device, BufferDesc(BUFFER_READBACK | BUFFER_STORAGE, 64 as uint64, 'upload.buffer'));
    array<uint32> $words = [11, 22, 33, 44];
    $gpu->runFrame(function(Pipeline $p) : void {
        $buf->upload(ptr<const uint8>(&$words[0]), 16 as uint64, 16 as uint64);
    });
    $gpu->device->waitIdle();
    assert($gpu->device->draws->last->uploads == 1, 'one upload counted');
    assert($gpu->device->draws->last->uploadBytes == 16, 'buffer bytes counted');
    uint32[16] $out;
    $gpu->device->readMapped($buf, ptr<uint8>(&$out[0]), 64 as uint64);
    assert($out[4] == 11 && $out[5] == 22 && $out[6] == 33 && $out[7] == 44, 'buffer words at their offset');
    $buf->destroy();
}

#[if: os != darwin]
#[group: "glfw"]
test gpu_in_frame_texture_upload
{
    GpuContext $gpu = gpuHidden('upload');
    checkInFrameTextureUpload($gpu);
    $gpu->end();
}
#[end]

#[group: "glfw"]
test gpu_in_frame_buffer_upload
{
    GpuContext $gpu = gpuHidden('upload.buffer');
    checkInFrameBufferUpload($gpu);
    $gpu->end();
}
