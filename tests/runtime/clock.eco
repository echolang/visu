/**
 * Monotonic seconds() helper. glfwGetTime stand-in.
 */

use std::time;

test seconds_is_non_negative
{
    float64 $t = visu::runtime::seconds();
    assert($t >= 0.0, 'non-negative');
}

test seconds_is_monotonic
{
    float64 $a = visu::runtime::seconds();
    float64 $b = visu::runtime::seconds();
    assert($b >= $a, 'non-decreasing');
}

test seconds_advances_after_sleep
{
    float64 $a = visu::runtime::seconds();
    time::sleep(.millis(20));
    float64 $b = visu::runtime::seconds();
    assert($b > $a, 'advanced');
}
