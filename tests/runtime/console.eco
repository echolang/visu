/**
 * DebugConsole command side: KeySignal / CharSignal facts, no overlay.
 */

use visu::os::{Window, WindowHints};
use visu::os::input::{InputHub, MOD_CONTROL};
use visu::runtime::DebugConsole;
use visu::signal::{CharSignal, ConsoleCommandSignal, Dispatcher, Flow, KeySignal};

class ConsoleCaught
{
    public string $raw;
    public int32 $n;

    public constructor()
    {
        $this->raw = '';
        $this->n = 0;
    }
}

function consoleToggle(Dispatcher $d) : void
{
    $d->dispatch(KeySignal(.c, 0, .press, MOD_CONTROL));
}

function consolePair(Dispatcher $d) : DebugConsole
{
    return DebugConsole($d, InputHub(Window('console', 64, 64, WindowHints()), $d));
}

test console_ctrl_c_toggles
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    assert(!$c->enabled(), 'off');
    consoleToggle($d);
    assert($c->enabled(), 'on');
    consoleToggle($d);
    assert(!$c->enabled(), 'off again');
}

test console_char_appends_when_enabled
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $d->dispatch(CharSignal(65));
    assert($c->line() == '', 'disabled ignores');
    consoleToggle($d);
    $d->dispatch(CharSignal(65));
    $d->dispatch(CharSignal(66));
    assert($c->line() == 'AB', 'typed');
}

test console_enter_dispatches_command
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<ConsoleCommandSignal>(function(const ConsoleCommandSignal& $cmd) : Flow {
        $caught->raw = $cmd->raw;
        $caught->n = $caught->n + 1;
        return .proceed;
    });
    consoleToggle($d);
    $d->dispatch(CharSignal(104));
    $d->dispatch(CharSignal(105));
    $d->dispatch(KeySignal(.enter, 0, .release, 0));
    assert($caught->n == 1, 'once');
    assert($caught->raw == 'hi', 'raw');
    assert($c->line() == '', 'cleared');
}

test console_backspace_trims
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $d->dispatch(CharSignal(65));
    $d->dispatch(CharSignal(66));
    $d->dispatch(KeySignal(.backspace, 0, .press, 0));
    assert($c->line() == 'A', 'trimmed');
}

test console_history_up_down
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $c->submit('one');
    $c->submit('two');
    $d->dispatch(KeySignal(.up, 0, .release, 0));
    assert($c->line() == 'unknown command: two. type help', 'last');
    $d->dispatch(KeySignal(.up, 0, .release, 0));
    assert($c->line() == 'two', 'cmd');
    $d->dispatch(KeySignal(.down, 0, .release, 0));
    assert($c->line() == 'unknown command: two. type help', 'next');
    $d->dispatch(KeySignal(.down, 0, .release, 0));
    assert($c->line() == '', 'past end');
}

test console_history_copy
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $c->submit('one');
    $c->writeLine('reply');
    array<string> $h = $c->history();
    assert($h->count() == 3, 'cmd, miss, reply');
    assert($h[0] == 'one', 'cmd');
    assert($h[1] == 'unknown command: one. type help', 'miss');
    assert($h[2] == 'reply', 'out');
    $c->clearHistory();
    assert($c->history()->count() == 0, 'cleared');
}

test console_ctrl_c_stops_other_key_handlers
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<KeySignal>(function(const KeySignal& $k) : Flow {
        $caught->n = $caught->n + 1;
        return .proceed;
    }, 0);
    consoleToggle($d);
    assert($caught->n == 0, 'console swallowed ctrl+c');
}

test console_toggle_claims_and_releases_input
{
    Dispatcher $d = Dispatcher();
    Window $w = Window('console', 64, 64, WindowHints());
    InputHub $in = InputHub($w, $d);
    DebugConsole $c = DebugConsole($d, $in);
    assert($in->unclaimed(), 'free');
    consoleToggle($d);
    assert($c->enabled(), 'on');
    assert($in->holds('visu/dev/console'), 'claimed');
    consoleToggle($d);
    assert(!$c->enabled(), 'off');
    assert($in->unclaimed(), 'released');
}

test console_toggle_stays_off_when_claim_is_taken
{
    Dispatcher $d = Dispatcher();
    Window $w = Window('console', 64, 64, WindowHints());
    InputHub $in = InputHub($w, $d);
    guard $in->claim('camera') else ($e) {
        die($e->message());
    }
    DebugConsole $c = DebugConsole($d, $in);
    consoleToggle($d);
    assert(!$c->enabled(), 'stays off');
    assert($in->holds('camera'), 'still camera');
    $d->dispatch(CharSignal(65));
    assert($c->line() == '', 'no char listener');
    guard $in->release('camera') else ($e) {
        die($e->message());
    }
    consoleToggle($d);
    assert($c->enabled(), 'on after free');
    assert($in->holds('visu/dev/console'), 'claimed');
}
