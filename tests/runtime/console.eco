/**
 * DebugConsole command side: KeySignal / CharSignal facts, no overlay.
 */

use visu::os::{Window, WindowHints};
use visu::os::input::{InputHub, MOD_CONTROL};
use visu::runtime::DebugConsole;
use visu::signal::{CharSignal, ConsoleCommandSignal, Dispatcher, Flow, KeySignal};

class ConsoleCaught
{
    public string $raw;
    public int32 $n;

    public constructor()
    {
        $this->raw = '';
        $this->n = 0;
    }
}

function consoleToggle(Dispatcher $d) : void
{
    $d->dispatch(KeySignal(.graveAccent, 0, .press, 0));
}

function consolePair(Dispatcher $d) : DebugConsole
{
    return DebugConsole($d, InputHub(Window('console', 64, 64, WindowHints()), $d));
}

test console_grave_toggles
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    assert(!$c->enabled(), 'off');
    consoleToggle($d);
    assert($c->enabled(), 'on');
    consoleToggle($d);
    assert(!$c->enabled(), 'off again');
}

test console_escape_closes
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    assert($c->enabled(), 'on');
    $d->dispatch(KeySignal(.escape, 0, .press, 0));
    assert(!$c->enabled(), 'closed');
    $d->dispatch(KeySignal(.escape, 0, .press, 0));
    assert(!$c->enabled(), 'escape does not open');
}

test console_ctrl_c_does_not_toggle
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $d->dispatch(KeySignal(.c, 0, .press, MOD_CONTROL));
    assert(!$c->enabled(), 'ctrl+c is not a toggle');
}

test console_ctrl_b_toggles
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    assert(!$c->enabled(), 'off');
    $d->dispatch(KeySignal(.b, 0, .press, MOD_CONTROL));
    assert($c->enabled(), 'on');
    $d->dispatch(KeySignal(.b, 0, .press, MOD_CONTROL));
    assert(!$c->enabled(), 'off again');
}

test console_plain_b_does_not_toggle
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $d->dispatch(KeySignal(.b, 0, .press, 0));
    assert(!$c->enabled(), 'b alone stays closed');
}

test console_char_appends_when_enabled
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $d->dispatch(CharSignal(65));
    assert($c->line() == '', 'disabled ignores');
    consoleToggle($d);
    $d->dispatch(CharSignal(65));
    $d->dispatch(CharSignal(66));
    assert($c->line() == 'AB', 'typed');
}

test console_enter_dispatches_command
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<ConsoleCommandSignal>(function(const ConsoleCommandSignal& $cmd) : Flow {
        $caught->raw = $cmd->raw;
        $caught->n = $caught->n + 1;
        return .proceed;
    });
    consoleToggle($d);
    $d->dispatch(CharSignal(104));
    $d->dispatch(CharSignal(105));
    $d->dispatch(KeySignal(.enter, 0, .press, 0));
    assert($caught->n == 1, 'once');
    assert($caught->raw == 'hi', 'raw');
    assert($c->line() == '', 'cleared');
}

test console_empty_enter_is_noop
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<ConsoleCommandSignal>(function(const ConsoleCommandSignal& $cmd) : Flow {
        $caught->n = $caught->n + 1;
        return .proceed;
    });
    consoleToggle($d);
    $d->dispatch(KeySignal(.enter, 0, .press, 0));
    assert($caught->n == 0, 'no dispatch');
    assert($c->history()->count() == 0, 'no log');
}

test console_backspace_trims
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $d->dispatch(CharSignal(65));
    $d->dispatch(CharSignal(66));
    $d->dispatch(KeySignal(.backspace, 0, .press, 0));
    assert($c->line() == 'A', 'trimmed');
}

test console_caret_left_insert
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $d->dispatch(CharSignal(65));
    $d->dispatch(CharSignal(67));
    $d->dispatch(KeySignal(.left, 0, .press, 0));
    assert($c->caret() == 1, 'between');
    $d->dispatch(CharSignal(66));
    assert($c->line() == 'ABC', 'inserted');
    assert($c->caret() == 2, 'after B');
}

test console_history_up_down
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $c->submit('one');
    $c->submit('two');
    $d->dispatch(KeySignal(.up, 0, .press, 0));
    assert($c->line() == 'two', 'last command');
    $d->dispatch(KeySignal(.up, 0, .press, 0));
    assert($c->line() == 'one', 'older');
    $d->dispatch(KeySignal(.down, 0, .press, 0));
    assert($c->line() == 'two', 'newer');
    $d->dispatch(KeySignal(.down, 0, .press, 0));
    assert($c->line() == '', 'past end is draft');
}

test console_history_stashes_draft
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $c->submit('one');
    $d->dispatch(CharSignal(120));
    $d->dispatch(CharSignal(121));
    assert($c->line() == 'xy', 'draft');
    $d->dispatch(KeySignal(.up, 0, .press, 0));
    assert($c->line() == 'one', 'command');
    $d->dispatch(KeySignal(.down, 0, .press, 0));
    assert($c->line() == 'xy', 'draft restored');
}

test console_history_copy
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $c->submit('one');
    $c->writeLine('reply');
    array<string> $h = $c->history();
    assert($h->count() == 3, 'echo, miss, reply');
    assert($h[0] == '> one', 'echo');
    assert($h[1] == 'unknown command: one. type help', 'miss');
    assert($h[2] == 'reply', 'out');
    $c->clearHistory();
    assert($c->history()->count() == 0, 'cleared');
}

test console_grave_stops_other_key_handlers
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<KeySignal>(function(const KeySignal& $k) : Flow {
        $caught->n = $caught->n + 1;
        return .proceed;
    }, 0);
    consoleToggle($d);
    assert($caught->n == 0, 'console swallowed grave');
}

test console_ctrl_b_stops_other_key_handlers
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    ConsoleCaught $caught = ConsoleCaught();
    $d->register<KeySignal>(function(const KeySignal& $k) : Flow {
        $caught->n = $caught->n + 1;
        return .proceed;
    }, 0);
    $d->dispatch(KeySignal(.b, 0, .press, MOD_CONTROL));
    assert($c->enabled(), 'opened');
    assert($caught->n == 0, 'console swallowed ctrl+b');
}

test console_toggle_claims_and_releases_input
{
    Dispatcher $d = Dispatcher();
    Window $w = Window('console', 64, 64, WindowHints());
    InputHub $in = InputHub($w, $d);
    DebugConsole $c = DebugConsole($d, $in);
    assert($in->unclaimed(), 'free');
    consoleToggle($d);
    assert($c->enabled(), 'on');
    assert($in->holds('visu/dev/console'), 'claimed');
    consoleToggle($d);
    assert(!$c->enabled(), 'off');
    assert($in->unclaimed(), 'released');
}

test console_toggle_steals_claim
{
    Dispatcher $d = Dispatcher();
    Window $w = Window('console', 64, 64, WindowHints());
    InputHub $in = InputHub($w, $d);
    guard $in->claim('camera') else ($e) {
        die($e->message());
    }
    DebugConsole $c = DebugConsole($d, $in);
    consoleToggle($d);
    assert($c->enabled(), 'opens over camera');
    assert($in->holds('visu/dev/console'), 'stolen');
    consoleToggle($d);
    assert(!$c->enabled(), 'off');
    assert($in->unclaimed(), 'released, camera does not return');
}

test console_tab_completes_unique
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    consoleToggle($d);
    $d->dispatch(CharSignal(104));
    $d->dispatch(CharSignal(101));
    $d->dispatch(CharSignal(108));
    $d->dispatch(KeySignal(.tab, 0, .press, 0));
    assert($c->line() == 'help', 'unique help');
}

test console_unknown_guesses
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = consolePair($d);
    $c->submit('hepl');
    array<string> $h = $c->history();
    assert($h[$h->count() - 1] == 'unknown command: hepl. did you mean help?', 'guess');
}
