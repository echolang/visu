test ui_panel_card_uses_the_panel_style
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->theme->card->pad = visu::ui::Edges::all(20.0f);
    $ui->theme->panel->pad = visu::ui::Edges::all(3.0f);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginCard();
    $ui->space(10.0f, 10.0f);
    $ui->end();
    $ui->beginCard(style: .panel);
    $ui->space(10.0f, 10.0f);
    $ui->end();
    $ui->endFrame();
    Node $card = $ui->nodes[1];
    Node $panel = $ui->nodes[3];
    assert(equal($card->size->x, 50.0f) && equal($card->size->y, 50.0f), 'card pads 20');
    assert(equal($panel->size->x, 16.0f) && equal($panel->size->y, 16.0f), 'panel pads 3');
    $ui->destroy();
    $device->shutdown();
}

test ui_apply_generals_derives_widget_colours_and_keeps_pads_it_owns
{
    Device $device = Device();
    Ui $ui = Ui($device);
    Color $paper = Color(0.9f, 0.85f, 0.7f, 1.0f);
    Color $wine = Color(0.5f, 0.1f, 0.15f, 1.0f);
    $ui->theme->surface = $paper;
    $ui->theme->accent = $wine;
    $ui->theme->applyGenerals();
    assert(equal($ui->theme->checkbox->knob->r, 0.9f), 'knob is the surface');
    assert(equal($ui->theme->checkbox->activeTrack->r, 0.5f), 'on track is the accent');
    assert(equal($ui->theme->card->bg->g, 0.85f), 'card is the surface');
    assert(equal($ui->theme->panel->bg->g, 0.85f), 'panel is the surface');
    assert(equal($ui->theme->iconButton->selectedBg->b, 0.15f), 'selected icon is the accent');
    assert($ui->theme->panel->pad->left < $ui->theme->card->pad->left, 'panel is tighter');
    $ui->destroy();
    $device->shutdown();
}
