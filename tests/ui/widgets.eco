    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $changed = $ui->tabBar('Pages', $opts, &$sel);
    $ui->endFrame();
    assert($changed, 'changed');
    assert($sel == 'b', 'b');
    $ui->destroy();
    $device->shutdown();
}

test ui_slider_drag_clamp_step_and_ignores_foreign_drag
{
    Device $device = Device();
    Ui $ui = Ui($device);
    float32 $value = 0.5f;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, step: 0.25f, id: 's');
    $ui->endFrame();
    Node $sl = firstKind($ui, Kind::slider);
    Vec2 $at = Vec2($sl->pos->x + $sl->size->x * 0.9f, $sl->pos->y + $sl->size->y * 0.5f);
    $ui->seed($at, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $changed = $ui->slider('', &$value, min: 0.0f, max: 1.0f, step: 0.25f, id: 's');
    $ui->endFrame();
    assert($changed, 'changed');
    assert($value > 0.74f && $value < 1.01f, 'stepped');
    $ui->seed($at, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, step: 0.25f, id: 's');
    $ui->endFrame();
    $value = 0.5f;
    $ui->seed(Vec2(300.0f, 180.0f), true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    $ui->seed($at, false, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $stolen = $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    assert(!$stolen, 'foreign drag');
    assert($value > 0.49f && $value < 0.51f, 'unchanged');
    $ui->destroy();
    $device->shutdown();
}

test ui_slider_drag_does_not_click_later_button
{
    Device $device = Device();
    Ui $ui = Ui($device);
    float32 $value = 0.5f;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->button('Later');
    $ui->endFrame();
    Node $sl = firstKind($ui, Kind::slider);
    Node $btn = firstKind($ui, Kind::button);
    Vec2 $press = Vec2($sl->pos->x + $sl->size->x * 0.5f, $sl->pos->y + $sl->size->y * 0.5f);
    $ui->seed($press, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->button('Later');
    $ui->endFrame();
    Vec2 $overBtn = Vec2($btn->pos->x + $btn->size->x * 0.5f, $btn->pos->y + $btn->size->y * 0.5f);
    $ui->seed($overBtn, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    bool $hit = $ui->button('Later');
    $ui->endFrame();
    assert(!$hit, 'button skipped');
    $ui->destroy();
    $device->shutdown();
}

test ui_image_measures_given_size
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginColumn();
    $ui->image(null, 120.0f, 80.0f);
    $ui->end();
    $ui->endFrame();
    Node $img = firstKind($ui, Kind::image);
    assert(equal($img->measured->x, 120.0f), 'w');
    assert(equal($img->measured->y, 80.0f), 'h');
    $ui->destroy();
    $device->shutdown();
}

test ui_image_border_grows_measured_size
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginColumn();
    $ui->image(null, 120.0f, 80.0f, border: Color::black());
    $ui->end();
    $ui->endFrame();
    Node $img = firstKind($ui, Kind::image);
    assert(equal($img->measured->x, 124.0f), 'w');
    assert(equal($img->measured->y, 84.0f), 'h');
    $ui->destroy();
    $device->shutdown();
}

test ui_image_missing_height_is_square
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->image(null, 90.0f);
    $ui->endFrame();
    Node $img = firstKind($ui, Kind::image);
    assert(equal($img->measured->x, 90.0f), 'w');
    assert(equal($img->measured->y, 90.0f), 'h');
    $ui->destroy();
    $device->shutdown();
}

test ui_progress_clamps_and_measures
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->progress(0.4f, id: 'bar');
    $ui->endFrame();
    Node $bar = firstKind($ui, Kind::progress);
    assert($bar->kind == Kind::progress, 'kind');
    assert($bar->measured->y == $ui->theme->progress->height, 'h');
    $ui->destroy();
    $device->shutdown();
}

test ui_spinner_is_square
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->spinner();
    $ui->endFrame();
    Node $spin = firstKind($ui, Kind::spinner);
    assert(equal($spin->measured->x, $spin->measured->y), 'square');
    assert($spin->measured->x == $ui->theme->spinner->size, 'size');
    $ui->destroy();
    $device->shutdown();
}
