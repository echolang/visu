test ui_solid_card_padding_hovers
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginCard(200.0f);
    $ui->text('Tools');
    $ui->end();
    $ui->endFrame();
    Node $card = $ui->nodes[1];
    assert($card->solid, 'card is solid');
    Vec2 $pad = Vec2($card->pos->x + 2.0f, $card->pos->y + 2.0f);
    $ui->seed($pad, false, false, false);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginCard(200.0f);
    $ui->text('Tools');
    $ui->end();
    $ui->endFrame();
    assert($ui->hoverAny, 'padding takes the pointer');
    $ui->seed(Vec2(390.0f, 390.0f), false, false, false);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->beginCard(200.0f);
    $ui->text('Tools');
    $ui->end();
    $ui->endFrame();
    assert(!$ui->hoverAny, 'outside is free');
    $ui->destroy();
    $device->shutdown();
}

test ui_bare_layout_is_not_solid
{
    Device $device = Device();
    Ui $ui = Ui($device);
