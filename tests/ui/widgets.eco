    $ui->endFrame();
    assert(equal($ui->nodes[1]->measured->x, $ui->nodes[2]->measured->x), 'same width');
    assert($ui->arena == '20.3 m', 'arena');
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->endFrame();
    assert($ui->arena->empty(), 'cleared per frame');
    $ui->destroy();
    $device->shutdown();
}

