test ui_empty_name_checkbox_is_just_the_switch
{
    Device $device = Device();
    Ui $ui = Ui($device);
    bool $on = true;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->checkbox('Vsync', &$on);
    $ui->checkbox('', &$on, id: 'bare');
    $ui->endFrame();
    Node $named = firstKind($ui, Kind::checkbox);
    Node $bare = nthKind($ui, Kind::checkbox, 1);
    assert($bare->size->x < $named->size->x, 'no label pad');
    assert(equal($bare->size->x, 48.0f), 'switch');
    $ui->destroy();
    $device->shutdown();
}

test ui_tab_bar_is_tighter_than_a_button_group
{
    Device $device = Device();
    Ui $ui = Ui($device);
    array<Choice> $opts = array<Choice>();
    $opts[] = Choice('a', 'A');
    $opts[] = Choice('b', 'B');
    string $sel = 'a';
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->buttonGroup('Size', $opts, &$sel);
    $ui->endFrame();
    float32 $groupW = firstKind($ui, Kind::group)->measured->x;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->tabBar('Pages', $opts, &$sel);
    $ui->endFrame();
    assert(firstKind($ui, Kind::group)->measured->x < $groupW, 'tighter');
    $ui->destroy();
    $device->shutdown();
}

