test ui_text_field_appends_seeded_chars
{
    Device $device = Device();
    Ui $ui = Ui($device);
    string $name = 'ab';
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->textField('Name', &$name);
    $ui->endFrame();
    Node $field = firstKind($ui, Kind::field);
    Vec2 $mid = Vec2($field->pos->x + $field->size->x * 0.5f, $field->pos->y + $field->size->y * 0.5f);
    $ui->seed($mid, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->textField('Name', &$name);
    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    array<int32> $chars = array<int32>();
    $chars[] = 99;
    $ui->seedChars($chars);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $changed = $ui->textField('Name', &$name);
    $ui->endFrame();
    assert($changed, 'changed');
    assert($name == 'abc', 'appended');
    $ui->destroy();
    $device->shutdown();
}

test ui_number_field_focuses_on_click_and_commits_on_blur
{
    Device $device = Device();
    Ui $ui = Ui($device);
    float32 $v = 1.5f;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->numberField('Radius', &$v);
    $ui->endFrame();
    Node $field = firstKind($ui, Kind::field);
    assert($ui->fields[0]->arena, 'idle shows the arena readout');
    Vec2 $mid = Vec2($field->pos->x + $field->size->x * 0.5f, $field->pos->y + $field->size->y * 0.5f);
    $ui->seed($mid, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->numberField('Radius', &$v);
    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->numberField('Radius', &$v);
    $ui->endFrame();
    assert($ui->fields[0]->focused, 'click focuses');
    assert(!$ui->fields[0]->arena, 'focused edits the raw text');
    $ui->seed(Vec2(390.0f, 190.0f), true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->numberField('Radius', &$v);
    $ui->endFrame();
    $ui->seed(Vec2(390.0f, 190.0f), false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $changed = $ui->numberField('Radius', &$v);
    $ui->endFrame();
    assert($changed, 'blur commits');
    assert(equal($v, 1.5f), 'value kept');
    assert($ui->fields[0]->arena, 'idle again');
    $ui->destroy();
    $device->shutdown();
}

test ui_modal_closed_skips_contents
{
    Device $device = Device();
    Ui $ui = Ui($device);
    bool $open = false;
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    if ($ui->beginModal('New map', &$open)) {
        $ui->button('Create');
        $ui->endModal();
    }

    $ui->endFrame();
    assert($ui->nodes->count() == 1, 'root only');
    $open = true;
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    if ($ui->beginModal('New map', &$open)) {
        $ui->button('Create');
        $ui->endModal();
    }

    $ui->endFrame();
    firstKind($ui, Kind::button);
    $ui->destroy();
    $device->shutdown();
}

