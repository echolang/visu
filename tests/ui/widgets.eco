test ui_tooltip_waits_for_the_delay
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->theme->tooltip->delay = 0.0f;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->button('Save');
    $ui->tooltip('Save map', shortcut: 'Cmd+S');
    $ui->endFrame();
    assert(!$ui->tip->show, 'no hover yet');
    Node $btn = firstKind($ui, Kind::button);
    $ui->seed(Vec2($btn->pos->x + 2.0f, $btn->pos->y + 2.0f), false, false, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->button('Save');
    $ui->tooltip('Save map', shortcut: 'Cmd+S');
    $ui->endFrame();
    assert($ui->tip->show, 'shown after the delay');
    assert($ui->tip->size->x > 0.0f, 'placed');
    $ui->theme->tooltip->delay = 60.0f;
    $ui->seed(Vec2(390.0f, 190.0f), false, false, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->button('Save');
    $ui->tooltip('Save map');
    $ui->endFrame();
    $ui->seed(Vec2($btn->pos->x + 2.0f, $btn->pos->y + 2.0f), false, false, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->button('Save');
    $ui->tooltip('Save map');
    $ui->endFrame();
    assert(!$ui->tip->show, 'leaving resets the rest timer');
    $ui->destroy();
    $device->shutdown();
}

