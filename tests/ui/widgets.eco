test ui_select_escape_closes
{
    Device $device = Device();
    Ui $ui = Ui($device);
    array<Choice> $opts = array<Choice>();
    $opts[] = Choice('low', 'Low');
    $opts[] = Choice('high', 'High');
    string $sel = 'low';
    uint64 $id = openSelect($ui, &$sel, $opts);
    array<int32> $chars = array<int32>();
    $chars[] = 104;
    $ui->seedChars($chars);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->select('Quality', $opts, &$sel);
    $ui->endFrame();
    $ui->seedKey(key::ESCAPE);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->select('Quality', $opts, &$sel);
    $ui->endFrame();
    assert(!selectIsOpen($ui->slots[$id]), 'closed');
    assert($sel == 'low', 'keep');
    assert(selectData($ui->slots[$id])->query == '', 'query dropped');
    $ui->destroy();
    $device->shutdown();
}

test ui_button_group_clicks
{
    Device $device = Device();
    Ui $ui = Ui($device);
    array<Choice> $opts = array<Choice>();
    $opts[] = Choice('a', 'A');
    $opts[] = Choice('b', 'B');
    string $sel = 'a';
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->buttonGroup('Size', $opts, &$sel);
    $ui->endFrame();
    Node $g = firstKind($ui, Kind::group);
    uint64 $oid = mixId($g->id, 'b');
    $opt = $ui->slots[$oid];
    Vec2 $mid = Vec2($opt->pos->x + $opt->size->x * 0.5f, $opt->pos->y + $opt->size->y * 0.5f);
    $ui->seed($mid, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->buttonGroup('Size', $opts, &$sel);
    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    bool $changed = $ui->buttonGroup('Size', $opts, &$sel);
    $ui->endFrame();
    assert($changed, 'changed');
    assert($sel == 'b', 'b');
    $ui->destroy();
    $device->shutdown();
}

test ui_select_outside_does_not_click_later_button
{
    Device $device = Device();
    Ui $ui = Ui($device);
    array<Choice> $opts = array<Choice>();
    $opts[] = Choice('low', 'Low');
    $opts[] = Choice('high', 'High');
    string $sel = 'low';
    uint64 $id = openSelect($ui, &$sel, $opts);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->select('Quality', $opts, &$sel);
    $ui->space(0.0f, 220.0f);
    $ui->button('Later');
    $ui->endFrame();
    Node $btn = firstKind($ui, Kind::button);
    Vec2 $mid = Vec2($btn->pos->x + $btn->size->x * 0.5f, $btn->pos->y + $btn->size->y * 0.5f);
    $ui->seed($mid, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->select('Quality', $opts, &$sel);
    $ui->space(0.0f, 220.0f);
    $ui->button('Later');
    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 400.0f));
    $ui->select('Quality', $opts, &$sel);
    $ui->space(0.0f, 220.0f);
    bool $hit = $ui->button('Later');
    $ui->endFrame();
    assert(!selectIsOpen($ui->slots[$id]), 'closed');
    assert(!$hit, 'button skipped');
    $ui->destroy();
    $device->shutdown();
}
