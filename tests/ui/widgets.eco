    $ui->destroy();
    $device->shutdown();
}

test ui_explicit_solid_overrides_bg
{
    Layout $l = Layout();
    assert(!$l->blocks(), 'bare');
    $l->bg = Color(0.0f, 0.0f, 0.0f, 0.5f);
    assert($l->blocks(), 'bg');
    $l->solid = false;
    assert(!$l->blocks(), 'forced off');
}

test ui_slider_drag_holds_hover_off_the_widget
{
    Device $device = Device();
    Ui $ui = Ui($device);
    float32 $value = 0.5f;
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    Node $sl = firstKind($ui, Kind::slider);
    Vec2 $at = Vec2($sl->pos->x + 4.0f, $sl->pos->y + $sl->size->y * 0.5f);
    $ui->seed($at, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    $ui->seed(Vec2(390.0f, 190.0f), false, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    assert($ui->hoverAny, 'drag keeps the pointer');
    $ui->seed(Vec2(390.0f, 190.0f), false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    assert($ui->hoverAny, 'the release frame still belongs to the drag');
    $ui->seed(Vec2(390.0f, 190.0f), false, false, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->slider('', &$value, min: 0.0f, max: 1.0f, id: 's');
    $ui->endFrame();
    assert(!$ui->hoverAny, 'released');
    $ui->destroy();
    $device->shutdown();
}

function fixed(float32 $v, int32 $d) : string
{
    string $s = '';
    appendFixed($s, $v, $d);
    return $s;
}

test ui_append_fixed_formats_without_rounding_drift
{
    assert(fixed(0.0f, 0) == '0', 'zero');
    assert(fixed(12.345f, 1) == '12.3', 'one place');
    assert(fixed(12.35f, 1) == '12.4', 'half up');
    assert(fixed(-3.5f, 2) == '-3.50', 'negative padded');
    assert(fixed(-0.001f, 1) == '0.0', 'negative zero drops the sign');
    assert(fixed(0.05f, 2) == '0.05', 'leading zero in the fraction');
    assert(fixed(1204.0f, 0) == '1204', 'integer');
    assert(fixed(7.0f, 9) == '7.000000', 'decimals capped');
    assert(fixed(1000000000000000000000.0f, 1) == 'inf', 'overflow');
}

test ui_number_measures_like_text
{
    Device $device = Device();
