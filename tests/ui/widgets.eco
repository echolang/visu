}

test ui_disabled_button_never_clicks_and_fades
{
    Device $device = Device();
    Ui $ui = Ui($device);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->beginDisabled(true);
    $ui->button('Undo');
    $ui->endDisabled();
    $ui->button('Save');
    $ui->endFrame();
    Node $undo = firstKind($ui, Kind::button);
    assert($undo->dim, 'dim');
    assert(!$ui->nodes[2]->dim, 'scope ends');
    Vec2 $mid = Vec2($undo->pos->x + 4.0f, $undo->pos->y + 4.0f);
    bool $hit = false;
    $ui->seed($mid, true, false, true);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->beginDisabled(true);
    $hit = $hit || $ui->button('Undo');
    $ui->endDisabled();
    $ui->button('Save');
    $ui->endFrame();
    $ui->seed($mid, false, true, false);
    $ui->beginFrame(Vec2(400.0f, 200.0f));
    $ui->beginDisabled(true);
    $hit = $hit || $ui->button('Undo');
    $ui->endDisabled();
    $ui->button('Save');
    $ui->endFrame();
    assert(!$hit, 'no click');
    $ui->destroy();
    $device->shutdown();
}

