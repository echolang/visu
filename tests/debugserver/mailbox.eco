/**
 * The worker to main-thread hand-off: a posting thread sleeps until the main side answers,
 * and closing the mailbox wakes it with `shuttingDown`.
 */

use std::thread;
use visu::debugserver::{DebugFault, DebugJob, DebugMailbox, DebugReply};

test debugserver_mailbox_idle_takes_nothing
{
    DebugMailbox $mail = DebugMailbox();
    assert(!$mail->waiting(), 'idle');
    assert($mail->take() == null, 'nothing queued');
}

test debugserver_mailbox_post_answers_across_threads
{
    DebugMailbox $mail = DebugMailbox();
    thread::task<bool> $client = guard thread::spawn(function() : bool {
        DebugReply $reply = $mail->post(.status);
        return $reply->fault == null && $reply->body == '{"ok":true}';
    }) else ($e) {
        assert(false, "spawn failed");
        return;
    }
    int32 $tries = 0;
    DebugJob? $got = $mail->take();
    while ($got == null && $tries < 2000) {
        thread::sleep(1);
        $got = $mail->take();
        $tries = $tries + 1;
    }
    DebugJob $job = guard $got else {
        assert(false, 'the post never arrived');
        return;
    }
    assert(!$mail->waiting(), 'taken');
    $job->answer(DebugReply(json: '{"ok":true}'));
    assert($client->wait(), 'the worker got the answer');
}

test debugserver_mailbox_closed_answers_shutting_down
{
    DebugMailbox $mail = DebugMailbox();
    thread::task<bool> $client = guard thread::spawn(function() : bool {
        DebugReply $reply = $mail->post(.verbs);
        DebugFault $fault = guard $reply->fault else {
            return false;
        }
        return $fault == DebugFault::shuttingDown;
    }) else ($e) {
        assert(false, "spawn failed");
        return;
    }
    while (!$mail->waiting()) {
        thread::sleep(1);
    }
    $mail->close();
    assert($client->wait(), 'a closed mailbox answers shuttingDown');
    DebugReply $late = $mail->post(.status);
    DebugFault $lateFault = guard $late->fault else {
        assert(false, 'a post after close is refused');
        return;
    }
    assert($lateFault == DebugFault::shuttingDown, 'a post after close is refused as shuttingDown');
}
