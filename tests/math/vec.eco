test vec3_splat_and_extend
{
    visu::math::Vec3 $s = visu::math::Vec3(2.0f);
    visu::math::Vec3 $e = visu::math::Vec3(visu::math::Vec2(1.0f, 3.0f), 5.0f);

    assert(visu::math::equal($s, visu::math::Vec3(2.0f, 2.0f, 2.0f)));
    assert(visu::math::equal($e, visu::math::Vec3(1.0f, 3.0f, 5.0f)));
    assert(visu::math::equal($e->xy(), visu::math::Vec2(1.0f, 3.0f)));
}

test vec_arithmetic_and_hadamard
{
    visu::math::Vec3 $a = visu::math::Vec3(1.0f, 2.0f, 3.0f);
    visu::math::Vec3 $b = visu::math::Vec3(4.0f, 5.0f, 6.0f);

    assert(visu::math::equal($a + $b, visu::math::Vec3(5.0f, 7.0f, 9.0f)));
    assert(visu::math::equal($b - $a, visu::math::Vec3(3.0f, 3.0f, 3.0f)));
    assert(visu::math::equal($a * $b, visu::math::Vec3(4.0f, 10.0f, 18.0f)));
    assert(visu::math::equal($a * 2.0f, visu::math::Vec3(2.0f, 4.0f, 6.0f)));
    assert(visu::math::equal(2.0f * $a, visu::math::Vec3(2.0f, 4.0f, 6.0f)));
    assert(visu::math::equal(-$a, visu::math::Vec3(-1.0f, -2.0f, -3.0f)));
}

test vec_dot_cross_length
{
    visu::math::Vec3 $x = visu::math::Vec3(1.0f, 0.0f, 0.0f);
    visu::math::Vec3 $y = visu::math::Vec3(0.0f, 1.0f, 0.0f);

    assert(visu::math::equal(visu::math::dot($x, $y), 0.0f));
    assert(visu::math::equal(visu::math::cross($x, $y), visu::math::Vec3(0.0f, 0.0f, 1.0f)));
    assert(visu::math::equal(visu::math::length($x), 1.0f));
    assert(visu::math::equal(visu::math::normalize(visu::math::Vec3(0.0f, 3.0f, 0.0f)), $y));
}

test vec_index_write
{
    visu::math::Vec3 $v = visu::math::Vec3(0.0f);
    $v[1] = 9.0f;

    assert(visu::math::equal($v[1], 9.0f));
    assert(visu::math::equal($v->y, 9.0f));
}

test vec2_and_vec4_ops
{
    visu::math::Vec2 $a = visu::math::Vec2(3.0f, 4.0f);
    visu::math::Vec4 $b = visu::math::Vec4(visu::math::Vec3(1.0f, 2.0f, 3.0f), 4.0f);

    assert(visu::math::equal(visu::math::length($a), 5.0f));
    assert(visu::math::equal($b->xyz(), visu::math::Vec3(1.0f, 2.0f, 3.0f)));
    assert(visu::math::equal(visu::math::mix($a, visu::math::Vec2(5.0f, 6.0f), 0.5f), visu::math::Vec2(4.0f, 5.0f)));
}

test radians_degrees
{
    assert(visu::math::equal(visu::math::degrees(std::math::PI_F32), 180.0f, 0.001f));
    assert(visu::math::equal(visu::math::radians(180.0f), std::math::PI_F32, 0.001f));
}

test vec_min_max_abs_clamp
{
    visu::math::Vec3 $v = visu::math::Vec3(-2.0f, 0.5f, 4.0f);

    assert(visu::math::equal(visu::math::abs($v), visu::math::Vec3(2.0f, 0.5f, 4.0f)));
    assert(visu::math::equal(visu::math::min($v, 0.0f), visu::math::Vec3(-2.0f, 0.0f, 0.0f)));
    assert(visu::math::equal(visu::math::clamp($v, -1.0f, 1.0f), visu::math::Vec3(-1.0f, 0.5f, 1.0f)));
}

test reflect_horizontal
{
    visu::math::Vec3 $r = visu::math::reflect(visu::math::Vec3(1.0f, -1.0f, 0.0f), visu::math::Vec3(0.0f, 1.0f, 0.0f));

    assert(visu::math::equal($r, visu::math::Vec3(1.0f, 1.0f, 0.0f)));
}
