/**
 * Tiny struct components for ecs tests.
 * One file so view/entities/system tests share the types (the test target is one module).
 */

use visu::ecs::Entity;

struct Position
{
    public float32 $x;
    public float32 $y;
}

struct Velocity
{
    public float32 $dx;
    public float32 $dy;
}

struct Tag
{
    public int32 $id;
}

class Counter
{
    public int32 $n;

    public constructor()
    {
        $this->n = 0;
    }
}

class EntityLog
{
    public array<Entity> $entities;
    public array<int32> $values;

    public constructor()
    {
        $this->entities = array<Entity>();
        $this->values = array<int32>();
    }
}
