/**
 * CPU font load and textBounds. No GPU — atlas upload is sync().
 */

use std::io;
use visu::graphics::Device;
use visu::math::Vec2;
use visu::vg::{Canvas, TextAlign, VgError};

function fontCanvas() : Canvas
{
    Device $device = Device();
    Canvas $vg = Canvas($device);
    $vg->begin(400.0f, 300.0f, 1.0f);
    return $vg;
}

function inconsolataPath() : string
{
    if (fontFileExists('resources/font/Inconsolata-Regular.ttf')) {
        return 'resources/font/Inconsolata-Regular.ttf';
    }

    if (fontFileExists('../resources/font/Inconsolata-Regular.ttf')) {
        return '../resources/font/Inconsolata-Regular.ttf';
    }

    return 'resources/font/Inconsolata-Regular.ttf';
}

function fontFileExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}

test font_snap_pt
{
    assert(visu::vg::snapPt(10.0f, 1.0f) == 10.0f, 'int');
    assert(visu::vg::snapPt(10.4f, 1.0f) == 10.0f, 'down');
    assert(visu::vg::snapPt(10.6f, 1.0f) == 11.0f, 'up');
    assert(visu::vg::snapPt(10.25f, 2.0f) == 10.5f, 'retina');
    assert(visu::vg::snapPt(-20.3f, 1.0f) == -20.0f, 'neg');
}

test font_load_and_bounds
{
    Canvas $vg = fontCanvas();
    guard $vg->createFont('sans', inconsolataPath()) else {
        assert(false, 'load font');
        return;
    }
    guard $vg->fontFace('sans') else {
        assert(false, 'font face');
        return;
    }
    $vg->fontSize(18.0f);
    $bHi = $vg->textBounds(Vec2(0.0f, 0.0f), 'Hi');
    $bH = $vg->textBounds(Vec2(0.0f, 0.0f), 'H');
    assert($bHi->width() > $bH->width(), 'Hi wider than H');
    $empty = $vg->textBounds(Vec2(10.0f, 20.0f), '');
    assert($empty->width() == 0.0f, 'empty width');
    assert($empty->height() == 0.0f, 'empty height');
}

test font_sep_advance_includes_spaces
{
    Canvas $vg = fontCanvas();
    guard $vg->createFont('sans', inconsolataPath()) else {
        assert(false, 'load font');
        return;
    }
    guard $vg->fontFace('sans') else {
        assert(false, 'font face');
        return;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $ink = $vg->textBounds(Vec2(0.0f, 0.0f), ' | ')->width();
    float32 $adv = $vg->textAdvance(Vec2(0.0f, 0.0f), ' | ');
    assert($adv > $ink, 'spaces add advance');
    float32 $pipe = $vg->textAdvance(Vec2(0.0f, 0.0f), '|');
    assert($adv > $pipe, 'spaces around pipe');
}

test font_align_right
{
    Canvas $vg = fontCanvas();
    guard $vg->createFont('sans', inconsolataPath()) else {
        assert(false, 'load font');
        return;
    }
    guard $vg->fontFace('sans') else {
        assert(false, 'face');
        return;
    }
    $vg->fontSize(18.0f);
    $vg->textAlign(TextAlign(.right, .baseline));
    $b = $vg->textBounds(Vec2(0.0f, 0.0f), 'Hi');
    assert($b->max->x <= 0.5f, 'right-aligned max');
    assert($b->min->x < -1.0f, 'right-aligned min');
}

test font_missing_name
{
    Canvas $vg = fontCanvas();
    status<VgError> $r = $vg->fontFace('nope');
    assert($r->failed(), 'missing');
    VgError $e = $r->failure();
    string $msg = $e->message();
    assert($msg == "vg font 'nope' is not loaded", 'name');
}

test font_bad_bytes
{
    Canvas $vg = fontCanvas();
    result<visu::vg::Font, VgError> $r = $vg->createFont(name: 'x', bytes: 'not a font');
    assert($r->failed(), 'parse');
    VgError $e = $r->failure();
    match ($e) {
        VgError::fontParse => {
        },
        else => {
            assert(false, 'wrong error');
        },
    };
}

test font_missing_file
{
    Canvas $vg = fontCanvas();
    result<visu::vg::Font, VgError> $r = $vg->createFont('sans', 'no/such/font.ttf');
    assert($r->failed(), 'file');
    VgError $e = $r->failure();
    string $msg = $e->message();
    assert($msg == "vg font file 'no/such/font.ttf'", 'path');
}

test font_inconsolata_no_kern
{
    Canvas $vg = fontCanvas();
    guard $vg->createFont('sans', inconsolataPath()) else {
        assert(false, 'load font');
        return;
    }
    guard $vg->fontFace('sans') else {
        assert(false, 'font face');
        return;
    }
    $vg->fontSize(18.0f);
    float32 $av = $vg->textAdvance(Vec2(0.0f, 0.0f), 'AV');
    float32 $a = $vg->textAdvance(Vec2(0.0f, 0.0f), 'A');
    float32 $v = $vg->textAdvance(Vec2(0.0f, 0.0f), 'V');
    assert($av == $a + $v, 'mono kern');
    float32 $again = $vg->textAdvance(Vec2(0.0f, 0.0f), 'AV');
    assert($again == $av, 'repeat');
}

function interPath() : string
{
    if (fontFileExists('resources/font/Inter-Regular.ttf')) {
        return 'resources/font/Inter-Regular.ttf';
    }

    if (fontFileExists('../resources/font/Inter-Regular.ttf')) {
        return '../resources/font/Inter-Regular.ttf';
    }

    return 'resources/font/Inter-Regular.ttf';
}

test font_inter_gpos_pair
{
    Canvas $vg = fontCanvas();
    guard $vg->createFont('sans', interPath()) else {
        assert(false, 'load inter');
        return;
    }
    guard $vg->fontFace('sans') else {
        assert(false, 'font face');
        return;
    }
    $vg->fontSize(48.0f);
    float32 $pair = $vg->textAdvance(Vec2(0.0f, 0.0f), 'y<');
    float32 $y = $vg->textAdvance(Vec2(0.0f, 0.0f), 'y');
    float32 $lt = $vg->textAdvance(Vec2(0.0f, 0.0f), '<');
    assert($pair + 1.0f < $y + $lt, 'y< kerns');
    float32 $again = $vg->textAdvance(Vec2(0.0f, 0.0f), 'y<');
    assert($again == $pair, 'repeat');
}
