/**
 * Color storage and premul.
 */

use visu::math::{Vec4, equal};
use visu::vg::Color;

test color_premultiplied
{
    Color $c = Color(1.0f, 0.5f, 0.0f, 0.5f);
    Vec4 $p = $c->premultiplied();
    assert(equal($p->x, 0.5f), 'r');
    assert(equal($p->y, 0.25f), 'g');
    assert(equal($p->z, 0.0f), 'b');
    assert(equal($p->w, 0.5f), 'a');
}

test color_hex_rgb
{
    Color $c = Color(rgb: 0xff0000 as uint32);
    assert(equal($c->r, 1.0f), 'r');
    assert(equal($c->g, 0.0f), 'g');
    assert(equal($c->b, 0.0f), 'b');
    assert(equal($c->a, 1.0f), 'a');
}

test color_named
{
    Color $w = Color::white();
    assert(equal($w->r, 1.0f) && equal($w->a, 1.0f), 'white');
    Color $t = Color::transparent();
    assert(equal($t->a, 0.0f), 'clear');
}
