/**
 * Path commands and control-point bounds.
 */

use visu::geo::AABB2D;
use visu::math::{Vec2, equal};
use visu::vg::Path;

test path_rect_bounds
{
    Path $p = Path();
    $p->rect(Vec2(10.0f, 20.0f), Vec2(30.0f, 40.0f));
    AABB2D $b = $p->bounds();
    assert(equal($b->min, Vec2(10.0f, 20.0f)), 'min');
    assert(equal($b->max, Vec2(40.0f, 60.0f)), 'max');
    assert(equal($b->width(), 30.0f), 'w');
    assert(equal($b->height(), 40.0f), 'h');
}

test path_clear
{
    Path $p = Path();
    $p->rect(Vec2(0.0f, 0.0f), Vec2(10.0f, 10.0f));
    $p->clear();
    AABB2D $b = $p->bounds();
    assert(equal($b->width(), 0.0f), 'empty w');
    assert(equal($b->height(), 0.0f), 'empty h');
}

test path_circle_bounds_contains_radius
{
    Path $p = Path();
    $p->circle(Vec2(0.0f, 0.0f), 10.0f);
    AABB2D $b = $p->bounds();
    assert($b->width() >= 19.9f, 'w');
    assert($b->height() >= 19.9f, 'h');
}
