/**
 * CameraSystem publishes CameraData from the ActiveCamera marker.
 * GPU-free.
 */

use visu::components::{ActiveCamera, FlyingCamera};
use visu::ecs::{Entities, Entity};
use visu::geo::{Pose, Transform};
use visu::graphics::{
    Camera, CameraData, CameraOverrideData, RenderContext, Device, Frame, Pipeline, Pool,
    Projection, RenderTarget, SceneTargetData, TargetRef
};
use visu::math::{Quat, Vec3};
use visu::system::CameraSystem;

internal function headlessFrame(int32 $width, int32 $height) : RenderContext
{
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget($width, $height);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    return RenderContext($device, $pipeline, $frame, $pool, 0.0f);
}

test camera_marker_records_the_tick
{
    Entities $world = Entities();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    assert(!$world->has<ActiveCamera>($entity), 'spawn is not active');
    ActiveCamera::activate($world, $entity);
    assert($world->has<ActiveCamera>($entity), 'marked');
    assert($world->get<ActiveCamera>($entity)->tick == 0, 'tick default');
    ActiveCamera::activate($world, $entity, 12);
    assert($world->get<ActiveCamera>($entity)->tick == 12, 'tick');
}

test camera_activate_detaches_the_previous_marker
{
    Entities $world = Entities();
    Entity $a = Camera::spawn($world, Vec3(0.0f, 0.0f, 1.0f));
    Entity $b = Camera::spawn($world, Vec3(0.0f, 0.0f, 8.0f));
    ActiveCamera::activate($world, $a);
    ActiveCamera::activate($world, $b, 3);
    assert(!$world->has<ActiveCamera>($a), 'old marker gone');
    assert($world->has<ActiveCamera>($b), 'new marker');
    assert($world->get<ActiveCamera>($b)->tick == 3, 'tick');
    assert($world->view<ActiveCamera>()->size() == 1, 'one');
}

test camera_system_publishes_from_the_marker
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(5.4f, 2.4f, 14.4f));
    $world->attach($entity, FlyingCamera());
    ActiveCamera::activate($world, $entity);
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->x == 5.4f, 'position x');
    assert($transform->position->z == 14.4f, 'position z');
    Camera& $camera = $world->get<Camera>($entity);
    assert($camera->mode == Projection::perspective, 'perspective');
}

test camera_system_publishes_camera_data_for_the_scene_target
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    $world->attach($entity, FlyingCamera());
    ActiveCamera::activate($world, $entity);
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    TargetRef $scene = $pipeline->createTarget('scene', 320, 200);
    $frame->set(SceneTargetData($scene));
    RenderContext $ctx = RenderContext($device, $pipeline, $frame, $pool, 0.5f);
    $system->render($world, $ctx);
    assert($frame->has<CameraData>(), 'published');
    CameraData $data = $frame->get<CameraData>();
    assert($data->resolutionX == 320, 'scene width');
    assert($data->resolutionY == 200, 'scene height');
    assert($data->compensation == 0.5f, 'compensation');
    assert($data->position->z == 4.0f, 'camera position');
}

test camera_system_falls_back_to_the_backbuffer
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 0.0f));
    $world->attach($entity, FlyingCamera());
    ActiveCamera::activate($world, $entity);
    RenderContext $ctx = headlessFrame(128, 64);
    $system->render($world, $ctx);
    CameraData $data = $ctx->frame->get<CameraData>();
    assert($data->resolutionX == 128, 'backbuffer width');
}

test camera_system_publishes_the_marked_camera
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $a = Camera::spawn($world, Vec3(0.0f, 0.0f, 1.0f));
    Entity $b = Camera::spawn($world, Vec3(0.0f, 0.0f, 8.0f));
    assert($a != $b, 'two cameras');
    ActiveCamera::activate($world, $b);
    RenderContext $ctx = headlessFrame(64, 64);
    $system->render($world, $ctx);
    CameraData $data = $ctx->frame->get<CameraData>();
    assert($data->position->z == 8.0f, 'marked camera');
}

test camera_system_without_a_marker_publishes_nothing
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $idle = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    assert($world->has<Camera>($idle), 'spawned');
    RenderContext $ctx = headlessFrame(64, 64);
    $system->render($world, $ctx);
    assert(!$ctx->frame->has<CameraData>(), 'nothing published');
}

test camera_system_honours_override_data
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    ActiveCamera::activate($world, $entity);
    RenderContext $ctx = headlessFrame(64, 64);
    $ctx->frame->set(CameraOverrideData(Vec3(1.0f, 2.0f, 3.0f), Quat(), 90.0f));
    $system->render($world, $ctx);
    CameraData $data = $ctx->frame->get<CameraData>();
    assert($data->position->x == 1.0f, 'override x');
    assert($data->position->z == 3.0f, 'override z');
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->z == 4.0f, 'entity untouched');
    Camera& $camera = $world->get<Camera>($entity);
    assert($camera->fov == 45.0f, 'entity fov untouched');
    RenderContext $plain = headlessFrame(64, 64);
    $system->render($world, $plain);
    CameraData $back = $plain->frame->get<CameraData>();
    assert($back->position->z == 4.0f, 'no override, entity pose again');
}

test camera_system_snapshots_every_camera
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $a = Camera::spawn($world, Vec3(1.0f, 0.0f, 0.0f));
    Entity $b = Camera::spawn($world, Vec3(2.0f, 0.0f, 0.0f));
    ActiveCamera::activate($world, $a);
    $system->update($world);
    $world->get<Transform>($a)->position = Vec3(10.0f, 0.0f, 0.0f);
    $world->get<Transform>($b)->position = Vec3(20.0f, 0.0f, 0.0f);
    Pose $pa = $world->get<Transform>($a)->mix(0.0f);
    Pose $pb = $world->get<Transform>($b)->mix(0.0f);
    assert($pa->position->x == 1.0f, 'active previous');
    assert($pb->position->x == 2.0f, 'inactive previous');
}

test camera_system_freeze_keeps_cull_on_the_snapshot
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    ActiveCamera::activate($world, $entity);
    RenderContext $first = headlessFrame(64, 64);
    $system->setFrozen(true);
    $system->render($world, $first);
    CameraData $snap = $first->frame->get<CameraData>();
    assert($snap->cullFrozen, 'frozen this frame');
    assert($snap->position->z == 4.0f, 'live still here');
    assert($snap->cullPosition->z == 4.0f, 'cull matches on the snapshot frame');

    $world->get<Transform>($entity)->position = Vec3(500.0f, 0.0f, 4.0f);
    RenderContext $moved = headlessFrame(64, 64);
    $system->render($world, $moved);
    CameraData $data = $moved->frame->get<CameraData>();
    assert($data->cullFrozen, 'still frozen');
    assert($data->position->x == 500.0f, 'render eye followed the entity');
    assert($data->cullPosition->x == 0.0f, 'cull eye stayed');
    assert($data->cullPosition->z == 4.0f, 'cull z stayed');
    assert($data->cullFrustum->contains(Vec3(0.0f, 0.0f, -10.0f), 1.0f), 'old look still in cull');
    assert(!$data->frustum->contains(Vec3(0.0f, 0.0f, -10.0f), 1.0f), 'old look is beside the live camera');
    assert($data->frustum->contains(Vec3(500.0f, 0.0f, -10.0f), 1.0f), 'new look in the render frustum');
    assert(!$data->cullFrustum->contains(Vec3(500.0f, 0.0f, -10.0f), 1.0f), 'new look outside the freeze');
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->x == 500.0f, 'entity was not pinned');

    $system->setFrozen(false);
    RenderContext $live = headlessFrame(64, 64);
    $system->render($world, $live);
    CameraData $joined = $live->frame->get<CameraData>();
    assert(!$joined->cullFrozen, 'released');
    assert($joined->cullPosition->x == 500.0f, 'cull joined the entity');
    assert($joined->position->x == 500.0f, 'render stayed with the entity');
}

test camera_system_freeze_override_moves_only_the_render_half
{
    Entities $world = Entities();
    CameraSystem $system = CameraSystem();
    Entity $entity = Camera::spawn($world, Vec3(0.0f, 0.0f, 4.0f));
    ActiveCamera::activate($world, $entity);
    RenderContext $first = headlessFrame(64, 64);
    $system->setFrozen(true);
    $system->render($world, $first);
    RenderContext $over = headlessFrame(64, 64);
    $over->frame->set(CameraOverrideData(Vec3(1.0f, 2.0f, 9.0f), Quat(), 90.0f));
    $system->render($world, $over);
    CameraData $data = $over->frame->get<CameraData>();
    assert($data->position->z == 9.0f, 'override is the render eye');
    assert($data->cullPosition->z == 4.0f, 'cull stayed on the freeze');
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->z == 4.0f, 'entity still untouched');
}
