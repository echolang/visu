/**
 * CameraSystem entity handling and the CameraData handoff. Movement
 * needs a real window (Input.down is glfwGetKey), so it lives in the
 * glfw group; everything here is GPU-free.
 */

use visu::ecs::{Entities, Entity};
use visu::geo::Transform;
use visu::graphics::{
    Backbuffer, Camera, CameraData, Context, Device, Frame, Pipeline, Pool,
    Projection, RenderTarget, SceneTarget, TargetRef, TextureOptions
};
use visu::math::{Vec2, Vec3};
use visu::os::{Input, Window};
use visu::signal::Dispatcher;
use visu::system::{CameraMode, CameraSystem};

internal function headlessCamera() : CameraSystem
{
    return CameraSystem(Input(Window('camera', 64, 64), Dispatcher()), Dispatcher());
}

test camera_system_starts_without_a_camera
{
    Entities $world = Entities();
    CameraSystem $system = headlessCamera();
    assert(!$system->valid($world, $system->activeCamera), 'no active camera');
}

test camera_system_spawns_a_flying_camera
{
    Entities $world = Entities();
    CameraSystem $system = headlessCamera();
    Entity $entity = $system->spawnDefaultFlyingCamera($world, Vec3(5.4f, 2.4f, 14.4f));
    assert($system->activeCamera == $entity, 'active');
    assert($system->valid($world, $entity), 'camera and transform');
    assert($system->mode == CameraMode::flying, 'flying');
    Transform& $transform = $world->get<Transform>($entity);
    assert($transform->position->x == 5.4f, 'position x');
    assert($transform->position->z == 14.4f, 'position z');
    Camera& $camera = $world->get<Camera>($entity);
    assert($camera->mode == Projection::perspective, 'perspective');
}

test camera_system_publishes_camera_data_for_the_scene_target
{
    Entities $world = Entities();
    CameraSystem $system = headlessCamera();
    $system->spawnDefaultFlyingCamera($world, Vec3(0.0f, 0.0f, 4.0f));
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    TargetRef $scene = $pipeline->createTarget('scene', 320, 200);
    $frame->set(SceneTarget($scene));
    Context $ctx = Context($device, $pipeline, $frame, $pool, 0.5f);
    $system->render($world, $ctx);
    assert($frame->has<CameraData>(), 'published');
    CameraData $data = $frame->get<CameraData>();
    assert($data->resolutionX == 320, 'scene width');
    assert($data->resolutionY == 200, 'scene height');
    assert($data->compensation == 0.5f, 'compensation');
    assert($data->position->z == 4.0f, 'camera position');
}

test camera_system_falls_back_to_the_backbuffer
{
    Entities $world = Entities();
    CameraSystem $system = headlessCamera();
    $system->spawnDefaultFlyingCamera($world, Vec3(0.0f, 0.0f, 0.0f));
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(128, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    Context $ctx = Context($device, $pipeline, $frame, $pool, 0.0f);
    $system->render($world, $ctx);
    CameraData $data = $frame->get<CameraData>();
    assert($data->resolutionX == 128, 'backbuffer width');
}

test camera_system_without_a_camera_publishes_nothing
{
    Entities $world = Entities();
    CameraSystem $system = headlessCamera();
    Device $device = Device();
    Pool $pool = Pool($device);
    Frame $frame = Frame();
    RenderTarget $rt = RenderTarget(64, 64);
    Pipeline $pipeline = Pipeline($pool, $frame, $rt);
    Context $ctx = Context($device, $pipeline, $frame, $pool, 0.0f);
    $system->render($world, $ctx);
    assert(!$frame->has<CameraData>(), 'nothing published');
}
