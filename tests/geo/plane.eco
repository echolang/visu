/**
 * Plane constructor normalizes the normal and distance.
 */

use visu::geo::Plane;
use visu::math::{Vec3, equal, length};

test plane_normalizes
{
    Plane $p = Plane(Vec3(0.0f, 2.0f, 0.0f), 4.0f);
    assert(equal(length($p->normal), 1.0f), 'unit');
    assert(equal($p->normal, Vec3(0.0f, 1.0f, 0.0f)), 'up');
    assert(equal($p->distance, 2.0f), 'd');
}
