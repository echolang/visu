/**
 * AABB2D contains, union, apply from a Transform.
 */

use visu::geo::{AABB2D, Transform};
use visu::math::{Vec2, Vec3, equal};

test aabb2d_contains_and_union
{
    AABB2D $a = AABB2D(Vec2(0.0f, 0.0f), Vec2(2.0f, 2.0f));
    AABB2D $b = AABB2D(Vec2(1.0f, 1.0f), Vec2(3.0f, 3.0f));
    assert($a->contains(Vec2(1.0f, 1.0f)), 'point');
    assert($a->intersects($b), 'overlap');
    AABB2D $u = AABB2D::union($a, $b);
    assert(equal($u->min, Vec2(0.0f, 0.0f)), 'umin');
    assert(equal($u->max, Vec2(3.0f, 3.0f)), 'umax');
    assert($u->contains($a), 'holds a');
}

test aabb2d_apply_scale_and_translate
{
    AABB2D $box = AABB2D(Vec2(-1.0f, -1.0f), Vec2(1.0f, 1.0f));
    Transform $t = Transform();
    $t->position = Vec3(10.0f, 20.0f, 0.0f);
    $t->scale = Vec3(2.0f, 3.0f, 1.0f);
    $box->apply($t);
    assert(equal($box->min, Vec2(8.0f, 17.0f)), 'min');
    assert(equal($box->max, Vec2(12.0f, 23.0f)), 'max');
}
