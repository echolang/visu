/**
 * Gribb/Hartmann frustum from a view-projection matrix.
 */

use visu::geo::Frustum;
use visu::math::{Mat4, Vec3, lookAt, perspective};

test frustum_contains_points_on_the_look_axis
{
    Mat4 $proj = perspective(fovY: std::math::PI_F32 / 2.0f, aspect: 1.0f, near: 1.0f, far: 20.0f);
    Mat4 $view = lookAt(eye: Vec3(0.0f, 0.0f, 5.0f), center: Vec3(0.0f, 0.0f, 0.0f), up: Vec3(0.0f, 1.0f, 0.0f));
    Frustum $f = Frustum($proj * $view);

    assert($f->contains(Vec3(0.0f, 0.0f, 0.0f), 0.1f), 'origin');
    assert($f->contains(Vec3(0.0f, 0.0f, 2.0f), 0.1f), 'ahead');
    assert(!$f->contains(Vec3(0.0f, 0.0f, 50.0f), 0.1f), 'behind');
    assert(!$f->contains(Vec3(80.0f, 0.0f, 0.0f), 0.1f), 'side');
}
