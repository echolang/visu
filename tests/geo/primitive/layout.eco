/**
 * PrimitiveLayout stride, offsets, presets.
 */

use visu::geo::{Attrib, PrimitiveLayout};

test primitive_layout_stride_and_offsets
{
    PrimitiveLayout $l = PrimitiveLayout::pos3n3uv2();
    assert($l->stride() == 8, 'stride');
    assert($l->has(Attrib::normal), 'has n');
    assert($l->has(Attrib::uv), 'has uv');
    int32 $po = $l->offset(Attrib::position) ?? -1;
    int32 $no = $l->offset(Attrib::normal) ?? -1;
    int32 $uo = $l->offset(Attrib::uv) ?? -1;
    assert($po == 0, 'pos off');
    assert($no == 3, 'n off');
    assert($uo == 6, 'uv off');
}

test primitive_layout_position_only
{
    PrimitiveLayout $l = PrimitiveLayout::pos3();
    assert($l->stride() == 3, '3');
    assert($l->offset(Attrib::uv) == null, 'no uv');
}

#[tests: expects death]
test primitive_layout_duplicate_dies
{
    array<visu::geo::Attrib> $a = array<visu::geo::Attrib>();
    $a[] = visu::geo::Attrib::position;
    $a[] = visu::geo::Attrib::position;
    PrimitiveLayout $l = PrimitiveLayout($a);
}
