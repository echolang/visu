/**
 * PrimitiveBuilder writes only the requested attribs.
 */

use visu::geo::{PrimitiveBuilder, PrimitiveLayout};
use visu::math::Vec3;

test builder_writes_position_normal
{
    PrimitiveBuilder $b = PrimitiveBuilder(PrimitiveLayout::pos3n3());
    $b->add(Vec3(1.0f, 2.0f, 3.0f), Vec3(0.0f, 1.0f, 0.0f));
    assert($b->data->count() == 6, '6 floats');
    assert($b->data[0] == 1.0f, 'x');
    assert($b->data[4] == 1.0f, 'ny');
}

#[tests: expects death]
test builder_missing_uv_dies
{
    array<visu::geo::Attrib> $attribs = array<visu::geo::Attrib>();
    $attribs[] = visu::geo::Attrib::position;
    $attribs[] = visu::geo::Attrib::uv;
    PrimitiveBuilder $b = PrimitiveBuilder(PrimitiveLayout($attribs));
    $b->add(Vec3(0.0f, 0.0f, 0.0f));
}
