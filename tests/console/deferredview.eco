/**
 * DeferredViewConsole routing.
 */

use visu::console::DeferredViewConsole;
use visu::ecs::{Entities, Systems};
use visu::graphics::{DeferredRenderer, DeferredView, Device, SsaoLevel, SsaoQuality};
use visu::os::{Window, WindowHints};
use visu::os::input::InputHub;
use visu::runtime::DebugConsole;
use visu::signal::Dispatcher;

function ssaoLine(string $state, SsaoQuality $q) : string
{
    string $level = $q->level->label();
    return "ssao: {$state}, quality {$level}, strength {$q->strength}, radius {$q->radius}";
}

test deferred_view_console_sets_renderer
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = DebugConsole($d, InputHub(Window('view', 64, 64, WindowHints()), $d));
    DeferredRenderer $renderer = DeferredRenderer(Device());
    DeferredViewConsole $verbs = DeferredViewConsole($renderer);
    Systems $systems = Systems();
    $systems->listen($c);
    $systems->bindConsole($verbs);

    Entities $world = Entities();
    $systems->register($world);

    $c->submit('view');
    array<string> $h0 = $c->history();
    assert($h0[$h0->count() - 1] == 'view: scene', 'default');
    assert($renderer->view == DeferredView::scene, 'still scene');

    $c->submit('view albedo');
    assert($renderer->view == DeferredView::albedo, 'albedo');
    array<string> $h1 = $c->history();
    assert($h1[$h1->count() - 1] == 'view: albedo', 'albedo line');

    $c->submit('view ssao');
    assert($renderer->view == DeferredView::ssao, 'ssao');

    $c->submit('view nope');
    assert($renderer->view == DeferredView::ssao, 'unchanged');
    array<string> $h2 = $c->history();
    assert(
        $h2[$h2->count() - 1] == 'usage: view [scene|albedo|normal|roughness|metallic|ao|emissive|position|ssao|id]',
        'usage'
    );

    $c->submit('view scene');
    assert($renderer->view == DeferredView::scene, 'back');

    $renderer->ssao = null;
    $c->submit('view ssao');
    assert($renderer->view == DeferredView::ssao, 'ssao off kept');
    array<string> $h3 = $c->history();
    assert($h3[$h3->count() - 1] == 'view: ssao (ssao is off)', 'ssao off line');

    $systems->unregister($world);
}

test deferred_view_console_ssao_toggle
{
    Dispatcher $d = Dispatcher();
    DebugConsole $c = DebugConsole($d, InputHub(Window('ssao', 64, 64, WindowHints()), $d));
    DeferredRenderer $renderer = DeferredRenderer(Device());
    DeferredViewConsole $verbs = DeferredViewConsole($renderer);
    Systems $systems = Systems();
    $systems->listen($c);
    $systems->bindConsole($verbs);

    Entities $world = Entities();
    $systems->register($world);

    $c->submit('ssao');
    SsaoQuality $q0 = guard $renderer->ssao;
    array<string> $h0 = $c->history();
    assert($h0[$h0->count() - 1] == ssaoLine('on', $q0), 'default');
    assert($q0->level == SsaoLevel::ultra, 'default quality');

    $q0->radius = 2.5f;
    $c->submit('ssao off');
    assert($renderer->ssao == null, 'off');
    array<string> $h1 = $c->history();
    assert($h1[$h1->count() - 1] == ssaoLine('off', $q0), 'off line');

    $c->submit('view ssao');
    array<string> $hView = $c->history();
    assert($hView[$hView->count() - 1] == 'view: ssao (ssao is off)', 'view while off');

    $c->submit('ssao on');
    SsaoQuality $q1 = guard $renderer->ssao;
    assert($q1->radius == 2.5f, 'radius kept');
    array<string> $h2 = $c->history();
    assert($h2[$h2->count() - 1] == ssaoLine('on', $q1), 'on line');

    $c->submit('ssao toggle');
    assert($renderer->ssao == null, 'toggle off');
    $c->submit('ssao toggle');
    SsaoQuality $q2 = guard $renderer->ssao;
    assert($q2->radius == 2.5f, 'toggle on');

    $c->submit('ssao strength 4');
    assert($q2->strength == 4.0f, 'strength');
    array<string> $hStrength = $c->history();
    assert($hStrength[$hStrength->count() - 1] == ssaoLine('on', $q2), 'strength line');

    $c->submit('ssao quality low');
    assert($q2->level == SsaoLevel::low, 'quality');
    assert($q2->samples == 16, 'quality samples');
    assert($q2->strength == 4.0f, 'quality keeps strength');
    assert($q2->radius == 2.5f, 'quality keeps radius');
    array<string> $hQuality = $c->history();
    assert($hQuality[$hQuality->count() - 1] == ssaoLine('on', $q2), 'quality line');

    $c->submit('ssao off');
    $c->submit('ssao quality high');
    $c->submit('ssao on');
    SsaoQuality $q3 = guard $renderer->ssao;
    assert($q3->level == SsaoLevel::high, 'quality while off');
    assert($q3->strength == 4.0f, 'strength while off');

    $c->submit('ssao nope');
    array<string> $h3 = $c->history();
    assert(
        $h3[$h3->count() - 1] == 'usage: ssao [on|off|toggle|quality <low|medium|high|ultra>|strength <x>]',
        'usage'
    );

    $c->submit('ssao quality');
    array<string> $h4 = $c->history();
    assert(
        $h4[$h4->count() - 1] == 'usage: ssao [on|off|toggle|quality <low|medium|high|ultra>|strength <x>]',
        'quality usage'
    );

    $systems->unregister($world);
}
