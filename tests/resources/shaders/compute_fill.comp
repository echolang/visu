#version 450

// one colour per grid cell: r is the column, g the row, b marks "written by the kernel"
layout(local_size_x = 16) in;

layout(std430, set = 2, binding = 0) writeonly buffer Cells {
    vec4 colors[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= 64u) {
        return;
    }
    float col = float(i % 8u);
    float row = float(i / 8u);
    colors[i] = vec4(col / 7.0, row / 7.0, 1.0, 1.0);
}
