#version 450

// writes one draw (6 vertices, 64 instances) and one dispatch (64 threads of 16) for the
// indirect check, so the CPU never sees either count
layout(local_size_x = 1) in;

layout(std430, set = 2, binding = 0) writeonly buffer Args {
    uint words[];
};

void main()
{
    // drawIndirect: vertex count, instance count, first vertex, first instance
    words[0] = 6u;
    words[1] = 64u;
    words[2] = 0u;
    words[3] = 0u;
    // dispatchIndirect: groups along x, y and z
    words[4] = 4u;
    words[5] = 1u;
    words[6] = 1u;
    words[7] = 0u;
}
