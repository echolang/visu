/**
 * Signal payload fields. No window; the producer holds that.
 */

use visu::ecs::Entity;
use visu::math::Vec2;
use visu::os::input;
use visu::os::input::{KeyPhase, MOD_CONTROL, MOD_SHIFT};
use visu::signal::{
    CharModSignal, CharSignal, ClickSignal, ConsoleCommandSignal, CursorEnterSignal,
    CursorSignal, DropSignal, EntitySelectedSignal, FocusSignal, KeySignal,
    MouseButtonSignal, PauseSignal, Pick, ResumeSignal, ScrollSignal, TouchSignal
};

test console_command_parts
{
    ConsoleCommandSignal $cmd = ConsoleCommandSignal('spawn box');
    assert($cmd->raw == 'spawn box', 'raw');
    assert($cmd->parts->count() == 2, 'n');
    assert($cmd->isAction('spawn'), 'action');
    assert(!$cmd->isAction('kill'), 'other');
}

test entity_selected
{
    Entity $e = Entity(index: 3, version: 1);
    EntitySelectedSignal $sel = EntitySelectedSignal($e, Pick::picker);
    assert($sel->entity == $e, 'entity');
    bool $fromPicker = match ($sel->pick) {
        Pick::picker => true,
    };
    assert($fromPicker, 'picker');
}

test key_fields
{
    int32 $mods = MOD_SHIFT | MOD_CONTROL;
    KeySignal $k = KeySignal(.a, 0, .press, $mods);
    assert($k->key == input::Key::a, 'key');
    assert($k->phase == KeyPhase::press, 'press');
    assert($k->isShift(), 'shift');
    assert($k->isControl(), 'control');
    assert(!$k->isAlt(), 'alt');
    assert(!$k->isSuper(), 'super');
    assert(!$k->isCapsLock(), 'caps');
    assert(!$k->isNumLock(), 'num');
}

test char_text_utf8
{
    CharSignal $a = CharSignal(65);
    string $at = guard $a->text() else {
        die('A');
    }
    assert($at == 'A', 'A');
    CharSignal $e = CharSignal(0xE9);
    string $et = guard $e->text() else {
        die('e-acute');
    }
    assert($et == 'é', 'e-acute');
    string? $bad = CharSignal(-1)->text();
    assert($bad == null, 'invalid');
    CharModSignal $cm = CharModSignal(66, 0);
    string $bt = guard $cm->text() else {
        die('B');
    }
    assert($bt == 'B', 'B');
}

test touch_and_lifecycle_fields
{
    TouchSignal $t = TouchSignal(3, .began, Vec2(1.0f, 2.0f), 0.5f);
    assert($t->id == 3, 'id');
    assert($t->position->x == 1.0f, 'x');
    assert($t->force == 0.5f, 'force');
    PauseSignal $p = PauseSignal();
    ResumeSignal $r = ResumeSignal();
    FocusSignal $f = FocusSignal(true);
    assert($f->gained, 'gained');

}

test mouse_button_fields
{
    MouseButtonSignal $left = MouseButtonSignal(.left, .press, 0);
    assert($left->isLeft(), 'left');
    assert($left->isLeftDown(), 'down');
    assert(!$left->isLeftUp(), 'not up');
    MouseButtonSignal $right = MouseButtonSignal(.right, .release, 0);
    assert($right->isRight(), 'right');
    assert($right->isRightUp(), 'up');
    assert(!$right->isRightDown(), 'not down');
    MouseButtonSignal $mid = MouseButtonSignal(.middle, .press, 0);
    assert($mid->isMiddle(), 'middle');
    assert($mid->isMiddleDown(), 'mid down');
    assert(!$mid->isMiddleUp(), 'mid not up');
}

test click_cursor_scroll_enter_drop
{
    Vec2 $pos = Vec2(4.0f, 8.0f);
    Vec2 $start = Vec2(1.0f, 2.0f);
    ClickSignal $click = ClickSignal(0, $pos, $start, 5.0f);
    assert($click->travel == 5.0f, 'travel');
    assert($click->position->x == 4.0f, 'px');
    CursorSignal $cursor = CursorSignal(10.0, 20.0, 1.0, -2.0);
    assert($cursor->x == 10.0, 'x');
    assert($cursor->offsetY == -2.0, 'oy');
    ScrollSignal $scroll = ScrollSignal(0.0, 3.0);
    assert($scroll->y == 3.0, 'sy');
    CursorEnterSignal $enter = CursorEnterSignal(true);
    assert($enter->entered, 'in');
    CursorEnterSignal $leave = CursorEnterSignal(false);
    assert(!$leave->entered, 'out');
    DropSignal $drop = DropSignal('a.obj');
    assert($drop->path == 'a.obj', 'path');
}
