/**
 * Debug HTTP body parsers: console lines, live steps, camera and click bodies.
 */

use visu::dcapture::{CameraSpec, Step};

test debughttp_console_body_json_list
{
    array<string> $lines = guard visu::debughttp::parseConsoleBody('{"commands":["time pause","moon age 12"]}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($lines->count() == 2, 'two commands');
    assert($lines[1] == 'moon age 12', 'order kept');
}

test debughttp_console_body_single_and_text
{
    array<string> $one = guard visu::debughttp::parseConsoleBody('{"command":"fog"}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($one->count() == 1 && $one[0] == 'fog', 'one command');
    array<string> $text = guard visu::debughttp::parseConsoleBody("time\n\n  godrays off  \n") else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($text->count() == 2, 'blank lines skipped');
    assert($text[1] == 'godrays off', 'lines trimmed');
}

test debughttp_console_body_rejects
{
    bool $empty = visu::debughttp::parseConsoleBody('   ')->has_value();
    assert(!$empty, 'empty body');
    bool $wrong = visu::debughttp::parseConsoleBody('{"commands":[1]}')->has_value();
    assert(!$wrong, 'non-string command');
    bool $broken = visu::debughttp::parseConsoleBody('{"commands":')->has_value();
    assert(!$broken, 'bad json');
}

test debughttp_step_body_ignores_timing
{
    Step $step = guard visu::debughttp::parseStepBody('{"console":["time"],"dump":["scene"]}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($step->console->count() == 1, 'console line');
    assert($step->dump->count() == 1, 'dump pattern');
    Step $timed = guard visu::debughttp::parseStepBody('{"frame":40,"profile":true}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($timed->profile, 'a timing key is ignored, not an error');
}

test debughttp_camera_and_click_bodies
{
    Step $cam = guard visu::debughttp::parseCameraBody('{"position":[0,10,20],"lookAt":[0,0,0],"fov":50}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    bool $posed = match ($cam->camera) {
        CameraSpec::pose($p, $q, $fov) => $fov == 50.0f,
        else => false,
    };
    assert($posed, 'pose with its fov');
    Step $click = guard visu::debughttp::parseClickBody('{"x":950,"y":560}') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($click->click && $click->clickX == 950.0 && $click->clickY == 560.0, 'object click');
    Step $pair = guard visu::debughttp::parseClickBody('[10, 20]') else ($e) {
        assert(false, "parse failed");
        return;
    }
    assert($pair->clickY == 20.0, 'array click');
    bool $bad = visu::debughttp::parseClickBody('{"x":1}')->has_value();
    assert(!$bad, 'missing y');
}

test debughttp_host_header_must_be_local
{
    assert(visu::debughttp::localHost('127.0.0.1:7777', '127.0.0.1'), 'loopback with port');
    assert(visu::debughttp::localHost('localhost', '127.0.0.1'), 'localhost');
    assert(visu::debughttp::localHost('[::1]:7777', '127.0.0.1'), 'ipv6 loopback');
    assert(visu::debughttp::localHost('10.0.0.5:7777', '10.0.0.5'), 'the bound address');
    assert(!visu::debughttp::localHost('evil.example:7777', '127.0.0.1'), 'a rebound name');
    assert(!visu::debughttp::localHost('127.0.0.1.evil.example', '127.0.0.1'), 'a lookalike name');
}
