/*
 * Starter-shaped app: Game as GameLoopDelegate + Application, Director, menu + play.
 * Not Quickstart.
 *
 *   echoc run -m examples --target fullapp
 *   echoc run -m examples --target fullapp --define VISU_FINITE
 */

use std::env;
use std::io;
use visu::app::{Paths, Services, bootstrap, run};

Services $services = bootstrap(Paths(root: fullappRoot()), function(Services $s) : void {
});

run(Game($services));

internal function fullappRoot() : string
{
    if (fullappExists('resources/shader/cube.vert.spv') || fullappExists('resources/shader/cube.vert.metal')) {
        return env::cwd();
    }

    if (fullappExists('fullapp/resources/shader/cube.vert.spv') || fullappExists('fullapp/resources/shader/cube.vert.metal')) {
        return 'fullapp';
    }

    return 'examples/fullapp';
}

internal function fullappExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
