/*
 * Starter-shaped app: Game as Delegate, Director, menu + play.
 * Not Quickstart.
 *
 *   echoc run -m examples --target fullapp
 *   echoc run -m examples --target fullapp --define VISU_FINITE
 */

use std::env;
use std::io;
use visu::app::{HostError, Paths, Services, bootstrap};
use visu::os::{init, run, terminate};
use visu::runtime::{registerMain, unregisterMain};

Services $services = bootstrap(Paths(root: fullappRoot()), function(Services $s) : void {
});

Game $game = Game($services);
run(
    function() : void {
        guard init() else ($e) {
            die($e->message());
        }

        guard $game->initialize() else ($e) {
            $game->destroy();
            terminate();
            die($e->message());
        }

        registerMain($game->host->events);
        $game->prepare();
    },
    function() : void {
        $game->tick();
    },
    function() : void {
        HostError $fail = $game->host->fail;
        $game->destroy();
        unregisterMain();
        terminate();

        if ($fail->failed()) {
            die($fail->message());
        }
    }
);

internal function fullappRoot() : string
{
    if (fullappExists('resources/shader/cube.vert.spv') || fullappExists('resources/shader/cube.vert.metal')) {
        return env::cwd();
    }

    if (fullappExists('fullapp/resources/shader/cube.vert.spv') || fullappExists('fullapp/resources/shader/cube.vert.metal')) {
        return 'fullapp';
    }

    return 'examples/fullapp';
}

internal function fullappExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
