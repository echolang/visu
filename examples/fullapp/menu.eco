/**
 * Main menu: FlyUI card with Play / Quit. ESC quits. No 3D.
 */

use visu::app::Host;
use visu::graphics::Context;
use visu::scene::{Scene, Switch};
use visu::ui::{Align, Layout, Ui};

public class Menu : Scene
{
    private Host $host;

    public constructor(Host $host)
    {
        $this->host = $host;
    }

    public const function name() : string
    {
        return 'menu';
    }

    public function load() : void
    {
        guard $this->host->inputContext->switch('menu') else ($e) {
            die($e->message());
        }
    }

    public function unload() : void
    {
    }

    public function update() : void
    {
        if ($this->host->inputContext->actions()->pressed('quit')) {
            $this->quit();
        }
    }

    public function render(const Context& $ctx) : void
    {
    }

    public function ui(Ui $ui) : void
    {
        Layout $root = Layout();
        $root->h = .fill;
        $root->v = .fill;
        $root->align = Align::center;
        $ui->begin($root);
        $ui->beginCard();
        $ui->text('visu', size: 42.0f, bold: true);
        $ui->space(0.0f, 8.0f);
        $ui->text('a scene, not a quickstart', size: 16.0f);
        $ui->space(0.0f, 24.0f);

        if ($ui->button('Play', fill: true)) {
            Scene $next = Play($this->host);
            $this->host->dispatcher->dispatch(Switch($next));
        }

        $ui->space(0.0f, 8.0f);

        if ($ui->button('Quit', fill: true, style: .secondary)) {
            $this->quit();
        }

        $ui->end();
        $ui->end();
    }

    private function quit() : void
    {
        $this->host->window->setShouldClose(true);
    }
}
