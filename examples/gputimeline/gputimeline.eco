/*
 * In-process GpuTimeline check on its own, because gpucheck's QuadPass<T> currently
 * crashes the JIT (missing generic destructor symbol):
 *
 *   echoc run -m examples --target gputimeline
 *   echoc run -m examples --target gputimeline --define VISU_RELEASE
 */

use visu::app::ensureLogger;

ensureLogger();
GpuContext $gpu = gpuHidden('gputimeline');
checkGpuTimeline($gpu);
$gpu->end();
echo 'gputimeline ok';
