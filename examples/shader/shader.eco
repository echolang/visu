/*
 * Compile a fullscreen-quad shader and draw it through the graph.
 * UVs go in red/green; QuadParams.b tints the blue channel.
 *
 *   echoc run -m examples --target shader
 *   echoc run -m examples --target shader --define VISU_FINITE
 */

use std::io;
use visu::app::ensureLogger;
use visu::os::{Window, init, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Device, DeviceError, FrameStatus, Pool, Frame, Pipeline, Backbuffer,
    ClearPass, ClearPassOptions, ShaderCollection, QuadRenderer
};

ensureLogger();
guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu shader', 800, 600);
Device $device = Device();
guard $window->initialize($device) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

Pool $pool = Pool($device);
ShaderCollection $shaders = ShaderCollection($device, shaderDirectory());
guard $shaders->scan() else ($e) {
    $shaders->destroy();
    $pool->destroy();
    $window->destroy();
    $device->shutdown();
    terminate();
    die($e->message());
}

$quadShader = guard $shaders->shader('quad') else ($e) {
    $shaders->destroy();
    $pool->destroy();
    $window->destroy();
    $device->shutdown();
    terminate();
    die($e->message());
}
guard $quadShader->load() else ($e) {
    $shaders->destroy();
    $pool->destroy();
    $window->destroy();
    $device->shutdown();
    terminate();
    die($e->message());
}

QuadRenderer $quad = QuadRenderer($quadShader);
TintParams $params = TintParams(Vec4(0.2f, 0.55f, 0.9f, 1.0f));
int32 $tick = 0;
int32 $frame = 0;

while (!$window->shouldClose() && !visu::finiteDone($frame)) {
    int32 $w = $window->framebufferWidth();
    int32 $h = $window->framebufferHeight();
    FrameStatus $status = guard $device->beginFrame($w, $h) else ($e) {
        match ($e) {
            DeviceError::surfaceLost => {
                break;
            },
            else => {
                die($e->message());
            },
        };
    }

    if ($status == FrameStatus::ready) {
        Frame $data = Frame();
        Pipeline $pipeline = Pipeline($pool, $data, $window->renderTarget());
        Backbuffer $back = $data->get<Backbuffer>();
        $pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.08f, 0.08f, 0.1f, 1.0f))));
        $quad->pass($pipeline, $back->target, $params);
        guard $pipeline->execute($tick) else ($e) {
            guard $window->swap() else ($se) {
                die($se->message());
            }
            die($e->message());
        }
        guard $window->swap() else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    break;
                },
                else => {
                    die($e->message());
                },
            };
        }
    }

    $window->poll();
    $tick = $tick + 1;
    $frame = $frame + 1;
}

$device->waitIdle();
$shaders->destroy();
$pool->destroy();
$window->destroy();
$device->shutdown();
terminate();

internal function shaderDirectory() : string
{
    if (shaderFileExists('shaders/quad.vert.spv') || shaderFileExists('shaders/quad.vert.metal')) {
        return 'shaders';
    }

    if (shaderFileExists('shader/shaders/quad.vert.spv') || shaderFileExists('shader/shaders/quad.vert.metal')) {
        return 'shader/shaders';
    }

    return 'examples/shader/shaders';
}

internal function shaderFileExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
