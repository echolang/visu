/*
 * Compile a fullscreen-quad shader from this example's shaders/ and
 * draw a solid colour.
 *
 *   echoc run -m examples --target shader -- --frames 120
 */

use command;
use std::env;
use std::io;
use visu::os::{Window, init, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Gpu, QuadVertexArray, ShaderCollection, ShaderFile, ShaderProgram, COLOR_BUFFER_BIT
};

command::Command $app = command::Command('shader', '0.1.0', 'draw a fullscreen quad with a shader');
command::Arg $framesArg = $app->arg('frames', '', '<n>', 'close after this many swaps');
$app->fallback($framesArg, '300');

$r = $app->parse(env::argv());

if ($r->error != null) {
    command::Error $e = $r->error ?? .noCommand;
    command::CLIContext $err = .from($r->parsed, $app, .stderr);
    $err->print(command::renderError($e, $app, $r->parsed, $err));
    env::exit(1);
}

$parsed = $r->parsed;
$frames = guard str::int($parsed->value($framesArg)) else {
    die('--frames needs an integer');
}

bool $booted = guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu shader', 800, 600);
Gpu $state = Gpu();
bool $ready = guard $window->initialize($state) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

ShaderCollection $shaders = ShaderCollection(shaderDirectory());
array<ShaderFile> $files = [
    ShaderFile(.vertex, 'quad.vert.glsl'),
    ShaderFile(.fragment, 'quad.frag.glsl')
];
bool $reg = guard $shaders->register('quad', $files) else ($e) {
    $window->destroy();
    terminate();
    die($e->message());
}

ShaderProgram $program = guard $shaders->get($state, 'quad') else ($e) {
    $shaders->destroy($state);
    $window->destroy();
    terminate();
    die($e->message());
}

QuadVertexArray $quad = QuadVertexArray($state);

int32 $n = 0;

while ($n < $frames && !$window->shouldClose()) {
    $state->clearColor(0.08f, 0.08f, 0.1f, 1.0f);
    $state->clear(COLOR_BUFFER_BIT);
    $program->bind($state);
    $program->set($state, 'u_color', Vec4(0.2f, 0.55f, 0.9f, 1.0f));
    $quad->draw($state);
    $window->swap();
    $window->poll();
    $n = $n + 1;
}

$quad->destroy($state);
$shaders->destroy($state);
$window->destroy();
terminate();

internal function shaderDirectory() : string
{
    if (shaderFileExists('shaders/quad.vert.glsl')) {
        return 'shaders';
    }

    if (shaderFileExists('shader/shaders/quad.vert.glsl')) {
        return 'shader/shaders';
    }

    return 'examples/shader/shaders';
}

internal function shaderFileExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
