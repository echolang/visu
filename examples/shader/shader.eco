/*
 * Compile a fullscreen-quad shader and draw it through the graph.
 * UVs go in red/green; QuadParams.b tints the blue channel.
 *
 *   echoc run -m examples --target shader
 *   echoc run -m examples --target shader --define VISU_FINITE
 */

use std::io;
use visu::app::ensureLogger;
use visu::os::{Window, WindowHints, init, requestStop, run, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Device, DeviceError, FrameStatus, Pool, Frame, Pipeline, Backbuffer,
    ClearPass, ClearPassOptions, ShaderCollection, QuadRenderer
};

internal class ShaderExample
{
    public Window $window;
    public Device $device;
    public Pool $pool;
    public ShaderCollection $shaders;
    public QuadRenderer? $quad;
    public TintParams $params;
    public int32 $tick;
    public int32 $frame;

    public constructor()
    {
        $this->window = Window('visu shader', 800, 600, WindowHints());
        $this->device = Device();
        $this->pool = Pool($this->device);
        $this->shaders = ShaderCollection($this->device, shaderDirectory());
        $this->quad = null;
        $this->params = TintParams(Vec4(0.2f, 0.55f, 0.9f, 1.0f));
        $this->tick = 0;
        $this->frame = 0;
    }

    public function start() : void
    {
        guard init() else ($e) {
            die($e->message());
        }

        guard $this->window->initialize($this->device) else ($e) {
            terminate();
            die($e->message());
        }

        $this->window->setVsync(true);
        guard $this->shaders->scan() else ($e) {
            $this->abandon();
            die($e->message());
        }
        $quadShader = guard $this->shaders->shader('quad') else ($e) {
            $this->abandon();
            die($e->message());
        }
        guard $quadShader->load() else ($e) {
            $this->abandon();
            die($e->message());
        }
        $this->quad = QuadRenderer($quadShader);
    }

    public function tick() : void
    {
        if ($this->window->shouldClose() || visu::finiteDone($this->frame)) {
            requestStop();
            return;
        }

        int32 $w = $this->window->framebufferWidth();
        int32 $h = $this->window->framebufferHeight();
        FrameStatus $status = guard $this->device->beginFrame($w, $h) else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    requestStop();
                    return;
                },
                else => {
                    die($e->message());
                },
            };
        }

        if ($status == FrameStatus::ready) {
            QuadRenderer $quad = guard $this->quad else {
                die('shader: quad missing');
            }
            Frame $data = Frame();
            Pipeline $pipeline = Pipeline($this->pool, $data, $this->window->renderTarget());
            Backbuffer $back = $data->get<Backbuffer>();
            $pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.08f, 0.08f, 0.1f, 1.0f))));
            $quad->pass($pipeline, $back->target, $this->params);
            guard $pipeline->execute($this->tick) else ($e) {
                guard $this->window->swap() else ($se) {
                    die($se->message());
                }
                die($e->message());
            }
            guard $this->window->swap() else ($e) {
                match ($e) {
                    DeviceError::surfaceLost => {
                        requestStop();
                        return;
                    },
                    else => {
                        die($e->message());
                    },
                };
            }
        }

        $this->window->poll();
        $this->tick = $this->tick + 1;
        $this->frame = $this->frame + 1;
    }

    public function stop() : void
    {
        $this->device->waitIdle();
        $this->shaders->destroy();
        $this->pool->destroy();
        $this->window->destroy();
        $this->device->shutdown();
        terminate();
    }

    private function abandon() : void
    {
        $this->shaders->destroy();
        $this->pool->destroy();
        $this->window->destroy();
        $this->device->shutdown();
        terminate();
    }
}

ensureLogger();
ShaderExample $app = ShaderExample();
run(
    function() : void {
        $app->start();
    },
    function() : void {
        $app->tick();
    },
    function() : void {
        $app->stop();
    }
);

internal function shaderDirectory() : string
{
    if (shaderFileExists('shaders/quad.vert.spv') || shaderFileExists('shaders/quad.vert.metal')) {
        return 'shaders';
    }

    if (shaderFileExists('shader/shaders/quad.vert.spv') || shaderFileExists('shader/shaders/quad.vert.metal')) {
        return 'shader/shaders';
    }

    return 'examples/shader/shaders';
}

internal function shaderFileExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
