/*
 * Open a window through visu, clear dark grey.
 *
 *   echoc run -m examples --target clear
 *   echoc run -m examples --target clear --define VISU_FINITE
 */

use visu::os::{Window, init, terminate};
use visu::graphics::{Gpu, COLOR_BUFFER_BIT};

guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu', 800, 600);
Gpu $state = Gpu();
guard $window->initialize($state) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

int32 $frame = 0;
while (!$window->shouldClose() && !visu::finiteDone($frame)) {
    $state->clearColor(0.25f, 0.25f, 0.25f, 1.0f);
    $state->clear(COLOR_BUFFER_BIT);
    $window->swap();
    $window->poll();
    $frame = $frame + 1;
}

$window->destroy();
terminate();
