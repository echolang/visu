/*
 * Open a window through visu, clear dark grey.
 *
 *   echoc run -m examples --target clear
 *   echoc run -m examples --target clear --define VISU_FINITE
 */

use visu::app::ensureLogger;
use visu::os::{Window, init, terminate};
use visu::graphics::{Device, DeviceError, FrameStatus, RenderPassDesc, ColorTarget};
use visu::math::Vec4;

ensureLogger();
guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu', 800, 600);
Device $device = Device();
guard $window->initialize($device) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

int32 $frame = 0;
while (!$window->shouldClose() && !visu::finiteDone($frame)) {
    int32 $w = $window->framebufferWidth();
    int32 $h = $window->framebufferHeight();
    FrameStatus $status = guard $device->beginFrame($w, $h) else ($e) {
        match ($e) {
            DeviceError::surfaceLost => {
                break;
            },
            else => {
                die($e->message());
            },
        };
    }

    if ($status == FrameStatus::ready) {
        ColorTarget $color = ColorTarget($device->backbuffer());
        $color->load = .clear;
        $color->store = .store;
        $color->clear = Vec4(0.25f, 0.25f, 0.25f, 1.0f);
        RenderPassDesc $desc = RenderPassDesc();
        $desc->colors[] = $color;
        $enc = $device->beginRender($desc);
        $enc->endRender();
        guard $window->swap() else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    break;
                },
                else => {
                    die($e->message());
                },
            };
        }
    }

    $window->poll();
    $frame = $frame + 1;
}

$device->waitIdle();
$window->destroy();
$device->shutdown();
terminate();
