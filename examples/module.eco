#[module: "visu-examples"]
#[depends: ".."]
#[requires: "echolang/libcommand" { version: "^0.1", source: git "https://github.com/echolang/libcommand" }]
#[if: os != ios]
#[requires: "echolang/libglfw" { version: "^0.1", source: git "https://github.com/echolang/libglfw" }]
#[end]
#[if: os == ios || os == darwin]
#[requires: "echolang/libmetal" { version: "^0.1", source: git "https://github.com/echolang/libmetal" }]
#[end]
#[if: os != ios]
#[requires: "echolang/libvulkan" { version: "^0.1", source: git "https://github.com/echolang/libvulkan" }]
#[end]
#[requires: "echolang/libminiaudio" { version: "^0.1", source: git "https://github.com/echolang/libminiaudio" }]
#[sources: [
    "cli/cli.eco",
    "cli/services.eco",
    "flyui/flyui.eco",
    "pbr/pbr.eco",
    "shared/*.eco"
]]

#[target: exe { name: "cli", entry: "cli/cli.eco" }] {
    #[sources: "cli/*.eco"]
}

#[target: exe { name: "quickstart", entry: "quickstart/quickstart.eco" }] {
    #[sources: ["quickstart/*.eco", "shared/*.eco"]]
}

#[target: exe { name: "flyui", entry: "flyui/flyui.eco" }] {
    #[sources: "flyui/*.eco"]
}

#[target: exe { name: "pbr", entry: "pbr/pbr.eco" }] {
    #[sources: ["pbr/*.eco", "shared/*.eco"]]
}

#[if: os != ios]
#[target: exe { name: "fullapp", entry: "fullapp/fullapp.eco" }] {
    #[sources: "fullapp/*.eco"]
}
#[end]

#[target: exe { name: "audio", entry: "audio/audio.eco" }] {
    #[sources: "audio/*.eco"]
}

#[target: exe { name: "gpucheck", entry: "gpucheck/gpucheck.eco" }] {
    #[sources: [
        "gpucheck/*.eco",
        "../tests/gpu/checks/*.eco",
        "../tests/graphics/gpucontext.eco"
    ]]
}

// from the visu root:
//   epm install -m examples
//   echoc run -m examples --target flyui --define VISU_FINITE
//   echoc run -m examples --target quickstart --define VISU_FINITE
//   echoc run -m examples --target pbr
//   echoc run -m examples --target pbr --define VISU_FINITE --define VISU_PBR_DUMP
//   echoc run -m examples --target fullapp
//   echoc run -m examples --target fullapp --define VISU_FINITE
//   echoc run -m examples --target audio
//   echoc run -m examples --target audio --define VISU_FINITE
//   echoc run -m examples --target gpucheck
//   echoc run -m examples --target cli -- paths
//   echoc run -m examples --target cli -- log --message hi
