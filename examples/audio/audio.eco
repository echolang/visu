/*
 * Named playlist with a 0.5s cross-fade. Bundled sine → click.
 *
 *   echoc run -m examples --target audio
 *   echoc run -m examples --target audio --define VISU_FINITE
 *
 *   echoc build -m examples --target audio --target-os ios
 *   ./examples/ios/pack.sh examples/ecobuild/audio --resources examples/audio/resources
 */

use std::env;
use std::io;
use visu::app::{Paths, Services, bootstrap};
use visu::audio::MusicPlayer;
use visu::math::Vec4;
use visu::os::resourceRoot;
use visu::quickstart::{App, Options, Quickstart};
use visu::runtime::defer;
use visu::signal::{Flow, PauseSignal, ResumeSignal};

Quickstart $qs = Quickstart(function(Options $opt) : void
{
    $opt->windowTitle = 'visu audio';
    $opt->windowWidth = 800;
    $opt->windowHeight = 600;
    $opt->clearColor = Vec4(0.08f, 0.08f, 0.1f, 1.0f);

    $opt->services = bootstrap(Paths(root: exampleRoot()), function(Services $ctn) : void {
    });

    $opt->ready = function(App $app) : void {
        ma::Engine $engine = guard ma::Engine::create() else ($e) {
            die("{$e}");
        }
        MusicPlayer $player = $app->services->create<MusicPlayer, ma::Engine>($engine);
        $player->fadeDuration = 0.5f;

        string $sine = guard findWav('sine.wav') else {
            die('audio: sine.wav not found');
        }
        string $click = guard findWav('click.wav') else {
            die('audio: click.wav not found');
        }
        guard $player->add($sine) else ($e) {
            die($e->message());
        }
        guard $player->add($click) else ($e) {
            die($e->message());
        }
        guard $player->play('sine') else ($e) {
            die($e->message());
        }

        $app->dispatcher->register<PauseSignal>(function(const PauseSignal& $signal) : Flow {
            guard $engine->stop() else {
                return .proceed;
            }
            return .proceed;
        });
        $app->dispatcher->register<ResumeSignal>(function(const ResumeSignal& $signal) : Flow {
            guard $engine->start() else {
                return .proceed;
            }
            return .proceed;
        });

        defer(1000, function() : void {
            MusicPlayer $p = $app->services->get<MusicPlayer>();
            guard $p->switchTo('click') else ($e) {
                die($e->message());
            }
        });
    };
});
$qs->run();

internal function exampleRoot() : string
{
    #[if: os == ios]
    return resourceRoot();
    #[else]
    if (fileExists('resources/sine.wav')) {
        return env::cwd();
    }

    if (fileExists('audio/resources/sine.wav')) {
        return 'audio';
    }

    return 'examples/audio';
    #[end]
}

// pack copies wavs to the .app root; desktop keeps them under resources/
internal function findWav(string $name) : string?
{
    array<string> $dirs = [
        'resources/',
        'examples/audio/resources/',
        'audio/resources/',
        '../examples/audio/resources/',
    ];
    string $bundle = resourceRoot();
    if (!$bundle->empty()) {
        $dirs[] = "{$bundle}/";
        $dirs[] = "{$bundle}/resources/";
    }

    foreach ($dirs as $dir) {
        string $candidate = "{$dir}{$name}";
        if (fileExists($candidate)) {
            return $candidate;
        }
    }

    return null;
}

internal function fileExists(string $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }

    return $here;
}
