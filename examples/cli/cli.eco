/*
 * Framework CLI over a type-keyed Services container.
 *
 *   echoc run -m examples --target cli -- paths
 *   echoc run -m examples --target cli -- log --message hi
 *   echoc run -m examples --target cli -- --help
 */

use command;
use std::env;
use std::io;
use visu::app::{Services, Paths, bootstrap, info};
use visu::asset::Kitchen;

command::Command $app = command::Command('visu', '0.1.0', 'framework tools wired through Services');
command::Subcommand $pathsCmd = $app->command('paths', 'print application roots', 'Shows the Paths fact from the container.');
command::Subcommand $logCmd = $app->command('log', 'write a line through Logger', 'Resolves Logger and writes one info line.');
command::Subcommand $cookCmd = $app->command('cook', 'cook resources/source', 'Writes catalog.vcat into var/cache/asset.');
command::Subcommand $packCmd = $app->command('pack', 'cook and write a vpack', 'Writes resources/pack/main.vpack.');

command::Arg $rootArg = $app->arg('root', '', '<dir>', 'application root');
$app->accept($rootArg, $pathsCmd);
$app->accept($rootArg, $cookCmd);
$app->accept($rootArg, $packCmd);
$app->fallback($rootArg, env::cwd());

command::Arg $msgArg = $app->arg('message', 'm', '<text>', 'line to write');
$app->accept($msgArg, $logCmd);
$app->fallback($msgArg, 'hello from visu');

$r = $app->parse(env::argv());

if ($r->error != null) {
    command::Error $e = $r->error ?? .noCommand;
    command::CLIContext $err = .from($r->parsed, $app, .stderr);
    $err->print(command::renderError($e, $app, $r->parsed, $err));
    env::exit(1);
}

$parsed = $r->parsed;

if ($parsed->wantsVersion) {
    io::println(command::renderVersion($app));
    env::exit(0);
}

if ($parsed->wantsHelp || !$parsed->hasCommand) {
    command::CLIContext $help = .from($parsed, $app, .stdout);
    $help->print(command::renderHelp($app, $parsed, $help));
    env::exit(0);
}

string $root = env::cwd();
if ($parsed->command->id == $pathsCmd->id || $parsed->command->id == $cookCmd->id || $parsed->command->id == $packCmd->id) {
    $root = $parsed->value($rootArg);
}

Services $s = bootstrap(Paths(root: $root), function(Services $s) : void {
    define($s);
});

if ($parsed->command->id == $pathsCmd->id) {
    Paths $paths = $s->get<Paths>();
    AppInfo $info = $s->get<AppInfo>();
    echo "app: {$info->name}";
    echo "root: {$paths->root}";
    echo "cache: {$paths->cache}";
    echo "store: {$paths->store}";
    echo "resources: {$paths->resources}";
    echo "shaders: {$paths->resourcesShader}";
    echo "source: {$paths->resourcesSource}";
    echo "pack: {$paths->resourcesPack}";
    env::exit(0);
}

if ($parsed->command->id == $cookCmd->id || $parsed->command->id == $packCmd->id) {
    Paths $paths = $s->get<Paths>();
    bool $srcOk = guard io::exists($paths->resourcesSource) else ($e) {
        echo $e->message();
        env::exit(1);
    }
    if (!$srcOk) {
        echo "no source tree at {$paths->resourcesSource}";
        env::exit(0);
    }

    Kitchen $k = Kitchen::defaults();
    if ($parsed->command->id == $packCmd->id) {
        cliEnsureDir($paths->resourcesPack);
        string $packFile = $paths->resourcesPack;
        $packFile->append('/main.vpack');
        guard $k->pack($paths->resourcesSource, $packFile) else ($e) {
            echo $e->message();
            env::exit(1);
        }

        echo $packFile;
        env::exit(0);
    }

    cliEnsureDir($paths->cache);
    string $out = $paths->cache;
    $out->append('/asset');
    cliEnsureDir($out);
    array<visu::asset::PackItem> $items = guard $k->cook($paths->resourcesSource, $out) else ($e) {
        echo $e->message();
        env::exit(1);
    }

    echo "{$items->count()} items -> {$out}";
    env::exit(0);
}

function cliEnsureDir(const string& $path) : void
{
    string $p = $path->clone();
    guard io::mkdir($p) else ($e) {
        if ($e->exists()) {
            return;
        }

        echo $e->message();
        env::exit(1);
    }
}

info($parsed->value($msgArg));
