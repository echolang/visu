/*
 * App service definitions. This file is the .ctn replacement: typed Echo that the compiler checks.
 */

use visu::app::Services;

public class AppInfo
{
    public const string $name;

    public constructor(string $name)
    {
        $this->name = $name;
    }
}

public function define(Services $s) : void
{
    $s->create<AppInfo>('visu-cli');
}
