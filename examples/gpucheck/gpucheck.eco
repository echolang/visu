/*
 * In-process pixel checks. echoc test's fork dies at pipeline create on this MoltenVK (XPC shader compile); run this instead:
 *
 *   echoc build -m examples --target gpucheck
 *   ./examples/ecobuild/gpucheck
 *   echoc run -m examples --target gpucheck
 */

use visu::app::ensureLogger;

ensureLogger();
GpuContext $gpu = gpuHidden('gpucheck');
checkQuadDraw($gpu);
checkUniformSlots($gpu);
checkInstanceOffsets($gpu);
checkCubeDraw($gpu);
checkBlit($gpu);
checkBlitY($gpu);
checkTextureSampling($gpu);
checkMultiTexture($gpu);
checkCameraDepth($gpu);
checkDrawCalls($gpu);
checkCubemap($gpu);
checkMipmaps($gpu);
checkRenderToFace($gpu);
checkCaptureOrientation($gpu);
checkPbrFrame($gpu);
checkForgetReload($gpu);
checkLaterPassWins($gpu);
checkRenderTargetResize($gpu);
checkFlyUiButton($gpu);
checkFlyUiSelect($gpu);
checkOverlay($gpu);
checkDump($gpu);
$gpu->end();
echo 'gpucheck ok';
