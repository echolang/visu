/*
 * FlyUI gallery: sidebar of demos (layout stacks, buttons, groups, checkboxes, selects).
 * Quickstart owns the window / loop / graph.
 *
 *   echoc run -m examples --target flyui
 *   echoc run -m examples --target flyui --define VISU_FINITE
 *   echoc run -m examples --target flyui -- --flag flyui.skins=true
 */

use visu::graphics::{Pixels, Texture};
use visu::math::Vec4;
use visu::quickstart::{App, Options, Quickstart};
use visu::ui::{Align, ButtonSkin, Choice, Edges, Flow, Layout, NineSlice, Sizing, Ui};
use visu::vg::Color;

internal class FlyUiDemo
{
    public string $current;
    public string $stackFlow;
    public string $vSizing;
    public string $hSizing;
    public string $hAlign;
    public string $vAlign;
    public string $groupSize;
    public string $selectSize;
    public string $selectFruit;
    public bool $notifications;
    public bool $darkMode;
    public bool $autoSave;
    public bool $showGrid;
    public bool $sounds;
    public string $settingsTab;
    public float32 $density;
    public float32 $radius;
    public bool $vsync;
    public string $quality;
    public Texture? $skin;
    public bool $skinned;

    public constructor()
    {
        $this->current = 'stacks';
        $this->stackFlow = 'vertical';
        $this->vSizing = 'fill';
        $this->hSizing = 'fill';
        $this->hAlign = 'left';
        $this->vAlign = 'top';
        $this->groupSize = 'medium';
        $this->selectSize = '';
        $this->selectFruit = '';
        $this->notifications = true;
        $this->darkMode = false;
        $this->autoSave = true;
        $this->showGrid = false;
        $this->sounds = true;
        $this->settingsTab = 'graphics';
        $this->density = 1.0f;
        $this->radius = 70.0f;
        $this->vsync = true;
        $this->quality = 'medium';
        $this->skin = null;
        $this->skinned = false;
    }
}

FlyUiDemo $demo = FlyUiDemo();

Quickstart $qs = Quickstart(function(Options $opt) : void {
    $opt->windowTitle = 'visu flyui';
    $opt->windowWidth = 1280;
    $opt->windowHeight = 720;
    $opt->clearColor = Vec4(1.0f, 1.0f, 1.0f, 1.0f);

    $opt->ready = function(App $app) : void {
        Texture $tex = Texture($app->device, 'flyui-skin', skinPixels());
        $demo->skin = $tex;

        // `--flag flyui.skins=true` opens the skin tab themed, for dcapture
        if (!visu::app::flags()->bool('flyui.skins', false)) {
            return;
        }

        Ui $ui = guard $app->host->ui else {
            return;
        }
        $demo->current = 'skins';
        $demo->skinned = true;
        skinTheme($ui, $tex, true);
    };

    $opt->ui = function(App $app, Ui $ui) : void {
        paint($demo, $ui);
    };

    $opt->teardown = function(App $app) : void {
        Texture $tex = guard $demo->skin else {
            return;
        }
        $tex->destroy();
    };
});
$qs->run();

internal function paint(FlyUiDemo $demo, Ui $ui) : void
{
    Layout $root = Layout();
    $root->flow = .horizontal;
    $root->h = .fill;
    $root->v = .fill;
    $root->pad = Edges::all(25.0f);
    $root->spacing = 20.0f;
    $root->bg = Color::white();
    $ui->begin($root);

    Layout $side = Layout();
    $side->flow = .vertical;
    $side->v = .fill;
    $side->width = 250.0f;
    $side->pad = Edges::all(10.0f);
    $side->spacing = 10.0f;
    $side->bg = Color(0.9f, 0.9f, 0.9f);
    $side->radius = 5.0f;
    $ui->begin($side);

    if ($ui->button('Layout - Stacks', fill: true)) {
        $demo->current = 'stacks';
    }

    if ($ui->button('Components - Buttons', fill: true)) {
        $demo->current = 'buttons';
    }

    if ($ui->button('Components - Button Groups', fill: true)) {
        $demo->current = 'groups';
    }

    if ($ui->button('Components - Checkboxes', fill: true)) {
        $demo->current = 'checks';
    }

    if ($ui->button('Components - Select Dropdowns', fill: true)) {
        $demo->current = 'selects';
    }

    if ($ui->button('Components - Sliders', fill: true)) {
        $demo->current = 'sliders';
    }

    if ($ui->button('Components - Tabs', fill: true)) {
        $demo->current = 'tabs';
    }

    if ($ui->button('Components - Skins', fill: true)) {
        $demo->current = 'skins';
    }

    if ($ui->button('Settings', fill: true)) {
        $demo->current = 'settings';
    }

    $ui->end();

    Layout $content = Layout();
    $content->flow = .vertical;
    $content->h = .fill;
    $content->v = .fill;
    $content->pad = Edges::all(10.0f);
    $content->bg = Color(0.95f, 0.95f, 0.95f);
    $content->radius = 5.0f;
    $ui->begin($content);

    if ($demo->current == 'stacks') {
        demoStacks($demo, $ui);
    } else if ($demo->current == 'buttons') {
        demoButtons($ui);
    } else if ($demo->current == 'groups') {
        demoGroups($demo, $ui);
    } else if ($demo->current == 'checks') {
        demoChecks($demo, $ui);
    } else if ($demo->current == 'sliders') {
        demoSliders($demo, $ui);
    } else if ($demo->current == 'tabs') {
        demoTabs($demo, $ui);
    } else if ($demo->current == 'skins') {
        demoSkins($demo, $ui);
    } else if ($demo->current == 'settings') {
        demoSettings($demo, $ui);
    } else {
        demoSelects($demo, $ui);
    }

    $ui->end();
    $ui->end();
}

internal function demoStacks(FlyUiDemo $demo, Ui $ui) : void
{
    Layout $split = Layout();
    $split->flow = .horizontal;
    $split->h = .fill;
    $split->v = .fill;
    $split->spacing = 10.0f;
    $ui->begin($split);

    Layout $stack = Layout();
    $stack->flow = stackFlow($demo->stackFlow);
    $stack->h = .fill;
    $stack->v = .fill;
    $stack->align = stackAlign($demo);
    $stack->spacing = 5.0f;
    $ui->begin($stack);

    int32 $i = 0;

    while ($i < 10) {
        Layout $box = Layout();
        $box->h = stackSizing($demo->hSizing);
        $box->v = stackSizing($demo->vSizing);
        $box->pad = Edges::all(10.0f);
        $box->bg = Color::white()->darken(($i as float32) / 10.0f);
        $box->radius = 3.0f;
        $ui->begin($box);
        Color $tc = Color::black();

        if ($i >= 5) {
            $tc = Color::white();
        }

        int32 $n = $i + 1;
        $ui->text("#{$n}", size: 12.0f, color: $tc);
        $ui->end();
        $i = $i + 1;
    }

    $ui->end();

    Layout $settings = Layout();
    $settings->h = .fit;
    $settings->v = .fit;
    $settings->spacing = 5.0f;
    $ui->begin($settings);

    array<Choice> $flows = array<Choice>();
    $flows[] = Choice('vertical', 'Vertical');
    $flows[] = Choice('horizontal', 'Horizontal');
    $ui->buttonGroup('Stack Flow', $flows, &$demo->stackFlow);
    $ui->space(0.0f, 10.0f);

    $ui->beginSection('Stack Sizing');
    array<Choice> $sizes = array<Choice>();
    $sizes[] = Choice('fill', 'Fill');
    $sizes[] = Choice('fit', 'Fit');
    $ui->buttonGroup('Vertical', $sizes, &$demo->vSizing);
    $ui->buttonGroup('Horizontal', $sizes, &$demo->hSizing);
    $ui->end();
    $ui->space(0.0f, 10.0f);

    $ui->beginSection('Stack Alignment');
    array<Choice> $hAligns = array<Choice>();
    $hAligns[] = Choice('left', 'Left');
    $hAligns[] = Choice('center', 'Center');
    $hAligns[] = Choice('right', 'Right');
    $ui->buttonGroup('Horizontal', $hAligns, &$demo->hAlign, id: 'h-align-btn-group');
    array<Choice> $vAligns = array<Choice>();
    $vAligns[] = Choice('top', 'Top');
    $vAligns[] = Choice('center', 'Center');
    $vAligns[] = Choice('bottom', 'Bottom');
    $ui->buttonGroup('Vertical', $vAligns, &$demo->vAlign, id: 'v-align-btn-group');
    $ui->end();

    $ui->end();
    $ui->end();
}

internal function demoButtons(Ui $ui) : void
{
    $ui->beginSection('Button Styles');
    $ui->beginRow();
    $ui->button('Primary Button');
    $ui->button('Secondary Button', style: .secondary);
    $ui->end();
    $ui->end();

    $ui->beginSection('Fill');
    $ui->button('Full width', fill: true);
    $ui->end();
}

/**
 * Buttons read the theme when they emit, so the skin is a whole-theme switch, not a per-call one.
 */
internal function demoSkins(FlyUiDemo $demo, Ui $ui) : void
{
    Texture $tex = guard $demo->skin else {
        $ui->text('Skin texture missing');
        return;
    }

    $ui->beginSection('Theme');

    if ($ui->checkbox('9-slice buttons and cards', &$demo->skinned)) {
        skinTheme($ui, $tex, $demo->skinned);
    }

    $ui->end();
    $ui->beginSection('Buttons');
    $ui->beginRow();
    $ui->button('Primary');
    $ui->button('Secondary', style: .secondary);
    $ui->end();
    $ui->button('Full width', fill: true);
    $ui->end();
    $ui->beginSection('Skinned layout');
    Layout $box = Layout();
    $box->pad = Edges::all(16.0f);
    $box->skin = skinCell($tex, 3);
    $ui->begin($box);
    $ui->text('Any begin() box takes Layout.skin.');
    $ui->end();
    $ui->end();
}

internal const int32 SKIN_CELL = 16;

/**
 * Cell `$i` of the demo atlas: 0 normal, 1 hover, 2 down, 3 card. Cells sit 1 px apart.
 */
internal function skinCell(Texture $tex, int32 $i) : NineSlice
{
    float32 $y = ($i * (SKIN_CELL + 1)) as float32;
    float32 $c = SKIN_CELL as float32;
    return NineSlice($tex, Edges::all(4.0f), $rect: Vec4(0.0f, $y, $c, $c), $scale: 2.0f, $nearest: true);
}

internal function skinTheme(Ui $ui, Texture $tex, bool $on) : void
{
    if (!$on) {
        $ui->theme->primaryButton->skin = ButtonSkin();
        $ui->theme->secondaryButton->skin = ButtonSkin();
        $ui->theme->card->skin = null;
        return;
    }

    ButtonSkin $skin = ButtonSkin();
    $skin->normal = skinCell($tex, 0);
    $skin->hover = skinCell($tex, 1);
    $skin->down = skinCell($tex, 2);
    $ui->theme->primaryButton->skin = $skin;
    $ui->theme->primaryButton->text = Color(0.16f, 0.1f, 0.06f, 1.0f);
    $ui->theme->primaryButton->hoverText = $ui->theme->primaryButton->text;
    ButtonSkin $dark = $skin;
    NineSlice $n = skinCell($tex, 0);
    $n->tint = Color(0.55f, 0.6f, 0.7f, 1.0f);
    $dark->normal = $n;
    $ui->theme->secondaryButton->skin = $dark;
    $ui->theme->card->skin = skinCell($tex, 3);
}

/**
 * Four 16 px bevelled cells stacked with a 1 px gap: normal, hover, down, card.
 */
internal function skinPixels() : Pixels
{
    int32 $w = SKIN_CELL;
    int32 $h = SKIN_CELL * 4 + 3;
    array<uint8> $px = array<uint8>();
    $px->reserve(($w * $h * 4) as usize);
    int32 $y = 0;

    while ($y < $h) {
        int32 $x = 0;

        while ($x < $w) {
            Color $c = skinTexel($x, $y);
            $px[] = ($c->r * 255.0f) as uint8;
            $px[] = ($c->g * 255.0f) as uint8;
            $px[] = ($c->b * 255.0f) as uint8;
            $px[] = ($c->a * 255.0f) as uint8;
            $x = $x + 1;
        }

        $y = $y + 1;
    }

    return Pixels($w, $h, $px);
}

internal function skinTexel(int32 $x, int32 $y) : Color
{
    int32 $cell = $y / (SKIN_CELL + 1);
    int32 $cy = $y - $cell * (SKIN_CELL + 1);
    int32 $last = SKIN_CELL - 1;

    if ($cy >= SKIN_CELL) {
        return Color::transparent();
    }

    bool $cornerX = $x == 0 || $x == $last;
    bool $cornerY = $cy == 0 || $cy == $last;

    if ($cornerX && $cornerY) {
        return Color::transparent();
    }

    if ($x == 0 || $cy == 0 || $x == $last || $cy == $last) {
        return Color(0.16f, 0.1f, 0.06f, 1.0f);
    }

    Color $fill = Color(0.95f, 0.91f, 0.82f, 1.0f);

    if ($cell == 0) {
        $fill = Color(0.75f, 0.59f, 0.35f, 1.0f);
    } else if ($cell == 1) {
        $fill = Color(0.84f, 0.69f, 0.43f, 1.0f);
    } else if ($cell == 2) {
        $fill = Color(0.59f, 0.45f, 0.27f, 1.0f);
    }
    bool $lit = $x == 1 || $cy == 1;
    bool $shade = $x == $last - 1 || $cy == $last - 1;

    if ($cell == 2) {
        bool $swap = $lit;
        $lit = $shade;
        $shade = $swap;
    }

    if ($lit) {
        return $fill->lighten(0.25f);
    }

    if ($shade) {
        return $fill->darken(0.25f);
    }

    return $fill;
}

internal function demoGroups(FlyUiDemo $demo, Ui $ui) : void
{
    array<Choice> $sizes = array<Choice>();
    $sizes[] = Choice('small', 'Small');
    $sizes[] = Choice('medium', 'Medium');
    $sizes[] = Choice('large', 'Large');
    $ui->buttonGroup('Size', $sizes, &$demo->groupSize);
    $ui->space(0.0f, 20.0f);
    $ui->beginSection('Current Selections');
    $ui->text("Size: {$demo->groupSize}");
    $ui->end();
}

internal function demoChecks(FlyUiDemo $demo, Ui $ui) : void
{
    $ui->beginSection('Basic Checkboxes');
    $ui->beginColumn(5.0f);
    $ui->checkbox('Enable Notifications', &$demo->notifications);
    $ui->checkbox('Dark Mode', &$demo->darkMode);
    $ui->checkbox('Auto Save', &$demo->autoSave);
    $ui->end();
    $ui->end();
    $ui->space(0.0f, 20.0f);

    $ui->beginSection('Settings Panel');
    $ui->beginColumn(5.0f);
    $ui->text('Display Options:', size: 14.0f, color: Color(0.3f, 0.3f, 0.3f));
    $ui->space(0.0f, 5.0f);
    $ui->checkbox('Show Grid', &$demo->showGrid);
    $ui->space(0.0f, 10.0f);
    $ui->text('Audio Options:', size: 14.0f, color: Color(0.3f, 0.3f, 0.3f));
    $ui->space(0.0f, 5.0f);
    $ui->checkbox('Enable Sounds', &$demo->sounds);
    $ui->end();
    $ui->end();
    $ui->space(0.0f, 20.0f);

    $ui->beginSection('Current State');
    $ui->beginColumn(3.0f);
    string $n0 = onOff($demo->notifications);
    $ui->text("Notifications: {$n0}");
    string $n1 = onOff($demo->darkMode);
    $ui->text("Dark Mode: {$n1}");
    string $n2 = onOff($demo->autoSave);
    $ui->text("Auto Save: {$n2}");
    string $n3 = onOff($demo->showGrid);
    $ui->text("Show Grid: {$n3}");
    string $n4 = onOff($demo->sounds);
    $ui->text("Enable Sounds: {$n4}");
    $ui->end();
    $ui->end();
}

internal function demoSelects(FlyUiDemo $demo, Ui $ui) : void
{
    $ui->beginSection('Basic Select Dropdowns');
    $ui->beginColumn(10.0f);
    array<Choice> $sizes = array<Choice>();
    $sizes[] = Choice('small', 'Small');
    $sizes[] = Choice('medium', 'Medium');
    $sizes[] = Choice('large', 'Large');
    $sizes[] = Choice('xl', 'Extra Large');
    $ui->select('Size', $sizes, &$demo->selectSize);
    string $picked = $demo->selectSize;

    if ($picked->empty()) {
        $picked = 'Not selected';
    }

    $ui->text("Size: {$picked}");
    $ui->space(0.0f, 16.0f);
    array<Choice> $fruits = array<Choice>();
    $fruits[] = Choice('apple', 'Apple');
    $fruits[] = Choice('banana', 'Banana');
    $fruits[] = Choice('cherry', 'Cherry');
    $fruits[] = Choice('grape', 'Grape');
    $fruits[] = Choice('mango', 'Mango');
    $fruits[] = Choice('orange', 'Orange');
    $fruits[] = Choice('peach', 'Peach');
    $fruits[] = Choice('pear', 'Pear');
    $fruits[] = Choice('plum', 'Plum');
    $fruits[] = Choice('strawberry', 'Strawberry');
    $ui->select('Fruit', $fruits, &$demo->selectFruit);
    string $fruit = $demo->selectFruit;

    if ($fruit->empty()) {
        $fruit = 'Not selected';
    }

    $ui->text("Fruit: {$fruit}");
    $ui->end();
    $ui->end();
}

internal function demoSliders(FlyUiDemo $demo, Ui $ui) : void
{
    $ui->beginSection('Sliders');
    $ui->slider('Density', &$demo->density, min: 0.0f, max: 2.0f, step: 0.05f);
    $ui->slider('Radius', &$demo->radius, min: 8.0f, max: 90.0f, step: 1.0f);
    $ui->text("density {$demo->density:.2f}, radius {$demo->radius:.0f}");
    $ui->end();
}

internal function demoTabs(FlyUiDemo $demo, Ui $ui) : void
{
    array<Choice> $pages = array<Choice>();
    $pages[] = Choice('basics', 'Basics');
    $pages[] = Choice('display', 'Display');
    $pages[] = Choice('graphics', 'Graphics');
    $ui->beginSection('Same choices');
    $ui->tabBar('Pages', $pages, &$demo->settingsTab, id: 'tabs');
    $ui->space(0.0f, 12.0f);
    $ui->buttonGroup('Pages', $pages, &$demo->settingsTab, id: 'group');
    $ui->text("tab: {$demo->settingsTab}");
    $ui->end();
}

internal function demoSettings(FlyUiDemo $demo, Ui $ui) : void
{
    array<Choice> $pages = array<Choice>();
    $pages[] = Choice('basics', 'Basics');
    $pages[] = Choice('display', 'Display');
    $pages[] = Choice('graphics', 'Graphics');
    $ui->tabBar('Settings', $pages, &$demo->settingsTab);
    $ui->space(0.0f, 16.0f);
    $ui->beginCard();
    $ui->beginSettingRow('V-Sync');
    $ui->checkbox('', &$demo->vsync, id: 'vsync');
    $ui->endSettingRow();
    $ui->beginSettingRow('Quality');
    array<Choice> $levels = array<Choice>();
    $levels[] = Choice('low', 'Low');
    $levels[] = Choice('medium', 'Medium');
    $levels[] = Choice('high', 'High');
    $ui->select('', $levels, &$demo->quality, id: 'quality');
    $ui->endSettingRow();
    $ui->beginSettingRow('Density');
    $ui->slider('', &$demo->density, min: 0.0f, max: 2.0f, step: 0.05f, id: 'density');
    $ui->endSettingRow();
    $ui->end();
}

internal function stackFlow(string $id) : Flow
{
    if ($id == 'horizontal') {
        return Flow::horizontal;
    }

    return Flow::vertical;
}

internal function stackSizing(string $id) : Sizing
{
    if ($id == 'fill') {
        return Sizing::fill;
    }

    return Sizing::fit;
}

internal function stackAlign(FlyUiDemo $demo) : Align
{
    if ($demo->hAlign == 'center') {
        if ($demo->vAlign == 'center') {
            return Align::center;
        }

        if ($demo->vAlign == 'bottom') {
            return Align::bottomCenter;
        }

        return Align::topCenter;
    }

    if ($demo->hAlign == 'right') {
        if ($demo->vAlign == 'center') {
            return Align::centerRight;
        }

        if ($demo->vAlign == 'bottom') {
            return Align::bottomRight;
        }

        return Align::topRight;
    }

    if ($demo->vAlign == 'center') {
        return Align::centerLeft;
    }

    if ($demo->vAlign == 'bottom') {
        return Align::bottomLeft;
    }

    return Align::topLeft;
}

internal function onOff(bool $on) : string
{
    if ($on) {
        return 'ON';
    }

    return 'OFF';
}
