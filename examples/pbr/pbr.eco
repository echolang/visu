/*
 * Deferred PBR: a 10x5 grid of spheres, roughness left to right and metallic bottom to top.
 * Lit by a directional sun and (when an HDRI is present) the environment around them.
 *
 *   echoc run -m examples --target pbr
 *   echoc run -m examples --target pbr --define VISU_FINITE
 *
 * Hold left to orbit, scroll to zoom. On iOS, drag and pinch.
 */

use std::io;
use visu::app::info;
use visu::os::{resourceRoot, writableRoot};
use visu::ecs::{Entities, Entity, Schedule, System};
use visu::geo::{AABB, Transform, PrimitiveBuilder, PrimitiveLayout, sphere};
use visu::graphics::{
    Camera, RenderContext, DeferredRenderer, DrawCallAssembler, GBufferData, IblQuality, Mesh, MeshHandle,
    HdrPixels, SceneTargetData, Texture, TextureOptions, TextureRef, VertexBuilder,
    VertexLayout, instanceLayout
};
use visu::math::{Vec3, Vec4};
use visu::quickstart::{App, Options, Quickstart};
use visu::components::{ActiveCamera, OrbitCamera};
use visu::runtime::DebugConsole;
use visu::system::{CameraSystem, DeferredViewSystem, OrbitCameraSystem};

/**
 * Any equirectangular radiance map. Missing means sun-only lighting.
 */
const HDRI_PATH = 'resources/hdri/cowboy_town_saloon_2k.hdr';
const int32 ENVIRONMENT_SIZE = 1024;
const int32 ROUGHNESS_STEPS = 10;
const int32 METALLIC_STEPS = 5;
const float32 SPHERE_SPACING = 1.2f;

/**
 * Per-entity material. The sphere mesh itself is shared.
 */
public struct PbrMaterial
{
    public Vec3 $albedo;
    public float32 $roughness;
    public float32 $metallic;
    public Vec3 $emissive;
}

/**
 * The two payload vec4s that ride the instance stream.
 */
public struct SphereInstance
{
    public Vec4 $albedoMetallic;
    public Vec4 $emissiveRoughness;
}

/**
 * Submits every sphere into the assembler,
 * then hands the deferred renderer a closure that records the merged draw calls.
 */
public class SphereSystem : System
{
    public DrawCallAssembler<SphereInstance> $dca;
    public DeferredRenderer $renderer;
    public MeshHandle $sphere;
    public VertexLayout $layout;

    public constructor(DrawCallAssembler<SphereInstance> $dca, DeferredRenderer $renderer)
    {
        $this->dca = $dca;
        $this->renderer = $renderer;
        $this->sphere = MeshHandle::none();
        $this->layout = VertexLayout::pos3n3()->join(
            instanceLayout<SphereInstance>(2, function(VertexBuilder $b, ptr<const SphereInstance> $p) : void {
                $b->attr(6, &$p->albedoMetallic);
                $b->attr(7, &$p->emissiveRoughness);
            })
        );
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function schedule(Schedule& $schedule) : void
    {
    }

    public function update(Entities $entities) : void
    {
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
        DrawCallAssembler<SphereInstance> $dca = $this->dca;
        MeshHandle $sphere = $this->sphere;
        $dca->clearInstances();
        $entities->each<Transform, PbrMaterial>(function(Entity $id, Transform& $t, PbrMaterial& $m) : void {
            $dca->submit($sphere, $t->local(), SphereInstance(
                Vec4($m->albedo->x, $m->albedo->y, $m->albedo->z, $m->metallic),
                Vec4($m->emissive->x, $m->emissive->y, $m->emissive->z, $m->roughness)
            ));
        });

        SceneTargetData $scene = $ctx->frame->get<SceneTargetData>();
        VertexLayout $layout = $this->layout;
        DeferredRenderer $renderer = $this->renderer;
        $renderer->render($ctx, $scene->target, function(RenderContext $inner, GBufferData $gbuffer) : void {
            $renderer->draw($inner, $gbuffer, $dca, $layout);
        });
    }
}

/**
 * Everything `ready` builds.
 * Closures capture by value, so the scene lives on Services and every callback reads it back through `$app`.
 */
public class PbrScene
{
    public DeferredRenderer $renderer;
    public Mesh $mesh;
    public DrawCallAssembler<SphereInstance> $dca;

    public constructor(
        DeferredRenderer $renderer,
        Mesh $mesh,
        DrawCallAssembler<SphereInstance> $dca
    )
    {
        $this->renderer = $renderer;
        $this->mesh = $mesh;
        $this->dca = $dca;
    }
}

Quickstart $qs = Quickstart(function(Options $opt) : void
{
    $opt->windowTitle = 'visu pbr';
    $opt->windowWidth = 1280;
    $opt->windowHeight = 720;
    $opt->debugConsole = true;

    $opt->ready = function(App $app) : void {
        DeferredRenderer $renderer = DeferredRenderer($app->device);
        #[if: os == ios]
        $renderer->ibl = IblQuality::mobile();
        #[end]
        guard $renderer->load() else ($e) {
            die($e->message());
        }

        PrimitiveBuilder $builder = PrimitiveBuilder(PrimitiveLayout::pos3n3());
        sphere($builder, 0.5f, 32, 16);
        Mesh $mesh = Mesh($app->device, $builder->data, stride: $builder->layout->bytes());

        loadEnvironment($app, $renderer);
        DrawCallAssembler<SphereInstance> $dca = DrawCallAssembler<SphereInstance>($app->device);
        SphereSystem $spheres = SphereSystem($dca, $renderer);
        $spheres->sphere = $dca->register($mesh, AABB(Vec3(-0.5f, -0.5f, -0.5f), Vec3(0.5f, 0.5f, 0.5f)));

        // the camera has to publish CameraData before anything reads it
        $app->systems->bind(CameraSystem());
        $app->systems->bind(OrbitCameraSystem($app->input));
        $app->systems->bind($spheres);
        $app->systems->bind(DeferredViewSystem($renderer));
        if ($app->host->console != null) {
            DebugConsole $console = guard $app->host->console;
            $app->systems->listen($console);
        }

        $app->services->set(PbrScene($renderer, $mesh, $dca));
    };

    $opt->initializeScene = function(App $app) : void {
        float32 $gridWidth = (ROUGHNESS_STEPS as float32) * SPHERE_SPACING;
        float32 $gridHeight = (METALLIC_STEPS as float32) * SPHERE_SPACING;
        float32 $distance = $gridWidth;

        if ($gridHeight > $distance) {
            $distance = $gridHeight;
        }

        Vec3 $center = Vec3(
            $gridWidth * 0.5f - SPHERE_SPACING * 0.5f,
            $gridHeight * 0.5f - SPHERE_SPACING * 0.5f,
            0.0f
        );
        Entity $cam = Camera::spawn($app->entities, Vec3(0.0f, 0.0f, 0.0f));
        OrbitCamera $orbit = OrbitCamera($center, $distance * 1.2f);
        $orbit->place($app->entities->get<Transform>($cam));
        $app->entities->attach($cam, $orbit);
        ActiveCamera::activate($app->entities, $cam);

        int32 $metallicLast = METALLIC_STEPS - 1;
        float32 $metallicSteps = $metallicLast as float32;

        for ($my = 0; $my < METALLIC_STEPS; $my++) {
            for ($rx = 0; $rx < ROUGHNESS_STEPS; $rx++) {
                Entity $entity = $app->entities->create();
                Transform $transform = Transform();
                $transform->position = Vec3(
                    ($rx as float32) * SPHERE_SPACING,
                    ($my as float32) * SPHERE_SPACING,
                    0.0f
                );
                $app->entities->attach($entity, $transform);
                float32 $metallic = ($my as float32);
                $metallic = $metallic / $metallicSteps;
                $app->entities->attach($entity, PbrMaterial(
                    Vec3(1.0f, 1.0f, 1.0f),
                    gridRoughness($rx),
                    $metallic,
                    Vec3(0.0f, 0.0f, 0.0f)
                ));
            }
        }

        int32 $count = ROUGHNESS_STEPS * METALLIC_STEPS;
        info("pbr: {$count} spheres, roughness across x, metallic up y");
    };

    #[if: VISU_PBR_DUMP]
    $opt->afterFrame = function(App $app) : void {
        if (PbrDump::$done) {
            return;
        }

        PbrScene $scene = $app->services->get<PbrScene>();
        if ($scene->renderer->hasEnvironment() && !$scene->renderer->iblReady()) {
            return;
        }

        if ($app->device->frameIndex() < 4) {
            return;
        }

        dumpFrame($app);
        PbrDump::$done = true;
    };
    #[end]

    $opt->teardown = function(App $app) : void {
        PbrScene $scene = $app->services->get<PbrScene>();
        $scene->renderer->destroy();
        $scene->mesh->destroy();
    };
});
$qs->run();

/**
 * Maps a grid step to roughness, never fully smooth.
 * A zero-roughness highlight is a single pixel.
 */
internal function gridRoughness(int32 $step) : float32
{
    int32 $last = ROUGHNESS_STEPS - 1;
    float32 $steps = $last as float32;
    float32 $r = ($step as float32);
    $r = $r / $steps;

    if ($r < 0.04f) {
        return 0.04f;
    }

    return $r;
}

/**
 * Finds the HDRI whether the example runs from the repo root or from its own directory,
 * and hands it to the renderer to bake.
 */
internal function loadEnvironment(App $app, DeferredRenderer $renderer) : void
{
    string $path = guard findHdri() else {
        info('pbr: no HDRI found, lighting with the sun alone');
        return;
    }
    HdrPixels $pixels = guard HdrPixels::load($path) else ($e) {
        info("pbr: {$path} could not be decoded");
        return;
    }
    Texture $equirect = Texture($app->device, 'pbr.hdri', $pixels);
    $renderer->setEnvironment(hdri: $equirect, ENVIRONMENT_SIZE);
    info("pbr: environment from {$path}");
}

internal function findHdri() : string?
{
    array<string> $roots = ['', 'examples/pbr/', 'pbr/', '../examples/pbr/'];
    string $bundle = resourceRoot();
    if (!$bundle->empty()) {
        $roots[] = "{$bundle}/";
    }

    array<string> $files = [HDRI_PATH, 'hdri/cowboy_town_saloon_2k.hdr'];

    foreach ($files as $relative) {
        foreach ($roots as $root) {
            string $candidate = "{$root}{$relative}";

            if (pathExists($candidate)) {
                return $candidate;
            }
        }
    }

    return null;
}

internal function pathExists(const string& $path) : bool
{
    bool $here = guard io::exists($path) else {
        return false;
    }
    return $here;
}

/**
 * --define VISU_PBR_DUMP writes the last frame to var/ so the scene can be eyeballed (and diffed) without a window.
 */
#[if: VISU_PBR_DUMP]
internal class PbrDump
{
    public static bool $done = false;
}

internal function dumpDir() : string
{
    return writableRoot();
}

internal function dumpFrame(App $app) : void
{
    string $dir = dumpDir();
    dumpPoolTexture($app, 'quickstartTarget.attachment.color_quickstartColor', "{$dir}/pbr.png");
    dumpPoolTexture($app, 'gbuffer.attachment.color_albedo', "{$dir}/pbr_albedo.png");
    dumpPoolTexture($app, 'gbuffer.attachment.color_normal', "{$dir}/pbr_normal.png");
    dumpPoolTexture($app, 'lightpass.attachment.color_output', "{$dir}/pbr_light.png");
    dumpPoolTexture($app, 'ssao.attachment.color_output', "{$dir}/pbr_ssao_raw.png");
    dumpPoolTexture($app, 'ssaoBlur.attachment.color_output', "{$dir}/pbr_ssao.png");
    // cube dumps write face 0, +X
    dumpPoolTexture($app, 'environment', "{$dir}/pbr_env.png");
    dumpPoolTexture($app, 'ibl.irradiance.0', "{$dir}/pbr_irradiance.png");
    dumpPoolTexture($app, 'ibl.prefilter.0', "{$dir}/pbr_prefilter.png");
    dumpPoolTexture($app, 'ibl.brdf', "{$dir}/pbr_brdf.png");
}

internal function dumpPoolTexture(App $app, string $name, string $path) : void
{
    TextureRef $ref = TextureRef($name, 0, 0, TextureOptions());
    Texture $texture = guard $app->pool->getTexture($ref) else ($e) {
        info("pbr: no texture {$name}");
        return;
    }
    guard $texture->dump($path) else ($e) {
        info("pbr: {$path} failed");
        return;
    }
    info("pbr: wrote {$path}");
}
#[end]
