use std::time;
use visu::components::Collider;
use visu::ecs::{Entities, Entity, Systems};
use visu::geo::{Heightmap, Ray, Transform};
use visu::math::Vec3;
use visu::physics::{ColliderShape, PhysicsHit, PhysicsLayer, PhysicsSettings, PhysicsWorld};
use visu::system::PhysicsSystem;

Heightmap $map = Heightmap::flat(4097, 4097, 300.0f, 2.0f);
Entities $entities = Entities();
Systems $systems = Systems();
PhysicsWorld $world = PhysicsWorld(PhysicsSettings());
$systems->bind(PhysicsSystem($world));
Entity $ground = $entities->create();
$entities->attach<Transform>($ground, Transform());
$entities->attach<Collider>($ground, Collider(ColliderShape::heightfield($map), layer: PhysicsLayer::terrain()));
time::instant $t0 = time::instant::now();
$systems->register($entities);
float64 $ms = ((time::instant::now() - $t0)->as_micros() as float64) / 1000.0;
echo "heightfield 4097x4097 built in {$ms:.1f} ms";
time::instant $t1 = time::instant::now();
for (int32 $i = 0; $i < 1000; $i++) {
    float32 $x = (($i % 40) as float32) * 90.0f - 1800.0f;
    PhysicsHit? $h = $world->ray(Ray(Vec3($x, 2000.0f, 0.0f), Vec3(0.3f, -1.0f, 0.1f)), 5000.0f);
}
float64 $rays = ((time::instant::now() - $t1)->as_micros() as float64) / 1000.0;
echo "1000 long slanted rays in {$rays:.1f} ms";
