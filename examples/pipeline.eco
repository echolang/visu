/*
 * Open a window and clear it through the render graph.
 *
 *   echoc run -m examples --target pipeline --package-dir vendor -- --frames 120
 */

use command;
use std::env;
use visu::os::{Window, init, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Gpu, Pool, Frame, Pipeline, Context, Backbuffer, ClearPass, ClearPassOptions
};

command::Command $app = command::Command('pipeline', '0.1.0', 'clear a window through the render graph');
command::Arg $framesArg = $app->arg('frames', '', '<n>', 'close after this many swaps');
$app->fallback($framesArg, '300');

$r = $app->parse(env::argv());

if ($r->error != null) {
    command::Error $e = $r->error ?? .noCommand;
    command::CLIContext $err = .from($r->parsed, $app, .stderr);
    $err->print(command::renderError($e, $app, $r->parsed, $err));
    env::exit(1);
}

$parsed = $r->parsed;
$frames = guard str::int($parsed->value($framesArg)) else {
    die('--frames needs an integer');
}

bool $booted = guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu pipeline', 800, 600);
Gpu $state = Gpu();
bool $ready = guard $window->initialize($state) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

Pool $pool = Pool();
int32 $tick = 0;
int32 $n = 0;

while ($n < $frames && !$window->shouldClose()) {
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());
    Context $ctx = Context($pipeline, $frame, $pool);

    Backbuffer $back = $ctx->frame->get<Backbuffer>();
    $ctx->pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.25f, 0.25f, 0.25f, 1.0f))));
    bool $ok = guard $ctx->execute($state, $tick) else ($e) {
        die($e->message());
    }

    $window->swap();
    $window->poll();
    $tick = $tick + 1;
    $n = $n + 1;
}

$pool->destroy($state);
$window->destroy();
terminate();
