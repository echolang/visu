/*
 * Open a window and clear it through the render graph.
 *
 *   echoc run -m examples --target pipeline
 *   echoc run -m examples --target pipeline --define VISU_FINITE
 */

use visu::app::ensureLogger;
use visu::os::{Window, WindowHints, init, requestStop, run, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Device, DeviceError, FrameStatus, Pool, Frame, Pipeline, Backbuffer,
    ClearPass, ClearPassOptions
};

internal class PipelineExample
{
    public Window $window;
    public Device $device;
    public Pool $pool;
    public int32 $tick;
    public int32 $frame;

    public constructor()
    {
        $this->window = Window('visu pipeline', 800, 600, WindowHints());
        $this->device = Device();
        $this->pool = Pool($this->device);
        $this->tick = 0;
        $this->frame = 0;
    }

    public function start() : void
    {
        guard init() else ($e) {
            die($e->message());
        }

        guard $this->window->initialize($this->device) else ($e) {
            terminate();
            die($e->message());
        }

        $this->window->setVsync(true);
    }

    public function tick() : void
    {
        if ($this->window->shouldClose() || visu::finiteDone($this->frame)) {
            requestStop();
            return;
        }

        int32 $w = $this->window->framebufferWidth();
        int32 $h = $this->window->framebufferHeight();
        FrameStatus $status = guard $this->device->beginFrame($w, $h) else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    requestStop();
                    return;
                },
                else => {
                    die($e->message());
                },
            };
        }

        if ($status == FrameStatus::ready) {
            Frame $frame = Frame();
            Pipeline $pipeline = Pipeline($this->pool, $frame, $this->window->renderTarget());
            Backbuffer $back = $frame->get<Backbuffer>();
            $pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.25f, 0.25f, 0.25f, 1.0f))));
            guard $pipeline->execute($this->tick) else ($e) {
                guard $this->window->swap() else ($se) {
                    die($se->message());
                }
                die($e->message());
            }
            guard $this->window->swap() else ($e) {
                match ($e) {
                    DeviceError::surfaceLost => {
                        requestStop();
                        return;
                    },
                    else => {
                        die($e->message());
                    },
                };
            }
        }

        $this->window->poll();
        $this->tick = $this->tick + 1;
        $this->frame = $this->frame + 1;
    }

    public function stop() : void
    {
        $this->device->waitIdle();
        $this->pool->destroy();
        $this->window->destroy();
        $this->device->shutdown();
        terminate();
    }
}

ensureLogger();
PipelineExample $app = PipelineExample();
run(
    function() : void {
        $app->start();
    },
    function() : void {
        $app->tick();
    },
    function() : void {
        $app->stop();
    }
);
