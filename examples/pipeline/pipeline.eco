/*
 * Open a window and clear it through the render graph.
 *
 *   echoc run -m examples --target pipeline
 *   echoc run -m examples --target pipeline --define VISU_FINITE
 */

use visu::os::{Window, init, terminate};
use visu::math::Vec4;
use visu::graphics::{
    Gpu, Pool, Frame, Pipeline, Backbuffer, ClearPass, ClearPassOptions
};

bool $booted = guard init() else ($e) {
    die($e->message());
}

Window $window = Window('visu pipeline', 800, 600);
Gpu $state = Gpu();
bool $ready = guard $window->initialize($state) else ($e) {
    terminate();
    die($e->message());
}

$window->setSwapInterval(1);

Pool $pool = Pool($state);
int32 $tick = 0;
int32 $n = 0;

while (!$window->shouldClose() && !visu::finiteDone($n)) {
    Frame $frame = Frame();
    Pipeline $pipeline = Pipeline($pool, $frame, $window->renderTarget());

    Backbuffer $back = $frame->get<Backbuffer>();
    $pipeline->add(ClearPass($back->target, ClearPassOptions(color: Vec4(0.25f, 0.25f, 0.25f, 1.0f))));
    bool $ok = guard $pipeline->execute($tick) else ($e) {
        die($e->message());
    }

    $window->swap();
    $window->poll();
    $tick = $tick + 1;
    $n = $n + 1;
}

$pool->destroy();
$window->destroy();
terminate();
