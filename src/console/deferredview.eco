/**
 * Console verbs `view` (which deferred buffer the renderer blits) and `ssao`
 * (on/off, quality, strength). Holds the renderer; does not draw. Shadows are `ShadowConsole`.
 */

namespace visu::console;

use visu::graphics::{DeferredRenderer, DeferredView, SsaoLevel, SsaoQuality};
use visu::runtime::{ConsoleCommandHandler, ConsoleCommandRegistry, DebugConsole};
use visu::signal::ConsoleCommandSignal;

internal const VIEW_USAGE = 'usage: view [scene|albedo|normal|roughness|metallic|ao|emissive|position|ssao|id]';
internal const SSAO_USAGE = 'usage: ssao [on|off|toggle|quality <low|medium|high|ultra>|strength <x>]';

public class DeferredViewConsole : ConsoleCommandHandler
{
    public DeferredRenderer $renderer;

    /**
     * Last quality while SSAO is off, so `ssao on` restores radius and sample count.
     */
    private SsaoQuality? $held;

    public constructor(DeferredRenderer $renderer)
    {
        $this->renderer = $renderer;
        $this->held = null;
    }

    public function registerConsoleCommands(ConsoleCommandRegistry $registry) : array<string>
    {
        $registry->add('view', $this, 'scene|albedo|normal|roughness|metallic|ao|emissive|position|ssao|id');
        $registry->add('ssao', $this, 'on|off|toggle|quality <low|medium|high|ultra>|strength <x>');
        array<string> $names = array<string>();
        $names[] = 'view';
        $names[] = 'ssao';
        return $names;
    }

    public function onConsoleCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void
    {
        if ($cmd->isAction('ssao')) {
            $this->onSsaoCommand($cmd, $console);
            return;
        }

        if (!$cmd->isAction('view')) {
            return;
        }

        $this->onViewCommand($cmd, $console);
    }

    private function onViewCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void
    {
        if ($cmd->parts->count() < 2) {
            string $name = $this->renderer->view->label();
            $console->writeLine("view: {$name}");
            return;
        }

        string $part = $cmd->parts[1];
        DeferredView $view = guard DeferredView::parse($part) else {
            $console->writeLine(VIEW_USAGE);
            return;
        }
        $this->renderer->view = $view;
        string $name = $view->label();
        if ($view->needsSsao() && $this->renderer->ssao == null) {
            $console->writeLine("view: {$name} (ssao is off)");
            return;
        }

        $console->writeLine("view: {$name}");
    }

    private function onSsaoCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void
    {
        SsaoConsoleAction $action = parseSsaoConsole($cmd);
        match ($action) {
            SsaoConsoleAction::usage => {
                $console->writeLine(SSAO_USAGE);
            },
            SsaoConsoleAction::status => {
                $console->writeLine($this->ssaoStatus());
            },
            SsaoConsoleAction::enable($on) => {
                $this->setSsao($on, $console);
            },
            SsaoConsoleAction::toggle => {
                $this->toggleSsao($console);
            },
            SsaoConsoleAction::strength($value) => {
                $this->setStrength($value, $console);
            },
            SsaoConsoleAction::quality($level) => {
                $this->setQuality($level, $console);
            },
        };
    }

    private function setSsao(bool $on, DebugConsole $console) : void
    {
        if ($on) {
            $this->enableSsao();
        } else {
            $this->disableSsao();
        }

        $console->writeLine($this->ssaoStatus());
    }

    private function toggleSsao(DebugConsole $console) : void
    {
        if ($this->renderer->ssao != null) {
            $this->disableSsao();
        } else {
            $this->enableSsao();
        }

        $console->writeLine($this->ssaoStatus());
    }

    private function enableSsao() : void
    {
        if ($this->renderer->ssao != null) {
            return;
        }

        $this->renderer->ssao = $this->held ?? SsaoQuality::ultra();
    }

    private function disableSsao() : void
    {
        SsaoQuality? $current = $this->renderer->ssao;
        if ($current != null) {
            SsaoQuality $quality = guard $current;
            $this->held = $quality;
            $this->renderer->ssao = null;
        }
    }

    private function setStrength(float32 $value, DebugConsole $console) : void
    {
        SsaoQuality $quality = $this->current();
        $quality->strength = $value;
        $console->writeLine($this->ssaoStatus());
    }

    private function setQuality(SsaoLevel $level, DebugConsole $console) : void
    {
        $this->current()->apply($level);
        $console->writeLine($this->ssaoStatus());
    }

    /**
     * Live settings when SSAO is on, otherwise the stashed ones (ultra if nothing was held).
     */
    private function current() : SsaoQuality
    {
        SsaoQuality? $ssao = $this->renderer->ssao;
        if ($ssao != null) {
            SsaoQuality $live = guard $ssao;
            return $live;
        }

        SsaoQuality $held = $this->held ?? SsaoQuality::ultra();
        $this->held = $held;
        return $held;
    }

    private function ssaoStatus() : string
    {
        string $state = 'off';
        if ($this->renderer->ssao != null) {
            $state = 'on';
        }

        SsaoQuality? $ssao = $this->renderer->ssao;
        if ($ssao == null) {
            $ssao = $this->held;
        }

        if ($ssao == null) {
            return "ssao: {$state}";
        }

        SsaoQuality $quality = guard $ssao;
        string $level = $quality->level->label();
        return "ssao: {$state}, quality {$level}, strength {$quality->strength}, radius {$quality->radius}";
    }
}

internal enum SsaoConsoleAction
{
    case status;
    case enable(bool $on);
    case toggle;
    case strength(float32 $value);
    case quality(SsaoLevel $level);
    case usage;
}

/**
 * `ssao` alone is status; `ssao on|off|toggle` flips the renderer field;
 * `ssao quality` is the cost preset; `ssao strength` is the occlusion exponent.
 */
internal function parseSsaoConsole(const ConsoleCommandSignal& $cmd) : SsaoConsoleAction
{
    if (!$cmd->isAction('ssao')) {
        return .usage;
    }

    usize $n = $cmd->parts->count();
    if ($n == 1) {
        return .status;
    }

    string $verb = $cmd->parts[1];
    if ($verb == 'on') {
        if ($n != 2) {
            return .usage;
        }

        return .enable(true);
    }

    if ($verb == 'off') {
        if ($n != 2) {
            return .usage;
        }

        return .enable(false);
    }

    if ($verb == 'toggle') {
        if ($n != 2) {
            return .usage;
        }

        return .toggle;
    }

    if ($verb == 'strength') {
        if ($n != 3) {
            return .usage;
        }

        float64 $value = guard str::float($cmd->parts[2]) else {
            return .usage;
        }
        return .strength($value as float32);
    }

    if ($verb == 'quality') {
        if ($n != 3) {
            return .usage;
        }

        SsaoLevel $level = guard SsaoLevel::parse($cmd->parts[2]) else {
            return .usage;
        }
        return .quality($level);
    }

    return .usage;
}
