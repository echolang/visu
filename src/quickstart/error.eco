/**
 * Process-edge failures for the prototyping harness. Pipeline
 * execute errors stay PipelineError; FlyUI boot is UiError.
 */

namespace visu::quickstart;

use visu::graphics::PipelineError;
use visu::ui::UiError;

public enum AppError
{
    case none;
    case pipeline(PipelineError $inner);
    case ui(UiError $inner);

    public const function failed() : bool
    {
        return match ($this) {
            AppError::none => false,
            else => true,
        };
    }

    public const function message() : string
    {
        return match ($this) {
            AppError::none => '',
            AppError::pipeline($inner) => $inner->message(),
            AppError::ui($inner) => $inner->message(),
        };
    }
}

internal function appPipeline(PipelineError $inner) : AppError
{
    return .pipeline($inner);
}

internal function appUi(UiError $inner) : AppError
{
    return .ui($inner);
}
