/**
 * Prototyping harness: window + loop + pipeline behind closures.
 * Not for large apps.
 * Cuts corners (die at the process edge).
 */

namespace visu::quickstart;

use visu::app::{HostError, Paths, Services, bootstrap};
use visu::instrument::{DeviceSource, LoopSource};
use visu::os::{init, requestStop, resourceRoot, terminate};
use visu::runtime::{GameLoop, registerMain, unregisterMain};
use visu::signal::{Flow, Resume};

public class Quickstart
{
    private App $app;
    private Options $options;
    private GameLoop $loop;

    public constructor(function<void(Options)> $configure)
    {
        Options $options = Options();
        $configure($options);
        $this->options = $options;

        Services $services = $options->services ?? bootstrap(Paths(root: resourceRoot()), function(Services $s) : void {
        });
        
        $this->app = App($options, $services);
        $this->loop = GameLoop($this->app, $options->tickRate, $options->maxUpdatesPerFrame);

        $this->app->instruments->add(LoopSource($this->loop));
        $this->app->instruments->add(DeviceSource($this->app->device));
    }

    public function app() : App
    {
        return $this->app;
    }

    public function loop() : GameLoop
    {
        return $this->loop;
    }

    /**
     * Bring the window and loop up.
     * Called from os::run start.
     */
    public function prepare() : void
    {
        guard init() else ($e) {
            die($e->message());
        }

        guard $this->app->initialize() else ($e) {
            terminate();
            die($e->message());
        }

        registerMain($this->app->events);
        $this->app->ready();
        $this->loop->prepare();
        GameLoop $loop = $this->loop;
        $this->app->dispatcher->register<Resume>(function(const Resume& $signal) : Flow {
            $loop->prepare();
            return .proceed;
        });
    }

    public function tick() : void
    {
        if ($this->app->shouldStop()) {
            requestStop();
            return;
        }

        $this->loop->pulse();
    }

    public function shutdown() : void
    {
        HostError $fail = $this->app->host->fail;
        $this->app->destroy();
        unregisterMain();
        terminate();

        if ($fail->failed()) {
            die($fail->message());
        }
    }

    /**
     * Process edge.
     * os::run: prepare after the host is up (iOS: after the key window exists), tick until requestStop.
     */
    public function run() : void
    {
        Quickstart $qs = $this;
        visu::os::run(
            function() : void {
                $qs->prepare();
            },
            function() : void {
                $qs->tick();
            },
            function() : void {
                $qs->shutdown();
            }
        );
    }
}
