/**
 * Prototyping harness: window + loop + pipeline behind closures.
 * Not for large apps.
 * Cuts corners (die at the process edge).
 */

namespace visu::quickstart;

use visu::app::{Application, Host, HostError, Paths, Services, bootstrap};
use visu::instrument::{DeviceSource, LoopSource};
use visu::os::{requestStop, resourceRoot};
use visu::runtime::GameLoop;
use visu::signal::{Flow, ResumeSignal};

public class Quickstart : Application
{
    private App $app;
    private Options $options;
    private GameLoop $loop;

    public constructor(function<void(Options)> $configure)
    {
        Options $options = Options();
        $configure($options);
        $this->options = $options;

        Services $services = $options->services ?? bootstrap(Paths(root: resourceRoot()), function(Services $s) : void {
        });

        $this->app = App($options, $services);
        $this->loop = GameLoop($this->app, $options->tickRate, $options->maxUpdatesPerFrame);

        $this->app->instruments->add(LoopSource($this->loop));
        $this->app->instruments->add(DeviceSource($this->app->device));
    }

    public function app() : App
    {
        return $this->app;
    }

    public function loop() : GameLoop
    {
        return $this->loop;
    }

    public const function host() : Host
    {
        return $this->app->host;
    }

    public function initialize() : status<HostError>
    {
        return $this->app->initialize();
    }

    /**
     * After the host is up: ready callbacks, loop clock, snap the clock on resume.
     */
    public function prepare() : void
    {
        $this->app->ready();
        $this->loop->prepare();
        GameLoop $loop = $this->loop;
        $this->app->dispatcher->register<ResumeSignal>(function(const ResumeSignal& $signal) : Flow {
            $loop->prepare();
            return .proceed;
        });
    }

    public function tick() : void
    {
        if ($this->app->shouldStop()) {
            requestStop();
            return;
        }

        $this->loop->pulse();
    }

    public function destroy() : void
    {
        $this->app->destroy();
    }

    /**
     * Process edge.
     * visu::app::run: prepare after the host is up (iOS: after the key window exists), tick until requestStop.
     */
    public function run() : void
    {
        visu::app::run($this);
    }
}
