/**
 * Prototyping harness: window + loop + pipeline behind closures.
 * Not for large apps. Cuts corners (die at the process edge).
 */

namespace visu::quickstart;

use std::env;
use std::io;
use visu::app::{Paths, Services, bootstrap};
use visu::instrument::{DeviceSource, LoopSource};
use visu::os::{init, terminate};
use visu::runtime::{GameLoop, registerMain, unregisterMain};

public class Quickstart
{
    private App $app;
    private Options $options;
    private GameLoop $loop;

    public constructor(function<void(Options)> $configure)
    {
        Options $options = Options();
        $configure($options);
        $this->options = $options;

        Services $services = $options->services ?? bootstrap(Paths(root: env::cwd()), function(Services $s) : void {
        });
        $this->app = App($options, $services);
        $this->loop = GameLoop($this->app, $options->tickRate, $options->maxUpdatesPerFrame);
        $this->app->instruments->add(LoopSource($this->loop));
        $this->app->instruments->add(DeviceSource($this->app->device));
    }

    public function app() : App
    {
        return $this->app;
    }

    public function loop() : GameLoop
    {
        return $this->loop;
    }

    /**
     * glfwInit, initialize the window, ready(), run the loop, tear
     * down. Dies on WindowError / AppError — this is the process
     * edge.
     */
    public function run() : void
    {
        guard init() else ($e) {
            die($e->message());
        }

        guard $this->app->initialize() else ($e) {
            terminate();
            die($e->message());
        }

        registerMain($this->app->events);
        $this->loadShaders();
        $this->app->ready();
        $this->loop->start();

        AppError $fail = $this->app->fail;
        $this->app->destroy();
        unregisterMain();
        terminate();

        if ($fail->failed()) {
            die($fail->message());
        }
    }

    private function loadShaders() : void
    {
        string $dir = $this->app->shaders->loader->directory;
        bool $here = guard io::exists($dir) else ($e) {
            $this->teardown();
            die($e->message());
        }

        if (!$here) {
            return;
        }

        guard $this->app->shaders->scan() else ($e) {
            $this->teardown();
            die($e->message());
        }
    }

    private function teardown() : void
    {
        $this->app->destroy();
        unregisterMain();
        terminate();
    }
}
