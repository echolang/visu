/**
 * Prototyping app the GameLoop drives.
 * Owns a Host (window / GPU session); GPU objects store the Device.
 * Scene goes to an offscreen target: `$opt->render` adds graph passes, `$opt->draw` runs after beginRender on that target, `$opt->ui` builds FlyUI during graph setup, then the host blits to the backbuffer.
 */

namespace visu::quickstart;

use visu::app::{Host, HostConfig, HostError, HostPassData, Services};
use visu::ecs::{Entities, Systems};
use visu::graphics::{
    CallbackPass, RenderContext, Device, Frame, IoSink, Pipeline, PipelineError,
    Pool, RenderEncoder, RenderTarget, ShaderCollection, TargetRef
};
use visu::instrument::Instruments;
use visu::math::Vec2;
use visu::os::Window;
use visu::os::input::{ContextMap, InputHub};
use visu::runtime::{EventLoop, GameLoopDelegate};
use visu::signal::Dispatcher;
use visu::ui::Ui;

public class App : GameLoopDelegate
{
    public Host $host;
    public Device $device;
    public Window $window;
    public Pool $pool;
    public Entities $entities;
    public Systems $systems;
    public Dispatcher $dispatcher;
    public InputHub $input;
    public ContextMap $inputContext;
    public ShaderCollection $shaders;
    public Services $services;
    public Options $options;
    public EventLoop $events;
    public Instruments $instruments;
    public Ui? $ui;
    public int32 $tickIndex;

    public constructor(Options $options, Services $services)
    {
        $this->options = $options;
        $this->services = $services;
        HostConfig $cfg = hostConfigFromOptions($options);
        Host $host = Host($cfg, $services);
        $this->host = $host;
        $this->device = $host->device;
        $this->window = $host->window;
        $this->pool = $host->pool;
        $this->dispatcher = $host->dispatcher;
        $this->input = $host->input;
        $this->inputContext = $host->inputContext;
        $this->shaders = $host->shaders;
        $this->events = $host->events;
        $this->instruments = $host->instruments;
        $this->ui = $host->ui;
        $this->entities = Entities();
        $this->systems = Systems();
        $this->tickIndex = 0;
    }

    public function initialize() : status<HostError>
    {
        guard $this->host->initialize() else ($e) {
            return .error($e);
        }
        $this->ui = $this->host->ui;
        return .ok;
    }

    public function ready() : void
    {
        $this->runCallback($this->options->ready);
        $this->systems->register($this->entities);
        $this->runCallback($this->options->initializeScene);
    }

    public function update() : void
    {
        $this->host->poll();
        $this->systems->update($this->entities);
        $this->runCallback($this->options->update);
        $this->tickIndex = $this->tickIndex + 1;
    }

    public function render(float32 $compensation) : void
    {
        App $app = $this;
        $this->host->renderFrame(
            $compensation,
            function(RenderContext $ctx, TargetRef $target) : void {
                $app->runRender($ctx, $target);
                $app->systems->render($app->entities, $ctx);
                $app->addDraw($ctx->pipeline);
            },
            $app->uiHook(),
            function() : void {
                $app->runAfterFrame();
            }
        );
    }

    public function shouldStop() : bool
    {
        return $this->host->shouldStop();
    }

    public function destroy() : void
    {
        $this->device->waitIdle();
        $this->systems->unregister($this->entities);
        $this->runCallback($this->options->teardown);
        $this->host->destroy();
        $this->ui = null;
    }

    internal function addDraw(Pipeline $pipeline) : void
    {
        $pipeline->add(CallbackPass(
            'quickstart.draw',
            setup: function(Pipeline $pipe, Frame $frame, IoSink $io) : void {
                HostPassData $data = $frame->get<HostPassData>();
                $io->writes($data->renderTarget);
            },
            execute: function(RenderContext $ctx) : status<PipelineError> {
                function<void(App, RenderContext, RenderTarget)> $draw = guard $this->options->draw else {
                    return .ok;
                }
                HostPassData $data = $ctx->frame->get<HostPassData>();
                RenderEncoder $enc = guard $ctx->beginRender($data->renderTarget) else ($e) {
                    return .error($e);
                }
                RenderTarget $rt = guard $ctx->pool->getTarget($data->renderTarget) else ($e) {
                    $enc->endRender();
                    return .error(.pool($e));
                }
                $draw($this, $ctx, $rt);
                $enc->endRender();
                return .ok;
            }
        ));
    }

    private function uiHook() : function<void(Ui)>?
    {
        function<void(App, Ui)> $cb = guard $this->options->ui else {
            return null;
        }
        App $app = $this;
        return function(Ui $ui) : void {
            $cb($app, $ui);
        };
    }

    internal function runAfterFrame() : void
    {
        $this->runCallback($this->options->afterFrame);
    }

    private function runCallback(function<void(App)>? $cb) : void
    {
        function<void(App)> $fn = guard $cb else {
            return;
        }
        $fn($this);
    }

    internal function runRender(RenderContext $ctx, TargetRef $target) : void
    {
        function<void(App, RenderContext, TargetRef)> $fn = guard $this->options->render else {
            return;
        }
        $fn($this, $ctx, $target);
    }
}

internal function hostConfigFromOptions(Options $options) : HostConfig
{
    HostConfig $cfg = HostConfig();
    $cfg->title = $options->windowTitle;
    $cfg->width = $options->windowWidth;
    $cfg->height = $options->windowHeight;
    $cfg->vsync = $options->windowVsync;
    $cfg->headless = $options->windowHeadless;
    $cfg->instrumentOverlay = $options->instrumentOverlay;
    $cfg->debugConsole = $options->debugConsole;
    $cfg->ui = $options->ui != null;
    $cfg->maxFrames = $options->maxFrames;
    $cfg->clearColor = $options->clearColor;
    $cfg->targetName = 'quickstartTarget';
    $cfg->colorName = 'quickstartColor';
    if ($options->renderResolution != null) {
        Vec2 $fixed = guard $options->renderResolution;
        $cfg->fixedResolution = true;
        $cfg->renderSize = $fixed;
    }

    return $cfg;
}
