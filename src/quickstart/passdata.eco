/**
 * Per-frame mailbox for the Quickstart offscreen target. render
 * writes this target; draw (and FlyUI later) too; the blit reads
 * outputTexture onto the backbuffer. Replace outputTexture to
 * debug a G-Buffer attachment.
 */

namespace visu::quickstart;

use visu::graphics::{TargetRef, TextureRef};

public class QuickstartPassData
{
    public TargetRef $renderTarget;
    public TextureRef $outputTexture;

    public constructor(TargetRef $renderTarget, TextureRef $outputTexture)
    {
        $this->renderTarget = $renderTarget;
        $this->outputTexture = $outputTexture;
    }
}
