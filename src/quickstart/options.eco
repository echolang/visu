/**
 * Knobs for the prototyping harness.
 * Public fields, no fluent chain.
 * Closures are the extension point; Echo has no subclassing.
 */

namespace visu::quickstart;

use visu::app::Services;
use visu::graphics::{Context, RenderTarget, TargetRef};
use visu::math::{Vec2, Vec4};
use visu::ui::Ui;

public class Options
{

    /**
     * Targeted update ticks per second.
     */
    public float64 $tickRate = 60.0;

    /**
     * Spiral-of-death cap: force a render after this many updates.
     */
    public int32 $maxUpdatesPerFrame = 10;

    public string $windowTitle = 'VISU Quickstart';
    public int32 $windowWidth = 1280;
    public int32 $windowHeight = 720;
    public bool $windowVsync = true;
    public bool $windowHeadless = false;

    /**
     * VG FPS overlay on the backbuffer.
     * Forced off when windowHeadless so glfw tests skip VG load.
     */
    public bool $instrumentOverlay = true;

    /**
     * Stop after this many rendered frames.
     * Null is unlimited.
     * `--define VISU_FINITE` fills this with 120.
     */
    public int32? $maxFrames = null;

    /**
     * ClearPass colour on the offscreen scene target each frame.
     */
    public Vec4 $clearColor;

    /**
     * Fixed pixel size for the offscreen target.
     * Null mirrors the window framebuffer (including content scale).
     */
    public Vec2? $renderResolution = null;

    /**
     * Occupied Services, if the caller already bootstrapped.
     * Null builds one from cwd via bootstrap() / defaults().
     */
    public Services? $services = null;

    public function<void(App)>? $ready = null;
    public function<void(App)>? $initializeScene = null;
    public function<void(App)>? $update = null;
    public function<void(App, Context, TargetRef)>? $render = null;
    public function<void(App, Context, RenderTarget)>? $draw = null;
    public function<void(App, Ui)>? $ui = null;

    /**
     * After present, not in a frame; safe to dump GPU images.
     */
    public function<void(App)>? $afterFrame = null;

    /**
     * After the loop, before shaders / pool / window / shutdown.
     * GPU objects created in ready go here.
     */
    public function<void(App)>? $teardown = null;

    public constructor()
    {
        $this->clearColor = Vec4(0.25f, 0.25f, 0.25f, 1.0f);
        $this->maxFrames = visu::finiteFrames();
    }
}
