namespace visu::debugserver;

public enum DebugServerError
{
    case spawn(string $why);
    case bind(string $address, string $why);

    public const function message() : string
    {
        return match ($this) {
            DebugServerError::spawn($why) => "debug server: could not start the server thread: {$why}",
            DebugServerError::bind($address, $why) => "debug server: could not listen on {$address}: {$why}",
        };
    }
}
