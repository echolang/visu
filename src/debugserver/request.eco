/**
 * What a debug client asked the running app for. Parsed from a request frame on the connection's
 * thread (`parseOp`), answered on the main thread by `DebugExecutor`.
 */

namespace visu::debugserver;

use visu::dcapture::Step;

public enum DebugRequest
{
    case status;

    /**
     * Console lines, run in order on one frame, each with its own captured output.
     */
    case console(array<string> $commands);
    case verbs;
    case flags;
    case setFlag(string $name, string $raw);

    /**
     * A dcapture step object applied now. Its dumps and profiles report into `var/debug`.
     */
    case step(Step $step);

    /**
     * Dump every name matching `$pattern` after the next present. Answers with the paths written.
     */
    case snapshot(string $pattern);
    case dumps;
    case profile;
    case wait(int32 $frames);
}
