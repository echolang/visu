/**
 * The main thread's answer to a `DebugRequest`. The connection thread wraps it in the reply frame
 * (`replyJson`): `body` is the result's JSON when there is no `fault`, `message` the reason
 * otherwise. Snapshots and profiles answer with the paths they wrote, so the main thread never
 * reads an image back in and nothing large crosses the wire.
 */

namespace visu::debugserver;

public struct DebugReply
{
    public DebugFault? $fault;
    public string $body;
    public string $message;

    public constructor(json: const string& $body)
    {
        $this->fault = null;
        $this->body = $body;
        $this->message = '';
    }

    /**
     * A refusal or a failure: which kind, and why in words.
     */
    public constructor(DebugFault $fault, error: const string& $message)
    {
        $this->fault = $fault;
        $this->body = '';
        $this->message = $message;
    }
}
