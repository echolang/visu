/**
 * Left-button click: press then release without travelling far.
 * InputHub is the producer; this is only the payload.
 */

namespace visu::signal;

use visu::math::Vec2;

public struct Click
{
    public const int32 $mods;
    public const Vec2 $position;
    public const Vec2 $initial;
    public const float32 $travel;
}
