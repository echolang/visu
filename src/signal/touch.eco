/**
 * One finger, one event.
 * Never coalesced into mouse by the host.
 */

namespace visu::signal;

use visu::math::Vec2;
use visu::os::input::TouchPhase;

public struct TouchSignal
{
    public const int32 $id;
    public const TouchPhase $phase;
    public const Vec2 $position;
    public const float32 $force;
}
