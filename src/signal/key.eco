/**
 * Keyboard press, release, or repeat.
 */

namespace visu::signal;

use visu::os::input;
use visu::os::input::{
    MOD_ALT, MOD_CAPS_LOCK, MOD_CONTROL, MOD_NUM_LOCK, MOD_SHIFT, MOD_SUPER
};

public struct KeySignal
{
    public const input::Key $key;
    public const int32 $scancode;
    public const input::KeyPhase $phase;
    public const int32 $mods;

    public const function isShift() : bool
    {
        return ($this->mods & MOD_SHIFT) == MOD_SHIFT;
    }

    public const function isControl() : bool
    {
        return ($this->mods & MOD_CONTROL) == MOD_CONTROL;
    }

    public const function isAlt() : bool
    {
        return ($this->mods & MOD_ALT) == MOD_ALT;
    }

    public const function isSuper() : bool
    {
        return ($this->mods & MOD_SUPER) == MOD_SUPER;
    }

    public const function isCapsLock() : bool
    {
        return ($this->mods & MOD_CAPS_LOCK) == MOD_CAPS_LOCK;
    }

    public const function isNumLock() : bool
    {
        return ($this->mods & MOD_NUM_LOCK) == MOD_NUM_LOCK;
    }
}
