/**
 * Keyboard press, release, or repeat.
 */

namespace visu::signal;

use visu::os::key;

public struct Key
{
    public const int32 $key;
    public const int32 $scancode;
    public const int32 $action;
    public const int32 $mods;

    public const function isShift() : bool
    {
        return ($this->mods & key::MOD_SHIFT) == key::MOD_SHIFT;
    }

    public const function isControl() : bool
    {
        return ($this->mods & key::MOD_CONTROL) == key::MOD_CONTROL;
    }

    public const function isAlt() : bool
    {
        return ($this->mods & key::MOD_ALT) == key::MOD_ALT;
    }

    public const function isSuper() : bool
    {
        return ($this->mods & key::MOD_SUPER) == key::MOD_SUPER;
    }

    public const function isCapsLock() : bool
    {
        return ($this->mods & key::MOD_CAPS_LOCK) == key::MOD_CAPS_LOCK;
    }

    public const function isNumLock() : bool
    {
        return ($this->mods & key::MOD_NUM_LOCK) == key::MOD_NUM_LOCK;
    }
}
