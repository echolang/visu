/**
 * Mouse button press or release.
 */

namespace visu::signal;

use visu::os::key;
use visu::os::mouse;

public struct MouseButton
{
    public const int32 $button;
    public const int32 $action;
    public const int32 $mods;

    public const function isLeft() : bool
    {
        return $this->button == mouse::LEFT;
    }

    public const function isRight() : bool
    {
        return $this->button == mouse::RIGHT;
    }

    public const function isMiddle() : bool
    {
        return $this->button == mouse::MIDDLE;
    }

    public const function isLeftDown() : bool
    {
        return $this->isLeft() && $this->action == key::PRESS;
    }

    public const function isRightDown() : bool
    {
        return $this->isRight() && $this->action == key::PRESS;
    }

    public const function isMiddleDown() : bool
    {
        return $this->isMiddle() && $this->action == key::PRESS;
    }

    public const function isLeftUp() : bool
    {
        return $this->isLeft() && $this->action == key::RELEASE;
    }

    public const function isRightUp() : bool
    {
        return $this->isRight() && $this->action == key::RELEASE;
    }

    public const function isMiddleUp() : bool
    {
        return $this->isMiddle() && $this->action == key::RELEASE;
    }
}
