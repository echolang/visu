/**
 * Mouse button press or release.
 * Fingers do not produce this.
 */

namespace visu::signal;

use visu::os::input;

public struct MouseButton
{
    public const input::MouseButton $button;
    public const input::KeyPhase $phase;
    public const int32 $mods;

    public const function isLeft() : bool
    {
        return $this->button == input::MouseButton::left;
    }

    public const function isRight() : bool
    {
        return $this->button == input::MouseButton::right;
    }

    public const function isMiddle() : bool
    {
        return $this->button == input::MouseButton::middle;
    }

    public const function isLeftDown() : bool
    {
        return $this->isLeft() && $this->phase == input::KeyPhase::press;
    }

    public const function isRightDown() : bool
    {
        return $this->isRight() && $this->phase == input::KeyPhase::press;
    }

    public const function isMiddleDown() : bool
    {
        return $this->isMiddle() && $this->phase == input::KeyPhase::press;
    }

    public const function isLeftUp() : bool
    {
        return $this->isLeft() && $this->phase == input::KeyPhase::release;
    }

    public const function isRightUp() : bool
    {
        return $this->isRight() && $this->phase == input::KeyPhase::release;
    }

    public const function isMiddleUp() : bool
    {
        return $this->isMiddle() && $this->phase == input::KeyPhase::release;
    }
}
