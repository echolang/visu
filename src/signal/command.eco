/**
 * A line submitted to the debug console. No console back-ref — the
 * console is a producer, this is a fact.
 */

namespace visu::signal;

public struct ConsoleCommand
{
    public const string $raw;
    public const array<string> $parts;

    public constructor(string $raw)
    {
        $this->raw = $raw;
        str::parts $split = str::split($raw, ' ');
        $this->parts = $split->owned();
    }

    public const function isAction(const string& $command) : bool
    {
        if ($this->parts->empty()) {
            return false;
        }

        return $this->parts[0] == $command;
    }
}
