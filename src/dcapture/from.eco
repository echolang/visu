/**
 * `str::from` so `"{$e}"` works. Own file because a namespace is a property of the file.
 */

namespace str;

public function from(const visu::dcapture::DCaptureError& $e) : string
{
    return $e->message();
}

public function from(const visu::dcapture::DumpFailure& $e) : string
{
    return $e->message();
}
