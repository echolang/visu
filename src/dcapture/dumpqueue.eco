/**
 * Dump-after-present queue for images and profile trees. Always on so console `dump` and `profile dump`
 * work without a script. The script driver queues onto the same object; stop-only steps do not stall the GPU.
 */

namespace visu::dcapture;

use std::env;
use std::io;
use visu::app::{flags, info};
use visu::graphics::{Frame, Pool};
use visu::os::Window;
use visu::profile::{FrameProfile, StatsBook, writeProfile};

/**
 * One dump-after-present item. Profile `$frame` is -1 until afterPresent stamps the presented
 * frame; the JSON is written when that frame's profile completes.
 */
internal enum QueuedWork
{
    case dump(string $pattern, string $label);
    case profile(int32 $frame, string $label);
}

public class DumpQueue
{
    public const string $out;
    private Dumper $dumper;
    private Manifest $manifest;
    private array<DumpProvider> $providers;
    private array<QueuedWork> $queue;
    private bool $listQueued;
    private bool $stopQueued;
    private bool $wroteAnything;
    private int32 $tick;
    private bool $gpuLog;
    private int32 $gpuFrames;

    public constructor(string $out)
    {
        $this->out = $out;
        $this->dumper = Dumper($out);
        $this->manifest = Manifest();
        $this->providers = builtinProviders();
        $this->queue = array<QueuedWork>();
        $this->listQueued = false;
        $this->stopQueued = false;
        $this->wroteAnything = false;
        $this->tick = 0;
        $this->gpuLog = false;
        $this->gpuFrames = 0;
    }

    /**
     * One JSON line per completed frame of GPU times (`gpu.jsonl`). Starts empty; Host noteProfile fills it.
     */
    public function logGpu() : void
    {
        $this->gpuLog = true;
    }

    public function addProvider(DumpProvider $provider) : void
    {
        $this->providers[] = $provider;
    }

    public function queue(const string& $pattern) : void
    {
        string $empty = '';
        $this->queue($pattern, $empty);
    }

    public function queue(const string& $pattern, const string& $label) : void
    {
        QueuedWork $dump = QueuedWork::dump($pattern, $label);
        $this->queue[] = $dump;
    }

    /**
     * Write the profile tree of the frame being presented next, once its GPU spans landed.
     */
    public function queueProfile(const string& $label) : void
    {
        QueuedWork $item = QueuedWork::profile(-1, $label);
        $this->queue[] = $item;
    }

    public function queueList() : void
    {
        $this->listQueued = true;
    }

    public function queueStop() : void
    {
        $this->stopQueued = true;
    }

    public const function queued() : int32
    {
        return $this->queue->count() as int32;
    }

    /**
     * Write queued dumps, list the catalog, then stop. Outside a frame; stalls only when a dump
     * or list needs GPU readback.
     */
    public function afterPresent(Frame $frame, Pool $pool, Window $window, int32 $presented, int32 $tick) : void
    {
        $this->tick = $tick;
        $this->stampProfiles($presented);
        array<QueuedWork> $dumps = array<QueuedWork>();
        array<QueuedWork> $kept = array<QueuedWork>();
        foreach ($this->queue as $item) {
            match ($item) {
                QueuedWork::dump($pattern, $label) => {
                    $dumps[] = $item;
                },
                else => {
                    $kept[] = $item;
                },
            }
        }

        $this->queue = $kept;
        bool $needCatalog = !$dumps->empty() || $this->listQueued;
        if (!$needCatalog && !$this->stopQueued) {
            return;
        }

        DumpCatalog $catalog = DumpCatalog();
        if ($needCatalog) {
            $pool->device->waitIdle();
            foreach ($this->providers as $provider) {
                $provider->describe($frame, $pool, $catalog);
            }
        }

        foreach ($dumps as $item) {
            match ($item) {
                QueuedWork::dump($pattern, $label) => {
                    $this->writeDump($catalog, $pool, $pattern, $label, $presented);
                },
                else => {
                },
            }
        }

        if ($this->listQueued) {
            $this->listQueued = false;
            array<string> $names = $catalog->names();
            $this->manifest->catalog = $names;
            int32 $count = $names->count() as int32;
            info("dcapture: {$count} dumpable names at frame {$presented}, see manifest.json");
            $this->wroteAnything = true;
        }

        if ($this->stopQueued) {
            $this->stopQueued = false;
            $this->note("frame {$presented}: stop");
            $window->setShouldClose(true);
        }

        $this->manifest->frames = $presented + 1;
        $this->manifest->ticks = $tick;
        $this->writeManifest();
    }

    /**
     * A frame's profile completed (GPU spans in, or abandoned at shutdown): write every dump queued
     * for it. Host calls this from its frame end and from destroy.
     */
    public function noteProfile(const FrameProfile& $profile, const StatsBook& $stats) : void
    {
        if ($this->gpuLog) {
            $this->appendGpuLog(formatGpuLog($profile));
        }

        if ($this->queue->empty()) {
            return;
        }

        array<QueuedWork> $kept = array<QueuedWork>();
        array<QueuedWork> $have = $this->queue;
        bool $wrote = false;
        foreach ($have as $item) {
            bool $keep = true;
            match ($item) {
                QueuedWork::profile($frame, $label) => {
                    if ($frame == $profile->frame) {
                        $this->writeProfileFile($profile, $stats, $frame, $label);
                        $wrote = true;
                        $keep = false;
                    }
                },
                else => {
                },
            }

            if ($keep) {
                $kept[] = $item;
            }
        }

        $this->queue = $kept;

        if ($wrote) {
            $this->writeManifest();
        }
    }

    public function skip(const array<Step>& $left) : void
    {
        foreach ($left as $step) {
            $this->manifest->skipped[] = $step->describe();
        }
    }

    public function finish(int32 $framesRun, int32 $tick, bool $force) : void
    {
        $this->tick = $tick;
        $this->manifest->frames = $framesRun;
        $this->manifest->ticks = $tick;
        array<QueuedWork> $left = $this->queue;
        $this->queue = array<QueuedWork>();
        foreach ($left as $item) {
            match ($item) {
                QueuedWork::profile($frame, $label) => {
                    if ($frame < 0) {
                        $this->fail('profile: run ended before the step frame was presented');
                    } else {
                        $this->fail("profile f{$frame}: run ended before the frame completed");
                    }
                },
                else => {
                },
            }
        }

        if ($this->gpuLog) {
            string $ds = env::DS;
            info("dcapture: wrote {$this->out}{$ds}gpu.jsonl ({$this->gpuFrames} frames)");
        }

        if (!$force && !$this->wroteAnything && !$this->gpuLog) {
            return;
        }

        $this->writeManifest();
    }

    public function note(string $text) : void
    {
        $this->manifest->events[] = $text;
    }

    public function fail(string $text) : void
    {
        info("dcapture: {$text}");
        $this->manifest->errors[] = $text;
    }

    private function writeDump(
        DumpCatalog $catalog,
        Pool $pool,
        string $pattern,
        string $label,
        int32 $presented
    ) : void
    {
        array<DumpEntry> $entries = $catalog->resolve($pattern);
        if ($entries->empty()) {
            DumpFailure $miss = .unknown($pattern);
            $this->fail($miss->message());
            return;
        }

        foreach ($entries as $entry) {
            array<DumpRecord> $records = guard $this->dumper->write($pool, $entry, $presented, $label) else ($e) {
                $this->fail($e->message());
                continue;
            }
            foreach ($records as $record) {
                $this->manifest->dumps[] = $record;
                info("dcapture: wrote {$record->path}");
            }
            $this->wroteAnything = true;
        }
    }

    private function stampProfiles(int32 $presented) : void
    {
        int32 $i = 0;
        while ($i < ($this->queue->count() as int32)) {
            match ($this->queue[$i as usize]) {
                QueuedWork::profile($frame, $label) => {
                    if ($frame < 0) {
                        QueuedWork $stamped = QueuedWork::profile($presented, $label);
                        $this->queue[$i as usize] = $stamped;
                    }
                },
                else => {
                },
            }
            $i = $i + 1;
        }
    }

    private function writeProfileFile(
        const FrameProfile& $profile,
        const StatsBook& $stats,
        int32 $frame,
        string $label
    ) : void
    {
        guard ensureDir($this->out) else ($e) {
            $this->fail($e->message());
            return;
        }
        string $ds = env::DS;
        string $path = "{$this->out}{$ds}profile.f{$frame}.json";
        guard writeProfile($path, $profile, $stats) else ($e) {
            $this->fail($e->message());
            return;
        }
        $this->manifest->profiles[] = ProfileRecord($frame, $path, $label);
        string $gpu = 'gpu resolved';

        if (!$profile->gpuResolved) {
            $gpu = 'gpu missing';
        }

        $this->note("frame {$frame}: profile written, {$gpu}");
        info("dcapture: wrote {$path}");
        $this->wroteAnything = true;
    }

    private function appendGpuLog(const string& $line) : void
    {
        guard ensureDir($this->out) else ($e) {
            $this->fail($e->message());
            return;
        }

        string $ds = env::DS;
        string $path = "{$this->out}{$ds}gpu.jsonl";
        io::file $file = guard io::append($path) else ($e) {
            $this->fail($e->message());
            return;
        }
        string $text = $line;
        $text->append(io::NEWLINE);
        guard $file->write($text) else ($e) {
            $this->fail($e->message());
            return;
        }

        $this->gpuFrames = $this->gpuFrames + 1;
        $this->wroteAnything = true;
    }

    private function writeManifest() : void
    {
        guard ensureDir($this->out) else ($e) {
            info("dcapture: {$e->message()}");
            return;
        }
        string $ds = env::DS;
        string $path = "{$this->out}{$ds}manifest.json";
        guard $this->manifest->write($path, flags()) else ($e) {
            info("dcapture: {$e->message()}");
            return;
        }
    }
}
