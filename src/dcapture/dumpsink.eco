/**
 * Completion of ticketed dump-after-present work. `DumpQueue` calls it on the main thread once a
 * queued dump, profile or catalog listing with a positive ticket is done.
 */

namespace visu::dcapture;

public interface DumpSink
{
    /**
     * A dump pattern matched `$matched` entries; `$records` were written and `$errors` say what
     * failed. Zero matched is an unknown name.
     */
    function dumped(
        int32 $ticket,
        usize $matched,
        const array<DumpRecord>& $records,
        const array<string>& $errors
    ) : void;

    /**
     * A profile tree was written to `$path`. Empty when the run ended before the frame completed.
     */
    function profiled(int32 $ticket, const string& $path) : void;

    /**
     * The dumpable names of the presented frame. Empty when the run ended first.
     */
    function listed(int32 $ticket, const array<string>& $names) : void;
}
