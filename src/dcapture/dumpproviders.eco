/**
 * The dump providers every `DumpQueue` of the process reads. A class, so the Host's queue and
 * the debug server's queue share one list and a provider added to either reaches both.
 */

namespace visu::dcapture;

public class DumpProviders
{
    public array<DumpProvider> $all;

    public constructor(array<DumpProvider> $all)
    {
        $this->all = $all;
    }

    public function add(DumpProvider $provider) : void
    {
        $this->all[] = $provider;
    }
}
