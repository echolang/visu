/**
 * The dcapture script: JSON text to typed steps.
 *
 * Top level: `out`, `headless`, `window: [w, h]`, `frames`, `flags`, `list`, `steps`.
 * A step carries exactly one timing key (`frame`, `tick`, `after`) and any of the actions
 * `label`, `flags`, `camera`, `console`, `dump`, `profile`, `list`, `log`, `stop`. Parsing is strict: a
 * wrong shape names the JSON path it tripped on, so an agent can fix the script blind.
 */

namespace visu::dcapture;

use visu::app::FlagValue;
use visu::math::{Quat, Vec3};

public enum StepAt
{
    case frame(int32 $n);
    case tick(int32 $n);
    case after(int32 $n);

    public const function label() : string
    {
        return match ($this) {
            StepAt::frame($n) => "frame {$n}",
            StepAt::tick($n) => "tick {$n}",
            StepAt::after($n) => "after {$n}",
        };
    }
}

/**
 * What a step does to the camera. `pose` carries the field of view in degrees; zero keeps the camera's own.
 */
public enum CameraSpec
{
    case none;
    case clear;
    case pose(Vec3 $position, Quat $orientation, float32 $fov);
}

public struct FlagAssign
{
    public string $name;
    public FlagValue $value;
}

public class Step
{
    public const int32 $index;
    public const StepAt $at;
    public const string $label;
    public const array<FlagAssign> $flags;
    public const CameraSpec $camera;
    public const array<string> $console;
    public const array<string> $dump;
    /** write this frame's profile tree as JSON once its GPU spans landed */
    public const bool $profile;
    public const bool $list;
    public const string $log;
    public const bool $stop;

    public constructor(
        int32 $index,
        StepAt $at,
        string $label,
        array<FlagAssign> $flags,
        CameraSpec $camera,
        array<string> $console,
        array<string> $dump,
        bool $profile,
        bool $list,
        string $log,
        bool $stop,
    )
    {
        $this->index = $index;
        $this->at = $at;
        $this->label = $label;
        $this->flags = $flags;
        $this->camera = $camera;
        $this->console = $console;
        $this->dump = $dump;
        $this->profile = $profile;
        $this->list = $list;
        $this->log = $log;
        $this->stop = $stop;
    }

    public const function describe() : string
    {
        string $when = $this->at->label();
        return "steps[{$this->index}] at {$when}";
    }
}

public class Script
{
    public string $out;
    public bool $headless;
    public int32? $width;
    public int32? $height;
    public int32? $frames;
    public array<FlagAssign> $flags;
    public bool $list;
    public array<Step> $steps;

    public constructor()
    {
        $this->out = 'var/dcapture';
        $this->headless = false;
        $this->width = null;
        $this->height = null;
        $this->frames = null;
        $this->flags = array<FlagAssign>();
        $this->list = false;
        $this->steps = array<Step>();
    }

    /**
     * Any step submits console lines, so the host must boot the debug console.
     */
    public const function needsConsole() : bool
    {
        foreach ($this->steps as $step) {
            if (!$step->console->empty()) {
                return true;
            }
        }

        return false;
    }

    public const function hasStop() : bool
    {
        foreach ($this->steps as $step) {
            if ($step->stop) {
                return true;
            }
        }

        return false;
    }

    public const function hasProfile() : bool
    {
        foreach ($this->steps as $step) {
            if ($step->profile) {
                return true;
            }
        }

        return false;
    }

    /**
     * Frame cap for the host: the explicit `frames`, else two past the last frame step when
     * nothing stops the run, else null for "until the window closes". Host adds in-flight GPU
     * frames when a step profiles.
     */
    public const function impliedFrames() : int32?
    {
        if ($this->frames != null) {
            return $this->frames;
        }

        if ($this->steps->empty() || $this->hasStop()) {
            return null;
        }

        array<StepAt> $resolved = resolveTiming($this->steps);
        int32 $last = -1;
        foreach ($resolved as $at) {
            int32 $n = frameNumber($at);
            if ($n > $last) {
                $last = $n;
            }
        }

        if ($last < 0) {
            return null;
        }

        return $last + 2;
    }

    public static function parse(const string& $text) : result<Script, DCaptureError>
    {
        json::Value $root = guard json::parse($text) else ($e) {
            return .error(.syntax($e));
        }
        if (!$root->isObject()) {
            return .error(.notObject('script'));
        }

        Script $script = Script();
        string $out = guard optStr($root, 'out', 'out', $script->out) else ($e) {
            return .error($e);
        }
        $script->out = $out;
        bool $headless = guard optBool($root, 'headless', 'headless', false) else ($e) {
            return .error($e);
        }
        $script->headless = $headless;
        bool $list = guard optBool($root, 'list', 'list', false) else ($e) {
            return .error($e);
        }
        $script->list = $list;
        int64 $frames = 0;
        bool $hasFrames = guard intField($root, 'frames', 'frames', $frames) else ($e) {
            return .error($e);
        }
        if ($hasFrames) {
            $script->frames = $frames as int32;
        }

        json::Value? $window = $root->get('window');
        if ($window != null) {
            json::Value $w = guard $window;
            array<json::Value> $size = guard $w->asArray() else {
                return .error(.field('window', 'array of 2 integers'));
            }
            if ($size->count() != 2) {
                return .error(.field('window', 'array of 2 integers'));
            }
            int64 $width = guard $size[0]->asInt() else {
                return .error(.field('window[0]', 'integer'));
            }
            int64 $height = guard $size[1]->asInt() else {
                return .error(.field('window[1]', 'integer'));
            }
            $script->width = $width as int32;
            $script->height = $height as int32;
        }

        json::Value? $flagsValue = $root->get('flags');
        if ($flagsValue != null) {
            json::Value $fv = guard $flagsValue;
            array<FlagAssign> $flags = guard parseFlags($fv, 'flags') else ($e) {
                return .error($e);
            }
            $script->flags = $flags;
        }

        json::Value? $stepsValue = $root->get('steps');
        if ($stepsValue != null) {
            json::Value $sv = guard $stepsValue;
            array<json::Value> $items = guard $sv->asArray() else {
                return .error(.field('steps', 'array of step objects'));
            }
            int32 $i = 0;
            foreach ($items as $item) {
                Step $step = guard parseStep($item, $i) else ($e) {
                    return .error($e);
                }
                $script->steps[] = $step;
                $i = $i + 1;
            }
        }

        guard validateTiming($script->steps) else ($e) {
            return .error($e);
        }
        if ($script->frames == null && !$script->hasStop() && onlyTicks($script->steps)) {
            return .error(.openEnded);
        }

        return .ok($script);
    }
}
