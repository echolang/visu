namespace visu::math;

public struct Vec4
{
    public float32 $x;
    public float32 $y;
    public float32 $z;
    public float32 $w;

    #[inline]
    public constructor(float32 $s)
    {
        $this->x = $s;
        $this->y = $s;
        $this->z = $s;
        $this->w = $s;
    }

    public constructor(float32 $x, float32 $y, float32 $z, float32 $w)
    {
        $this->x = $x;
        $this->y = $y;
        $this->z = $z;
        $this->w = $w;
    }

    #[inline]
    public constructor(Vec3 $xyz, float32 $w)
    {
        $this->x = $xyz->x;
        $this->y = $xyz->y;
        $this->z = $xyz->z;
        $this->w = $w;
    }

    #[inline]
    public const function xy() : Vec2
    {
        return Vec2($this->x, $this->y);
    }

    #[inline]
    public const function xyz() : Vec3
    {
        return Vec3($this->x, $this->y, $this->z);
    }
}

#[inline]
operator (Vec4 $a) + (Vec4 $b) : Vec4
{
    return Vec4($a->x + $b->x, $a->y + $b->y, $a->z + $b->z, $a->w + $b->w);
}

#[inline]
operator (Vec4 $a) - (Vec4 $b) : Vec4
{
    return Vec4($a->x - $b->x, $a->y - $b->y, $a->z - $b->z, $a->w - $b->w);
}

#[inline]
operator (Vec4 $a) * (Vec4 $b) : Vec4
{
    return Vec4($a->x * $b->x, $a->y * $b->y, $a->z * $b->z, $a->w * $b->w);
}

#[inline]
operator (Vec4 $a) / (Vec4 $b) : Vec4
{
    return Vec4($a->x / $b->x, $a->y / $b->y, $a->z / $b->z, $a->w / $b->w);
}

#[inline]
operator (Vec4 $a) + (float32 $s) : Vec4
{
    return Vec4($a->x + $s, $a->y + $s, $a->z + $s, $a->w + $s);
}

#[inline]
operator (float32 $s) + (Vec4 $a) : Vec4
{
    return $a + $s;
}

#[inline]
operator (Vec4 $a) - (float32 $s) : Vec4
{
    return Vec4($a->x - $s, $a->y - $s, $a->z - $s, $a->w - $s);
}

#[inline]
operator (float32 $s) - (Vec4 $a) : Vec4
{
    return Vec4($s - $a->x, $s - $a->y, $s - $a->z, $s - $a->w);
}

#[inline]
operator (Vec4 $a) * (float32 $s) : Vec4
{
    return Vec4($a->x * $s, $a->y * $s, $a->z * $s, $a->w * $s);
}

#[inline]
operator (float32 $s) * (Vec4 $a) : Vec4
{
    return $a * $s;
}

#[inline]
operator (Vec4 $a) / (float32 $s) : Vec4
{
    return Vec4($a->x / $s, $a->y / $s, $a->z / $s, $a->w / $s);
}

#[inline]
operator (float32 $s) / (Vec4 $a) : Vec4
{
    return Vec4($s / $a->x, $s / $a->y, $s / $a->z, $s / $a->w);
}

#[inline]
operator -(Vec4 $v) : Vec4
{
    return Vec4(-$v->x, -$v->y, -$v->z, -$v->w);
}

#[inline]
operator (Vec4 $a) == (Vec4 $b) : bool
{
    return $a->x == $b->x && $a->y == $b->y && $a->z == $b->z && $a->w == $b->w;
}

#[inline]
operator (Vec4 $a) != (Vec4 $b) : bool
{
    return !($a == $b);
}

#[inline]
operator (Vec4& $v)[usize $i] : float32&
{
    assert($i < 4, 'Vec4 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    if ($i == 1) {
        return &$v->y;
    }

    if ($i == 2) {
        return &$v->z;
    }

    return &$v->w;
}

#[inline]
operator (const Vec4& $v)[usize $i] : const float32&
{
    assert($i < 4, 'Vec4 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    if ($i == 1) {
        return &$v->y;
    }

    if ($i == 2) {
        return &$v->z;
    }

    return &$v->w;
}

#[inline]
public function dot(Vec4 $a, Vec4 $b) : float32
{
    return $a->x * $b->x + $a->y * $b->y + $a->z * $b->z + $a->w * $b->w;
}

#[inline]
public function length2(Vec4 $v) : float32
{
    return dot($v, $v);
}

#[inline]
public function length(Vec4 $v) : float32
{
    return std::math::sqrt(length2($v));
}

#[inline]
public function distance2(Vec4 $a, Vec4 $b) : float32
{
    return length2($a - $b);
}

#[inline]
public function distance(Vec4 $a, Vec4 $b) : float32
{
    return length($a - $b);
}

#[inline]
public function normalize(Vec4 $v) : Vec4
{
    return $v / length($v);
}

#[inline]
public function mix(Vec4 $a, Vec4 $b, float32 $t) : Vec4
{
    return $a * (1.0f - $t) + $b * $t;
}

#[inline]
public function abs(Vec4 $v) : Vec4
{
    return Vec4(
        std::math::abs($v->x),
        std::math::abs($v->y),
        std::math::abs($v->z),
        std::math::abs($v->w)
    );
}

#[inline]
public function min(Vec4 $a, Vec4 $b) : Vec4
{
    return Vec4(
        std::math::min($a->x, $b->x),
        std::math::min($a->y, $b->y),
        std::math::min($a->z, $b->z),
        std::math::min($a->w, $b->w)
    );
}

#[inline]
public function min(Vec4 $v, float32 $s) : Vec4
{
    return Vec4(
        std::math::min($v->x, $s),
        std::math::min($v->y, $s),
        std::math::min($v->z, $s),
        std::math::min($v->w, $s)
    );
}

#[inline]
public function max(Vec4 $a, Vec4 $b) : Vec4
{
    return Vec4(
        std::math::max($a->x, $b->x),
        std::math::max($a->y, $b->y),
        std::math::max($a->z, $b->z),
        std::math::max($a->w, $b->w)
    );
}

#[inline]
public function max(Vec4 $v, float32 $s) : Vec4
{
    return Vec4(
        std::math::max($v->x, $s),
        std::math::max($v->y, $s),
        std::math::max($v->z, $s),
        std::math::max($v->w, $s)
    );
}

#[inline]
public function clamp(Vec4 $v, Vec4 $lo, Vec4 $hi) : Vec4
{
    return Vec4(
        std::math::clamp($v->x, $lo->x, $hi->x),
        std::math::clamp($v->y, $lo->y, $hi->y),
        std::math::clamp($v->z, $lo->z, $hi->z),
        std::math::clamp($v->w, $lo->w, $hi->w)
    );
}

#[inline]
public function clamp(Vec4 $v, float32 $lo, float32 $hi) : Vec4
{
    return Vec4(
        std::math::clamp($v->x, $lo, $hi),
        std::math::clamp($v->y, $lo, $hi),
        std::math::clamp($v->z, $lo, $hi),
        std::math::clamp($v->w, $lo, $hi)
    );
}

#[inline]
public function reflect(Vec4 $incident, Vec4 $normal) : Vec4
{
    return $incident - $normal * (2.0f * dot($normal, $incident));
}

#[inline]
public function faceforward(Vec4 $n, Vec4 $incident, Vec4 $nref) : Vec4
{
    if (dot($nref, $incident) < 0.0f) {
        return $n;
    }

    return -$n;
}

#[inline]
public function refract(Vec4 $incident, Vec4 $normal, float32 $eta) : Vec4
{
    $dot = dot($normal, $incident);
    $k = 1.0f - $eta * $eta * (1.0f - $dot * $dot);

    if ($k < 0.0f) {
        return Vec4(0.0f);
    }

    return $incident * $eta - $normal * ($eta * $dot + std::math::sqrt($k));
}

#[inline]
public function equal(Vec4 $a, Vec4 $b, float32 $eps) : bool
{
    return equal($a->x, $b->x, $eps)
        && equal($a->y, $b->y, $eps)
        && equal($a->z, $b->z, $eps)
        && equal($a->w, $b->w, $eps);
}

#[inline]
public function equal(Vec4 $a, Vec4 $b) : bool
{
    return equal($a, $b, 0.0001f);
}

#[inline]
public function valuePtr(const Vec4& $v) : ptr<const float32>
{
    const float32& $first = &$v->x;

    return $first:$ as ptr<const float32>;
}

namespace str;

public function from(const visu::math::Vec4& $v) : string
{
    return "({$v->x}, {$v->y}, {$v->z}, {$v->w})";
}
