/**
 * `str::from` so `"{$v}"` works. Own file because a namespace is a
 * property of the file.
 */

namespace str;

public function from(const visu::math::Vec2& $v) : string
{
    return "({$v->x}, {$v->y})";
}

public function from(const visu::math::Vec3& $v) : string
{
    return "({$v->x}, {$v->y}, {$v->z})";
}

public function from(const visu::math::Vec4& $v) : string
{
    return "({$v->x}, {$v->y}, {$v->z}, {$v->w})";
}
