namespace visu::math;

public const float32 EPS = 0.0001f;

#[inline]
public function radians(float32 $degrees) : float32
{
    return $degrees * (std::math::PI_F32 / 180.0f);
}

#[inline]
public function degrees(float32 $radians) : float32
{
    return $radians * (180.0f / std::math::PI_F32);
}

#[inline]
public function equal(float32 $a, float32 $b, float32 $eps) : bool
{
    return std::math::abs($a - $b) <= $eps;
}

#[inline]
public function equal(float32 $a, float32 $b) : bool
{
    return equal($a, $b, EPS);
}
