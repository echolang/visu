namespace visu::math;

public struct Vec3
{
    public float32 $x;
    public float32 $y;
    public float32 $z;

    #[inline]
    public constructor(float32 $s)
    {
        $this->x = $s;
        $this->y = $s;
        $this->z = $s;
    }

    public constructor(float32 $x, float32 $y, float32 $z)
    {
        $this->x = $x;
        $this->y = $y;
        $this->z = $z;
    }

    #[inline]
    public constructor(Vec2 $xy, float32 $z)
    {
        $this->x = $xy->x;
        $this->y = $xy->y;
        $this->z = $z;
    }

    #[inline]
    public const function xy() : Vec2
    {
        return Vec2($this->x, $this->y);
    }
}

#[inline]
operator (Vec3 $a) + (Vec3 $b) : Vec3
{
    return Vec3($a->x + $b->x, $a->y + $b->y, $a->z + $b->z);
}

#[inline]
operator (Vec3 $a) - (Vec3 $b) : Vec3
{
    return Vec3($a->x - $b->x, $a->y - $b->y, $a->z - $b->z);
}

#[inline]
operator (Vec3 $a) * (Vec3 $b) : Vec3
{
    return Vec3($a->x * $b->x, $a->y * $b->y, $a->z * $b->z);
}

#[inline]
operator (Vec3 $a) / (Vec3 $b) : Vec3
{
    return Vec3($a->x / $b->x, $a->y / $b->y, $a->z / $b->z);
}

#[inline]
operator (Vec3 $a) + (float32 $s) : Vec3
{
    return Vec3($a->x + $s, $a->y + $s, $a->z + $s);
}

#[inline]
operator (float32 $s) + (Vec3 $a) : Vec3
{
    return $a + $s;
}

#[inline]
operator (Vec3 $a) - (float32 $s) : Vec3
{
    return Vec3($a->x - $s, $a->y - $s, $a->z - $s);
}

#[inline]
operator (float32 $s) - (Vec3 $a) : Vec3
{
    return Vec3($s - $a->x, $s - $a->y, $s - $a->z);
}

#[inline]
operator (Vec3 $a) * (float32 $s) : Vec3
{
    return Vec3($a->x * $s, $a->y * $s, $a->z * $s);
}

#[inline]
operator (float32 $s) * (Vec3 $a) : Vec3
{
    return $a * $s;
}

#[inline]
operator (Vec3 $a) / (float32 $s) : Vec3
{
    return Vec3($a->x / $s, $a->y / $s, $a->z / $s);
}

#[inline]
operator (float32 $s) / (Vec3 $a) : Vec3
{
    return Vec3($s / $a->x, $s / $a->y, $s / $a->z);
}

#[inline]
operator -(Vec3 $v) : Vec3
{
    return Vec3(-$v->x, -$v->y, -$v->z);
}

#[inline]
operator (Vec3 $a) == (Vec3 $b) : bool
{
    return $a->x == $b->x && $a->y == $b->y && $a->z == $b->z;
}

#[inline]
operator (Vec3 $a) != (Vec3 $b) : bool
{
    return !($a == $b);
}

#[inline]
operator (Vec3& $v)[usize $i] : float32&
{
    assert($i < 3, 'Vec3 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    if ($i == 1) {
        return &$v->y;
    }

    return &$v->z;
}

#[inline]
operator (const Vec3& $v)[usize $i] : const float32&
{
    assert($i < 3, 'Vec3 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    if ($i == 1) {
        return &$v->y;
    }

    return &$v->z;
}

#[inline]
public function dot(Vec3 $a, Vec3 $b) : float32
{
    return $a->x * $b->x + $a->y * $b->y + $a->z * $b->z;
}

#[inline]
public function cross(Vec3 $a, Vec3 $b) : Vec3
{
    return Vec3(
        $a->y * $b->z - $a->z * $b->y,
        $a->z * $b->x - $a->x * $b->z,
        $a->x * $b->y - $a->y * $b->x
    );
}

#[inline]
public function length2(Vec3 $v) : float32
{
    return dot($v, $v);
}

#[inline]
public function length(Vec3 $v) : float32
{
    return std::math::sqrt(length2($v));
}

#[inline]
public function distance2(Vec3 $a, Vec3 $b) : float32
{
    return length2($a - $b);
}

#[inline]
public function distance(Vec3 $a, Vec3 $b) : float32
{
    return length($a - $b);
}

#[inline]
public function normalize(Vec3 $v) : Vec3
{
    return $v / length($v);
}

#[inline]
public function mix(Vec3 $a, Vec3 $b, float32 $t) : Vec3
{
    return $a * (1.0f - $t) + $b * $t;
}

#[inline]
public function abs(Vec3 $v) : Vec3
{
    return Vec3(std::math::abs($v->x), std::math::abs($v->y), std::math::abs($v->z));
}

#[inline]
public function min(Vec3 $a, Vec3 $b) : Vec3
{
    return Vec3(
        std::math::min($a->x, $b->x),
        std::math::min($a->y, $b->y),
        std::math::min($a->z, $b->z)
    );
}

#[inline]
public function min(Vec3 $v, float32 $s) : Vec3
{
    return Vec3(
        std::math::min($v->x, $s),
        std::math::min($v->y, $s),
        std::math::min($v->z, $s)
    );
}

#[inline]
public function max(Vec3 $a, Vec3 $b) : Vec3
{
    return Vec3(
        std::math::max($a->x, $b->x),
        std::math::max($a->y, $b->y),
        std::math::max($a->z, $b->z)
    );
}

#[inline]
public function max(Vec3 $v, float32 $s) : Vec3
{
    return Vec3(
        std::math::max($v->x, $s),
        std::math::max($v->y, $s),
        std::math::max($v->z, $s)
    );
}

#[inline]
public function clamp(Vec3 $v, Vec3 $lo, Vec3 $hi) : Vec3
{
    return Vec3(
        std::math::clamp($v->x, $lo->x, $hi->x),
        std::math::clamp($v->y, $lo->y, $hi->y),
        std::math::clamp($v->z, $lo->z, $hi->z)
    );
}

#[inline]
public function clamp(Vec3 $v, float32 $lo, float32 $hi) : Vec3
{
    return Vec3(
        std::math::clamp($v->x, $lo, $hi),
        std::math::clamp($v->y, $lo, $hi),
        std::math::clamp($v->z, $lo, $hi)
    );
}

#[inline]
public function reflect(Vec3 $incident, Vec3 $normal) : Vec3
{
    return $incident - $normal * (2.0f * dot($normal, $incident));
}

#[inline]
public function faceforward(Vec3 $n, Vec3 $incident, Vec3 $nref) : Vec3
{
    if (dot($nref, $incident) < 0.0f) {
        return $n;
    }

    return -$n;
}

#[inline]
public function refract(Vec3 $incident, Vec3 $normal, float32 $eta) : Vec3
{
    $dot = dot($normal, $incident);
    $k = 1.0f - $eta * $eta * (1.0f - $dot * $dot);

    if ($k < 0.0f) {
        return Vec3(0.0f);
    }

    return $incident * $eta - $normal * ($eta * $dot + std::math::sqrt($k));
}

#[inline]
public function equal(Vec3 $a, Vec3 $b, float32 $eps) : bool
{
    return equal($a->x, $b->x, $eps) && equal($a->y, $b->y, $eps) && equal($a->z, $b->z, $eps);
}

#[inline]
public function equal(Vec3 $a, Vec3 $b) : bool
{
    return equal($a, $b, EPS);
}

#[inline]
public function valuePtr(const Vec3& $v) : ptr<const float32>
{
    const float32& $first = &$v->x;

    return $first:$ as ptr<const float32>;
}
