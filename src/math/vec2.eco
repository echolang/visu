namespace visu::math;

public struct Vec2
{
    public float32 $x;
    public float32 $y;

    #[inline]
    public constructor(float32 $s)
    {
        $this->x = $s;
        $this->y = $s;
    }

    public constructor(float32 $x, float32 $y)
    {
        $this->x = $x;
        $this->y = $y;
    }
}

#[inline]
operator (Vec2 $a) + (Vec2 $b) : Vec2
{
    return Vec2($a->x + $b->x, $a->y + $b->y);
}

#[inline]
operator (Vec2 $a) - (Vec2 $b) : Vec2
{
    return Vec2($a->x - $b->x, $a->y - $b->y);
}

#[inline]
operator (Vec2 $a) * (Vec2 $b) : Vec2
{
    return Vec2($a->x * $b->x, $a->y * $b->y);
}

#[inline]
operator (Vec2 $a) / (Vec2 $b) : Vec2
{
    return Vec2($a->x / $b->x, $a->y / $b->y);
}

#[inline]
operator (Vec2 $a) + (float32 $s) : Vec2
{
    return Vec2($a->x + $s, $a->y + $s);
}

#[inline]
operator (float32 $s) + (Vec2 $a) : Vec2
{
    return $a + $s;
}

#[inline]
operator (Vec2 $a) - (float32 $s) : Vec2
{
    return Vec2($a->x - $s, $a->y - $s);
}

#[inline]
operator (float32 $s) - (Vec2 $a) : Vec2
{
    return Vec2($s - $a->x, $s - $a->y);
}

#[inline]
operator (Vec2 $a) * (float32 $s) : Vec2
{
    return Vec2($a->x * $s, $a->y * $s);
}

#[inline]
operator (float32 $s) * (Vec2 $a) : Vec2
{
    return $a * $s;
}

#[inline]
operator (Vec2 $a) / (float32 $s) : Vec2
{
    return Vec2($a->x / $s, $a->y / $s);
}

#[inline]
operator (float32 $s) / (Vec2 $a) : Vec2
{
    return Vec2($s / $a->x, $s / $a->y);
}

#[inline]
operator -(Vec2 $v) : Vec2
{
    return Vec2(-$v->x, -$v->y);
}

#[inline]
operator (Vec2 $a) == (Vec2 $b) : bool
{
    return $a->x == $b->x && $a->y == $b->y;
}

#[inline]
operator (Vec2 $a) != (Vec2 $b) : bool
{
    return !($a == $b);
}

#[inline]
operator (Vec2& $v)[usize $i] : float32&
{
    assert($i < 2, 'Vec2 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    return &$v->y;
}

#[inline]
operator (const Vec2& $v)[usize $i] : const float32&
{
    assert($i < 2, 'Vec2 index out of range');

    if ($i == 0) {
        return &$v->x;
    }

    return &$v->y;
}

#[inline]
public function dot(Vec2 $a, Vec2 $b) : float32
{
    return $a->x * $b->x + $a->y * $b->y;
}

#[inline]
public function length2(Vec2 $v) : float32
{
    return dot($v, $v);
}

#[inline]
public function length(Vec2 $v) : float32
{
    return std::math::sqrt(length2($v));
}

#[inline]
public function distance2(Vec2 $a, Vec2 $b) : float32
{
    return length2($a - $b);
}

#[inline]
public function distance(Vec2 $a, Vec2 $b) : float32
{
    return length($a - $b);
}

#[inline]
public function normalize(Vec2 $v) : Vec2
{
    return $v / length($v);
}

#[inline]
public function mix(Vec2 $a, Vec2 $b, float32 $t) : Vec2
{
    return $a * (1.0f - $t) + $b * $t;
}

#[inline]
public function abs(Vec2 $v) : Vec2
{
    return Vec2(std::math::abs($v->x), std::math::abs($v->y));
}

#[inline]
public function min(Vec2 $a, Vec2 $b) : Vec2
{
    return Vec2(std::math::min($a->x, $b->x), std::math::min($a->y, $b->y));
}

#[inline]
public function min(Vec2 $v, float32 $s) : Vec2
{
    return Vec2(std::math::min($v->x, $s), std::math::min($v->y, $s));
}

#[inline]
public function max(Vec2 $a, Vec2 $b) : Vec2
{
    return Vec2(std::math::max($a->x, $b->x), std::math::max($a->y, $b->y));
}

#[inline]
public function max(Vec2 $v, float32 $s) : Vec2
{
    return Vec2(std::math::max($v->x, $s), std::math::max($v->y, $s));
}

#[inline]
public function clamp(Vec2 $v, Vec2 $lo, Vec2 $hi) : Vec2
{
    return Vec2(
        std::math::clamp($v->x, $lo->x, $hi->x),
        std::math::clamp($v->y, $lo->y, $hi->y)
    );
}

#[inline]
public function clamp(Vec2 $v, float32 $lo, float32 $hi) : Vec2
{
    return Vec2(
        std::math::clamp($v->x, $lo, $hi),
        std::math::clamp($v->y, $lo, $hi)
    );
}

#[inline]
public function reflect(Vec2 $incident, Vec2 $normal) : Vec2
{
    return $incident - $normal * (2.0f * dot($normal, $incident));
}

#[inline]
public function faceforward(Vec2 $n, Vec2 $incident, Vec2 $nref) : Vec2
{
    if (dot($nref, $incident) < 0.0f) {
        return $n;
    }

    return -$n;
}

#[inline]
public function refract(Vec2 $incident, Vec2 $normal, float32 $eta) : Vec2
{
    $dot = dot($normal, $incident);
    $k = 1.0f - $eta * $eta * (1.0f - $dot * $dot);

    if ($k < 0.0f) {
        return Vec2(0.0f);
    }

    return $incident * $eta - $normal * ($eta * $dot + std::math::sqrt($k));
}

#[inline]
public function equal(Vec2 $a, Vec2 $b, float32 $eps) : bool
{
    return equal($a->x, $b->x, $eps) && equal($a->y, $b->y, $eps);
}

#[inline]
public function equal(Vec2 $a, Vec2 $b) : bool
{
    return equal($a, $b, EPS);
}

#[inline]
public function valuePtr(const Vec2& $v) : ptr<const float32>
{
    const float32& $first = &$v->x;

    return $first:$ as ptr<const float32>;
}
