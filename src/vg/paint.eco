/**
 * Fill / stroke paint: solid colour, linear / radial / box
 * gradient, or alpha-atlas text.
 */

namespace visu::vg;

use visu::math::Vec2;

public enum PaintKind
{
    case color;
    case linear;
    case radial;
    case box;
    case alpha;
}

public struct Paint
{
    public PaintKind $kind;
    public Color $inner;
    public Color $outer;
    public Xform $xform;
    public Vec2 $extent;
    public float32 $radius;
    public float32 $feather;

    public constructor()
    {
        $this->kind = .color;
        $this->inner = Color::white();
        $this->outer = Color::white();
        $this->xform = Xform();
        $this->extent = Vec2(0.0f, 0.0f);
        $this->radius = 0.0f;
        $this->feather = 1.0f;
    }

    public constructor(Color $color)
    {
        $this->kind = .color;
        $this->inner = $color;
        $this->outer = $color;
        $this->xform = Xform();
        $this->extent = Vec2(0.0f, 0.0f);
        $this->radius = 0.0f;
        $this->feather = 1.0f;
    }
}
