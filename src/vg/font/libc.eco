/**
 * stb_truetype shim. Raw C symbols, not public — Font wraps them.
 */

namespace visu::vg;

extern struct VgFont;

internal extern {
    function vg_font_load(ptr<const uint8> $ttf, int32 $bytes) : ptr<VgFont>;
    function vg_font_free(ptr<VgFont> $font) : void;
    function vg_font_metrics(
        ptr<VgFont> $font,
        float32 $size,
        ptr<float32> $ascent,
        ptr<float32> $descent,
        ptr<float32> $lineh
    ) : void;
    function vg_font_glyph(
        ptr<VgFont> $font,
        int32 $cp,
        float32 $size,
        ptr<int32> $w,
        ptr<int32> $h,
        ptr<int32> $xoff,
        ptr<int32> $yoff,
        ptr<float32> $advance
    ) : int32;
    function vg_font_raster(
        ptr<VgFont> $font,
        int32 $cp,
        float32 $size,
        ptr<uint8> $out,
        int32 $stride
    ) : int32;
    function vg_font_kern(ptr<VgFont> $font, int32 $a, int32 $b, float32 $size) : float32;
}
