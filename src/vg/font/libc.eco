/**
 * stb_truetype shim. Raw C symbols, not public — Font wraps them.
 */

namespace visu::vg;

extern struct VgFont;

internal struct VgFontLayout
{
    public int32 $ascent = 0;
    public int32 $descent = 0;
    public int32 $lineGap = 0;
    public int32 $unitsPerEm = 0;
    public int32 $glyphCount = 0;
    public int32 $kernPairCount = 0;
    public int32 $class1Count = 0;
    public int32 $class2Count = 0;
    public int32 $hasClassKern = 0;
    public int32 $hiCount = 0;
}

internal extern {
    function vg_font_load(ptr<const uint8> $ttf, int32 $bytes) : ptr<VgFont>;
    function vg_font_free(ptr<VgFont> $font) : void;
    function vg_font_layout(ptr<VgFont> $font, ptr<VgFontLayout> $out) : void;
    function vg_font_copy_cmap(ptr<VgFont> $font, ptr<int32> $out, int32 $cap) : int32;
    function vg_font_copy_advance(ptr<VgFont> $font, ptr<int32> $out, int32 $cap) : int32;
    function vg_font_copy_kern(
        ptr<VgFont> $font,
        ptr<uint64> $keys,
        ptr<int32> $vals,
        int32 $cap
    ) : int32;
    function vg_font_copy_class1(ptr<VgFont> $font, ptr<int32> $out, int32 $cap) : int32;
    function vg_font_copy_class2(ptr<VgFont> $font, ptr<int32> $out, int32 $cap) : int32;
    function vg_font_copy_class_matrix(ptr<VgFont> $font, ptr<int32> $out, int32 $cap) : int32;
    function vg_font_copy_cmap_hi(
        ptr<VgFont> $font,
        ptr<int32> $starts,
        ptr<int32> $ends,
        ptr<int32> $glyphs,
        int32 $cap
    ) : int32;
    function vg_font_drop_layout(ptr<VgFont> $font) : void;
    function vg_font_glyph(
        ptr<VgFont> $font,
        int32 $glyph,
        float32 $size,
        ptr<int32> $w,
        ptr<int32> $h,
        ptr<int32> $xoff,
        ptr<int32> $yoff
    ) : int32;
    function vg_font_raster(
        ptr<VgFont> $font,
        int32 $glyph,
        float32 $size,
        ptr<uint8> $out,
        int32 $stride
    ) : int32;
}
