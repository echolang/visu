/**
 * Packed GPU vertex and the CPU tessellation output.
 * `uv.x` is coverage (1 interior, 0 on the AA fringe) when `shape.w` is 0.
 * SDF boxes store local p in `uv` and extents in `shape`.
 */

namespace visu::vg;

use visu::math::{Vec2, Vec4};

public struct VgVertex
{
    public Vec2 $pos;
    public Vec2 $uv;
    public Vec4 $shape = Vec4(0.0f);
}

public struct Contour
{
    public array<Vec2> $pts;
    public bool $closed;
    public Winding $winding;

    public constructor()
    {
        $this->pts = array<Vec2>();
        $this->closed = false;
        $this->winding = .ccw;
    }
}

public struct TessMesh
{
    public array<VgVertex> $verts;
    public array<uint32> $indices;

    public constructor()
    {
        $this->verts = array<VgVertex>();
        $this->indices = array<uint32>();
    }

    public function clear() : void
    {
        $this->verts->clear();
        $this->indices->clear();
    }
}
