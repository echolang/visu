/**
 * Loaded TTF plus a packed r8 atlas.
 * Raster lives in C (stb_truetype); packing and the GPU texture stay in Echo.
 */

namespace visu::vg;

use visu::geo::AABB2D;
use visu::graphics::{
    Device, PixelFormat, ResourceState, Texture, TextureDesc
};
use visu::math::Vec2;

internal const int32 FONT_ATLAS = 512;
internal const int32 FONT_ATLAS_MAX = 2048;
internal const int32 FONT_PAD = 1;
internal const int32 FONT_CMAP = 65536;

internal struct Glyph
{
    public int32 $w = 0;
    public int32 $h = 0;
    public int32 $xoff = 0;
    public int32 $yoff = 0;
    public float32 $advance = 0.0f;
    public int32 $atlasX = 0;
    public int32 $atlasY = 0;
    public bool $packed = false;
}

internal struct CmapHiRange
{
    public int32 $start = 0;
    public int32 $end = 0;
    public int32 $startGlyph = 0;
}

internal struct FontMetrics
{
    public float32 $ascent = 0.0f;
    public float32 $descent = 0.0f;
    public float32 $lineh = 0.0f;
}

/**
 * One face.
 * Canvas owns these by name; the handle is what `fontFace` stores on the state stack.
 */
public class Font
{
    public const string $name;
    public Device $device;
    internal string $bytes;
    internal ptr<VgFont> $raw;
    internal map<uint64, Glyph> $glyphs;
    internal array<int32> $cmap;
    internal array<int32> $advance;
    internal map<uint64, int32> $kern;
    internal array<CmapHiRange> $cmapHi;
    internal array<int32> $class1;
    internal array<int32> $class2;
    internal array<int32> $classMatrix;
    internal int32 $class2Count;
    internal int32 $rawAscent;
    internal int32 $rawDescent;
    internal int32 $rawLineGap;
    internal bool $hasKern;
    internal bool $hasClassKern;
    internal Texture? $atlas;
    internal array<uint8> $pixels;
    internal int32 $atlasW;
    internal int32 $atlasH;
    internal int32 $packX;
    internal int32 $packY;
    internal int32 $rowH;
    internal bool $dirty;
    internal bool $overflow;
    private bool $dead;

    internal constructor(Device $device, string $name, string $bytes, ptr<VgFont> $raw)
    {
        $this->device = $device;
        $this->name = $name;
        $this->bytes = $bytes;
        $this->raw = $raw;
        $this->glyphs = map<uint64, Glyph>();
        $this->cmap = array<int32>();
        $this->advance = array<int32>();
        $this->kern = map<uint64, int32>();
        $this->cmapHi = array<CmapHiRange>();
        $this->class1 = array<int32>();
        $this->class2 = array<int32>();
        $this->classMatrix = array<int32>();
        $this->class2Count = 0;
        $this->rawAscent = 0;
        $this->rawDescent = 0;
        $this->rawLineGap = 0;
        $this->hasKern = false;
        $this->hasClassKern = false;
        $this->atlas = null;
        $this->pixels = array<uint8>();
        $this->atlasW = FONT_ATLAS;
        $this->atlasH = FONT_ATLAS;
        $this->packX = FONT_PAD;
        $this->packY = FONT_PAD;
        $this->rowH = 0;
        $this->dirty = false;
        $this->overflow = false;
        $this->dead = false;
    }

    destructor()
    {
        $this->destroy();
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;

        if ($this->raw != null) {
            vg_font_free($this->raw);
            $this->raw:$ = null;
        }

        Texture? $atlas = $this->atlas;

        if ($atlas != null) {
            Texture $tex = guard $atlas;
            $tex->destroy();
            $this->atlas = null;
        }
    }
}

internal function fontLoad(Device $device, string $name, string $bytes) : result<Font, VgError>
{
    ptr<const uint8> $data = $bytes->data();

    if ($bytes->size() == 0 || $data:$ == null) {
        return .error(.fontParse);
    }

    ptr<VgFont> $raw = vg_font_load($data, $bytes->size() as int32);

    if ($raw == null) {
        return .error(.fontParse);
    }

    Font $font = Font($device, $name, $bytes, $raw);
    fontTakeLayout($font);
    return .ok($font);
}

internal function fontTakeLayout(Font $font) : void
{
    if ($font->raw == null) {
        return;
    }

    VgFontLayout $info = VgFontLayout();
    vg_font_layout($font->raw, &$info);
    $font->rawAscent = $info->ascent;
    $font->rawDescent = $info->descent;
    $font->rawLineGap = $info->lineGap;
    $font->cmap = takeI32($font->raw, FONT_CMAP, true);
    $font->advance = takeI32($font->raw, $info->glyphCount, false);
    takeKern($font, $info);
    takeClassKern($font, $info);
    takeCmapHi($font, $info);
    $font->hasKern = $font->kern->count() > 0 || $font->hasClassKern;
    vg_font_drop_layout($font->raw);
}

internal function takeI32(ptr<VgFont> $raw, int32 $n, bool $cmap) : array<int32>
{
    if ($n <= 0) {
        return array<int32>();
    }

    usize $cap = $n as usize;
    array<int32> $out = arr::room<int32>($cap);
    ptr<int32> $p = $out->spare();

    if ($p:$ == null) {
        return array<int32>();
    }

    int32 $got = 0;

    if ($cmap) {
        $got = vg_font_copy_cmap($raw, $p, $n);
    } else {
        $got = vg_font_copy_advance($raw, $p, $n);
    }

    if ($got < 0) {
        $got = 0;
    }

    $out->commit($got as usize);
    return $out;
}

internal function takeClass(ptr<VgFont> $raw, int32 $n, int32 $which) : array<int32>
{
    if ($n <= 0) {
        return array<int32>();
    }

    usize $cap = $n as usize;
    array<int32> $out = arr::room<int32>($cap);
    ptr<int32> $p = $out->spare();

    if ($p:$ == null) {
        return array<int32>();
    }

    int32 $got = 0;

    if ($which == 1) {
        $got = vg_font_copy_class1($raw, $p, $n);
    } else if ($which == 2) {
        $got = vg_font_copy_class2($raw, $p, $n);
    } else {
        $got = vg_font_copy_class_matrix($raw, $p, $n);
    }

    if ($got < 0) {
        $got = 0;
    }

    $out->commit($got as usize);
    return $out;
}

internal function takeKern(Font $font, const VgFontLayout& $info) : void
{
    int32 $n = $info->kernPairCount;

    if ($n <= 0 || $font->raw == null) {
        return;
    }

    usize $cap = $n as usize;
    array<uint64> $keys = arr::room<uint64>($cap);
    array<int32> $vals = arr::room<int32>($cap);
    ptr<uint64> $pk = $keys->spare();
    ptr<int32> $pv = $vals->spare();

    if ($pk:$ == null || $pv:$ == null) {
        return;
    }

    int32 $got = vg_font_copy_kern($font->raw, $pk, $pv, $n);

    if ($got <= 0) {
        return;
    }

    $keys->commit($got as usize);
    $vals->commit($got as usize);
    int32 $i = 0;

    while ($i < $got) {
        uint64 $k = $keys[$i as usize];

        if (!$font->kern->has($k)) {
            $font->kern[$k] = $vals[$i as usize];
        }

        $i = $i + 1;
    }
}

internal function takeClassKern(Font $font, const VgFontLayout& $info) : void
{
    if ($info->hasClassKern == 0 || $info->glyphCount <= 0 || $font->raw == null) {
        return;
    }

    int32 $cells = $info->class1Count * $info->class2Count;
    $font->class1 = takeClass($font->raw, $info->glyphCount, 1);
    $font->class2 = takeClass($font->raw, $info->glyphCount, 2);
    $font->classMatrix = takeClass($font->raw, $cells, 0);
    $font->class2Count = $info->class2Count;
    $font->hasClassKern = $font->class1->count() > 0
        && $font->class2->count() > 0
        && $font->classMatrix->count() > 0
        && $font->class2Count > 0;
}

internal function takeCmapHi(Font $font, const VgFontLayout& $info) : void
{
    int32 $n = $info->hiCount;

    if ($n <= 0 || $font->raw == null) {
        return;
    }

    usize $cap = $n as usize;
    array<int32> $starts = arr::room<int32>($cap);
    array<int32> $ends = arr::room<int32>($cap);
    array<int32> $glyphs = arr::room<int32>($cap);
    ptr<int32> $ps = $starts->spare();
    ptr<int32> $pe = $ends->spare();
    ptr<int32> $pg = $glyphs->spare();

    if ($ps:$ == null || $pe:$ == null || $pg:$ == null) {
        return;
    }

    int32 $got = vg_font_copy_cmap_hi($font->raw, $ps, $pe, $pg, $n);

    if ($got <= 0) {
        return;
    }

    $starts->commit($got as usize);
    $ends->commit($got as usize);
    $glyphs->commit($got as usize);
    int32 $i = 0;

    while ($i < $got) {
        usize $u = $i as usize;
        CmapHiRange $r = CmapHiRange();
        $r->start = $starts[$u];
        $r->end = $ends[$u];
        $r->startGlyph = $glyphs[$u];
        $font->cmapHi[] = $r;
        $i = $i + 1;
    }
}

internal function fontScale(Font $font, float32 $px) : float32
{
    int32 $h = $font->rawAscent - $font->rawDescent;

    if ($h <= 0) {
        return 0.0f;
    }

    return $px / ($h as float32);
}

internal function fontIndex(Font $font, int32 $cp) : int32
{
    if ($cp < 0) {
        return 0;
    }

    if ($cp < FONT_CMAP) {
        usize $i = $cp as usize;

        if ($i >= $font->cmap->count()) {
            return 0;
        }

        return $font->cmap[$i];
    }

    int32 $n = $font->cmapHi->count();
    int32 $i = 0;

    while ($i < $n) {
        CmapHiRange $r = $font->cmapHi[$i as usize];

        if ($cp >= $r->start && $cp <= $r->end) {
            return $r->startGlyph + ($cp - $r->start);
        }

        $i = $i + 1;
    }

    return 0;
}

internal function fontKern(Font $font, int32 $g1, int32 $g2) : int32
{
    if (!$font->hasKern) {
        return 0;
    }

    uint64 $hi = $g1 as uint64;
    uint64 $lo = $g2 as uint64;
    uint64 $key = ($hi << 32) | $lo;

    if ($font->kern->has($key)) {
        return $font->kern[$key];
    }

    if (!$font->hasClassKern) {
        return 0;
    }

    usize $i1 = $g1 as usize;
    usize $i2 = $g2 as usize;

    if ($i1 >= $font->class1->count() || $i2 >= $font->class2->count()) {
        return 0;
    }

    int32 $c1 = $font->class1[$i1];

    if ($c1 < 0) {
        return 0;
    }

    int32 $c2 = $font->class2[$i2];
    int32 $idx = $c1 * $font->class2Count + $c2;

    if ($idx < 0 || ($idx as usize) >= $font->classMatrix->count()) {
        return 0;
    }

    return $font->classMatrix[$idx as usize];
}

internal function fontAdvance(Font $font, int32 $glyph, float32 $scale) : float32
{
    if ($glyph < 0) {
        return 0.0f;
    }

    usize $i = $glyph as usize;

    if ($i >= $font->advance->count()) {
        return 0.0f;
    }

    return ($font->advance[$i] as float32) * $scale;
}

internal function fontMetrics(Font $font, float32 $px) : FontMetrics
{
    FontMetrics $m = FontMetrics();
    float32 $s = fontScale($font, $px);
    $m->ascent = ($font->rawAscent as float32) * $s;
    $m->descent = ($font->rawDescent as float32) * $s;
    int32 $line = $font->rawAscent - $font->rawDescent + $font->rawLineGap;
    $m->lineh = ($line as float32) * $s;
    return $m;
}

internal function fontGlyph(Font $font, int32 $cp, float32 $px) : Glyph
{
    uint64 $key = glyphKey($cp, $px);

    if ($font->glyphs->has($key)) {
        return $font->glyphs[$key];
    }

    Glyph $g = Glyph();
    int32 $glyph = fontIndex($font, $cp);
    float32 $scale = fontScale($font, $px);
    $g->advance = fontAdvance($font, $glyph, $scale);

    if ($font->raw == null) {
        $font->glyphs[$key] = $g;
        return $g;
    }

    int32 $ok = vg_font_glyph(
        $font->raw,
        $glyph,
        $px,
        &$g->w,
        &$g->h,
        &$g->xoff,
        &$g->yoff
    );

    if ($ok == 0) {
        $font->glyphs[$key] = $g;
        return $g;
    }

    $font->glyphs[$key] = $g;
    return $g;
}

internal function fontPack(Font $font, int32 $cp, float32 $px) : Glyph
{
    Glyph $g = fontGlyph($font, $cp, $px);

    if ($g->packed || $g->w <= 0 || $g->h <= 0) {
        return $g;
    }

    fontEnsureAtlas($font);

    if (!fontPlace($font, $g)) {
        $font->overflow = true;
        return $g;
    }

    usize $n = ($g->w * $g->h) as usize;
    array<uint8> $bitmap = arr::room<uint8>($n);
    ptr<uint8> $dst = $bitmap->spare();

    if ($dst:$ != null) {
        vg_font_raster($font->raw, fontIndex($font, $cp), $px, $dst, $g->w);
        $bitmap->commit($n);
        fontBlit($font, $g, $bitmap);
    }

    $g->packed = true;
    $font->glyphs[glyphKey($cp, $px)] = $g;
    $font->dirty = true;
    return $g;
}

internal function fontSync(Font $font) : void
{
    if (!$font->dirty) {
        return;
    }

    Texture? $maybe = $font->atlas;
    Texture $tex = guard $maybe else {
        return;
    }
    usize $n = $font->pixels->count();
    ptr<uint8> $pixels = $font->pixels->data();

    if ($n == 0 || $pixels:$ == null) {
        $font->dirty = false;
        return;
    }

    $tex->upload(0, $pixels, $n as uint64, $font->atlasW);
    $font->device->transitionTexture($tex, ResourceState::shaderRead);
    $font->dirty = false;
}

internal function fontEnsureAtlas(Font $font) : void
{
    if ($font->atlas != null) {
        return;
    }

    int32 $w = $font->atlasW;
    int32 $h = $font->atlasH;
    usize $n = ($w * $h) as usize;
    $font->pixels = arr::room<uint8>($n);
    ptr<uint8> $p = $font->pixels->spare();

    if ($p:$ != null) {
        mem::zero<uint8>($p, $n);
        $font->pixels->commit($n);
    }

    TextureDesc $desc = TextureDesc($format: .r8, $width: $w, $height: $h);
    Texture $tex = Texture($font->device, "vg-font-{$font->name}", $desc);
    $font->atlas = $tex;
    $font->dirty = true;
}

internal function fontResetAtlas(Font $font) : void
{
    $font->glyphs->clear();
    $font->packX = FONT_PAD;
    $font->packY = FONT_PAD;
    $font->rowH = 0;
    usize $n = $font->pixels->count();

    ptr<uint8> $pixels = $font->pixels->data();

    if ($n > 0 && $pixels:$ != null) {
        mem::zero<uint8>($pixels, $n);
    }

    $font->dirty = true;
}

internal function fontHandleOverflow(Font $font) : void
{
    if (!$font->overflow) {
        return;
    }

    $font->overflow = false;

    if ($font->atlasW < FONT_ATLAS_MAX) {
        int32 $next = $font->atlasW * 2;

        if ($next > FONT_ATLAS_MAX) {
            $next = FONT_ATLAS_MAX;
        }

        $font->atlasW = $next;
        $font->atlasH = $next;
    }

    Texture? $old = $font->atlas;

    if ($old != null) {
        Texture $tex = guard $old;
        $tex->destroy();
        $font->atlas = null;
    }

    $font->pixels = array<uint8>();
    fontResetAtlas($font);
}

internal function fontPlace(Font $font, Glyph& $g) : bool
{
    int32 $bw = $g->w + FONT_PAD;
    int32 $bh = $g->h + FONT_PAD;

    if ($bw > $font->atlasW || $bh > $font->atlasH) {
        return false;
    }

    if ($font->packX + $bw > $font->atlasW) {
        $font->packX = FONT_PAD;
        $font->packY = $font->packY + $font->rowH + FONT_PAD;
        $font->rowH = 0;
    }

    if ($font->packY + $bh > $font->atlasH) {
        return false;
    }

    $g->atlasX = $font->packX;
    $g->atlasY = $font->packY;
    $font->packX = $font->packX + $bw;

    if ($g->h > $font->rowH) {
        $font->rowH = $g->h;
    }

    return true;
}

internal function fontBlit(Font $font, const Glyph& $g, array<uint8>& $bitmap) : void
{
    ptr<uint8> $baseDst = $font->pixels->data();
    ptr<uint8> $baseSrc = $bitmap->data();

    if ($baseDst:$ == null || $baseSrc:$ == null) {
        return;
    }

    int32 $row = 0;

    while ($row < $g->h) {
        usize $dstOff = (($g->atlasY + $row) * $font->atlasW + $g->atlasX) as usize;
        usize $srcOff = ($row * $g->w) as usize;
        ptr<uint8> $dst = $baseDst;
        ptr<uint8> $src = $baseSrc;
        $dst:$ = $baseDst:$ + ($dstOff as isize);
        $src:$ = $baseSrc:$ + ($srcOff as isize);
        mem::copy<uint8>($dst, $src, $g->w as usize);
        $row = $row + 1;
    }
}

internal function quantizePx(float32 $px) : float32
{
    float32 $q = $px * 4.0f + 0.5f;
    int32 $n = $q as int32;

    if ($n < 1) {
        $n = 1;
    }

    float32 $f = $n as float32;
    return $f * 0.25f;
}

internal function snapPt(float32 $v, float32 $scale) : float32
{
    return std::math::floor($v * $scale + 0.5f) / $scale;
}

internal function glyphKey(int32 $cp, float32 $px) : uint64
{
    float32 $qpx = $px * 4.0f + 0.5f;
    int32 $q = $qpx as int32;

    if ($q < 1) {
        $q = 1;
    }

    uint64 $hi = $cp as uint64;
    uint64 $lo = $q as uint64;
    return ($hi << 32) | $lo;
}

internal function utf8Next(const string& $s, usize& $i) : int32
{
    usize $n = $s->size();

    if ($i >= $n) {
        return 0;
    }

    uint8 $b0 = $s->byte($i);
    $i = $i + 1;

    if ($b0 < 128) {
        return $b0 as int32;
    }

    if ($b0 < 194 || $i >= $n) {
        return $b0 as int32;
    }

    if ($b0 < 224) {
        uint8 $b1 = $s->byte($i);
        $i = $i + 1;
        return ((($b0 as int32) & 31) << 6) | (($b1 as int32) & 63);
    }

    if ($b0 < 240 && $i + 1 < $n) {
        uint8 $b1 = $s->byte($i);
        uint8 $b2 = $s->byte($i + 1);
        $i = $i + 2;
        return ((($b0 as int32) & 15) << 12)
            | ((($b1 as int32) & 63) << 6)
            | (($b2 as int32) & 63);
    }

    if ($i + 2 < $n) {
        uint8 $b1 = $s->byte($i);
        uint8 $b2 = $s->byte($i + 1);
        uint8 $b3 = $s->byte($i + 2);
        $i = $i + 3;
        return ((($b0 as int32) & 7) << 18)
            | ((($b1 as int32) & 63) << 12)
            | ((($b2 as int32) & 63) << 6)
            | (($b3 as int32) & 63);
    }

    return $b0 as int32;
}

internal function textWidth(Font $font, float32 $px, const string& $s) : float32
{
    return textWidthRange($font, $px, $s, 0, $s->size());
}

/**
 * Width of the bytes `[from, to)`. `to` must end on a character boundary.
 */
internal function textWidthRange(
    Font $font,
    float32 $px,
    const string& $s,
    usize $from,
    usize $to,
    bool $upper = false
) : float32
{
    float32 $scale = fontScale($font, $px);
    float32 $pen = 0.0f;
    int32 $prev = -1;
    usize $i = $from;
    usize $n = $to;

    while ($i < $n) {
        int32 $cp = utf8Next($s, $i);

        if ($cp <= 0) {
            continue;
        }

        if ($upper) {
            $cp = asciiUpper($cp);
        }

        int32 $g = fontIndex($font, $cp);

        if ($prev >= 0) {
            $pen = $pen + (fontKern($font, $prev, $g) as float32) * $scale;
        }

        $pen = $pen + fontAdvance($font, $g, $scale);
        $prev = $g;
    }

    return $pen;
}

internal struct TextLayout
{
    public float32 $advance;
    public AABB2D $bounds;
}

internal function emitText(Canvas $vg, Vec2 $pos, const string& $s, bool $draw) : float32
{
    TextLayout $layout = layoutText($vg, $pos, $s, $draw);
    return $layout->advance;
}

internal function layoutText(Canvas $vg, Vec2 $pos, const string& $s, bool $draw) : TextLayout
{
    TextLayout $out = TextLayout(0.0f, AABB2D($pos, $pos));
    Font? $maybe = $vg->state->font;
    Font $font = guard $maybe else {
        return $out;
    }

    if ($s->size() == 0) {
        return $out;
    }

    float32 $scale = tessScale($vg->state->xform);
    float32 $px = quantizePx($vg->state->fontSize * $scale);
    float32 $fs = fontScale($font, $px);
    float32 $inv = 1.0f / $scale;
    FontMetrics $m = fontMetrics($font, $px);
    float32 $widthPx = 0.0f;
    float32 $originX = $pos->x;
    float32 $originY = $pos->y;
    bool $needWidth = $vg->state->align->h != HAlign::left;

    if ($needWidth) {
        $widthPx = textWidth($font, $px, $s);
    }

    match ($vg->state->align->h) {
        HAlign::left => {
        },
        HAlign::center => {
            $originX = $originX - $widthPx * $inv * 0.5f;
        },
        HAlign::right => {
            $originX = $originX - $widthPx * $inv;
        },
    };

    match ($vg->state->align->v) {
        VAlign::baseline => {
        },
        VAlign::top => {
            $originY = $originY + $m->ascent * $inv;
        },
        VAlign::middle => {
            $originY = $originY + ($m->ascent + $m->descent) * 0.5f * $inv;
        },
        VAlign::bottom => {
            $originY = $originY + $m->descent * $inv;
        },
    };

    $originX = snapPt($originX, $scale);
    $originY = snapPt($originY, $scale);
    float32 $pen = 0.0f;
    int32 $prev = -1;
    usize $i = 0;
    usize $n = $s->size();
    bool $any = false;
    float32 $minX = $originX;
    float32 $minY = $originY;
    float32 $maxX = $originX;
    float32 $maxY = $originY;
    int32 $first = $vg->mesh->indices->count() as int32;
    Xform $xf = $vg->state->xform;
    float32 $aw = $font->atlasW as float32;
    float32 $ah = $font->atlasH as float32;

    if ($aw < 1.0f) {
        $aw = 1.0f;
    }

    if ($ah < 1.0f) {
        $ah = 1.0f;
    }

    while ($i < $n) {
        int32 $cp = utf8Next($s, $i);

        if ($cp <= 0) {
            continue;
        }

        int32 $gi = fontIndex($font, $cp);

        if ($prev >= 0) {
            $pen = $pen + (fontKern($font, $prev, $gi) as float32) * $fs;
        }

        Glyph $g = fontGlyph($font, $cp, $px);

        if ($draw) {
            $g = fontPack($font, $cp, $px);
        }

        float32 $x0 = snapPt($originX + ($pen + ($g->xoff as float32)) * $inv, $scale);
        float32 $y0 = snapPt($originY + ($g->yoff as float32) * $inv, $scale);
        float32 $x1 = $x0 + ($g->w as float32) * $inv;
        float32 $y1 = $y0 + ($g->h as float32) * $inv;

        if ($g->w > 0 && $g->h > 0) {
            if (!$any) {
                $minX = $x0;
                $minY = $y0;
                $maxX = $x1;
                $maxY = $y1;
                $any = true;
            } else {
                if ($x0 < $minX) {
                    $minX = $x0;
                }

                if ($y0 < $minY) {
                    $minY = $y0;
                }

                if ($x1 > $maxX) {
                    $maxX = $x1;
                }

                if ($y1 > $maxY) {
                    $maxY = $y1;
                }
            }

            if ($draw && $g->packed) {
                int32 $gx1 = $g->atlasX + $g->w;
                int32 $gy1 = $g->atlasY + $g->h;
                float32 $u0 = $g->atlasX as float32 / $aw;
                float32 $v0 = $g->atlasY as float32 / $ah;
                float32 $u1 = $gx1 as float32 / $aw;
                float32 $v1 = $gy1 as float32 / $ah;
                emitGlyphQuad($vg->mesh, $xf, $x0, $y0, $x1, $y1, $u0, $v0, $u1, $v1);
            }
        }

        $pen = $pen + $g->advance;
        $prev = $gi;
    }

    $out->advance = $pen * $inv;

    if ($any) {
        $out->bounds = AABB2D(Vec2($minX, $minY), Vec2($maxX, $maxY));
    }

    if ($draw) {
        int32 $count = ($vg->mesh->indices->count() as int32) - $first;
        Paint $p = Paint($vg->state->fill->inner);
        $p->kind = .alpha;
        Texture? $atlas = $font->atlas;

        if ($atlas != null) {
            Texture $tex = guard $atlas;
            pushCall($vg, $first, $count, $p, $tex);
        }
    }

    return $out;
}

internal function emitGlyphQuad(
    TessMesh& $mesh,
    const Xform& $xf,
    float32 $x0,
    float32 $y0,
    float32 $x1,
    float32 $y1,
    float32 $u0,
    float32 $v0,
    float32 $u1,
    float32 $v1
) : void
{
    uint32 $base = $mesh->verts->count() as uint32;
    $mesh->verts[] = VgVertex($xf->apply(Vec2($x0, $y0)), Vec2($u0, $v0));
    $mesh->verts[] = VgVertex($xf->apply(Vec2($x1, $y0)), Vec2($u1, $v0));
    $mesh->verts[] = VgVertex($xf->apply(Vec2($x1, $y1)), Vec2($u1, $v1));
    $mesh->verts[] = VgVertex($xf->apply(Vec2($x0, $y1)), Vec2($u0, $v1));
    $mesh->indices[] = $base;
    $mesh->indices[] = ($base + 1) as uint32;
    $mesh->indices[] = ($base + 2) as uint32;
    $mesh->indices[] = $base;
    $mesh->indices[] = ($base + 2) as uint32;
    $mesh->indices[] = ($base + 3) as uint32;
}

/**
 * ASCII a-z to A-Z, anything else unchanged. Section headers draw upper case per glyph, so the
 * title never needs an uppercased copy.
 */
internal function asciiUpper(int32 $cp) : int32
{
    if ($cp >= 97 && $cp <= 122) {
        return $cp - 32;
    }

    return $cp;
}
