/**
 * Holds a Canvas and mints VgPass onto a graph Pipeline.
 */

namespace visu::vg;

use visu::graphics::{Device, Pipeline, TargetRef};

public class VgRenderer
{
    public Canvas $canvas;

    public constructor(Device $device)
    {
        $this->canvas = Canvas($device);
    }

    public function load() : status<VgError>
    {
        return $this->canvas->load();
    }

    public function pass(Pipeline $pipeline, TargetRef $target, function<void(Canvas)> $draw) : void
    {
        $pipeline->add(VgPass($this->canvas, $target, $draw));
    }

    public function destroy() : void
    {
        $this->canvas->destroy();
    }
}
