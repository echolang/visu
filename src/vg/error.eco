/**
 * Recoverable vg failures. Path / state misuse is an assert.
 */

namespace visu::vg;

public enum VgError
{
    case missingFont(string $name);
    case fontFile(string $path);
    case fontParse;
    case shader(string $why);

    public const function message() : string
    {
        return match ($this) {
            .missingFont($name) => "vg font '{$name}' is not loaded",
            .fontFile($path) => "vg font file '{$path}'",
            .fontParse => 'vg font parse failed',
            .shader($why) => "vg shader: {$why}",
        };
    }
}
