/**
 * SPIR-V / MSL bytes for the baked vg program.
 */

namespace visu::vg;

#[if: os == darwin && !VISU_BACKEND_VULKAN]
internal function vgVertexBytes() : string
{
    return vgVertexSource();
}

internal function vgFragmentBytes() : string
{
    return vgFragmentSource();
}
#[else]
internal function vgVertexBytes() : string
{
    return visu::graphics::hexBytes(vgVertexSpvHex());
}

internal function vgFragmentBytes() : string
{
    return visu::graphics::hexBytes(vgFragmentSpvHex());
}
#[end]
