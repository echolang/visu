/**
 * Failures reading a glTF 2.0 file into cooked models.
 */

namespace visu::asset;

public enum GltfError
{
    case io(string $path, string $message);
    case notGltf(string $why);
    case json(string $why);
    case accessor(int32 $index, string $why);
    case unsupported(string $what);
    case empty;

    public const function message() : string
    {
        return match ($this) {
            GltfError::io($path, $message) => "gltf: '{$path}': {$message}",
            GltfError::notGltf($why) => "gltf: not a glTF file: {$why}",
            GltfError::json($why) => "gltf: {$why}",
            GltfError::accessor($index, $why) => "gltf: accessor {$index}: {$why}",
            GltfError::unsupported($what) => "gltf: unsupported: {$what}",
            GltfError::empty => 'gltf: no node carries a mesh',
        };
    }
}
