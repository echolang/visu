/**
 * One cooked object in a store. Offset/size are pack-relative; a directory store leaves offset 0.
 */

namespace visu::asset;

public struct CatalogEntry
{
    public string $id = '';
    public string $kind = '';
    public uint64 $offset = 0;
    public uint64 $size = 0;
    public uint64 $hash = 0;
    public string $path = '';
}
