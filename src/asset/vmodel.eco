/**
 * vmodel blob (`VMDL`): one model object as LOD levels over a shared vertex and index buffer.
 * `CookedModel` is the CPU form the cooker writes and `decodeCookedModel` reads back without a GPU;
 * `visu::graphics::decodeModel` turns it into buffers. A rigid vertex is `MODEL_VERTEX_BYTES`:
 * position, normal, tangent (w is handedness), uv. A skinned vertex adds four joint bytes and four
 * weight bytes, and the blob then ends with the `Skeleton`. Indices are absolute into the vertex
 * buffer. Version 1 blobs (rigid only) still decode.
 */

namespace visu::asset;

use visu::geo::AABB;
use visu::graphics::{IndexType, indexWidth};
use visu::math::Vec3;

internal const string MODEL_MAGIC = 'VMDL';
internal const uint16 MODEL_VERSION = 2;

/**
 * Header flag: the blob ends with a skeleton section.
 */
internal const uint16 MODEL_FLAG_SKINNED = 1;
public const string KIND_MODEL = 'model';

/**
 * Bytes per cooked vertex: float32 x (3 + 3 + 4 + 2).
 */
public const int32 MODEL_VERTEX_BYTES = 48;

/**
 * Bytes per skinned vertex: the rigid 48, then joints (uint8 x 4) and weights (unorm8 x 4).
 */
public const int32 MODEL_SKINNED_VERTEX_BYTES = 56;

/**
 * Rigid vertex format, the only one version 1 writes.
 */
public const uint32 MODEL_VERTEX_P3N3T4UV2 = 1;

/**
 * Skinned vertex format: `MODEL_VERTEX_P3N3T4UV2` plus four joint indices and four weights.
 */
public const uint32 MODEL_VERTEX_P3N3T4UV2J4W4 = 2;
public const int32 MODEL_MAX_LODS = 6;

/**
 * An index range drawn with one material slot.
 */
public struct ModelPrimitive
{
    public int32 $slot = 0;
    public int32 $firstIndex = 0;
    public int32 $indexCount = 0;
}

/**
 * One level of detail. `$distance` is where this level switches in (0 for level 0).
 */
public struct ModelLodDesc
{
    public float32 $distance;
    public AABB $bounds;
    public array<ModelPrimitive> $primitives;

    public constructor()
    {
        $this->distance = 0.0f;
        $this->bounds = AABB(Vec3(0.0f), Vec3(0.0f));
        $this->primitives = array<ModelPrimitive>();
    }
}

public class CookedModel
{
    /**
     * Material slot names, the glTF material names. `Material` records in the folder sheet bind by these.
     */
    public array<string> $slots;
    public array<ModelLodDesc> $lods;
    public AABB $bounds;

    /**
     * Multiplies the measured distance before the LOD table is read.
     */
    public float32 $lodBias;

    /**
     * Instances further away than this are not drawn. 0 means never culled by distance.
     */
    public float32 $cullDistance;
    public IndexType $indexType;
    public string $vertices;
    public string $indices;

    /**
     * `MODEL_VERTEX_P3N3T4UV2`, or `MODEL_VERTEX_P3N3T4UV2J4W4` when `$skeleton` is set.
     */
    public uint32 $format;
    public Skeleton? $skeleton;

    public constructor(
        array<string> $slots,
        array<ModelLodDesc> $lods,
        const AABB& $bounds,
        float32 $lodBias,
        float32 $cullDistance,
        IndexType $indexType,
        string $vertices,
        string $indices
    )
    {
        $this->slots = $slots;
        $this->lods = $lods;
        $this->bounds = $bounds;
        $this->lodBias = $lodBias;
        $this->cullDistance = $cullDistance;
        $this->indexType = $indexType;
        $this->vertices = $vertices;
        $this->indices = $indices;
        $this->format = MODEL_VERTEX_P3N3T4UV2;
        $this->skeleton = null;
    }

    public const function vertexBytes() : int32
    {
        return modelVertexBytes($this->format);
    }

    public const function vertexCount() : int32
    {
        return ($this->vertices->size() as int32) / $this->vertexBytes();
    }

    public const function indexCount() : int32
    {
        return ($this->indices->size() as int32) / indexWidth($this->indexType);
    }
}

public function encodeModel(const CookedModel& $model) : result<Blob, AssetError>
{
    string $id = 'model';
    int32 $slots = $model->slots->count() as int32;
    int32 $lods = $model->lods->count() as int32;
    if ($slots < 1 || $slots > 65535) {
        return .error(.corrupt($id, 'slot count'));
    }

    if ($lods < 1 || $lods > MODEL_MAX_LODS) {
        return .error(.corrupt($id, 'lod count'));
    }

    int32 $stride = modelVertexBytes($model->format);
    if ($stride == 0) {
        return .error(.corrupt($id, 'vertex format'));
    }

    bool $skinned = $model->format == MODEL_VERTEX_P3N3T4UV2J4W4;
    if ($skinned != ($model->skeleton != null)) {
        return .error(.corrupt($id, 'a skinned vertex format needs a skeleton and only it'));
    }

    if ($model->vertices->empty() || ($model->vertices->size() as int32) % $stride != 0) {
        return .error(.corrupt($id, 'vertex bytes'));
    }

    int32 $width = indexWidth($model->indexType);
    if ($model->indices->empty() || ($model->indices->size() as int32) % $width != 0) {
        return .error(.corrupt($id, 'index bytes'));
    }

    int32 $indexCount = $model->indexCount();
    string $out = '';
    putMagic($out, MODEL_MAGIC);
    putU16($out, MODEL_VERSION);
    uint16 $flags = 0;
    if ($skinned) {
        $flags = MODEL_FLAG_SKINNED;
    }

    putU16($out, $flags);
    putU32($out, $model->format);
    putU8($out, $width as uint8);
    putU8($out, $lods as uint8);
    putU16($out, $slots as uint16);
    putAabb($out, $model->bounds);
    putF32($out, $model->lodBias);
    putF32($out, $model->cullDistance);

    foreach ($model->slots as $slot) {
        putStr($out, $slot);
    }

    foreach ($model->lods as $lod) {
        int32 $prims = $lod->primitives->count() as int32;
        if ($prims < 0 || $prims > 65535) {
            return .error(.corrupt($id, 'primitive count'));
        }

        putF32($out, $lod->distance);
        putAabb($out, $lod->bounds);
        putU16($out, $prims as uint16);
        foreach ($lod->primitives as $prim) {
            if ($prim->slot < 0 || $prim->slot >= $slots) {
                return .error(.corrupt($id, 'primitive slot'));
            }

            if ($prim->firstIndex < 0 || $prim->indexCount < 1 || $prim->firstIndex + $prim->indexCount > $indexCount) {
                return .error(.corrupt($id, 'primitive index range'));
            }

            putU16($out, $prim->slot as uint16);
            putU32($out, $prim->firstIndex as uint32);
            putU32($out, $prim->indexCount as uint32);
        }
    }

    putU32($out, $model->vertexCount() as uint32);
    putMagic($out, $model->vertices);
    putU32($out, $indexCount as uint32);
    putMagic($out, $model->indices);
    if ($model->skeleton != null) {
        Skeleton $skeleton = guard $model->skeleton;
        int32 $joints = $skeleton->count();
        if ($joints < 1 || $joints > SKIN_MAX_JOINTS || !$skeleton->ordered()) {
            return .error(.corrupt($id, 'skeleton'));
        }

        putSkeleton($out, $skeleton);
    }

    return .ok(Blob($out));
}

public function decodeCookedModel(Assets $assets, Blob $blob) : result<CookedModel, AssetError>
{
    string $id = $assets->loading;
    if ($id->empty()) {
        $id = 'model';
    }

    string $s = $blob->bytes;
    usize $i = 0;
    guard getMagic($s, $i, MODEL_MAGIC, $id) else ($e) {
        return .error($e);
    }
    uint16 $ver = guard getU16($s, $i, $id) else ($e) {
        return .error($e);
    }
    if ($ver != 1 && $ver != MODEL_VERSION) {
        return .error(.corrupt($id, 'unsupported version'));
    }

    uint16 $flags = guard getU16($s, $i, $id) else ($e) {
        return .error($e);
    }
    uint32 $format = guard getU32($s, $i, $id) else ($e) {
        return .error($e);
    }
    int32 $stride = modelVertexBytes($format);
    if ($stride == 0 || ($ver == 1 && $format != MODEL_VERTEX_P3N3T4UV2)) {
        return .error(.corrupt($id, 'unknown vertex format'));
    }

    bool $skinned = ($flags & MODEL_FLAG_SKINNED) != 0;
    if ($skinned != ($format == MODEL_VERTEX_P3N3T4UV2J4W4)) {
        return .error(.corrupt($id, 'skinned flag and vertex format disagree'));
    }

    uint8 $width = guard getU8($s, $i, $id) else ($e) {
        return .error($e);
    }
    IndexType $indexType = .uint16;
    if ($width == 4) {
        $indexType = .uint32;
    } else if ($width != 2) {
        return .error(.corrupt($id, 'index width'));
    }

    uint8 $lodCount = guard getU8($s, $i, $id) else ($e) {
        return .error($e);
    }
    uint16 $slotCount = guard getU16($s, $i, $id) else ($e) {
        return .error($e);
    }
    if ($lodCount < 1 || ($lodCount as int32) > MODEL_MAX_LODS || $slotCount < 1) {
        return .error(.corrupt($id, 'lod or slot count'));
    }

    AABB $bounds = guard getAabb($s, $i, $id) else ($e) {
        return .error($e);
    }
    float32 $lodBias = guard getF32($s, $i, $id) else ($e) {
        return .error($e);
    }
    float32 $cullDistance = guard getF32($s, $i, $id) else ($e) {
        return .error($e);
    }

    array<string> $slots = array<string>();
    int32 $n = 0;
    while ($n < ($slotCount as int32)) {
        string $slot = guard getStr($s, $i, $id) else ($e) {
            return .error($e);
        }
        $slots[] = $slot;
        $n = $n + 1;
    }

    array<ModelLodDesc> $lods = array<ModelLodDesc>();
    int32 $l = 0;
    while ($l < ($lodCount as int32)) {
        ModelLodDesc $lod = ModelLodDesc();
        float32 $distance = guard getF32($s, $i, $id) else ($e) {
            return .error($e);
        }
        AABB $lodBounds = guard getAabb($s, $i, $id) else ($e) {
            return .error($e);
        }
        uint16 $prims = guard getU16($s, $i, $id) else ($e) {
            return .error($e);
        }
        $lod->distance = $distance;
        $lod->bounds = $lodBounds;
        int32 $p = 0;
        while ($p < ($prims as int32)) {
            uint16 $slot = guard getU16($s, $i, $id) else ($e) {
                return .error($e);
            }
            uint32 $first = guard getU32($s, $i, $id) else ($e) {
                return .error($e);
            }
            uint32 $count = guard getU32($s, $i, $id) else ($e) {
                return .error($e);
            }
            if (($slot as int32) >= ($slotCount as int32)) {
                return .error(.corrupt($id, 'primitive slot'));
            }

            $lod->primitives[] = ModelPrimitive($slot as int32, $first as int32, $count as int32);
            $p = $p + 1;
        }

        $lods[] = $lod;
        $l = $l + 1;
    }

    uint32 $vertexCount = guard getU32($s, $i, $id) else ($e) {
        return .error($e);
    }
    usize $vertexBytes = ($vertexCount as usize) * ($stride as usize);
    if ($vertexCount == 0 || $i + $vertexBytes > $s->size()) {
        return .error(.corrupt($id, 'truncated vertices'));
    }

    string $vertices = $s->sub($i, $vertexBytes)->clone();
    $i = $i + $vertexBytes;
    uint32 $indexCount = guard getU32($s, $i, $id) else ($e) {
        return .error($e);
    }
    usize $indexBytes = ($indexCount as usize) * ($width as usize);
    if ($indexCount == 0 || $i + $indexBytes > $s->size()) {
        return .error(.corrupt($id, 'truncated indices'));
    }

    string $indices = $s->sub($i, $indexBytes)->clone();
    $i = $i + $indexBytes;
    foreach ($lods as $lod) {
        foreach ($lod->primitives as $prim) {
            if ($prim->firstIndex + $prim->indexCount > ($indexCount as int32)) {
                return .error(.corrupt($id, 'primitive index range'));
            }
        }
    }

    CookedModel $model = CookedModel($slots, $lods, $bounds, $lodBias, $cullDistance, $indexType, $vertices, $indices);
    $model->format = $format;
    if ($skinned) {
        Skeleton $skeleton = guard getSkeleton($s, $i, $id) else ($e) {
            return .error($e);
        }
        $model->skeleton = $skeleton;
    }

    return .ok($model);
}

/**
 * Bytes per vertex for a cooked vertex format, 0 for one this build does not know.
 */
public function modelVertexBytes(uint32 $format) : int32
{
    if ($format == MODEL_VERTEX_P3N3T4UV2) {
        return MODEL_VERTEX_BYTES;
    }

    if ($format == MODEL_VERTEX_P3N3T4UV2J4W4) {
        return MODEL_SKINNED_VERTEX_BYTES;
    }

    return 0;
}

internal function putAabb(string& $out, const AABB& $box) : void
{
    putF32($out, $box->min->x);
    putF32($out, $box->min->y);
    putF32($out, $box->min->z);
    putF32($out, $box->max->x);
    putF32($out, $box->max->y);
    putF32($out, $box->max->z);
}

internal function getAabb(const string& $s, usize& $i, const string& $id) : result<AABB, AssetError>
{
    float32[6] $v;
    int32 $k = 0;
    while ($k < 6) {
        float32 $f = guard getF32($s, $i, $id) else ($e) {
            return .error($e);
        }
        $v[$k] = $f;
        $k = $k + 1;
    }

    return .ok(AABB(Vec3($v[0], $v[1], $v[2]), Vec3($v[3], $v[4], $v[5])));
}
