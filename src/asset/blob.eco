/**
 * Opaque cooked bytes. The bytes decoder returns this; other decoders parse a typed header out of it.
 */

namespace visu::asset;

public class Blob
{
    public const string $bytes;

    public constructor(string $bytes)
    {
        $this->bytes = $bytes;
    }
}

/**
 * One cooked object ready to pack or write into a directory store.
 */
public struct PackItem
{
    public string $id;
    public string $kind;
    public Blob $blob;
}
