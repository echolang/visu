/**
 * Failures looking up, reading, or decoding a cooked asset.
 */

namespace visu::asset;

public enum AssetError
{
    case missing(string $id);
    case wrongKind(string $id, string $want, string $have);
    case corrupt(string $id, string $why);
    case io(string $path, string $message);
    case decode(string $id, string $why);

    public const function message() : string
    {
        return match ($this) {
            AssetError::missing($id) => "asset: '{$id}' is not in any mounted store",
            AssetError::wrongKind($id, $want, $have) => "asset: '{$id}' is '{$have}', not '{$want}'",
            AssetError::corrupt($id, $why) => "asset: '{$id}' is corrupt: {$why}",
            AssetError::io($path, $message) => "asset: '{$path}': {$message}",
            AssetError::decode($id, $why) => "asset: could not decode '{$id}': {$why}",
        };
    }
}
