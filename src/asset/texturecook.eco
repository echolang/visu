/**
 * png → vtex. Cook knobs come from the folder `.vtex` view on `Source.$meta`.
 * `mip: "max"` keeps cutout coverage through the chain; box average is the default,
 * in linear light for an sRGB format. `premultiplied: true` divides rgb by alpha first.
 * `bleed: "self"` (own alpha) or `bleed: "<sibling png stem>"` (its red channel) marks the
 * covered texels and refills every other texel's rgb with the nearest covered colour, so a
 * cutout authored on black does not mip to black.
 */

namespace visu::asset;

use json;
use visu::graphics::{Pixels, PixelFormat};

public class TextureCooker : Cooker
{
    public function kind() : string
    {
        return KIND_TEXTURE;
    }

    public function accepts(const string& $path) : bool
    {
        return str::lower($path)->ends('.png');
    }

    public function cook(const Source& $src) : result<array<PackItem>, AssetError>
    {
        Pixels $px = guard Pixels::load($src->path) else ($e) {
            return .error(.io($src->path, $e->message()));
        }
        bool $srgb = guard vmatBool($src->meta, 'srgb', true) else ($e) {
            return .error($e);
        }
        bool $mips = guard vmatBool($src->meta, 'mips', true) else ($e) {
            return .error($e);
        }
        string $filter = str::lower(vmatStr($src->meta, 'mip', 'box'));
        if (!$filter->equals('box') && !$filter->equals('max')) {
            return .error(.decode($src->id, "unknown mip '{$filter}'"));
        }

        PixelFormat $fmt = guard cookPixelFormat($src->meta, $srgb) else ($e) {
            return .error($e);
        }
        bool $premultiplied = guard vmatBool($src->meta, 'premultiplied', false) else ($e) {
            return .error($e);
        }
        if ($premultiplied) {
            unpremultiply($px);
        }
        string $bleedFrom = vmatStr($src->meta, 'bleed', '');
        if (!$bleedFrom->empty()) {
            array<uint8> $cover = guard bleedCoverage($src, $px, $bleedFrom) else ($e) {
                return .error($e);
            }
            bleed($px, $cover);
        }

        Blob $blob = guard encodeTexture($px, $fmt, $mips, $filter->equals('max')) else ($e) {
            return .error($e);
        }
        array<PackItem> $items = array<PackItem>();
        $items[] = PackItem($src->id, KIND_TEXTURE, $blob);
        return .ok($items);
    }
}

/**
 * Covered texels for `bleed`: the texture's own alpha for `self`, else the red
 * channel of a same-size sibling png in the source folder.
 */
internal function bleedCoverage(const Source& $src, const Pixels& $px, const string& $from) : result<array<uint8>, AssetError>
{
    if ($from->equals('self')) {
        return .ok(coverageOf($px, 3));
    }

    string $base = dirBase($src->path);
    string $path = $src->path->sub(0, $src->path->size() - $base->size())->clone();
    $path->append($from);
    $path->append('.png');
    Pixels $mask = guard Pixels::load($path) else ($e) {
        return .error(.io($path, $e->message()));
    }
    if ($mask->width != $px->width || $mask->height != $px->height) {
        return .error(.decode($src->id, "bleed mask '{$from}' is not the texture's size"));
    }

    return .ok(coverageOf($mask, 0));
}

internal function cookPixelFormat(json::Value $meta, bool $srgb) : result<PixelFormat, AssetError>
{
    string $name = str::lower(vmatStr($meta, 'format', ''));
    if ($name->empty() || $name->equals('rgba8')) {
        if ($srgb) {
            return .ok(PixelFormat::rgba8Srgb);
        }

        return .ok(PixelFormat::rgba8);
    }

    if ($name->equals('rgba8srgb')) {
        return .ok(PixelFormat::rgba8Srgb);
    }

    if ($name->equals('compressed')) {
        #[if: os == ios]
        if ($srgb) {
            return .ok(PixelFormat::astc4x4Srgb);
        }

        return .ok(PixelFormat::astc4x4);
        #[else]
        if ($srgb) {
            return .ok(PixelFormat::bc7Srgb);
        }

        return .ok(PixelFormat::bc7);
        #[end]
    }

    if ($name->equals('bc7')) {
        if ($srgb) {
            return .ok(PixelFormat::bc7Srgb);
        }

        return .ok(PixelFormat::bc7);
    }

    if ($name->equals('bc7srgb')) {
        return .ok(PixelFormat::bc7Srgb);
    }

    if ($name->equals('astc') || $name->equals('astc4x4')) {
        if ($srgb) {
            return .ok(PixelFormat::astc4x4Srgb);
        }

        return .ok(PixelFormat::astc4x4);
    }

    if ($name->equals('astc4x4srgb')) {
        return .ok(PixelFormat::astc4x4Srgb);
    }

    return .error(.decode('format', "unknown format '{$name}'"));
}
