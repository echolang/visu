/**
 * Encoded wav / flac / mp3 bytes from a cooked vsnd. Play with `$engine->sound(memory: $clip->bytes)`.
 */

namespace visu::asset;

public const string KIND_SOUND = 'sound';

public class AudioClip
{
    public const string $bytes;

    public constructor(string $bytes)
    {
        $this->bytes = $bytes;
    }
}
