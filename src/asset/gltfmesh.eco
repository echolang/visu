/**
 * Bake grouped glTF parts into a `CookedModel`: world transforms in the vertices, primitives
 * grouped by material name, tangents generated when the file has none.
 */

namespace visu::asset;

use visu::geo::AABB;
use visu::graphics::{IndexType, indexWidth};
use visu::math::{Mat4, Vec2, Vec3, Vec4, cross, dot, inverse, length, normalize};

/**
 * Per-slot index list of one level while the object is being assembled.
 */
internal class GltfChunk
{
    public int32 $level;
    public int32 $slot;
    public array<uint32> $indices;

    public constructor(int32 $level, int32 $slot)
    {
        $this->level = $level;
        $this->slot = $slot;
        $this->indices = array<uint32>();
    }
}

/**
 * One primitive's attributes as flat float arrays, plus its triangle indices.
 */
internal class GltfPrimitive
{
    public int32 $count;
    public array<float32> $positions;
    public array<float32> $normals;
    public array<float32> $tangents;
    public array<float32> $uvs;
    public array<uint32> $indices;
    public bool $hasNormals;
    public bool $hasTangents;
    public bool $hasUvs;
    public AABB $bounds;

    public constructor()
    {
        $this->count = 0;
        $this->positions = array<float32>();
        $this->normals = array<float32>();
        $this->tangents = array<float32>();
        $this->uvs = array<float32>();
        $this->indices = array<uint32>();
        $this->hasNormals = false;
        $this->hasTangents = false;
        $this->hasUvs = false;
        $this->bounds = AABB(Vec3(0.0f), Vec3(0.0f));
    }
}

/**
 * Bake every part of one object into a shared vertex string plus per-level, per-slot index ranges.
 */
internal function gltfBuild(GltfFile $file, GltfParts $object) : result<CookedModel, GltfError>
{
    return gltfBuild($file, $object, Mat4());
}

/**
 * Bake `$object` with vertices in `$origin`'s space (`inverse(origin) * world`). Identity origin
 * is the old world bake, used by `gltfModels`. The cooker passes the part's LOD0 world matrix.
 */
internal function gltfBuild(GltfFile $file, GltfParts $object, const Mat4& $origin) : result<CookedModel, GltfError>
{
    array<string> $slots = array<string>();
    array<GltfChunk> $chunks = array<GltfChunk>();
    array<AABB> $levelBounds = array<AABB>();
    array<bool> $levelSeen = array<bool>();
    int32 $l = 0;
    while ($l < MODEL_MAX_LODS) {
        $levelBounds[] = AABB(Vec3(0.0f), Vec3(0.0f));
        $levelSeen[] = false;
        $l = $l + 1;
    }

    string $vertices = '';
    uint32 $vertexCount = 0;
    int32 $maxLevel = 0;

    foreach ($object->parts as $part) {
        if ($part->mesh < 0 || ($part->mesh as usize) >= $file->meshes->count()) {
            return .error(.json("mesh {$part->mesh} does not exist"));
        }

        if ($part->level >= MODEL_MAX_LODS) {
            return .error(.unsupported('more than six LOD levels'));
        }

        if ($part->level > $maxLevel) {
            $maxLevel = $part->level;
        }

        GltfMesh $mesh = $file->meshes[$part->mesh as usize];
        foreach ($mesh->primitives as $prim) {
            if ($prim->mode != GLTF_TRIANGLES) {
                return .error(.unsupported('a primitive that is not a triangle list'));
            }

            GltfPrimitive $data = guard gltfReadPrimitive($file, $prim) else ($e) {
                return .error($e);
            }
            int32 $slot = gltfSlot($file->materials, $prim->material, $slots);
            gltfBake($data, inverse($origin) * $part->world);
            AABB $box = $levelBounds[$part->level as usize];
            if (!$levelSeen[$part->level as usize]) {
                $box = $data->bounds;
                $levelSeen[$part->level as usize] = true;
            } else {
                $box->extend($data->bounds);
            }

            $levelBounds[$part->level as usize] = $box;
            gltfAppendVertices($vertices, $data);
            GltfChunk $chunk = gltfChunk($chunks, $part->level, $slot);
            foreach ($data->indices as $index) {
                $chunk->indices[] = $index + $vertexCount;
            }

            $vertexCount = $vertexCount + ($data->count as uint32);
        }
    }

    if ($vertexCount == 0) {
        return .error(.empty);
    }

    IndexType $indexType = .uint16;
    if ($vertexCount > 65535) {
        $indexType = .uint32;
    }

    string $indices = '';
    array<ModelLodDesc> $lods = array<ModelLodDesc>();
    AABB $bounds = $levelBounds[0];
    int32 $level = 0;
    while ($level <= $maxLevel) {
        ModelLodDesc $lod = ModelLodDesc();
        if ($levelSeen[$level as usize]) {
            $lod->bounds = $levelBounds[$level as usize];
            int32 $slot = 0;
            while (($slot as usize) < $slots->count()) {
                GltfChunk? $found = gltfFindChunk($chunks, $level, $slot);
                GltfChunk $chunk = guard $found else {
                    $slot = $slot + 1;
                    continue;
                }
                int32 $first = ($indices->size() as int32) / indexWidth($indexType);
                gltfAppendIndices($indices, $chunk->indices, $indexType);
                $lod->primitives[] = ModelPrimitive($slot, $first, $chunk->indices->count() as int32);
                $slot = $slot + 1;
            }
        } else if ($level > 0) {
            // a missing level keeps drawing the one before it
            $lod->bounds = $lods[($level - 1) as usize]->bounds;
            $lod->primitives = $lods[($level - 1) as usize]->primitives;
        }

        if ($level > 0) {
            $bounds->extend($lod->bounds);
        }

        $lods[] = $lod;
        $level = $level + 1;
    }

    return .ok(CookedModel($slots, $lods, $bounds, 1.0f, 0.0f, $indexType, $vertices, $indices));
}

internal function gltfPartOrigin(GltfParts $object) : Mat4
{
    foreach ($object->parts as $part) {
        if ($part->level == 0) {
            return $part->world;
        }
    }

    if ($object->parts->count() == 0) {
        return Mat4();
    }

    return $object->parts[0]->world;
}

internal function gltfSlot(const array<string>& $materials, int32 $materialIndex, array<string>& $slots) : int32
{
    string $name = 'default';
    if ($materialIndex >= 0 && ($materialIndex as usize) < $materials->count()) {
        $name = $materials[$materialIndex as usize];
    }

    int32 $i = 0;
    while (($i as usize) < $slots->count()) {
        if ($slots[$i as usize]->equals($name)) {
            return $i;
        }

        $i = $i + 1;
    }

    $slots[] = $name;
    return $i;
}

internal function gltfChunk(array<GltfChunk>& $chunks, int32 $level, int32 $slot) : GltfChunk
{
    GltfChunk? $found = gltfFindChunk($chunks, $level, $slot);
    GltfChunk $have = guard $found else {
        GltfChunk $fresh = GltfChunk($level, $slot);
        $chunks[] = $fresh;
        return $fresh;
    }
    return $have;
}

internal function gltfFindChunk(const array<GltfChunk>& $chunks, int32 $level, int32 $slot) : GltfChunk?
{
    foreach ($chunks as $chunk) {
        if ($chunk->level == $level && $chunk->slot == $slot) {
            return $chunk;
        }
    }

    return null;
}

internal function gltfReadPrimitive(GltfFile $file, GltfPrim $prim) : result<GltfPrimitive, GltfError>
{
    if ($prim->position < 0) {
        return .error(.json('primitive without POSITION'));
    }

    int32 $positionAccessor = $prim->position;
    GltfPrimitive $out = GltfPrimitive();
    array<float32> $positions = guard gltfReadFloats($file, $positionAccessor, 3) else ($e) {
        return .error($e);
    }
    $out->positions = $positions;
    $out->count = ($positions->count() / 3) as int32;
    if ($out->count == 0) {
        return .error(.accessor($positionAccessor, 'empty'));
    }

    if ($prim->normal >= 0) {
        array<float32> $normals = guard gltfReadFloats($file, $prim->normal, 3) else ($e) {
            return .error($e);
        }
        if ($normals->count() != $positions->count()) {
            return .error(.accessor($prim->normal, 'NORMAL count does not match POSITION'));
        }

        $out->normals = $normals;
        $out->hasNormals = true;
    }

    if ($prim->tangent >= 0) {
        array<float32> $tangents = guard gltfReadFloats($file, $prim->tangent, 4) else ($e) {
            return .error($e);
        }
        if ($tangents->count() != ($out->count as usize) * 4) {
            return .error(.accessor($prim->tangent, 'TANGENT count does not match POSITION'));
        }

        $out->tangents = $tangents;
        $out->hasTangents = true;
    }

    if ($prim->uv >= 0) {
        array<float32> $uvs = guard gltfReadFloats($file, $prim->uv, 2) else ($e) {
            return .error($e);
        }
        if ($uvs->count() != ($out->count as usize) * 2) {
            return .error(.accessor($prim->uv, 'TEXCOORD_0 count does not match POSITION'));
        }

        $out->uvs = $uvs;
        $out->hasUvs = true;
    }

    if ($prim->indices >= 0) {
        array<uint32> $indices = guard gltfReadIndices($file, $prim->indices) else ($e) {
            return .error($e);
        }
        foreach ($indices as $i) {
            if ($i >= ($out->count as uint32)) {
                return .error(.accessor($prim->indices, 'index past the vertex count'));
            }
        }

        $out->indices = $indices;
    } else {
        uint32 $i = 0;
        while ($i < ($out->count as uint32)) {
            $out->indices[] = $i;
            $i = $i + 1;
        }
    }

    if ($out->indices->count() % 3 != 0) {
        return .error(.unsupported('index count is not a multiple of three'));
    }

    return .ok($out);
}

/**
 * Apply the world matrix, fill in missing normals and tangents, and measure the bounds.
 * Mirrored matrices flip the winding so front faces stay front.
 */
internal function gltfBake(GltfPrimitive $p, const Mat4& $world) : void
{
    int32 $n = $p->count;
    bool $mirrored = gltfDeterminant($world) < 0.0f;
    if ($mirrored) {
        usize $t = 0;
        while ($t + 2 < $p->indices->count()) {
            uint32 $b = $p->indices[$t + 1];
            $p->indices[$t + 1] = $p->indices[$t + 2];
            $p->indices[$t + 2] = $b;
            $t = $t + 3;
        }
    }

    if (!$p->hasNormals) {
        $p->normals = gltfFaceNormals($p->positions, $p->indices, $n);
        $p->hasNormals = true;
    }

    if (!$p->hasUvs) {
        $p->uvs = array<float32>();
        int32 $i = 0;
        while ($i < $n) {
            $p->uvs[] = 0.0f;
            $p->uvs[] = 0.0f;
            $i = $i + 1;
        }
    }

    if (!$p->hasTangents) {
        $p->tangents = gltfTangents($p->positions, $p->normals, $p->uvs, $p->indices, $n, $p->hasUvs);
        $p->hasTangents = true;
    }

    Vec3 $lo = Vec3(0.0f);
    Vec3 $hi = Vec3(0.0f);
    int32 $v = 0;
    while ($v < $n) {
        usize $i3 = ($v * 3) as usize;
        usize $i4 = ($v * 4) as usize;
        Vec4 $wp = $world * Vec4($p->positions[$i3], $p->positions[$i3 + 1], $p->positions[$i3 + 2], 1.0f);
        Vec4 $wn = $world * Vec4($p->normals[$i3], $p->normals[$i3 + 1], $p->normals[$i3 + 2], 0.0f);
        Vec4 $wt = $world * Vec4($p->tangents[$i4], $p->tangents[$i4 + 1], $p->tangents[$i4 + 2], 0.0f);
        Vec3 $nn = gltfSafeNormalize(Vec3($wn->x, $wn->y, $wn->z), Vec3(0.0f, 1.0f, 0.0f));
        Vec3 $tt = gltfSafeNormalize(Vec3($wt->x, $wt->y, $wt->z), Vec3(1.0f, 0.0f, 0.0f));
        $p->positions[$i3] = $wp->x;
        $p->positions[$i3 + 1] = $wp->y;
        $p->positions[$i3 + 2] = $wp->z;
        $p->normals[$i3] = $nn->x;
        $p->normals[$i3 + 1] = $nn->y;
        $p->normals[$i3 + 2] = $nn->z;
        $p->tangents[$i4] = $tt->x;
        $p->tangents[$i4 + 1] = $tt->y;
        $p->tangents[$i4 + 2] = $tt->z;
        if ($mirrored) {
            $p->tangents[$i4 + 3] = -$p->tangents[$i4 + 3];
        }

        Vec3 $point = Vec3($wp->x, $wp->y, $wp->z);
        if ($v == 0) {
            $lo = $point;
            $hi = $point;
        } else {
            $lo = visu::math::min($lo, $point);
            $hi = visu::math::max($hi, $point);
        }

        $v = $v + 1;
    }

    $p->bounds = AABB($lo, $hi);
}

/**
 * Area-weighted vertex normals from the triangle list.
 */
internal function gltfFaceNormals(const array<float32>& $pos, const array<uint32>& $idx, int32 $n) : array<float32>
{
    array<float32> $out = array<float32>();
    int32 $i = 0;
    while ($i < $n * 3) {
        $out[] = 0.0f;
        $i = $i + 1;
    }

    usize $t = 0;
    while ($t + 2 < $idx->count()) {
        Vec3 $a = gltfVec3($pos, $idx[$t]);
        Vec3 $b = gltfVec3($pos, $idx[$t + 1]);
        Vec3 $c = gltfVec3($pos, $idx[$t + 2]);
        Vec3 $fn = cross($b - $a, $c - $a);
        gltfAddVec3($out, $idx[$t], $fn);
        gltfAddVec3($out, $idx[$t + 1], $fn);
        gltfAddVec3($out, $idx[$t + 2], $fn);
        $t = $t + 3;
    }

    int32 $v = 0;
    while ($v < $n) {
        Vec3 $nn = gltfSafeNormalize(gltfVec3($out, $v as uint32), Vec3(0.0f, 1.0f, 0.0f));
        gltfSetVec3($out, $v as uint32, $nn);
        $v = $v + 1;
    }

    return $out;
}

/**
 * Lengyel tangents: accumulate per triangle from the uv gradient, then Gram-Schmidt against the
 * normal, handedness in w. Without uvs every tangent is a perpendicular of the normal.
 */
internal function gltfTangents(
    const array<float32>& $pos,
    const array<float32>& $nrm,
    const array<float32>& $uv,
    const array<uint32>& $idx,
    int32 $n,
    bool $hasUvs
) : array<float32>
{
    array<float32> $tan1 = array<float32>();
    array<float32> $tan2 = array<float32>();
    int32 $i = 0;
    while ($i < $n * 3) {
        $tan1[] = 0.0f;
        $tan2[] = 0.0f;
        $i = $i + 1;
    }

    if ($hasUvs) {
        usize $t = 0;
        while ($t + 2 < $idx->count()) {
            uint32 $i0 = $idx[$t];
            uint32 $i1 = $idx[$t + 1];
            uint32 $i2 = $idx[$t + 2];
            Vec3 $p0 = gltfVec3($pos, $i0);
            Vec3 $p1 = gltfVec3($pos, $i1);
            Vec3 $p2 = gltfVec3($pos, $i2);
            Vec2 $w0 = gltfVec2($uv, $i0);
            Vec2 $w1 = gltfVec2($uv, $i1);
            Vec2 $w2 = gltfVec2($uv, $i2);
            Vec3 $e1 = $p1 - $p0;
            Vec3 $e2 = $p2 - $p0;
            float32 $s1 = $w1->x - $w0->x;
            float32 $s2 = $w2->x - $w0->x;
            float32 $t1 = $w1->y - $w0->y;
            float32 $t2 = $w2->y - $w0->y;
            float32 $det = $s1 * $t2 - $s2 * $t1;
            if ($det > -0.000001f && $det < 0.000001f) {
                $t = $t + 3;
                continue;
            }

            float32 $r = 1.0f / $det;
            Vec3 $sdir = ($e1 * $t2 - $e2 * $t1) * $r;
            Vec3 $tdir = ($e2 * $s1 - $e1 * $s2) * $r;
            gltfAddVec3($tan1, $i0, $sdir);
            gltfAddVec3($tan1, $i1, $sdir);
            gltfAddVec3($tan1, $i2, $sdir);
            gltfAddVec3($tan2, $i0, $tdir);
            gltfAddVec3($tan2, $i1, $tdir);
            gltfAddVec3($tan2, $i2, $tdir);
            $t = $t + 3;
        }
    }

    array<float32> $out = array<float32>();
    $out->reserve(($n * 4) as usize);
    int32 $v = 0;
    while ($v < $n) {
        Vec3 $normal = gltfVec3($nrm, $v as uint32);
        Vec3 $t1 = gltfVec3($tan1, $v as uint32);
        Vec3 $ortho = $t1 - $normal * dot($normal, $t1);
        float32 $w = 1.0f;
        if (length($ortho) < 0.000001f) {
            $ortho = gltfPerpendicular($normal);
        } else {
            $ortho = normalize($ortho);
            if (dot(cross($normal, $ortho), gltfVec3($tan2, $v as uint32)) < 0.0f) {
                $w = -1.0f;
            }
        }

        $out[] = $ortho->x;
        $out[] = $ortho->y;
        $out[] = $ortho->z;
        $out[] = $w;
        $v = $v + 1;
    }

    return $out;
}

internal function gltfPerpendicular(Vec3 $n) : Vec3
{
    Vec3 $axis = Vec3(1.0f, 0.0f, 0.0f);
    if ($n->x > 0.9f || $n->x < -0.9f) {
        $axis = Vec3(0.0f, 1.0f, 0.0f);
    }

    return gltfSafeNormalize(cross($n, $axis), Vec3(1.0f, 0.0f, 0.0f));
}

internal function gltfSafeNormalize(Vec3 $v, Vec3 $fallback) : Vec3
{
    float32 $len = length($v);
    if ($len < 0.000001f) {
        return $fallback;
    }

    return $v / $len;
}

internal function gltfDeterminant(const Mat4& $m) : float32
{
    Vec3 $c0 = Vec3($m->c0->x, $m->c0->y, $m->c0->z);
    Vec3 $c1 = Vec3($m->c1->x, $m->c1->y, $m->c1->z);
    Vec3 $c2 = Vec3($m->c2->x, $m->c2->y, $m->c2->z);
    return dot($c0, cross($c1, $c2));
}

internal function gltfVec3(const array<float32>& $a, uint32 $i) : Vec3
{
    usize $k = ($i * 3) as usize;
    return Vec3($a[$k], $a[$k + 1], $a[$k + 2]);
}

internal function gltfVec2(const array<float32>& $a, uint32 $i) : Vec2
{
    usize $k = ($i * 2) as usize;
    return Vec2($a[$k], $a[$k + 1]);
}

internal function gltfAddVec3(array<float32>& $a, uint32 $i, Vec3 $v) : void
{
    usize $k = ($i * 3) as usize;
    $a[$k] = $a[$k] + $v->x;
    $a[$k + 1] = $a[$k + 1] + $v->y;
    $a[$k + 2] = $a[$k + 2] + $v->z;
}

internal function gltfSetVec3(array<float32>& $a, uint32 $i, Vec3 $v) : void
{
    usize $k = ($i * 3) as usize;
    $a[$k] = $v->x;
    $a[$k + 1] = $v->y;
    $a[$k + 2] = $v->z;
}

/**
 * Append `count` vertices in the cooked layout: position, normal, tangent, uv.
 */
internal function gltfAppendVertices(string& $out, GltfPrimitive $p) : void
{
    $out->reserve($out->size() + ($p->count as usize) * (MODEL_VERTEX_BYTES as usize));
    int32 $v = 0;
    while ($v < $p->count) {
        usize $i3 = ($v * 3) as usize;
        usize $i4 = ($v * 4) as usize;
        usize $i2 = ($v * 2) as usize;
        putF32($out, $p->positions[$i3]);
        putF32($out, $p->positions[$i3 + 1]);
        putF32($out, $p->positions[$i3 + 2]);
        putF32($out, $p->normals[$i3]);
        putF32($out, $p->normals[$i3 + 1]);
        putF32($out, $p->normals[$i3 + 2]);
        putF32($out, $p->tangents[$i4]);
        putF32($out, $p->tangents[$i4 + 1]);
        putF32($out, $p->tangents[$i4 + 2]);
        putF32($out, $p->tangents[$i4 + 3]);
        putF32($out, $p->uvs[$i2]);
        putF32($out, $p->uvs[$i2 + 1]);
        $v = $v + 1;
    }
}

internal function gltfAppendIndices(string& $out, const array<uint32>& $indices, IndexType $type) : void
{
    foreach ($indices as $i) {
        if ($type == IndexType::uint16) {
            putU16($out, $i as uint16);
        } else {
            putU32($out, $i);
        }
    }
}
