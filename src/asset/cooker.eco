/**
 * Offline source → cooked blob. Implementations are classes.
 */

namespace visu::asset;

use json;

public struct Source
{
    public string $path = '';
    public string $id = '';
    public json::Value $meta = json::object();
}

public interface Cooker
{
    function kind() : string;
    function accepts(const string& $path) : bool;
    function cook(const Source& $src) : result<PackItem, AssetError>;
}
