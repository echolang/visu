/**
 * Typed cook-blob → live object, stored as erased.
 * Host registers one per kind; a second decoder for T is a wiring bug.
 * Not a generic class: Echo rejects those at global scope.
 */

namespace visu::asset;

internal class DecodeThunk
{
    public function<result<erased, AssetError>(Assets, Blob)> $run;

    public constructor(function<result<erased, AssetError>(Assets, Blob)> $run)
    {
        $this->run = $run;
    }

    public function decode(Assets $assets, Blob $blob) : result<erased, AssetError>
    {
        function<result<erased, AssetError>(Assets, Blob)> $fn = $this->run;
        return $fn($assets, $blob);
    }
}
