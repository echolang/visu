/**
 * `str::from` so `"{$e}"` works. Own file because a namespace is a property of the file.
 */

namespace str;

public function from(const visu::asset::AssetError& $e) : string
{
    return $e->message();
}

public function from(const visu::asset::GltfError& $e) : string
{
    return $e->message();
}
