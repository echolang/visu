/**
 * Axis-aligned box centered at the origin, non-indexed triangle list.
 * Normals are flat per face; UVs span 0..1 on every face.
 */

namespace visu::geo;

use visu::math::{Vec2, Vec3};

public function cube(
    PrimitiveBuilder& $b,
    float32 $width = 1.0f,
    float32 $height = 1.0f,
    float32 $depth = 1.0f
) : void
{
    $b->room(36);
    float32 $hx = $width * 0.5f;
    float32 $hy = $height * 0.5f;
    float32 $hz = $depth * 0.5f;

    cubeFace($b, Vec3(1.0f, 0.0f, 0.0f), Vec3($hx, 0.0f, 0.0f), Vec3(0.0f, 0.0f, -$hz), Vec3(0.0f, $hy, 0.0f));
    cubeFace($b, Vec3(-1.0f, 0.0f, 0.0f), Vec3(-$hx, 0.0f, 0.0f), Vec3(0.0f, 0.0f, $hz), Vec3(0.0f, $hy, 0.0f));
    cubeFace($b, Vec3(0.0f, 1.0f, 0.0f), Vec3(0.0f, $hy, 0.0f), Vec3($hx, 0.0f, 0.0f), Vec3(0.0f, 0.0f, -$hz));
    cubeFace($b, Vec3(0.0f, -1.0f, 0.0f), Vec3(0.0f, -$hy, 0.0f), Vec3($hx, 0.0f, 0.0f), Vec3(0.0f, 0.0f, $hz));
    cubeFace($b, Vec3(0.0f, 0.0f, 1.0f), Vec3(0.0f, 0.0f, $hz), Vec3($hx, 0.0f, 0.0f), Vec3(0.0f, $hy, 0.0f));
    cubeFace($b, Vec3(0.0f, 0.0f, -1.0f), Vec3(0.0f, 0.0f, -$hz), Vec3(-$hx, 0.0f, 0.0f), Vec3(0.0f, $hy, 0.0f));
}

internal function cubeFace(PrimitiveBuilder& $b, Vec3 $normal, Vec3 $center, Vec3 $uDir, Vec3 $vDir) : void
{
    Vec3 $bl = $center - $uDir - $vDir;
    Vec3 $br = $center + $uDir - $vDir;
    Vec3 $tr = $center + $uDir + $vDir;
    Vec3 $tl = $center - $uDir + $vDir;

    $b->add($bl, $normal, Vec2(0.0f, 0.0f));
    $b->add($br, $normal, Vec2(1.0f, 0.0f));
    $b->add($tr, $normal, Vec2(1.0f, 1.0f));

    $b->add($bl, $normal, Vec2(0.0f, 0.0f));
    $b->add($tr, $normal, Vec2(1.0f, 1.0f));
    $b->add($tl, $normal, Vec2(0.0f, 1.0f));
}
