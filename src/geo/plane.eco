/**
 * Plane equation `dot(normal, p) + distance = 0`. The constructor
 * divides both by the normal's length so later tests can use the
 * values as-is.
 */

namespace visu::geo;

use visu::math::{Vec3, length};

public struct Plane
{
    public Vec3 $normal;
    public float32 $distance;

    public constructor(Vec3 $normal, float32 $distance)
    {
        float32 $mag = length($normal);
        $this->normal = $normal / $mag;
        $this->distance = $distance / $mag;
    }
}
