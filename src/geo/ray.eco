/**
 * Origin plus direction.
 * `at($t)` is the point `$t` units along the ray; direction is not assumed unit length.
 */

namespace visu::geo;

use visu::math::Vec3;

public struct Ray
{
    public Vec3 $origin;
    public Vec3 $direction;

    public const function at(float32 $t) : Vec3
    {
        return $this->origin + $this->direction * $t;
    }
}
