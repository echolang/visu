/**
 * View frustum as six planes.
 * `Frustum($viewProjection)` is Gribb/Hartmann; the six-plane constructor is the unmarked path.
 */

namespace visu::geo;

use visu::math::{Mat4, Vec3, dot};

/**
 * How a box sits against a frustum. `inside` lets a spatial index accept a whole subtree untested.
 */
public enum Containment
{
    case outside;
    case intersects;
    case inside;
}

public struct Frustum
{
    public Plane $left;
    public Plane $right;
    public Plane $top;
    public Plane $bottom;
    public Plane $near;
    public Plane $far;

    public constructor(Plane $left, Plane $right, Plane $top, Plane $bottom, Plane $near, Plane $far)
    {
        $this->left = $left;
        $this->right = $right;
        $this->top = $top;
        $this->bottom = $bottom;
        $this->near = $near;
        $this->far = $far;
    }

    public constructor(const Mat4& $m)
    {
        $this->left = Plane(
            Vec3($m->c0->w + $m->c0->x, $m->c1->w + $m->c1->x, $m->c2->w + $m->c2->x),
            $m->c3->w + $m->c3->x
        );
        $this->right = Plane(
            Vec3($m->c0->w - $m->c0->x, $m->c1->w - $m->c1->x, $m->c2->w - $m->c2->x),
            $m->c3->w - $m->c3->x
        );
        $this->top = Plane(
            Vec3($m->c0->w - $m->c0->y, $m->c1->w - $m->c1->y, $m->c2->w - $m->c2->y),
            $m->c3->w - $m->c3->y
        );
        $this->bottom = Plane(
            Vec3($m->c0->w + $m->c0->y, $m->c1->w + $m->c1->y, $m->c2->w + $m->c2->y),
            $m->c3->w + $m->c3->y
        );
        $this->near = Plane(
            Vec3($m->c0->w + $m->c0->z, $m->c1->w + $m->c1->z, $m->c2->w + $m->c2->z),
            $m->c3->w + $m->c3->z
        );
        $this->far = Plane(
            Vec3($m->c0->w - $m->c0->z, $m->c1->w - $m->c1->z, $m->c2->w - $m->c2->z),
            $m->c3->w - $m->c3->z
        );
    }

    /**
     * Gribb/Hartmann for a 0..1 depth projection-view (`visu::math::clipZeroOne`): the near plane is z_clip >= 0, the other five are unchanged.
     */
    public constructor(zeroOne: const Mat4& $m)
    {
        // five of the six planes are the clip-space extraction
        Frustum $gl = Frustum($m);

        $this->left = $gl->left;
        $this->right = $gl->right;
        $this->top = $gl->top;
        $this->bottom = $gl->bottom;
        $this->far = $gl->far;
        $this->near = Plane(
            Vec3($m->c0->z, $m->c1->z, $m->c2->z),
            $m->c3->z
        );
    }

    public const function contains(Vec3 $center, float32 $radius) : bool
    {
        if (dot($this->left->normal, $center) + $this->left->distance < -$radius) {
            return false;
        }

        if (dot($this->right->normal, $center) + $this->right->distance < -$radius) {
            return false;
        }

        if (dot($this->top->normal, $center) + $this->top->distance < -$radius) {
            return false;
        }

        if (dot($this->bottom->normal, $center) + $this->bottom->distance < -$radius) {
            return false;
        }

        if (dot($this->near->normal, $center) + $this->near->distance < -$radius) {
            return false;
        }

        if (dot($this->far->normal, $center) + $this->far->distance < -$radius) {
            return false;
        }

        return true;
    }

    /**
     * True unless the box is completely outside a plane. Conservative: a straddling box counts as in.
     */
    public const function contains(const AABB& $box) : bool
    {
        Plane[6] $planes = frustumPlanes($this);
        int32 $i = 0;
        while ($i < 6) {
            if (boxOutside($planes[$i], $box)) {
                return false;
            }

            $i = $i + 1;
        }

        return true;
    }

    /**
     * Outside when any plane has the whole box behind it, inside when every plane has the whole box
     * in front, intersects otherwise. Same p-vertex test as `contains`, plus the n-vertex for inside.
     */
    public const function classify(const AABB& $box) : Containment
    {
        Plane[6] $planes = frustumPlanes($this);
        bool $straddles = false;
        int32 $i = 0;
        while ($i < 6) {
            if (boxOutside($planes[$i], $box)) {
                return .outside;
            }

            if (!boxInside($planes[$i], $box)) {
                $straddles = true;
            }

            $i = $i + 1;
        }

        if ($straddles) {
            return .intersects;
        }

        return .inside;
    }
}

internal function frustumPlanes(const Frustum& $f) : Plane[6]
{
    Plane[6] $p;
    $p[0] = $f->left;
    $p[1] = $f->right;
    $p[2] = $f->top;
    $p[3] = $f->bottom;
    $p[4] = $f->near;
    $p[5] = $f->far;
    return $p;
}

/**
 * The n-vertex (the corner furthest behind the plane) is still in front: the box is wholly inside.
 */
internal function boxInside(const Plane& $plane, const AABB& $box) : bool
{
    float32 $x = $box->max->x;
    if ($plane->normal->x >= 0.0f) {
        $x = $box->min->x;
    }

    float32 $y = $box->max->y;
    if ($plane->normal->y >= 0.0f) {
        $y = $box->min->y;
    }

    float32 $z = $box->max->z;
    if ($plane->normal->z >= 0.0f) {
        $z = $box->min->z;
    }

    return $plane->normal->x * $x + $plane->normal->y * $y + $plane->normal->z * $z + $plane->distance >= 0.0f;
}

internal function boxOutside(const Plane& $plane, const AABB& $box) : bool
{
    float32 $x = $box->min->x;
    if ($plane->normal->x >= 0.0f) {
        $x = $box->max->x;
    }

    float32 $y = $box->min->y;
    if ($plane->normal->y >= 0.0f) {
        $y = $box->max->y;
    }

    float32 $z = $box->min->z;
    if ($plane->normal->z >= 0.0f) {
        $z = $box->max->z;
    }

    return $plane->normal->x * $x + $plane->normal->y * $y + $plane->normal->z * $z + $plane->distance < 0.0f;
}
