/**
 * CPU height grid in XZ, origin at the centre.
 * `sample` is bilinear in world units; `cast` clips to `bounds()` then binary-searches the span.
 * One texel is `1 / ppu` world units. `smoothed` is a binomial low-pass copy.
 */

namespace visu::geo;

use visu::math::{Vec2, Vec3, mix, normalize};

public class Heightmap
{
    public const int32 $width;
    public const int32 $height;
    public const float32 $ppu;
    private array<float32> $data;
    private float32 $lo;
    private float32 $hi;
    private bool $loose;

    /**
     * `$data` is row-major in Z, `width * height` samples. `$ppu` must be > 0.
     */
    public constructor(const array<float32>& $data, int32 $width, int32 $height, float32 $ppu = 1.0f)
    {
        assert($width > 0, 'heightmap width');
        assert($height > 0, 'heightmap height');
        assert($ppu > 0.0f, 'heightmap ppu');
        assert(($data->count() as int32) == $width * $height, 'heightmap count');
        $this->width = $width;
        $this->height = $height;
        $this->ppu = $ppu;
        $this->data = $data;
        $this->lo = 0.0f;
        $this->hi = 0.0f;
        $this->loose = false;
        $this->recount();
    }

    /**
     * Every sample set to `$value`.
     */
    public static function flat(int32 $width, int32 $height, float32 $value = 0.0f, float32 $ppu = 1.0f) : Heightmap
    {
        int32 $n = $width * $height;
        array<float32> $data = array<float32>();
        $data->reserve($n as usize);

        for (int32 $i = 0; $i < $n; $i = $i + 1) {
            $data[] = $value;
        }

        return Heightmap($data, $width, $height, $ppu);
    }

    /**
     * Grid sample. `$ix` along X, `$iz` along Z.
     */
    public const function at(int32 $ix, int32 $iz) : float32
    {
        assert($ix >= 0 && $ix < $this->width, 'heightmap x');
        assert($iz >= 0 && $iz < $this->height, 'heightmap z');
        return $this->data[($iz * $this->width + $ix) as usize];
    }

    public function set(int32 $ix, int32 $iz, float32 $h) : void
    {
        assert($ix >= 0 && $ix < $this->width, 'heightmap x');
        assert($iz >= 0 && $iz < $this->height, 'heightmap z');
        usize $i = ($iz * $this->width + $ix) as usize;
        float32 $old = $this->data[$i];
        $this->data[$i] = $h;
        if ($h < $this->lo) {
            $this->lo = $h;
        }

        if ($h > $this->hi) {
            $this->hi = $h;
        }

        // a vacated extreme leaves the old bound standing. a wider AABB never culls a
        // visible patch; exactness is for range() and a later recount()
        if (($old == $this->lo && $h > $this->lo) || ($old == $this->hi && $h < $this->hi)) {
            $this->loose = true;
        }
    }

    /**
     * Binomial low-pass copy, same size and ppu. `$radius` is samples; 1 is a 3-tap, 2 is a 5-tap.
     * Edges clamp. Interior linear ramps stay linear; a one-sample spike is spread across the kernel.
     */
    public const function smoothed(int32 $radius = 2) : Heightmap
    {
        HeightmapSmooth $work = HeightmapSmooth($this, $radius);
        while (!$work->step($this->height)) {
        }

        return $work->take();
    }

    /**
     * Multiply every sample by `$s` and the cached min/max with it. One pass, no recount.
     */
    public function scale(float32 $s) : void
    {
        if ($s == 1.0f) {
            return;
        }

        HeightmapScale $work = HeightmapScale($this, $s);
        while (!$work->step($this->height)) {
        }
    }

    /**
     * Multiply samples in rows `[$z0, $z1)`. Bounds stay put until commitScale.
     */
    internal function scaleSlice(float32 $s, int32 $z0, int32 $z1) : void
    {
        if ($z0 < 0) {
            $z0 = 0;
        }

        if ($z1 > $this->height) {
            $z1 = $this->height;
        }

        int32 $w = $this->width;
        int32 $iz = $z0;
        while ($iz < $z1) {
            usize $row = ($iz * $w) as usize;
            usize $end = $row + ($w as usize);
            usize $i = $row;
            while ($i < $end) {
                $this->data[$i] = $this->data[$i] * $s;
                $i = $i + 1;
            }

            $iz = $iz + 1;
        }
    }

    /**
     * Apply `$s` to the cached min/max once the samples are all scaled.
     */
    internal function commitScale(float32 $s) : void
    {
        $this->lo = $this->lo * $s;
        $this->hi = $this->hi * $s;
        if ($s < 0.0f) {
            float32 $swap = $this->lo;
            $this->lo = $this->hi;
            $this->hi = $swap;
        }
    }

    /**
     * Row-major samples, `width * height`, borrowed in place. No copy; writes go through `set`.
     */
    public const function samples() : const array<float32>&
    {
        return &$this->data;
    }

    /**
     * Central-difference world-space normal, Y-up. Neighbours clamp at the edge.
     * Y is 2 so the slope matches a span of two cells; `1 / ppu` is the cell size.
     */
    public const function normal(int32 $ix, int32 $iz) : Vec3
    {
        int32 $xL = $ix - 1;
        int32 $xR = $ix + 1;
        int32 $zD = $iz - 1;
        int32 $zU = $iz + 1;

        if ($xL < 0) {
            $xL = 0;
        }

        if ($xR >= $this->width) {
            $xR = $this->width - 1;
        }

        if ($zD < 0) {
            $zD = 0;
        }

        if ($zU >= $this->height) {
            $zU = $this->height - 1;
        }

        float32 $cell = 1.0f / $this->ppu;
        float32 $dx = ($this->at($xR, $iz) - $this->at($xL, $iz)) / $cell;
        float32 $dz = ($this->at($ix, $zU) - $this->at($ix, $zD)) / $cell;
        return normalize(Vec3(-$dx, 2.0f, -$dz));
    }

    /**
     * World X of column `$ix`. Column 0 is `-width / (2 * ppu)`.
     */
    public const function worldX(int32 $ix) : float32
    {
        return (($ix as float32) - ($this->width as float32) * 0.5f) / $this->ppu;
    }

    /**
     * World Z of row `$iz`. Row 0 is `-height / (2 * ppu)`.
     */
    public const function worldZ(int32 $iz) : float32
    {
        return (($iz as float32) - ($this->height as float32) * 0.5f) / $this->ppu;
    }

    /**
     * Height at world XZ, or null outside the grid.
     */
    public const function sample(float32 $x, float32 $z) : float32?
    {
        float32 $px = $x * $this->ppu + ($this->width as float32) * 0.5f;
        float32 $pz = $z * $this->ppu + ($this->height as float32) * 0.5f;
        float32 $w = $this->width as float32;
        float32 $h = $this->height as float32;

        if ($px < 0.0f || $pz < 0.0f || $px >= $w || $pz >= $h) {
            return null;
        }

        int32 $ix0 = std::math::floor($px) as int32;
        int32 $iz0 = std::math::floor($pz) as int32;
        int32 $ix1 = $ix0 + 1;
        int32 $iz1 = $iz0 + 1;

        if ($ix1 >= $this->width) {
            $ix1 = $this->width - 1;
        }

        if ($iz1 >= $this->height) {
            $iz1 = $this->height - 1;
        }

        float32 $fx = $px - ($ix0 as float32);
        float32 $fz = $pz - ($iz0 as float32);
        float32 $h00 = $this->at($ix0, $iz0);
        float32 $h10 = $this->at($ix1, $iz0);
        float32 $h01 = $this->at($ix0, $iz1);
        float32 $h11 = $this->at($ix1, $iz1);
        return mix(mix($h00, $h10, $fx), mix($h01, $h11, $fx), $fz);
    }

    /**
     * Surface hit along `$ray`, or null if the ray misses the heightfield.
     * Clips to `bounds()` first, then binary-searches that interval `$lookups` times.
     */
    public const function cast(const Ray& $ray, float32 $maxDistance = 1000.0f, int32 $lookups = 16) : Vec3?
    {
        AABB $box = $this->bounds();
        Vec2 $span = guard $box->hitInterval($ray) else {
            return null;
        }

        float32 $t0 = $span->x;
        float32 $t1 = $span->y;
        if ($t1 > $maxDistance) {
            $t1 = $maxDistance;
        }

        if ($t0 > $t1) {
            return null;
        }

        int32 $n = $lookups;
        if ($n < 1) {
            $n = 1;
        }

        int32 $i = 0;
        while ($i < $n) {
            float32 $t = ($t0 + $t1) * 0.5f;
            Vec3 $p = $ray->at($t);
            float32? $sampled = $this->sample($p->x, $p->z);
            float32 $height = $sampled ?? ($p->y - 1.0f);
            if ($p->y > $height) {
                $t0 = $t;
            } else {
                $t1 = $t;
            }

            $i = $i + 1;
        }

        Vec3 $hit = $ray->at($t1);
        float32 $h = guard $this->sample($hit->x, $hit->z) else {
            return null;
        }

        if ($hit->y > $h + 0.5f) {
            return null;
        }

        return Vec3($hit->x, $h, $hit->z);
    }

    /**
     * Lowest sample. Cached; `set` widens it and leaves it standing when an extreme is vacated.
     */
    public const function min() : float32
    {
        return $this->lo;
    }

    /**
     * Highest sample. Cached; `set` widens it and leaves it standing when an extreme is vacated.
     */
    public const function max() : float32
    {
        return $this->hi;
    }

    /**
     * True when min/max may be wider than the samples. `recount` clears it.
     */
    public const function loose() : bool
    {
        return $this->loose;
    }

    /**
     * Walk every sample and store exact min/max. For save/load and a console verb, never a stroke.
     */
    public function recount() : void
    {
        float32 $lo = $this->data[0];
        float32 $hi = $lo;
        foreach ($this->data as $h) {
            if ($h < $lo) {
                $lo = $h;
            }

            if ($h > $hi) {
                $hi = $h;
            }
        }

        $this->lo = $lo;
        $this->hi = $hi;
        $this->loose = false;
    }

    /**
     * World AABB covering every grid vertex. Y uses the cached min/max, never a full recount.
     */
    public const function bounds() : AABB
    {
        return AABB(
            Vec3($this->worldX(0), $this->lo, $this->worldZ(0)),
            Vec3($this->worldX($this->width - 1), $this->hi, $this->worldZ($this->height - 1))
        );
    }

    /**
     * Inclusive vertex rectangle. `$range.x` is min height, `$range.y` is max.
     */
    public const function range(int32 $ix0, int32 $iz0, int32 $ix1, int32 $iz1) : Vec2
    {
        $this->checkRect($ix0, $iz0, $ix1, $iz1);
        float32 $lo = $this->at($ix0, $iz0);
        float32 $hi = $lo;

        for (int32 $iz = $iz0; $iz <= $iz1; $iz = $iz + 1) {
            for (int32 $ix = $ix0; $ix <= $ix1; $ix = $ix + 1) {
                float32 $h = $this->at($ix, $iz);
                if ($h < $lo) {
                    $lo = $h;
                }

                if ($h > $hi) {
                    $hi = $h;
                }
            }
        }

        return Vec2($lo, $hi);
    }

    /**
     * World AABB of an inclusive vertex rectangle. Y from the samples in that rect.
     */
    public const function bounds(int32 $ix0, int32 $iz0, int32 $ix1, int32 $iz1) : AABB
    {
        Vec2 $y = $this->range($ix0, $iz0, $ix1, $iz1);
        return AABB(
            Vec3($this->worldX($ix0), $y->x, $this->worldZ($iz0)),
            Vec3($this->worldX($ix1), $y->y, $this->worldZ($iz1))
        );
    }

    private const function checkRect(int32 $ix0, int32 $iz0, int32 $ix1, int32 $iz1) : void
    {
        assert($ix0 >= 0 && $iz0 >= 0, 'heightmap rect min');
        assert($ix1 >= $ix0 && $iz1 >= $iz0, 'heightmap rect empty');
        assert($ix1 < $this->width && $iz1 < $this->height, 'heightmap rect max');
    }
}
