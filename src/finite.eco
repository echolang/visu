/**
 * Optional swap cap for demos.
 * `--define VISU_FINITE` stops after 120 frames; without it the loop runs until the window closes.
 */

namespace visu;

public const VERSION = '0.2.0';
public const FINITE_FRAMES = 120;

public function finiteFrames() : int32?
{
    #[if: VISU_FINITE]
    return FINITE_FRAMES;
    #[else]
    return null;
    #[end]
}

public function finiteDone(int32 $n) : bool
{
    int32 $cap = guard finiteFrames() else {
        return false;
    }
    return $n >= $cap;
}
