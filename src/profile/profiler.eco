/**
 * Hierarchical CPU + GPU scopes. `begin('name')` / `end()` nest into a persistent interned
 * tree; the pipeline opens one CPU scope per pass and passes open sub-scopes inside. GPU time
 * per scope is the sum of encoders opened while that CPU node was current, so a scope that
 * never opened an encoder has no GPU time, not zero GPU time. HUD `GPU:` / the `render` row
 * takes the scene busy union (`GpuPublish.busyNs`) instead of a sum of overlapping stages.
 *
 * Frames complete late: GPU publishes land FRAMES_IN_FLIGHT frames after the frame ran, so
 * ended frames wait in a small ring until `mergeGpu` sees their `gpuFrame`. Names should be
 * literals: an interpolated name allocates per call and never folds with its siblings.
 *
 * Process singleton like `visu::app::flags()`: Host attaches the device, GameLoop owns the frame
 * boundaries, and a `begin` outside a frame opens one lazily. Single-threaded; `$open` is what
 * would become per-thread once Echo has thread-local storage.
 *
 * Under `--define VISU_RELEASE` every measuring body is empty: no tree, no ring, no stats, and the
 * device never samples. Call sites stay unconditional.
 */

namespace visu::profile;

use std::time;
use visu::graphics::{DrawCounters, DrawStats, FRAMES_IN_FLIGHT, GpuProfiler, GpuPublish, GpuSpan};

public const int32 MAX_DEPTH = 16;
/** what the console and the overlay say when `enabled()` is false */
public const string PROFILE_DISABLED_NOTE = 'profiling compiled out (VISU_RELEASE)';
internal const usize RING = (FRAMES_IN_FLIGHT as usize) + 1;
internal const usize SCOPE_ROOM = 64;

internal struct OpenScope
{
    public int32 $node;
    public time::instant $t0;
    public DrawStats $draws0;
}

internal struct ScopeDef
{
    public int32 $parent = -1;
    public int32 $depth = 0;
    public string $name = '';
    public string $path = '';
    public array<int32> $children = array<int32>();
}

internal struct ScopeValues
{
    public int32 $calls = 0;
    public float64 $cpuNs = 0.0;
    public float64 $gpuNs = 0.0;
    public int32 $gpuSpans = 0;
    public DrawStats $draw = DrawStats();
}

/**
 * An ended frame waiting for its GPU spans. Reused in a RING-sized pool; `$frame` < 0 is empty.
 */
internal class PendingFrame
{
    public int32 $frame;
    public uint64 $gpuFrame;
    public float64 $submitNs;
    public usize $n;
    public array<ScopeValues> $values;

    public constructor()
    {
        $this->frame = -1;
        $this->gpuFrame = 0;
        $this->submitNs = 0.0;
        $this->n = 0;
        $this->values = arr::room<ScopeValues>(SCOPE_ROOM);
    }
}

public class Profiler
{
    public StatsBook $stats;
    public GpuProfiler? $timeline;
    private DrawCounters? $draws;
    private array<ScopeDef> $defs;
    private array<ScopeValues> $live;
    private array<OpenScope> $open;
    private int32 $frame;
    private uint64 $gpuFrame;
    private bool $bound;
    private bool $inFrame;
    private time::instant $frameStart;
    private array<PendingFrame> $pending;
    private array<FrameProfile> $done;
    private FrameProfile? $latest;
    private int32 $renderId;

    public constructor()
    {
        $this->stats = StatsBook();
        $this->timeline = null;
        $this->draws = null;
        $this->defs = arr::room<ScopeDef>(SCOPE_ROOM);
        $this->live = arr::room<ScopeValues>(SCOPE_ROOM);
        $this->open = arr::room<OpenScope>(MAX_DEPTH as usize);
        $this->frame = -1;
        $this->gpuFrame = 0;
        $this->bound = false;
        $this->inFrame = false;
        $this->frameStart = time::instant::now();
        $this->pending = array<PendingFrame>();
        $this->pending->reserve(RING);
        usize $i = 0;

        while ($i < RING) {
            $this->pending[] = PendingFrame();
            $i = $i + 1;
        }

        $this->done = array<FrameProfile>();
        $this->latest = null;
        $this->renderId = -1;
        $this->internRoot();
    }

    /**
     * Host calls this once: draw counters for per-scope draw deltas, the timeline for GPU spans.
     */
    public function attach(DrawCounters $draws, GpuProfiler $timeline) : void
    {
        $this->timeline = $timeline;
        #[if: !VISU_RELEASE]
        $this->draws = $draws;
        #[end]
    }

    /**
     * Open a frame. A frame left open by an early return ends here first.
     */
    public function beginFrame() : void
    {
        #[if: !VISU_RELEASE]
        if ($this->inFrame) {
            $this->endFrame();
        }

        $this->openFrame();
        #[end]
    }

    /**
     * Tie the open frame to the device frame whose encoders it opens, and to the host frame index.
     */
    public function bindFrame(uint64 $gpuFrame, int32 $frame) : void
    {
        #[if: !VISU_RELEASE]
        if (!$this->inFrame) {
            $this->openFrame();
        }

        $this->gpuFrame = $gpuFrame;
        $this->frame = $frame;
        $this->bound = true;
        #[end]
    }

    /**
     * Close the frame. Open scopes are a wiring bug; they are closed anyway so the tree stays sane.
     */
    public function endFrame() : void
    {
        #[if: !VISU_RELEASE]
        if (!$this->inFrame) {
            return;
        }

        assert($this->open->empty(), 'profile: endFrame with open scopes');

        while (!$this->open->empty()) {
            $this->end();
        }

        ScopeValues& $root = $this->live->at(0);
        $root->calls = 1;
        $root->cpuNs = (time::instant::now() - $this->frameStart)->as_nanos() as float64;
        $this->inFrame = false;
        bool $waitsForGpu = $this->bound && $this->gpuSupported();

        if (!$waitsForGpu) {
            usize $n = $this->live->count();
            array<ScopeValues> $values = $this->live;
            $this->finishValues($values, $n, $this->frame, $this->gpuFrame, 0.0, false);
            return;
        }

        PendingFrame $slot = $this->takeSlot();
        $this->storeLive($slot);
        $slot->frame = $this->frame;
        $slot->gpuFrame = $this->gpuFrame;
        $slot->submitNs = 0.0;
        #[end]
    }

    public function begin(const string& $name) : void
    {
        #[if: !VISU_RELEASE]
        if (!$this->inFrame) {
            $this->openFrame();
        }

        int32 $parent = 0;

        if (!$this->open->empty()) {
            $parent = $this->open[$this->open->count() - 1]->node;
        }

        int32 $id = $this->childId($parent, $name);

        if ($id < 0) {
            $id = $this->intern($parent, $name);
        }

        ScopeValues& $node = $this->live->at($id as usize);
        $node->calls = $node->calls + 1;
        $this->open[] = OpenScope($id, time::instant::now(), $this->drawsNow());
        #[end]
    }

    public function end() : void
    {
        #[if: !VISU_RELEASE]
        assert(!$this->open->empty(), 'profile: end without begin');

        if ($this->open->empty()) {
            return;
        }

        OpenScope $top = $this->open[$this->open->count() - 1];
        $this->open->pop();
        ScopeValues& $node = $this->live->at($top->node as usize);
        $node->cpuNs = $node->cpuNs + ((time::instant::now() - $top->t0)->as_nanos() as float64);
        $node->draw = addDraws($node->draw, $this->drawsNow()->since($top->draws0));
        #[end]
    }

    /**
     * Open scope count; 0 between frames and always 0 under VISU_RELEASE.
     */
    public const function depth() : int32
    {
        return $this->open->count() as int32;
    }

    /**
     * Close down to `$mark` open scopes. A pass that left a scope open is a wiring bug.
     */
    public function close(int32 $mark) : void
    {
        #[if: !VISU_RELEASE]
        assert($this->depth() == $mark + 1, 'profile: scope left open');

        while ($this->depth() > $mark) {
            $this->end();
        }
        #[end]
    }

    /**
     * Fold the attached timeline's resolved spans into the frame they belong to and complete it,
     * along with any older frame still waiting. Repeated calls that drain an empty inbox are no-ops.
     */
    public function mergeGpu() : void
    {
        #[if: !VISU_RELEASE]
        GpuProfiler $timeline = guard $this->timeline else {
            return;
        }

        array<GpuPublish> $pubs = $timeline->take();
        if ($pubs->empty()) {
            return;
        }

        foreach ($pubs as $pub) {
            $this->finishOlderThan($pub->frame);
            usize $i = 0;

            while ($i < RING) {
                PendingFrame $p = $this->pending[$i];

                if ($p->frame >= 0 && $p->gpuFrame == $pub->frame) {
                    $this->fold($p, $pub->spans, $pub->busyNs);
                    $this->finish($p, true);
                }

                $i = $i + 1;
            }
        }
        #[end]
    }

    /**
     * Oldest completed frame not yet taken, or null.
     */
    public function complete() : FrameProfile?
    {
        if ($this->done->empty()) {
            return null;
        }

        FrameProfile $f = $this->done[0];
        $this->done->remove(0);
        return $f;
    }

    /**
     * Most recently completed frame, whether or not it was taken.
     */
    public const function latest() : FrameProfile?
    {
        return $this->latest;
    }

    /**
     * Complete every waiting frame without GPU time. Host.destroy, after the device went idle.
     */
    public function abandon() : void
    {
        #[if: !VISU_RELEASE]
        if ($this->inFrame) {
            $this->endFrame();
        }

        usize $i = 0;

        while ($i < RING) {
            PendingFrame $p = $this->pending[$i];

            if ($p->frame >= 0) {
                $this->finish($p, false);
            }

            $i = $i + 1;
        }
        #[end]
    }

    public function reset() : void
    {
        $this->stats->reset();
    }

    public const function gpuSupported() : bool
    {
        GpuProfiler $tl = guard $this->timeline else {
            return false;
        }
        return $tl->supported;
    }

    /**
     * Innermost open CPU node id (interned), or -1 between scopes. Encoder timestamps capture this.
     */
    public const function currentNode() : int32
    {
        if ($this->open->empty()) {
            return -1;
        }

        return $this->open[$this->open->count() - 1]->node;
    }

    private function internRoot() : void
    {
        ScopeDef $root = ScopeDef();
        $root->name = 'frame';
        $this->defs[] = $root;
        $this->live[] = ScopeValues();
    }

    private function openFrame() : void
    {
        usize $n = $this->live->count();
        usize $i = 0;

        while ($i < $n) {
            $this->live[$i] = ScopeValues();
            $i = $i + 1;
        }

        $this->open->clear();
        $this->frame = -1;
        $this->gpuFrame = 0;
        $this->bound = false;
        $this->inFrame = true;
        $this->frameStart = time::instant::now();
    }

    private function childId(int32 $parent, const string& $name) : int32
    {
        if ($parent < 0 || ($parent as usize) >= $this->defs->count()) {
            return -1;
        }

        foreach ($this->defs[$parent as usize]->children as $child) {
            if ($this->defs[$child as usize]->name == $name) {
                return $child;
            }
        }

        return -1;
    }

    private function intern(int32 $parent, const string& $name) : int32
    {
        ScopeDef& $p = $this->defs->at($parent as usize);
        assert($p->depth + 1 < MAX_DEPTH, 'profile: scopes nested deeper than MAX_DEPTH');
        int32 $depth = $p->depth + 1;
        string $parentPath = $p->path;
        int32 $id = $this->defs->count() as int32;
        $p->children[] = $id;
        ScopeDef $n = ScopeDef();
        $n->parent = $parent;
        $n->depth = $depth;
        $n->name = $name;
        $n->path = $name;

        if (!$parentPath->empty()) {
            $n->path = "{$parentPath}/{$name}";
        }

        // the append may move the array, so the parent borrow is done before it
        $this->defs[] = $n;
        $this->live[] = ScopeValues();

        if ($n->path == 'render') {
            $this->renderId = $id;
        }

        return $id;
    }

    /**
     * The device's running draw counters, or zeros before Host attached them.
     */
    private const function drawsNow() : DrawStats
    {
        DrawCounters $dc = guard $this->draws else {
            return DrawStats();
        }
        return $dc->frame;
    }

    private function takeSlot() : PendingFrame
    {
        int32 $oldest = -1;
        uint64 $oldestGpu = 0;
        usize $i = 0;

        while ($i < RING) {
            PendingFrame $p = $this->pending[$i];

            if ($p->frame < 0) {
                return $p;
            }

            if ($oldest < 0 || $p->gpuFrame < $oldestGpu) {
                $oldest = $i as int32;
                $oldestGpu = $p->gpuFrame;
            }

            $i = $i + 1;
        }

        PendingFrame $drop = $this->pending[$oldest as usize];
        $this->finish($drop, false);
        return $drop;
    }

    private function storeLive(PendingFrame $slot) : void
    {
        usize $n = $this->live->count();

        while ($slot->values->count() < $n) {
            $slot->values[] = ScopeValues();
        }

        usize $i = 0;

        while ($i < $n) {
            $slot->values[$i] = $this->live[$i];
            $i = $i + 1;
        }

        $slot->n = $n;
    }

    private function finishOlderThan(uint64 $gpuFrame) : void
    {
        while (true) {
            int32 $best = -1;
            uint64 $bestGpu = 0;
            usize $i = 0;

            while ($i < RING) {
                PendingFrame $p = $this->pending[$i];

                if ($p->frame >= 0 && $p->gpuFrame < $gpuFrame) {
                    if ($best < 0 || $p->gpuFrame < $bestGpu) {
                        $best = $i as int32;
                        $bestGpu = $p->gpuFrame;
                    }
                }

                $i = $i + 1;
            }

            if ($best < 0) {
                return;
            }

            $this->finish($this->pending[$best as usize], false);
        }
    }

    /**
     * Add exclusive encoder time to interned nodes, roll up to parents, then give `render` and
     * the root the scene busy union when `$busyNs` is present.
     */
    private function fold(PendingFrame $p, const array<GpuSpan>& $spans, float64 $busyNs) : void
    {
        usize $count = $p->n;
        foreach ($spans as $s) {
            if ($s->ns <= 0.0 || $s->scope < 0 || ($s->scope as usize) >= $count) {
                continue;
            }

            ScopeValues& $n = $p->values->at($s->scope as usize);
            $n->gpuNs = $n->gpuNs + $s->ns;
            $n->gpuSpans = $n->gpuSpans + 1;
        }

        usize $i = $count;

        while ($i > 1) {
            $i = $i - 1;
            ScopeValues& $child = $p->values->at($i);

            if ($child->gpuSpans == 0) {
                continue;
            }

            int32 $parent = $this->defs[$i]->parent;

            if ($parent < 0) {
                continue;
            }

            ScopeValues& $par = $p->values->at($parent as usize);
            $par->gpuNs = $par->gpuNs + $child->gpuNs;
            $par->gpuSpans = $par->gpuSpans + $child->gpuSpans;
        }

        $p->submitNs = $busyNs;

        if ($busyNs > 0.0) {
            int32 $render = $this->renderId;

            if ($render >= 0 && ($render as usize) < $count) {
                ScopeValues& $owner = $p->values->at($render as usize);
                $owner->gpuNs = $busyNs;
                $owner->gpuSpans = 1;
            }

            ScopeValues& $root = $p->values->at(0);
            $root->gpuNs = $busyNs;
            $root->gpuSpans = 1;
        }
    }

    private function finish(PendingFrame $p, bool $gpuResolved) : void
    {
        $this->finishValues($p->values, $p->n, $p->frame, $p->gpuFrame, $p->submitNs, $gpuResolved);
        $p->frame = -1;
    }

    private function finishValues(
        const array<ScopeValues>& $values,
        usize $count,
        int32 $frame,
        uint64 $gpuFrame,
        float64 $submitNs,
        bool $gpuResolved
    ) : void
    {
        FrameProfile $f = FrameProfile(
            $frame,
            $gpuFrame,
            $this->gpuSupported(),
            $gpuResolved,
            $submitNs,
            $this->assemble($values, $count)
        );
        $this->stats->note($f);
        $this->done[] = $f;
        $this->latest = $f;
    }

    private function assemble(const array<ScopeValues>& $values, usize $count) : array<ScopeNode>
    {
        array<int32> $map = arr::room<int32>($count);
        usize $i = 0;

        while ($i < $count) {
            $map[] = -1;
            $i = $i + 1;
        }

        array<ScopeNode> $nodes = arr::room<ScopeNode>($count);
        $i = 0;

        while ($i < $count) {
            if ($values[$i]->calls == 0) {
                $i = $i + 1;
                continue;
            }

            int32 $cid = $nodes->count() as int32;
            $map[$i] = $cid;
            ScopeDef $d = $this->defs[$i];
            ScopeValues $v = $values[$i];
            ScopeNode $n = ScopeNode();
            $n->parent = -1;

            if ($d->parent >= 0) {
                $n->parent = $map[$d->parent as usize];
            }

            $n->depth = $d->depth;
            $n->name = $d->name;
            $n->path = $d->path;
            $n->calls = $v->calls;
            $n->cpuNs = $v->cpuNs;
            $n->gpuNs = $v->gpuNs;
            $n->gpuSpans = $v->gpuSpans;
            $n->draw = $v->draw;
            $nodes[] = $n;

            if ($n->parent >= 0) {
                ScopeNode& $par = $nodes->at($n->parent as usize);
                $par->children[] = $cid;
            }

            $i = $i + 1;
        }

        return $nodes;
    }
}

internal function addDraws(const DrawStats& $a, const DrawStats& $b) : DrawStats
{
    DrawStats $d = DrawStats();
    $d->draws = $a->draws + $b->draws;
    $d->indexed = $a->indexed + $b->indexed;
    $d->pipelineBinds = $a->pipelineBinds + $b->pipelineBinds;
    $d->vertices = $a->vertices + $b->vertices;
    $d->triangles = $a->triangles + $b->triangles;
    $d->patches = $a->patches + $b->patches;
    return $d;
}

internal class ProcessProfiler
{
    public static Profiler? $held = null;
}

public function installProfiler(Profiler $profiler) : void
{
    ProcessProfiler::$held = $profiler;
}

/**
 * The process profiler. Fill-if-absent so a system may open scopes before Host exists.
 */
public function profiler() : Profiler
{
    Profiler? $held = ProcessProfiler::$held;
    if ($held != null) {
        Profiler $current = guard $held;
        return $current;
    }

    Profiler $fresh = Profiler();
    installProfiler($fresh);
    return $fresh;
}

/**
 * Open a scope on the process profiler. Literal names only.
 */
#[inline]
public function begin(const string& $name) : void
{
    #[if: !VISU_RELEASE]
    profiler()->begin($name);
    #[end]
}

#[inline]
public function end() : void
{
    #[if: !VISU_RELEASE]
    profiler()->end();
    #[end]
}

/**
 * False under `--define VISU_RELEASE`, where every scope is compiled to nothing.
 */
public function enabled() : bool
{
    #[if: VISU_RELEASE]
    return false;
    #[else]
    return true;
    #[end]
}
