/**
 * First-word name table for debug-console handlers.
 * Duplicate names assert; that is a wiring bug.
 */

namespace visu::runtime;

public class ConsoleCommandRegistry
{
    private map<string, ConsoleCommandHandler> $handlers;
    private map<string, string> $usages;
    private array<string> $names;

    public constructor()
    {
        $this->handlers = map<string, ConsoleCommandHandler>();
        $this->usages = map<string, string>();
        $this->names = array<string>();
    }

    public function add(string $name, ConsoleCommandHandler $handler, string $usage = '') : void
    {
        assert(!$this->handlers->has($name), 'console: command already registered');
        $this->handlers[$name] = $handler;
        $this->usages[$name] = $usage;
        $this->names[] = $name;
    }

    public function find(string $name) : ConsoleCommandHandler?
    {
        if (!$this->handlers->has($name)) {
            return null;
        }

        return $this->handlers->get($name);
    }

    /**
     * Synopsis passed to add, or empty when the handler did not give one.
     */
    public function usage(string $name) : string
    {
        if (!$this->usages->has($name)) {
            return '';
        }

        return $this->usages->get($name);
    }

    /**
     * Insertion order. `help` lists these after the builtins.
     */
    public function names() : array<string>
    {
        return $this->names->clone();
    }

    /**
     * Drop one name. False when it was not registered.
     */
    public function remove(string $name) : bool
    {
        if (!$this->handlers->has($name)) {
            return false;
        }

        $this->handlers->remove($name);
        if ($this->usages->has($name)) {
            $this->usages->remove($name);
        }

        array<string> $kept = array<string>();
        foreach ($this->names as $held) {
            if ($held != $name) {
                $kept[] = $held;
            }
        }
        $this->names = $kept;
        return true;
    }

    public function clear() : void
    {
        $this->handlers->clear();
        $this->usages->clear();
        $this->names->clear();
    }
}
