/**
 * Optional system capability: named debug-console verbs.
 * `Systems.bind` notices whoever conforms; `Systems.register` then asks for names.
 */

namespace visu::runtime;

use visu::signal::ConsoleCommandSignal;

public interface ConsoleCommandHandler
{
    /**
     * Register verbs and return the names this handler added, so Systems can drop only those.
     */
    function registerConsoleCommands(ConsoleCommandRegistry $registry) : array<string>;
    function onConsoleCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void;
}
