/**
 * Tilde / Ctrl+C command line.
 * Types into a buffer, dispatches ConsoleCommand on enter.
 * Overlay drawing waits on bitmap fonts.
 * Toggle claims the input-context mutex.
 * ContextMap then skips action handle so bound keys are not stolen while the line is open (`track` still updates down()).
 */

namespace visu::runtime;

use visu::os::input;
use visu::os::input::{InputHub, KeyPhase};
use visu::signal::{Char, ConsoleCommand, Dispatcher, Flow, Key};

internal const HISTORY_LIMIT = 100;
internal const CONSOLE_CONTEXT = 'visu/dev/console';

public class DebugConsole
{
    private Dispatcher $dispatcher;
    private InputHub $input;
    private bool $enabled;
    private string $line;
    private array<string> $history;
    private int32 $historyIndex;
    private int32 $keyId;
    private int32? $charListener;

    public constructor(Dispatcher $dispatcher, InputHub $input)
    {
        $this->dispatcher = $dispatcher;
        $this->input = $input;
        $this->enabled = false;
        $this->line = '';
        $this->history = array<string>();
        $this->historyIndex = 0;
        $this->charListener = null;
        $this->keyId = $this->dispatcher->register<Key>(function(const Key& $signal) : Flow {
            return $this->handleKey($signal);
        }, -1000);
    }

    destructor()
    {
        $this->dispatcher->unregister<Key>($this->keyId);
        if ($this->charListener != null) {
            int32 $id = guard $this->charListener;
            $this->dispatcher->unregister<Char>($id);
            $this->charListener = null;
        }

        if ($this->input->holds(CONSOLE_CONTEXT)) {
            guard $this->input->release(CONSOLE_CONTEXT) else {
                return;
            }
        }
    }

    public const function enabled() : bool
    {
        return $this->enabled;
    }

    public const function line() : string
    {
        return $this->line;
    }

    public function writeLine(string $text) : void
    {
        $this->history->push($text);
        if (($this->history->count() as int32) > (HISTORY_LIMIT as int32)) {
            $this->history->remove(0);
        }

        $this->historyIndex = $this->history->count() as int32;
    }

    public function clearHistory() : void
    {
        $this->history->clear();
        $this->historyIndex = 0;
    }

    /**
     * Submit `$raw` as if enter was pressed (tests, and later a typed line).
     */
    public function submit(string $raw) : void
    {
        $this->writeLine($raw);
        $this->line = '';
        $this->dispatcher->dispatch(ConsoleCommand($raw));
    }

    internal function handleKey(const Key& $signal) : Flow
    {
        if ($this->enabled) {
            if ($signal->key == input::Key::enter && $signal->phase == KeyPhase::release) {
                string $raw = $this->line;
                $this->submit($raw);
            }

            if ($signal->key == input::Key::up && $signal->phase == KeyPhase::release) {
                $this->historyIndex = $this->historyIndex - 1;
                if ($this->historyIndex < 0) {
                    $this->historyIndex = 0;
                }

                $this->line = $this->historyLine($this->historyIndex);
            }

            if ($signal->key == input::Key::down && $signal->phase == KeyPhase::release) {
                int32 $end = $this->history->count() as int32;
                $this->historyIndex = $this->historyIndex + 1;
                if ($this->historyIndex > $end) {
                    $this->historyIndex = $end;
                }

                $this->line = $this->historyLine($this->historyIndex);
            }

            if ($signal->key == input::Key::backspace && $signal->phase->down()) {
                usize $n = $this->line->size();
                if ($n > 0) {
                    $this->line = $this->line->sub(0, $n - 1);
                }
            }
        }

        if ($signal->key == input::Key::c && $signal->isControl() && $signal->phase == KeyPhase::press) {
            $this->setEnabled(!$this->enabled);
            return .stop;
        }

        return .proceed;
    }

    internal function handleChar(const Char& $signal) : Flow
    {
        string $ch = guard $signal->text() else {
            return .proceed;
        }
        $this->line->append($ch);
        return .proceed;
    }

    private function setEnabled(bool $on) : void
    {
        if ($on) {
            guard $this->input->claim(CONSOLE_CONTEXT) else {
                return;
            }
            $this->enabled = true;
            if ($this->charListener != null) {
                return;
            }

            int32 $id = $this->dispatcher->register<Char>(function(const Char& $signal) : Flow {
                return $this->handleChar($signal);
            }, -1000);
            $this->charListener = $id;
            return;
        }

        $this->enabled = false;
        if ($this->input->holds(CONSOLE_CONTEXT)) {
            guard $this->input->release(CONSOLE_CONTEXT) else {
                return;
            }
        }

        int32 $id = guard $this->charListener else {
            return;
        }
        $this->dispatcher->unregister<Char>($id);
        $this->charListener = null;
    }

    private const function historyLine(int32 $index) : string
    {
        if ($index < 0) {
            return '';
        }

        if ($index >= ($this->history->count() as int32)) {
            return '';
        }

        return $this->history[$index as usize];
    }
}
