/**
 * Grave or Ctrl+B toggle command line, Escape to close.
 * Types into a buffer with a caret, dispatches ConsoleCommandSignal on enter.
 * Overlay is VG on the backbuffer (Host.attachPass after the instrument HUD).
 * Toggle steals the input-context mutex so FlyUI cannot trap it.
 * ContextMap then skips action handle so bound keys are not stolen while the line is open (`track` still updates down()).
 */

namespace visu::runtime;

use visu::graphics::{Device, Pipeline, TargetRef};
use visu::os::input;
use visu::os::input::{InputHub, KeyPhase};
use visu::signal::{CharSignal, ConsoleCommandSignal, Dispatcher, Flow, KeySignal};
use visu::vg::{Canvas, VgError, VgRenderer};

internal const HISTORY_LIMIT = 100;
internal const CONSOLE_CONTEXT = 'visu/dev/console';
internal const int32 GRAVE_CODEPOINT = 96;
internal const int32 TILDE_CODEPOINT = 126;

public class DebugConsole
{
    public ConsoleCommandRegistry $registry;
    private Dispatcher $dispatcher;
    private InputHub $input;
    private bool $enabled;
    private string $line;
    private usize $caret;
    private array<ConsoleLogLine> $log;
    private array<string> $commands;
    private int32 $commandIndex;
    private string $draft;
    private int32 $logOffset;
    private array<string> $completions;
    private int32 $completionAt;
    private int32 $keyId;
    private int32? $charListener;
    private VgRenderer? $vg;
    private bool $loaded;
    private bool $dead;

    public constructor(Dispatcher $dispatcher, InputHub $input)
    {
        $this->registry = ConsoleCommandRegistry();
        $this->dispatcher = $dispatcher;
        $this->input = $input;
        $this->enabled = false;
        $this->line = '';
        $this->caret = 0;
        $this->log = array<ConsoleLogLine>();
        $this->commands = array<string>();
        $this->commandIndex = 0;
        $this->draft = '';
        $this->logOffset = 0;
        $this->completions = array<string>();
        $this->completionAt = -1;
        $this->charListener = null;
        $this->vg = null;
        $this->loaded = false;
        $this->dead = false;
        $this->keyId = $this->dispatcher->register<KeySignal>(function(const KeySignal& $signal) : Flow {
            return $this->handleKey($signal);
        }, -1000);
    }

    destructor()
    {
        $this->dispatcher->unregister<KeySignal>($this->keyId);
        if ($this->charListener != null) {
            int32 $id = guard $this->charListener;
            $this->dispatcher->unregister<CharSignal>($id);
            $this->charListener = null;
        }

        if ($this->input->holds(CONSOLE_CONTEXT)) {
            guard $this->input->release(CONSOLE_CONTEXT) else {
                $this->destroy();
                return;
            }
        }

        $this->destroy();
    }

    public const function enabled() : bool
    {
        return $this->enabled;
    }

    public const function line() : string
    {
        return $this->line;
    }

    public const function caret() : usize
    {
        return $this->caret;
    }

    /**
     * Copy of the log texts. Overlay and tests read this; writeLine is the mutator.
     */
    public function history() : array<string>
    {
        array<string> $out = array<string>();
        foreach ($this->log as $row) {
            $out[] = $row->text;
        }

        return $out;
    }

    public function writeLine(string $text) : void
    {
        ConsoleLogKind $kind = ConsoleLogKind::output;
        if ($text->starts('usage:') || $text->starts('unknown command:')) {
            $kind = ConsoleLogKind::error;
        }

        $this->pushLog($text, $kind);
    }

    public function writeError(string $text) : void
    {
        $this->pushLog($text, ConsoleLogKind::error);
    }

    public function clearHistory() : void
    {
        $this->log->clear();
        $this->logOffset = 0;
    }

    /**
     * Compile the VG overlay. Command side works without this; attachPass no-ops until it succeeds.
     */
    public function load(Device $device) : status<VgError>
    {
        if ($this->loaded) {
            return .ok;
        }

        VgRenderer $vg = VgRenderer($device);
        guard $vg->load() else ($e) {
            $vg->destroy();
            return .error($e);
        }
        string $bytes = visu::instrument::debugFontBytes();
        guard $vg->canvas->createFont(name: 'debug', bytes: $bytes) else ($e) {
            $vg->destroy();
            return .error($e);
        }
        $this->vg = $vg;
        $this->loaded = true;
        return .ok;
    }

    /**
     * Bottom bar on `$target` when the console is open and the overlay loaded. Host calls this after the instrument HUD.
     */
    public function attachPass(Pipeline $pipeline, TargetRef $target) : void
    {
        if (!$this->enabled || !$this->loaded) {
            return;
        }

        VgRenderer $vg = guard $this->vg else {
            return;
        }
        ConsolePaint $paint = ConsolePaint(
            $this->log->clone(),
            $this->line,
            $this->caret,
            consoleCaretOn(),
            $this->logOffset
        );
        $vg->pass($pipeline, $target, function(Canvas $canvas) : void {
            paintConsole($canvas, $paint);
        });
    }

    /**
     * Drop the VG overlay. Idempotent. Host.destroy waitIdle first.
     */
    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->loaded = false;
        VgRenderer? $maybe = $this->vg;

        if ($maybe != null) {
            VgRenderer $vg = guard $maybe;
            $vg->destroy();
            $this->vg = null;
        }
    }

    /**
     * Submit `$raw` as if enter was pressed (tests, and later a typed line).
     * Empty is a no-op. Dispatches ConsoleCommandSignal first, then routes help / clear / registered names.
     */
    public function submit(string $raw) : void
    {
        if ($raw->empty()) {
            $this->line = '';
            $this->caret = 0;
            return;
        }

        $this->remember($raw);
        $this->pushLog("> {$raw}", ConsoleLogKind::input);
        $this->line = '';
        $this->caret = 0;
        $this->draft = '';
        $this->commandIndex = $this->commands->count() as int32;
        $this->logOffset = 0;
        $this->dropCompletions();
        ConsoleCommandSignal $cmd = ConsoleCommandSignal($raw);
        $this->dispatcher->dispatch($cmd);
        $this->route($cmd);
    }

    internal function handleKey(const KeySignal& $signal) : Flow
    {
        if ($signal->key == input::Key::graveAccent && $signal->phase == KeyPhase::press) {
            $this->setEnabled(!$this->enabled);
            return .stop;
        }

        if ($signal->isControl() && $signal->key == input::Key::b && $signal->phase == KeyPhase::press) {
            $this->setEnabled(!$this->enabled);
            return .stop;
        }

        if (!$this->enabled) {
            return .proceed;
        }

        if ($signal->phase == KeyPhase::release) {
            return .stop;
        }

        if ($signal->key == input::Key::escape && $signal->phase == KeyPhase::press) {
            $this->setEnabled(false);
            return .stop;
        }

        if ($signal->key == input::Key::enter && $signal->phase == KeyPhase::press) {
            $this->submit($this->line);
            return .stop;
        }

        if ($signal->key == input::Key::tab && $signal->phase->down()) {
            $this->complete();
            return .stop;
        }

        if ($signal->isControl() && $signal->key == input::Key::w && $signal->phase->down()) {
            $this->deleteBack(wordPrev($this->line, $this->caret));
            return .stop;
        }

        if ($signal->isAlt() && $signal->key == input::Key::backspace && $signal->phase->down()) {
            $this->deleteBack(wordPrev($this->line, $this->caret));
            return .stop;
        }

        if ($signal->isControl() && $signal->key == input::Key::u && $signal->phase->down()) {
            $this->deleteBack(0);
            return .stop;
        }

        if ($signal->isControl() && $signal->key == input::Key::k && $signal->phase->down()) {
            $this->line = splice($this->line, $this->caret, $this->line->size() - $this->caret, '');
            $this->dropCompletions();
            return .stop;
        }

        if ($signal->key == input::Key::up && $signal->phase->down()) {
            $this->historyUp();
            return .stop;
        }

        if ($signal->key == input::Key::down && $signal->phase->down()) {
            $this->historyDown();
            return .stop;
        }

        if ($signal->key == input::Key::left && $signal->phase->down()) {
            $this->caret = utf8Prev($this->line, $this->caret);
            $this->dropCompletions();
            return .stop;
        }

        if ($signal->key == input::Key::right && $signal->phase->down()) {
            $this->caret = utf8Next($this->line, $this->caret);
            $this->dropCompletions();
            return .stop;
        }

        if ($signal->key == input::Key::home && $signal->phase->down()) {
            $this->caret = 0;
            $this->dropCompletions();
            return .stop;
        }

        if ($signal->key == input::Key::end && $signal->phase->down()) {
            $this->caret = $this->line->size();
            $this->dropCompletions();
            return .stop;
        }

        if ($signal->key == input::Key::backspace && $signal->phase->down()) {
            $this->deleteBack(utf8Prev($this->line, $this->caret));
            return .stop;
        }

        if ($signal->key == input::Key::delete && $signal->phase->down()) {
            usize $next = utf8Next($this->line, $this->caret);
            if ($next > $this->caret) {
                $this->line = splice($this->line, $this->caret, $next - $this->caret, '');
                $this->dropCompletions();
            }

            return .stop;
        }

        if ($signal->key == input::Key::pageUp && $signal->phase->down()) {
            $this->logOffset = $this->logOffset + 8;
            return .stop;
        }

        if ($signal->key == input::Key::pageDown && $signal->phase->down()) {
            $this->logOffset = $this->logOffset - 8;
            if ($this->logOffset < 0) {
                $this->logOffset = 0;
            }

            return .stop;
        }

        return .stop;
    }

    internal function handleChar(const CharSignal& $signal) : Flow
    {
        if ($signal->codepoint < 32) {
            return .stop;
        }

        if ($signal->codepoint == GRAVE_CODEPOINT || $signal->codepoint == TILDE_CODEPOINT) {
            return .stop;
        }

        if ($signal->codepoint == 127) {
            return .stop;
        }

        string $ch = guard $signal->text() else {
            return .stop;
        }
        $this->line = splice($this->line, $this->caret, 0, $ch);
        $this->caret = $this->caret + $ch->size();
        $this->dropCompletions();
        return .stop;
    }

    private function route(const ConsoleCommandSignal& $cmd) : void
    {
        if ($cmd->parts->empty()) {
            return;
        }

        if ($cmd->isAction('help')) {
            string $focus = '';
            if ($cmd->parts->count() >= 2) {
                $focus = $cmd->parts[1];
            }

            $this->writeHelp($focus);
            return;
        }

        if ($cmd->isAction('clear')) {
            $this->clearHistory();
            $this->writeLine('cleared');
            return;
        }

        ConsoleCommandHandler $handler = guard $this->registry->find($cmd->parts[0]) else {
            $this->writeUnknown($cmd->parts[0]);
            return;
        }
        $handler->onConsoleCommand($cmd, $this);
    }

    private function writeHelp(const string& $focus) : void
    {
        if ($focus != '') {
            $this->writeHelpOne($focus);
            return;
        }

        $this->writeLine('help - list commands');
        $this->writeLine('clear - clear the log');
        array<string> $names = $this->registry->names();
        foreach ($names as $name) {
            $this->writeHelpOne($name);
        }
    }

    private function writeHelpOne(const string& $name) : void
    {
        if ($name == 'help') {
            $this->writeLine('help - list commands');
            return;
        }

        if ($name == 'clear') {
            $this->writeLine('clear - clear the log');
            return;
        }

        if ($this->registry->find($name) == null) {
            $this->writeUnknown($name);
            return;
        }

        string $usage = $this->registry->usage($name);
        if ($usage->empty()) {
            $this->writeLine($name);
            return;
        }

        $this->writeLine("{$name} - {$usage}");
    }

    private function writeUnknown(const string& $name) : void
    {
        array<string> $names = $this->verbNames();
        string $guess = guard guessCommand($name, $names) else {
            $this->writeError("unknown command: {$name}. type help");
            return;
        }
        $this->writeError("unknown command: {$name}. did you mean {$guess}?");
    }

    private function verbNames() : array<string>
    {
        array<string> $names = array<string>();
        $names[] = 'help';
        $names[] = 'clear';
        array<string> $reg = $this->registry->names();
        foreach ($reg as $name) {
            $names[] = $name;
        }

        return $names;
    }

    private function complete() : void
    {
        if ($this->line->contains(' ')) {
            return;
        }

        if (!$this->completions->empty()) {
            int32 $n = $this->completions->count() as int32;
            if ($this->completionAt < 0) {
                $this->completionAt = 0;
            } else {
                $this->completionAt = $this->completionAt + 1;
                if ($this->completionAt >= $n) {
                    $this->completionAt = 0;
                }
            }

            string $pick = $this->completions[$this->completionAt as usize];
            $this->setLine($pick);
            return;
        }

        string $stem = $this->line;
        array<string> $matches = array<string>();
        array<string> $names = $this->verbNames();
        foreach ($names as $name) {
            if ($stem->empty() || $name->starts($stem)) {
                $matches[] = $name;
            }
        }

        if ($matches->empty()) {
            return;
        }

        if ($matches->count() == 1) {
            $this->setLine($matches[0]);
            $this->dropCompletions();
            return;
        }

        string $prefix = commonPrefix($matches);
        if ($prefix->size() > $stem->size()) {
            $this->setLine($prefix);
        }

        $this->completions = $matches;
        $this->completionAt = -1;
        foreach ($matches as $name) {
            $this->writeLine($name);
        }
    }

    private function setEnabled(bool $on) : void
    {
        if ($on) {
            $this->input->steal(CONSOLE_CONTEXT);
            $this->enabled = true;
            if ($this->charListener != null) {
                return;
            }

            int32 $id = $this->dispatcher->register<CharSignal>(function(const CharSignal& $signal) : Flow {
                return $this->handleChar($signal);
            }, -1000);
            $this->charListener = $id;
            return;
        }

        $this->enabled = false;
        if ($this->input->holds(CONSOLE_CONTEXT)) {
            guard $this->input->release(CONSOLE_CONTEXT) else {
                return;
            }
        }

        int32 $id = guard $this->charListener else {
            return;
        }
        $this->dispatcher->unregister<CharSignal>($id);
        $this->charListener = null;
    }

    private function historyUp() : void
    {
        int32 $n = $this->commands->count() as int32;
        if ($n == 0) {
            return;
        }

        if ($this->commandIndex == $n) {
            $this->draft = $this->line;
        }

        if ($this->commandIndex > 0) {
            $this->commandIndex = $this->commandIndex - 1;
        }

        string $older = $this->commands[$this->commandIndex as usize];
        $this->setLine($older);
        $this->dropCompletions();
    }

    private function historyDown() : void
    {
        int32 $n = $this->commands->count() as int32;
        if ($this->commandIndex >= $n) {
            return;
        }

        $this->commandIndex = $this->commandIndex + 1;
        if ($this->commandIndex >= $n) {
            string $draft = $this->draft;
            $this->setLine($draft);
            $this->dropCompletions();
            return;
        }

        string $newer = $this->commands[$this->commandIndex as usize];
        $this->setLine($newer);
        $this->dropCompletions();
    }

    private function remember(const string& $raw) : void
    {
        if (!$this->commands->empty()) {
            int32 $last = ($this->commands->count() as int32) - 1;
            if ($this->commands[$last as usize] == $raw) {
                return;
            }
        }

        $this->commands[] = $raw;
        if (($this->commands->count() as int32) > (HISTORY_LIMIT as int32)) {
            $this->commands->remove(0);
        }
    }

    private function pushLog(const string& $text, ConsoleLogKind $kind) : void
    {
        ConsoleLogLine $row = ConsoleLogLine($text, $kind);
        $this->log[] = $row;
        if (($this->log->count() as int32) > (HISTORY_LIMIT as int32)) {
            $this->log->remove(0);
        }

        $this->logOffset = 0;
    }

    private function setLine(const string& $text) : void
    {
        $this->line = $text;
        $this->caret = $text->size();
    }

    private function deleteBack(usize $to) : void
    {
        if ($to >= $this->caret) {
            return;
        }

        $this->line = splice($this->line, $to, $this->caret - $to, '');
        $this->caret = $to;
        $this->dropCompletions();
    }

    private function dropCompletions() : void
    {
        $this->completions->clear();
        $this->completionAt = -1;
    }
}

internal function consoleCaretOn() : bool
{
    int32 $tick = (seconds() * 2.0) as int32;
    return ($tick % 2) == 0;
}
