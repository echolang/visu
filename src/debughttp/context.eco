/**
 * What the Host hands the executor on each drain: the console, the step runner and the frame
 * facts. Built only when a job is taken, so an idle poll builds nothing.
 */

namespace visu::debughttp;

use visu::dcapture::StepRunner;
use visu::runtime::DebugConsole;

public class DebugContext
{
    public DebugConsole? $console;
    public StepRunner $steps;
    public int32 $frame;
    public int32 $tick;
    public int32 $width;
    public int32 $height;
    public int32 $windowWidth;
    public int32 $windowHeight;
    public bool $scripted;

    public constructor(DebugConsole? $console, StepRunner $steps, int32 $frame, int32 $tick)
    {
        $this->console = $console;
        $this->steps = $steps;
        $this->frame = $frame;
        $this->tick = $tick;
        $this->width = 0;
        $this->height = 0;
        $this->windowWidth = 0;
        $this->windowHeight = 0;
        $this->scripted = false;
    }
}
