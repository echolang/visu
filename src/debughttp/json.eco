/**
 * The JSON bodies the debug server answers with.
 */

namespace visu::debughttp;

use visu::app::FlagValue;

internal function errorJson(const string& $message) : string
{
    json::Value $o = json::object();
    $o['error'] = $message;
    return json::dump($o);
}

internal function stringsJson(const array<string>& $items) : json::Value
{
    json::Value $list = json::arr();
    foreach ($items as $item) {
        $list[] = $item;
    }

    return $list;
}

internal function flagJson(FlagValue $value) : json::Value
{
    return match ($value) {
        FlagValue::boolean($v) => json::bool($v),
        FlagValue::integer($n) => json::int($n),
        FlagValue::floating($n) => json::float($n),
        FlagValue::text($s) => json::str($s),
    };
}
