/**
 * What a debug HTTP client asked the running app for. Built on a server worker, answered on the
 * main thread by `DebugExecutor`.
 */

namespace visu::debughttp;

use visu::dcapture::Step;

public enum DebugRequest
{
    case status;

    /**
     * Console lines, run in order on one frame, each with its own captured output.
     */
    case console(array<string> $commands);
    case verbs;
    case flags;
    case setFlag(string $name, string $raw);

    /**
     * A dcapture step object applied now. Its dumps and profiles report into `var/debughttp`.
     */
    case step(Step $step);

    /**
     * Dump every name matching `$pattern` after the next present. `$json` answers with the
     * written paths even when one file matched.
     */
    case snapshot(string $pattern, bool $json);
    case dumps;
    case profile;
    case wait(int32 $frames);
}
