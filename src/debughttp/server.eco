/**
 * The opt-in debug HTTP server: `--flag debug.http=<port>` (and `debug.http.host`, default
 * 127.0.0.1). libhttp listens on its own thread and answers on its workers; every request is
 * posted to the mailbox and answered on the main thread when the Host drains it. Snapshots,
 * the dump catalog and profiles go through a `DumpQueue` of their own under `var/debughttp`,
 * so a dcapture run beside it keeps a clean manifest.
 *
 * A snapshot reads the image back with the device idle, like every dump: one frame hitches.
 */

namespace visu::debughttp;

use std::thread;
use visu::app::info;
use visu::dcapture::DumpQueue;
use visu::graphics::{Frame, Pool};
use visu::os::Window;
use visu::profile::{FrameProfile, StatsBook};

internal const DEBUG_HTTP_OUT = 'var/debughttp';

// a request parked on a frame keeps its worker until it is answered or expires
internal const int32 DEBUG_HTTP_WORKERS = 8;

// a request that waits on frames keeps its worker, so the bind wait is the only sleep here
internal const int32 DEBUG_HTTP_BIND_TRIES = 400;

public class DebugServer
{
    public const string $host;
    private DumpQueue $dumps;
    private int32 $requested;
    private http::Server $http;
    private DebugMailbox $mailbox;
    private DebugExecutor $executor;
    private thread::handle? $thread;
    private thread::mutex<string> $failure;

    /**
     * `$shared` is the Host's dump queue: this server's queue reads its providers.
     */
    public constructor(string $host, int32 $port, DumpQueue $shared)
    {
        $this->host = $host;
        $this->requested = $port;
        $this->dumps = DumpQueue(DEBUG_HTTP_OUT, sharing: $shared);
        $this->http = http::Server();
        $this->mailbox = DebugMailbox();
        $this->executor = DebugExecutor($this->dumps);
        $this->dumps->sink = $this->executor;
        $this->thread = null;
        $this->failure = thread::mutex<string>('');
    }

    /**
     * The bound port, or 0 before `start` succeeded.
     */
    public const function port() : int32
    {
        return $this->http->port();
    }

    /**
     * Bind and serve on a thread of its own. Returns once the port is bound or the bind failed.
     */
    public function start() : status<DebugServerError>
    {
        http::Server $srv = $this->http;
        $srv->workers(DEBUG_HTTP_WORKERS);
        addDebugGuard($srv, $this->host);
        addDebugRoutes($srv, $this->mailbox);
        string $host = $this->host;
        int32 $port = $this->requested;
        thread::mutex<string> $failure = $this->failure;
        thread::handle $handle = guard thread::spawn(function() : void {
            result<int32, http::Error> $r = $srv->listen($host, $port);
            int32 $ignored = guard $r else ($e) {
                thread::locked<string> $held = $failure->lock();
                $held->value = $e->message();
                return;
            }
        }) else ($e) {
            return .error(.spawn($e->message()));
        }
        $this->thread = $handle;
        int32 $tries = 0;
        while ($tries < DEBUG_HTTP_BIND_TRIES) {
            if ($srv->port() > 0) {
                info("debug http: listening on http://{$host}:{$srv->port()}");
                return .ok;
            }

            string $why = $this->failed();
            if (!$why->empty()) {
                $this->join();
                return .error(.bind("{$host}:{$port}", $why));
            }

            thread::sleep(5);
            $tries = $tries + 1;
        }

        $srv->stop();
        $this->join();
        return .error(.bind("{$host}:{$port}", 'timed out waiting for the bind'));
    }

    /**
     * Answer what the workers posted. Main thread, once a poll. One atomic load when idle.
     */
    public function drain(DebugContext $ctx) : void
    {
        DebugJob? $next = $this->mailbox->take();
        while ($next != null) {
            DebugJob $job = guard $next;
            $this->executor->run($job, $ctx);
            $next = $this->mailbox->take();
        }
    }

    /**
     * True when a job is queued. The Host builds a `DebugContext` only then.
     */
    public const function pending() : bool
    {
        return $this->mailbox->waiting();
    }

    /**
     * True while a job waits on a frame. The Host then calls `expire` every poll.
     */
    public const function parked() : bool
    {
        return $this->executor->parked();
    }

    public function expire() : void
    {
        $this->executor->expire();
    }

    /**
     * After present: answer waits that are due, and write the queued snapshots.
     */
    public function afterPresent(Frame $frame, Pool $pool, Window $window, int32 $presented, int32 $tick) : void
    {
        $this->executor->tick($presented + 1);
        $this->dumps->afterPresent($frame, $pool, $window, $presented, $tick);
    }

    public function noteProfile(const FrameProfile& $profile, const StatsBook& $stats) : void
    {
        $this->dumps->noteProfile($profile, $stats);
    }

    /**
     * Answer everything in flight with a 503, stop listening, and join the thread.
     */
    public function stop() : void
    {
        $this->mailbox->close();
        $this->executor->close();
        $this->dumps->sink = null;
        $this->http->stop();
        $this->join();
    }

    private function failed() : string
    {
        thread::locked<string> $held = $this->failure->lock();
        return $held->value->clone();
    }

    private function join() : void
    {
        thread::handle $handle = guard $this->thread else {
            return;
        }
        $this->thread = null;
        $handle->join();
    }
}
