/**
 * Camera / world rectangle. Not the GPU viewport (encoder setViewport).
 */

namespace visu::graphics;

use visu::math::Vec2;

public struct Viewport
{
    public const float32 $left;
    public const float32 $right;
    public const float32 $bottom;
    public const float32 $top;
    public const float32 $screenSpaceWidth;
    public const float32 $screenSpaceHeight;

    /**
     * Viewport width. Can be negative if the viewport is flipped.
     */
    public const float32 $width;

    /**
     * Viewport height. Can be negative if the viewport is flipped.
     */
    public const float32 $height;

    /**
     * World rectangle from edge coordinates plus the screen-space size used to convert points.
     */
    public constructor(
        left: float32 $left,
        right: float32 $right,
        bottom: float32 $bottom,
        top: float32 $top,
        float32 $screenSpaceWidth,
        float32 $screenSpaceHeight
    )
    {
        $this->left = $left;
        $this->right = $right;
        $this->bottom = $bottom;
        $this->top = $top;
        $this->screenSpaceWidth = $screenSpaceWidth;
        $this->screenSpaceHeight = $screenSpaceHeight;
        $this->width = $right - $left;
        $this->height = $bottom - $top;
    }

    /**
     * Absolute width. The stored width can be negative if the viewport is flipped.
     */
    public const function absWidth() : float32
    {
        return std::math::abs($this->width);
    }

    /**
     * Absolute height. The stored height can be negative if the viewport is flipped.
     */
    public const function absHeight() : float32
    {
        return std::math::abs($this->height);
    }

    /**
     * Aspect ratio of the absolute width over the absolute height.
     */
    public const function aspectRatio() : float32
    {
        return $this->absWidth() / $this->absHeight();
    }

    /**
     * Center of the world rectangle.
     */
    public const function center() : Vec2
    {
        return Vec2(($this->left + $this->right) / 2.0f, ($this->bottom + $this->top) / 2.0f);
    }

    /**
     * Top-left corner of the world rectangle.
     */
    public const function topLeft() : Vec2
    {
        return Vec2($this->left, $this->top);
    }

    /**
     * Top-right corner of the world rectangle.
     */
    public const function topRight() : Vec2
    {
        return Vec2($this->right, $this->top);
    }

    /**
     * Bottom-left corner of the world rectangle.
     */
    public const function bottomLeft() : Vec2
    {
        return Vec2($this->left, $this->bottom);
    }

    /**
     * Bottom-right corner of the world rectangle.
     */
    public const function bottomRight() : Vec2
    {
        return Vec2($this->right, $this->bottom);
    }

    /**
     * Bottom-center of the world rectangle.
     */
    public const function bottomCenter() : Vec2
    {
        return Vec2(($this->left + $this->right) / 2.0f, $this->bottom);
    }

    /**
     * Top-center of the world rectangle.
     */
    public const function topCenter() : Vec2
    {
        return Vec2(($this->left + $this->right) / 2.0f, $this->top);
    }

    /**
     * Left-center of the world rectangle.
     */
    public const function leftCenter() : Vec2
    {
        return Vec2($this->left, ($this->bottom + $this->top) / 2.0f);
    }

    /**
     * Right-center of the world rectangle.
     */
    public const function rightCenter() : Vec2
    {
        return Vec2($this->right, ($this->bottom + $this->top) / 2.0f);
    }

    /**
     * Whether `$point` lies inside the rectangle. Flipped edges are sorted first so the test is axis-aligned.
     */
    public const function contains(const Vec2& $point) : bool
    {
        float32 $minX = $this->left;
        float32 $maxX = $this->right;
        float32 $minY = $this->bottom;
        float32 $maxY = $this->top;

        if ($minX > $maxX) {
            float32 $t = $minX;
            $minX = $maxX;
            $maxX = $t;
        }

        if ($minY > $maxY) {
            float32 $t = $minY;
            $minY = $maxY;
            $maxY = $t;
        }

        return $point->x >= $minX && $point->x <= $maxX && $point->y >= $minY && $point->y <= $maxY;
    }

    /**
     * Map a screen-space point into this world rectangle.
     */
    public const function screenSpaceToViewSpace(const Vec2& $point) : Vec2
    {
        return Vec2(
            $this->left + $point->x * $this->width / $this->screenSpaceWidth,
            $this->top + $point->y * $this->height / $this->screenSpaceHeight
        );
    }

    /**
     * Map a point in this world rectangle back to screen space.
     */
    public const function viewSpaceToScreenSpace(const Vec2& $point) : Vec2
    {
        return Vec2(
            ($point->x - $this->left) * $this->screenSpaceWidth / $this->width,
            ($point->y - $this->top) * $this->screenSpaceHeight / $this->height
        );
    }
}
