/**
 * Persistent GPU objects for the render graph. Keyed by resource name.
 * Stores Device; getTarget / cache / collect use the handle.
 */

namespace visu::graphics;

public enum PoolError
{
    case missingImport(string $name);
    case missing(string $name);
    case device(DeviceError $inner);

    public const function message() : string
    {
        return match ($this) {
            PoolError::missingImport($name) => "pool: imported '{$name}' was never set",
            PoolError::missing($name) => "pool: '{$name}' was never created",
            PoolError::device($inner) => $inner->message(),
        };
    }
}

// public: stored in map<string, StoredTarget>; stdlib must name the value type
public class StoredTarget
{
    public RenderTarget $target;
    public array<string> $ownedTextures;
    public bool $imported;

    /**
     * What the target was built for; a ref that no longer matches it rebuilds the target.
     */
    public TargetKey $key;

    public constructor(RenderTarget $target, array<string> $ownedTextures, bool $imported, TargetKey $key)
    {
        $this->target = $target;
        $this->ownedTextures = $ownedTextures;
        $this->imported = $imported;
        $this->key = $key;
    }
}

/**
 * The size, the depth-stencil flag and every attachment (name and options) a pooled target was
 * built from. Built when a target is created; compared field by field every `getTarget`, so the
 * check builds no string.
 */
public struct TargetKey
{
    public int32 $width;
    public int32 $height;
    public bool $depthStencil;
    public array<string> $names;
    public array<TextureOptions> $options;
}

public class StoredTexture
{
    public Texture $texture;
    public bool $imported;
    public string? $parent;

    public constructor(Texture $texture, bool $imported, string? $parent = null)
    {
        $this->texture = $texture;
        $this->imported = $imported;
        $this->parent = $parent;
    }
}

public class Pool
{
    public Device $device;
    private map<string, StoredTarget> $targets;
    private map<string, StoredTexture> $textures;
    private map<string, int32> $used;
    private map<string, map<type_id, erased>> $cached;
    private array<GpuObject> $cachedOwned;
    private int32 $tick;

    /**
     * `collect`'s list of names the tick passed by, kept so a collect allocates nothing.
     */
    private array<string> $stale;

    public constructor(Device $device)
    {
        $this->device = $device;
        $this->targets = map<string, StoredTarget>();
        $this->textures = map<string, StoredTexture>();
        $this->used = map<string, int32>();
        $this->cached = map<string, map<type_id, erased>>();
        $this->cachedOwned = array<GpuObject>();
        $this->tick = 0;
        $this->stale = array<string>();
    }

    public function setCurrentTick(int32 $tick) : void
    {
        $this->tick = $tick;
    }

    public function touch(string $name) : void
    {
        $this->used[$name] = $this->tick;
    }

    /**
     * Import an already-created render target (the window backbuffer).
     */
    public function setTarget(TargetRef $ref, RenderTarget $target) : void
    {
        if ($this->targets->has($ref->name)) {
            StoredTarget $held = $this->targets[$ref->name];
            if ($held->imported) {
                $held->target = $target;
                $this->touch($ref->name);
                return;
            }
        }

        array<string> $none = array<string>();
        $this->targets[$ref->name] = StoredTarget($target, $none, true, targetKey($ref));
        $this->touch($ref->name);
    }

    /**
     * Import an already-created texture.
     * A name the pool already owns stays owned: the blit re-imports scene color
     * under that name, and that is a second graph edge, not a change of owner.
     * An existing import is rebound. A new name is stored as imported.
     */
    public function setTexture(TextureRef $ref, Texture $texture) : void
    {
        if ($this->textures->has($ref->name)) {
            StoredTexture $held = $this->textures[$ref->name];
            $this->touch($ref->name);
            if ($held->imported) {
                $held->texture = $texture;
            }

            return;
        }

        $this->textures[$ref->name] = StoredTexture($texture, true, null);
        $this->touch($ref->name);
    }

    /**
     * The GPU render target for `$ref`, allocating or resizing if needed.
     */
    public function getTarget(TargetRef $ref) : result<RenderTarget, PoolError>
    {
        $this->touchTarget($ref);

        if ($ref->imported) {
            if (!$this->targets->has($ref->name)) {
                return .error(.missingImport($ref->name));
            }

            StoredTarget $imported = $this->targets[$ref->name];
            return .ok($imported->target);
        }

        if ($this->targets->has($ref->name)) {
            StoredTarget $held = $this->targets[$ref->name];
            if (targetKeyMatches($held->key, $ref)) {
                return .ok($held->target);
            }

            $this->dropTarget($ref->name);
        }

        RenderTarget $fresh = guard $this->createTarget($ref) else ($e) {
            return .error($e);
        }
        return .ok($fresh);
    }

    /**
     * Capture `$ref` to a PNG. After endFrame; stalls. Float attachments clamp to 0..1.
     */
    public function dump(TextureRef $ref, const string& $path) : status<DumpError>
    {
        return $this->dump($ref, $path, opaque: false);
    }

    public function dump(TextureRef $ref, const string& $path, opaque: bool $opaque) : status<DumpError>
    {
        return $this->dump($ref, $path, dump: .color);
    }

    public function dump(TextureRef $ref, const string& $path, dump: PixelDump $dump) : status<DumpError>
    {
        Texture $tex = guard $this->getTexture($ref) else ($e) {
            return .error(.io($path, $e->message()));
        }
        return $tex->dump($path, face: 0, 0, dump: $dump);
    }

    /**
     * The GPU texture for `$ref`. Attachments are created by `getTarget`; this never allocates.
     */
    public function getTexture(TextureRef $ref) : result<Texture, PoolError>
    {
        $this->touch($ref->name);

        if ($this->textures->has($ref->name)) {
            StoredTexture $held = $this->textures[$ref->name];
            string $parent = guard $held->parent else {
                return .ok($held->texture);
            }
            $this->touch($parent);
            return .ok($held->texture);
        }

        if ($ref->imported) {
            return .error(.missingImport($ref->name));
        }

        return .error(.missing($ref->name));
    }

    /**
     * Named static cache for the lifetime of the pool (PHP `cacheStaticResource`).
     * Same (name, type) returns the same object. Not tick-collected; `destroy()` tears GPU objects down.
     */
    public function cache<T : GpuObject>(string $name, function<T()> $make) : T
    {
        type_id $id = type_id<T>();

        if ($this->cached->has($name)) {
            map<type_id, erased>& $slot = $this->cached->at($name);

            if ($slot->has($id)) {
                erased $held = $slot->get($id);
                unsafe {
                    return assume<T>($held);
                }
            }
        } else {
            $this->cached[$name] = map<type_id, erased>();
        }

        T $value = $make();
        map<type_id, erased>& $into = $this->cached->at($name);
        $into[$id] = erased::from($value);
        GpuObject $owned = $value;
        $this->cachedOwned->push($owned);
        return $value;
    }

    /**
     * Tick forward and collect. Owned graph textures the last frame touched are
     * destroyed. Imports are forgotten. The static cache is not walked: long-lived
     * GPU objects live on their owner (ModelBank, Device, cache).
     * Call after waitIdle, once the outgoing scene has dropped its handles.
     */
    public function reap() : void
    {
        $this->tick = $this->tick + 1;
        $this->collect();
    }

    /**
     * Destroy owned GPU objects that were not touched this tick, and forget untouched
     * imports (the importer still owns the Texture). A target stays if any owned
     * texture was touched. The static cache is never collected.
     */
    public function collect() : void
    {
        $this->stale->clear();
        foreach ($this->used as $name => $at) {
            if ($at < $this->tick) {
                $this->stale->push($name);
            }
        }

        usize $count = $this->stale->count();
        usize $i = 0;
        while ($i < $count) {
            string $name = $this->stale[$i];
            $i = $i + 1;
            if (!$this->targets->has($name)) {
                continue;
            }

            if ($this->targetHasLiveOwned($name)) {
                continue;
            }

            $this->dropTarget($name);
            $this->used->remove($name);
        }

        $i = 0;
        while ($i < $count) {
            string $name = $this->stale[$i];
            $i = $i + 1;
            if (!$this->used->has($name)) {
                continue;
            }

            if (!$this->textures->has($name)) {
                continue;
            }

            StoredTexture $held = $this->textures[$name];
            string $parent = guard $held->parent else {
                $this->dropTexture($name);
                $this->used->remove($name);
                continue;
            }

            if (!$this->targets->has($parent)) {
                $this->dropTexture($name);
                $this->used->remove($name);
            }
        }
    }

    /**
     * Destroy every owned GPU object. Call at shutdown.
     */
    public function destroy() : void
    {
        array<string> $targetNames = $this->targets->keys();

        foreach ($targetNames as $name) {
            $this->dropTarget($name);
        }

        array<string> $textureNames = $this->textures->keys();

        foreach ($textureNames as $name) {
            $this->dropTexture($name);
        }

        array<GpuObject> $owned = $this->cachedOwned;

        foreach ($owned as $obj) {
            $obj->destroy();
        }

        $this->used->clear();
        $this->cached->clear();
        $this->cachedOwned->clear();
    }

    destructor()
    {
        $this->destroy();
    }

    public const function hasTarget(string $name) : bool
    {
        return $this->targets->has($name);
    }

    public const function hasTexture(string $name) : bool
    {
        return $this->textures->has($name);
    }

    public const function textureCount() : int32
    {
        return $this->textures->count() as int32;
    }

    public const function targetCount() : int32
    {
        return $this->targets->count() as int32;
    }

    public const function cachedCount() : int32
    {
        return $this->cachedOwned->count() as int32;
    }

    /**
     * Every texture the pool holds right now, attachments and imports alike. For dump listings.
     */
    public const function textureNames() : array<string>
    {
        return $this->textures->keys();
    }

    public const function targetNames() : array<string>
    {
        return $this->targets->keys();
    }

    /**
     * A live texture by pool name, without a graph handle. Null when absent; never allocates.
     */
    public function findTexture(string $name) : Texture?
    {
        if (!$this->textures->has($name)) {
            return null;
        }

        StoredTexture $held = $this->textures[$name];
        return $held->texture;
    }

    private function targetHasLiveOwned(string $name) : bool
    {
        StoredTarget $held = $this->targets[$name];
        array<string> $owned = $held->ownedTextures;

        foreach ($owned as $texName) {
            if ($this->used->has($texName) && $this->used[$texName] >= $this->tick) {
                return true;
            }
        }

        return false;
    }

    /**
     * Touch `$ref` and each of its attachments.
     */
    public function touchTarget(TargetRef $ref) : void
    {
        $this->touch($ref->name);
        usize $n = $ref->colorAttachments->count();
        usize $i = 0;
        while ($i < $n) {
            $this->touch($ref->colorAttachments[$i]->name);
            $i = $i + 1;
        }

        TextureRef $depth = guard $ref->depthAttachment else {
            return;
        }
        $this->touch($depth->name);
    }

    private function createTarget(TargetRef $ref) : result<RenderTarget, PoolError>
    {
        RenderTarget $target = RenderTarget($ref->width, $ref->height);
        $target->contentScaleX = $ref->contentScaleX;
        $target->contentScaleY = $ref->contentScaleY;

        array<string> $owned = array<string>();
        array<TextureRef> $colors = $ref->colorAttachments;

        foreach ($colors as $color) {
            $color->width = $ref->width;
            $color->height = $ref->height;
            $this->dropTexture($color->name);
            Texture $tex = $this->makeColor($color, $ref);
            $this->textures[$color->name] = StoredTexture($tex, false, $ref->name);
            $owned->push($color->name);
            $target->colors[] = $tex;
        }

        TextureRef $depth = guard $ref->depthAttachment else {
            return $this->finishTarget($ref, $target, $owned);
        }
        $depth->width = $ref->width;
        $depth->height = $ref->height;
        $this->dropTexture($depth->name);
        Texture $depthTex = $this->makeColor($depth, $ref);
        $this->textures[$depth->name] = StoredTexture($depthTex, false, $ref->name);
        $owned->push($depth->name);
        $target->depth = $depthTex;
        return $this->finishTarget($ref, $target, $owned);
    }

    private function makeColor(TextureRef $ref, TargetRef $target) : Texture
    {
        TextureDesc $desc = $ref->options->desc($target->width, $target->height);
        assert($desc->kind == TextureKind::texture2D, 'pool: cube and array attachments are imported, not pooled');
        $desc->usage = TEXTURE_RENDER_TARGET | TEXTURE_SAMPLED | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
        $desc->label = $ref->name;
        return Texture($this->device, $ref->name, $desc);
    }

    private function finishTarget(
        TargetRef $ref,
        RenderTarget $target,
        array<string> $owned
    ) : result<RenderTarget, PoolError>
    {
        if ($ref->depthStencil && $ref->depthAttachment == null && $target->depth == null) {
            string $dsName = "{$ref->name}.attachment.depthStencil";
            TextureOptions $opt = TextureOptions($format: .depth32fStencil8);
            TextureDesc $desc = $opt->desc($ref->width, $ref->height);
            $desc->usage = TEXTURE_RENDER_TARGET | TEXTURE_SAMPLED | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
            $desc->label = $dsName;
            $this->dropTexture($dsName);
            Texture $ds = Texture($this->device, $dsName, $desc);
            $this->textures[$dsName] = StoredTexture($ds, false, $ref->name);
            $owned->push($dsName);
            $target->depth = $ds;
        }

        $this->targets[$ref->name] = StoredTarget($target, $owned, false, targetKey($ref));
        return .ok($target);
    }

    private function dropTarget(string $name) : void
    {
        if (!$this->targets->has($name)) {
            return;
        }

        StoredTarget $held = $this->targets[$name];
        if ($held->imported) {
            // the window owns the backbuffer; the pool only forgets the name
            $this->targets->remove($name);
            return;
        }

        array<string> $owned = $held->ownedTextures;

        foreach ($owned as $texName) {
            $this->dropTexture($texName);
        }

        $this->targets->remove($name);
    }

    private function dropTexture(string $name) : void
    {
        if (!$this->textures->has($name)) {
            return;
        }

        StoredTexture $held = $this->textures[$name];
        if (!$held->imported) {
            $held->texture->destroy();
        }

        $this->textures->remove($name);
    }
}

/**
 * What `$ref` asks the pool to build: its size, depth-stencil flag and attachments.
 */
public function targetKey(TargetRef $ref) : TargetKey
{
    array<string> $names = array<string>();
    array<TextureOptions> $options = array<TextureOptions>();
    foreach ($ref->colorAttachments as $tex) {
        $names->push($tex->name);
        $options->push($tex->options);
    }

    TextureRef? $depth = $ref->depthAttachment;
    if ($depth != null) {
        TextureRef $held = guard $depth;
        $names->push($held->name);
        $options->push($held->options);
    }

    return TargetKey($ref->width, $ref->height, $ref->depthStencil, $names, $options);
}

/**
 * Whether `$ref` still asks for the target `$key` was built from. Allocates nothing.
 */
public function targetKeyMatches(const TargetKey& $key, TargetRef $ref) : bool
{
    if ($key->width != $ref->width || $key->height != $ref->height || $key->depthStencil != $ref->depthStencil) {
        return false;
    }

    usize $colors = $ref->colorAttachments->count();
    usize $total = $colors;
    if ($ref->depthAttachment != null) {
        $total = $total + 1;
    }

    if ($key->names->count() != $total) {
        return false;
    }

    usize $i = 0;
    while ($i < $colors) {
        TextureRef $tex = $ref->colorAttachments[$i];
        if (!sameAttachment($key, $i, $tex)) {
            return false;
        }

        $i = $i + 1;
    }

    TextureRef $depth = guard $ref->depthAttachment else {
        return true;
    }
    return sameAttachment($key, $colors, $depth);
}

internal function sameAttachment(const TargetKey& $key, usize $at, TextureRef $tex) : bool
{
    TextureOptions $want = $key->options[$at];
    return $key->names[$at] == $tex->name
        && $want->format == $tex->options->format
        && $want->kind == $tex->options->kind
        && $want->mips == $tex->options->mips;
}
