/**
 * Per-frame pass list. `setup()` runs at `add()`; `execute()` runs in scheduled I/O order.
 * Pending clears live here until `RenderContext.beginRender` consumes them.
 * Every pass runs inside a `visu::profile` scope named after it.
 *
 * A Pipeline lives across frames: `reset` empties the pass list and keeps the storage, the
 * scheduler and the graph handles (a target or texture of the same name is the same ref every
 * frame, refilled), so a frame that builds the graph the last one did allocates nothing here.
 */

namespace visu::graphics;

use visu::profile::{Profiler, profiler};

// public: stdlib array<T> / map<K,V> must name T, so module-internal is not enough
public enum Access
{
    case read;
    case write;
}

public enum ResourceIo
{
    case target(TargetRef $ref);
    case texture(TextureRef $ref);
}

public struct Io
{
    public int32 $passIndex;
    public ResourceIo $resource;
    public Access $access;
}

public struct PendingClear
{
    public TargetRef $target;
    public ClearPassOptions $options;
}

public class Pipeline
{
    private Pool $pool;
    private Frame $frame;
    private array<Pass> $passes;
    private map<string, bool> $names;
    private array<Io> $io;
    private map<string, PendingClear> $clears;
    private GraphSchedule $schedule;

    /**
     * Graph handles by name, kept across frames so a ref is refilled, not rebuilt.
     */
    private map<string, TargetRef> $targetRefs;
    private map<string, TextureRef> $textureRefs;
    private BackbufferData? $backbufferData;

    /**
     * Offscreen graph: no window backbuffer. Host records the scene into this, then a second
     * pipeline after `Device.backbuffer()` for blit/overlay.
     */
    public constructor(Pool $pool, Frame $frame)
    {
        $this->pool = $pool;
        $this->frame = $frame;
        $this->passes = array<Pass>();
        $this->names = map<string, bool>();
        $this->io = array<Io>();
        $this->clears = map<string, PendingClear>();
        $this->schedule = GraphSchedule();
        $this->targetRefs = map<string, TargetRef>();
        $this->textureRefs = map<string, TextureRef>();
        $this->backbufferData = null;
    }

    public constructor(Pool $pool, Frame $frame, RenderTarget $backbuffer)
    {
        $this->pool = $pool;
        $this->frame = $frame;
        $this->passes = array<Pass>();
        $this->names = map<string, bool>();
        $this->io = array<Io>();
        $this->clears = map<string, PendingClear>();
        $this->schedule = GraphSchedule();
        $this->targetRefs = map<string, TargetRef>();
        $this->textureRefs = map<string, TextureRef>();
        $this->backbufferData = null;
        $this->publishBackbuffer($backbuffer);
    }

    /**
     * Start the next frame of an offscreen graph: no passes, no claims, no clears. The frame
     * blackboard is the caller's to clear.
     */
    public function reset() : void
    {
        $this->passes->clear();
        $this->names->clear();
        $this->io->clear();
        $this->clears->clear();
    }

    /**
     * Start the next frame of a graph that ends on the window: `reset`, then import `$backbuffer`
     * and publish it again.
     */
    public function reset(RenderTarget $backbuffer) : void
    {
        $this->reset();
        $this->publishBackbuffer($backbuffer);
    }

    /**
     * Drop the frame's passes and clears once it is presented, so nothing they hold outlives the
     * frame (a scene switch destroys GPU objects right after).
     */
    public function release() : void
    {
        $this->reset();
    }

    public function createTarget(string $name, int32 $width, int32 $height) : TargetRef
    {
        return $this->makeTarget($name, $width, $height, false);
    }

    public function createTargetLike(string $name, const RenderTarget& $like) : TargetRef
    {
        TargetRef $ref = $this->makeTarget($name, $like->width, $like->height, false);
        $ref->contentScaleX = $like->contentScaleX;
        $ref->contentScaleY = $like->contentScaleY;
        return $ref;
    }

    public function importTarget(string $name, RenderTarget $target) : TargetRef
    {
        TargetRef $ref = $this->makeTarget($name, $target->width, $target->height, $imported: true);
        $ref->contentScaleX = $target->contentScaleX;
        $ref->contentScaleY = $target->contentScaleY;
        $this->pool->setTarget($ref, $target);
        return $ref;
    }

    public function createColor(TargetRef $target, string $name, TextureOptions $options) : TextureRef
    {
        if ($target->colorCache->has($name)) {
            TextureRef $have = $target->colorCache[$name];
            $this->claimName($have->name);
            $have->width = $target->width;
            $have->height = $target->height;
            $have->options = $options;
            $target->colorAttachments->push($have);
            return $have;
        }

        string $full = "{$target->name}.attachment.color_{$name}";
        $this->claimName($full);
        TextureRef $ref = TextureRef($full, $target->width, $target->height, $options, false);
        $target->colorCache[$name] = $ref;
        $target->colorAttachments->push($ref);
        return $ref;
    }

    public function createDepth(TargetRef $target) : TextureRef
    {
        return $this->createDepth($target, TextureOptions::depth());
    }

    public function createDepth(TargetRef $target, TextureOptions $options) : TextureRef
    {
        TextureRef $ref = guard $target->depthCache else {
            string $full = "{$target->name}.attachment.depth";
            $this->claimName($full);
            TextureRef $fresh = TextureRef($full, $target->width, $target->height, $options, false);
            $target->depthCache = $fresh;
            $target->depthAttachment = $fresh;
            return $fresh;
        }
        $this->claimName($ref->name);
        $ref->width = $target->width;
        $ref->height = $target->height;
        $ref->options = $options;
        $target->depthAttachment = $ref;
        return $ref;
    }

    /**
     * Graph handle for a standalone 2D texture. GPU storage comes from `importTexture` or from `getTarget` when used as an attachment.
     */
    public function createTexture(string $name, int32 $width, int32 $height, TextureOptions $options) : TextureRef
    {
        return $this->makeTexture($name, $width, $height, $options, false);
    }

    public function importTexture(string $name, Texture $texture) : TextureRef
    {
        // describe what was handed in, so a cube or a mip chain does not read back as a plain rgba8 2D texture
        TextureOptions $opt = TextureOptions::from($texture->desc);
        TextureRef $ref = $this->makeTexture($name, $texture->desc->width, $texture->desc->height, $opt, $imported: true);
        $this->pool->setTexture($ref, $texture);
        return $ref;
    }

    /**
     * Remember a clear until `RenderContext.beginRender` or the unconsumed flush at the end of execute.
     */
    public function requestClear(TargetRef $target, ClearPassOptions $options) : void
    {
        $this->clears[$target->name] = PendingClear($target, $options);
    }

    internal function takeClear(TargetRef $target) : ClearPassOptions?
    {
        if (!$this->clears->has($target->name)) {
            return null;
        }

        ClearPassOptions $options = $this->clears[$target->name]->options;
        $this->clears->remove($target->name);
        return $options;
    }

    /**
     * Append `$pass` and run `setup()` immediately so later passes can `get()` data this one published.
     */
    public function add(Pass $pass) : void
    {
        int32 $index = $this->passes->count() as int32;
        $this->passes->push($pass);
        IoSink $io = IoSink($this, $index);
        $pass->setup($this, $this->frame, $io);
    }

    /**
     * Run every pass in scheduled I/O order. `$compensation` defaults to 0 (no interpolation).
     * Unconsumed clears flush as empty render passes so a clear-only frame still clears.
     * `collect:` (default true) runs `Pool.collect` after the passes. Skip it when another
     * execute on the same pool and tick still needs last frame's unreferenced targets.
     */
    public function execute(int32 $tick, float32 $compensation = 0.0f, collect: bool $collect = true) : status<PipelineError>
    {
        $this->pool->setCurrentTick($tick);
        // imports and declarations happen before execute, often on the previous tick
        // this pipeline still owns those names for the tick it is running
        foreach ($this->names as $name => $claimed) {
            $this->pool->touch($name);
        }

        $this->schedule->begin();
        usize $edges = $this->io->count();
        usize $e = 0;
        while ($e < $edges) {
            $this->schedule->record($this->io->at($e));
            $e = $e + 1;
        }

        guard $this->schedule->run($this->passes->count() as int32) else ($err) {
            return .error($err);
        }
        $this->touchIo();

        RenderContext $ctx = RenderContext($this->pool->device, $this, $this->frame, $this->pool, $compensation);
        Profiler $prof = profiler();
        usize $count = $this->schedule->order->count();
        usize $k = 0;
        while ($k < $count) {
            int32 $index = $this->schedule->order[$k];
            $k = $k + 1;
            guard $this->flushClearsForReads($index, $ctx) else ($err) {
                return .error($err);
            }
            $this->transitionReads($index);
            Pass $pass = $this->passes[$index as usize];
            // one CPU scope and debug label per pass; a pass that leaves a sub-scope open is a wiring bug
            int32 $mark = $prof->depth();
            string $passName = $pass->name();
            $prof->begin($passName);
            GpuProfileScope $gpu = $this->pool->device->gpuBegin($passName);
            status<PipelineError> $ran = $pass->execute($ctx);
            $this->pool->device->gpuEnd($gpu);
            $prof->close($mark);
            guard $ran else ($err) {
                return .error($err);
            }
        }

        guard $this->flushClears($ctx) else ($err) {
            return .error($err);
        }

        if ($collect) {
            $this->pool->collect();
        }

        return .ok;
    }


    internal function record(int32 $passIndex, ResourceIo $resource, Access $access) : void
    {
        $this->io->push(Io($passIndex, $resource, $access));
    }

    private function publishBackbuffer(RenderTarget $backbuffer) : void
    {
        // the backbuffer ref is cached by name and always imported, so it is one object for the
        // pipeline's life and so is the fact that carries it
        TargetRef $bb = $this->importTarget('backbuffer', $backbuffer);
        BackbufferData $data = guard $this->backbufferData else {
            BackbufferData $fresh = BackbufferData($bb);
            $this->backbufferData = $fresh;
            $this->frame->set($fresh);
            return;
        }
        $this->frame->set($data);
    }

    /**
     * The cached ref for `$name`, refilled to this frame's size and stripped of last frame's
     * attachments; a fresh one the first time, or when `$imported` changed.
     */
    private function makeTarget(string $name, int32 $width, int32 $height, bool $imported) : TargetRef
    {
        $this->claimName($name);
        if ($this->targetRefs->has($name)) {
            TargetRef $have = $this->targetRefs[$name];
            if ($have->imported == $imported) {
                $have->width = $width;
                $have->height = $height;
                $have->contentScaleX = 1.0f;
                $have->contentScaleY = 1.0f;
                $have->colorAttachments->clear();
                $have->depthAttachment = null;
                $have->depthStencil = false;
                return $have;
            }
        }

        TargetRef $fresh = TargetRef($name, $width, $height, $imported);
        $this->targetRefs[$name] = $fresh;
        return $fresh;
    }

    private function makeTexture(string $name, int32 $width, int32 $height, TextureOptions $options, bool $imported) : TextureRef
    {
        $this->claimName($name);
        if ($this->textureRefs->has($name)) {
            TextureRef $have = $this->textureRefs[$name];
            if ($have->imported == $imported) {
                $have->width = $width;
                $have->height = $height;
                $have->options = $options;
                return $have;
            }
        }

        TextureRef $fresh = TextureRef($name, $width, $height, $options, $imported);
        $this->textureRefs[$name] = $fresh;
        return $fresh;
    }

    private function claimName(const string& $name) : void
    {
        assert(!$this->names->has($name), 'pipeline: duplicate resource name');
        $this->names[$name] = true;
    }

    private function touchIo() : void
    {
        usize $edges = $this->io->count();
        usize $e = 0;
        while ($e < $edges) {
            Io& $edge = $this->io->at($e);
            match ($edge->resource) {
                ResourceIo::target($ref) => {
                    $this->pool->touchTarget($ref);
                },
                ResourceIo::texture($ref) => {
                    $this->pool->touch($ref->name);
                },
            };
            $e = $e + 1;
        }
    }

    private function transitionReads(int32 $passIndex) : void
    {
        usize $edges = $this->io->count();
        usize $e = 0;
        while ($e < $edges) {
            Io& $edge = $this->io->at($e);
            $e = $e + 1;
            if ($edge->passIndex != $passIndex || $edge->access == Access::write) {
                continue;
            }

            match ($edge->resource) {
                ResourceIo::target($ref) => {
                    $this->transitionTarget($ref);
                },
                ResourceIo::texture($ref) => {
                    $this->transitionTexture($ref);
                },
            };
        }
    }

    private function transitionTarget(TargetRef $ref) : void
    {
        RenderTarget $rt = guard $this->pool->getTarget($ref) else {
            return;
        }
        usize $n = $rt->colors->count();
        usize $i = 0;
        while ($i < $n) {
            $this->pool->device->transitionTexture($rt->colors[$i], .shaderRead);
            $i = $i + 1;
        }

        Texture $depth = guard $rt->depth else {
            return;
        }
        $this->pool->device->transitionTexture($depth, .shaderRead);
    }

    private function transitionTexture(TextureRef $ref) : void
    {
        Texture $tex = guard $this->pool->getTexture($ref) else {
            return;
        }
        $this->pool->device->transitionTexture($tex, .shaderRead);
    }

    private function flushClearsForReads(int32 $passIndex, RenderContext $ctx) : status<PipelineError>
    {
        if ($this->clears->empty()) {
            return .ok;
        }

        usize $edges = $this->io->count();
        usize $e = 0;
        while ($e < $edges) {
            Io& $edge = $this->io->at($e);
            $e = $e + 1;
            if ($edge->passIndex != $passIndex || $edge->access == Access::write) {
                continue;
            }

            guard $this->flushClearOf($edge->resource, $ctx) else ($err) {
                return .error($err);
            }
        }

        return .ok;
    }

    private function flushClearOf(ResourceIo $resource, RenderContext $ctx) : status<PipelineError>
    {
        match ($resource) {
            ResourceIo::target($ref) => {
                return $this->flushNamed($ref->name, $ctx);
            },
            ResourceIo::texture($ref) => {
                return $this->flushParentOf($ref, $ctx);
            },
        };

        return .ok;
    }

    private function flushParentOf(TextureRef $ref, RenderContext $ctx) : status<PipelineError>
    {
        string $parent = '';
        bool $found = false;
        foreach ($this->clears as $name => $held) {
            if (targetHolds($held->target, $ref->name)) {
                $parent = $name;
                $found = true;
                break;
            }
        }

        if (!$found) {
            return .ok;
        }

        return $this->flushNamed($parent, $ctx);
    }

    private function flushNamed(const string& $name, RenderContext $ctx) : status<PipelineError>
    {
        if (!$this->clears->has($name)) {
            return .ok;
        }

        TargetRef $target = $this->clears[$name]->target;
        RenderEncoder $enc = guard $ctx->beginRender($target) else ($err) {
            return .error($err);
        }
        $enc->endRender();
        return .ok;
    }

    private function flushClears(RenderContext $ctx) : status<PipelineError>
    {
        // each flush consumes its clear through beginRender
        while (!$this->clears->empty()) {
            string $next = '';
            foreach ($this->clears as $name => $held) {
                $next = $name;
                break;
            }

            TargetRef $target = $this->clears[$next]->target;
            RenderEncoder $enc = guard $ctx->beginRender($target) else ($err) {
                return .error($err);
            }
            $enc->endRender();
            // a clear beginRender did not take would spin; it always takes the target's own
            $this->clears->remove($next);
        }

        return .ok;
    }
}

/**
 * Whether `$name` is one of `$target`'s attachments.
 */
internal function targetHolds(TargetRef $target, const string& $name) : bool
{
    usize $n = $target->colorAttachments->count();
    usize $i = 0;
    while ($i < $n) {
        if ($target->colorAttachments[$i]->name == $name) {
            return true;
        }

        $i = $i + 1;
    }

    TextureRef $depth = guard $target->depthAttachment else {
        return false;
    }
    return $depth->name == $name;
}
