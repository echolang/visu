/**
 * I/O recorder for one pass's setup(). Identity is the pass index;
 * there is no Pass argument and no setup-mode flag on Pipeline.
 */

namespace visu::graphics;

public struct IoSink
{
    private Pipeline $pipeline;
    private int32 $passIndex;

    public constructor(Pipeline $pipeline, int32 $passIndex)
    {
        $this->pipeline = $pipeline;
        $this->passIndex = $passIndex;
    }

    public function writes(TargetRef $target) : void
    {
        $this->pipeline->record($this->passIndex, .target($target), .write);
    }

    public function writes(TextureRef $texture) : void
    {
        $this->pipeline->record($this->passIndex, .texture($texture), .write);
    }

    public function reads(TargetRef $target) : void
    {
        $this->pipeline->record($this->passIndex, .target($target), .read);
    }

    public function reads(TextureRef $texture) : void
    {
        $this->pipeline->record($this->passIndex, .texture($texture), .read);
    }
}
