/**
 * Graph handles. Distinct types so a texture cannot be passed where a target is required.
 * Classes because width / attachments are mutated after create (PHP RenderTargetResource).
 * Identity is the name; names are unique per Pipeline. A Pipeline keeps its refs across frames
 * and refills them, so a ref seen last frame is this frame's ref of that name.
 */

namespace visu::graphics;

public class TargetRef
{
    public const string $name;
    public int32 $width;
    public int32 $height;
    public float32 $contentScaleX;
    public float32 $contentScaleY;
    public array<TextureRef> $colorAttachments;
    public TextureRef? $depthAttachment;
    public bool $depthStencil;
    public const bool $imported;

    /**
     * The attachment refs `Pipeline.createColor` / `createDepth` made for this target, by short
     * name, reused every frame so their full names are built once.
     */
    internal map<string, TextureRef> $colorCache;
    internal TextureRef? $depthCache;

    public constructor(string $name, int32 $width, int32 $height, bool $imported = false)
    {
        $this->name = $name;
        $this->width = $width;
        $this->height = $height;
        $this->contentScaleX = 1.0f;
        $this->contentScaleY = 1.0f;
        $this->colorAttachments = array<TextureRef>();
        $this->depthAttachment = null;
        $this->depthStencil = false;
        $this->imported = $imported;
        $this->colorCache = map<string, TextureRef>();
        $this->depthCache = null;
    }

    /**
     * Color attachments then optional depth. Used by the scheduler and the pool so a target write implies its textures.
     */
    public const function textures() : array<TextureRef>
    {
        array<TextureRef> $out = $this->colorAttachments;
        TextureRef $depth = guard $this->depthAttachment else {
            return $out;
        }
        $out->push($depth);
        return $out;
    }
}

public class TextureRef
{
    public const string $name;
    public int32 $width;
    public int32 $height;
    public TextureOptions $options;
    public const bool $imported;

    public constructor(string $name, int32 $width, int32 $height, TextureOptions $options, bool $imported = false)
    {
        $this->name = $name;
        $this->width = $width;
        $this->height = $height;
        $this->options = $options;
        $this->imported = $imported;
    }
}
