/**
 * Named closures as a pass. Capture class handles (Frame, Pool,
 * Gpu objects). execute receives Context (gpu is on it).
 */

namespace visu::graphics;

public class CallbackPass : Pass
{
    private string $label;
    private function<void(Pipeline, Frame, IoSink)> $onSetup;
    private function<result<bool, PipelineError>(Context)> $onExecute;

    public constructor(
        string $label,
        setup: function<void(Pipeline, Frame, IoSink)> $onSetup,
        execute: function<result<bool, PipelineError>(Context)> $onExecute
    )
    {
        $this->label = $label;
        $this->onSetup = $onSetup;
        $this->onExecute = $onExecute;
    }

    public function name() : string
    {
        return $this->label;
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        function<void(Pipeline, Frame, IoSink)> $fn = $this->onSetup;
        $fn($pipeline, $frame, $io);
    }

    public function execute(Context $ctx) : result<bool, PipelineError>
    {
        function<result<bool, PipelineError>(Context)> $fn = $this->onExecute;
        return $fn($ctx);
    }
}
