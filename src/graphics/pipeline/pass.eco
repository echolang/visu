/**
 * One node in the render graph. Resource I/O and execute; not a place to own shaders.
 * Concrete passes are classes; only a class can be stored as an interface value.
 */

namespace visu::graphics;

public interface Pass
{
    function name() : string;
    function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void;
    function execute(RenderContext $ctx) : status<PipelineError>;
}
