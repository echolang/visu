/**
 * One node in the render graph. Concrete passes are classes — only a
 * class can be stored as an interface value.
 */

namespace visu::graphics;

public interface Pass
{
    function name() : string;
    function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void;
    function execute(Gpu& $state, Context $ctx) : result<bool, PipelineError>;
}
