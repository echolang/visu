/**
 * Stable topological sort of pass I/O. Setup still runs at add();
 * this only orders execute. Resources are keyed by name.
 */

namespace visu::graphics;

public enum PipelineError
{
    case unread(string $name);
    case cycle;
    case pool(PoolError $inner);
    case shader(ShaderError $inner);

    public const function message() : string
    {
        return match ($this) {
            PipelineError::unread($name) => "pipeline: read of '{$name}' that was never written",
            PipelineError::cycle => 'pipeline: cyclic pass I/O',
            PipelineError::pool($inner) => $inner->message(),
            PipelineError::shader($inner) => $inner->message(),
        };
    }
}

internal struct GraphRes
{
    public string $name;
    public bool $imported;
}

internal function schedule(int32 $passCount, const array<Io>& $io) : result<array<int32>, PipelineError>
{
    array<int32> $empty = array<int32>();

    if ($passCount <= 0) {
        return .ok($empty);
    }

    map<string, array<int32>> $writers = map<string, array<int32>>();
    map<string, array<int32>> $readers = map<string, array<int32>>();
    map<string, GraphRes> $info = map<string, GraphRes>();
    array<Io> $edges = $io;

    foreach ($edges as $edge) {
        array<GraphRes> $res = expandIo($edge->resource);

        foreach ($res as $r) {
            $info[$r->name] = $r;
            bool $isWrite = match ($edge->access) {
                Access::write => true,
                Access::read => false,
            };

            if ($isWrite) {
                appendUnique($writers, $r->name, $edge->passIndex);
            } else {
                appendUnique($readers, $r->name, $edge->passIndex);
            }
        }
    }

    array<array<int32>> $adj = array<array<int32>>();
    array<int32> $indegree = array<int32>();
    int32 $n = 0;

    while ($n < $passCount) {
        $adj->push(array<int32>());
        $indegree->push(0);
        $n = $n + 1;
    }

    array<string> $ids = $info->keys();

    foreach ($ids as $id) {
        GraphRes $meta = $info[$id];
        array<int32> $w = passList($writers, $id);
        array<int32> $r = passList($readers, $id);

        if ($r->count() > 0 && $w->count() == 0 && !$meta->imported) {
            return .error(.unread($meta->name));
        }

        usize $wi = 1;
        usize $wn = $w->count();

        while ($wi < $wn) {
            addEdge($adj, $indegree, $w[$wi - 1], $w[$wi]);
            $wi = $wi + 1;
        }

        foreach ($w as $writer) {
            foreach ($r as $reader) {
                addEdge($adj, $indegree, $writer, $reader);
            }
        }
    }

    return kahn($adj, $indegree, $passCount);
}

internal function expandIo(ResourceIo $resource) : array<GraphRes>
{
    array<GraphRes> $out = array<GraphRes>();

    match ($resource) {
        ResourceIo::target($ref) => {
            $out->push(GraphRes($ref->name, $ref->imported));
            array<TextureRef> $texes = $ref->textures();
            foreach ($texes as $tex) {
                $out->push(GraphRes($tex->name, $tex->imported));
            }
        },
        ResourceIo::texture($ref) => {
            $out->push(GraphRes($ref->name, $ref->imported));
        },
    };

    return $out;
}

internal function appendUnique(map<string, array<int32>>& $into, string $id, int32 $pass) : void
{
    if (!$into->has($id)) {
        array<int32> $first = array<int32>();
        $first->push($pass);
        $into[$id] = $first;
        return;
    }

    array<int32>& $list = $into->at($id);
    usize $n = $list->count();

    if ($n > 0 && $list[$n - 1] == $pass) {
        return;
    }

    $list->push($pass);
}

internal function passList(const map<string, array<int32>>& $m, string $id) : array<int32>
{
    if (!$m->has($id)) {
        return array<int32>();
    }

    return $m[$id];
}

internal function addEdge(array<array<int32>>& $adj, array<int32>& $indegree, int32 $from, int32 $to) : void
{
    if ($from == $to) {
        return;
    }

    usize $f = $from as usize;
    array<int32>& $succ = $adj->at($f);

    foreach ($succ as $s) {
        if ($s == $to) {
            return;
        }
    }

    $succ->push($to);
    usize $t = $to as usize;
    $indegree[$t] = $indegree[$t] + 1;
}

internal function kahn(array<array<int32>>& $adj, array<int32>& $indegree, int32 $passCount) : result<array<int32>, PipelineError>
{
    array<int32> $order = array<int32>();
    int32 $placed = 0;

    while ($placed < $passCount) {
        int32 $pick = -1;
        int32 $i = 0;

        while ($i < $passCount) {
            if ($indegree[$i as usize] == 0) {
                $pick = $i;
                break;
            }

            $i = $i + 1;
        }

        if ($pick < 0) {
            return .error(.cycle);
        }

        $order->push($pick);
        $indegree[$pick as usize] = -1;
        array<int32> $succ = $adj[$pick as usize];

        foreach ($succ as $v) {
            usize $vi = $v as usize;
            $indegree[$vi] = $indegree[$vi] - 1;
        }

        $placed = $placed + 1;
    }

    return .ok($order);
}
