/**
 * Stable topological sort of pass I/O. Setup still runs at `add()`; this only orders `execute`.
 * Resources are keyed by name, interned once into dense ids, so a frame that adds the same
 * passes as the last one schedules them in storage it already has: no map, no list, no copy.
 */

namespace visu::graphics;

public enum PipelineError
{
    case unread(string $name);
    case cycle;
    case pool(PoolError $inner);
    case shader(ShaderError $inner);
    case device(DeviceError $inner);

    public const function message() : string
    {
        return match ($this) {
            PipelineError::unread($name) => "pipeline: read of '{$name}' that was never written",
            PipelineError::cycle => 'pipeline: cyclic pass I/O',
            PipelineError::pool($inner) => $inner->message(),
            PipelineError::shader($inner) => $inner->message(),
            PipelineError::device($inner) => $inner->message(),
        };
    }
}

/**
 * The scheduler a Pipeline keeps across frames. Names intern into ids the first frame they are
 * seen; every per-frame list is cleared and refilled, never rebuilt.
 *
 * The rule: within one resource, its writers run in add order and every writer runs before
 * every reader. Among passes that are ready, the earliest added runs first.
 */
internal class GraphSchedule
{
    private map<string, int32> $ids;
    private array<string> $names;
    private array<bool> $imported;

    /**
     * This frame's expanded edges: a target edge is one edge per resource it names (the target
     * and each attachment), in record order.
     */
    private array<int32> $edgeRes;
    private array<int32> $edgePass;
    private array<bool> $edgeWrite;

    /**
     * Edge indices bucketed by resource, record order kept inside a bucket.
     */
    private array<int32> $bucketStart;
    private array<int32> $bucketFill;
    private array<int32> $sorted;
    private array<int32> $writers;
    private array<int32> $readers;
    private array<array<int32>> $adj;
    private array<int32> $indegree;

    /**
     * Pass indices in execution order, valid after `run`.
     */
    public array<int32> $order;

    public constructor()
    {
        $this->ids = map<string, int32>();
        $this->names = array<string>();
        $this->imported = array<bool>();
        $this->edgeRes = array<int32>();
        $this->edgePass = array<int32>();
        $this->edgeWrite = array<bool>();
        $this->bucketStart = array<int32>();
        $this->bucketFill = array<int32>();
        $this->sorted = array<int32>();
        $this->writers = array<int32>();
        $this->readers = array<int32>();
        $this->adj = array<array<int32>>();
        $this->indegree = array<int32>();
        $this->order = array<int32>();
    }

    /**
     * Forget this frame's edges; the interned names stay.
     */
    public function begin() : void
    {
        $this->edgeRes->clear();
        $this->edgePass->clear();
        $this->edgeWrite->clear();
    }

    /**
     * Record every resource `$io` names for pass `$pass`.
     */
    public function record(const Io& $io) : void
    {
        bool $write = match ($io->access) {
            Access::write => true,
            Access::read => false,
        };

        match ($io->resource) {
            ResourceIo::target($ref) => {
                $this->edge($ref->name, $ref->imported, $io->passIndex, $write);
                usize $n = $ref->colorAttachments->count();
                usize $i = 0;
                while ($i < $n) {
                    TextureRef $tex = $ref->colorAttachments[$i];
                    $this->edge($tex->name, $tex->imported, $io->passIndex, $write);
                    $i = $i + 1;
                }

                TextureRef? $depth = $ref->depthAttachment;
                if ($depth != null) {
                    TextureRef $held = guard $depth;
                    $this->edge($held->name, $held->imported, $io->passIndex, $write);
                }
            },
            ResourceIo::texture($ref) => {
                $this->edge($ref->name, $ref->imported, $io->passIndex, $write);
            },
        };
    }

    /**
     * Order `$passCount` passes into `order`.
     */
    public function run(int32 $passCount) : status<PipelineError>
    {
        $this->order->clear();
        if ($passCount <= 0) {
            return .ok;
        }

        int32 $resources = $this->names->count() as int32;
        $this->bucket($resources);
        $this->resetAdjacency($passCount);

        int32 $r = 0;
        while ($r < $resources) {
            int32 $from = $this->bucketStart[$r as usize];
            int32 $to = $this->bucketStart[($r + 1) as usize];
            if ($from == $to) {
                $r = $r + 1;
                continue;
            }

            $this->writers->clear();
            $this->readers->clear();
            int32 $k = $from;
            while ($k < $to) {
                int32 $e = $this->sorted[$k as usize];
                int32 $pass = $this->edgePass[$e as usize];
                if ($this->edgeWrite[$e as usize]) {
                    appendPass($this->writers, $pass);
                } else {
                    appendPass($this->readers, $pass);
                }

                $k = $k + 1;
            }

            if ($this->readers->count() > 0 && $this->writers->count() == 0 && !$this->imported[$r as usize]) {
                return .error(.unread($this->names[$r as usize]));
            }

            usize $wn = $this->writers->count();
            usize $wi = 1;
            while ($wi < $wn) {
                $this->addEdge($this->writers[$wi - 1], $this->writers[$wi]);
                $wi = $wi + 1;
            }

            usize $rn = $this->readers->count();
            $wi = 0;
            while ($wi < $wn) {
                usize $ri = 0;
                while ($ri < $rn) {
                    $this->addEdge($this->writers[$wi], $this->readers[$ri]);
                    $ri = $ri + 1;
                }

                $wi = $wi + 1;
            }

            $r = $r + 1;
        }

        return $this->kahn($passCount);
    }

    private function edge(const string& $name, bool $imported, int32 $pass, bool $write) : void
    {
        int32 $id = 0;
        if ($this->ids->has($name)) {
            $id = $this->ids[$name];
        } else {
            $id = $this->names->count() as int32;
            $this->ids[$name] = $id;
            $this->names->push($name);
            $this->imported->push($imported);
        }

        // the last edge's word wins, as one name is one resource for the frame
        $this->imported[$id as usize] = $imported;
        $this->edgeRes->push($id);
        $this->edgePass->push($pass);
        $this->edgeWrite->push($write);
    }

    /**
     * Counting sort of this frame's edges by resource, stable, into `sorted`.
     */
    private function bucket(int32 $resources) : void
    {
        while (($this->bucketStart->count() as int32) < $resources + 1) {
            $this->bucketStart->push(0);
            $this->bucketFill->push(0);
        }

        int32 $r = 0;
        while ($r <= $resources) {
            $this->bucketStart[$r as usize] = 0;
            $this->bucketFill[$r as usize] = 0;
            $r = $r + 1;
        }

        usize $edges = $this->edgeRes->count();
        usize $e = 0;
        while ($e < $edges) {
            usize $id = ($this->edgeRes[$e] + 1) as usize;
            $this->bucketStart[$id] = $this->bucketStart[$id] + 1;
            $e = $e + 1;
        }

        $r = 1;
        while ($r <= $resources) {
            usize $at = $r as usize;
            $this->bucketStart[$at] = $this->bucketStart[$at] + $this->bucketStart[$at - 1];
            $r = $r + 1;
        }

        while ($this->sorted->count() < $edges) {
            $this->sorted->push(0);
        }

        $e = 0;
        while ($e < $edges) {
            usize $id = $this->edgeRes[$e] as usize;
            int32 $slot = $this->bucketStart[$id] + $this->bucketFill[$id];
            $this->sorted[$slot as usize] = $e as int32;
            $this->bucketFill[$id] = $this->bucketFill[$id] + 1;
            $e = $e + 1;
        }
    }

    private function resetAdjacency(int32 $passCount) : void
    {
        while (($this->adj->count() as int32) < $passCount) {
            $this->adj->push(array<int32>());
            $this->indegree->push(0);
        }

        int32 $i = 0;
        while ($i < $passCount) {
            $this->adj->at($i as usize)->clear();
            $this->indegree[$i as usize] = 0;
            $i = $i + 1;
        }
    }

    private function addEdge(int32 $from, int32 $to) : void
    {
        if ($from == $to) {
            return;
        }

        array<int32>& $succ = $this->adj->at($from as usize);
        usize $n = $succ->count();
        usize $i = 0;
        while ($i < $n) {
            if ($succ[$i] == $to) {
                return;
            }

            $i = $i + 1;
        }

        $succ->push($to);
        usize $t = $to as usize;
        $this->indegree[$t] = $this->indegree[$t] + 1;
    }

    /**
     * Kahn's sort; among ready passes the lowest index (the earliest added) goes first.
     */
    private function kahn(int32 $passCount) : status<PipelineError>
    {
        int32 $placed = 0;
        while ($placed < $passCount) {
            int32 $pick = -1;
            int32 $i = 0;
            while ($i < $passCount) {
                if ($this->indegree[$i as usize] == 0) {
                    $pick = $i;
                    break;
                }

                $i = $i + 1;
            }

            if ($pick < 0) {
                return .error(.cycle);
            }

            $this->order->push($pick);
            $this->indegree[$pick as usize] = -1;
            array<int32>& $succ = $this->adj->at($pick as usize);
            usize $n = $succ->count();
            usize $k = 0;
            while ($k < $n) {
                usize $v = $succ[$k] as usize;
                $this->indegree[$v] = $this->indegree[$v] - 1;
                $k = $k + 1;
            }

            $placed = $placed + 1;
        }

        return .ok;
    }
}

/**
 * Append `$pass` unless it is already the last entry: a pass that names a resource twice is
 * one writer or one reader.
 */
internal function appendPass(array<int32>& $list, int32 $pass) : void
{
    usize $n = $list->count();
    if ($n > 0 && $list[$n - 1] == $pass) {
        return;
    }

    $list->push($pass);
}
