/**
 * PBR material filled from a cooked `.vmat` sheet. Named map slots are `AssetRef`s, not live GPU
 * textures: terrain packs CPU texels, a mesh path `load<Texture>`s the same ids.
 */

namespace visu::graphics;

use json;
use visu::asset::{AssetError, AssetRef, Assets, Vmat, parentId, vmatBool, vmatF32, vmatMap, vmatRgb, vmatVec2};
use visu::math::{Vec2, Vec3};

public class Material
{
    public const string $id;
    public const Vmat $sheet;

    /**
     * The JSON this material reads: the cooked `.vmat` root.
     */
    public const json::Value $root;

    /**
     * Catalog folder the sheet was cooked in. A bind that names a bare stem resolves against it.
     */
    public const string $folder;

    /**
     * Tiles per world unit. JSON `textureScale`, factory may overwrite.
     */
    public Vec2 $textureScale;

    /**
     * Solid albedo when a map is missing. JSON `fallback`.
     */
    public Vec3 $diffuseColor;

    /**
     * Scalar surface values used where the map is missing. JSON `roughnessFactor` / `metallicFactor`.
     */
    public float32 $roughnessFactor;
    public float32 $metallicFactor;

    /**
     * Below this alpha a fragment is discarded. 0 means opaque, no test. JSON `alphaCutoff`;
     * defaults to 0.5 when an `alpha` map is bound.
     */
    public float32 $alphaCutoff;

    public bool $backfaceCull;

    public AssetRef? $albedo;
    public AssetRef? $normal;
    public AssetRef? $roughness;
    public AssetRef? $metal;
    public AssetRef? $height;
    public AssetRef? $ao;
    public AssetRef? $emissive;
    public AssetRef? $alpha;

    public constructor(Vmat $sheet)
    {
        $this->id = $sheet->id;
        $this->sheet = $sheet;
        $this->root = $sheet->root;
        $this->folder = parentId($sheet->id);
        $this->textureScale = Vec2(1.0f);
        $this->diffuseColor = Vec3(1.0f);
        $this->roughnessFactor = 0.8f;
        $this->metallicFactor = 0.0f;
        $this->alphaCutoff = 0.0f;
        $this->backfaceCull = true;
        $this->albedo = null;
        $this->normal = null;
        $this->roughness = null;
        $this->metal = null;
        $this->height = null;
        $this->ao = null;
        $this->emissive = null;
        $this->alpha = null;
        $this->read();
    }

    /**
     * Empty slots. Used when the sheet is missing.
     */
    public constructor(id: string $id)
    {
        $this->id = $id;
        $this->sheet = Vmat($id, json::object());
        $this->root = json::object();
        $this->folder = '';
        $this->textureScale = Vec2(1.0f);
        $this->diffuseColor = Vec3(1.0f);
        $this->roughnessFactor = 0.8f;
        $this->metallicFactor = 0.0f;
        $this->alphaCutoff = 0.0f;
        $this->backfaceCull = true;
        $this->albedo = null;
        $this->normal = null;
        $this->roughness = null;
        $this->metal = null;
        $this->height = null;
        $this->ao = null;
        $this->emissive = null;
        $this->alpha = null;
    }

    /**
     * Surface knobs from `$root`.
     */
    private function read() : void
    {
        $this->textureScale = vmatVec2($this->root, 'textureScale', Vec2(1.0f));
        $this->diffuseColor = vmatRgb($this->root, 'fallback', Vec3(1.0f));
        $this->roughnessFactor = vmatF32($this->root, 'roughnessFactor', 0.8f);
        $this->metallicFactor = vmatF32($this->root, 'metallicFactor', 0.0f);
        $this->backfaceCull = vmatBool($this->root, 'backfaceCull', true)->or(true);
        float32 $cutoff = 0.0f;
        if (vmatMap($this->root, 'alpha', 'opacity') != null) {
            $cutoff = 0.5f;
        }

        $this->alphaCutoff = vmatF32($this->root, 'alphaCutoff', $cutoff);
    }

    /**
     * Load a cooked `.vmat` and bind catalog slots.
     */
    public static function load(Assets $assets, string $id) : result<Material, AssetError>
    {
        Vmat $sheet = guard $assets->load<Vmat>($id) else ($e) {
            return .error($e);
        }
        Material $mat = Material($sheet);
        $mat->bind($assets);
        return .ok($mat);
    }

    /**
     * Resolve map binds against the mounted catalog. Missing ids stay null.
     */
    public function bind(Assets $assets) : void
    {
        json::Value $root = $this->root;
        string $folder = $this->folder;
        $this->albedo = materialSlot($assets, $folder, vmatMap($root, 'albedo', 'diffuse'));
        $this->normal = materialSlot($assets, $folder, vmatMap($root, 'normal'));
        $this->roughness = materialSlot($assets, $folder, vmatMap($root, 'rough', 'roughness'));
        $this->metal = materialSlot($assets, $folder, vmatMap($root, 'metal', 'metallic'));
        $this->height = materialSlot($assets, $folder, vmatMap($root, 'height'));
        $this->ao = materialSlot($assets, $folder, vmatMap($root, 'ao'));
        $this->emissive = materialSlot($assets, $folder, vmatMap($root, 'emissive'));
        $this->alpha = materialSlot($assets, $folder, vmatMap($root, 'alpha', 'opacity'));
    }

    /**
     * The catalog id a bind names: a bare stem is relative to the material's folder, anything
     * with a slash in it is already an id. The cooker rewrites the sheet's own binds; a record's
     * binds are resolved here.
     */
    public const function mapId(const string& $bind) : string
    {
        return materialMapId($this->folder, $bind);
    }

    /**
     * Cut-out surfaces test alpha; anything else writes every fragment.
     */
    public const function cutout() : bool
    {
        return $this->alphaCutoff > 0.0f;
    }
}

internal function materialSlot(Assets $assets, const string& $folder, string? $id) : AssetRef?
{
    string $have = guard $id else {
        return null;
    }
    return $assets->slot(materialMapId($folder, $have));
}

/**
 * `wood` in folder `props/crate_01` is `props/crate_01/wood`; `props/crate_01/wood` stays put.
 */
internal function materialMapId(const string& $folder, const string& $bind) : string
{
    if ($folder->empty() || $bind->find('/') != $bind->size()) {
        return $bind;
    }

    string $id = $folder;
    $id->append('/');
    $id->append($bind);
    return $id;
}
