/**
 * Loader proc for visu::os::init. Never names vk:: from os/.
 */

namespace visu::graphics;

internal function vulkanLoaderProc() : ptr<uint8>
{
    if (vk::loadDefault() == 0) {
        return null;
    }

    return vk::getInstanceProcAddrPtr();
}

internal function needsVulkanLoader() : bool
{
    return true;
}
