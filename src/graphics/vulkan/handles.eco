/**
 * Per-backend GPU object identities. Shared resource classes
 * store these; the Vulkan arm fills them with vk handles.
 */

namespace visu::graphics;

public struct Surface
{
    public vk::SurfaceKHR $handle;

    public static function none() : Surface
    {
        return Surface(vk::SurfaceKHR::none());
    }
}

public struct BufferHandle
{
    public vk::Buffer $buffer;
    public vk::DeviceMemory $memory;
    public uint64 $offset;
    public uint64 $bytes;

    public static function none() : BufferHandle
    {
        return BufferHandle(vk::Buffer::none(), vk::DeviceMemory::none(), 0 as uint64, 0 as uint64);
    }
}

public struct TextureHandle
{
    public vk::Image $image;
    public vk::ImageView $view;
    public vk::DeviceMemory $memory;
    public bool $imported;

    public static function none() : TextureHandle
    {
        return TextureHandle(vk::Image::none(), vk::ImageView::none(), vk::DeviceMemory::none(), false);
    }
}

public struct SamplerHandle
{
    public vk::Sampler $sampler;

    public static function none() : SamplerHandle
    {
        return SamplerHandle(vk::Sampler::none());
    }
}

public struct ShaderModuleHandle
{
    public vk::ShaderModule $module;

    public static function none() : ShaderModuleHandle
    {
        return ShaderModuleHandle(vk::ShaderModule::none());
    }
}

public struct PipelineHandle
{
    public vk::Pipeline $pipeline;

    public static function none() : PipelineHandle
    {
        return PipelineHandle(vk::Pipeline::none());
    }
}
