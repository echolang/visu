/**
 * Framework pipeline layout: set 0 = dynamic UBOs, set 1 = combined image samplers, set 2 =
 * storage buffers. One layout for graphics and compute. One set 0 per frame slot, written
 * against that slot's ring; sets 1 and 2 are minted per distinct binding tuple.
 */

namespace visu::graphics;

/**
 * Set-1 allocations per frame slot. One set is minted per distinct texture tuple an encoder binds, not per draw.
 */
internal const uint32 SET1_MAX_SETS = 1024;

/**
 * Set-2 allocations per frame slot, one per distinct storage tuple an encoder binds.
 */
internal const uint32 SET2_MAX_SETS = 1024;

internal const uint32 VK_ALL_STAGES = vk::SHADER_STAGE_VERTEX_BIT
    | vk::SHADER_STAGE_FRAGMENT_BIT
    | vk::SHADER_STAGE_TESSELLATION_CONTROL_BIT
    | vk::SHADER_STAGE_TESSELLATION_EVALUATION_BIT
    | vk::SHADER_STAGE_COMPUTE_BIT;

internal function vkCreateDrawStack(Device $device) : status<DeviceError>
{
    vk::DescriptorSetLayoutBinding[4] $ubo;
    uint32 $i = 0;

    while ($i < UNIFORM_SLOTS) {
        $ubo[$i] = vk::DescriptorSetLayoutBinding();
        $ubo[$i]->binding = $i;
        $ubo[$i]->descriptorType = vk::DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
        $ubo[$i]->descriptorCount = 1;
        $ubo[$i]->stageFlags = VK_ALL_STAGES;
        $i = $i + 1;
    }

    vk::DescriptorSetLayoutCreateInfo $s0 = vk::DescriptorSetLayoutCreateInfo();
    $s0->bindingCount = UNIFORM_SLOTS;
    $s0->pBindings:$ = &$ubo[0];
    guard vkCheck(
        vk::CreateDescriptorSetLayout($device->logical, &$s0, null, &$device->setLayout0),
        'CreateDescriptorSetLayout'
    ) else ($e) {
        return .error($e);
    }

    vk::DescriptorSetLayoutBinding[16] $tex;
    $i = 0;

    while ($i < TEXTURE_SLOTS) {
        $tex[$i] = vk::DescriptorSetLayoutBinding();
        $tex[$i]->binding = $i;
        $tex[$i]->descriptorType = vk::DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
        $tex[$i]->descriptorCount = 1;
        $tex[$i]->stageFlags = VK_ALL_STAGES;
        $i = $i + 1;
    }

    vk::DescriptorSetLayoutCreateInfo $s1 = vk::DescriptorSetLayoutCreateInfo();
    $s1->bindingCount = TEXTURE_SLOTS;
    $s1->pBindings:$ = &$tex[0];
    guard vkCheck(
        vk::CreateDescriptorSetLayout($device->logical, &$s1, null, &$device->setLayout1),
        'CreateDescriptorSetLayout'
    ) else ($e) {
        return .error($e);
    }

    vk::DescriptorSetLayoutBinding[8] $ssbo;
    $i = 0;

    while ($i < STORAGE_SLOTS) {
        $ssbo[$i] = vk::DescriptorSetLayoutBinding();
        $ssbo[$i]->binding = $i;
        $ssbo[$i]->descriptorType = vk::DESCRIPTOR_TYPE_STORAGE_BUFFER;
        $ssbo[$i]->descriptorCount = 1;
        $ssbo[$i]->stageFlags = VK_ALL_STAGES;
        $i = $i + 1;
    }

    vk::DescriptorSetLayoutCreateInfo $s2 = vk::DescriptorSetLayoutCreateInfo();
    $s2->bindingCount = STORAGE_SLOTS;
    $s2->pBindings:$ = &$ssbo[0];
    guard vkCheck(
        vk::CreateDescriptorSetLayout($device->logical, &$s2, null, &$device->setLayout2),
        'CreateDescriptorSetLayout'
    ) else ($e) {
        return .error($e);
    }

    vk::DescriptorSetLayout[3] $layouts;
    $layouts[0] = $device->setLayout0;
    $layouts[1] = $device->setLayout1;
    $layouts[2] = $device->setLayout2;
    vk::PipelineLayoutCreateInfo $plci = vk::PipelineLayoutCreateInfo();
    $plci->setLayoutCount = 3;
    $plci->pSetLayouts:$ = &$layouts[0];
    guard vkCheck(
        vk::CreatePipelineLayout($device->logical, &$plci, null, &$device->pipeLayout),
        'CreatePipelineLayout'
    ) else ($e) {
        return .error($e);
    }

    vk::DescriptorPoolSize $ps = vk::DescriptorPoolSize();
    $ps->type = vk::DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
    $ps->descriptorCount = UNIFORM_SLOTS * FRAMES_IN_FLIGHT;
    vk::DescriptorPoolCreateInfo $pci = vk::DescriptorPoolCreateInfo();
    $pci->maxSets = FRAMES_IN_FLIGHT;
    $pci->poolSizeCount = 1;
    $pci->pPoolSizes:$ = &$ps;
    guard vkCheck(
        vk::CreateDescriptorPool($device->logical, &$pci, null, &$device->set0pool),
        'CreateDescriptorPool'
    ) else ($e) {
        return .error($e);
    }

    vk::CommandPoolCreateInfo $setup = vk::CommandPoolCreateInfo();
    $setup->flags = vk::COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
    $setup->queueFamilyIndex = $device->family;
    guard vkCheck(
        vk::CreateCommandPool($device->logical, &$setup, null, &$device->setupPool),
        'CreateCommandPool'
    ) else ($e) {
        return .error($e);
    }

    vk::CommandBufferAllocateInfo $ai = vk::CommandBufferAllocateInfo();
    $ai->commandPool = $device->setupPool;
    $ai->level = vk::COMMAND_BUFFER_LEVEL_PRIMARY;
    $ai->commandBufferCount = 1;
    guard vkCheck(
        vk::AllocateCommandBuffers($device->logical, &$ai, &$device->setupCmd),
        'AllocateCommandBuffers'
    ) else ($e) {
        return .error($e);
    }

    uint64 $range = $device->limits->maxUniformRange;

    if ($range == 0 || $range > RING_SLACK) {
        $range = RING_SLACK;
    }

    $device->uniformRange = $range;
    $i = 0;

    while ($i < FRAMES_IN_FLIGHT) {
        FrameSlot $slot = $device->slots[$i];
        guard $slot->ring->allocate($device, RING_BYTES) else ($e) {
            return .error($e);
        }

        vk::DescriptorSetAllocateInfo $dai = vk::DescriptorSetAllocateInfo();
        $dai->descriptorPool = $device->set0pool;
        $dai->descriptorSetCount = 1;
        $dai->pSetLayouts:$ = &$device->setLayout0;
        guard vkCheck(
            vk::AllocateDescriptorSets($device->logical, &$dai, &$slot->set0),
            'AllocateDescriptorSets'
        ) else ($e) {
            return .error($e);
        }

        vkWriteSet0($device, $slot);
        vk::DescriptorPoolSize $ps1 = vk::DescriptorPoolSize();
        $ps1->type = vk::DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
        $ps1->descriptorCount = TEXTURE_SLOTS * SET1_MAX_SETS;
        vk::DescriptorPoolCreateInfo $pci1 = vk::DescriptorPoolCreateInfo();
        $pci1->maxSets = SET1_MAX_SETS;
        $pci1->poolSizeCount = 1;
        $pci1->pPoolSizes:$ = &$ps1;
        guard vkCheck(
            vk::CreateDescriptorPool($device->logical, &$pci1, null, &$slot->set1pool),
            'CreateDescriptorPool'
        ) else ($e) {
            return .error($e);
        }

        vk::DescriptorPoolSize $ps2 = vk::DescriptorPoolSize();
        $ps2->type = vk::DESCRIPTOR_TYPE_STORAGE_BUFFER;
        $ps2->descriptorCount = STORAGE_SLOTS * SET2_MAX_SETS;
        vk::DescriptorPoolCreateInfo $pci2 = vk::DescriptorPoolCreateInfo();
        $pci2->maxSets = SET2_MAX_SETS;
        $pci2->poolSizeCount = 1;
        $pci2->pPoolSizes:$ = &$ps2;
        guard vkCheck(
            vk::CreateDescriptorPool($device->logical, &$pci2, null, &$slot->set2pool),
            'CreateDescriptorPool'
        ) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    guard vkCreateDummy($device) else ($e) {
        return .error($e);
    }

    $device->limits->vertexTextures = true;
    return .ok;
}

internal function vkCreateDummy(Device $device) : status<DeviceError>
{
    TextureDesc $desc = TextureDesc($format: .rgba8, $width: 1, $height: 1);
    $desc->usage = TEXTURE_SAMPLED;
    $desc->label = 'dummy';
    TextureHandle $image = guard $device->createTexture($desc) else ($e) {
        return .error($e);
    }
    vkOneShotImageBarrier(
        $device,
        $image->image,
        .undefined,
        .shaderRead,
        vk::IMAGE_ASPECT_COLOR_BIT
    );
    $device->dummyImage = $image;
    Sampler $samp = $device->createSampler(SamplerDesc());
    $device->dummySampler = $samp->handle;
    return .ok;
}

internal function vkWriteSet0(Device $device, FrameSlot $slot) : void
{
    vk::DescriptorBufferInfo[4] $infos;
    vk::WriteDescriptorSet[4] $writes;
    uint32 $i = 0;

    while ($i < UNIFORM_SLOTS) {
        $infos[$i] = vk::DescriptorBufferInfo();
        $infos[$i]->buffer = $slot->ring->buffer;
        $infos[$i]->offset = 0 as uint64;
        $infos[$i]->range = $device->uniformRange;
        $writes[$i] = vk::WriteDescriptorSet();
        $writes[$i]->dstSet = $slot->set0;
        $writes[$i]->dstBinding = $i;
        $writes[$i]->descriptorCount = 1;
        $writes[$i]->descriptorType = vk::DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
        $writes[$i]->pBufferInfo:$ = &$infos[$i];
        $i = $i + 1;
    }

    vk::UpdateDescriptorSets($device->logical, UNIFORM_SLOTS, &$writes[0], 0, null);
}

internal function vkDestroyDrawStack(Device $device) : void
{
    if ($device->logical->handle == 0) {
        return;
    }

    vk::DeviceWaitIdle($device->logical);

    foreach ($device->psos as $handle) {
        if ($handle->pipeline->handle != 0) {
            vk::DestroyPipeline($device->logical, $handle->pipeline, null);
        }
    }

    $device->psos = map<string, PipelineHandle>();

    foreach ($device->computePsos as $pipeline) {
        if ($pipeline->handle != 0) {
            vk::DestroyPipeline($device->logical, $pipeline, null);
        }
    }

    $device->computePsos = map<uint32, vk::Pipeline>();

    foreach ($device->samplers as $s) {
        if ($s->handle->sampler->handle != 0) {
            vk::DestroySampler($device->logical, $s->handle->sampler, null);
        }
    }

    $device->samplers = map<string, Sampler>();

    foreach ($device->slots as $slot) {
        $slot->ring->destroy($device);
        $slot->set0 = vk::DescriptorSet::none();

        if ($slot->set1pool->handle != 0) {
            vk::DestroyDescriptorPool($device->logical, $slot->set1pool, null);
            $slot->set1pool = vk::DescriptorPool::none();
        }

        if ($slot->set2pool->handle != 0) {
            vk::DestroyDescriptorPool($device->logical, $slot->set2pool, null);
            $slot->set2pool = vk::DescriptorPool::none();
        }
    }

    if ($device->dummyImage->image->handle != 0) {
        $device->destroyTexture($device->dummyImage);
        $device->dummyImage = TextureHandle::none();
    }

    if ($device->pipeLayout->handle != 0) {
        vk::DestroyPipelineLayout($device->logical, $device->pipeLayout, null);
        $device->pipeLayout = vk::PipelineLayout::none();
    }

    if ($device->setLayout0->handle != 0) {
        vk::DestroyDescriptorSetLayout($device->logical, $device->setLayout0, null);
        $device->setLayout0 = vk::DescriptorSetLayout::none();
    }

    if ($device->setLayout1->handle != 0) {
        vk::DestroyDescriptorSetLayout($device->logical, $device->setLayout1, null);
        $device->setLayout1 = vk::DescriptorSetLayout::none();
    }

    if ($device->setLayout2->handle != 0) {
        vk::DestroyDescriptorSetLayout($device->logical, $device->setLayout2, null);
        $device->setLayout2 = vk::DescriptorSetLayout::none();
    }

    if ($device->set0pool->handle != 0) {
        vk::DestroyDescriptorPool($device->logical, $device->set0pool, null);
        $device->set0pool = vk::DescriptorPool::none();
    }

    if ($device->setupPool->handle != 0) {
        vk::DestroyCommandPool($device->logical, $device->setupPool, null);
        $device->setupPool = vk::CommandPool::none();
        $device->setupCmd = vk::CommandBuffer::none();
    }
}

/**
 * Bind set 0 with this slot's dynamic offsets at `$bindPoint`. Graphics skips a clean slot;
 * a compute dispatch always binds, then leaves the slot dirty so the next draw rebinds too.
 */
internal function vkFlushUniforms(Device $device, uint32 $bindPoint = vk::PIPELINE_BIND_POINT_GRAPHICS) : void
{
    FrameSlot $slot = $device->slots[$device->slot];
    bool $compute = $bindPoint == vk::PIPELINE_BIND_POINT_COMPUTE;

    if (!$slot->uniformsDirty && !$compute) {
        return;
    }

    vk::CmdBindDescriptorSets(
        $slot->cmd,
        $bindPoint,
        $device->pipeLayout,
        0,
        1,
        &$slot->set0,
        UNIFORM_SLOTS,
        &$slot->dynOff[0]
    );
    $slot->uniformsDirty = $compute;
}

internal function vkFlushTextures(Device $device, VkBindings& $b, uint32 $bindPoint) : void
{
    if (!$b->texturesDirty) {
        return;
    }

    FrameSlot $fs = $device->slots[$device->slot];
    vk::DescriptorSet $set = vk::DescriptorSet::none();
    vk::DescriptorSetAllocateInfo $ai = vk::DescriptorSetAllocateInfo();
    $ai->descriptorPool = $fs->set1pool;
    $ai->descriptorSetCount = 1;
    $ai->pSetLayouts:$ = &$device->setLayout1;
    guard vkCheck(
        vk::AllocateDescriptorSets($device->logical, &$ai, &$set),
        'AllocateDescriptorSets'
    ) else ($e) {
        die($e->message());
    }

    vk::DescriptorImageInfo[16] $infos;
    vk::WriteDescriptorSet[16] $writes;
    uint32 $i = 0;

    while ($i < TEXTURE_SLOTS) {
        $infos[$i] = vk::DescriptorImageInfo();
        $infos[$i]->imageLayout = vk::IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;

        if ($b->texSet[$i]) {
            $infos[$i]->sampler = $b->sampHandles[$i]->sampler;
            $infos[$i]->imageView = $b->texHandles[$i]->view;
        } else {
            $infos[$i]->sampler = $device->dummySampler->sampler;
            $infos[$i]->imageView = $device->dummyImage->view;
        }

        $writes[$i] = vk::WriteDescriptorSet();
        $writes[$i]->dstSet = $set;
        $writes[$i]->dstBinding = $i;
        $writes[$i]->descriptorCount = 1;
        $writes[$i]->descriptorType = vk::DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
        $writes[$i]->pImageInfo:$ = &$infos[$i];
        $i = $i + 1;
    }

    vk::UpdateDescriptorSets($device->logical, TEXTURE_SLOTS, &$writes[0], 0, null);
    vk::CmdBindDescriptorSets(
        $fs->cmd,
        $bindPoint,
        $device->pipeLayout,
        1,
        1,
        &$set,
        0,
        null
    );
    $b->texturesDirty = false;
}

/**
 * Mint and bind set 2 for the storage buffers bound since the last flush. Only bound slots are
 * written; a shader must not read a slot nothing was bound into.
 */
internal function vkFlushStorage(Device $device, VkBindings& $b, uint32 $bindPoint) : void
{
    if (!$b->storageDirty) {
        return;
    }

    FrameSlot $fs = $device->slots[$device->slot];
    vk::DescriptorSet $set = vk::DescriptorSet::none();
    vk::DescriptorSetAllocateInfo $ai = vk::DescriptorSetAllocateInfo();
    $ai->descriptorPool = $fs->set2pool;
    $ai->descriptorSetCount = 1;
    $ai->pSetLayouts:$ = &$device->setLayout2;
    guard vkCheck(
        vk::AllocateDescriptorSets($device->logical, &$ai, &$set),
        'AllocateDescriptorSets'
    ) else ($e) {
        die($e->message());
    }

    vk::DescriptorBufferInfo[8] $infos;
    vk::WriteDescriptorSet[8] $writes;
    uint32 $n = 0;
    uint32 $i = 0;

    while ($i < STORAGE_SLOTS) {
        if ($b->storageSet[$i]) {
            $infos[$n] = vk::DescriptorBufferInfo();
            $infos[$n]->buffer = $b->storage[$i];
            $infos[$n]->offset = $b->storageOff[$i];
            $infos[$n]->range = vk::WHOLE_SIZE;
            $writes[$n] = vk::WriteDescriptorSet();
            $writes[$n]->dstSet = $set;
            $writes[$n]->dstBinding = $i;
            $writes[$n]->descriptorCount = 1;
            $writes[$n]->descriptorType = vk::DESCRIPTOR_TYPE_STORAGE_BUFFER;
            $writes[$n]->pBufferInfo:$ = &$infos[$n];
            $n = $n + 1;
        }

        $i = $i + 1;
    }

    if ($n > 0) {
        vk::UpdateDescriptorSets($device->logical, $n, &$writes[0], 0, null);
    }

    vk::CmdBindDescriptorSets(
        $fs->cmd,
        $bindPoint,
        $device->pipeLayout,
        2,
        1,
        &$set,
        0,
        null
    );
    $b->storageDirty = false;
}
