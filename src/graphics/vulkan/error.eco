/**
 * vk::Result → DeviceError. Keep the call name in the payload.
 */

namespace visu::graphics;

internal function vkCheck(vk::Result $r, string $what) : status<DeviceError>
{
    if ($r->ok()) {
        return .ok;
    }

    return .error(vkErr($r, $what));
}

internal function vkErr(vk::Result $r, string $what) : DeviceError
{
    if ($r == vk::Result::errorDeviceLost || $r == vk::Result::errorSurfaceLostKhr) {
        return .surfaceLost;
    }

    return .vulkan($what, $r->value());
}
