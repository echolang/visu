/**
 * visu enums → Vulkan constants.
 */

namespace visu::graphics;

internal function vkAspect(PixelFormat $format) : uint32
{
    if ($format == PixelFormat::depth32fStencil8) {
        return vk::IMAGE_ASPECT_DEPTH_BIT | vk::IMAGE_ASPECT_STENCIL_BIT;
    }

    if ($format->isDepth()) {
        return vk::IMAGE_ASPECT_DEPTH_BIT;
    }

    return vk::IMAGE_ASPECT_COLOR_BIT;
}

internal function vkLoadOp(LoadOp $op) : uint32
{
    return match ($op) {
        LoadOp::load => vk::ATTACHMENT_LOAD_OP_LOAD,
        LoadOp::clear => vk::ATTACHMENT_LOAD_OP_CLEAR,
        LoadOp::dontCare => vk::ATTACHMENT_LOAD_OP_DONT_CARE,
    };
}

internal function vkStoreOp(StoreOp $op) : uint32
{
    return match ($op) {
        StoreOp::store => vk::ATTACHMENT_STORE_OP_STORE,
        StoreOp::dontCare => vk::ATTACHMENT_STORE_OP_DONT_CARE,
    };
}

internal function vkFormat(PixelFormat $format) : uint32
{
    return match ($format) {
        PixelFormat::rgba8 => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::bgra8 => vk::FORMAT_B8G8R8A8_UNORM,
        PixelFormat::rgba8Srgb => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::rgba16f => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::rgba32f => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::r8 => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::r16f => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::r32f => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::rg16f => vk::FORMAT_R8G8B8A8_UNORM,
        PixelFormat::depth32f => vk::FORMAT_D32_SFLOAT,
        PixelFormat::depth32fStencil8 => vk::FORMAT_D32_SFLOAT_S8_UINT,
    };
}

internal function vkAttrFormat(int32 $components) : uint32
{
    if ($components == 1) {
        return vk::FORMAT_R32_SFLOAT;
    }

    if ($components == 2) {
        return vk::FORMAT_R32G32_SFLOAT;
    }

    if ($components == 3) {
        return vk::FORMAT_R32G32B32_SFLOAT;
    }

    return vk::FORMAT_R32G32B32A32_SFLOAT;
}

internal function vkTopology(Topology $topology) : uint32
{
    return match ($topology) {
        Topology::points => vk::PRIMITIVE_TOPOLOGY_POINT_LIST,
        Topology::lines => vk::PRIMITIVE_TOPOLOGY_LINE_LIST,
        Topology::lineStrip => vk::PRIMITIVE_TOPOLOGY_LINE_STRIP,
        Topology::triangles => vk::PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        Topology::triangleStrip => vk::PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP,
    };
}

internal function vkCull(CullMode $cull) : uint32
{
    return match ($cull) {
        CullMode::none => vk::CULL_MODE_NONE,
        CullMode::front => vk::CULL_MODE_FRONT_BIT,
        CullMode::back => vk::CULL_MODE_BACK_BIT,
    };
}

internal function vkFront(FrontFace $front) : uint32
{
    return match ($front) {
        FrontFace::ccw => vk::FRONT_FACE_COUNTER_CLOCKWISE,
        FrontFace::cw => vk::FRONT_FACE_CLOCKWISE,
    };
}

internal function vkCompare(Compare $op) : uint32
{
    return match ($op) {
        Compare::never => vk::COMPARE_OP_NEVER,
        Compare::less => vk::COMPARE_OP_LESS,
        Compare::equal => vk::COMPARE_OP_EQUAL,
        Compare::lessEqual => vk::COMPARE_OP_LESS_OR_EQUAL,
        Compare::greater => vk::COMPARE_OP_GREATER,
        Compare::notEqual => vk::COMPARE_OP_NOT_EQUAL,
        Compare::greaterEqual => vk::COMPARE_OP_GREATER_OR_EQUAL,
        Compare::always => vk::COMPARE_OP_ALWAYS,
    };
}

internal function vkFilter(Filter $filter) : uint32
{
    return match ($filter) {
        Filter::nearest => vk::FILTER_NEAREST,
        Filter::nearestMipmapNearest => vk::FILTER_NEAREST,
        Filter::nearestMipmapLinear => vk::FILTER_NEAREST,
        else => vk::FILTER_LINEAR,
    };
}

internal function vkMipmapMode(Filter $filter) : uint32
{
    return match ($filter) {
        Filter::nearest => vk::SAMPLER_MIPMAP_MODE_NEAREST,
        Filter::nearestMipmapNearest => vk::SAMPLER_MIPMAP_MODE_NEAREST,
        Filter::linearMipmapNearest => vk::SAMPLER_MIPMAP_MODE_NEAREST,
        else => vk::SAMPLER_MIPMAP_MODE_LINEAR,
    };
}

internal function vkWrap(Wrap $wrap) : uint32
{
    return match ($wrap) {
        Wrap::repeat => vk::SAMPLER_ADDRESS_MODE_REPEAT,
        Wrap::mirroredRepeat => vk::SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT,
        Wrap::clampToEdge => vk::SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
        Wrap::clampToBorder => vk::SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER,
    };
}

internal function vkIndexType(IndexType $type) : uint32
{
    return match ($type) {
        IndexType::uint16 => vk::INDEX_TYPE_UINT16,
        IndexType::uint32 => vk::INDEX_TYPE_UINT32,
    };
}

internal function vkSampleCount(SampleCount $samples) : uint32
{
    return match ($samples) {
        SampleCount::one => vk::SAMPLE_COUNT_1_BIT,
        SampleCount::four => vk::SAMPLE_COUNT_4_BIT,
    };
}

internal function vkFillBlend(Raster $raster) : vk::PipelineColorBlendAttachmentState
{
    vk::PipelineColorBlendAttachmentState $att = vk::PipelineColorBlendAttachmentState();

    if ($raster->colorWrite) {
        $att->colorWriteMask = vk::COLOR_COMPONENT_R_BIT
            | vk::COLOR_COMPONENT_G_BIT
            | vk::COLOR_COMPONENT_B_BIT
            | vk::COLOR_COMPONENT_A_BIT;
    }

    match ($raster->blend) {
        BlendMode::none => {
        }
        BlendMode::alpha => {
            $att->blendEnable = vk::TRUE;
            $att->srcColorBlendFactor = vk::BLEND_FACTOR_SRC_ALPHA;
            $att->dstColorBlendFactor = vk::BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
            $att->colorBlendOp = vk::BLEND_OP_ADD;
            $att->srcAlphaBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->dstAlphaBlendFactor = vk::BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
            $att->alphaBlendOp = vk::BLEND_OP_ADD;
        }
        BlendMode::premultiplied => {
            $att->blendEnable = vk::TRUE;
            $att->srcColorBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->dstColorBlendFactor = vk::BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
            $att->colorBlendOp = vk::BLEND_OP_ADD;
            $att->srcAlphaBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->dstAlphaBlendFactor = vk::BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
            $att->alphaBlendOp = vk::BLEND_OP_ADD;
        }
        BlendMode::additive => {
            $att->blendEnable = vk::TRUE;
            $att->srcColorBlendFactor = vk::BLEND_FACTOR_SRC_ALPHA;
            $att->dstColorBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->colorBlendOp = vk::BLEND_OP_ADD;
            $att->srcAlphaBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->dstAlphaBlendFactor = vk::BLEND_FACTOR_ONE;
            $att->alphaBlendOp = vk::BLEND_OP_ADD;
        }
    }

    return $att;
}
