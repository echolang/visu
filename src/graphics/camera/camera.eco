/**
 * Projection parameters as an ECS component. The pose lives on the entity's `Transform`;
 * `CameraSystem` snapshots every camera each tick and interpolates the `ActiveCamera` on render.
 */

namespace visu::graphics;

use visu::ecs::{Entities, Entity};
use visu::geo::{Frustum, Pose, Transform};
use visu::math::{Mat4, Vec2, Vec3, Vec4, clipZeroOne, inverse, lookAt, ortho, perspective, radians, translate};

public enum Projection
{
    case perspective;

    /**
     * Screen-space ortho: origin at the top-left, y down, one unit per logical point.
     */
    case orthographicScreen;

    /**
     * World-space ortho: origin at the centre of the target, size in world units, DPI aware.
     */
    case orthographicWorld;

    /**
     * World-space ortho with a fixed world height; width follows the target aspect.
     */
    case orthographicStaticWorld;
}

public struct Camera
{
    public Projection $mode = .perspective;
    public float32 $near = 0.1f;
    public float32 $far = 65536.0f;

    /**
     * Vertical field of view in degrees. `legacyFov` changes how `projection()` consumes this.
     */
    public float32 $fov = 45.0f;

    /**
     * PHP VISU handed `fieldOfView` straight to a radians-taking perspective, so its 45 was really ~58.3 degrees.
     * False reads `fov` as degrees; true keeps that PHP framing.
     */
    public bool $legacyFov = false;

    /**
     * World height for `orthographicStaticWorld`. Width is derived from the target aspect.
     */
    public float32 $staticWorldHeight = 100.0f;
    public float32 $zoom = 1.0f;

    /**
     * Negates the orthographic world's half-height, flipping y.
     */
    public bool $flipViewportY = false;

    public constructor(Projection $mode = .perspective)
    {
        $this->mode = $mode;
    }

    public constructor(orthographicStaticWorld: float32 $height, bool $flipY = false)
    {
        $this->mode = .orthographicStaticWorld;
        $this->staticWorldHeight = $height;
        $this->flipViewportY = $flipY;
    }

    public constructor(orthographicScreen: bool $flipY = false)
    {
        $this->mode = .orthographicScreen;
        $this->flipViewportY = $flipY;
    }

    public constructor(orthographicWorld: bool $flipY = false)
    {
        $this->mode = .orthographicWorld;
        $this->flipViewportY = $flipY;
    }

    /**
     * Camera + Transform at `$position`, looking down -Z. `$camera` is
     * perspective unless you pass one of the labelled constructors.
     */
    public static function spawn(Entities $entities, Vec3 $position, Camera $camera = Camera(.perspective)) : Entity
    {
        Entity $entity = $entities->create();
        Transform $transform = Transform();
        $transform->position = $position;
        $entities->attach($entity, $transform);
        $entities->attach($entity, $camera);
        return $entity;
    }

    /**
     * Projection matrix for a `$width`×`$height` target. Perspective uses `$fov` and aspect; ortho uses `viewport()`.
     * Depth is remapped to 0..1 so Vulkan and Metal share the same matrix.
     */
    public const function projection(int32 $width, int32 $height, float32 $scaleX, float32 $scaleY) : Mat4
    {
        float32 $w = $width as float32;
        float32 $h = $height as float32;

        if ($this->mode == Projection::perspective) {
            float32 $fovY = $this->fov;

            if (!$this->legacyFov) {
                $fovY = radians($this->fov);
            }

            return clipZeroOne(perspective(fovY: $fovY, aspect: $w / $h, near: $this->near, far: $this->far));
        }

        // the world rect is the ortho frame, so derive it there once
        Viewport $vp = $this->viewport($width, $height, $scaleX, $scaleY);

        return clipZeroOne(ortho(
            left: $vp->left,
            right: $vp->right,
            bottom: $vp->bottom,
            top: $vp->top,
            near: $this->near,
            far: $this->far
        ));
    }

    public const function orthographic() : bool
    {
        return $this->mode != Projection::perspective;
    }

    /**
     * World rectangle of an orthographic camera. Perspective has none; check `orthographic()` first.
     * Returns an empty rect there because `Viewport?` still miscompiles.
     */
    public const function viewport(int32 $width, int32 $height, float32 $scaleX, float32 $scaleY) : Viewport
    {
        float32 $w = $width as float32;
        float32 $h = $height as float32;
        float32 $ssW = $w / $scaleX;
        float32 $ssH = $h / $scaleY;

        if ($this->mode == Projection::perspective) {
            return Viewport(left: 0.0f, right: 0.0f, bottom: 0.0f, top: 0.0f, $ssW, $ssH);
        }

        if ($this->mode == Projection::orthographicScreen) {
            return Viewport(left: 0.0f, right: $ssW, bottom: $ssH, top: 0.0f, $ssW, $ssH);
        }

        float32 $halfWidth = $ssW * 0.5f;
        float32 $halfHeight = $ssH * 0.5f;

        if ($this->mode == Projection::orthographicStaticWorld) {
            $halfHeight = $this->staticWorldHeight * 0.5f;
            $halfWidth = $halfHeight * ($w / $h);
        }

        if ($this->flipViewportY) {
            $halfHeight = -$halfHeight;
        }

        return Viewport(
            left: -$halfWidth,
            right: $halfWidth,
            bottom: -$halfHeight,
            top: $halfHeight,
            $ssW,
            $ssH
        );
    }

    /**
     * View matrix from an interpolated pose. Pose scale is ignored; a scaled camera would scale the whole scene.
     */
    public const function view(const Pose& $pose) : Mat4
    {
        Mat4 $model = translate($pose->position) * Mat4($pose->orientation);
        return inverse($model);
    }

    /**
     * The per-frame fact later passes read. `$pose` is the interpolated camera pose (`Transform.mix($compensation)`).
     */
    public const function data(
        const Pose& $pose,
        int32 $width,
        int32 $height,
        float32 $scaleX,
        float32 $scaleY,
        float32 $compensation
    ) : CameraData
    {
        Mat4 $projection = $this->projection($width, $height, $scaleX, $scaleY);
        Mat4 $view = $this->view($pose);
        Mat4 $projectionView = $projection * $view;
        return CameraData(
            $projection,
            $view,
            $projectionView,
            inverse($projection),
            inverse($projectionView),
            Frustum(zeroOne: $projectionView),
            $pose->position,
            $compensation,
            $width,
            $height,
            $scaleX,
            $scaleY,
            $this->viewport($width, $height, $scaleX, $scaleY),
            $this->orthographic()
        );
    }
}
