/**
 * Frame fact that pins the published camera to a scripted pose.
 * The Host sets it while DCapture holds an override; CameraSystem reads it instead of the
 * ActiveCamera transform. The entity's Transform is never touched, so dropping the override
 * hands the camera straight back to its controller.
 */

namespace visu::graphics;

use visu::math::{Quat, Vec3};

public class CameraOverrideData
{
    public const Vec3 $position;
    public const Quat $orientation;

    /**
     * Vertical field of view in degrees. Zero keeps the camera's own, the same convention as a
     * dcapture `CameraSpec.pose`.
     */
    public const float32 $fov;

    public constructor(Vec3 $position, Quat $orientation, float32 $fov = 0.0f)
    {
        $this->position = $position;
        $this->orientation = $orientation;
        $this->fov = $fov;
    }
}
