/**
 * Everything a pass needs from the camera this frame. Written once by `CameraSystem.render`;
 * later passes read it through `Frame.get<CameraData>()`. Immutable so readers cannot disagree.
 * Render matrices (view, projection, frustum, position) are what the GPU binds. The cull set is
 * the same until freeze, then it stays on the snapshot so culling and LOD do not follow the fly camera.
 */

namespace visu::graphics;

use visu::geo::{Frustum, Ray};
use visu::math::{Mat4, Vec2, Vec3, Vec4, normalize};

public class CameraData
{
    public const Mat4 $projection;
    public const Mat4 $view;
    public const Mat4 $projectionView;
    public const Mat4 $inverseProjection;
    public const Mat4 $inverseProjectionView;
    public const Frustum $frustum;

    /**
     * Interpolated world position of the camera.
     */
    public const Vec3 $position;

    /**
     * Cull half. Equals the render frustum/eye until `camera freeze`; then this set stays on the
     * snapshot while view/projection/position keep following the flying camera.
     * `cullInverseProjectionView` is only for `cullCorners`.
     */
    public const Frustum $cullFrustum;
    public const Vec3 $cullPosition;
    public const Mat4 $cullInverseProjectionView;
    public const bool $cullFrozen;

    /**
     * Lag between ticks, 0 just after an update, approaching 1 before the next.
     */
    public const float32 $compensation;
    public const int32 $resolutionX;
    public const int32 $resolutionY;
    public const float32 $contentScaleX;
    public const float32 $contentScaleY;

    /**
     * Orthographic world rectangle; meaningless unless `hasViewport`.
     */
    public const Viewport $viewport;
    public const bool $hasViewport;

    public constructor(
        Mat4 $projection,
        Mat4 $view,
        Mat4 $projectionView,
        Mat4 $inverseProjection,
        Mat4 $inverseProjectionView,
        Frustum $frustum,
        Vec3 $position,
        float32 $compensation,
        int32 $resolutionX,
        int32 $resolutionY,
        float32 $contentScaleX,
        float32 $contentScaleY,
        Viewport $viewport,
        bool $hasViewport
    )
    {
        $this->projection = $projection;
        $this->view = $view;
        $this->projectionView = $projectionView;
        $this->inverseProjection = $inverseProjection;
        $this->inverseProjectionView = $inverseProjectionView;
        $this->frustum = $frustum;
        $this->position = $position;
        $this->compensation = $compensation;
        $this->resolutionX = $resolutionX;
        $this->resolutionY = $resolutionY;
        $this->contentScaleX = $contentScaleX;
        $this->contentScaleY = $contentScaleY;
        $this->viewport = $viewport;
        $this->hasViewport = $hasViewport;
        $this->cullFrustum = $frustum;
        $this->cullPosition = $position;
        $this->cullInverseProjectionView = $inverseProjectionView;
        $this->cullFrozen = false;
    }

    /**
     * Render half from `$render`, cull half from `$cull`'s render matrices. Freeze is the only
     * caller: both halves start equal from the unmarked constructor.
     */
    public constructor(cullFrom: CameraData $render, CameraData $cull)
    {
        $this->projection = $render->projection;
        $this->view = $render->view;
        $this->projectionView = $render->projectionView;
        $this->inverseProjection = $render->inverseProjection;
        $this->inverseProjectionView = $render->inverseProjectionView;
        $this->frustum = $render->frustum;
        $this->position = $render->position;
        $this->compensation = $render->compensation;
        $this->resolutionX = $render->resolutionX;
        $this->resolutionY = $render->resolutionY;
        $this->contentScaleX = $render->contentScaleX;
        $this->contentScaleY = $render->contentScaleY;
        $this->viewport = $render->viewport;
        $this->hasViewport = $render->hasViewport;
        $this->cullFrustum = $cull->frustum;
        $this->cullPosition = $cull->position;
        $this->cullInverseProjectionView = $cull->inverseProjectionView;
        $this->cullFrozen = true;
    }

    /**
     * Keep this fact's render camera and take the cull volume from `$cull`.
     */
    public const function withCullFrom(CameraData $cull) : CameraData
    {
        return CameraData(cullFrom: $this, $cull);
    }

    /**
     * Framebuffer size in device pixels.
     */
    public const function resolution() : Vec2
    {
        return Vec2($this->resolutionX as float32, $this->resolutionY as float32);
    }

    /**
     * Framebuffer size in logical points (device pixels divided by content scale).
     */
    public const function scaledResolution() : Vec2
    {
        return Vec2(
            ($this->resolutionX as float32) / $this->contentScaleX,
            ($this->resolutionY as float32) / $this->contentScaleY
        );
    }

    /**
     * Picking ray through a normalized device point (-1..1, y up).
     */
    public const function ray(Vec2 $ndc) : Ray
    {
        Vec4 $far = $this->inverseProjectionView * Vec4($ndc->x, $ndc->y, 1.0f, 1.0f);
        Vec3 $point = Vec3($far->x / $far->w, $far->y / $far->w, $far->z / $far->w);
        return Ray($this->position, normalize($point - $this->position));
    }

    /**
     * Eight world corners of the cull volume. 0..3 is the near rectangle, 4..7 the far, in the
     * same NDC order as the shadow slice (top-left, top-right, bottom-right, bottom-left).
     */
    public const function cullCorners() : Vec3[8]
    {
        return cameraUnprojectCorners($this->cullInverseProjectionView);
    }

    /**
     * Slot 1 payload for the camera uniform block. std140 needs mat4 and vec4 only.
     */
    public const function uniforms() : CameraUniforms
    {
        float32 $w = $this->resolutionX as float32;
        float32 $h = $this->resolutionY as float32;
        return CameraUniforms(
            $this->projection,
            $this->view,
            $this->projectionView,
            $this->inverseProjection,
            $this->inverseProjectionView,
            Vec4($this->position->x, $this->position->y, $this->position->z, 1.0f),
            Vec4($w, $h, 1.0f / $w, 1.0f / $h)
        );
    }
}

/**
 * Mirrors `CameraUniforms` in resources/shaders/include/visu/camera.glsl at uniform slot 1.
 */
public struct CameraUniforms
{
    public Mat4 $projection;
    public Mat4 $view;
    public Mat4 $projectionView;
    public Mat4 $inverseProjection;
    public Mat4 $inverseProjectionView;
    public Vec4 $position;
    public Vec4 $resolution;
}

internal function cameraUnprojectCorners(const Mat4& $invPV) : Vec3[8]
{
    Vec3[8] $ndc;
    $ndc[0] = Vec3(-1.0f, 1.0f, 0.0f);
    $ndc[1] = Vec3(1.0f, 1.0f, 0.0f);
    $ndc[2] = Vec3(1.0f, -1.0f, 0.0f);
    $ndc[3] = Vec3(-1.0f, -1.0f, 0.0f);
    $ndc[4] = Vec3(-1.0f, 1.0f, 1.0f);
    $ndc[5] = Vec3(1.0f, 1.0f, 1.0f);
    $ndc[6] = Vec3(1.0f, -1.0f, 1.0f);
    $ndc[7] = Vec3(-1.0f, -1.0f, 1.0f);
    Vec3[8] $world;
    int32 $i = 0;
    while ($i < 8) {
        Vec4 $clip = $invPV * Vec4($ndc[$i], 1.0f);
        $world[$i] = $clip->xyz() / $clip->w;
        $i = $i + 1;
    }

    return $world;
}
