/**
 * The target the scene is drawn into this frame. Host publishes it next to `HostPassData`;
 * systems read it instead of depending on DCapture.
 * Falls back to the backbuffer when nobody published one.
 */

namespace visu::graphics;

public class SceneTargetData
{
    public const TargetRef $target;

    public constructor(TargetRef $target)
    {
        $this->target = $target;
    }
}
