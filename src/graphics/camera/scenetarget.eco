/**
 * The target the scene is drawn into this frame. Quickstart publishes
 * it next to `QuickstartPassData`; systems read it instead of
 * depending on the quickstart harness. Falls back to the backbuffer
 * when nobody published one.
 */

namespace visu::graphics;

public class SceneTarget
{
    public const TargetRef $target;

    public constructor(TargetRef $target)
    {
        $this->target = $target;
    }
}
