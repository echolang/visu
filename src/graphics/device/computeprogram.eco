/**
 * One compute shader module and its workgroup size. Each backend mints its compute pipeline
 * lazily on first use (`ComputeEncoder.setKernel`, or Metal's `tessellateWith`).
 */

namespace visu::graphics;

internal struct ComputeProgramIds
{
    public static uint32 $next = 1;
}

public class ComputeProgram : GpuObject
{
    public Device $device;
    public const uint32 $id;
    public const string $name;

    /**
     * Threads per workgroup, from the kernel's `local_size`.
     */
    public const WorkgroupSize $group;
    internal ShaderModuleHandle $cs;
    private bool $dead;

    public constructor(Device $device, string $name, ShaderModuleHandle $cs, WorkgroupSize $group)
    {
        $this->device = $device;
        $this->id = ComputeProgramIds::$next;
        ComputeProgramIds::$next = ComputeProgramIds::$next + 1;
        $this->name = $name;
        $this->group = $group;
        $this->cs = $cs;
        $this->dead = false;
    }

    destructor()
    {
        $this->destroy();
    }

    public static function link(
        Device $device,
        string $name,
        const string& $bytes,
        WorkgroupSize $group
    ) : result<ComputeProgram, ShaderError>
    {
        ShaderModuleHandle $cs = guard $device->createShaderModule(.compute, $bytes, "{$name}.comp") else ($e) {
            return .error(.compile($e->message()));
        }
        return .ok(ComputeProgram($device, $name, $cs, $group));
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->device->destroyShaderModule($this->cs);
        $this->cs = ShaderModuleHandle::none();
    }

    public const function destroyed() : bool
    {
        return $this->dead;
    }
}
