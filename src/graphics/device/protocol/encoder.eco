/**
 * Open render-pass encoder checklist. Both backends write
 * `: RenderEncoderProtocol` so a missing method fails at the
 * class. Not a stored interface value.
 */

namespace visu::graphics;

public interface RenderEncoderProtocol
{
    /**
     * Color / depth / sample formats of this pass. The PSO key: setGpuPass mints state against
     * this, not against a string.
     */
    const function targetFormats() : TargetFormats;

    /**
     * Pass width in pixels (first color target). Viewport and scissor default to this if you never
     * set them.
     */
    const function width() : int32;

    /**
     * Pass height in pixels (first color target). Viewport and scissor default to this if you
     * never set them.
     */
    const function height() : int32;

    /**
     * Bind a GpuPass: program, vertex layout, raster, topology. Mints or reuses the PSO for these
     * formats. If you have not set a viewport or scissor yet, fills the whole target. Draw asserts
     * this ran.
     */
    function setGpuPass(const GpuPass& $pass) : void;

    /**
     * Map clip space onto a pixel rectangle. Skip it and setGpuPass covers the whole target.
     */
    function setViewport(int32 $x, int32 $y, int32 $w, int32 $h) : void;

    /**
     * Pixel clip rect, clamped to the target. Same default as viewport: the whole pass, unless you
     * set one.
     */
    function setScissor(int32 $x, int32 $y, int32 $w, int32 $h) : void;

    /**
     * Bind a GPU vertex buffer at `$binding`. `$offset` is bytes into that buffer.
     */
    function setVertexBuffer(uint32 $binding, Buffer $buffer, uint64 $offset = 0) : void;

    /**
     * Bind a GPU index buffer for drawIndexed. `$offset` is bytes into that buffer.
     */
    function setIndexBuffer(Buffer $buffer, IndexType $type, uint64 $offset = 0) : void;

    /**
     * Same as setVertexBuffer, but the data lives in this frame's ring. Transient from another
     * frame asserts.
     */
    function setVertexTransient(uint32 $binding, TransientSlice $slice) : void;

    /**
     * Same as setIndexBuffer, from this frame's ring. Transient from another frame asserts.
     */
    function setIndexTransient(TransientSlice $slice, IndexType $type) : void;

    /**
     * Bind a typed payload at `$slot`. Slot is the identity, not a uniform-block name: 0 is
     * per-draw, 1+ are shared. Slice must be this frame's transient.
     */
    function bindUniform(uint32 $slot, TransientSlice $slice) : void;

    /**
     * Bind a sampled texture at `$slot`. The texture must already be shaderRead; this does not
     * transition it.
     */
    function bindTexture(uint32 $slot, Texture $texture, Sampler $sampler) : void;

    /**
     * Non-indexed draw. Needs setGpuPass first. Flushes the uniforms and textures bound since the
     * last draw.
     */
    function draw(int32 $first, int32 $count, int32 $instances = 1) : void;

    /**
     * Indexed draw. Needs an index buffer (or transient) and setGpuPass. Metal currently asserts
     * `$vertexOffset == 0`.
     */
    function drawIndexed(int32 $firstIndex, int32 $count, int32 $instances = 1, int32 $vertexOffset = 0) : void;

    /**
     * Close the encoder. The destructor asserts you called this. Device only allows one open
     * encoder at a time. Pairs with Device.beginRender.
     */
    function endRender() : void;
}
