/**
 * Open render-pass encoder checklist.
 * Both backends write `: RenderEncoderProtocol` so a missing method fails at the class.
 * Not a stored interface value.
 */

namespace visu::graphics;

public interface RenderEncoderProtocol
{

    /**
     * Color / depth / sample formats of this pass.
     * The PSO key: setGpuPass mints state against this, not against a string.
     */
    const function targetFormats() : TargetFormats;

    /**
     * Pass width in pixels (first color target).
     * Viewport and scissor default to this if you never set them.
     */
    const function width() : int32;

    /**
     * Pass height in pixels (first color target).
     * Viewport and scissor default to this if you never set them.
     */
    const function height() : int32;

    /**
     * Bind a GpuPass: program, vertex layout, raster, topology.
     * Mints or reuses the PSO for these formats.
     * If you have not set a viewport or scissor yet, fills the whole target. Draw asserts this ran.
     */
    function setGpuPass(const GpuPass& $pass) : void;

    /**
     * Map clip space onto a pixel rectangle. Skip it and setGpuPass covers the whole target.
     */
    function setViewport(int32 $x, int32 $y, int32 $w, int32 $h) : void;

    /**
     * Pixel clip rect, clamped to the target.
     * Same default as viewport: the whole pass, unless you set one.
     */
    function setScissor(int32 $x, int32 $y, int32 $w, int32 $h) : void;

    /**
     * Bind a GPU vertex buffer at `$binding`. `$offset` is bytes into that buffer.
     */
    function setVertexBuffer(uint32 $binding, Buffer $buffer, uint64 $offset = 0) : void;

    /**
     * Bind a GPU index buffer for drawIndexed. `$offset` is bytes into that buffer.
     */
    function setIndexBuffer(Buffer $buffer, IndexType $type, uint64 $offset = 0) : void;

    /**
     * Same as setVertexBuffer, but the data lives in this frame's ring.
     * Transient from another frame asserts.
     */
    function setVertexTransient(uint32 $binding, TransientSlice $slice) : void;

    /**
     * Same as setIndexBuffer, from this frame's ring. Transient from another frame asserts.
     */
    function setIndexTransient(TransientSlice $slice, IndexType $type) : void;

    /**
     * Bind a typed payload at `$slot`.
     * Slot is the identity, not a uniform-block name: 0 is per-draw, 1+ are shared.
     * Slice must be this frame's transient.
     */
    function bindUniform(uint32 $slot, TransientSlice $slice) : void;

    /**
     * Bind a sampled texture at `$slot`.
     * The texture must already be shaderRead; this does not transition it.
     * Bound to both vertex and fragment stages.
     */
    function bindTexture(uint32 $slot, Texture $texture, Sampler $sampler) : void;

    /**
     * Bind a storage buffer at `$slot` (GLSL `set = 2, binding = $slot`) for vertex and fragment
     * reads. `$offset` is bytes into that buffer.
     */
    function bindStorage(uint32 $slot, Buffer $buffer, uint64 $offset = 0) : void;

    /**
     * Bind this frame's transient `$slice` as the storage buffer at `$slot`, read only: per
     * frame rows the CPU wrote (`allocTransient` at `limits.storageAlign`) that a kernel or a
     * draw reads without a buffer of their own. A transient from another frame asserts.
     */
    function bindStorage(uint32 $slot, transient: TransientSlice $slice) : void;

    /**
     * GPU per-patch tessellation factors for the next patches draw. Reads the bound vertex transient and uniform slots.
     * Metal records `$kernel` into the frame's pre-render compute command buffer and binds the factor slice it writes;
     * Vulkan does nothing: the tessellation control shader owns the factors there.
     */
    function tessellateWith(ComputeProgram $kernel, uint32 $patchCount) : void;

    /**
     * Non-indexed draw. Needs setGpuPass first.
     * Flushes the uniforms and textures bound since the last draw.
     * Topology.patches: `$count` is control-point vertices; Metal converts to patchCount.
     */
    function draw(int32 $first, int32 $count, int32 $instances = 1) : void;

    /**
     * Indexed draw. Needs an index buffer (or transient) and setGpuPass.
     * Metal currently asserts `$vertexOffset == 0`.
     */
    function drawIndexed(int32 $firstIndex, int32 $count, int32 $instances = 1, int32 $vertexOffset = 0) : void;

    /**
     * Non-indexed draw whose arguments a kernel wrote: four uint32 at `$offset` in `$arguments`
     * (vertex count, instance count, first vertex, first instance). Needs setGpuPass and a
     * buffer made with `BUFFER_INDIRECT`. The CPU never learns the count, so the draw
     * statistics record the call and no triangles.
     */
    function drawIndirect(Buffer $arguments, uint64 $offset = 0) : void;

    /**
     * Indexed draw whose arguments a kernel wrote: five uint32 at `$offset` in `$arguments`
     * (index count, instance count, first index, base vertex, first instance), over the bound
     * index buffer. Needs setGpuPass, an index buffer and a buffer made with `BUFFER_INDIRECT`.
     * The draw statistics record the call as indirect and indexed, and no triangles.
     */
    function drawIndexedIndirect(Buffer $arguments, uint64 $offset = 0) : void;

    /**
     * Bind `$table` as set 3 for the draws that follow, in every stage, and make its textures
     * resident for this encoder. Bind it once per encoder, not per draw.
     */
    function bindTextureTable(TextureTable $table) : void;

    /**
     * Close the encoder. The destructor asserts you called this.
     * Device only allows one open encoder at a time. Pairs with Device.beginRender.
     */
    function endRender() : void;
}
