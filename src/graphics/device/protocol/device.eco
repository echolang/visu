/**
 * Compile-time GPU device checklist. Both backends write
 * `: DeviceProtocol` so a missing method fails at the class.
 * Not a runtime switch: call sites still hold Device.
 */

namespace visu::graphics;

public interface DeviceProtocol
{
    /**
     * Construct is cheap and headless. This is the call that actually talks to the GPU: instance,
     * queue, frame slots, adapter line. Idempotent. Call it before attachSurface.
     */
    function initialize(const DeviceOptions& $options) : status<DeviceError>;

    /**
     * Bind a window surface so this device can present. Needs initialize first. Builds the
     * swapchain (Vulkan) or the CAMetalLayer (Metal).
     */
    function attachSurface(Surface $surface, int32 $width, int32 $height) : status<DeviceError>;

    /**
     * Record a new drawable size. Applied on the next beginFrame, not mid-frame. 0x0 is a skip,
     * not a crash.
     */
    function resizeSurface(int32 $width, int32 $height) : void;

    /**
     * Drop the surface and swapchain so the window can die. The device stays: later destroy()
     * still works. This is a clean stop, not a die.
     */
    function loseSurface() : void;

    /**
     * Whether loseSurface() ran or the surface died under us. Don't beginFrame a lost device.
     */
    const function surfaceLost() : bool;

    /**
     * Stall until in-flight GPU work is done. Call this before destroying pool, shaders, or the
     * window.
     */
    function waitIdle() : void;

    /**
     * Alignment and caps (uniform offset, max range, vertex textures). Use these instead of
     * hardcoding 256.
     */
    const function limits() : DeviceLimits;

    /**
     * GPU identity for boot logs. Headless construct fills `$api` only; initialize fills the rest.
     */
    const function adapterInfo() : AdapterInfo;

    /**
     * GPU memory snapshot for instruments. `$budget` is 0 when unknown.
     */
    const function memoryStats() : MemoryStats;

    /**
     * Acquire the next swapchain image and open the frame. `.skipped` for a 0-size drawable. Don't
     * call this after shouldClose, or once surfaceLost().
     */
    function beginFrame(int32 $width, int32 $height) : result<FrameStatus, DeviceError>;

    /**
     * Submit, present, and drop the imported backbuffer Texture so it cannot keep Device alive.
     * Window.swap is this. Dump offscreen attachments, not the drawable.
     */
    function endFrame() : status<DeviceError>;

    /**
     * Index into the in-flight ring (0 .. frames-in-flight-1). Transient slices and per-frame GPU
     * objects live on this slot.
     */
    const function frameSlot() : uint32;

    /**
     * Monotonic completed-frame count. Not the ring slot.
     */
    const function frameIndex() : uint64;

    /**
     * This frame's swapchain image as an imported Texture. Only valid between beginFrame and
     * endFrame. Don't dump it: endFrame drops it, and Metal cannot blit the drawable.
     */
    function backbuffer() : Texture;

    /**
     * Pixel format of the swapchain. Match this when you mint an offscreen target you later blit
     * to the window.
     */
    const function backbufferFormat() : PixelFormat;

    /**
     * Tear vs wait-for-vblank. Takes effect on the next present (Metal on the layer, Vulkan by
     * rebuilding the swapchain).
     */
    function setVsync(bool $on) : void;

    /**
     * Requested present rate in Hz. 0 means the panel default. This is the wish, not a measured
     * fps.
     */
    function setPresentRate(int32 $hz) : void;

    /**
     * The requested present cadence. Not a measured fps.
     */
    const function presentRate() : int32;

    /**
     * Backing scale of the surface, framebuffer pixels per point. Metal actually resizes the
     * layer; Vulkan stores it because the swapchain is already in pixels.
     */
    function setContentsScale(float64 $scale) : void;

    /**
     * Framebuffer pixels per point. 1.0 until setContentsScale.
     */
    const function contentsScale() : float64;

    /**
     * Open a render encoder for this pass. Must be inside a frame, and no encoder already open.
     * Needs 1..4 color targets. Close it with endRender.
     */
    function beginRender(const RenderPassDesc& $desc) : RenderEncoder;

    /**
     * Put `$texture` into `$to`. Vulkan emits a barrier; Metal just stores the enum. Not inside a
     * render pass.
     */
    function transitionTexture(Texture $texture, ResourceState $to) : void;

    /**
     * Carve a host-visible slice from this frame's ring (uniforms, dynamic verts). Dies at
     * endFrame. Aligns up to `limits()->uniformAlign`.
     */
    function allocTransient(uint64 $bytes, uint64 $align) : TransientSlice;

    /**
     * Copy a texture to CPU bytes. After endFrame; stalls. Needs TEXTURE_TRANSFER_SRC. Depth and
     * imported textures fail.
     */
    function readbackTexture(Texture $texture) : result<array<uint8>, DeviceError>;

    /**
     * GPU blit, same size, same format. After endFrame; stalls. Not the window backbuffer.
     */
    function copyTexture(Texture $src, Texture $dst) : status<DeviceError>;

    /**
     * Allocate a GPU buffer. `Buffer` wraps this; typical code never calls it.
     */
    function createBuffer(const BufferDesc& $desc) : result<BufferHandle, DeviceError>;

    /**
     * Tear down a buffer the backend allocated. `Buffer.destroy` is the call site.
     */
    function destroyBuffer(BufferHandle $handle) : void;

    /**
     * CPU write into a host-visible buffer at `$offset`.
     */
    function uploadBuffer(BufferHandle $handle, uint64 $offset, ptr<const uint8> $src, uint64 $bytes) : void;

    /**
     * Allocate a 2D GPU texture. `Texture` wraps this handle.
     */
    function createTexture(const TextureDesc& $desc) : result<TextureHandle, DeviceError>;

    /**
     * Tear down a texture the backend allocated. Imported swapchain images no-op; the layer owns
     * those.
     */
    function destroyTexture(TextureHandle $handle) : void;

    /**
     * CPU write one mip level. Sets state to shaderRead. `$bytesPerRow` 0 means tightly packed.
     */
    function uploadTexture(Texture $texture, int32 $mip, ptr<const uint8> $src, uint64 $bytes, int32 $bytesPerRow) : void;

    /**
     * Fill mip 1+ from mip 0. Call after uploadTexture.
     */
    function generateMipmaps(Texture $texture) : void;

    /**
     * Get-or-create a sampler. Cached by filter/wrap, so the same desc is the same GPU object.
     */
    function createSampler(const SamplerDesc& $desc) : Sampler;

    /**
     * Compile a shader stage from `$bytes` (SPIR-V or Metal source). Metal entry points are `vs` /
     * `fs`.
     */
    function createShaderModule(ShaderKind $kind, const string& $bytes, string $name) : result<ShaderModuleHandle, DeviceError>;

    /**
     * Drop a compiled stage. `ShaderModule.destroy` is the call site.
     */
    function destroyShaderModule(ShaderModuleHandle $handle) : void;

    /**
     * Drop a pipeline state object. No create on this protocol: GpuPass / the backend mint them.
     */
    function destroyPipeline(PipelineHandle $handle) : void;
}
