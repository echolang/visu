/**
 * Texture formats, shader stage kind, and the on-disk suffix `scan` looks for.
 * The backend `#[if]` for the suffix is one of the four sites allowed outside the backend folders.
 */

namespace visu::graphics;

public enum PixelFormat
{
    case rgba8;
    case bgra8;
    case rgba8Srgb;
    case rgba16f;
    case rgba32f;
    case r8;
    case r16f;
    case r32f;
    case rg16f;
    case depth32f;
    case depth32fStencil8;
    case bc7;
    case bc7Srgb;
    case astc4x4;
    case astc4x4Srgb;

    public const function isDepth() : bool
    {
        return match ($this) {
            PixelFormat::depth32f => true,
            PixelFormat::depth32fStencil8 => true,
            else => false,
        };
    }

    /**
     * BC7 and ASTC 4x4. Upload is block rows, not bytes-per-pixel.
     */
    public const function isCompressed() : bool
    {
        return match ($this) {
            PixelFormat::bc7 => true,
            PixelFormat::bc7Srgb => true,
            PixelFormat::astc4x4 => true,
            PixelFormat::astc4x4Srgb => true,
            else => false,
        };
    }

    /**
     * Components per texel. A depth format reports none.
     */
    public const function channels() : int32
    {
        return match ($this) {
            PixelFormat::rgba8 => 4,
            PixelFormat::bgra8 => 4,
            PixelFormat::rgba8Srgb => 4,
            PixelFormat::rgba16f => 4,
            PixelFormat::rgba32f => 4,
            PixelFormat::rg16f => 2,
            PixelFormat::r8 => 1,
            PixelFormat::r16f => 1,
            PixelFormat::r32f => 1,
            PixelFormat::bc7 => 4,
            PixelFormat::bc7Srgb => 4,
            PixelFormat::astc4x4 => 4,
            PixelFormat::astc4x4Srgb => 4,
            else => 0,
        };
    }

    /**
     * How one component is stored, which is what a readback decodes.
     */
    public const function component() : Component
    {
        return match ($this) {
            PixelFormat::rgba8 => Component::unorm8,
            PixelFormat::bgra8 => Component::unorm8,
            PixelFormat::rgba8Srgb => Component::unorm8,
            PixelFormat::r8 => Component::unorm8,
            PixelFormat::bc7 => Component::unorm8,
            PixelFormat::bc7Srgb => Component::unorm8,
            PixelFormat::astc4x4 => Component::unorm8,
            PixelFormat::astc4x4Srgb => Component::unorm8,
            PixelFormat::rgba16f => Component::half,
            PixelFormat::rg16f => Component::half,
            PixelFormat::r16f => Component::half,
            PixelFormat::rgba32f => Component::float32,
            PixelFormat::r32f => Component::float32,
            else => Component::depth,
        };
    }
}

/**
 * Component storage behind a `PixelFormat`.
 */
public enum Component
{
    case unorm8;
    case half;
    case float32;
    case depth;
}

public enum ShaderKind
{
    case vertex;
    case fragment;
    case geometry;
    case tessControl;
    case tessEvaluation;
}

public enum SampleCount
{
    case one;
    case four;
}

public enum IndexType
{
    case uint16;
    case uint32;
}

public enum Topology
{
    case points;
    case lines;
    case lineStrip;
    case triangles;
    case triangleStrip;
    case patches;
}

public enum Filter
{
    case nearest;
    case linear;
    case nearestMipmapNearest;
    case nearestMipmapLinear;
    case linearMipmapNearest;
    case linearMipmapLinear;

    public const function mipmapped() : bool
    {
        return match ($this) {
            Filter::nearest => false,
            Filter::linear => false,
            else => true,
        };
    }
}

public enum Wrap
{
    case repeat;
    case mirroredRepeat;
    case clampToEdge;
    case clampToBorder;
}

#[if: (os == darwin || os == ios) && !VISU_BACKEND_VULKAN]
internal function shaderSuffix() : string
{
    return 'metal';
}
#[else]
internal function shaderSuffix() : string
{
    return 'spv';
}
#[end]

internal function pixelByteCount(PixelFormat $format) : uint32
{
    return match ($format) {
        PixelFormat::rgba8 => 4,
        PixelFormat::bgra8 => 4,
        PixelFormat::rgba8Srgb => 4,
        PixelFormat::rgba16f => 8,
        PixelFormat::rgba32f => 16,
        PixelFormat::r8 => 1,
        PixelFormat::r16f => 2,
        PixelFormat::r32f => 4,
        PixelFormat::rg16f => 4,
        PixelFormat::depth32f => 4,
        PixelFormat::depth32fStencil8 => 5,
        PixelFormat::bc7 => 0,
        PixelFormat::bc7Srgb => 0,
        PixelFormat::astc4x4 => 0,
        PixelFormat::astc4x4Srgb => 0,
    };
}

/**
 * Bytes for one tightly packed mip of `$width` x `$height`. Compressed is 16-byte 4x4 blocks.
 */
internal function mipByteCount(PixelFormat $format, int32 $width, int32 $height) : uint64
{
    if ($format->isCompressed()) {
        int32 $bw = ($width + 3) / 4;
        int32 $bh = ($height + 3) / 4;
        if ($bw < 1) {
            $bw = 1;
        }
        if ($bh < 1) {
            $bh = 1;
        }

        return (($bw as uint64) * ($bh as uint64)) * 16;
    }

    uint32 $bpp = pixelByteCount($format);
    if ($bpp == 0) {
        return 0;
    }

    return (($width as uint64) * ($height as uint64)) * ($bpp as uint64);
}

/**
 * Bytes from one row of texels (or one row of blocks) to the next.
 */
internal function mipRowBytes(PixelFormat $format, int32 $width) : uint64
{
    if ($format->isCompressed()) {
        int32 $bw = ($width + 3) / 4;
        if ($bw < 1) {
            $bw = 1;
        }

        return ($bw as uint64) * 16;
    }

    uint32 $bpp = pixelByteCount($format);
    return ($width as uint64) * ($bpp as uint64);
}
