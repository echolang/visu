/**
 * Device-wide caps shared by both arms.
 * Metal uniform buffer indices must equal `MTL_UNIFORM_BASE` in tools/shaders.php, and storage
 * buffer indices `MTL_STORAGE_BASE`.
 */

namespace visu::graphics;

public const uint32 FRAMES_IN_FLIGHT = 2;
public const uint32 UNIFORM_SLOTS = 4;
public const uint32 TEXTURE_SLOTS = 16;
public const uint32 MAX_COLOR_TARGETS = 8;
public const uint32 VERTEX_BINDING = 0;
public const uint32 INSTANCE_BINDING = 1;
public const uint32 METAL_UNIFORM_BASE = 2;
// GLSL set 2 binding B; Metal [[buffer(METAL_STORAGE_BASE + B)]] in every stage
public const uint32 STORAGE_SLOTS = 8;
public const uint32 METAL_STORAGE_BASE = 6;
