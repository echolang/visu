/**
 * CPU-side draw and upload accounting for the instrument overlay and the profiler.
 * Encoders and in-frame uploads increment `$frame`; `roll` at endFrame publishes it as `$last`.
 */

namespace visu::graphics;

public struct DrawStats
{
    public int32 $draws = 0;
    public int32 $indexed = 0;

    /**
     * Draws whose arguments the GPU wrote; their vertices and triangles are not counted.
     */
    public int32 $indirect = 0;
    public int32 $pipelineBinds = 0;
    public int64 $vertices = 0;
    public int64 $triangles = 0;
    public int32 $patches = 0;

    /**
     * Texture and buffer uploads made inside the frame, and their bytes. Loads belong in a load
     * step: a frame that uploads megabytes hitches.
     */
    public int32 $uploads = 0;
    public int64 $uploadBytes = 0;

    /**
     * Counts since `$start` (this minus start), clamped at zero.
     */
    public const function since(const DrawStats& $start) : DrawStats
    {
        DrawStats $d = DrawStats();
        $d->draws = sub32($this->draws, $start->draws);
        $d->indexed = sub32($this->indexed, $start->indexed);
        $d->indirect = sub32($this->indirect, $start->indirect);
        $d->pipelineBinds = sub32($this->pipelineBinds, $start->pipelineBinds);
        $d->vertices = sub64($this->vertices, $start->vertices);
        $d->triangles = sub64($this->triangles, $start->triangles);
        $d->patches = sub32($this->patches, $start->patches);
        $d->uploads = sub32($this->uploads, $start->uploads);
        $d->uploadBytes = sub64($this->uploadBytes, $start->uploadBytes);
        return $d;
    }
}

public class DrawCounters
{
    public DrawStats $frame;
    public DrawStats $last;

    public constructor()
    {
        $this->frame = DrawStats();
        $this->last = DrawStats();
    }

    /**
     * Publish this frame as last and start a new counter. Device.endFrame calls this.
     */
    public function roll() : void
    {
        $this->last = $this->frame;
        $this->frame = DrawStats();
    }

    public function bind() : void
    {
        DrawStats $s = $this->frame;
        $s->pipelineBinds = $s->pipelineBinds + 1;
        $this->frame = $s;
    }

    public function draw(Topology $top, int32 $count, int32 $instances, int32 $cps = 0) : void
    {
        $this->add($top, $count, $instances, $cps, false);
    }

    public function drawIndexed(Topology $top, int32 $count, int32 $instances, int32 $cps = 0) : void
    {
        $this->add($top, $count, $instances, $cps, true);
    }

    /**
     * An upload of `$bytes` made inside the frame. `Texture.upload` and `bufferUpload` call this
     * from the shared device layer; the backends only copy.
     */
    public function upload(uint64 $bytes) : void
    {
        DrawStats $s = $this->frame;
        $s->uploads = $s->uploads + 1;
        $s->uploadBytes = $s->uploadBytes + ($bytes as int64);
        $this->frame = $s;
    }

    /**
     * A draw the GPU sized: counted as a draw (and indexed when it is), never as vertices.
     */
    public function drawIndirect(Topology $top, bool $indexed) : void
    {
        DrawStats $s = $this->frame;
        $s->draws = $s->draws + 1;
        $s->indirect = $s->indirect + 1;
        if ($indexed) {
            $s->indexed = $s->indexed + 1;
        }

        $this->frame = $s;
    }

    private function add(
        Topology $top,
        int32 $count,
        int32 $instances,
        int32 $cps,
        bool $indexed
    ) : void
    {
        int32 $n = $instances;
        if ($n < 1) {
            $n = 1;
        }

        int32 $c = $count;
        if ($c < 0) {
            $c = 0;
        }

        DrawStats $s = $this->frame;
        $s->draws = $s->draws + 1;
        if ($indexed) {
            $s->indexed = $s->indexed + 1;
        }

        $s->vertices = $s->vertices + (($c as int64) * ($n as int64));
        $s->triangles = $s->triangles + drawTriangles($top, $c, $n);
        $s->patches = $s->patches + drawPatches($top, $c, $n, $cps);
        $this->frame = $s;
    }
}

internal function drawTriangles(Topology $top, int32 $count, int32 $instances) : int64
{
    int32 $strip = $count - 2;
    if ($strip < 0) {
        $strip = 0;
    }

    return match ($top) {
        Topology::triangles => (($count / 3) as int64) * ($instances as int64),
        Topology::triangleStrip => ($strip as int64) * ($instances as int64),
        else => 0 as int64,
    };
}

internal function drawPatches(Topology $top, int32 $count, int32 $instances, int32 $cps) : int32
{
    int32 $p = $cps;
    if ($p < 1) {
        $p = 4;
    }

    return match ($top) {
        Topology::patches => ($count / $p) * $instances,
        else => 0,
    };
}

internal function sub32(int32 $a, int32 $b) : int32
{
    int32 $d = $a - $b;
    if ($d < 0) {
        return 0;
    }

    return $d;
}

internal function sub64(int64 $a, int64 $b) : int64
{
    int64 $d = $a - $b;
    if ($d < 0) {
        return 0;
    }

    return $d;
}
