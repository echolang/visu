/**
 * One compiled shader stage. SPIR-V bytes (Vulkan) or MSL (Metal).
 * Creation is Phase 3.
 */

namespace visu::graphics;

public class ShaderModule : GpuObject
{
    public Device $device;
    public const ShaderModuleHandle $handle;
    public const ShaderKind $kind;
    public const string $name;
    private bool $dead;

    public constructor(Device $device, ShaderKind $kind, ShaderModuleHandle $handle, string $name)
    {
        $this->device = $device;
        $this->handle = $handle;
        $this->kind = $kind;
        $this->name = $name;
        $this->dead = false;
    }

    destructor()
    {
        $this->destroy();
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->device->destroyShaderModule($this->handle);
    }
}
