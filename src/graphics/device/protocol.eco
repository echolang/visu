/**
 * Compile-time GPU device. Both backends write `: DeviceProtocol`
 * / `: RenderEncoderProtocol` so a missing method fails at the
 * class. Not a runtime switch — call sites still hold Device.
 */

namespace visu::graphics;

public interface DeviceProtocol
{
    function initialize(const DeviceOptions& $options) : status<DeviceError>;
    function attach(Surface $surface, int32 $width, int32 $height) : status<DeviceError>;
    function resize(int32 $width, int32 $height) : void;
    function lose() : void;
    const function lost() : bool;
    function waitIdle() : void;
    const function limits() : DeviceLimits;
    const function adapter() : AdapterInfo;
    const function memory() : MemoryStats;

    function beginFrame(int32 $width, int32 $height) : result<FrameStatus, DeviceError>;
    function endFrame() : status<DeviceError>;
    const function frameSlot() : uint32;
    const function frameIndex() : uint64;
    function backbuffer() : Texture;
    const function backbufferFormat() : PixelFormat;
    function setVsync(bool $on) : void;
    function setPresentRate(int32 $hz) : void;
    const function presentRate() : int32;
    function setContentsScale(float64 $scale) : void;
    const function contentsScale() : float64;

    function beginRender(const RenderPassDesc& $desc) : RenderEncoder;
    function transition(Texture $texture, ResourceState $to) : void;
    function scratch(uint64 $bytes, uint64 $align) : ScratchSlice;
    function readback(Texture $texture) : result<array<uint8>, DeviceError>;

    function createBuffer(const BufferDesc& $desc) : result<BufferHandle, DeviceError>;
    function destroyBuffer(BufferHandle $handle) : void;
    function uploadBuffer(BufferHandle $handle, uint64 $offset, ptr<const uint8> $src, uint64 $bytes) : void;
    function createTexture(const TextureDesc& $desc) : result<TextureHandle, DeviceError>;
    function destroyTexture(TextureHandle $handle) : void;
    function uploadTexture(Texture $texture, int32 $mip, ptr<const uint8> $src, uint64 $bytes, int32 $bytesPerRow) : void;
    function generateMipmaps(Texture $texture) : void;
    function sampler(const SamplerDesc& $desc) : Sampler;
    function createShaderModule(ShaderKind $kind, const string& $bytes, string $name) : result<ShaderModuleHandle, DeviceError>;
    function destroyShaderModule(ShaderModuleHandle $handle) : void;
    function destroyPipeline(PipelineHandle $handle) : void;
}

public interface RenderEncoderProtocol
{
    const function formats() : TargetFormats;
    const function width() : int32;
    const function height() : int32;
    function setPipeline(const GpuPass& $pass) : void;
    function setViewport(int32 $x, int32 $y, int32 $w, int32 $h) : void;
    function setScissor(int32 $x, int32 $y, int32 $w, int32 $h) : void;
    function setVertexBuffer(uint32 $binding, Buffer $buffer, uint64 $offset = 0) : void;
    function setIndexBuffer(Buffer $buffer, IndexType $type, uint64 $offset = 0) : void;
    function setVertexScratch(uint32 $binding, ScratchSlice $slice) : void;
    function setIndexScratch(ScratchSlice $slice, IndexType $type) : void;
    function bindUniform(uint32 $slot, ScratchSlice $slice) : void;
    function bindTexture(uint32 $slot, Texture $texture, Sampler $sampler) : void;
    function draw(int32 $first, int32 $count, int32 $instances = 1) : void;
    function drawIndexed(int32 $firstIndex, int32 $count, int32 $instances = 1, int32 $vertexOffset = 0) : void;
    function end() : void;
}
