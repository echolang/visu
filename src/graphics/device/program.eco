/**
 * Linked program. `id` is process-unique and part of the PSO key.
 * Owns the vertex and fragment modules, and tessellation stages when present.
 */

namespace visu::graphics;

internal struct ProgramIds
{
    public static uint32 $next = 1;
}

public class ShaderProgram : GpuObject
{
    public Device $device;
    public const uint32 $id;
    public const string $name;
    public const bool $tessellated;
    internal ShaderModuleHandle $vs;
    internal ShaderModuleHandle $fs;
    internal ShaderModuleHandle $tcs;
    internal ShaderModuleHandle $tes;
    private bool $dead;

    public constructor(
        Device $device,
        string $name,
        ShaderModuleHandle $vs,
        ShaderModuleHandle $fs,
        ShaderModuleHandle $tcs,
        ShaderModuleHandle $tes,
        bool $tessellated
    )
    {
        $this->device = $device;
        $this->id = ProgramIds::$next;
        ProgramIds::$next = ProgramIds::$next + 1;
        $this->name = $name;
        $this->vs = $vs;
        $this->fs = $fs;
        $this->tcs = $tcs;
        $this->tes = $tes;
        $this->tessellated = $tessellated;
        $this->dead = false;
        $this->device->counts->noteProgramCreated();
    }

    destructor()
    {
        $this->destroy();
    }

    public static function link(
        Device $device,
        string $name,
        const string& $vertexBytes,
        const string& $fragmentBytes
    ) : result<ShaderProgram, ShaderError>
    {
        return ShaderProgram::link(
            $device,
            $name,
            $vertexBytes,
            $fragmentBytes,
            tessControl: '',
            tessEvaluation: ''
        );
    }

    public static function link(
        Device $device,
        string $name,
        const string& $vertexBytes,
        const string& $fragmentBytes,
        tessControl: string $tesscBytes,
        tessEvaluation: string $tesseBytes
    ) : result<ShaderProgram, ShaderError>
    {
        ShaderModuleHandle $vs = guard $device->createShaderModule(.vertex, $vertexBytes, "{$name}.vert") else ($e) {
            return .error(.compile($e->message()));
        }
        ShaderModuleHandle $fs = guard $device->createShaderModule(.fragment, $fragmentBytes, "{$name}.frag") else ($e) {
            $device->destroyShaderModule($vs);
            return .error(.compile($e->message()));
        }
        ShaderModuleHandle $tcs = ShaderModuleHandle::none();
        ShaderModuleHandle $tes = ShaderModuleHandle::none();
        bool $tess = false;
        if (!$tesseBytes->empty()) {
            ShaderModuleHandle $eval = guard $device->createShaderModule(
                .tessEvaluation,
                $tesseBytes,
                "{$name}.tesse"
            ) else ($e) {
                $device->destroyShaderModule($vs);
                $device->destroyShaderModule($fs);
                return .error(.compile($e->message()));
            }
            $tes = $eval;
            $tess = true;
        }

        if (!$tesscBytes->empty()) {
            ShaderModuleHandle $ctrl = guard $device->createShaderModule(
                .tessControl,
                $tesscBytes,
                "{$name}.tessc"
            ) else ($e) {
                $device->destroyShaderModule($vs);
                $device->destroyShaderModule($fs);
                if ($tes->alive()) {
                    $device->destroyShaderModule($tes);
                }

                return .error(.compile($e->message()));
            }
            $tcs = $ctrl;
            $tess = true;
        }

        return .ok(ShaderProgram($device, $name, $vs, $fs, $tcs, $tes, $tess));
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->device->counts->noteProgramDestroyed();
        $this->device->forgetProgram($this->id);
        $this->device->destroyShaderModule($this->vs);
        $this->device->destroyShaderModule($this->fs);
        if ($this->tcs->alive()) {
            $this->device->destroyShaderModule($this->tcs);
        }

        if ($this->tes->alive()) {
            $this->device->destroyShaderModule($this->tes);
        }

        $this->vs = ShaderModuleHandle::none();
        $this->fs = ShaderModuleHandle::none();
        $this->tcs = ShaderModuleHandle::none();
        $this->tes = ShaderModuleHandle::none();
    }

    public const function destroyed() : bool
    {
        return $this->dead;
    }
}
