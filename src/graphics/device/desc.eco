/**
 * Create-info and pass descriptions. Typed structs, not maps.
 */

namespace visu::graphics;

use visu::math::Vec4;


public enum BufferUsage
{
    case vertex;
    case index;
    case uniform;
    case storage;
}

public struct BufferDesc
{
    public BufferUsage $usage;
    public uint64 $bytes;
    public string $label = '';
}

public const uint32 TEXTURE_SAMPLED = 1;
public const uint32 TEXTURE_RENDER_TARGET = 2;
public const uint32 TEXTURE_TRANSFER_SRC = 4;
public const uint32 TEXTURE_TRANSFER_DST = 8;

/**
 * What the texture is shaped like.
 * A cube is six square array slices in the order +X -X +Y -Y +Z -Z.
 * Sampling takes a direction, so wrap modes never apply to it.
 * An array2D is N 2D slices; `TextureDesc.arrayLength` is the slice count.
 */
public enum TextureKind
{
    case texture2D;
    case cube;
    case array2D;
}

public struct TextureDesc
{
    public PixelFormat $format = .rgba8;
    public TextureKind $kind = .texture2D;
    public int32 $width;
    public int32 $height;
    public int32 $mips = 1;

    /**
     * Slice count when `kind` is `array2D`. Ignored for 2D (always 1) and cube (always 6).
     */
    public int32 $arrayLength = 1;
    public uint32 $usage = TEXTURE_SAMPLED | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
    public SampleCount $samples = .one;
    public string $label = '';

    public const function isDepth() : bool
    {
        return $this->format->isDepth();
    }

    /**
     * Array slices the GPU object holds. Cube faces count as slices.
     */
    public const function layers() : int32
    {
        return match ($this->kind) {
            TextureKind::texture2D => 1,
            TextureKind::cube => 6,
            TextureKind::array2D => $this->arrayLength,
        };
    }
}

public struct SamplerDesc
{
    public Filter $min = .linear;
    public Filter $mag = .linear;
    public Wrap $wrapS = .clampToEdge;
    public Wrap $wrapT = .clampToEdge;

    /**
     * Device sampler cache key. A call inside a string hole is plain text, so the filter and wrap codes are locals.
     */
    public const function key() : string
    {
        int32 $min = filterCode($this->min);
        int32 $mag = filterCode($this->mag);
        int32 $wrapS = wrapCode($this->wrapS);
        int32 $wrapT = wrapCode($this->wrapT);
        return "{$min}|{$mag}|{$wrapS}|{$wrapT}";
    }
}

public struct ColorTarget
{
    public Texture $texture;
    public LoadOp $load = .load;
    public StoreOp $store = .store;
    public Vec4 $clear;

    /**
     * Array slice. A cube face is a slice.
     */
    public int32 $face = 0;
    public int32 $mip = 0;

    public constructor(Texture $texture)
    {
        $this->texture = $texture;
        $this->load = .load;
        $this->store = .store;
        $this->clear = visu::math::Vec4(0.0f);
        $this->face = 0;
        $this->mip = 0;
    }

    /**
     * Color target that writes one face and mip of a cube or mipped texture.
     */
    public constructor(Texture $texture, face: int32 $face, int32 $mip = 0)
    {
        $this->texture = $texture;
        $this->load = .load;
        $this->store = .store;
        $this->clear = visu::math::Vec4(0.0f);
        $this->face = $face;
        $this->mip = $mip;
    }

    /**
     * Pixel width of the mip this target writes, not of mip 0.
     */
    public const function width() : int32
    {
        return mipSize($this->texture->desc->width, $this->mip);
    }

    public const function height() : int32
    {
        return mipSize($this->texture->desc->height, $this->mip);
    }

    /**
     * Assert the face and mip exist. The fields are public and can be set after construct.
     */
    public const function validate() : void
    {
        assert($this->face >= 0 && $this->face < $this->texture->layers(), 'beginRender face');
        assert($this->mip >= 0 && $this->mip < $this->texture->desc->mips, 'beginRender mip');
    }
}

public struct DepthTarget
{
    public Texture $texture;
    public LoadOp $load = .load;
    public StoreOp $store = .store;
    public float32 $clearDepth = 1.0f;
}

public struct RenderPassDesc
{
    public array<ColorTarget> $colors = array<ColorTarget>();
    public DepthTarget? $depth = null;
    public string $label = '';
}

public struct TargetFormats
{
    public PixelFormat[8] $colors;
    public uint32 $colorCount;
    public PixelFormat $depth;
    public bool $hasDepth;
    public SampleCount $samples;

    public constructor()
    {
        PixelFormat[8] $colors;
        uint32 $i = 0;

        while ($i < MAX_COLOR_TARGETS) {
            $colors[$i] = .rgba8;
            $i = $i + 1;
        }

        $this->colors = mv $colors;
        $this->colorCount = 0;
        $this->depth = .depth32f;
        $this->hasDepth = false;
        $this->samples = .one;
    }

    public const function fingerprint() : string
    {
        string $out = "{$this->colorCount}|";
        uint32 $i = 0;

        while ($i < $this->colorCount) {
            int32 $color = pixelCode($this->colors[$i]);
            $out = "{$out}{$color}|";
            $i = $i + 1;
        }

        int32 $sample = sampleCode($this->samples);

        if (!$this->hasDepth) {
            return "{$out}-|{$sample}";
        }

        int32 $depth = pixelCode($this->depth);
        return "{$out}{$depth}|{$sample}";
    }
}

public struct DeviceOptions
{
    public bool $validation = false;
    public bool $vsync = true;
    public string $appName = 'visu';
}

public struct DeviceLimits
{
    public uint64 $uniformAlign = 256;
    public uint64 $maxUniformRange = 65536;
    public bool $vertexTextures = false;
    public int32 $maxTessellationFactor = 0;
    public uint64 $tessFactorAlign = 256;
}

public enum AdapterKind
{
    case unknown;
    case integrated;
    case discrete;
    case virtual;
    case cpu;
}

/**
 * GPU identity for boot logs and debug overlays.
 * Headless construct fills `$api` only; `initialize` fills the rest.
 */
public struct AdapterInfo
{
    public string $api = '';
    public string $name = '';
    public string $vendor = '';
    public string $version = '';
    public AdapterKind $kind = .unknown;

    /**
     * One-line GPU identity for logs. Backend and version, then the adapter name.
     */
    public const function line() : string
    {
        if ($this->api->empty()) {
            return '';
        }

        string $head = $this->api;
        if (!$this->version->empty()) {
            $head = "{$head} {$this->version}";
        }

        if ($this->name->empty()) {
            return $head;
        }

        return "{$head} — {$this->name}";
    }
}

/**
 * GPU memory snapshot for instruments. `$budget` is 0 when unknown.
 * Metal fills driver numbers; Vulkan counts Device-owned allocations against the device-local heap size.
 */
public struct MemoryStats
{
    public uint64 $used = 0;
    public uint64 $budget = 0;
    public bool $unified = false;
}

/**
 * Size of mip `$level` of a `$size`-wide image, never below one.
 */
public function mipSize(int32 $size, int32 $level) : int32
{
    int32 $out = $size >> $level;

    if ($out < 1) {
        return 1;
    }

    return $out;
}

/**
 * How many mips a `$width` by `$height` image can carry.
 */
public function mipCount(int32 $width, int32 $height) : int32
{
    int32 $largest = $width;

    if ($height > $largest) {
        $largest = $height;
    }

    int32 $count = 1;

    while ($largest > 1) {
        $largest = $largest / 2;
        $count = $count + 1;
    }

    return $count;
}

internal function kindCode(TextureKind $kind) : int32
{
    return match ($kind) {
        TextureKind::texture2D => 0,
        TextureKind::cube => 1,
        TextureKind::array2D => 2,
    };
}

internal function pixelCode(PixelFormat $format) : int32
{
    return match ($format) {
        PixelFormat::rgba8 => 0,
        PixelFormat::bgra8 => 1,
        PixelFormat::rgba8Srgb => 2,
        PixelFormat::rgba16f => 3,
        PixelFormat::rgba32f => 4,
        PixelFormat::r8 => 5,
        PixelFormat::r16f => 6,
        PixelFormat::r32f => 7,
        PixelFormat::rg16f => 8,
        PixelFormat::depth32f => 9,
        PixelFormat::depth32fStencil8 => 10,
        PixelFormat::bc7 => 11,
        PixelFormat::bc7Srgb => 12,
        PixelFormat::astc4x4 => 13,
        PixelFormat::astc4x4Srgb => 14,
    };
}

internal function sampleCode(SampleCount $samples) : int32
{
    return match ($samples) {
        SampleCount::one => 1,
        SampleCount::four => 4,
    };
}

internal function filterCode(Filter $filter) : int32
{
    return match ($filter) {
        Filter::nearest => 0,
        Filter::linear => 1,
        Filter::nearestMipmapNearest => 2,
        Filter::nearestMipmapLinear => 3,
        Filter::linearMipmapNearest => 4,
        Filter::linearMipmapLinear => 5,
    };
}

internal function wrapCode(Wrap $wrap) : int32
{
    return match ($wrap) {
        Wrap::repeat => 0,
        Wrap::mirroredRepeat => 1,
        Wrap::clampToEdge => 2,
        Wrap::clampToBorder => 3,
    };
}
