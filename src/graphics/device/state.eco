/**
 * GPU object the pool can destroy, plus the layout token the graph tracks on `Texture`.
 */

namespace visu::graphics;

public interface GpuObject
{
    function destroy() : void;
}

public enum ResourceState
{
    case undefined;
    case colorTarget;
    case depthTarget;
    case shaderRead;
    case transferSrc;
    case transferDst;
    case present;
}

public enum LoadOp
{
    case load;
    case clear;
    case dontCare;
}

public enum StoreOp
{
    case store;
    case dontCare;
}

public enum FrameStatus
{
    case ready;
    case skipped;
}
