/**
 * Cached sampler. Minted only by Device.sampler(), not a GpuObject.
 */

namespace visu::graphics;

public class Sampler
{
    public Device $device;
    public const SamplerHandle $handle;
    public const SamplerDesc $desc;

    public constructor(Device $device, SamplerHandle $handle, SamplerDesc $desc)
    {
        $this->device = $device;
        $this->handle = $handle;
        $this->desc = $desc;
    }
}
