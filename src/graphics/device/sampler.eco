/**
 * Cached sampler. Minted only by Device.createSampler(), not a GpuObject.
 * The device keeps one instance per desc and swaps `$handle` in place when the anisotropy
 * level changes, so a holder never re-asks for it.
 */

namespace visu::graphics;

public class Sampler
{
    public SamplerHandle $handle;
    public const SamplerDesc $desc;

    public constructor(SamplerHandle $handle, SamplerDesc $desc)
    {
        $this->handle = $handle;
        $this->desc = $desc;
    }
}
