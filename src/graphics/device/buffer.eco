/**
 * A GPU buffer. Always device-local. Uploads go through `bufferUpload`: inside a frame they are
 * recorded and counted, outside a frame they may stall.
 */

namespace visu::graphics;

public class Buffer : GpuObject
{
    public Device $device;
    public const BufferHandle $handle;
    private bool $dead;

    public constructor(Device $device, BufferDesc $desc)
    {
        result<BufferHandle, DeviceError> $made = $device->createBuffer($desc);
        BufferHandle $handle = guard $made else ($e) {
            die($e->message());
        }
        $this->device = $device;
        $this->handle = $handle;
        $this->dead = false;
    }

    init
    {
        $this->device->counts->noteBufferCreated();
    }

    public constructor(Device $device, uint32 $usage, const array<float32>& $data)
    {
        usize $n = $data->count();
        assert($n > 0, 'buffer data');
        uint64 $bytes = ($n as uint64) * (mem::size<float32>() as uint64);
        BufferDesc $desc = BufferDesc($usage, $bytes);
        result<BufferHandle, DeviceError> $made = $device->createBuffer($desc);
        BufferHandle $handle = guard $made else ($e) {
            die($e->message());
        }
        $this->device = $device;
        $this->handle = $handle;
        $this->dead = false;
        ptr<const float32> $src = $data->data();
        bufferUpload($device, $handle, 0 as uint64, ptr<const uint8>($src:$), $bytes);
    }

    public constructor(Device $device, uint32 $usage, ptr<const uint8> $src, uint64 $bytes)
    {
        assert($bytes > 0, 'buffer data');
        BufferDesc $desc = BufferDesc($usage, $bytes);
        result<BufferHandle, DeviceError> $made = $device->createBuffer($desc);
        BufferHandle $handle = guard $made else ($e) {
            die($e->message());
        }
        $this->device = $device;
        $this->handle = $handle;
        $this->dead = false;
        bufferUpload($device, $handle, 0 as uint64, $src, $bytes);
    }

    destructor()
    {
        $this->destroy();
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->device->counts->noteBufferDestroyed();
        $this->device->destroyBuffer($this->handle);
    }

    public function upload(ptr<const uint8> $src, uint64 $bytes, uint64 $offset = 0) : void
    {
        assert(!$this->dead, 'upload on destroyed buffer');
        bufferUpload($this->device, $this->handle, $offset, $src, $bytes);
    }
}

/**
 * Every buffer upload lands here, so an upload inside a displayed frame is counted once in the
 * frame's draw stats on every backend; the backends only copy.
 */
internal function bufferUpload(Device $device, BufferHandle $handle, uint64 $offset, ptr<const uint8> $src, uint64 $bytes) : void
{
    $device->uploadBuffer($handle, $offset, $src, $bytes);
    if ($device->inFrame()) {
        $device->draws->upload($bytes);
    }
}

/**
 * Destroys an owned buffer if there is one; always returns null.
 */
internal function dropBuffer(Buffer? $buffer) : Buffer?
{
    Buffer $held = guard $buffer else {
        return null;
    }

    $held->destroy();
    return null;
}
