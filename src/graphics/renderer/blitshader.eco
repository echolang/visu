/**
 * Baked fullscreen blit shaders. Programs: blit. Generated by
 * `php tools/shaders.php --bake`. Do not edit.
 */

namespace visu::graphics;

#[if: os == darwin && !VISU_BACKEND_VULKAN]
internal function blitBytes(string $program, visu::graphics::ShaderKind $kind) : string?
{
    if ($program == 'blit' && $kind == visu::graphics::ShaderKind::fragment) {
        return '// generated by tools/shaders.php — do not edit
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct fs_out
{
    float4 FragColor [[color(0)]];
};

struct fs_in
{
    float2 vUv [[user(locn0)]];
};

fragment fs_out fs(fs_in in [[stage_in]], texture2d<float> u_texture [[texture(0)]], sampler u_textureSmplr [[sampler(0)]])
{
    fs_out out = {};
    out.FragColor = u_texture.sample(u_textureSmplr, in.vUv);
    return out;
}

';
    }

    if ($program == 'blit' && $kind == visu::graphics::ShaderKind::vertex) {
        return '// generated by tools/shaders.php — do not edit
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct vs_out
{
    float2 vUv [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vs_in
{
    float3 aPos [[attribute(0)]];
    float2 aUv [[attribute(1)]];
};

vertex vs_out vs(vs_in in [[stage_in]])
{
    vs_out out = {};
    out.gl_Position = float4(in.aPos, 1.0);
    out.vUv = float2(in.aUv.x, 1.0 - in.aUv.y);
    return out;
}

';
    }

    return null;
}
#[else]
internal function blitBytes(string $program, visu::graphics::ShaderKind $kind) : string?
{
    if ($program == 'blit' && $kind == visu::graphics::ShaderKind::fragment) {
        return visu::graphics::hexBytes('');
    }

    if ($program == 'blit' && $kind == visu::graphics::ShaderKind::vertex) {
        return visu::graphics::hexBytes('');
    }

    return null;
}
#[end]
