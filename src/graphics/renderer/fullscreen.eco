/**
 * Blit a texture onto a target as a fullscreen quad. Owns the
 * program (baked SPIR-V / MSL). load() after the device exists;
 * pass() mints FullscreenQuadPass.
 */

namespace visu::graphics;

public class FullscreenTextureRenderer
{
    private ShaderProgram? $program;

    public constructor()
    {
        $this->program = null;
    }

    destructor()
    {
        $this->destroy();
    }

    public function load(Device $device) : status<ShaderError>
    {
        $this->destroy();
        ShaderProgram $program = guard ShaderProgram::link(
            $device,
            'fullscreen-blit',
            blitVertexBytes(),
            blitFragmentBytes()
        ) else ($e) {
            return .error($e);
        }
        $this->program = $program;
        return .ok;
    }

    /**
     * Per-frame graph node: reads `$texture`, writes `$target`.
     */
    public function pass(Pipeline $pipeline, TargetRef $target, TextureRef $texture) : void
    {
        ShaderProgram? $maybe = $this->program;
        assert($maybe != null, 'fullscreen: load before pass');
        ShaderProgram $program = guard $maybe;
        $pipeline->add(FullscreenQuadPass($program, $target, $texture));
    }

    public function destroy() : void
    {
        ShaderProgram $held = guard $this->program else {
            return;
        }
        $held->destroy();
        $this->program = null;
    }
}

#[if: os == darwin && !VISU_BACKEND_VULKAN]
internal function blitVertexBytes() : string
{
    return blitVertexSource();
}

internal function blitFragmentBytes() : string
{
    return blitFragmentSource();
}
#[else]
internal function blitVertexBytes() : string
{
    return hexBytes(blitVertexSpvHex());
}

internal function blitFragmentBytes() : string
{
    return hexBytes(blitFragmentSpvHex());
}
#[end]

internal function hexBytes(string $hex) : string
{
    string $out = '';
    usize $i = 0;
    usize $n = $hex->size();

    while ($i + 1 < $n) {
        uint8 $hi = hexNibble($hex->byte($i));
        uint8 $lo = hexNibble($hex->byte($i + 1));
        $out->push(($hi << 4) | $lo);
        $i = $i + 2;
    }

    return $out;
}

internal function hexNibble(uint8 $b) : uint8
{
    if ($b >= 48 && $b <= 57) {
        return $b - 48;
    }

    if ($b >= 97 && $b <= 102) {
        return $b - 87;
    }

    if ($b >= 65 && $b <= 70) {
        return $b - 55;
    }

    return 0;
}
