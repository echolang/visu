/**
 * Screen-quad pass factory. Holds a ShaderRef; does not compile, own a mesh, or hold a GpuPass.
 * `pass()` mints a `QuadPass<T>` and adds it to the graph Pipeline.
 */

namespace visu::graphics;

public class QuadRenderer
{
    private ShaderRef? $shader;

    public constructor()
    {
        $this->shader = null;
    }

    public constructor(ShaderRef $shader)
    {
        $this->shader = $shader;
    }

    public function setShader(ShaderRef $shader) : void
    {
        $this->shader = $shader;
    }

    /**
     * Per-frame graph node: writes `$target`, `beginRender`, draw.
     * Params are copied onto the pass. Adds the pass to `$pipeline`. The pass draws; this type does not.
     */
    public function pass<T>(Pipeline $pipeline, TargetRef $target, T $params) : void
    {
        ShaderRef? $maybe = $this->shader;
        assert($maybe != null, 'quadrenderer: setShader before pass');
        ShaderRef $shader = guard $maybe;
        $pipeline->add(QuadPass($shader, $target, $params));
    }
}
