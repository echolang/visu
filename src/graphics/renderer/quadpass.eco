/**
 * Graph node minted by QuadRenderer.pass, or constructed with a
 * ShaderRef directly. Writes the target, prepares it, then draws
 * the snapshotted payload T through GpuPass. Mesh comes from the
 * pool. Defaults are the fullscreen-quad shader (pos3uv2, no
 * raster, block QuadParams at slot 0).
 */

namespace visu::graphics;

public class QuadPass<T> : Pass
{
    public const TargetRef $target;
    public const VertexLayout $layout;
    public const Raster $raster;
    public const string $block;
    public const uint32 $slot;
    private ShaderRef $shader;
    private T $params;

    public constructor(ShaderRef $shader, TargetRef $target, T $params)
    {
        $this->shader = $shader;
        $this->target = $target;
        $this->params = $params;
        $this->layout = VertexLayout::pos3uv2();
        $this->raster = Raster::none();
        $this->block = 'QuadParams';
        $this->slot = 0;
    }

    public constructor(
        ShaderRef $shader,
        TargetRef $target,
        T $params,
        VertexLayout $layout,
        Raster $raster,
        block: string $block = 'QuadParams',
        slot: uint32 $slot = 0
    )
    {
        $this->shader = $shader;
        $this->target = $target;
        $this->params = $params;
        $this->layout = $layout;
        $this->raster = $raster;
        $this->block = $block;
        $this->slot = $slot;
    }

    public function name() : string
    {
        return 'QuadPass';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        $io->writes($this->target);
    }

    public function execute(Context $ctx) : result<bool, PipelineError>
    {
        RenderTarget $rt = guard $ctx->pool->activate($this->target) else ($e) {
            return .error(.pool($e));
        }

        Gpu $gpu = $ctx->gpu;
        Mesh $mesh = $ctx->pool->cache<Mesh>('quad', function() : Mesh {
            return .quad($gpu);
        });

        GpuPass $pass = GpuPass(
            $this->shader->program(),
            $this->layout,
            $this->raster,
            slot: $this->slot,
            block: $this->block
        );
        $pass->draw($mesh, $this->params);
        return .ok(true);
    }
}
