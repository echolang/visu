/**
 * Graph node minted by `QuadRenderer.pass`, or constructed with a program directly.
 * Writes the target, `beginRender`, then draws the snapshotted payload T through GpuPass.
 * Mesh comes from the pool. Defaults are the fullscreen-quad shader (pos3uv2, no raster, slot 0).
 * A ShaderRef is resolved in the constructor; the shader is already loaded.
 */

namespace visu::graphics;

public class QuadPass<T> : Pass
{
    public const TargetRef $target;
    public const VertexLayout $layout;
    public const Raster $raster;
    public const uint32 $slot;
    private ShaderProgram $program;
    private T $params;

    public constructor(ShaderRef $shader, TargetRef $target, T $params)
    {
        $this->program = $shader->program();
        $this->target = $target;
        $this->params = $params;
        $this->layout = VertexLayout::pos3uv2();
        $this->raster = Raster::none();
        $this->slot = 0;
    }

    public constructor(ShaderProgram $program, TargetRef $target, T $params)
    {
        $this->program = $program;
        $this->target = $target;
        $this->params = $params;
        $this->layout = VertexLayout::pos3uv2();
        $this->raster = Raster::none();
        $this->slot = 0;
    }

    public constructor(
        ShaderRef $shader,
        TargetRef $target,
        T $params,
        VertexLayout $layout,
        Raster $raster,
        slot: uint32 $slot = 0
    )
    {
        $this->program = $shader->program();
        $this->target = $target;
        $this->params = $params;
        $this->layout = $layout;
        $this->raster = $raster;
        $this->slot = $slot;
    }

    public function name() : string
    {
        return 'QuadPass';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        $io->writes($this->target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        RenderEncoder $enc = guard $ctx->beginRender($this->target) else ($e) {
            return .error($e);
        }
        Device $device = $ctx->device;
        Mesh $mesh = $ctx->pool->cache<Mesh>('quad', function() : Mesh {
            return .quad($device);
        });
        GpuPass $pass = GpuPass($this->program, $this->layout, $this->raster, slot: $this->slot);
        $pass->draw($enc, $mesh, $this->params);
        $enc->endRender();
        return .ok;
    }
}
