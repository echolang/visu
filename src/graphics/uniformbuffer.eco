/**
 * Per-frame uniform push into the host-visible ring. Not a
 * GpuObject; slot 1+ is shared data (camera, lights).
 */

namespace visu::graphics;

public class UniformBuffer
{
    public Device $device;
    public const uint32 $slot;
    private uint64 $pushedFrame;
    private TransientSlice $slice;

    public constructor(Device $device, uint32 $slot = 1)
    {
        $this->device = $device;
        $this->slot = $slot;
        $this->pushedFrame = vk::WHOLE_SIZE;
        $this->slice = TransientSlice(null, 0 as uint64, 0 as uint64, 0);
    }

    public function push<T>(const T& $params) : void
    {
        uint64 $n = mem::size<T>() as uint64;
        TransientSlice $slice = $this->device->allocTransient($n, $this->device->limits->uniformAlign);
        T $local = $params;
        ptr<const uint8> $src = ptr<const uint8>(&$local);
        mem::copy<uint8>(ptr<uint8>($slice->data:$), ptr<uint8>($src:$), $n);
        $this->slice = $slice;
        $this->pushedFrame = $this->device->frameIndex();
    }

    public function bind(RenderEncoder $enc) : void
    {
        assert($this->pushedFrame == $this->device->frameIndex(), 'UniformBuffer.bind without push this frame');
        $enc->bindUniform($this->slot, $this->slice);
    }
}
