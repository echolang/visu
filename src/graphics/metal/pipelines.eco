/**
 * Metal render-pipeline cache. Baked at first setGpuPass from GpuPass.key + encoder TargetFormats.
 */

namespace visu::graphics;

internal function metalVertexDescriptor(const VertexLayout& $layout, bool $patches) : mtl::VertexDescriptor
{
    mtl::VertexDescriptor $vd = mtl::VertexDescriptor();
    bool $hasVertex = false;
    bool $hasInstance = false;
    uint32 $vertexStride = 0;
    uint32 $instanceStride = 0;
    uint32 $n = 0;

    foreach ($layout->attrs as $attr) {
        assert($n < 16, 'too many vertex attributes');
        uint32 $bufIndex = VERTEX_BINDING;

        if ($attr->divisor != 0) {
            $bufIndex = INSTANCE_BINDING;
            $hasInstance = true;
            $instanceStride = $attr->stride as uint32;
        } else {
            $hasVertex = true;
            $vertexStride = $attr->stride as uint32;
        }

        $vd->attributes[] = mtl::VertexAttribute(
            $attr->location,
            mtlVertexFormat($attr->components),
            $attr->offset as uint32,
            $bufIndex
        );
        $n = $n + 1;
    }

    if ($hasVertex) {
        mtl::VertexStepFunction $step = mtl::VertexStepFunction::perVertex;
        if ($patches) {
            $step = mtl::VertexStepFunction::perPatchControlPoint;
        }

        $vd->layouts[] = mtl::VertexBufferLayout(VERTEX_BINDING, $vertexStride, $step, 1);
    }

    if ($hasInstance) {
        $vd->layouts[] = mtl::VertexBufferLayout(
            INSTANCE_BINDING,
            $instanceStride,
            mtl::VertexStepFunction::perInstance,
            1
        );
    }

    return $vd;
}

internal function metalPipelineFromPass(
    Device $device,
    const GpuPass& $pass,
    const TargetFormats& $formats,
    mtl::PixelFormat $depthFmt
) : result<PipelineHandle, DeviceError>
{
    mtl::Device $gpu = guard $device->gpu else {
        return .error(.noDevice);
    }
    mtl::Function? $vsFn = $pass->program->vs->fn;
    if ($pass->program->tessellated && $pass->program->tes->alive()) {
        $vsFn = $pass->program->tes->fn;
    }

    mtl::Function $vs = guard $vsFn else {
        return .error(.pipeline($pass->key(), 'missing vertex function'));
    }
    mtl::Function $fs = guard $pass->program->fs->fn else {
        return .error(.pipeline($pass->key(), 'missing fragment function'));
    }
    mtl::VertexDescriptor $vd = metalVertexDescriptor($pass->layout, $pass->program->tessellated);
    mtl::RenderPipelineDescriptor $desc = mtl::RenderPipelineDescriptor($vs, $vertexDescriptor: $vd);
    $desc->fragmentFunction = $fs;
    if ($pass->program->tessellated) {
        uint32 $max = $device->limits->maxTessellationFactor as uint32;
        if ($max < 1) {
            $max = 16;
        }

        $desc->maxTessellationFactor = $max;
        $desc->tessellationPartitionMode = mtl::TessellationPartitionMode::pow2;
        $desc->tessellationFactorStepFunction = mtl::TessellationFactorStepFunction::perPatch;
        $desc->tessellationOutputWindingOrder = mtl::Winding::counterClockwise;
    }
    uint32 $ci = 0;
    uint32 $colorN = $formats->colorCount;

    if ($colorN == 0) {
        $desc->colorPixelFormats[] = mtl::PixelFormat::bgra8Unorm;
    } else {
        while ($ci < $colorN) {
            $desc->colorPixelFormats[] = mtlPixelFormat($formats->colors[$ci]);
            $ci = $ci + 1;
        }
    }

    mtlApplyRaster($desc, $pass->raster);
    $desc->depthPixelFormat = $depthFmt;
    mtl::RenderPipelineState $pso = guard $gpu->newRenderPipelineState($desc) else ($e) {
        string $log = match ($e) {
            mtl::Error::compile($m) => $m,
            mtl::Error::pipeline($m) => $m,
            mtl::Error::other($m) => $m,
        };
        return .error(.pipeline($pass->key(), $log));
    }
    return .ok(PipelineHandle($pso));
}

internal function metalGetPipeline(
    Device $device,
    const GpuPass& $pass,
    const TargetFormats& $formats,
    mtl::PixelFormat $depthFmt
) : PipelineHandle
{
    uint32 $df = $depthFmt->value();
    string $key = "{$pass->key()}|{$formats->fingerprint()}|{$df}";

    if ($device->psos->has($key)) {
        return $device->psos[$key];
    }

    PipelineHandle $made = guard metalPipelineFromPass($device, $pass, $formats, $depthFmt) else ($e) {
        die($e->message());
    }
    $device->psos[$key] = $made;
    return $made;
}

internal function metalDepthKey(const Raster& $raster) : uint32
{
    uint32 $key = compareCode($raster->depthCompare) as uint32;

    if ($raster->depthTest) {
        $key = $key | 16;
    }

    if ($raster->depthWrite) {
        $key = $key | 32;
    }

    return $key;
}

internal function metalDepthState(Device $device, const Raster& $raster) : mtl::DepthStencilState?
{
    mtl::Device $gpu = guard $device->gpu else {
        return null;
    }
    uint32 $key = metalDepthKey($raster);

    if ($device->depthStates->has($key)) {
        return $device->depthStates[$key];
    }

    mtl::DepthStencilDescriptor $ds = mtl::DepthStencilDescriptor();

    if ($raster->depthTest) {
        $ds->depthCompareFunction = mtlCompare($raster->depthCompare);
    } else {
        $ds->depthCompareFunction = .always;
    }

    $ds->depthWriteEnabled = $raster->depthWrite && $raster->depthTest;
    mtl::DepthStencilState $made = guard $gpu->newDepthStencilState($ds) else {
        return null;
    }
    $device->depthStates[$key] = $made;
    return $made;
}
