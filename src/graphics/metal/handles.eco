/**
 * Per-backend GPU object identities. Shared resource classes store these; the Metal arm fills them with mtl classes.
 */

namespace visu::graphics;

public struct Surface
{
    public ptr<uint8> $view;

    public static function none() : Surface
    {
        return Surface(null);
    }
}

public struct BufferHandle
{
    public mtl::Buffer? $buffer;
    public uint64 $bytes;

    public static function none() : BufferHandle
    {
        return BufferHandle(null, 0 as uint64);
    }
}

public struct TextureHandle
{
    public mtl::Texture? $texture;
    public bool $imported;

    public static function none() : TextureHandle
    {
        return TextureHandle(null, false);
    }
}

public struct SamplerHandle
{
    public mtl::SamplerState? $sampler;

    public static function none() : SamplerHandle
    {
        return SamplerHandle(null);
    }
}

public struct ShaderModuleHandle
{
    public mtl::Library? $library;
    public mtl::Function? $fn;

    public static function none() : ShaderModuleHandle
    {
        return ShaderModuleHandle(null, null);
    }

    public const function alive() : bool
    {
        return $this->fn != null;
    }
}

public struct PipelineHandle
{
    public mtl::RenderPipelineState? $pipeline;

    public static function none() : PipelineHandle
    {
        return PipelineHandle(null);
    }
}
