/**
 * GPU constants for this backend. Same names on every arm; the
 * values are bit flags here. App code writes
 * visu::graphics::COLOR_BUFFER_BIT, never mtl::.
 */

namespace visu::graphics;

public const uint32 COLOR_BUFFER_BIT = 1;
public const uint32 DEPTH_BUFFER_BIT = 2;
public const uint32 STENCIL_BUFFER_BIT = 4;
public const uint32 TEXTURE0 = 0;

/**
 * Metal buffer table. Vertex and instance occupy 0 and 1;
 * uniform slot N is [[buffer(2 + N)]]. GLSL UBO binding = N.
 */
internal const uint32 MTL_VERTEX_BUFFER = 0;
internal const uint32 MTL_INSTANCE_BUFFER = 1;
internal const uint32 MTL_UNIFORM_BASE = 2;

internal function mtlUniformIndex(uint32 $slot) : uint32
{
    return MTL_UNIFORM_BASE + $slot;
}
