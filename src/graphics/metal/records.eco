/**
 * Handle-table rows for the Metal Gpu. uint32 names on Texture /
 * GpuBuffer / ShaderStage index these maps.
 */

namespace visu::graphics;

internal class TexRec
{
    public mtl::Texture? $obj;
    public mtl::SamplerState? $sampler;
    public PixelFormat $format;
    public int32 $width;
    public int32 $height;
    public Filter $min;
    public Filter $mag;
    public Wrap $wrapS;
    public Wrap $wrapT;
    public TextureTarget $target;

    public constructor()
    {
        $this->obj = null;
        $this->sampler = null;
        $this->format = .rgba;
        $this->width = 0;
        $this->height = 0;
        $this->min = .linear;
        $this->mag = .linear;
        $this->wrapS = .clampToEdge;
        $this->wrapT = .clampToEdge;
        $this->target = .texture2D;
    }
}

internal class BufRec
{
    public mtl::Buffer? $obj;
    public BufferUse $kind;
    public isize $bytes;

    public constructor()
    {
        $this->obj = null;
        $this->kind = .vertex;
        $this->bytes = 0;
    }
}

internal class FboRec
{
    public uint32 $color;
    public uint32 $depth;
    public PixelFormat $colorFormat;
    public PixelFormat $depthFormat;
    public int32 $width;
    public int32 $height;

    public constructor()
    {
        $this->color = 0;
        $this->depth = 0;
        $this->colorFormat = .rgba;
        $this->depthFormat = .depthComponent;
        $this->width = 0;
        $this->height = 0;
    }
}

internal struct VaoAttr
{
    public uint32 $location = 0;
    public int32 $components = 3;
    public int32 $offset = 0;
    public int32 $stride = 0;
    public uint32 $divisor = 0;
    public uint32 $buffer = 0;
    public bool $enabled = false;
}

internal class VaoRec
{
    public array<VaoAttr> $attrs;

    public constructor()
    {
        $this->attrs = array<VaoAttr>();
    }
}

internal class ShdRec
{
    public ShaderKind $kind;
    public string $source;
    public mtl::Library? $library;
    public mtl::Function? $entry;
    public bool $compiled;
    public string $log;

    public constructor(ShaderKind $kind)
    {
        $this->kind = $kind;
        $this->source = '';
        $this->library = null;
        $this->entry = null;
        $this->compiled = false;
        $this->log = '';
    }
}

internal class PassTarget
{
    public mtl::Texture $color;
    public mtl::Texture? $depth;
    public int32 $width;
    public int32 $height;

    public constructor(mtl::Texture $color, mtl::Texture? $depth, int32 $width, int32 $height)
    {
        $this->color = $color;
        $this->depth = $depth;
        $this->width = $width;
        $this->height = $height;
    }
}

internal class ProgRec
{
    public uint32 $vs;
    public uint32 $fs;
    public mtl::Function? $vsFn;
    public mtl::Function? $fsFn;
    public bool $linked;
    public string $log;

    public constructor()
    {
        $this->vs = 0;
        $this->fs = 0;
        $this->vsFn = null;
        $this->fsFn = null;
        $this->linked = false;
        $this->log = '';
    }
}
