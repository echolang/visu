/**
 * One in-flight slot: previous command buffer for the wait, a host-visible uniform ring reset in beginFrame,
 * and the GPU timestamp samples of the frame it recorded.
 */

namespace visu::graphics;

internal const uint64 RING_BYTES = 16777216;
internal const uint64 RING_SLACK = 65536;

internal function mtlBeginFrame(Device $device, int32 $width, int32 $height) : result<FrameStatus, DeviceError>
{
    assert($device->ready, 'Device.beginFrame before initialize');
    assert(!$device->encoderOpen, 'beginFrame with an open encoder');
    assert(!$device->inFrame, 'beginFrame twice');

    if ($device->lostFlag) {
        return .error(.surfaceLost);
    }

    if ($device->pendingResize || $width != $device->drawableW || $height != $device->drawableH) {
        $device->pendingResize = false;
        $device->drawableW = $width;
        $device->drawableH = $height;
        mtl::Layer $layer = guard $device->layer else {
            return .ok(.skipped);
        }
        mtlResizeLayer($layer, $width, $height);
    }

    if ($width <= 0 || $height <= 0) {
        return .ok(.skipped);
    }

    FrameSlot $slot = $device->slots[$device->slot];
    if ($slot->epoch > 0) {
        bool $ready = $slot->gpuDone->waitUntilSignaledValue(
            $slot->epoch,
            timeoutMS: 1000000000
        );
        if (!$ready) {
            return .error(.metal('beginFrame', 'gpu timeline wait timed out'));
        }

        mtl::Device $gpu = guard $device->gpu else {
            return .error(.noDevice);
        }
        mtlClockSample($gpu, $device->clock);
        mtlTimestampsResolve($slot, $device->clock, $device->gpuProfiler);
    }
    $slot->prev = null;
    $slot->prePrev = null;
    $slot->presentPrev = null;
    $slot->preScope = -1;
    $device->releaseRetired();
    return $device->openScene();
}

internal class HostRing
{
    public mtl::Buffer? $buffer;
    public ptr<uint8> $mapped;
    public uint64 $bytes;
    public uint64 $cursor;

    public constructor()
    {
        $this->buffer = null;
        $this->mapped:$ = null;
        $this->bytes = 0;
        $this->cursor = 0;
    }

    public function reset() : void
    {
        $this->cursor = 0;
    }

    public function destroy() : void
    {
        $this->buffer = null;
        $this->mapped:$ = null;
        $this->bytes = 0;
        $this->cursor = 0;
    }

    public function allocate(mtl::Device $gpu, uint64 $bytes) : status<DeviceError>
    {
        $this->destroy();
        mtl::Buffer $buf = guard $gpu->newBuffer($bytes as usize) else {
            return .error(.outOfMemory($bytes));
        }
        ptr<uint8> $mapped = $buf->contents();

        if ($mapped:$ == null) {
            return .error(.outOfMemory($bytes));
        }

        $this->buffer = $buf;
        $this->mapped:$ = $mapped:$;
        $this->bytes = $bytes;
        $this->cursor = 0;
        return .ok;
    }

    public function take(uint64 $bytes, uint64 $align, uint32 $frameSlot) : TransientSlice
    {
        assert($this->mapped:$ != null, 'ring is not allocated');
        uint64 $off = mtlAlignUp($this->cursor, $align);
        assert($off + $bytes + RING_SLACK <= $this->bytes, 'uniform ring overflow');
        $this->cursor = $off + $bytes;
        ptr<uint8> $p = $this->mapped;
        $p:$ = $this->mapped:$ + ($off as isize);
        return TransientSlice($p, $off, $bytes, $frameSlot);
    }
}

internal class FrameSlot
{
    public mtl::CommandBuffer? $prev;
    // tessellation-factor compute committed before $prev; kernel time is a GPU span
    public mtl::CommandBuffer? $prePrev;
    // blit/overlay command buffer when the scene submitted without the drawable
    public mtl::CommandBuffer? $presentPrev;
    // profile node that first called tessellateWith this frame, or -1
    public int32 $preScope;
    public HostRing $ring;
    public mtl::SharedEvent $gpuDone;
    public uint64 $epoch;
    public GpuTimestamps $stamps;

    public constructor(mtl::SharedEvent $gpuDone)
    {
        $this->prev = null;
        $this->prePrev = null;
        $this->presentPrev = null;
        $this->preScope = -1;
        $this->ring = HostRing();
        $this->gpuDone = $gpuDone;
        $this->epoch = 0;
        $this->stamps = GpuTimestamps();
    }
}

internal function mtlCreateSlots(Device $device) : status<DeviceError>
{
    mtl::Device $gpu = guard $device->gpu else {
        return .error(.noDevice);
    }
    uint32 $i = 0;

    while ($i < FRAMES_IN_FLIGHT) {
        mtl::SharedEvent $done = guard $gpu->newSharedEvent() else {
            return .error(.metal('shared event', 'newSharedEvent failed'));
        }
        FrameSlot $slot = FrameSlot($done);
        guard $slot->ring->allocate($gpu, RING_BYTES) else ($e) {
            return .error($e);
        }

        if ($device->gpuProfiler->supported) {
            mtlTimestampsCreate($gpu, $slot->stamps);
        }

        $device->slots[] = $slot;
        $i = $i + 1;
    }

    return .ok;
}

internal function mtlDestroySlots(Device $device) : void
{
    foreach ($device->slots as $slot) {
        $slot->prev = null;
        $slot->prePrev = null;
        $slot->presentPrev = null;
        $slot->preScope = -1;
        $slot->stamps->buffer = null;
        $slot->ring->destroy();
    }

    $device->slots = array<FrameSlot>();
}

internal function mtlAlignUp(uint64 $v, uint64 $a) : uint64
{
    if ($a <= 1) {
        return $v;
    }

    uint64 $r = $v % $a;

    if ($r == 0) {
        return $v;
    }

    return $v + ($a - $r);
}
