/**
 * visu enums → Metal constants. Call sites write `.rgba8` /
 * `.triangles`; this file is the only place those become `mtl::`.
 */

namespace visu::graphics;

internal function mtlPixelFormat(PixelFormat $format) : mtl::PixelFormat
{
    return match ($format) {
        PixelFormat::rgba8 => mtl::PixelFormat::rgba8Unorm,
        PixelFormat::bgra8 => mtl::PixelFormat::bgra8Unorm,
        PixelFormat::rgba8Srgb => mtl::PixelFormat::rgba8Unorm_srgb,
        PixelFormat::rgba16f => mtl::PixelFormat::rgba16Float,
        PixelFormat::rgba32f => mtl::PixelFormat::rgba32Float,
        PixelFormat::r8 => mtl::PixelFormat::r8Unorm,
        PixelFormat::r16f => mtl::PixelFormat::r16Float,
        PixelFormat::r32f => mtl::PixelFormat::r32Float,
        PixelFormat::rg16f => mtl::PixelFormat::rgba8Unorm,
        PixelFormat::depth32f => mtl::PixelFormat::depth32Float,
        PixelFormat::depth32fStencil8 => mtl::PixelFormat::depth32Float_stencil8,
    };
}

internal function mtlLoadOp(LoadOp $op) : mtl::LoadAction
{
    return match ($op) {
        LoadOp::load => mtl::LoadAction::load,
        LoadOp::clear => mtl::LoadAction::clear,
        LoadOp::dontCare => mtl::LoadAction::dontCare,
    };
}

internal function mtlStoreOp(StoreOp $op) : mtl::StoreAction
{
    return match ($op) {
        StoreOp::store => mtl::StoreAction::store,
        StoreOp::dontCare => mtl::StoreAction::dontCare,
    };
}

internal function mtlTopology(Topology $topology) : mtl::PrimitiveType
{
    return match ($topology) {
        Topology::points => mtl::PrimitiveType::point,
        Topology::lines => mtl::PrimitiveType::line,
        Topology::lineStrip => mtl::PrimitiveType::lineStrip,
        Topology::triangles => mtl::PrimitiveType::triangle,
        Topology::triangleStrip => mtl::PrimitiveType::triangleStrip,
    };
}

internal function mtlCull(CullMode $cull) : mtl::CullMode
{
    return match ($cull) {
        CullMode::none => mtl::CullMode::none,
        CullMode::front => mtl::CullMode::front,
        CullMode::back => mtl::CullMode::back,
    };
}

internal function mtlWinding(FrontFace $front) : mtl::Winding
{
    return match ($front) {
        FrontFace::ccw => mtl::Winding::counterClockwise,
        FrontFace::cw => mtl::Winding::clockwise,
    };
}

internal function mtlCompare(Compare $op) : mtl::CompareFunction
{
    return match ($op) {
        Compare::never => mtl::CompareFunction::never,
        Compare::less => mtl::CompareFunction::less,
        Compare::equal => mtl::CompareFunction::equal,
        Compare::lessEqual => mtl::CompareFunction::lessEqual,
        Compare::greater => mtl::CompareFunction::greater,
        Compare::notEqual => mtl::CompareFunction::notEqual,
        Compare::greaterEqual => mtl::CompareFunction::greaterEqual,
        Compare::always => mtl::CompareFunction::always,
    };
}

internal function mtlVertexFormat(int32 $components) : mtl::VertexFormat
{
    if ($components == 1) {
        return mtl::VertexFormat::float;
    }

    if ($components == 2) {
        return mtl::VertexFormat::float2;
    }

    if ($components == 3) {
        return mtl::VertexFormat::float3;
    }

    return mtl::VertexFormat::float4;
}

internal function mtlMinMag(Filter $filter) : mtl::SamplerMinMagFilter
{
    return match ($filter) {
        Filter::nearest => mtl::SamplerMinMagFilter::nearest,
        Filter::nearestMipmapNearest => mtl::SamplerMinMagFilter::nearest,
        Filter::nearestMipmapLinear => mtl::SamplerMinMagFilter::nearest,
        else => mtl::SamplerMinMagFilter::linear,
    };
}

internal function mtlMip(Filter $filter) : mtl::SamplerMipFilter
{
    return match ($filter) {
        Filter::nearest => mtl::SamplerMipFilter::notMipmapped,
        Filter::linear => mtl::SamplerMipFilter::notMipmapped,
        Filter::nearestMipmapNearest => mtl::SamplerMipFilter::nearest,
        Filter::linearMipmapNearest => mtl::SamplerMipFilter::nearest,
        else => mtl::SamplerMipFilter::linear,
    };
}

internal function mtlAddress(Wrap $wrap) : mtl::SamplerAddressMode
{
    return match ($wrap) {
        Wrap::repeat => mtl::SamplerAddressMode::repeat,
        Wrap::mirroredRepeat => mtl::SamplerAddressMode::mirrorRepeat,
        Wrap::clampToEdge => mtl::SamplerAddressMode::clampToEdge,
        Wrap::clampToBorder => mtl::SamplerAddressMode::clampToZero,
    };
}

internal function mtlIndexType(IndexType $type) : mtl::IndexType
{
    return match ($type) {
        IndexType::uint16 => mtl::IndexType::uint16,
        IndexType::uint32 => mtl::IndexType::uint32,
    };
}

internal function mtlFunctionName(ShaderKind $kind) : string
{
    return match ($kind) {
        ShaderKind::vertex => 'vs',
        ShaderKind::fragment => 'fs',
        else => '',
    };
}

internal function mtlTextureUsage(const TextureDesc& $desc) : uint32
{
    uint32 $usage = 0;

    if (($desc->usage & TEXTURE_SAMPLED) != 0) {
        $usage = $usage | mtl::TEXTURE_USAGE_SHADER_READ;
    }

    if (($desc->usage & TEXTURE_RENDER_TARGET) != 0) {
        $usage = $usage | mtl::TEXTURE_USAGE_RENDER_TARGET;
    }

    if (($desc->usage & TEXTURE_TRANSFER_SRC) != 0 && ($usage & mtl::TEXTURE_USAGE_SHADER_READ) == 0) {
        $usage = $usage | mtl::TEXTURE_USAGE_SHADER_READ;
    }

    if ($usage == 0) {
        $usage = mtl::TEXTURE_USAGE_SHADER_READ;
    }

    return $usage;
}
