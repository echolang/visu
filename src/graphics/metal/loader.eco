/**
 * Loader proc for visu::os::init. Metal does not load Vulkan.
 * `visu_set_display_sync` lives in vsync.m.
 */

namespace visu::graphics;

internal extern {
    function visu_set_display_sync(ptr<uint8> $nsWindow, int32 $enabled) : void;
}

internal function vulkanLoaderProc() : ptr<uint8>
{
    return null;
}

internal function needsVulkanLoader() : bool
{
    return false;
}
