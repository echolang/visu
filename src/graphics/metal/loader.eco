/**
 * Loader proc for visu::os::init. Metal does not load Vulkan.
 * Display sync lives in src/os/display.m.
 */

namespace visu::graphics;

internal extern {
    function visu_mtl_current_allocated() : uint64;
    function visu_mtl_working_set() : uint64;
    function visu_mtl_has_unified() : int32;
}

internal function vulkanLoaderProc() : ptr<uint8>
{
    return null;
}

internal function needsVulkanLoader() : bool
{
    return false;
}
