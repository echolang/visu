/**
 * Metal Device. The app constructs one; GPU objects store the handle.
 * Construct-then-initialize; headless construct is legal.
 */

namespace visu::graphics;

use visu::app::{announceVersion, info};

public class Device : DeviceProtocol
{
    internal mtl::Device? $gpu;
    internal mtl::CommandQueue? $queue;
    internal mtl::Layer? $layer;
    internal mtl::Drawable? $drawable;
    internal mtl::CommandBuffer? $cmd;
    internal mtl::CommandBuffer? $preCmd;
    internal mtl::ComputeCommandEncoder? $preEnc;
    // profile node of the first tessellateWith this frame, or -1
    internal int32 $preScope;
    internal map<uint32, mtl::ComputePipelineState> $computePsos;
    internal array<FrameSlot> $slots;
    internal uint32 $slot;
    internal uint64 $frames;
    internal bool $ready;
    internal bool $lostFlag;
    internal bool $pendingResize;
    internal int32 $pendingW;
    internal int32 $pendingH;
    internal int32 $drawableW;
    internal int32 $drawableH;
    internal bool $vsync;
    internal int32 $presentHz;
    internal float64 $contentsScale;
    internal bool $encoderOpen;
    internal mtl::RenderCommandEncoder? $activeEnc;
    internal bool $inFrame;
    internal bool $sceneCommitted;
    internal DeviceLimits $limits;
    internal AdapterInfo $adapter;
    internal Texture? $bb;
    internal map<string, PipelineHandle> $psos;

    /**
     * The bind path's view of `psos`, cleared whenever a pipeline is dropped.
     */
    internal PipelineCache<PipelineHandle> $psoCache;
    internal map<string, Sampler> $samplers;
    internal int32 $anisoWanted;
    internal int32 $anisoLevel;
    internal map<uint32, mtl::DepthStencilState> $depthStates;
    internal PixelFormat $bbFormat;
    public DrawCounters $draws;
    public GpuProfiler $gpuProfiler;
    internal GpuClock $clock;
    internal TextureGrave $grave;
    internal GpuCounts $counts;
    internal DeferredCache $deferred;
    internal GpuShaders $gpuShaders;
    internal BakedShaderCache $sceneShaders;

    public constructor()
    {
        $this->gpu = null;
        $this->queue = null;
        $this->layer = null;
        $this->drawable = null;
        $this->cmd = null;
        $this->preCmd = null;
        $this->preEnc = null;
        $this->preScope = -1;
        $this->computePsos = map<uint32, mtl::ComputePipelineState>();
        $this->slots = array<FrameSlot>();
        $this->slot = 0;
        $this->frames = 0;
        $this->ready = false;
        $this->lostFlag = false;
        $this->pendingResize = false;
        $this->pendingW = 0;
        $this->pendingH = 0;
        $this->drawableW = 0;
        $this->drawableH = 0;
        $this->vsync = true;
        $this->presentHz = 0;
        $this->contentsScale = 1.0;
        $this->encoderOpen = false;
        $this->activeEnc = null;
        $this->inFrame = false;
        $this->sceneCommitted = false;
        $this->limits = DeviceLimits();
        $this->limits->uniformAlign = 16;
        $this->limits->storageAlign = 16;
        $this->limits->vertexTextures = true;
        AdapterInfo $info = AdapterInfo();
        $info->api = 'Metal';
        $this->adapter = $info;
        $this->bb = null;
        $this->psos = map<string, PipelineHandle>();
        $this->psoCache = PipelineCache<PipelineHandle>();
        $this->samplers = map<string, Sampler>();
        $this->anisoWanted = 1;
        $this->anisoLevel = 1;
        $this->depthStates = map<uint32, mtl::DepthStencilState>();
        $this->bbFormat = .bgra8;
        $this->draws = DrawCounters();
        $this->gpuProfiler = GpuProfiler();
        $this->clock = GpuClock();
        $this->grave = TextureGrave();
        $this->counts = GpuCounts();
        $this->deferred = DeferredCache();
        $this->gpuShaders = GpuShaders();
        $this->sceneShaders = BakedShaderCache();
    }

    destructor()
    {
        $this->shutdown();
    }

    public function initialize(const DeviceOptions& $options) : status<DeviceError>
    {
        if ($this->ready) {
            return .ok;
        }

        $this->vsync = $options->vsync;

        if (!mtl::available()) {
            return .error(.noDevice);
        }

        mtl::Device $gpu = guard mtl::Device::systemDefault() else {
            return .error(.noDevice);
        }
        mtl::CommandQueue $queue = guard $gpu->newCommandQueue() else {
            return .error(.noDevice);
        }
        $this->gpu = $gpu;
        $this->queue = $queue;
        $this->gpuProfiler->supported = mtlTimestampsSupported($gpu);

        if ($this->gpuProfiler->supported) {
            $this->gpuProfiler->mode = .lightweight;
        }
        mtlClockSample($gpu, $this->clock);
        guard mtlCreateSlots($this) else ($e) {
            $this->shutdown();
            return .error($e);
        }

        AdapterInfo $info = AdapterInfo();
        $info->api = 'Metal';
        $info->name = $gpu->name();
        $info->vendor = 'Apple';
        $this->adapter = $info;
        $this->limits->maxTessellationFactor = $gpu->maxTessellationFactor() as int32;
        $this->limits->tessFactorAlign = TESS_FACTOR_ALIGN;
        $this->limits->vertexTextures = true;
        $this->limits->maxAnisotropy = 16;
        $this->limits->bindless = $gpu->supportsMetal3();
        $this->ready = true;
        announceVersion();
        string $line = $info->line();
        info("graphics: {$line}");

        if ($this->gpuProfiler->supported) {
            $this->gpuProfiler->mode = .lightweight;
            info('gpu timestamps: on (stage boundary)');
        }

        return .ok;
    }

    public function attachSurface(Surface $surface, int32 $width, int32 $height) : status<DeviceError>
    {
        assert($this->ready, 'Device.attachSurface before initialize');
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }
        mtl::Layer $layer = guard mtlAttachLayer($gpu, $surface->view, $width, $height, $this->contentsScale) else ($e) {
            return .error($e);
        }
        $this->layer = $layer;
        $this->drawableW = $width;
        $this->drawableH = $height;
        $this->applyVsync();
        return .ok;
    }

    public function resizeSurface(int32 $width, int32 $height) : void
    {
        $this->pendingResize = true;
        $this->pendingW = $width;
        $this->pendingH = $height;
    }

    public function loseSurface() : void
    {
        $this->lostFlag = true;
        $this->abortFrame();
        $this->waitSlots();
        $this->bb = null;
        $this->drawable = null;
        $this->layer = null;
    }

    public const function surfaceLost() : bool
    {
        return $this->lostFlag;
    }

    public function waitIdle() : void
    {
        $this->abortFrame();
        $this->waitSlots();
        mtlWaitGpuDone($this);
    }

    public const function limits() : DeviceLimits
    {
        return $this->limits;
    }

    public const function adapterInfo() : AdapterInfo
    {
        return $this->adapter;
    }

    public const function memoryStats() : MemoryStats
    {
        return mtlMemoryStats($this);
    }

    public const function resourceStats() : ResourceStats
    {
        return mtlResourceStats($this);
    }

    public const function pipelineCount() : int32
    {
        return mtlPipelineCount($this);
    }

    public function retireTexture(TextureHandle $handle) : void
    {
        mtlRetireTexture($this, $handle);
    }

    public function releaseRetired() : void
    {
        mtlReleaseRetired($this);
    }

    public function forgetProgram(uint32 $id) : void
    {
        mtlForgetProgram($this, $id);
    }

    public function beginFrame(int32 $width, int32 $height) : result<FrameStatus, DeviceError>
    {
        $this->applyAnisotropy();
        return mtlBeginFrame($this, $width, $height);
    }

    public function endFrame() : status<DeviceError>
    {
        assert($this->inFrame, 'endFrame outside beginFrame');
        assert(!$this->encoderOpen, 'endFrame with an open encoder');
        if (!$this->sceneCommitted) {
            mtlCommitPreRender($this, false);
        }

        $this->bb = null;
        FrameSlot $slot = $this->slots[$this->slot];
        mtl::CommandBuffer $cmd = guard $this->cmd else {
            $this->inFrame = false;
            $this->sceneCommitted = false;
            $this->draws->roll();
            return .ok;
        }
        $slot->epoch = $slot->epoch + 1;
        $cmd->encodeSignalEvent($slot->gpuDone, $slot->epoch);
        mtl::Drawable $held = guard $this->drawable else {
            $cmd->commit();
            if ($this->sceneCommitted) {
                $slot->presentPrev = $cmd;
            } else {
                $slot->prev = $cmd;
            }

            $this->cmd = null;
            $this->drawable = null;
            $this->inFrame = false;
            $this->sceneCommitted = false;
            $this->frames = $this->frames + 1;
            $this->slot = ($this->slot + 1) % FRAMES_IN_FLIGHT;
            $this->draws->roll();
            return .ok;
        }
        $cmd->present($held);
        $cmd->commit();

        if ($this->sceneCommitted) {
            $slot->presentPrev = $cmd;
        } else {
            $slot->prev = $cmd;
        }

        $this->cmd = null;
        $this->drawable = null;
        $this->inFrame = false;
        $this->sceneCommitted = false;
        $this->frames = $this->frames + 1;
        $this->slot = ($this->slot + 1) % FRAMES_IN_FLIGHT;
        $this->draws->roll();
        return .ok;
    }

    public const function inFrame() : bool
    {
        return $this->inFrame;
    }

    public const function frameSlot() : uint32
    {
        return $this->slot;
    }

    public const function frameIndex() : uint64
    {
        return $this->frames;
    }

    public function backbuffer() : Texture
    {
        Texture $have = guard $this->bb else {
            return $this->acquireBackbuffer();
        }
        return $have;
    }

    public const function backbufferFormat() : PixelFormat
    {
        return $this->bbFormat;
    }

    public function setVsync(bool $on) : void
    {
        if ($this->vsync == $on) {
            return;
        }

        $this->vsync = $on;
        $this->applyVsync();
    }

    /**
     * Metadata only.
     * CAMetalLayer paces itself off the panel once displaySyncEnabled is on, so there is no rate to request.
     */
    public function setPresentRate(int32 $hz) : void
    {
        $this->presentHz = $hz;
    }

    public const function presentRate() : int32
    {
        return $this->presentHz;
    }

    /**
     * Backing scale of the surface, as framebuffer pixels per point.
     * See mtlLayerScale. The layer is view-hosted, so nobody else keeps this in step with drawableSize.
     */
    public function setContentsScale(float64 $scale) : void
    {
        if ($scale <= 0.0 || $this->contentsScale == $scale) {
            return;
        }

        $this->contentsScale = $scale;
        mtl::Layer $layer = guard $this->layer else {
            return;
        }
        mtlLayerScale($layer, $scale);
    }

    public const function contentsScale() : float64
    {
        return $this->contentsScale;
    }

    public function beginRender(const RenderPassDesc& $desc) : RenderEncoder
    {
        assert($this->inFrame, 'beginRender outside beginFrame');
        assert(!$this->encoderOpen, 'beginRender while an encoder is open');
        mtl::CommandBuffer $cmd = guard $this->cmd else {
            die('beginRender without a command buffer');
        }
        uint32 $n = $desc->colors->count() as uint32;
        assert($n <= MAX_COLOR_TARGETS, 'beginRender color targets');
        assert($n > 0 || $desc->depth != null, 'beginRender needs a color or a depth target');
        mtl::RenderPassDescriptor $pass = mtl::RenderPassDescriptor();
        TargetFormats $formats = TargetFormats();
        uint32 $i = 0;

        while ($i < $n) {
            ColorTarget $color = $desc->colors[$i as usize];
            $color->validate();
            $color->texture->state = .colorTarget;
            mtl::Texture $tex = guard $color->texture->handle->texture else {
                die('beginRender color texture handle is empty');
            }
            mtl::ClearColor $clear = mtl::ClearColor(
                $color->clear->x as float64,
                $color->clear->y as float64,
                $color->clear->z as float64,
                $color->clear->w as float64
            );
            mtl::ColorAttachment $attachment = mtl::ColorAttachment(
                $tex,
                mtlLoadOp($color->load),
                mtlStoreOp($color->store),
                $clear
            );
            $attachment->level = $color->mip as uint32;
            $attachment->slice = $color->face as uint32;
            $pass->colorAttachments[] = $attachment;
            $formats->colors[$i] = $color->texture->desc->format;
            $i = $i + 1;
        }

        $formats->colorCount = $n;
        $formats->samples = .one;
        int32 $passWidth = 1;
        int32 $passHeight = 1;
        if ($n > 0) {
            ColorTarget $first = $desc->colors[0];
            $passWidth = $first->width();
            $passHeight = $first->height();
        }

        mtl::PixelFormat $depthFmt = mtl::PixelFormat::invalid;
        DepthTarget $depth = guard $desc->depth else {
            return $this->openEncoder($cmd, $pass, $formats, $depthFmt, $passWidth, $passHeight);
        }
        $depth->validate();
        $depth->texture->state = .depthTarget;
        mtl::Texture $depthTex = guard $depth->texture->handle->texture else {
            die('beginRender depth texture handle is empty');
        }
        $pass->depthTexture = $depthTex;
        $pass->depthLoadAction = mtlLoadOp($depth->load);
        $pass->depthStoreAction = mtlStoreOp($depth->store);
        $pass->depthClear = $depth->clearDepth;
        $pass->depthLevel = $depth->mip as uint32;
        $pass->depthSlice = $depth->face as uint32;
        $formats->depth = $depth->texture->desc->format;
        $formats->hasDepth = true;
        $depthFmt = mtlPixelFormat($depth->texture->desc->format);
        if ($n == 0) {
            $passWidth = $depth->width();
            $passHeight = $depth->height();
        }

        return $this->openEncoder($cmd, $pass, $formats, $depthFmt, $passWidth, $passHeight);
    }

    public function beginCompute() : ComputeEncoder
    {
        assert($this->inFrame, 'beginCompute outside beginFrame');
        assert(!$this->encoderOpen, 'beginCompute while an encoder is open');
        mtl::CommandBuffer $cmd = guard $this->cmd else {
            die('beginCompute without a command buffer');
        }
        GpuTimestamps $stamps = $this->slots[$this->slot]->stamps;
        mtl::ComputePassDescriptor $pass = mtl::ComputePassDescriptor();
        mtlTimestampsAttachCompute($stamps, $pass);
        mtl::ComputeCommandEncoder $enc = guard $cmd->computeCommandEncoder($pass) else {
            die('metal: computeCommandEncoder failed');
        }
        bool $labelled = $stamps->gpuOpen && !$stamps->name->empty();
        if ($labelled) {
            $enc->setLabel($stamps->name);
            $enc->pushDebugGroup($stamps->name);
        }

        $this->encoderOpen = true;
        return ComputeEncoder($this, $enc, $labelled);
    }

    public function transitionTexture(Texture $texture, ResourceState $to) : void
    {
        assert(!$this->encoderOpen, 'transitionTexture inside a render pass');
        $texture->state = $to;
    }

    public function allocTransient(uint64 $bytes, uint64 $align) : TransientSlice
    {
        assert($this->inFrame, 'allocTransient outside beginFrame');
        uint64 $a = $align;

        if ($a < $this->limits->uniformAlign) {
            $a = $this->limits->uniformAlign;
        }

        if ($a == 0) {
            $a = 16;
        }

        return $this->slots[$this->slot]->ring->take($bytes, $a, $this->slot);
    }

    public function readbackTexture(Texture $texture, int32 $mip, int32 $layer) : result<array<uint8>, DeviceError>
    {
        assert($this->gpu != null, 'readbackTexture before initialize');
        assert(!$this->encoderOpen, 'readbackTexture with an open encoder');
        assert(!$this->inFrame, 'readbackTexture inside a frame');

        if ($texture->imported || ($texture->desc->usage & TEXTURE_TRANSFER_SRC) == 0) {
            return .error(.missingUsage);
        }

        if ($texture->desc->format->isDepth() || $texture->desc->format->isCompressed()) {
            return .error(.unsupportedFormat($texture->desc->format));
        }

        mtl::Texture $mt = guard $texture->handle->texture else {
            return .error(.metal('readback', 'texture handle is empty'));
        }
        $this->waitIdle();
        int32 $w = mipSize($texture->desc->width, $mip);
        int32 $h = mipSize($texture->desc->height, $mip);
        uint64 $row = mipRowBytes($texture->desc->format, $w);
        uint64 $total = mipByteCount($texture->desc->format, $w, $h);
        array<uint8> $pixels = pixelsFilled($total);

        if ($total == 0) {
            return .ok($pixels);
        }

        mtl::Texture $source = $mt;
        uint32 $level = $mip as uint32;
        uint32 $slice = $layer as uint32;
        if (mtlPrivate($texture->desc)) {
            // the CPU cannot see a private texture: blit the one level into a shared copy first
            mtl::Texture $staged = guard $this->staging($texture->desc->format, $w, $h) else ($e) {
                return .error($e);
            }
            guard $this->blitOnce($mt, $staged, $w, $h, $level, $slice, 0, 0, 0, 0, 0) else ($e) {
                return .error($e);
            }
            $source = $staged;
            $level = 0;
            $slice = 0;
        }

        mtl::Region $region = mtl::Region(mtl::Origin(), mtl::Size($w as usize, $h as usize));
        $source->getBytes(
            ptr<uint8>(&$pixels[0]),
            $row as usize,
            $region,
            $level,
            slice: $slice,
            bytesPerImage: ($row as usize) * ($h as usize)
        );
        return .ok($pixels);
    }

    /**
     * A one-level shared texture the CPU can read and write, the go-between for a private one.
     * Readback and load-time uploads only, never the displayed frame.
     */
    private function staging(PixelFormat $format, int32 $w, int32 $h) : result<mtl::Texture, DeviceError>
    {
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }
        mtl::TextureDescriptor $td = mtl::TextureDescriptor(
            $pixelFormat: mtlPixelFormat($format),
            $width: $w as usize
        );
        $td->height = $h as usize;
        $td->mipmapLevelCount = 1;
        $td->usage = mtl::TEXTURE_USAGE_SHADER_READ;
        $td->storageMode = .shared;
        mtl::Texture $tex = guard $gpu->newTexture($td) else {
            return .error(.outOfMemory(($w * $h) as uint64));
        }
        return .ok($tex);
    }

    /**
     * Copy a `$w` x `$h` region between two textures on a command buffer of its own and wait
     * for it. Outside a frame only: the GPU must be idle, as readback and load-time uploads have it.
     */
    private function blitOnce(
        mtl::Texture $src,
        mtl::Texture $dst,
        int32 $w,
        int32 $h,
        uint32 $srcLevel,
        uint32 $srcSlice,
        uint32 $dstLevel,
        uint32 $dstSlice,
        int32 $dstX,
        int32 $dstY,
        int32 $srcX
    ) : status<DeviceError>
    {
        mtl::CommandQueue $queue = guard $this->queue else {
            return .error(.metal('blit', 'no command queue'));
        }
        mtl::CommandBuffer $cmd = guard $queue->commandBuffer() else {
            return .error(.metal('blit', 'commandBuffer failed'));
        }
        mtl::BlitCommandEncoder $blit = guard $cmd->blitCommandEncoder() else {
            return .error(.metal('blit', 'blitCommandEncoder failed'));
        }
        $blit->copyFromTexture(
            $src,
            mtl::Origin($srcX as usize, 0),
            mtl::Size($w as usize, $h as usize),
            $dst,
            mtl::Origin($dstX as usize, $dstY as usize),
            sourceSlice: $srcSlice,
            sourceLevel: $srcLevel,
            destinationSlice: $dstSlice,
            destinationLevel: $dstLevel
        );
        $blit->endEncoding();
        $cmd->commit();
        $cmd->waitUntilCompleted();
        return .ok;
    }

    public function copyTexture(Texture $src, Texture $dst) : status<DeviceError>
    {
        assert($this->gpu != null, 'copyTexture before initialize');
        assert(!$this->encoderOpen, 'copyTexture with an open encoder');
        assert(!$this->inFrame, 'copyTexture inside a frame');
        guard textureCopyOk($src, $dst) else ($e) {
            return .error($e);
        }

        mtl::CommandQueue $queue = guard $this->queue else {
            return .error(.metal('copy', 'no command queue'));
        }
        mtl::Texture $srcTex = guard $src->handle->texture else {
            return .error(.metal('copy', 'src handle is empty'));
        }
        mtl::Texture $dstTex = guard $dst->handle->texture else {
            return .error(.metal('copy', 'dst handle is empty'));
        }
        $this->waitIdle();
        mtl::CommandBuffer $cmd = guard $queue->commandBuffer() else {
            return .error(.metal('copy', 'commandBuffer failed'));
        }
        mtl::BlitCommandEncoder $blit = guard $cmd->blitCommandEncoder() else {
            return .error(.metal('copy', 'blitCommandEncoder failed'));
        }
        $blit->copyFromTexture(
            $srcTex,
            mtl::Origin(),
            mtl::Size($src->desc->width as usize, $src->desc->height as usize),
            $dstTex,
            mtl::Origin()
        );
        $blit->endEncoding();
        $cmd->commit();
        $cmd->waitUntilCompleted();
        $dst->state = .shaderRead;
        return .ok;
    }

    public function createBuffer(const BufferDesc& $desc) : result<BufferHandle, DeviceError>
    {
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }
        uint64 $n = $desc->bytes;

        if ($n == 0) {
            $n = 16;
        }

        mtl::Buffer $buf = guard $gpu->newBuffer($n as usize, .shared) else {
            return .error(.outOfMemory($n));
        }
        return .ok(BufferHandle($buf, $n));
    }

    public function destroyBuffer(BufferHandle $handle) : void
    {
        // rc drop
    }

    public function createTextureTable(int32 $capacity) : result<TextureTableHandle, DeviceError>
    {
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }
        // the layout is the shaders': every declared texture id, then the sampler ids
        uint64 $bytes = metalTableTexture(TEXTURE_TABLE_CAPACITY);
        mtl::Buffer $buf = guard $gpu->newBuffer($bytes as usize, .shared) else {
            return .error(.outOfMemory($bytes));
        }
        mem::zero<uint8>($buf->contents(), $bytes as usize);
        return .ok(TextureTableHandle(MetalTextureTable($buf, $capacity)));
    }

    public function writeTextureTable(TextureTableHandle $handle, int32 $slot, Texture $texture) : void
    {
        MetalTextureTable $table = guard $handle->table else {
            die('metal: texture table handle is empty');
        }
        mtl::Texture $tex = guard $texture->handle->texture else {
            die('metal: texture table entry has no texture');
        }
        $table->write($slot, $tex);
    }

    public function eraseTextureTable(TextureTableHandle $handle, int32 $slot) : void
    {
        MetalTextureTable $table = guard $handle->table else {
            return;
        }
        $table->erase($slot);
    }

    public function writeTextureTableSampler(TextureTableHandle $handle, int32 $index, Sampler $sampler) : void
    {
        MetalTextureTable $table = guard $handle->table else {
            die('metal: texture table handle is empty');
        }
        mtl::SamplerState $state = guard $sampler->handle->sampler else {
            die('metal: texture table sampler has no state');
        }
        $table->writeSampler($index, $state);
    }

    public function destroyTextureTable(TextureTableHandle $handle) : void
    {
        // rc drop: a command buffer in flight retains the buffer it bound
    }

    public function uploadBuffer(BufferHandle $handle, uint64 $offset, ptr<const uint8> $src, uint64 $bytes) : void
    {
        assert($this->gpu != null, 'uploadBuffer before initialize');
        assert($bytes > 0, 'uploadBuffer size');
        mtl::Buffer $buf = guard $handle->buffer else {
            die('uploadBuffer handle is empty');
        }
        ptr<uint8> $base = $buf->contents();
        assert($base:$ != null, 'buffer is not host visible');
        ptr<uint8> $dst = $base;
        $dst:$ = $base:$ + ($offset as isize);
        mem::copy<uint8>($dst, ptr<uint8>($src:$), $bytes);
    }

    public function readMapped(Buffer $buffer, ptr<uint8> $dst, uint64 $bytes) : void
    {
        mtl::Buffer $buf = guard $buffer->handle->buffer else {
            die('metal: readMapped handle is empty');
        }
        mem::copy<uint8>($dst, $buf->contents(), $bytes);
    }

    public function readbackBuffer(Buffer $buffer, uint64 $offset, uint64 $bytes) : result<array<uint8>, DeviceError>
    {
        assert($this->gpu != null, 'readbackBuffer before initialize');
        assert(!$this->encoderOpen, 'readbackBuffer with an open encoder');
        assert(!$this->inFrame, 'readbackBuffer inside a frame');
        mtl::Buffer $buf = guard $buffer->handle->buffer else {
            return .error(.metal('readback', 'buffer handle is empty'));
        }
        $this->waitIdle();
        array<uint8> $out = pixelsFilled($bytes);
        if ($bytes == 0) {
            return .ok($out);
        }

        ptr<uint8> $base = $buf->contents();
        ptr<uint8> $src = $base;
        $src:$ = $base:$ + ($offset as isize);
        mem::copy<uint8>(ptr<uint8>(&$out[0]), $src, $bytes);
        return .ok($out);
    }

    public function fillBuffer(Buffer $buffer, uint64 $offset, uint64 $bytes, uint32 $value) : void
    {
        assert(!$this->encoderOpen, 'fillBuffer with an open encoder');
        assert(($offset % 4) == 0 && ($bytes % 4) == 0, 'fillBuffer: offset and size are multiples of 4');
        uint8 $byte = ($value & 0xFF) as uint8;
        assert($value == (($byte as uint32) * 0x01010101), 'metal: fillBuffer takes a repeated byte');
        if ($bytes == 0) {
            return;
        }

        mtl::Buffer $buf = guard $buffer->handle->buffer else {
            die('metal: fillBuffer handle is empty');
        }
        mtl::BlitCommandEncoder $blit = $this->openBlit();
        $blit->fillBuffer($buf, $offset as usize, $bytes as usize, $byte);
        $blit->endEncoding();
    }

    public function copyBuffer(Buffer $src, uint64 $srcOffset, Buffer $dst, uint64 $dstOffset, uint64 $bytes) : void
    {
        assert(!$this->encoderOpen, 'copyBuffer with an open encoder');
        if ($bytes == 0) {
            return;
        }

        mtl::Buffer $from = guard $src->handle->buffer else {
            die('metal: copyBuffer source handle is empty');
        }
        mtl::Buffer $to = guard $dst->handle->buffer else {
            die('metal: copyBuffer target handle is empty');
        }
        mtl::BlitCommandEncoder $blit = $this->openBlit();
        $blit->copyFromBuffer($from, $srcOffset as usize, $to, $dstOffset as usize, $bytes as usize);
        $blit->endEncoding();
    }

    /**
     * A blit encoder on the scene command buffer, in order with the frame's other encoders.
     */
    private function openBlit() : mtl::BlitCommandEncoder
    {
        assert($this->inFrame, 'blit outside beginFrame');
        mtl::CommandBuffer $cmd = guard $this->cmd else {
            die('metal: blit without a command buffer');
        }
        mtl::BlitCommandEncoder $blit = guard $cmd->blitCommandEncoder() else {
            die('metal: blitCommandEncoder failed');
        }
        return $blit;
    }

    public function createTexture(const TextureDesc& $desc) : result<TextureHandle, DeviceError>
    {
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }
        mtl::TextureDescriptor $td = mtl::TextureDescriptor(
            $pixelFormat: mtlPixelFormat($desc->format),
            $width: $desc->width as usize
        );
        $td->height = $desc->height as usize;
        $td->mipmapLevelCount = $desc->mips as usize;
        $td->usage = mtlTextureUsage($desc);

        if (mtlPrivate($desc)) {
            $td->storageMode = .devicePrivate;
        } else {
            $td->storageMode = .shared;
        }

        if ($desc->kind == TextureKind::cube) {
            $td->textureType = .typeCube;
        }

        if ($desc->kind == TextureKind::array2D) {
            assert($desc->arrayLength >= 1, 'array2D arrayLength');
            $td->textureType = .type2DArray;
            $td->arrayLength = $desc->arrayLength as usize;
        }

        if ($desc->samples == SampleCount::four) {
            $td->sampleCount = 4;
            $td->textureType = .type2DMultisample;
        }

        mtl::Texture $tex = guard $gpu->newTexture($td) else {
            return .error(.outOfMemory(($desc->width * $desc->height) as uint64));
        }
        return .ok(TextureHandle($tex, false));
    }

    public function destroyTexture(TextureHandle $handle) : void
    {
        // rc drop; imported drawable textures are owned by the layer
    }

    public function uploadTexture(
        Texture $texture,
        int32 $x,
        int32 $y,
        int32 $width,
        int32 $height,
        int32 $mip,
        int32 $layer,
        ptr<const uint8> $src,
        uint64 $bytes,
        int32 $bytesPerRow
    ) : void
    {
        assert($this->gpu != null, 'uploadTexture before initialize');
        assert(!$this->encoderOpen, 'uploadTexture with an open encoder');
        mtl::Texture $mt = guard $texture->handle->texture else {
            die('uploadTexture handle is empty');
        }
        uint64 $row = $bytesPerRow as uint64;

        if ($row == 0) {
            $row = mipRowBytes($texture->desc->format, $width);
        }

        if (mtlPrivate($texture->desc)) {
            // a render target: stage the rows in a shared texture and blit them across
            assert(!$this->inFrame, 'uploadTexture into a render target inside a frame');
            $this->waitIdle();
            mtl::Texture $staged = guard $this->staging($texture->desc->format, $width, $height) else {
                die('uploadTexture staging failed');
            }
            $staged->replace(
                mtl::Region(mtl::Origin(), mtl::Size($width as usize, $height as usize)),
                ptr<uint8>($src:$),
                $row as usize,
                0,
                slice: 0,
                bytesPerImage: 0
            );
            guard $this->blitOnce($staged, $mt, $width, $height, 0, 0, $mip as uint32, $layer as uint32, $x, $y, 0) else {
                die('uploadTexture blit failed');
            }
            $texture->state = .shaderRead;
            return;
        }

        // sampled textures are .shared, so this is a memcpy into the texture's own backing.
        // frames N-1/N-2 may still be sampling; a brush texel can tear for a frame.
        mtl::Region $region = mtl::Region(
            mtl::Origin($x as usize, $y as usize),
            mtl::Size($width as usize, $height as usize)
        );
        ptr<uint8> $p = ptr<uint8>($src:$);
        $mt->replace(
            $region,
            $p,
            $row as usize,
            $mip as uint32,
            slice: $layer as uint32,
            bytesPerImage: 0
        );
        $texture->state = .shaderRead;
    }

    public function generateMipmaps(Texture $texture) : void
    {
        assert($this->gpu != null, 'generateMipmaps before initialize');
        assert(!$this->encoderOpen, 'generateMipmaps with an open encoder');
        if ($texture->desc->mips <= 1) {
            $texture->state = .shaderRead;
            return;
        }
        mtl::Texture $mt = guard $texture->handle->texture else {
            die('generateMipmaps handle is empty');
        }

        // inside a frame the source mip was written by the frame's own command buffer, so the blit has to ride along with it
        if ($this->inFrame) {
            mtl::CommandBuffer $cmd = guard $this->cmd else {
                die('generateMipmaps without a command buffer');
            }
            mtl::BlitPassDescriptor $blitPass = mtl::BlitPassDescriptor();
            mtlTimestampsAttachBlit($this->slots[$this->slot]->stamps, $blitPass);
            mtl::BlitCommandEncoder $blit = guard $cmd->blitCommandEncoder($blitPass) else {
                die('metal: blitCommandEncoder failed');
            }
            $blit->generateMipmaps($mt);
            $blit->endEncoding();
            $texture->state = .shaderRead;
            return;
        }

        mtl::CommandQueue $queue = guard $this->queue else {
            die('generateMipmaps before initialize');
        }
        $this->waitIdle();
        mtl::CommandBuffer $once = guard $queue->commandBuffer() else {
            die('metal: commandBuffer failed');
        }
        mtl::BlitCommandEncoder $blit = guard $once->blitCommandEncoder() else {
            die('metal: blitCommandEncoder failed');
        }
        $blit->generateMipmaps($mt);
        $blit->endEncoding();
        $once->commit();
        $once->waitUntilCompleted();
        $texture->state = .shaderRead;
    }

    public function createSampler(const SamplerDesc& $desc) : Sampler
    {
        string $key = $desc->key();

        if ($this->samplers->has($key)) {
            return $this->samplers[$key];
        }

        Sampler $fresh = Sampler($this->samplerHandle($desc), $desc);
        $this->samplers[$key] = $fresh;
        $this->counts->noteSamplerCreated();
        return $fresh;
    }

    public function setAnisotropy(int32 $level) : void
    {
        $this->anisoWanted = $level;
    }

    public const function anisotropy() : int32
    {
        return $this->anisoLevel;
    }

    /**
     * Rebuild every anisotropic sampler at the wanted level, in place. Runs before the frame
     * records anything; a command buffer in flight retains the state it was encoded with.
     */
    private function applyAnisotropy() : void
    {
        int32 $level = anisotropyLevel($this->anisoWanted, $this->limits->maxAnisotropy);

        if ($level == $this->anisoLevel) {
            return;
        }

        $this->anisoLevel = $level;

        foreach ($this->samplers as $sampler) {
            if ($sampler->desc->anisotropic) {
                $sampler->handle = $this->samplerHandle($sampler->desc);
            }
        }
    }

    private function samplerHandle(const SamplerDesc& $desc) : SamplerHandle
    {
        mtl::Device $gpu = guard $this->gpu else {
            die('createSampler before initialize');
        }
        mtl::SamplerDescriptor $sd = mtl::SamplerDescriptor();
        $sd->minFilter = mtlMinMag($desc->min);
        $sd->magFilter = mtlMinMag($desc->mag);
        $sd->mipFilter = mtlMip($desc->min);
        $sd->sAddressMode = mtlAddress($desc->wrapS);
        $sd->tAddressMode = mtlAddress($desc->wrapT);
        $sd->rAddressMode = mtlAddress($desc->wrapT);

        if ($desc->anisotropic) {
            $sd->maxAnisotropy = $this->anisoLevel as uint32;
        }

        // any sampler may sit in a TextureTable's sampler row
        $sd->supportArgumentBuffers = $this->limits->bindless;

        mtl::SamplerState $samp = guard $gpu->newSamplerState($sd) else {
            die('metal: newSamplerState failed');
        }
        return SamplerHandle($samp);
    }

    public function createShaderModule(ShaderKind $kind, const string& $bytes, string $name) : result<ShaderModuleHandle, DeviceError>
    {
        mtl::Device $gpu = guard $this->gpu else {
            return .error(.noDevice);
        }

        if ($bytes->empty()) {
            return .error(.shader($name, 'empty source'));
        }

        string $entry = mtlFunctionName($kind);

        if ($entry->empty()) {
            return .error(.shader($name, 'unsupported stage'));
        }

        // a program that reads the texture table (set 3) is MSL 3: argument buffers of resource ids
        mtl::LanguageVersion $version = .default;
        if ($bytes->contains(METAL_TABLE_MARKER)) {
            $version = .v3_0;
        }

        mtl::Library $lib = guard $gpu->newLibrary(source: $bytes, mtl::CompileOptions(true, $version)) else ($e) {
            string $log = match ($e) {
                mtl::Error::compile($m) => $m,
                mtl::Error::pipeline($m) => $m,
                mtl::Error::other($m) => $m,
            };
            return .error(.shader($name, $log));
        }
        mtl::Function $fn = guard $lib->newFunction($entry) else {
            return .error(.shader($name, "missing entry '{$entry}'"));
        }
        return .ok(ShaderModuleHandle($lib, $fn));
    }

    public function destroyShaderModule(ShaderModuleHandle $handle) : void
    {
        // rc drop
    }

    public function destroyPipeline(PipelineHandle $handle) : void
    {
        // rc drop
    }

    internal function encoderClosed() : void
    {
        $this->encoderOpen = false;
        $this->activeEnc = null;
    }

    public function shutdown() : void
    {
        $this->deferred->drop();
        $this->gpuShaders->drop();
        $this->sceneShaders->drop();
        if ($this->gpu == null) {
            $this->ready = false;
            return;
        }

        $this->loseSurface();
        $this->waitSlots();
        $this->releaseRetired();
        mtlDestroySlots($this);
        $this->psos = map<string, PipelineHandle>();
        $this->psoCache->clear();
        $this->computePsos = map<uint32, mtl::ComputePipelineState>();
        $this->samplers = map<string, Sampler>();
        $this->depthStates = map<uint32, mtl::DepthStencilState>();
        $this->queue = null;
        $this->gpu = null;
        $this->ready = false;
    }

    internal function openScene() : result<FrameStatus, DeviceError>
    {
        FrameSlot $slot = $this->slots[$this->slot];
        $slot->ring->reset();
        $slot->stamps->reset($this->frames);
        $slot->stamps->barrier = $this->gpuProfiler->mode == GpuProfilerMode::detailed;
        $this->sceneCommitted = false;
        mtl::Layer $layer = guard $this->layer else {
            return .ok(.skipped);
        }
        mtl::CommandQueue $queue = guard $this->queue else {
            return .error(.noDevice);
        }
        mtl::CommandBuffer $cmd = guard $queue->commandBuffer() else {
            return .error(.metal('beginFrame', 'command buffer'));
        }
        $this->drawable = null;
        $this->bb = null;
        $this->cmd = $cmd;
        $this->inFrame = true;
        return .ok(.ready);
    }

    /**
     * Take the drawable. If the scene command buffer already recorded work, commit it first so
     * offscreen passes do not wait on the vsync queue.
     */
    private function acquireBackbuffer() : Texture
    {
        assert($this->inFrame, 'backbuffer outside beginFrame');
        FrameSlot $slot = $this->slots[$this->slot];
        bool $hadWork = $slot->stamps->pending->count() > 0 || $this->preEnc != null;

        if ($hadWork && !$this->sceneCommitted) {
            mtlCommitScene($this);
        }

        mtl::Layer $layer = guard $this->layer else {
            die('backbuffer without a surface');
        }
        mtl::Drawable $next = guard $layer->nextDrawable() else {
            die('metal: nextDrawable failed');
        }
        $this->drawable = $next;
        TextureHandle $th = TextureHandle($next->texture(), true);
        TextureDesc $bbDesc = TextureDesc(
            $format: $this->bbFormat,
            $width: $this->drawableW,
            $height: $this->drawableH
        );
        $bbDesc->usage = 0 as uint32;
        Texture $bb = Texture(imported: $this, $th, $bbDesc);
        $bb->state = .undefined;
        $this->bb = $bb;
        return $bb;
    }

    private function openEncoder(
        mtl::CommandBuffer $cmd,
        mtl::RenderPassDescriptor $pass,
        TargetFormats $formats,
        mtl::PixelFormat $depthFmt,
        int32 $width,
        int32 $height
    ) : RenderEncoder
    {
        mtlTimestampsAttach($this->slots[$this->slot]->stamps, $pass);
        mtl::RenderCommandEncoder $enc = guard $cmd->renderCommandEncoder($pass) else {
            die('metal: renderCommandEncoder failed');
        }
        GpuTimestamps $stamps = $this->slots[$this->slot]->stamps;
        mtlTimestampsTagBegin($stamps, $enc);

        if ($stamps->gpuOpen && !$stamps->name->empty()) {
            $enc->setLabel($stamps->name);
            $enc->pushDebugGroup($stamps->name);
        }

        $this->encoderOpen = true;
        $this->activeEnc = $enc;
        return RenderEncoder($this, $formats, $width, $height, $enc, $depthFmt);
    }

    public function gpuBegin(const string& $name) : GpuProfileScope
    {
        return mtlGpuBegin($this, $name, .graphics);
    }

    public function gpuEnd(GpuProfileScope $scope) : void
    {
        mtlGpuEnd($this, $scope);
    }

    /**
     * Only on a state change; never per frame.
     * A CATransaction around the layer write; doing this every frame dirties the layer and costs the compositor fast path.
     */
    private function applyVsync() : void
    {
        mtl::Layer $owned = guard $this->layer else {
            return;
        }
        $owned->setDisplaySync($this->vsync);
        if ($this->vsync != $owned->displaySync()) {
            info('metal: displaySyncEnabled did not take');
        }
    }

    private function waitSlots() : void
    {
        mtlTimestampsHarvest($this);
    }

    internal function preComputeEncoder() : mtl::ComputeCommandEncoder
    {
        return mtlPreComputeEncoder($this);
    }

    internal function computePipeline(ComputeProgram $kernel) : mtl::ComputePipelineState
    {
        return mtlComputePipeline($this, $kernel);
    }

    private function abortFrame() : void
    {
        mtlCommitPreRender($this, true);
        mtl::RenderCommandEncoder? $held = $this->activeEnc;

        if ($held != null) {
            mtl::RenderCommandEncoder $enc = guard $held;
            $enc->endEncoding();
        }

        $this->encoderOpen = false;
        $this->activeEnc = null;

        if ($this->inFrame) {
            mtl::CommandBuffer $cmd = guard $this->cmd else {
                $this->inFrame = false;
                $this->sceneCommitted = false;
                $this->drawable = null;
                $this->bb = null;
                return;
            }
            $cmd->commit();
            $cmd->waitUntilCompleted();
            $this->cmd = null;
            $this->inFrame = false;
            $this->sceneCommitted = false;
            FrameSlot $slot = $this->slots[$this->slot];
            mtlWaitDrop($slot->prev);
            $slot->prev = null;
            mtlWaitDrop($slot->presentPrev);
            $slot->presentPrev = null;
            // the aborted buffer never becomes $prev, so its samples must not pair with the next one
            $slot->stamps->reset($this->frames);
        }

        $this->drawable = null;
        $this->bb = null;
    }
}
