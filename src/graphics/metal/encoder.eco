/**
 * Open render encoder. endRender() must run; the destructor asserts it did.
 * Uniforms are the frame ring at buffer index 2+N.
 */

namespace visu::graphics;

public class RenderEncoder : RenderEncoderProtocol
{
    private Device $device;
    private TargetFormats $formats;
    private int32 $width;
    private int32 $height;
    private bool $ended;
    private bool $viewportSet;
    private bool $scissorSet;
    private bool $pipelineSet;
    internal mtl::RenderCommandEncoder $enc;
    internal mtl::PixelFormat $depthFmt;
    private Topology $topology;
    private Buffer? $indexBuffer;
    private mtl::Buffer? $indexTransient;
    private IndexType $indexType;
    private uint64 $indexOffset;
    private TextureHandle[16] $texHandles;
    private SamplerHandle[16] $sampHandles;
    private bool $texturesDirty;
    private uint64[4] $uniformOff;
    private bool[4] $uniformSet;
    private int32 $patchControlPoints;
    private uint64 $tessFactorOff;
    private bool $tessFactorSet;
    private uint32 $tessInstanceStride;
    private uint64 $vertexTransientOff;
    private bool $vertexTransientSet;

    public constructor(
        Device $device,
        TargetFormats $formats,
        int32 $width,
        int32 $height,
        mtl::RenderCommandEncoder $enc,
        mtl::PixelFormat $depthFmt
    )
    {
        $this->device = $device;
        $this->formats = $formats;
        $this->width = $width;
        $this->height = $height;
        $this->ended = false;
        $this->viewportSet = false;
        $this->scissorSet = false;
        $this->pipelineSet = false;
        $this->enc = $enc;
        $this->depthFmt = $depthFmt;
        $this->topology = .triangles;
        $this->patchControlPoints = 0;
        $this->tessFactorOff = 0;
        $this->tessFactorSet = false;
        $this->tessInstanceStride = 0;
        $this->vertexTransientOff = 0;
        $this->vertexTransientSet = false;
        $this->indexBuffer = null;
        $this->indexTransient = null;
        $this->indexType = .uint16;
        $this->indexOffset = 0;
        $this->texturesDirty = false;
        uint64[4] $off;
        bool[4] $set;
        uint32 $i = 0;

        while ($i < 4) {
            $off[$i] = 0;
            $set[$i] = false;
            $i = $i + 1;
        }

        $this->uniformOff = mv $off;
        $this->uniformSet = mv $set;
        TextureHandle[16] $texes;
        SamplerHandle[16] $samps;
        $i = 0;

        while ($i < TEXTURE_SLOTS) {
            $texes[$i] = TextureHandle::none();
            $samps[$i] = SamplerHandle::none();
            $i = $i + 1;
        }

        $this->texHandles = mv $texes;
        $this->sampHandles = mv $samps;
    }

    destructor()
    {
        assert($this->ended, 'RenderEncoder dropped without endRender');
    }

    public const function targetFormats() : TargetFormats
    {
        return $this->formats;
    }

    public const function width() : int32
    {
        return $this->width;
    }

    public const function height() : int32
    {
        return $this->height;
    }

    public function setGpuPass(const GpuPass& $pass) : void
    {
        assert(!$this->ended, 'setGpuPass after endRender');
        PipelineHandle $pso = metalGetPipeline($this->device, $pass, $this->formats, $this->depthFmt);
        mtl::RenderPipelineState $state = guard $pso->pipeline else {
            die('metal: pipeline handle is empty');
        }
        $this->enc->setRenderPipelineState($state);
        $this->enc->setCullMode(mtlCull($pass->raster->cull));
        $this->enc->setFrontFacing(mtlWinding($pass->raster->front));
        $this->enc->setTriangleFillMode(mtlFill($pass->raster->fill));
        mtl::DepthStencilState $ds = guard metalDepthState($this->device, $pass->raster) else {
            $this->pipelineSet = true;
            $this->topology = $pass->topology;
            $this->patchControlPoints = $pass->patchControlPoints;
            $this->device->draws->bind();
            $this->applyDefaults();
            return;
        }
        $this->enc->setDepthStencilState($ds);
        $this->pipelineSet = true;
        $this->topology = $pass->topology;
        $this->patchControlPoints = $pass->patchControlPoints;
        $this->device->draws->bind();
        $this->applyDefaults();
    }

    public function setViewport(int32 $x, int32 $y, int32 $w, int32 $h) : void
    {
        assert(!$this->ended, 'setViewport after endRender');
        $this->enc->setViewport(mtl::Viewport(
            $x as float64,
            $y as float64,
            $w as float64,
            $h as float64
        ));
        $this->viewportSet = true;
    }

    public function setScissor(int32 $x, int32 $y, int32 $w, int32 $h) : void
    {
        assert(!$this->ended, 'setScissor after endRender');
        GpuScissor $s = clampScissor($x, $y, $w, $h, $this->width, $this->height);
        $this->enc->setScissorRect(mtl::ScissorRect(
            $s->x as uint32,
            $s->y as uint32,
            $s->w as uint32,
            $s->h as uint32
        ));
        $this->scissorSet = true;
    }

    public function setVertexBuffer(uint32 $binding, Buffer $buffer, uint64 $offset = 0) : void
    {
        assert(!$this->ended, 'setVertexBuffer after endRender');
        mtl::Buffer $buf = guard $buffer->handle->buffer else {
            die('metal: vertex buffer handle is empty');
        }
        $this->enc->setVertexBuffer($buf, $offset as uint32, index: $binding);
    }

    public function setIndexBuffer(Buffer $buffer, IndexType $type, uint64 $offset = 0) : void
    {
        assert(!$this->ended, 'setIndexBuffer after endRender');
        $this->indexBuffer = $buffer;
        $this->indexTransient = null;
        $this->indexType = $type;
        $this->indexOffset = $offset;
    }

    public function setVertexTransient(uint32 $binding, TransientSlice $slice) : void
    {
        assert(!$this->ended, 'setVertexTransient after endRender');
        assert($slice->frameSlot == $this->device->slot, 'transient from another frame');
        mtl::Buffer $buf = guard $this->device->slots[$this->device->slot]->ring->buffer else {
            die('metal: ring is empty');
        }
        $this->enc->setVertexBuffer($buf, $slice->offset as uint32, index: $binding);
        $this->vertexTransientOff = $slice->offset;
        $this->vertexTransientSet = true;
    }

    public function setIndexTransient(TransientSlice $slice, IndexType $type) : void
    {
        assert(!$this->ended, 'setIndexTransient after endRender');
        assert($slice->frameSlot == $this->device->slot, 'transient from another frame');
        mtl::Buffer $buf = guard $this->device->slots[$this->device->slot]->ring->buffer else {
            die('metal: ring is empty');
        }
        $this->indexBuffer = null;
        $this->indexTransient = $buf;
        $this->indexType = $type;
        $this->indexOffset = $slice->offset;
    }

    public function bindUniform(uint32 $slot, TransientSlice $slice) : void
    {
        assert(!$this->ended, 'bindUniform after endRender');
        assert($slot < UNIFORM_SLOTS, 'uniform slot');
        assert($slice->frameSlot == $this->device->slot, 'transient from another frame');
        $this->uniformOff[$slot] = $slice->offset;
        $this->uniformSet[$slot] = true;
    }

    public function upload<T>(const T& $params, slot: uint32 $slot = 0) : void
    {
        uint64 $n = mem::size<T>() as uint64;
        TransientSlice $slice = $this->device->allocTransient($n, $this->device->limits->uniformAlign);
        T $local = $params;
        ptr<const uint8> $src = ptr<const uint8>(&$local);
        mem::copy<uint8>(ptr<uint8>($slice->data:$), ptr<uint8>($src:$), $n);
        $this->bindUniform($slot, $slice);
    }

    public function bindTexture(uint32 $slot, Texture $texture, Sampler $sampler) : void
    {
        assert(!$this->ended, 'bindTexture after endRender');
        assert($slot < TEXTURE_SLOTS, 'texture slot');
        if ($texture->state != ResourceState::shaderRead) {
            die("bindTexture: '{$texture->desc->label}' is not shaderRead");
        }
        $this->texHandles[$slot] = $texture->handle;
        $this->sampHandles[$slot] = $sampler->handle;
        $this->texturesDirty = true;
    }

    public function tessellateWith(ComputeProgram $kernel, uint32 $patchCount) : void
    {
        assert(!$this->ended, 'tessellateWith after endRender');
        assert($this->vertexTransientSet, 'tessellateWith before setVertexTransient');
        if ($patchCount < 1) {
            return;
        }

        uint64 $factBytes = ($patchCount as uint64) * (QUAD_TESS_FACTOR_STRIDE as uint64);
        uint64 $factAlign = $this->device->limits->tessFactorAlign;
        if ($factAlign < TESS_FACTOR_ALIGN) {
            $factAlign = TESS_FACTOR_ALIGN;
        }

        TransientSlice $facts = $this->device->allocTransient($factBytes, $factAlign);
        mtl::ComputeCommandEncoder $compute = $this->device->preComputeEncoder();
        mtl::ComputePipelineState $pso = $this->device->computePipeline($kernel);
        $compute->setComputePipelineState($pso);
        FrameSlot $fs = $this->device->slots[$this->device->slot];
        mtl::Buffer $ring = guard $fs->ring->buffer else {
            die('metal: ring is empty');
        }
        $compute->setBuffer($ring, $this->vertexTransientOff as uint32, index: 0);
        $compute->setBuffer($ring, $facts->offset as uint32, index: 1);
        uint32 $i = 0;
        while ($i < UNIFORM_SLOTS) {
            if ($this->uniformSet[$i]) {
                $compute->setBuffer($ring, $this->uniformOff[$i] as uint32, index: METAL_UNIFORM_BASE + $i);
            }

            $i = $i + 1;
        }

        $compute->dispatchThreads(
            mtl::Size($patchCount as usize, 1 as usize, 1 as usize),
            mtl::Size(64 as usize, 1 as usize, 1 as usize)
        );
        $this->tessFactorOff = $facts->offset;
        $this->tessFactorSet = true;
        $this->tessInstanceStride = 0;
    }

    public function draw(int32 $first, int32 $count, int32 $instances = 1) : void
    {
        assert(!$this->ended, 'draw after endRender');
        assert($this->pipelineSet, 'draw before setGpuPass');
        $this->flushBindings();
        uint32 $n = 1;

        if ($instances > 1) {
            $n = $instances as uint32;
        }

        $this->device->draws->draw($this->topology, $count, $instances, $this->patchControlPoints);
        if ($this->topology == Topology::patches) {
            int32 $cps = $this->patchControlPoints;
            if ($cps < 1) {
                $cps = 4;
            }

            uint32 $patchCount = ($count / $cps) as uint32;
            if ($patchCount < 1) {
                $patchCount = 1;
            }

            uint32 $patchStart = ($first / $cps) as uint32;
            $this->enc->drawPatches($cps as uint32, $patchStart, $patchCount, $n);
            return;
        }

        $this->enc->drawPrimitives(mtlTopology($this->topology), $first as uint32, $count as uint32, $n);
    }

    public function drawIndexed(int32 $firstIndex, int32 $count, int32 $instances = 1, int32 $vertexOffset = 0) : void
    {
        assert(!$this->ended, 'drawIndexed after endRender');
        assert($this->pipelineSet, 'drawIndexed before setGpuPass');
        assert($vertexOffset == 0, 'metal: base vertex is not implemented');
        mtl::Buffer? $chosen = $this->indexTransient;

        if ($chosen == null) {
            Buffer $idx = guard $this->indexBuffer else {
                die('drawIndexed without setIndexBuffer');
            }
            $chosen = $idx->handle->buffer;
        }

        guard $chosen else {
            die('metal: index buffer handle is empty');
        }
        mtl::Buffer $buf = guard $chosen;
        $this->flushBindings();
        uint32 $n = 1;

        if ($instances > 1) {
            $n = $instances as uint32;
        }

        uint32 $elem = 2;

        if ($this->indexType == IndexType::uint32) {
            $elem = 4;
        }

        $this->device->draws->drawIndexed($this->topology, $count, $instances, $this->patchControlPoints);
        uint32 $off = ($this->indexOffset as uint32) + (($firstIndex as uint32) * $elem);
        $this->enc->drawIndexedPrimitives(
            mtlTopology($this->topology),
            $count as uint32,
            mtlIndexType($this->indexType),
            $buf,
            $off,
            $n
        );
    }

    public function endRender() : void
    {
        assert(!$this->ended, 'RenderEncoder.endRender twice');
        $this->ended = true;
        GpuTimestamps $stamps = $this->device->slots[$this->device->slot]->stamps;

        if ($stamps->gpuOpen && !$stamps->name->empty()) {
            $this->enc->popDebugGroup();
        }

        mtlTimestampsTagEnd($stamps, $this->enc);
        $this->enc->endEncoding();
        $this->device->encoderClosed();
    }

    private function applyDefaults() : void
    {
        if (!$this->viewportSet) {
            $this->setViewport(0, 0, $this->width, $this->height);
        }

        if (!$this->scissorSet) {
            $this->setScissor(0, 0, $this->width, $this->height);
        }
    }

    private function flushBindings() : void
    {
        FrameSlot $fs = $this->device->slots[$this->device->slot];
        mtl::Buffer $ring = guard $fs->ring->buffer else {
            die('metal: uniform ring is empty');
        }
        uint32 $i = 0;

        while ($i < 4) {
            if ($this->uniformSet[$i]) {
                uint32 $off = $this->uniformOff[$i] as uint32;
                uint32 $index = METAL_UNIFORM_BASE + $i;
                $this->enc->setVertexBuffer($ring, $off, index: $index);
                $this->enc->setFragmentBuffer($ring, $off, index: $index);
            }

            $i = $i + 1;
        }

        if ($this->tessFactorSet) {
            $this->enc->setTessellationFactorBuffer($ring, $this->tessFactorOff, $this->tessInstanceStride);
        }

        if (!$this->texturesDirty) {
            return;
        }

        $i = 0;

        while ($i < TEXTURE_SLOTS) {
            // bindSlot skips a slot nothing was bound into
            $this->bindSlot($i);
            $i = $i + 1;
        }

        $this->texturesDirty = false;
    }

    /**
     * One combined image sampler. An empty handle is a wiring bug the shared Texture class already asserts against.
     */
    private function bindSlot(uint32 $slot) : void
    {
        mtl::Texture $mt = guard $this->texHandles[$slot]->texture else {
            return;
        }
        mtl::SamplerState $ss = guard $this->sampHandles[$slot]->sampler else {
            return;
        }
        $this->enc->setFragmentTexture($mt, index: $slot);
        $this->enc->setFragmentSamplerState($ss, index: $slot);
        $this->enc->setVertexTexture($mt, index: $slot);
        $this->enc->setVertexSamplerState($ss, index: $slot);
    }
}
