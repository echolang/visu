/**
 * CAMetalLayer attach / resize / next drawable. Device owns the layer.
 * The host passes the view (NSView or UIView), not an NSWindow.
 */

namespace visu::graphics;

internal function mtlAttachLayer(
    mtl::Device $gpu,
    ptr<uint8> $view,
    int32 $width,
    int32 $height,
    float64 $scale
) : result<mtl::Layer, DeviceError>
{
    if ($view:$ == null) {
        return .error(.metal('attach', 'no view'));
    }

    mtl::Layer $layer = mtl::Layer(attachView: $view, $gpu);
    $layer->setFramebufferOnly(true);
    $layer->setMaximumDrawableCount(3);
    mtlLayerScale($layer, $scale);

    if ($width > 0 && $height > 0) {
        $layer->setDrawableSize(mtl::Size($width as usize, $height as usize));
    }

    return .ok($layer);
}

internal function mtlResizeLayer(mtl::Layer $layer, int32 $width, int32 $height) : void
{
    if ($width <= 0 || $height <= 0) {
        return;
    }

    $layer->setDrawableSize(mtl::Size($width as usize, $height as usize));
}

/**
 * The layer is view-hosted (setLayer: + setWantsLayer:), so AppKit does not maintain contentsScale for us and GLFW cannot either; it never learns about this layer.
 * Leaving it at 1.0 while drawableSize is the backing size breaks the `drawableSize == bounds * contentsScale` invariant.
 * The WindowServer then resamples every frame instead of scanning the surface out directly, which pins the window to 60 Hz.
 */
internal function mtlLayerScale(mtl::Layer $layer, float64 $scale) : void
{
    if ($scale <= 0.0) {
        return;
    }

    $layer->setContentsScale($scale);
}
