/**
 * Metal `Gpu`. A class so GPU objects share one handle table and
 * one command stream. The app constructs one; everyone else stores
 * it. Call lose() when the window dies so the drawable is dropped;
 * the device stays so late destroy() can still release Metal objects.
 */

namespace visu::graphics;

public class Gpu : GpuProtocol
{
    private GpuBinds $binds;
    private MetalStore $store;
    private MetalPass $pass;
    private MetalPsoCache $psos;
    private map<uint32, uint32> $boundTex;
    private bool $lost;

    public constructor()
    {
        $this->binds = GpuBinds();
        $this->store = MetalStore();
        $this->pass = MetalPass();
        $this->psos = MetalPsoCache();
        $this->boundTex = map<uint32, uint32>();
        $this->lost = false;
        $this->clearBinds();
    }

    /**
     * The window is gone. Drops the layer and drawable. Device and
     * queue stay so destroy() can still release objects.
     */
    public function lose() : void
    {
        $this->pass->dropSurface();
    }

    public const function lost() : bool
    {
        return $this->lost;
    }

    /**
     * Create the system default device and a command queue.
     * Call after the GLFW window exists, before connect.
     */
    public function load() : bool
    {
        $this->lost = false;

        if ($this->pass->device != null && $this->pass->queue != null) {
            return true;
        }

        if (!mtl::available()) {
            return false;
        }

        mtl::Device $device = guard mtl::Device::systemDefault() else {
            return false;
        }
        mtl::CommandQueue $queue = guard $device->newCommandQueue() else {
            return false;
        }
        $this->pass->device = $device;
        $this->pass->queue = $queue;
        return true;
    }

    /**
     * Attach a CAMetalLayer to the NSWindow behind the GLFW handle.
     */
    public function connect(ptr<uint8> $view, int32 $width, int32 $height) : bool
    {
        return $this->pass->connect($view, $width, $height);
    }

    public function resizeDrawable(int32 $width, int32 $height) : void
    {
        $this->pass->resize($width, $height);
    }

    /**
     * End the encoder, present the drawable, commit. Next backbuffer
     * use takes a new drawable.
     */
    public function present() : void
    {
        $this->pass->present($this->binds, $this->store);
    }

    public function reset() : void
    {
        $this->pass->endEncoder();
        $this->clearBinds();
    }

    private function clearBinds() : void
    {
        $this->binds->clear();
        $this->binds->textureUnit = TEXTURE0;
        $this->boundTex = map<uint32, uint32>();
        $this->pass->pendingColorClear = false;
        $this->pass->pendingDepthClear = false;
    }

    public function useProgram(uint32 $program) : void
    {
        $this->binds->program = $program;
    }

    public function bindFramebuffer(FramebufferTarget $target, uint32 $id) : bool
    {
        return match ($target) {
            FramebufferTarget::readDraw => $this->bindReadDraw($id),
            FramebufferTarget::read => $this->bindRead($id),
            FramebufferTarget::draw => $this->bindDraw($id),
        };
    }

    private function bindReadDraw(uint32 $id) : bool
    {
        bool $changed = $this->binds->readFramebuffer != $id || $this->binds->drawFramebuffer != $id;

        if (!$changed) {
            return false;
        }

        if ($this->binds->drawFramebuffer != $id && $this->pass->passOpen) {
            $this->pass->endEncoder();
        }

        $this->binds->readFramebuffer = $id;
        $this->binds->drawFramebuffer = $id;
        return true;
    }

    private function bindRead(uint32 $id) : bool
    {
        if ($this->binds->readFramebuffer == $id) {
            return false;
        }

        $this->binds->readFramebuffer = $id;
        return true;
    }

    private function bindDraw(uint32 $id) : bool
    {
        if ($this->binds->drawFramebuffer == $id) {
            return false;
        }

        if ($this->pass->passOpen) {
            $this->pass->endEncoder();
        }

        $this->binds->drawFramebuffer = $id;
        return true;
    }

    public function bindVertexArray(uint32 $vao) : void
    {
        $this->binds->vertexArray = $vao;
    }

    public function bindVertexBuffer(uint32 $vbo) : void
    {
        $this->binds->vertexBuffer = $vbo;
    }

    public function bindIndexBuffer(uint32 $ibo) : void
    {
        $this->binds->indexBuffer = $ibo;
    }

    public function bindUniformBuffer(uint32 $ubo) : void
    {
        $this->binds->uniformBuffer = $ubo;
    }

    public function bindUniformSlot(uint32 $slot, uint32 $id) : void
    {
        $this->bindUniformBuffer($id);
        $this->binds->boundSlots[$slot] = $id;
    }

    public function pushUniform(uint32 $slot, ptr<const uint8> $ptr, isize $bytes) : void
    {
        fillUniformScratch($this, $this->binds, $slot, $ptr, $bytes);
    }

    public function uploadBytes(BufferUse $use, uint32 $id, ptr<const uint8> $ptr, isize $bytes) : void
    {
        if (!$this->store->buffers->has($id)) {
            return;
        }

        BufRec $rec = $this->store->buffers[$id];
        $rec->kind = $use;
        $this->store->writeBuffer($rec, $ptr, $bytes, $this->pass->device);
    }

    public function applyRaster(const Raster& $raster) : void
    {
        if ($this->binds->sameRaster($raster)) {
            return;
        }

        metalAssertRaster($raster->blend, $raster->colorWrite);
        $this->binds->rememberRaster($raster);
        mtl::RenderCommandEncoder $enc = guard $this->pass->enc else {
            return;
        }
        $this->pass->applyRasterNow($enc, $this->binds);
    }

    public function bindTexture(uint32 $unit, TextureTarget $target, uint32 $texture) : void
    {
        $this->binds->textureUnit = $unit;
        $this->boundTex[$unit] = $texture;
    }

    public const function boundTexture(uint32 $unit, TextureTarget $target) : uint32
    {
        if (!$this->boundTex->has($unit)) {
            return 0;
        }

        return $this->boundTex[$unit];
    }

    public function forgetTexture(uint32 $texture) : void
    {
        array<uint32> $units = $this->boundTex->keys();

        foreach ($units as $unit) {
            if ($this->boundTex[$unit] == $texture) {
                $this->boundTex[$unit] = 0;
            }
        }
    }

    public function createVertexArray() : uint32
    {
        uint32 $id = $this->store->alloc();
        $this->store->vaos[$id] = VaoRec();
        return $id;
    }

    public function deleteVertexArray(uint32 $id) : void
    {
        $this->store->vaos->remove($id);

        if ($this->binds->vertexArray == $id) {
            $this->binds->vertexArray = 0;
        }
    }

    public function createBuffer() : uint32
    {
        uint32 $id = $this->store->alloc();
        $this->store->buffers[$id] = BufRec();
        return $id;
    }

    public function deleteBuffer(uint32 $id) : void
    {
        $this->store->buffers->remove($id);
        $this->binds->dropBuffer($id);
    }

    public function uploadFloats(BufferUse $use, uint32 $id, array<float32>& $data) : void
    {
        usize $n = $data->count();
        isize $bytes = ($n * mem::size<float32>()) as isize;
        ptr<const uint8> $ptr = null;

        if ($n > 0) {
            $ptr:$ = ptr<const uint8>(&$data[0]);
        }

        $this->uploadBytes($use, $id, $ptr, $bytes);
    }

    public function applyLayout(uint32 $vao, const VertexLayout& $layout, uint32 $vertexBuf, uint32 $instanceBuf) : void
    {
        if (!$this->store->vaos->has($vao)) {
            return;
        }

        VaoRec $rec = $this->store->vaos[$vao];
        array<VaoAttr> $attrs = array<VaoAttr>();

        foreach ($layout->attrs as $attr) {
            uint32 $buf = $vertexBuf;

            if ($attr->divisor != 0) {
                assert($instanceBuf != 0, 'mesh: instance attrib without instance buffer');
                $buf = $instanceBuf;
            }

            $attrs[] = VaoAttr(
                $attr->location,
                $attr->components,
                $attr->offset,
                $attr->stride,
                $attr->divisor,
                $buf,
                true
            );
        }

        $rec->attrs = $attrs;
        $this->binds->vertexArray = $vao;
    }

    public function drawArrays(DrawMode $mode, int32 $first, int32 $count) : void
    {
        $this->drawPrims($mode, $first, $count, 1);
    }

    public function drawInstanced(DrawMode $mode, int32 $first, int32 $count, int32 $instances) : void
    {
        $this->drawPrims($mode, $first, $count, $instances);
    }

    private function drawPrims(DrawMode $mode, int32 $first, int32 $count, int32 $instances) : void
    {
        if ($count <= 0) {
            return;
        }

        if (!$this->pass->begin($this->binds, $this->store, $this->lost)) {
            return;
        }

        mtl::RenderCommandEncoder $enc = guard $this->pass->enc else {
            return;
        }

        if (!$this->psos->bind($enc, $this->pass->device, $this->store, $this->binds)) {
            return;
        }

        $this->bindDrawBuffers($enc);
        $this->bindDrawTextures($enc);
        uint32 $n = 1;

        if ($instances > 1) {
            $n = $instances as uint32;
        }

        $enc->drawPrimitives(mtlDrawMode($mode), $first as uint32, $count as uint32, $n);
    }

    private function bindDrawBuffers(mtl::RenderCommandEncoder $enc) : void
    {
        if (!$this->store->vaos->has($this->binds->vertexArray)) {
            return;
        }

        VaoRec $vao = $this->store->vaos[$this->binds->vertexArray];
        uint32 $vertexId = 0;
        uint32 $instanceId = 0;

        foreach ($vao->attrs as $attr) {
            if (!$attr->enabled) {
                continue;
            }

            if ($attr->divisor != 0) {
                $instanceId = $attr->buffer;
            } else {
                $vertexId = $attr->buffer;
            }
        }

        $this->setVertexBuf($enc, $vertexId, MTL_VERTEX_BUFFER);

        if ($instanceId != 0) {
            $this->setVertexBuf($enc, $instanceId, MTL_INSTANCE_BUFFER);
        }

        array<uint32> $slots = $this->binds->boundSlots->keys();

        foreach ($slots as $slot) {
            $this->setUniformBuf($enc, $this->binds->boundSlots[$slot], mtlUniformIndex($slot));
        }
    }

    private function setUniformBuf(mtl::RenderCommandEncoder $enc, uint32 $id, uint32 $index) : void
    {
        if ($id == 0 || !$this->store->buffers->has($id)) {
            return;
        }

        BufRec $rec = $this->store->buffers[$id];
        mtl::Buffer $buf = guard $rec->obj else {
            return;
        }
        $enc->setVertexBuffer($buf, index: $index);
        $enc->setFragmentBuffer($buf, index: $index);
    }

    private function setVertexBuf(mtl::RenderCommandEncoder $enc, uint32 $id, uint32 $index) : void
    {
        if ($id == 0 || !$this->store->buffers->has($id)) {
            return;
        }

        BufRec $rec = $this->store->buffers[$id];
        mtl::Buffer $buf = guard $rec->obj else {
            return;
        }
        $enc->setVertexBuffer($buf, index: $index);
    }

    private function bindDrawTextures(mtl::RenderCommandEncoder $enc) : void
    {
        array<uint32> $units = $this->boundTex->keys();

        foreach ($units as $unit) {
            uint32 $id = $this->boundTex[$unit];

            if ($id == 0 || !$this->store->textures->has($id)) {
                continue;
            }

            TexRec $rec = $this->store->textures[$id];
            mtl::Texture $tex = guard $rec->obj else {
                continue;
            }
            $enc->setFragmentTexture($tex, index: $unit);
            mtl::SamplerState $sampler = guard $rec->sampler else {
                continue;
            }
            $enc->setFragmentSamplerState($sampler, index: $unit);
        }
    }

    public function createTexture() : uint32
    {
        uint32 $id = $this->store->alloc();
        $this->store->textures[$id] = TexRec();
        return $id;
    }

    public function deleteTexture(uint32 $id) : void
    {
        $this->store->textures->remove($id);
        $this->forgetTexture($id);
    }

    public function texImage2D(TextureTarget $target, PixelFormat $format, int32 $width, int32 $height) : void
    {
        uint32 $id = $this->boundTexture($this->binds->textureUnit, $target);

        if ($id == 0 || !$this->store->textures->has($id)) {
            return;
        }

        TexRec $rec = $this->store->textures[$id];
        $rec->format = $format;
        $rec->width = $width;
        $rec->height = $height;
        $rec->target = $target;
        $rec->obj = $this->store->allocTexture($format, $width, $height, $this->pass->device);
        $this->store->rebuildSampler($rec, $this->pass->device);
    }

    public function texFilter(TextureTarget $target, Filter $min, Filter $mag) : void
    {
        uint32 $id = $this->boundTexture($this->binds->textureUnit, $target);

        if ($id == 0 || !$this->store->textures->has($id)) {
            return;
        }

        TexRec $rec = $this->store->textures[$id];
        $rec->min = $min;
        $rec->mag = $mag;
        $this->store->rebuildSampler($rec, $this->pass->device);
    }

    public function texWrap(TextureTarget $target, Wrap $s, Wrap $t) : void
    {
        uint32 $id = $this->boundTexture($this->binds->textureUnit, $target);

        if ($id == 0 || !$this->store->textures->has($id)) {
            return;
        }

        TexRec $rec = $this->store->textures[$id];
        $rec->wrapS = $s;
        $rec->wrapT = $t;
        $this->store->rebuildSampler($rec, $this->pass->device);
    }

    public function generateMipmap(TextureTarget $target) : void
    {
        assert(false, 'metal: mipmap generate is not implemented');
    }

    public function unbindFramebuffer(uint32 $id) : void
    {
        if ($this->binds->readFramebuffer == $id && $this->binds->drawFramebuffer == $id) {
            if ($this->pass->passOpen) {
                $this->pass->endEncoder();
            }

            $this->binds->readFramebuffer = 0;
            $this->binds->drawFramebuffer = 0;
            return;
        }

        if ($this->binds->readFramebuffer == $id) {
            $this->binds->readFramebuffer = 0;
        }

        if ($this->binds->drawFramebuffer == $id) {
            if ($this->pass->passOpen) {
                $this->pass->endEncoder();
            }

            $this->binds->drawFramebuffer = 0;
        }
    }

    public function viewport(int32 $x, int32 $y, int32 $width, int32 $height) : void
    {
        $this->binds->viewportSet = true;
        $this->binds->viewportX = $x;
        $this->binds->viewportY = $y;
        $this->binds->viewportWidth = $width;
        $this->binds->viewportHeight = $height;
        mtl::RenderCommandEncoder $enc = guard $this->pass->enc else {
            return;
        }
        $this->pass->applyViewportNow($enc, $this->binds, $width, $height);
    }

    public function clearColor(float32 $r, float32 $g, float32 $b, float32 $a) : void
    {
        $this->binds->clearColorSet = true;
        $this->binds->clearR = $r;
        $this->binds->clearG = $g;
        $this->binds->clearB = $b;
        $this->binds->clearA = $a;
    }

    public function clear(uint32 $mask) : void
    {
        if (($mask & COLOR_BUFFER_BIT) != 0) {
            $this->pass->pendingColorClear = true;
        }

        if (($mask & DEPTH_BUFFER_BIT) != 0) {
            $this->pass->pendingDepthClear = true;
        }

        $this->pass->begin($this->binds, $this->store, $this->lost);
    }

    public function createFramebuffer() : uint32
    {
        uint32 $id = $this->store->alloc();
        $this->store->fbos[$id] = FboRec();
        return $id;
    }

    public function deleteFramebuffer(uint32 $id) : void
    {
        $this->unbindFramebuffer($id);
        $this->store->fbos->remove($id);
    }

    public function createRenderbuffer() : uint32
    {
        return $this->createTexture();
    }

    public function deleteRenderbuffer(uint32 $id) : void
    {
        $this->deleteTexture($id);

        if ($this->binds->renderbuffer == $id) {
            $this->binds->renderbuffer = 0;
        }
    }

    public function bindRenderbuffer(uint32 $id) : void
    {
        $this->binds->renderbuffer = $id;
    }

    public function renderbufferStorage(PixelFormat $format, int32 $width, int32 $height) : void
    {
        uint32 $id = $this->binds->renderbuffer;

        if ($id == 0 || !$this->store->textures->has($id)) {
            return;
        }

        TexRec $rec = $this->store->textures[$id];
        $rec->format = $format;
        $rec->width = $width;
        $rec->height = $height;
        $rec->obj = $this->store->allocTexture($format, $width, $height, $this->pass->device);
    }

    public function framebufferRenderbuffer(Attachment $point, uint32 $renderbuffer) : void
    {
        $this->attachToFbo($point, $renderbuffer);
    }

    public function framebufferTexture2D(Attachment $point, TextureTarget $target, uint32 $texture, int32 $level) : void
    {
        $this->attachToFbo($point, $texture);
    }

    private function attachToFbo(Attachment $point, uint32 $tex) : void
    {
        uint32 $id = $this->binds->drawFramebuffer;

        if ($id == 0 || !$this->store->fbos->has($id)) {
            return;
        }

        FboRec $fbo = $this->store->fbos[$id];
        int32 $w = 0;
        int32 $h = 0;
        PixelFormat $fmt = .rgba;

        if ($this->store->textures->has($tex)) {
            TexRec $rec = $this->store->textures[$tex];
            $w = $rec->width;
            $h = $rec->height;
            $fmt = $rec->format;
        }

        match ($point) {
            Attachment::color($slot) => {
                $fbo->color = $tex;
                $fbo->colorFormat = $fmt;
                $fbo->width = $w;
                $fbo->height = $h;
            },
            Attachment::depth => {
                $fbo->depth = $tex;
                $fbo->depthFormat = $fmt;
            },
            Attachment::stencil => {
                $fbo->depth = $tex;
                $fbo->depthFormat = $fmt;
            },
            Attachment::depthStencil => {
                $fbo->depth = $tex;
                $fbo->depthFormat = $fmt;
            },
        };
    }

    public function framebufferStatus() : FramebufferStatus
    {
        if ($this->binds->drawFramebuffer == 0) {
            return .complete;
        }

        if (!$this->store->fbos->has($this->binds->drawFramebuffer)) {
            return .undefined;
        }

        FboRec $fbo = $this->store->fbos[$this->binds->drawFramebuffer];

        if ($fbo->color == 0 && $fbo->depth == 0) {
            return .incompleteMissingAttachment;
        }

        return .complete;
    }

    public function drawBuffers(const array<Attachment>& $colors) : void
    {
        assert($colors->count() <= 1, 'metal: multiple color attachments are not implemented');
    }

    public function drawBuffers(ColorSpan $colors) : void
    {
        uint32 $n = 0;

        if ($colors->toExclusive > $colors->from) {
            $n = $colors->toExclusive - $colors->from;
        }

        assert($n <= 1, 'metal: multiple color attachments are not implemented');
    }

    public function createShader(ShaderKind $kind) : uint32
    {
        return $this->store->createShader($kind);
    }

    public function deleteShader(uint32 $id) : void
    {
        $this->store->deleteShader($id);
    }

    public function shaderSource(uint32 $id, string $source) : void
    {
        $this->store->shaderSource($id, $source);
    }

    public function compileShader(uint32 $id) : void
    {
        $this->store->compileShader($id, $this->pass->device);
    }

    public function shaderCompiled(uint32 $id) : bool
    {
        return $this->store->shaderCompiled($id);
    }

    public function shaderInfoLog(uint32 $id) : string
    {
        return $this->store->shaderInfoLog($id);
    }

    public function createProgram() : uint32
    {
        return $this->store->createProgram();
    }

    public function deleteProgram(uint32 $id) : void
    {
        $this->store->deleteProgram($id);
        $this->psos->forget($id);

        if ($this->binds->program == $id) {
            $this->binds->program = 0;
        }
    }

    public function attachShader(uint32 $program, uint32 $shader) : void
    {
        $this->store->attachShader($program, $shader);
    }

    public function linkProgram(uint32 $id) : void
    {
        $this->store->linkProgram($id);
    }

    public function programLinked(uint32 $id) : bool
    {
        return $this->store->programLinked($id);
    }

    public function programInfoLog(uint32 $id) : string
    {
        return $this->store->programInfoLog($id);
    }
}
