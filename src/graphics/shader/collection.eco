/**
 * Named shader programs and their permutations. Stores Device; `scan` walks a directory of offline-compiled stages.
 * `ShaderRef` is the slot: one object per name (and per variant), held for the process lifetime.
 * `forget` drops the linked program, not the ref.
 */

namespace visu::graphics;

use std::io;
use visu::app::slashDir;

public class ShaderCollection
{
    public Device $device;
    public ShaderLoader $loader;
    private map<string, ShaderRef> $shaders;

    public constructor(Device $device, string $directory)
    {
        $this->device = $device;
        $this->loader = ShaderLoader($directory);
        $this->shaders = map<string, ShaderRef>();
    }

    public function register(string $name, array<ShaderFile> $files) : result<ShaderRef, ShaderError>
    {
        ShaderRef $entry = $this->entry($name);

        if ($entry->files->count() > 0) {
            return .error(.duplicate($name));
        }

        $entry->files = $files;
        return .ok($entry);
    }

    /**
     * Register every shader program under `$directory` (the collection directory when omitted). Recurses.
     * Name is the relative path with `.vert|.frag|.geo|.tessc|.tesse.{suffix}` stripped; `name+variant` files become permutation refs.
     * Already-registered names are left alone. Does not compile.
     */
    public function scan(string? $directory = null) : status<ShaderError>
    {
        string $root = guard $directory else {
            return $this->collect($this->loader->directory);
        }

        return $this->collect($root);
    }

    /**
     * Directory lookup. One map hit, then hold the class.
     */
    public function shader(string $name) : result<ShaderRef, ShaderError>
    {
        if (!$this->shaders->has($name)) {
            return .error(.missing($name));
        }

        return .ok($this->shaders[$name]);
    }

    /**
     * Compile if needed and return the program.
     */
    public function load(string $name) : result<ShaderProgram, ShaderError>
    {
        if (!$this->shaders->has($name)) {
            return .error(.missing($name));
        }

        ShaderRef $entry = $this->shaders[$name];

        if ($entry->files->count() == 0) {
            return .error(.missing($name));
        }

        return $entry->load();
    }

    /**
     * Hot-path lookup. Asserts the program was load()ed.
     */
    public function program(string $name) : ShaderProgram
    {
        assert($this->shaders->has($name), 'shader: program was never loaded');
        return $this->shaders[$name]->program();
    }

    /**
     * Resolve a scanned variant. Creates nothing; missing or manifest-mismatched defines are programmer errors.
     */
    public function definePermutation(string $shader, string $variant, array<Define> $defines = array<Define>()) : ShaderRef
    {
        assert($this->shaders->has($shader), 'shader: permutation base was never scanned');
        ShaderRef $entry = $this->shaders[$shader];
        assert($entry->variants->has($variant), 'shader: permutation was never scanned');
        ShaderRef $held = $entry->variants[$variant];

        if ($this->loader->hasManifest()) {
            array<Define> $expected = guard $this->loader->variantDefines($shader, $variant) else {
                die("shader: variant '{$variant}' of '{$shader}' does not match the manifest");
            }
            assert(definesMatch($defines, $expected), 'shader: stale variant defines');
        }

        $held->defines = $defines;
        return $held;
    }

    public function permutation(string $shader, string $variant) : result<ShaderRef, ShaderError>
    {
        if (!$this->shaders->has($shader)) {
            return .error(.missingPermutation($shader, $variant));
        }

        return $this->shaders[$shader]->permutation($variant);
    }

    public function permutations(string $shader) : array<string>
    {
        if (!$this->shaders->has($shader)) {
            return array<string>();
        }

        ShaderRef $entry = $this->shaders[$shader];
        return $entry->variants->keys();
    }

    public function hasPermutations(string $shader) : bool
    {
        return !$this->permutations($shader)->empty();
    }

    /**
     * Drop the compiled program and every permutation so the next get / permutation recompiles.
     */
    public function forget(string $shader) : void
    {
        if (!$this->shaders->has($shader)) {
            return;
        }

        $this->shaders[$shader]->forget();
    }

    public function load() : status<ShaderError>
    {
        array<string> $names = $this->shaders->keys();

        foreach ($names as $name) {
            ShaderRef $entry = $this->shaders[$name];

            if ($entry->files->count() == 0) {
                continue;
            }

            ShaderProgram $p = guard $entry->load() else ($e) {
                return .error($e);
            }
        }

        return .ok;
    }

    public function loadPermutations(string $shader) : status<ShaderError>
    {
        if (!$this->shaders->has($shader)) {
            return .ok;
        }

        array<string> $names = $this->permutations($shader);

        foreach ($names as $name) {
            ShaderRef $ref = guard $this->permutation($shader, $name) else ($e) {
                return .error($e);
            }
            ShaderProgram $p = guard $ref->load() else ($e) {
                return .error($e);
            }
        }

        return .ok;
    }

    public function destroy() : void
    {
        array<string> $names = $this->shaders->keys();

        foreach ($names as $name) {
            $this->forget($name);
        }
    }

    destructor()
    {
        $this->destroy();
    }

    private function entry(string $name) : ShaderRef
    {
        if (!$this->shaders->has($name)) {
            $this->shaders[$name] = ShaderRef($this, $name);
        }

        return $this->shaders[$name];
    }

    private function collect(string $directory) : status<ShaderError>
    {
        string $root = slashDir($directory);
        map<string, array<ShaderFile>> $programs = map<string, array<ShaderFile>>();
        map<string, map<string, array<ShaderFile>>> $variants = map<string, map<string, array<ShaderFile>>>();
        guard $this->walk($root, $root, shaderSuffix(), $programs, $variants) else ($e) {
            return .error($e);
        }
        array<string> $names = $programs->keys();

        foreach ($names as $name) {
            ShaderRef $entry = $this->entry($name);

            if ($entry->files->count() > 0) {
                continue;
            }

            $entry->files = $programs[$name];
        }

        array<string> $bases = $variants->keys();

        foreach ($bases as $base) {
            ShaderRef $entry = $this->entry($base);
            map<string, array<ShaderFile>> $vars = $variants[$base];
            array<string> $vnames = $vars->keys();

            foreach ($vnames as $vname) {
                if ($entry->variants->has($vname)) {
                    continue;
                }

                ShaderRef $ref = ShaderRef($this, $base, variant: $vname);
                $ref->files = $vars[$vname];
                $entry->variants[$vname] = $ref;
            }
        }

        return .ok;
    }

    private function walk(
        string $dir,
        string $prefix,
        string $ext,
        map<string, array<ShaderFile>>& $programs,
        map<string, map<string, array<ShaderFile>>>& $variants,
    ) : status<ShaderError>
    {
        io::dir $d = guard io::opendir($dir) else ($e) {
            return .error(.scan($dir, $e->message()));
        }
        array<string> $subs = array<string>();

        foreach ($d as $entry) {
            if ($entry->is_directory()) {
                $subs[] = $entry->path();
                continue;
            }

            string $rel = relativeShaderPath($entry->path(), $prefix);
            ShaderStem? $maybe = shaderStem($rel, $ext);
            ShaderStem $stem = guard $maybe else {
                continue;
            }
            string $variant = guard $stem->variant else {
                if (!$programs->has($stem->name)) {
                    $programs[$stem->name] = array<ShaderFile>();
                }

                array<ShaderFile> $files = $programs[$stem->name];
                $files[] = ShaderFile($stem->kind, $entry->path());
                $programs[$stem->name] = $files;
                continue;
            }

            if (!$variants->has($stem->name)) {
                $variants[$stem->name] = map<string, array<ShaderFile>>();
            }

            map<string, array<ShaderFile>>& $bucket = $variants->at($stem->name);

            if (!$bucket->has($variant)) {
                $bucket[$variant] = array<ShaderFile>();
            }

            array<ShaderFile> $vfiles = $bucket[$variant];
            $vfiles[] = ShaderFile($stem->kind, $entry->path());
            $bucket[$variant] = $vfiles;
        }

        io::ioerror? $readErr = $d->error();

        if ($readErr != null) {
            io::ioerror $e = guard $readErr else {
                return .error(.scan($dir, 'unknown'));
            }
            return .error(.scan($dir, $e->message()));
        }

        foreach ($subs as $sub) {
            guard $this->walk($sub, $prefix, $ext, $programs, $variants) else ($e) {
                return .error($e);
            }
        }

        return .ok;
    }

    internal function compileBase(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        ShaderProgram $held = guard $ref->compiled else {
            return $this->build($ref);
        }

        if ($held->destroyed()) {
            return $this->build($ref);
        }

        return .ok($held);
    }

    internal function compileVariant(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        ShaderProgram $held = guard $ref->compiled else {
            return $this->build($ref);
        }

        if ($held->destroyed()) {
            return $this->build($ref);
        }

        return .ok($held);
    }

    private function build(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        if ($ref->files->count() == 0) {
            string $v = guard $ref->variant else {
                return .error(.missing($ref->name));
            }
            return .error(.missingPermutation($ref->name, $v));
        }

        string $vs = '';
        string $fs = '';
        string $tcs = '';
        string $tes = '';

        foreach ($ref->files as $file) {
            string $bytes = guard $this->loader->read($file->path) else ($e) {
                return .error($e);
            }

            if ($file->kind == ShaderKind::vertex) {
                $vs = $bytes;
            } else if ($file->kind == ShaderKind::fragment) {
                $fs = $bytes;
            } else if ($file->kind == ShaderKind::tessControl) {
                $tcs = $bytes;
            } else if ($file->kind == ShaderKind::tessEvaluation) {
                $tes = $bytes;
            } else {
                return .error(.compile("shader '{$ref->name}': unsupported stage"));
            }
        }

        if ($vs->empty() || $fs->empty()) {
            return .error(.missing($ref->name));
        }

        string $linkName = $ref->name;
        string $v = guard $ref->variant else {
            ShaderProgram $program = guard ShaderProgram::link(
                $this->device,
                $linkName,
                $vs,
                $fs,
                tessControl: $tcs,
                tessEvaluation: $tes
            ) else ($e) {
                return .error($e);
            }
            $ref->compiled = $program;
            return .ok($program);
        }
        $linkName = "{$ref->name}+{$v}";
        ShaderProgram $program = guard ShaderProgram::link(
            $this->device,
            $linkName,
            $vs,
            $fs,
            tessControl: $tcs,
            tessEvaluation: $tes
        ) else ($e) {
            return .error($e);
        }
        $ref->compiled = $program;
        return .ok($program);
    }
}

internal function definesMatch(const array<Define>& $got, const array<Define>& $want) : bool
{
    if ($got->count() != $want->count()) {
        return false;
    }

    usize $i = 0;
    usize $n = $got->count();

    while ($i < $n) {
        if ($got[$i]->name != $want[$i]->name || $got[$i]->value != $want[$i]->value) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}
