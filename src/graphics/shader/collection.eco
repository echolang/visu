/**
 * Named shader programs and their permutations. Stores Gpu; get /
 * permutation / load / destroy use the handle. scan walks a directory
 * tree; register names files by hand. ShaderRef is the slot: one
 * object per name (and per variant), held for the process lifetime.
 * forget drops the compiled program, not the ref.
 */

namespace visu::graphics;

use std::io;

public class ShaderCollection
{
    public Gpu $gpu;
    public ShaderLoader $loader;
    private ordered_map<string, string> $globals;
    private map<string, ShaderRef> $shaders;

    public constructor(Gpu $gpu, string $directory)
    {
        $this->gpu = $gpu;
        $this->loader = ShaderLoader($directory);
        $this->globals = ordered_map<string, string>();
        $this->shaders = map<string, ShaderRef>();
    }

    public function enableVisuIncludes() : void
    {
        $this->loader->enableVisuIncludes();
    }

    public function define(string $name, int32 $value) : void
    {
        $this->globals[$name] = "{$value}";
    }

    public function define(string $name, float32 $value) : void
    {
        $this->globals[$name] = "{$value}";
    }

    public function define(string $name, string $value) : void
    {
        $this->globals[$name] = $value;
    }

    public function register(string $name, array<ShaderFile> $files) : result<ShaderRef, ShaderError>
    {
        ShaderRef $entry = $this->entry($name);

        if ($entry->files->count() > 0) {
            return .error(.duplicate($name));
        }

        $entry->files = $files;
        return .ok($entry);
    }

    /**
     * Register every shader program under `$directory` (the collection
     * directory when omitted). Recurses. Name is the relative path with
     * `.vert|.frag|.geo|.tessc|.tesse.{suffix}` stripped. Already-registered
     * names are left alone. Does not compile.
     */
    public function scan(string? $directory = null) : result<bool, ShaderError>
    {
        string $root = guard $directory else {
            return $this->collect($this->loader->directory);
        }

        return $this->collect($root);
    }

    /**
     * Directory lookup. One map hit, then hold the class.
     */
    public function shader(string $name) : result<ShaderRef, ShaderError>
    {
        if (!$this->shaders->has($name)) {
            return .error(.missing($name));
        }

        return .ok($this->shaders[$name]);
    }

    /**
     * Compile if needed and return the program.
     */
    public function load(string $name) : result<ShaderProgram, ShaderError>
    {
        if (!$this->shaders->has($name)) {
            return .error(.missing($name));
        }

        ShaderRef $entry = $this->shaders[$name];

        if ($entry->files->count() == 0) {
            return .error(.missing($name));
        }

        return $entry->load();
    }

    /**
     * Hot-path lookup. Asserts the program was load()ed.
     */
    public function program(string $name) : ShaderProgram
    {
        assert($this->shaders->has($name), 'shader: program was never loaded');
        return $this->shaders[$name]->program();
    }

    public function definePermutation(string $shader, string $variant, array<Define> $defines = array<Define>()) : ShaderRef
    {
        ShaderRef $entry = $this->entry($shader);

        if ($entry->variants->has($variant)) {
            ShaderRef $held = $entry->variants[$variant];
            $held->defines = $defines;
            return $held;
        }

        ShaderRef $ref = ShaderRef($this, $shader, variant: $variant);
        $ref->defines = $defines;
        $entry->variants[$variant] = $ref;
        return $ref;
    }

    public function permutation(string $shader, string $variant) : result<ShaderRef, ShaderError>
    {
        if (!$this->shaders->has($shader)) {
            return .error(.missingPermutation($shader, $variant));
        }

        return $this->shaders[$shader]->permutation($variant);
    }

    public function permutations(string $shader) : array<string>
    {
        if (!$this->shaders->has($shader)) {
            return array<string>();
        }

        ShaderRef $entry = $this->shaders[$shader];
        return $entry->variants->keys();
    }

    public function hasPermutations(string $shader) : bool
    {
        return !$this->permutations($shader)->empty();
    }

    /**
     * Drop the compiled program and every permutation so the next
     * get / permutation recompiles.
     */
    public function forget(string $shader) : void
    {
        if (!$this->shaders->has($shader)) {
            return;
        }

        $this->shaders[$shader]->forget();
    }

    public function load() : result<bool, ShaderError>
    {
        array<string> $names = $this->shaders->keys();

        foreach ($names as $name) {
            ShaderRef $entry = $this->shaders[$name];

            if ($entry->files->count() == 0) {
                continue;
            }

            ShaderProgram $p = guard $entry->load() else ($e) {
                return .error($e);
            }
        }

        return .ok(true);
    }

    public function loadPermutations(string $shader) : result<bool, ShaderError>
    {
        if (!$this->shaders->has($shader)) {
            return .ok(true);
        }

        array<string> $names = $this->permutations($shader);

        foreach ($names as $name) {
            ShaderRef $ref = guard $this->permutation($shader, $name) else ($e) {
                return .error($e);
            }
            ShaderProgram $p = guard $ref->load() else ($e) {
                return .error($e);
            }
        }

        return .ok(true);
    }

    public function destroy() : void
    {
        array<string> $names = $this->shaders->keys();

        foreach ($names as $name) {
            $this->forget($name);
        }
    }

    destructor()
    {
        $this->destroy();
    }

    private function entry(string $name) : ShaderRef
    {
        if (!$this->shaders->has($name)) {
            $this->shaders[$name] = ShaderRef($this, $name);
        }

        return $this->shaders[$name];
    }

    private function collect(string $directory) : result<bool, ShaderError>
    {
        string $root = slashDir($directory);
        map<string, array<ShaderFile>> $programs = map<string, array<ShaderFile>>();
        bool $ok = guard $this->walk($root, $root, shaderSuffix(), $programs) else ($e) {
            return .error($e);
        }
        array<string> $names = $programs->keys();

        foreach ($names as $name) {
            ShaderRef $entry = $this->entry($name);

            if ($entry->files->count() > 0) {
                continue;
            }

            $entry->files = $programs[$name];
        }

        return .ok(true);
    }

    private function walk(
        string $dir,
        string $prefix,
        string $ext,
        map<string, array<ShaderFile>>& $programs,
    ) : result<bool, ShaderError>
    {
        io::dir $d = guard io::opendir($dir) else ($e) {
            return .error(.scan($dir, $e->message()));
        }
        array<string> $subs = array<string>();

        foreach ($d as $entry) {
            if ($entry->is_directory()) {
                $subs[] = $entry->path();
                continue;
            }

            string $rel = relativeShaderPath($entry->path(), $prefix);
            ShaderStem? $maybe = shaderStem($rel, $ext);
            ShaderStem $stem = guard $maybe else {
                continue;
            }

            if (!$programs->has($stem->name)) {
                $programs[$stem->name] = array<ShaderFile>();
            }

            array<ShaderFile> $files = $programs[$stem->name];
            $files[] = ShaderFile($stem->kind, $entry->path());
            $programs[$stem->name] = $files;
        }

        io::ioerror? $readErr = $d->error();

        if ($readErr != null) {
            io::ioerror $e = guard $readErr else {
                return .error(.scan($dir, 'unknown'));
            }
            return .error(.scan($dir, $e->message()));
        }

        foreach ($subs as $sub) {
            bool $ok = guard $this->walk($sub, $prefix, $ext, $programs) else ($e) {
                return .error($e);
            }
        }

        return .ok(true);
    }

    internal function compileBase(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        ShaderProgram $held = guard $ref->compiled else {
            return $this->buildBase($ref);
        }

        if ($held->destroyed()) {
            return $this->buildBase($ref);
        }

        return .ok($held);
    }

    internal function compileVariant(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        ShaderProgram $held = guard $ref->compiled else {
            return $this->buildVariant($ref);
        }

        if ($held->destroyed()) {
            return $this->buildVariant($ref);
        }

        return .ok($held);
    }

    private function buildBase(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        if ($ref->files->count() == 0) {
            return .error(.missing($ref->name));
        }

        ShaderProgram $program = guard $this->build($ref->files, $this->globalDefines(), $ref->name) else ($e) {
            return .error($e);
        }
        $ref->compiled = $program;
        return .ok($program);
    }

    private function buildVariant(ShaderRef $ref) : result<ShaderProgram, ShaderError>
    {
        if (!$this->shaders->has($ref->name)) {
            return .error(.missingBase($ref->name));
        }

        ShaderRef $base = $this->shaders[$ref->name];

        if ($base->files->count() == 0) {
            return .error(.missingBase($ref->name));
        }

        string $v = guard $ref->variant else {
            return .error(.missingBase($ref->name));
        }
        string $key = "{$ref->name}#{$v}";
        ShaderProgram $program = guard $this->build($base->files, $this->mergedDefines($ref->defines), $key) else ($e) {
            return .error($e);
        }
        $ref->compiled = $program;
        return .ok($program);
    }

    private function globalDefines() : array<Define>
    {
        array<Define> $out = array<Define>();
        array<string> $keys = $this->globals->keys();

        foreach ($keys as $k) {
            $out[] = Define($k, $this->globals[$k]);
        }

        return $out;
    }

    private function mergedDefines(array<Define> $variant) : array<Define>
    {
        ordered_map<string, string> $merged = $this->globals->clone();

        foreach ($variant as $d) {
            $merged[$d->name] = $d->value;
        }

        array<Define> $out = array<Define>();
        array<string> $keys = $merged->keys();

        foreach ($keys as $k) {
            $out[] = Define($k, $merged[$k]);
        }

        return $out;
    }

    private function build(array<ShaderFile> $files, array<Define> $defines, string $linkName) : result<ShaderProgram, ShaderError>
    {
        ShaderProgram $program = ShaderProgram($this->gpu);

        foreach ($files as $file) {
            string $src = guard $this->loader->load($file->path, $defines) else ($e) {
                $program->destroy();
                return .error($e);
            }

            ShaderStage $stage = ShaderStage($this->gpu, $file->kind, $src);
            $program->attach($stage);
        }

        bool $ok = guard $program->link($linkName) else ($e) {
            $program->destroy();
            return .error($e);
        }

        return .ok($program);
    }
}
