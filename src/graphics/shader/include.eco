/**
 * Baked VISU GLSL includes. `#include "visu/..."` resolves
 * these first so a compiled app does not need a framework path.
 */

namespace visu::graphics;

internal function registerVisuIncludes(ShaderLoader $loader) : void
{
    $loader->addBuiltin('visu/constants.glsl', visuGlslConstants());
    $loader->addBuiltin('visu/fullscreen_quad.glsl', visuGlslFullscreenQuad());
    $loader->addBuiltin('visu/cubemap_vert.glsl', visuGlslCubemapVert());
    $loader->addBuiltin('visu/gbuffer_layout.glsl', visuGlslGbufferLayout());
    $loader->addBuiltin('visu/gbuffer_uniform.glsl', visuGlslGbufferUniform());
    $loader->addBuiltin('visu/matrix_operations.glsl', visuGlslMatrixOperations());
    $loader->addBuiltin('visu/functions/brdf.glsl', visuGlslBrdf());
    $loader->addBuiltin('visu/functions/gamma_corr.glsl', visuGlslGammaCorr());
    $loader->addBuiltin('visu/functions/importance_sampling.glsl', visuGlslImportanceSampling());
    $loader->addBuiltin('visu/functions/tone_mapping.glsl', visuGlslToneMapping());
    $loader->addBuiltin('visu/pbr/shade.glsl', visuGlslPbrShade());
    $loader->addBuiltin('visu/pbr/surface.glsl', visuGlslPbrSurface());
}
