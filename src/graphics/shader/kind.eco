/**
 * A file that belongs to a program, and a `#define` payload used to check scanned variants against `shaders.manifest`.
 */

namespace visu::graphics;

public struct ShaderFile
{
    public ShaderKind $kind;
    public string $path;
}

public struct Define
{
    public string $name;
    public string $value;

    public constructor(string $name, string $value)
    {
        $this->name = $name;
        $this->value = $value;
    }

    public constructor(string $name, int32 $value)
    {
        $this->name = $name;
        $this->value = "{$value}";
    }

    public constructor(string $name, float32 $value)
    {
        $this->name = $name;
        $this->value = "{$value}";
    }
}
