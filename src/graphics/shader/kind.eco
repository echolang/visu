/**
 * A programmable pipeline stage. Maps onto the GL shader type.
 */

namespace visu::graphics;

public enum ShaderKind
{
    case vertex;
    case fragment;
    case geometry;
    case tessControl;
    case tessEvaluation;
}

public struct ShaderFile
{
    public ShaderKind $kind;
    public string $path;
}

public struct Define
{
    public string $name;
    public string $value;

    public constructor(string $name, string $value)
    {
        $this->name = $name;
        $this->value = $value;
    }

    public constructor(string $name, int32 $value)
    {
        $this->name = $name;
        $this->value = "{$value}";
    }

    public constructor(string $name, float32 $value)
    {
        $this->name = $name;
        $this->value = "{$value}";
    }
}
