/**
 * Load GLSL, inject #define after #version, and expand #include "path".
 * Builtins (baked VISU includes) are tried before files. Include
 * matching is a line walk.
 */

namespace visu::graphics;

use std::io;

public class ShaderLoader
{
    public const string $directory;
    private array<string> $includePaths;
    private map<string, string> $builtins;

    public constructor(string $directory)
    {
        $this->directory = slashDir($directory);
        $this->includePaths = array<string>();
        $this->builtins = map<string, string>();
    }

    public function addInclude(string $path) : void
    {
        $this->includePaths[] = slashDir($path);
    }

    public function addBuiltin(string $name, string $source) : void
    {
        $this->builtins[$name] = $source;
    }

    public function enableVisuIncludes() : void
    {
        registerVisuIncludes($this);
    }

    public function load(string $file, array<Define> $defines = array<Define>()) : result<string, ShaderError>
    {
        string $text = guard $this->readShader($file) else ($e) {
            return .error($e);
        }

        return $this->process($text, $defines);
    }

    public function process(string $source, array<Define> $defines = array<Define>()) : result<string, ShaderError>
    {
        if ($defines->empty()) {
            array<string> $empty = array<string>();
            return $this->expandIncludes($source, $empty);
        }

        string $injected = guard $this->injectDefines($source, $defines) else ($e) {
            return .error($e);
        }
        array<string> $none = array<string>();
        return $this->expandIncludes($injected, $none);
    }

    private function injectDefines(string $source, array<Define> $defines) : result<string, ShaderError>
    {
        usize $ver = $source->find('#version');

        if ($ver == $source->size()) {
            return .error(.missingVersion);
        }

        usize $nl = $source->find("\n", $ver);
        usize $after = $source->size();

        if ($nl != $source->size()) {
            $after = $nl + 1;
        }

        string $out = $source->sub(0, $after);

        if ($nl == $source->size()) {
            $out->append("\n");
        }

        foreach ($defines as $d) {
            $out->append("#define {$d->name} {$d->value}\n");
        }

        if ($after < $source->size()) {
            $out->append($source->sub($after, $source->size() - $after));
        }

        return .ok($out);
    }

    private function expandIncludes(string $source, array<string> $stack) : result<string, ShaderError>
    {
        string $out = '';
        usize $i = 0;
        usize $n = $source->size();

        while ($i < $n) {
            usize $nl = $source->find("\n", $i);
            usize $end = $nl;

            if ($nl == $n) {
                $end = $n;
            }

            string $line = $source->sub($i, $end - $i);
            LineInclude $inc = guard parseIncludeLine($line) else ($e) {
                return .error($e);
            }

            match ($inc) {
                LineInclude::none => {
                    $out->append($line);

                    if ($nl != $n) {
                        $out->append("\n");
                    }
                },
                LineInclude::path($path) => {
                    if ($this->onStack($stack, $path)) {
                        return .error(.includeCycle($path));
                    }

                    string $included = guard $this->findInclude($path) else ($err) {
                        return .error($err);
                    }

                    array<string> $nested = $stack->clone();
                    $nested[] = $path;
                    string $expanded = guard $this->expandIncludes($included, $nested) else ($err) {
                        return .error($err);
                    }

                    $out->append($expanded);
                },
            };

            if ($nl == $n) {
                break;
            }

            $i = $nl + 1;
        }

        return .ok($out);
    }

    private function onStack(const array<string>& $stack, string $path) : bool
    {
        foreach ($stack as $s) {
            if ($s == $path) {
                return true;
            }
        }

        return false;
    }

    private function findInclude(string $path) : result<string, ShaderError>
    {
        if ($this->builtins->has($path)) {
            return .ok($this->builtins[$path]);
        }

        string $fromDir = $this->directory;
        $fromDir->append($path);
        string $here = guard $this->tryRead($fromDir) else {
            return $this->searchPaths($path);
        }

        return .ok($here);
    }

    private function searchPaths(string $path) : result<string, ShaderError>
    {
        foreach ($this->includePaths as $dir) {
            string $candidate = $dir;
            $candidate->append($path);
            string $text = guard $this->tryRead($candidate) else {
                continue;
            }
            return .ok($text);
        }

        return .error(.missingInclude($path));
    }

    private function tryRead(string $path) : result<string, ShaderError>
    {
        string $text = guard io::readfile($path) else {
            return .error(.missingFile($path));
        }

        return .ok($text);
    }

    private function readShader(string $file) : result<string, ShaderError>
    {
        string $fromDir = $this->directory;
        $fromDir->append($file);
        string $text = guard $this->tryRead($fromDir) else {
            return $this->tryRead($file);
        }

        return .ok($text);
    }
}

internal enum LineInclude
{
    case none;
    case path(string $path);
}

internal function parseIncludeLine(string $line) : result<LineInclude, ShaderError>
{
    usize $i = 0;
    usize $n = $line->size();
    uint8 $space = ' '->byte(0);
    uint8 $tab = "\t"->byte(0);

    while ($i < $n) {
        uint8 $b = $line->byte($i);

        if ($b != $space && $b != $tab) {
            break;
        }

        $i = $i + 1;
    }

    string $rest = $line->sub($i, $n - $i);

    if (!$rest->starts('#include')) {
        return .ok(.none);
    }

    usize $at = 8;

    if ($at > $rest->size()) {
        return .ok(.none);
    }

    while ($at < $rest->size()) {
        uint8 $b = $rest->byte($at);

        if ($b != $space && $b != $tab) {
            break;
        }

        $at = $at + 1;
    }

    if ($at >= $rest->size() || $rest->byte($at) != '"'->byte(0)) {
        return .ok(.none);
    }

    $at = $at + 1;
    usize $start = $at;

    while ($at < $rest->size() && $rest->byte($at) != '"'->byte(0)) {
        $at = $at + 1;
    }

    if ($at >= $rest->size()) {
        return .error(.unterminatedInclude);
    }

    return .ok(LineInclude::path($rest->sub($start, $at - $start)));
}

internal function slashDir(string $path) : string
{
    if ($path->empty()) {
        return './';
    }

    if ($path->ends('/') || $path->ends('\\')) {
        return $path;
    }

    string $out = $path;
    $out->append('/');
    return $out;
}
