/**
 * File reader plus optional `shaders.manifest` parser. Offline compile owns variants; this never preprocesses text.
 */

namespace visu::graphics;

use std::io;
use visu::app::slashDir;

public class ShaderLoader
{
    public const string $directory;
    private map<string, array<Define>> $manifest;

    public constructor(string $directory)
    {
        $this->directory = slashDir($directory);
        $this->manifest = map<string, array<Define>>();
        $this->loadManifest();
    }

    public function read(string $file) : result<string, ShaderError>
    {
        string $fromDir = $this->directory;
        $fromDir->append($file);
        string $here = guard io::readfile($fromDir) else {
            return $this->readAbs($file);
        }
        return .ok($here);
    }

    public function variantDefines(string $shader, string $variant) : array<Define>?
    {
        string $key = "{$shader}+{$variant}";

        if (!$this->manifest->has($key)) {
            return null;
        }

        return $this->manifest[$key];
    }

    public const function hasManifest() : bool
    {
        return !$this->manifest->empty();
    }

    private function readAbs(string $file) : result<string, ShaderError>
    {
        string $text = guard io::readfile($file) else {
            return .error(.missingFile($file));
        }
        return .ok($text);
    }

    private function loadManifest() : void
    {
        string $path = $this->directory;
        $path->append('shaders.manifest');
        string $text = guard io::readfile($path) else {
            return;
        }
        $this->parseManifest($text);
    }

    private function parseManifest(string $text) : void
    {
        usize $i = 0;
        usize $n = $text->size();

        while ($i < $n) {
            usize $nl = $text->find("\n", $i);
            usize $end = $nl;

            if ($nl == $n) {
                $end = $n;
            }

            string $line = $text->sub($i, $end - $i);
            $this->parseManifestLine($line);

            if ($nl == $n) {
                break;
            }

            $i = $nl + 1;
        }
    }

    private function parseManifestLine(string $line) : void
    {
        string $trim = str::trim($line);

        if ($trim->empty() || $trim->starts('#')) {
            return;
        }

        usize $sp = $trim->find(' ');
        string $stem = $trim;
        string $rest = '';

        if ($sp != $trim->size()) {
            $stem = $trim->sub(0, $sp);
            $rest = str::trim($trim->sub($sp + 1, $trim->size() - $sp - 1));
        }

        usize $plus = $stem->find('+');

        if ($plus == $stem->size()) {
            return;
        }

        array<Define> $defs = array<Define>();

        if (!$rest->empty()) {
            $defs = parseDefines($rest);
        }

        $this->manifest[$stem] = $defs;
    }
}

internal struct ShaderStem
{
    public ShaderKind $kind;
    public string $name;
    public string? $variant;
}

internal function relativeShaderPath(string $path, string $prefix) : string
{
    if (!$path->starts($prefix)) {
        return slashName($path);
    }

    usize $len = $path->size() - $prefix->size();
    return slashName($path->sub($prefix->size(), $len));
}

internal function slashName(string $name) : string
{
    if (!$name->contains("\\")) {
        return $name;
    }

    string $out = '';
    usize $i = 0;
    usize $n = $name->size();

    while ($i < $n) {
        uint8 $b = $name->byte($i);

        if ($b == 0x5C) {
            $out->push(0x2F);
        } else {
            $out->push($b);
        }

        $i = $i + 1;
    }

    return $out;
}

internal function matchStage(string $relative, string $suffix, ShaderKind $kind) : ShaderStem?
{
    if (!$relative->ends($suffix)) {
        return null;
    }

    usize $n = $relative->size() - $suffix->size();

    if ($n == 0) {
        return null;
    }

    string $stem = slashName($relative->sub(0, $n));
    usize $plus = $stem->find('+');

    if ($plus == $stem->size()) {
        return ShaderStem($kind, $stem, null);
    }

    if ($plus == 0 || $plus + 1 >= $stem->size()) {
        return null;
    }

    return ShaderStem($kind, $stem->sub(0, $plus), $stem->sub($plus + 1, $stem->size() - $plus - 1));
}

internal function shaderStem(string $relative, string $ext) : ShaderStem?
{
    ShaderStem? $tessc = matchStage($relative, ".tessc.{$ext}", .tessControl);

    if ($tessc != null) {
        return $tessc;
    }

    ShaderStem? $tesse = matchStage($relative, ".tesse.{$ext}", .tessEvaluation);

    if ($tesse != null) {
        return $tesse;
    }

    ShaderStem? $vert = matchStage($relative, ".vert.{$ext}", .vertex);

    if ($vert != null) {
        return $vert;
    }

    ShaderStem? $frag = matchStage($relative, ".frag.{$ext}", .fragment);

    if ($frag != null) {
        return $frag;
    }

    ShaderStem? $geo = matchStage($relative, ".geo.{$ext}", .geometry);

    if ($geo != null) {
        return $geo;
    }

    return null;
}

internal function parseDefines(string $rest) : array<Define>
{
    array<Define> $out = array<Define>();
    usize $i = 0;
    usize $n = $rest->size();
    uint8 $space = ' '->byte(0);
    uint8 $tab = "\t"->byte(0);

    while ($i < $n) {
        while ($i < $n) {
            uint8 $b = $rest->byte($i);

            if ($b != $space && $b != $tab) {
                break;
            }

            $i = $i + 1;
        }

        if ($i >= $n) {
            break;
        }

        usize $start = $i;

        while ($i < $n) {
            uint8 $b = $rest->byte($i);

            if ($b == $space || $b == $tab) {
                break;
            }

            $i = $i + 1;
        }

        string $tok = $rest->sub($start, $i - $start);
        usize $eq = $tok->find('=');

        if ($eq == $tok->size()) {
            $out[] = Define($tok, '1');
        } else {
            $out[] = Define($tok->sub(0, $eq), $tok->sub($eq + 1, $tok->size() - $eq - 1));
        }
    }

    return $out;
}
