/**
 * Failures loading, compiling, or linking a shader.
 */

namespace visu::graphics;

public enum ShaderError
{
    case missingFile(string $path);
    case missingVersion;
    case missingInclude(string $path);
    case unterminatedInclude;
    case includeCycle(string $path);
    case compile(string $log);
    case link(string $name, string $log);
    case duplicate(string $name);
    case missing(string $name);
    case missingBase(string $name);
    case missingPermutation(string $shader, string $name);

    public const function message() : string
    {
        return match ($this) {
            ShaderError::missingFile($path) => "shader: could not find '{$path}'",
            ShaderError::missingVersion => 'shader: no #version directive',
            ShaderError::missingInclude($path) => "shader: could not find include '{$path}'",
            ShaderError::unterminatedInclude => 'shader: unterminated #include',
            ShaderError::includeCycle($path) => "shader: include cycle at '{$path}'",
            ShaderError::compile($log) => "shader: compile failed: {$log}",
            ShaderError::link($name, $log) => "shader: link failed ('{$name}'): {$log}",
            ShaderError::duplicate($name) => "shader: program '{$name}' already exists",
            ShaderError::missing($name) => "shader: program '{$name}' does not exist and is not registered",
            ShaderError::missingBase($name) => "shader: base shader '{$name}' does not exist and is not registered",
            ShaderError::missingPermutation($shader, $name) => "shader: permutation '{$name}' not defined for '{$shader}'",
        };
    }
}
