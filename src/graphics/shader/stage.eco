/**
 * One compiled shader object (vertex, fragment, …). Construct
 * allocates a GPU name. After attach, ShaderProgram.destroy takes
 * the stages with it.
 */

namespace visu::graphics;

public class ShaderStage : GpuObject
{
    public Gpu $gpu;
    public const uint32 $id;
    public const ShaderKind $kind;
    private bool $dead;
    private bool $compiled;

    public constructor(Gpu $gpu, ShaderKind $kind, string $source = '')
    {
        $this->gpu = $gpu;
        $this->id = $gpu->createShader($kind);
        $this->kind = $kind;
        $this->dead = false;
        $this->compiled = false;

        if (!$source->empty()) {
            $gpu->shaderSource($this->id, $source);
        }
    }

    destructor()
    {
        $this->destroy();
    }

    public function source(string $source) : void
    {
        $this->gpu->shaderSource($this->id, $source);
        $this->compiled = false;
    }

    public const function compiled() : bool
    {
        return $this->compiled;
    }

    public function compile() : status<ShaderError>
    {
        $this->gpu->compileShader($this->id);

        if (!$this->gpu->shaderCompiled($this->id)) {
            $this->compiled = false;
            return .error(.compile($this->gpu->shaderInfoLog($this->id)));
        }

        $this->compiled = true;
        return .ok;
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        if (!$this->gpu->lost()) {
            $this->gpu->deleteShader($this->id);
        }

        $this->dead = true;
        $this->compiled = false;
    }
}
