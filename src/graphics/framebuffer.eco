/**
 * One framebuffer type: the window backbuffer (id 0, not owned) or a
 * generated offscreen FBO (owned). The backbuffer is the default
 * framebuffer, the one used when no other framebuffer is bound.
 *
 * Stores Gpu when constructed with one. The no-arg constructor is a
 * placeholder (window, before initialize; graph tests).
 */

namespace visu::graphics;

use visu::math::Vec4;

internal struct RboAttach
{
    public uint32 $id;
    public PixelFormat $format;
    public int32 $width;
    public int32 $height;
}

public class Framebuffer : GpuObject
{
    /**
     * GPU framebuffer name. 0 is the window backbuffer.
     */
    public const uint32 $id;

    /**
     * True when this object created the GL name and must delete it.
     */
    public const bool $owned;

    private Gpu? $device;
    private bool $dead;
    private map<Attachment, RboAttach> $rbos;

    /**
     * The window backbuffer (id 0). Placeholder until a Gpu is known.
     */
    public constructor()
    {
        $this->id = 0;
        $this->owned = false;
        $this->device = null;
        $this->dead = true;
        $this->rbos = map<Attachment, RboAttach>();
    }

    /**
     * Window backbuffer with a Gpu so bind / clear work.
     */
    public constructor(backbuffer: Gpu $gpu)
    {
        $this->id = 0;
        $this->owned = false;
        $this->device = $gpu;
        $this->dead = false;
        $this->rbos = map<Attachment, RboAttach>();
    }

    /**
     * Creates a new framebuffer object.
     */
    public constructor(Gpu $gpu)
    {
        $this->id = $gpu->createFramebuffer();
        $this->owned = true;
        $this->device = $gpu;
        $this->dead = false;
        $this->rbos = map<Attachment, RboAttach>();
    }

    destructor()
    {
        $this->destroy();
    }

    public function gpu() : Gpu
    {
        Gpu $gpu = guard $this->device;
        return $gpu;
    }

    /**
     * Deletes the GL name and renderbuffer attachments.
     * No-op for the backbuffer, and for an already-destroyed object.
     */
    public function destroy() : void
    {
        if (!$this->owned || $this->dead) {
            return;
        }

        Gpu $gpu = $this->gpu();

        if (!$gpu->lost()) {
            $gpu->unbindFramebuffer($this->id);
            array<RboAttach> $rbos = $this->rbos->values();

            foreach ($rbos as $rbo) {
                $gpu->deleteRenderbuffer($rbo->id);
            }

            $gpu->deleteFramebuffer($this->id);
        }

        $this->rbos->clear();
        $this->dead = true;
    }

    /**
     * Binds the framebuffer to the current context.
     *
     * `$target` specifies the target to which the framebuffer is bound.
     * Returns true if the framebuffer was bound, false if it was already bound.
     */
    public function bind(FramebufferTarget $target) : bool
    {
        return $this->gpu()->bindFramebuffer($target, $this->id);
    }

    /**
     * Clears the framebuffer.
     * Note: this will bind the framebuffer to the current context.
     */
    public function clear(uint32 $mask, Vec4 $color) : void
    {
        Gpu $gpu = $this->gpu();
        $this->bind(.readDraw);
        $gpu->clearColor($color->x, $color->y, $color->z, $color->w);
        $gpu->clear($mask);
    }

    /**
     * Clears color, depth, and stencil.
     * Note: this will bind the framebuffer to the current context.
     */
    public function clear(Vec4 $color) : void
    {
        $this->clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT | STENCIL_BUFFER_BIT, $color);
    }

    /**
     * Returns the current framebuffer status.
     * Note: this will bind the framebuffer to the current context.
     *
     * Status can be one of:
     * - complete
     * - undefined
     * - incompleteAttachment
     * - incompleteMissingAttachment
     * - incompleteDrawBuffer
     * - incompleteReadBuffer
     * - unsupported
     * - incompleteMultisample
     * - incompleteLayerTargets
     * - unknown
     */
    public function status() : FramebufferStatus
    {
        $this->bind(.readDraw);
        return $this->gpu()->framebufferStatus();
    }

    /**
     * Performs a status check on the framebuffer.
     * `.ok(true)` when complete; `.error($status)` otherwise.
     */
    public function valid() : result<bool, FramebufferStatus>
    {
        FramebufferStatus $s = $this->status();

        match ($s) {
            FramebufferStatus::complete => {
                return .ok(true);
            },
            else => {
                return .error($s);
            },
        };
    }

    /**
     * Creates a renderbuffer attachment.
     * Replaces an existing renderbuffer on the same attachment point.
     */
    public function attachRenderbuffer(Attachment $point, PixelFormat $format, int32 $width, int32 $height) : void
    {
        Gpu $gpu = $this->gpu();
        $this->bind(.readDraw);
        $this->dropRbo($point);

        uint32 $rbo = $gpu->createRenderbuffer();
        $gpu->bindRenderbuffer($rbo);
        $gpu->renderbufferStorage($format, $width, $height);
        $gpu->framebufferRenderbuffer($point, $rbo);
        $this->rbos[$point] = RboAttach($rbo, $format, $width, $height);
    }

    /**
     * Attaches an existing texture to the framebuffer.
     */
    public function attachTexture(Attachment $point, TextureTarget $target, uint32 $texture, int32 $level) : void
    {
        $this->bind(.readDraw);
        $this->dropRbo($point);
        $this->gpu()->framebufferTexture2D($point, $target, $texture, $level);
    }

    /**
     * Resizes the framebuffer's renderbuffer attachments.
     * Texture attachments are left as-is.
     */
    public function resize(int32 $width, int32 $height) : void
    {
        Gpu $gpu = $this->gpu();
        $this->bind(.readDraw);
        array<Attachment> $points = $this->rbos->keys();

        foreach ($points as $point) {
            RboAttach $rbo = $this->rbos[$point];
            $gpu->bindRenderbuffer($rbo->id);
            $gpu->renderbufferStorage($rbo->format, $width, $height);
            $this->rbos[$point] = RboAttach($rbo->id, $rbo->format, $width, $height);
        }
    }

    private function dropRbo(Attachment $point) : void
    {
        if (!$this->rbos->has($point)) {
            return;
        }

        RboAttach $old = $this->rbos[$point];
        Gpu $gpu = $this->gpu();

        if (!$gpu->lost()) {
            $gpu->deleteRenderbuffer($old->id);
        }

        $this->rbos->remove($point);
    }
}
