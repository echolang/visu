/**
 * Every model's arena form in storage buffers the GPU-driven views read by index: vertex words,
 * the meshlet detail (each meshlet's vertex list, the word offset of each of its vertices, then
 * its packed triangles, one buffer so a pulling program binds one), the meshlet records, and the
 * material runs every LOD level is cut into. The `ModelBank` owns
 * one and adds a model when it loads or adopts it, so nothing here runs in a frame that did not
 * load something. A CPU mirror keeps every word, so growing a buffer is one fresh buffer and one
 * upload at that load step; a removed model's ranges wait out the frames in flight (a frame
 * still on the GPU reads them), then go back on a free list that merges neighbours, so a road
 * rebuilt many times does not fragment it and a fresh model never overwrites words a frame in
 * flight draws. The buffers a frame in flight read are released by the device once no frame
 * reads them.
 */

namespace visu::graphics;

use visu::math::Vec4;

/**
 * Meshlet flag: the model is skinned, so its vertices carry joints and weights and its bind
 * pose bounds say nothing about where the posed triangles are.
 */
public const uint32 SCENE_MESHLET_SKINNED = 1;

/**
 * Bucket of a meshlet whose material casts no shadow: every depth view skips it.
 */
public const uint32 SCENE_BUCKET_NONE = 0xFFFFFFFF;

/**
 * One meshlet as the kernels and the pulling programs read it, 64 bytes (std430 `vec4, vec4,
 * uvec4, uvec4`). `sphere` is the model-space centre and radius, `cone` the normal cone (axis,
 * sine cutoff, `MESHLET_CONE_OPEN` never culls); `range` its first vertex-list entry and its
 * first triangle word (both in the detail buffer), its triangles and flags; `material` its
 * shadow bucket, material index, G-buffer class and vertex count.
 */
public struct SceneMeshletGpu
{
    public Vec4 $sphere;
    public Vec4 $cone;
    public uint32 $firstVertex;
    public uint32 $firstTriangle;
    public uint32 $triangles;
    public uint32 $flags;
    public uint32 $bucket;
    public uint32 $material;
    public uint32 $gclass;
    public uint32 $vertices;
}

/**
 * One material run (std430 `uvec4`): consecutive meshlets of one LOD level that share their
 * G-buffer class and their shadow bucket, so one (instance, view) pair walks one run and every
 * item it keeps lands in one draw segment.
 */
public struct SceneRunGpu
{
    public uint32 $firstMeshlet;
    public uint32 $meshlets;
    public uint32 $gclass;
    public uint32 $bucket;
}

/**
 * What the bank knows about one material slot of a model when the arena takes it: the shadow
 * bucket, the material's dense index, its G-buffer class and whether it draws both faces (which
 * turns the meshlet cone off).
 */
public struct ArenaSlot
{
    public uint32 $bucket;
    public int32 $material;
    public int32 $gclass;
    public bool $doubleSided;
}

/**
 * Where one model sits in the arena. Level `l` is runs `lodRun[l] .. lodRun[l + 1]`, global run
 * indices.
 */
public struct ArenaModel
{
    public int32 $firstWord;
    public int32 $words;
    public int32 $firstDetail;
    public int32 $details;
    public int32 $firstMeshlet;
    public int32 $meshlets;
    public int32 $firstRun;
    public int32 $runs;
    public int32 $stride;
    public bool $skinned;
    public array<int32> $lodRun;
}

public class MeshArena
{
    private Device $device;
    private array<uint32> $words;
    private array<uint32> $detail;
    private array<SceneMeshletGpu> $meshlets;
    private array<SceneRunGpu> $runs;
    private ArenaRanges $wordRanges;
    private ArenaRanges $detailRanges;
    private ArenaRanges $meshletRanges;
    private ArenaRanges $runRanges;
    private Buffer? $wordBuffer;
    private Buffer? $detailBuffer;
    private Buffer? $meshletBuffer;
    private Buffer? $runBuffer;

    public constructor(Device $device)
    {
        $this->device = $device;
        $this->words = array<uint32>();
        $this->detail = array<uint32>();
        $this->meshlets = array<SceneMeshletGpu>();
        $this->runs = array<SceneRunGpu>();
        $this->wordRanges = ArenaRanges();
        $this->detailRanges = ArenaRanges();
        $this->meshletRanges = ArenaRanges();
        $this->runRanges = ArenaRanges();
        $this->wordBuffer = null;
        $this->detailBuffer = null;
        $this->meshletBuffer = null;
        $this->runBuffer = null;
    }

    /**
     * Copy `$form` in and upload it. `$slots` describes each material slot. Within each level the
     * meshlets are ordered by (class, bucket, slot), keeping their order otherwise, and cut into
     * runs where class or bucket changes.
     */
    public function add(const ModelForm& $form, const array<ArenaSlot>& $slots, bool $skinned) : ArenaModel
    {
        uint64 $now = $this->device->frameIndex();
        $this->wordRanges->reclaim($now);
        $this->detailRanges->reclaim($now);
        $this->meshletRanges->reclaim($now);
        $this->runRanges->reclaim($now);
        int32 $wordCount = $form->words->count() as int32;
        int32 $vertexCount = $form->vertexList->count() as int32;
        int32 $triangleCount = $form->triangles->count() as int32;
        int32 $detailCount = $vertexCount + $triangleCount;
        int32 $meshletCount = $form->meshlets->count() as int32;
        array<int32> $order = arenaOrder($form, $slots);
        int32 $runCount = arenaRunCount($form, $slots, $order);
        int32 $firstWord = $this->wordRanges->take($wordCount);
        int32 $firstDetail = $this->detailRanges->take($detailCount);
        int32 $firstVertex = $firstDetail;
        int32 $firstTriangle = $firstDetail + $vertexCount;
        int32 $firstMeshlet = $this->meshletRanges->take($meshletCount);
        int32 $firstRun = $this->runRanges->take($runCount);
        arenaFit<uint32>($this->words, $this->wordRanges->top, 0 as uint32);
        arenaFit<uint32>($this->detail, $this->detailRanges->top, 0 as uint32);
        arenaFit<SceneMeshletGpu>($this->meshlets, $this->meshletRanges->top, arenaEmptyMeshlet());
        arenaFit<SceneRunGpu>($this->runs, $this->runRanges->top, SceneRunGpu(0, 0, 0, SCENE_BUCKET_NONE));

        int32 $i = 0;
        while ($i < $wordCount) {
            $this->words[($firstWord + $i) as usize] = $form->words[$i as usize];
            $i = $i + 1;
        }

        uint32 $stride = $form->stride as uint32;
        $i = 0;
        while ($i < $vertexCount) {
            $this->detail[($firstVertex + $i) as usize] = ($firstWord as uint32) + $form->vertexList[$i as usize] * $stride;
            $i = $i + 1;
        }

        $i = 0;
        while ($i < $triangleCount) {
            $this->detail[($firstTriangle + $i) as usize] = $form->triangles[$i as usize];
            $i = $i + 1;
        }

        uint32 $flags = 0;
        if ($skinned) {
            $flags = SCENE_MESHLET_SKINNED;
        }

        // meshlets in run order; each run its first meshlet, count and keys
        array<int32> $lodRun = array<int32>();
        int32 $run = $firstRun;
        int32 $level = 0;
        int32 $levels = ($form->lodStart->count() as int32) - 1;
        while ($level < $levels) {
            $lodRun[] = $run;
            int32 $start = $form->lodStart[$level as usize];
            int32 $end = $form->lodStart[($level + 1) as usize];
            int32 $k = $start;
            while ($k < $end) {
                FormMeshlet $m = $form->meshlets[$order[$k as usize] as usize];
                ArenaSlot $slot = arenaSlotOf($slots, $m->slot);
                float32 $cutoff = $m->cutoff;
                if ($slot->doubleSided) {
                    $cutoff = MESHLET_CONE_OPEN;
                }

                $this->meshlets[($firstMeshlet + $k) as usize] = SceneMeshletGpu(
                    $sphere: Vec4($m->center->x, $m->center->y, $m->center->z, $m->radius),
                    $cone: Vec4($m->axis->x, $m->axis->y, $m->axis->z, $cutoff),
                    $firstVertex: ($firstVertex + $m->firstVertex) as uint32,
                    $firstTriangle: ($firstTriangle + $m->firstTriangle) as uint32,
                    $triangles: $m->triangles as uint32,
                    $flags: $flags,
                    $bucket: $slot->bucket,
                    $material: $slot->material as uint32,
                    $gclass: $slot->gclass as uint32,
                    $vertices: $m->vertices as uint32
                );
                bool $opens = $k == $start;
                if (!$opens) {
                    FormMeshlet $prev = $form->meshlets[$order[($k - 1) as usize] as usize];
                    ArenaSlot $was = arenaSlotOf($slots, $prev->slot);
                    $opens = $was->gclass != $slot->gclass || $was->bucket != $slot->bucket;
                }

                if ($opens) {
                    $this->runs[$run as usize] = SceneRunGpu(($firstMeshlet + $k) as uint32, 0, $slot->gclass as uint32, $slot->bucket);
                    $run = $run + 1;
                }

                SceneRunGpu& $open = $this->runs->at(($run - 1) as usize);
                $open->meshlets = $open->meshlets + 1;
                $k = $k + 1;
            }

            $level = $level + 1;
        }

        $lodRun[] = $run;
        $this->sync();
        arenaUpload<uint32>($this->wordBuffer, $this->words, $firstWord, $wordCount);
        arenaUpload<uint32>($this->detailBuffer, $this->detail, $firstDetail, $detailCount);
        arenaUpload<SceneMeshletGpu>($this->meshletBuffer, $this->meshlets, $firstMeshlet, $meshletCount);
        arenaUpload<SceneRunGpu>($this->runBuffer, $this->runs, $firstRun, $runCount);
        return ArenaModel(
            $firstWord: $firstWord,
            $words: $wordCount,
            $firstDetail: $firstDetail,
            $details: $detailCount,
            $firstMeshlet: $firstMeshlet,
            $meshlets: $meshletCount,
            $firstRun: $firstRun,
            $runs: $runCount,
            $stride: $form->stride,
            $skinned: $skinned,
            $lodRun: $lodRun
        );
    }

    /**
     * Give a model's ranges back once no frame in flight reads them. Its words stay until
     * something reuses them; no view points at them once the model has no users, but the frames
     * already submitted were recorded against them, so a range freed in frame `F` is reused from
     * frame `F + FRAMES_IN_FLIGHT + 1` on.
     */
    public function remove(const ArenaModel& $model) : void
    {
        uint64 $frame = $this->device->frameIndex();
        $this->wordRanges->retire($model->firstWord, $model->words, $frame);
        $this->detailRanges->retire($model->firstDetail, $model->details, $frame);
        $this->meshletRanges->retire($model->firstMeshlet, $model->meshlets, $frame);
        $this->runRanges->retire($model->firstRun, $model->runs, $frame);
    }

    /**
     * Forget every model and free the buffers. The bank calls this when it drops its models.
     */
    public function clear() : void
    {
        $this->words->clear();
        $this->detail->clear();
        $this->meshlets->clear();
        $this->runs->clear();
        $this->wordRanges = ArenaRanges();
        $this->detailRanges = ArenaRanges();
        $this->meshletRanges = ArenaRanges();
        $this->runRanges = ArenaRanges();
        $this->wordBuffer = dropBuffer($this->wordBuffer);
        $this->detailBuffer = dropBuffer($this->detailBuffer);
        $this->meshletBuffer = dropBuffer($this->meshletBuffer);
        $this->runBuffer = dropBuffer($this->runBuffer);
    }

    public const function empty() : bool
    {
        return $this->wordBuffer == null;
    }

    /**
     * Words, vertex list, triangles, meshlets and runs held, for the `scene` verb.
     */
    public const function bytes() : int64
    {
        int64 $words = ($this->wordRanges->top + $this->detailRanges->top) as int64;
        int64 $meshlets = ($this->meshletRanges->top as int64) * (mem::size<SceneMeshletGpu>() as int64);
        int64 $runs = ($this->runRanges->top as int64) * (mem::size<SceneRunGpu>() as int64);
        return $words * 4 + $meshlets + $runs;
    }

    public const function meshletCount() : int32
    {
        return $this->meshletRanges->top;
    }

    /**
     * The vertex words. Only valid when not `empty`; so for every buffer below.
     */
    public function vertices() : Buffer
    {
        return arenaHeld($this->wordBuffer);
    }

    /**
     * Every meshlet's vertex list and packed triangles.
     */
    public function detailBuffer() : Buffer
    {
        return arenaHeld($this->detailBuffer);
    }

    public function meshletBuffer() : Buffer
    {
        return arenaHeld($this->meshletBuffer);
    }

    public function runBuffer() : Buffer
    {
        return arenaHeld($this->runBuffer);
    }

    /**
     * Replace every buffer whose range outgrew it with one sized to its capacity, filled from
     * the mirror.
     */
    private function sync() : void
    {
        $this->wordBuffer = arenaFitBuffer<uint32>($this->device, $this->wordBuffer, $this->words, $this->wordRanges, 'arena.words');
        $this->detailBuffer = arenaFitBuffer<uint32>($this->device, $this->detailBuffer, $this->detail, $this->detailRanges, 'arena.detail');
        $this->meshletBuffer = arenaFitBuffer<SceneMeshletGpu>($this->device, $this->meshletBuffer, $this->meshlets, $this->meshletRanges, 'arena.meshlets');
        $this->runBuffer = arenaFitBuffer<SceneRunGpu>($this->device, $this->runBuffer, $this->runs, $this->runRanges, 'arena.runs');
    }
}

/**
 * `$have`, or a fresh buffer sized to `$ranges`' capacity filled from `$mirror` when it outgrew it.
 */
internal function arenaFitBuffer<T>(Device $device, Buffer? $have, const array<T>& $mirror, ArenaRanges $ranges, string $label) : Buffer?
{
    int64 $bytes = ($ranges->capacity as int64) * (mem::size<T>() as int64);
    if (!arenaNeeds($have, $bytes)) {
        return $have;
    }

    Buffer? $fresh = arenaBuffer($device, $have, $bytes, $label);
    arenaUpload<T>($fresh, $mirror, 0, $ranges->top);
    return $fresh;
}

/**
 * Upload `$count` mirror entries from `$first` into the same place of `$into`.
 */
internal function arenaUpload<T>(Buffer? $into, const array<T>& $mirror, int32 $first, int32 $count) : void
{
    Buffer $b = guard $into else {
        return;
    }
    if ($count <= 0) {
        return;
    }

    uint64 $size = mem::size<T>() as uint64;
    ptr<const T> $src = ptr<const T>(&$mirror[$first as usize]);
    $b->upload(ptr<const uint8>($src:$), ($count as uint64) * $size, ($first as uint64) * $size);
}

/**
 * First-fit ranges over one arena buffer, in elements. `top` is the high-water mark the mirror
 * spans, `capacity` what the GPU buffer holds; a take past it doubles the capacity. Free ranges
 * stay sorted by start and a range given back merges with the free ones it touches.
 */
internal class ArenaRanges
{
    public int32 $top;
    public int32 $capacity;
    private array<int32> $freeStart;
    private array<int32> $freeCount;

    /**
     * Ranges given back while frames in flight may still read them, and the frame each was
     * given back in. `reclaim` moves them to the free list once those frames are done.
     */
    private array<int32> $retiredStart;
    private array<int32> $retiredCount;
    private array<uint64> $retiredFrame;

    public constructor()
    {
        $this->top = 0;
        $this->capacity = 0;
        $this->freeStart = array<int32>();
        $this->freeCount = array<int32>();
        $this->retiredStart = array<int32>();
        $this->retiredCount = array<int32>();
        $this->retiredFrame = array<uint64>();
    }

    /**
     * Give `$n` back from `$start` as of frame `$frame`: free once every frame up to it has
     * finished on the GPU (`reclaim`).
     */
    public function retire(int32 $start, int32 $n, uint64 $frame) : void
    {
        if ($n <= 0) {
            return;
        }

        $this->retiredStart->push($start);
        $this->retiredCount->push($n);
        $this->retiredFrame->push($frame);
    }

    /**
     * Free every retired range no frame in flight can read at frame `$now`. A frame waits for
     * the one `FRAMES_IN_FLIGHT` before it, so a range retired in frame `F` is safe from
     * `F + FRAMES_IN_FLIGHT + 1`.
     */
    public function reclaim(uint64 $now) : void
    {
        usize $i = 0;
        while ($i < $this->retiredFrame->count()) {
            if ($now <= $this->retiredFrame[$i] + (FRAMES_IN_FLIGHT as uint64)) {
                $i = $i + 1;
                continue;
            }

            $this->give($this->retiredStart[$i], $this->retiredCount[$i]);
            $this->retiredStart->remove($i);
            $this->retiredCount->remove($i);
            $this->retiredFrame->remove($i);
        }
    }

    /**
     * Ranges still waiting out the frames in flight, for tests.
     */
    public const function retiredRanges() : int32
    {
        return $this->retiredStart->count() as int32;
    }

    public function take(int32 $n) : int32
    {
        if ($n <= 0) {
            return $this->top;
        }

        usize $i = 0;
        while ($i < $this->freeStart->count()) {
            if ($this->freeCount[$i] >= $n) {
                int32 $start = $this->freeStart[$i];
                $this->freeStart[$i] = $start + $n;
                $this->freeCount[$i] = $this->freeCount[$i] - $n;
                if ($this->freeCount[$i] == 0) {
                    $this->freeStart->remove($i);
                    $this->freeCount->remove($i);
                }

                return $start;
            }

            $i = $i + 1;
        }

        int32 $start = $this->top;
        $this->top = $this->top + $n;
        if ($this->top > $this->capacity) {
            int32 $grown = $this->capacity * 2;
            if ($grown < 4096) {
                $grown = 4096;
            }

            while ($grown < $this->top) {
                $grown = $grown * 2;
            }

            $this->capacity = $grown;
        }

        return $start;
    }

    public function give(int32 $start, int32 $n) : void
    {
        if ($n <= 0) {
            return;
        }

        // the first free range past `$start`
        usize $at = 0;
        usize $count = $this->freeStart->count();
        while ($at < $count && $this->freeStart[$at] < $start) {
            $at = $at + 1;
        }

        bool $joinsLeft = $at > 0 && $this->freeStart[$at - 1] + $this->freeCount[$at - 1] == $start;
        bool $joinsRight = $at < $count && $start + $n == $this->freeStart[$at];
        if ($joinsLeft && $joinsRight) {
            $this->freeCount[$at - 1] = $this->freeCount[$at - 1] + $n + $this->freeCount[$at];
            $this->freeStart->remove($at);
            $this->freeCount->remove($at);
        } else if ($joinsLeft) {
            $this->freeCount[$at - 1] = $this->freeCount[$at - 1] + $n;
        } else if ($joinsRight) {
            $this->freeStart[$at] = $start;
            $this->freeCount[$at] = $this->freeCount[$at] + $n;
        } else {
            arenaInsert($this->freeStart, $at, $start);
            arenaInsert($this->freeCount, $at, $n);
        }
    }

    /**
     * Free ranges, for tests: a give that touches a neighbour leaves one range.
     */
    public const function freeRanges() : int32
    {
        return $this->freeStart->count() as int32;
    }
}

/**
 * The meshlet order of `$form`: level by level, by (class, bucket, slot), the build order kept
 * among equals. Insertion sort per level; levels hold tens to hundreds of meshlets.
 */
internal function arenaOrder(const ModelForm& $form, const array<ArenaSlot>& $slots) : array<int32>
{
    array<int32> $order = array<int32>();
    $order->reserve($form->meshlets->count());
    int32 $levels = ($form->lodStart->count() as int32) - 1;
    int32 $level = 0;
    while ($level < $levels) {
        int32 $start = $form->lodStart[$level as usize];
        int32 $end = $form->lodStart[($level + 1) as usize];
        int32 $k = $start;
        while ($k < $end) {
            $order[] = $k;
            int32 $j = $k;
            while ($j > $start && arenaKey($form, $slots, $order[($j - 1) as usize]) > arenaKey($form, $slots, $order[$j as usize])) {
                int32 $swap = $order[($j - 1) as usize];
                $order[($j - 1) as usize] = $order[$j as usize];
                $order[$j as usize] = $swap;
                $j = $j - 1;
            }

            $k = $k + 1;
        }

        $level = $level + 1;
    }

    return $order;
}

/**
 * The sort key of meshlet `$m`: class, then bucket (none last), then slot.
 */
internal function arenaKey(const ModelForm& $form, const array<ArenaSlot>& $slots, int32 $m) : int64
{
    int32 $slotIndex = $form->meshlets[$m as usize]->slot;
    ArenaSlot $slot = arenaSlotOf($slots, $slotIndex);
    int64 $bucket = 0xFFFF;
    if ($slot->bucket != SCENE_BUCKET_NONE) {
        $bucket = ($slot->bucket & 0xFFFF) as int64;
    }

    return (($slot->gclass as int64) << 40) | ($bucket << 20) | (($slotIndex & 0xFFFFF) as int64);
}

/**
 * Runs `$order` cuts into: one per level per change of class or bucket.
 */
internal function arenaRunCount(const ModelForm& $form, const array<ArenaSlot>& $slots, const array<int32>& $order) : int32
{
    int32 $runs = 0;
    int32 $levels = ($form->lodStart->count() as int32) - 1;
    int32 $level = 0;
    while ($level < $levels) {
        int32 $start = $form->lodStart[$level as usize];
        int32 $end = $form->lodStart[($level + 1) as usize];
        int32 $k = $start;
        while ($k < $end) {
            ArenaSlot $slot = arenaSlotOf($slots, $form->meshlets[$order[$k as usize] as usize]->slot);
            bool $opens = $k == $start;
            if (!$opens) {
                ArenaSlot $was = arenaSlotOf($slots, $form->meshlets[$order[($k - 1) as usize] as usize]->slot);
                $opens = $was->gclass != $slot->gclass || $was->bucket != $slot->bucket;
            }

            if ($opens) {
                $runs = $runs + 1;
            }

            $k = $k + 1;
        }

        $level = $level + 1;
    }

    return $runs;
}

/**
 * Slot `$index`'s entry, or one that casts nothing and draws in class 0 for a slot past the list.
 */
internal function arenaSlotOf(const array<ArenaSlot>& $slots, int32 $index) : ArenaSlot
{
    if ($index >= 0 && ($index as usize) < $slots->count()) {
        return $slots[$index as usize];
    }

    return ArenaSlot(SCENE_BUCKET_NONE, 0, 0, false);
}

internal function arenaEmptyMeshlet() : SceneMeshletGpu
{
    return SceneMeshletGpu(
        $sphere: Vec4(0.0f),
        $cone: Vec4(0.0f, 1.0f, 0.0f, MESHLET_CONE_OPEN),
        $firstVertex: 0,
        $firstTriangle: 0,
        $triangles: 0,
        $flags: 0,
        $bucket: SCENE_BUCKET_NONE,
        $material: 0,
        $gclass: 0,
        $vertices: 0
    );
}

internal function arenaHeld(Buffer? $buffer) : Buffer
{
    Buffer $b = guard $buffer else {
        die('mesh arena: no buffers yet');
    }
    return $b;
}

/**
 * Put `$value` at `$at`, the entries from there one further on.
 */
internal function arenaInsert(array<int32>& $list, usize $at, int32 $value) : void
{
    $list[] = $value;
    usize $i = $list->count() - 1;
    while ($i > $at) {
        $list[$i] = $list[$i - 1];
        $i = $i - 1;
    }

    $list[$at] = $value;
}

/**
 * Grow `$mirror` to `$count` entries with `$fill`.
 */
internal function arenaFit<T>(array<T>& $mirror, int32 $count, T $fill) : void
{
    while (($mirror->count() as int32) < $count) {
        $mirror[] = $fill;
    }
}

internal function arenaNeeds(Buffer? $have, int64 $bytes) : bool
{
    if ($bytes <= 0) {
        return false;
    }

    Buffer $b = guard $have else {
        return true;
    }
    return ($b->handle->bytes as int64) < $bytes;
}

/**
 * A fresh storage buffer of `$bytes`; the old one is destroyed, which the device defers until
 * no frame in flight reads it.
 */
internal function arenaBuffer(Device $device, Buffer? $old, int64 $bytes, string $label) : Buffer?
{
    dropBuffer($old);
    return Buffer($device, BufferDesc(BUFFER_STORAGE, $bytes as uint64, $label));
}
