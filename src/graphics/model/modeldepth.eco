/**
 * The depth-only form of a model that GPU-driven views pull their vertices from: position and
 * uv per vertex (joints and weights too for a skinned model), the cooked indices, and every
 * LOD's primitives cut into clusters of at most `DEPTH_CLUSTER_TRIANGLES` triangles with a
 * bounding sphere each. `buildModel` makes it from the cooked bytes, and the `ModelBank` moves
 * it into its `MeshArena` and drops it, so the CPU copy lives only between load and upload.
 */

namespace visu::graphics;

use visu::asset::{CookedModel, ModelPrimitive};
use visu::math::{Vec3, length, max, min};

/**
 * Triangles per cluster, the unit the GPU culls and draws. `depth_pull.vert` expands every draw
 * item to this many triangles and sends the unused ones outside the clip volume.
 */
public const int32 DEPTH_CLUSTER_TRIANGLES = 64;

/**
 * Words per depth vertex of a rigid model: position xyz and uv.
 */
public const int32 DEPTH_RIGID_WORDS = 5;

/**
 * Words per depth vertex of a skinned model: the rigid five, then the four joint bytes and the
 * four weight bytes as they were cooked.
 */
public const int32 DEPTH_SKINNED_WORDS = 7;

/**
 * One cluster: a run of consecutive triangles of one primitive, so one material slot.
 * `firstIndex` is local to the model's index list.
 */
public struct DepthCluster
{
    public int32 $firstIndex;
    public int32 $triangles;
    public int32 $slot;
    public Vec3 $center;
    public float32 $radius;
}

public class ModelDepth
{
    /**
     * `stride` words per vertex, in cooked vertex order, as raw bits.
     */
    public array<uint32> $words;
    public int32 $stride;

    /**
     * Local vertex indices, the cooked list unchanged.
     */
    public array<uint32> $indices;
    public array<DepthCluster> $clusters;

    /**
     * Level `l` is clusters `lodStart[l] .. lodStart[l + 1]`.
     */
    public array<int32> $lodStart;

    public constructor(int32 $stride)
    {
        $this->words = array<uint32>();
        $this->stride = $stride;
        $this->indices = array<uint32>();
        $this->clusters = array<DepthCluster>();
        $this->lodStart = array<int32>();
    }
}

/**
 * The depth form of `$cooked`. O(vertices + indices), at load or adopt time only.
 */
public function modelDepth(const CookedModel& $cooked) : ModelDepth
{
    bool $skinned = $cooked->skeleton != null;
    int32 $stride = DEPTH_RIGID_WORDS;
    if ($skinned) {
        $stride = DEPTH_SKINNED_WORDS;
    }

    ModelDepth $depth = ModelDepth($stride);
    int32 $vertexBytes = $cooked->vertexBytes();
    int32 $vertices = ($cooked->vertices->size() as int32) / $vertexBytes;
    $depth->words->reserve(($vertices * $stride) as usize);
    int32 $v = 0;
    while ($v < $vertices) {
        usize $at = ($v * $vertexBytes) as usize;
        // position (0..12) and uv (40..48) of the cooked vertex
        $depth->words[] = u32le($cooked->vertices, $at);
        $depth->words[] = u32le($cooked->vertices, $at + 4);
        $depth->words[] = u32le($cooked->vertices, $at + 8);
        $depth->words[] = u32le($cooked->vertices, $at + 40);
        $depth->words[] = u32le($cooked->vertices, $at + 44);
        if ($skinned) {
            $depth->words[] = u32le($cooked->vertices, $at + 48);
            $depth->words[] = u32le($cooked->vertices, $at + 52);
        }

        $v = $v + 1;
    }

    int32 $width = indexWidth($cooked->indexType);
    int32 $count = ($cooked->indices->size() as int32) / $width;
    $depth->indices->reserve($count as usize);
    int32 $i = 0;
    while ($i < $count) {
        usize $at = ($i * $width) as usize;
        if ($width == 2) {
            uint32 $lo = $cooked->indices->byte($at) as uint32;
            uint32 $hi = $cooked->indices->byte($at + 1) as uint32;
            $depth->indices[] = $lo | ($hi << 8);
        } else {
            $depth->indices[] = u32le($cooked->indices, $at);
        }

        $i = $i + 1;
    }

    foreach ($cooked->lods as $lod) {
        $depth->lodStart[] = $depth->clusters->count() as int32;
        foreach ($lod->primitives as $prim) {
            depthClusters($depth, $prim);
        }
    }

    $depth->lodStart[] = $depth->clusters->count() as int32;
    return $depth;
}

/**
 * Cut one primitive into clusters of consecutive triangles and bound each.
 */
internal function depthClusters(ModelDepth $depth, const ModelPrimitive& $prim) : void
{
    int32 $triangles = $prim->indexCount / 3;
    int32 $done = 0;
    while ($done < $triangles) {
        int32 $n = $triangles - $done;
        if ($n > DEPTH_CLUSTER_TRIANGLES) {
            $n = DEPTH_CLUSTER_TRIANGLES;
        }

        int32 $first = $prim->firstIndex + $done * 3;
        Vec3 $lo = depthPosition($depth, $depth->indices[$first as usize]);
        Vec3 $hi = $lo;
        int32 $k = 1;
        while ($k < $n * 3) {
            Vec3 $p = depthPosition($depth, $depth->indices[($first + $k) as usize]);
            $lo = min($lo, $p);
            $hi = max($hi, $p);
            $k = $k + 1;
        }

        Vec3 $center = ($lo + $hi) * 0.5f;
        $depth->clusters[] = DepthCluster(
            $firstIndex: $first,
            $triangles: $n,
            $slot: $prim->slot,
            $center: $center,
            $radius: length($hi - $center)
        );
        $done = $done + $n;
    }
}

internal function depthPosition(ModelDepth $depth, uint32 $vertex) : Vec3
{
    usize $at = ($vertex as usize) * ($depth->stride as usize);
    return Vec3(
        mem::bit_cast<float32, uint32>($depth->words[$at]),
        mem::bit_cast<float32, uint32>($depth->words[$at + 1]),
        mem::bit_cast<float32, uint32>($depth->words[$at + 2])
    );
}
