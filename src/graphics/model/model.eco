/**
 * A decoded model: its arena form for the GPU-driven views, the classic GPU mesh (shared vertices
 * and indices) the CPU views draw, its LOD table, and one `Material` per
 * slot resolved from a cooked `.vmat` whose catalog id is the slot string. `Assets.load<Model>`
 * builds it through `decodeModel`.
 * The `ModelBank` owns every live model and is the only thing that destroys one; the destructor
 * is the safety net for a handle that never reached a bank.
 */

namespace visu::graphics;

use json;
use visu::asset::{AssetError, Assets, Blob, CookedModel, ModelLodDesc, Skeleton, Vmat, decodeCookedModel};
use visu::geo::AABB;

public class Model
{
    public const string $id;

    /**
     * The classic vertex and index buffers the CPU main views register; null once the bank
     * dropped them because every main view draws from the GPU scene (`ModelBank.dropClassicMeshes`).
     */
    public Mesh? $mesh;
    public const AABB $bounds;

    /**
     * Multiplies the measured distance before the LOD table is read. From the sheet.
     */
    public const float32 $lodBias;

    /**
     * Instances further away than this are skipped. 0 means never.
     */
    public const float32 $cullDistance;
    public array<ModelLodDesc> $lods;
    public array<string> $slots;

    /**
     * One per slot, in slot order. A missing material id gets an empty material.
     */
    public array<Material> $materials;

    /**
     * The joints a skinned model deforms by, or null for a rigid one. Its vertices then carry
     * joints and weights and draw through the skinned programs.
     */
    public const Skeleton? $skeleton;

    /**
     * The arena form GPU-driven views pull from, between `buildModel` and the bank's arena
     * upload; null once the `ModelBank` has moved it into its `MeshArena`.
     */
    public ModelForm? $form;

    /**
     * Where the bank's `MeshArena` holds this model's meshlets, once it was uploaded.
     */
    public ArenaModel? $arena;
    private bool $dead;

    public constructor(string $id, Mesh $mesh, CookedModel $cooked, array<Material> $materials)
    {
        assert($materials->count() == $cooked->slots->count(), 'model: one material per slot');
        $this->id = $id;
        $this->mesh = $mesh;
        $this->bounds = $cooked->bounds;
        $this->lodBias = $cooked->lodBias;
        $this->cullDistance = $cooked->cullDistance;
        $this->lods = $cooked->lods;
        $this->slots = $cooked->slots;
        $this->materials = $materials;
        $this->skeleton = $cooked->skeleton;
        $this->form = null;
        $this->arena = null;
        $this->dead = false;
    }

    destructor()
    {
        $this->destroy();
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dropMesh();
        $this->dead = true;
    }

    /**
     * Free the classic mesh; the arena form stays.
     */
    public function dropMesh() : void
    {
        Mesh $held = guard $this->mesh else {
            return;
        }
        $held->destroy();
        $this->mesh = null;
    }

    public const function lodCount() : int32
    {
        return $this->lods->count() as int32;
    }

    public const function skinned() : bool
    {
        return $this->skeleton != null;
    }
}

/**
 * The `model` kind decoder: cooked bytes to GPU buffers plus bound materials. Each slot is a
 * material catalog id; a missing id yields an empty material.
 */
public function decodeModel(Assets $assets, Blob $blob) : result<Model, AssetError>
{
    // nested loads overwrite `loading`, so take the id before touching the sheet
    string $id = $assets->loading;
    CookedModel $cooked = guard decodeCookedModel($assets, $blob) else ($e) {
        return .error($e);
    }
    return .ok(buildModel($assets, $id, $cooked));
}

/**
 * Upload a `CookedModel` into a live `Model` named `$id`. Each slot is a material catalog id,
 * loaded like a cooked model's. The catalog decoder goes through here, and so does a model the
 * game builds at runtime, which it then hands to `ModelBank.adopt`.
 */
public function buildModel(Assets $assets, const string& $id, CookedModel $cooked) : Model
{
    Mesh $mesh = Mesh($assets->device, bytes: $cooked->vertices, stride: $cooked->vertexBytes());
    $mesh->index(bytes: $cooked->indices, $cooked->indexType);
    array<Material> $materials = modelMaterials($assets, $id, $cooked->slots);
    Model $model = Model($id, $mesh, $cooked, $materials);
    $model->form = modelForm($cooked);
    return $model;
}

/**
 * Load each slot as a material catalog id. Missing ids stay empty.
 */
internal function modelMaterials(Assets $assets, const string& $id, const array<string>& $slots) : array<Material>
{
    array<Material> $out = array<Material>();
    foreach ($slots as $slot) {
        result<Vmat, AssetError> $r = $assets->load<Vmat>($slot);
        if ($r->failed()) {
            $out[] = Material(id: "{$id}:{$slot}");
            continue;
        }

        Vmat $sheet = $r->or(Vmat($slot, json::object()));
        Material $mat = Material($sheet);
        $mat->bind($assets);
        $out[] = $mat;
    }

    return $out;
}
