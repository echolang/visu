/**
 * Process-lifetime bank object. One per Device; the app owns it (Game, not Services).
 * `release` drops acquired meshes and map textures so a menu can free VRAM; the next Play
 * `acquire`s again. `destroy` is shutdown after `waitIdle`. F5 reloads Play without `release`,
 * so the GPU objects survive that path. Fallback textures are minted on first use, so the
 * bank may be built before the GPU is up.
 */

namespace visu::graphics;

use visu::app::info;
use visu::asset::{AssetError, AssetRef, Assets};
use visu::math::{Vec2, Vec3, Vec4};

/**
 * One material's textures on the GPU plus its slot 0 payload. `$index` is the dense key the
 * draw-call assembler sorts by; the bank hands it out in acquisition order.
 */
public class MaterialGpu
{
    public const int32 $index;
    public Material $material;
    public Texture $albedo;
    public Texture $normal;
    public Texture $roughness;
    public Texture $metallic;
    public Texture $ao;
    public Texture $alpha;

    /**
     * Emissive map, or white when the material has none. The factor in `$params` scales it.
     */
    public Texture $emissive;

    /**
     * Height map the parallax programs march, or the white fallback when `$parallax` is false.
     */
    public Texture $height;
    public Sampler $sampler;
    public ModelMaterialData $params;
    public bool $doubleSided;

    /**
     * Drawn with the `+parallax` program, set once from `Material.parallax()`.
     */
    public bool $parallax;

    /**
     * Which depth-only bucket the GPU-driven views draw this material's meshlets in: -1 casts no
     * shadow, `SCENE_BUCKET_OPAQUE` every caster without an alpha cutoff, `SCENE_BUCKET_ALPHA`
     * every cut-out one (its cutoff read from the material table). Set by the bank.
     */
    public int32 $shadowBucket;

    public constructor(
        int32 $index,
        Material $material,
        Texture $albedo,
        Texture $normal,
        Texture $roughness,
        Texture $metallic,
        Texture $ao,
        Texture $alpha,
        Texture $emissive,
        Texture $height,
        bool $parallax,
        Sampler $sampler,
        ModelMaterialData $params
    )
    {
        $this->index = $index;
        $this->material = $material;
        $this->albedo = $albedo;
        $this->normal = $normal;
        $this->roughness = $roughness;
        $this->metallic = $metallic;
        $this->ao = $ao;
        $this->alpha = $alpha;
        $this->emissive = $emissive;
        $this->height = $height;
        $this->parallax = $parallax;
        $this->sampler = $sampler;
        $this->params = $params;
        $this->doubleSided = !$material->backfaceCull;
        $this->shadowBucket = -1;
    }

    /**
     * Slot 0 payload and the six samplers, seven with the height map for a parallax material.
     * The caller has bound the GpuPass.
     */
    public function bind(RenderEncoder $enc) : void
    {
        ModelMaterialData $params = $this->params;
        $enc->upload($params, slot: 0);
        $enc->bindTexture(0, $this->albedo, $this->sampler);
        $enc->bindTexture(1, $this->normal, $this->sampler);
        $enc->bindTexture(2, $this->roughness, $this->sampler);
        $enc->bindTexture(3, $this->metallic, $this->sampler);
        $enc->bindTexture(4, $this->ao, $this->sampler);
        $enc->bindTexture(5, $this->alpha, $this->sampler);
        $enc->bindTexture(7, $this->emissive, $this->sampler);
        if ($this->parallax) {
            $enc->bindTexture(MODEL_HEIGHT_SLOT, $this->height, $this->sampler);
        }
    }
}

public class ModelBank
{
    public Device $device;
    public Assets $assets;
    private map<string, Model> $models;

    /**
     * Ids `adopt` put in `$models`: built at runtime, never catalog entries, so `release` destroys
     * them without asking the catalog to forget them.
     */
    private map<string, bool> $adopted;
    private map<string, MaterialGpu> $materials;
    private array<MaterialGpu> $byIndex;
    private Texture? $white;
    private Texture? $flatNormal;
    private Sampler? $sampler;

    /**
     * Every loaded model's depth form, for the GPU-driven views.
     */
    public MeshArena $arena;

    /**
     * The bindless side of the materials, on a device that has it: every map in a `TextureTable`
     * slot (one slot per distinct texture, by label), every material a row of the material
     * table at its dense index. Made with the first material; null on a device without
     * bindless textures, where nothing GPU-driven draws the main views.
     */
    private TextureTable? $table;
    private map<string, int32> $tableSlots;
    private array<ModelMaterialGpu> $materialRows;
    private Buffer? $materialBuffer;

    /**
     * The G-buffer classes models drew in so far, in the order they first appeared.
     */
    private array<SceneClass> $classes;
    private bool $classesWarned;

    public constructor(Device $device, Assets $assets)
    {
        $this->device = $device;
        $this->assets = $assets;
        $this->models = map<string, Model>();
        $this->adopted = map<string, bool>();
        $this->materials = map<string, MaterialGpu>();
        $this->byIndex = array<MaterialGpu>();
        $this->white = null;
        $this->flatNormal = null;
        $this->sampler = null;
        $this->arena = MeshArena($device);
        $this->table = null;
        $this->tableSlots = map<string, int32>();
        $this->materialRows = array<ModelMaterialGpu>();
        $this->materialBuffer = null;
        $this->classes = arr::room<SceneClass>(SCENE_CLASSES_MAX as usize);
        $this->classesWarned = false;
    }

    /**
     * The live model for an id, loading it (and its materials' textures) the first time.
     */
    public function acquire(string $id) : result<Model, AssetError>
    {
        if ($this->models->has($id)) {
            return .ok($this->models[$id]);
        }

        Model $model = guard $this->assets->load<Model>($id) else ($e) {
            return .error($e);
        }
        foreach ($model->materials as $material) {
            $this->materialGpu($material);
        }

        $this->arenaAdd($model);
        $this->models[$id] = $model;
        return .ok($model);
    }

    public const function has(string $id) : bool
    {
        return $this->models->has($id);
    }

    /**
     * Load a material's textures now, at a load step, so the first model that draws with it
     * later does not pay for them in a frame.
     */
    public function prepare(Material $material) : void
    {
        $this->materialGpu($material);
    }

    /**
     * Take a model built at runtime (`buildModel`) under its own id, so `acquire` hands it out
     * like a catalog model. Its materials are the cooked ones, shared by id with every other
     * model. The id must be new: an edit adopts a fresh id and drops the old one, so a mesh a
     * frame in flight reads is never rewritten.
     */
    public function adopt(Model $model) : void
    {
        assert(!$this->models->has($model->id), 'bank: adopt needs a new id');
        foreach ($model->materials as $material) {
            $this->materialGpu($material);
        }

        $this->arenaAdd($model);
        $this->models[$model->id] = $model;
        $this->adopted[$model->id] = true;
    }

    /**
     * Destroy an adopted model's mesh. Its materials stay: other models share them. Evict the id
     * from every `ModelSystem` first; the device keeps the buffers until no frame reads them.
     */
    public function drop(const string& $id) : void
    {
        if (!$this->adopted->has($id)) {
            return;
        }

        Model $model = $this->models[$id];
        $this->models->remove($id);
        $this->adopted->remove($id);
        ArenaModel? $placed = $model->arena;
        if ($placed != null) {
            ArenaModel $held = guard $placed;
            $this->arena->remove($held);
            $model->arena = null;
        }

        $model->destroy();
    }

    public const function adoptedCount() : int32
    {
        return $this->adopted->count() as int32;
    }

    /**
     * The GPU side of a model's slot. `acquire` ran, so the entry exists.
     */
    public function materialOf(Model $model, int32 $slot) : MaterialGpu
    {
        assert($slot >= 0 && ($slot as usize) < $model->materials->count(), 'bank: slot');
        Material $material = $model->materials[$slot as usize];
        return $this->materialGpu($material);
    }

    /**
     * By the dense index the assembler sorted on.
     */
    public const function material(int32 $index) : MaterialGpu
    {
        assert($index >= 0 && ($index as usize) < $this->byIndex->count(), 'bank: material index');
        return $this->byIndex[$index as usize];
    }

    public const function materialCount() : int32
    {
        return $this->byIndex->count() as int32;
    }

    /**
     * Whether the materials have their bindless side: the GPU-driven programs need it.
     */
    public const function bindless() : bool
    {
        return $this->table != null && $this->materialBuffer != null;
    }

    /**
     * The texture table every material map sits in. Only when `bindless`.
     */
    public function textureTable() : TextureTable
    {
        TextureTable $t = guard $this->table else {
            die('bank: no texture table on this device');
        }
        return $t;
    }

    /**
     * The material table, one `ModelMaterialGpu` row per material index. Only when `bindless`.
     */
    public function materialTable() : Buffer
    {
        Buffer $b = guard $this->materialBuffer else {
            die('bank: no material table yet');
        }
        return $b;
    }

    /**
     * Distinct textures in the table, for the `scene` verb.
     */
    public const function tableTextures() : int32
    {
        return $this->tableSlots->count() as int32;
    }

    /**
     * The G-buffer class `$m` draws in on a model that is (or is not) skinned, registered the
     * first time it is asked for. At a load step: the arena asks while it takes a model.
     */
    public function gbufferClass(MaterialGpu $m, bool $skinned) : int32
    {
        SceneClass $want = SceneClass(
            $skinned: $skinned,
            $doubleSided: $m->doubleSided,
            $parallax: $m->parallax,
            $cutout: $m->material->alphaCutoff > 0.0f,
            $depthBias: $m->material->depthBias,
            $depthSlope: $m->material->depthSlope
        );
        int32 $i = 0;
        int32 $n = $this->classes->count() as int32;
        while ($i < $n) {
            if ($this->classes[$i as usize]->same($want)) {
                return $i;
            }

            $i = $i + 1;
        }

        if ($n >= SCENE_CLASSES_MAX) {
            if (!$this->classesWarned) {
                int32 $cap = SCENE_CLASSES_MAX;
                info("model: more than {$cap} G-buffer classes; further ones draw as class 0");
                $this->classesWarned = true;
            }

            return 0;
        }

        $this->classes[] = $want;
        return $n;
    }

    public const function classCount() : int32
    {
        return $this->classes->count() as int32;
    }

    public const function gclass(int32 $index) : SceneClass
    {
        return $this->classes[$index as usize];
    }

    public const function modelCount() : int32
    {
        return $this->models->count() as int32;
    }

    /**
     * Drop acquired meshes and their map textures. The bank object stays; fallbacks stay.
     * waitIdle first. Menu calls this so Play GPU does not sit on the title screen.
     */
    public function release() : void
    {
        $this->dropAcquired();
    }

    /**
     * Free the fallbacks and every model. waitIdle first.
     */
    public function destroy() : void
    {
        $this->dropAcquired();
        $this->dropTable();
        Texture? $white = $this->white;
        if ($white != null) {
            Texture $w = guard $white;
            $w->destroy();
            $this->white = null;
        }

        Texture? $flat = $this->flatNormal;
        if ($flat != null) {
            Texture $f = guard $flat;
            $f->destroy();
            $this->flatNormal = null;
        }
    }

    /**
     * Destroy live models, forget their catalog ids and map textures, keep fallbacks.
     */
    private function dropAcquired() : void
    {
        array<string> $ids = array<string>();
        array<string> $modelIds = $this->models->keys();
        foreach ($modelIds as $id) {
            if (!$this->adopted->has($id)) {
                $ids[] = $id;
            }
        }

        foreach ($this->materials as $gpu) {
            rememberMap($ids, $gpu->material->albedo);
            rememberMap($ids, $gpu->material->normal);
            rememberMap($ids, $gpu->material->roughness);
            rememberMap($ids, $gpu->material->metal);
            rememberMap($ids, $gpu->material->height);
            rememberMap($ids, $gpu->material->ao);
            rememberMap($ids, $gpu->material->emissive);
            rememberMap($ids, $gpu->material->alpha);
        }

        array<Model> $live = array<Model>();
        foreach ($this->models as $model) {
            $live[] = $model;
        }

        $this->models->clear();
        $this->adopted->clear();
        foreach ($live as $model) {
            $model->destroy();
        }

        $this->materials->clear();
        $this->byIndex->clear();
        $this->dropTable();
        $this->classes->clear();
        $this->arena->clear();
        foreach ($ids as $id) {
            $this->assets->forget($id);
        }
    }

    private function materialGpu(Material $material) : MaterialGpu
    {
        if ($this->materials->has($material->id)) {
            return $this->materials[$material->id];
        }

        Texture $white = $this->whiteTexture();
        Texture $flat = $this->flatNormalTexture();
        int32 $flags = 0;
        Texture $albedo = $this->mapOr($material->albedo, $white, MODEL_MAP_ALBEDO, $flags);
        Texture $normal = $this->mapOr($material->normal, $flat, MODEL_MAP_NORMAL, $flags);
        Texture $roughness = $this->mapOr($material->roughness, $white, MODEL_MAP_ROUGHNESS, $flags);
        Texture $metallic = $this->mapOr($material->metal, $white, MODEL_MAP_METALLIC, $flags);
        Texture $ao = $this->mapOr($material->ao, $white, MODEL_MAP_AO, $flags);
        Texture $alpha = $this->mapOr($material->alpha, $white, MODEL_MAP_ALPHA, $flags);
        Texture $emissive = $this->mapOr($material->emissive, $white, 0, $flags);
        Vec3 $glow = $material->emissiveFactor;
        // the height map is only loaded for a surface that marches it
        Texture $height = $white;
        float32 $depth = 0.0f;
        if ($material->parallax()) {
            $height = $this->mapOr($material->height, $white, MODEL_MAP_HEIGHT, $flags);
            if (($flags & MODEL_MAP_HEIGHT) != 0) {
                $depth = $material->parallaxDepth;
            }
        }

        Vec2 $scale = $material->textureScale;
        ModelMaterialData $params = ModelMaterialData(
            Vec4($material->diffuseColor->x, $material->diffuseColor->y, $material->diffuseColor->z, $material->alphaCutoff),
            Vec4($material->roughnessFactor, $material->metallicFactor, $flags as float32, $depth),
            Vec4($scale->x, $scale->y, $material->parallaxSteps, $material->parallaxFade),
            Vec4($glow->x, $glow->y, $glow->z, 0.0f)
        );
        int32 $index = $this->byIndex->count() as int32;
        MaterialGpu $gpu = MaterialGpu(
            $index,
            $material,
            $albedo,
            $normal,
            $roughness,
            $metallic,
            $ao,
            $alpha,
            $emissive,
            $height,
            $depth > 0.0f,
            $this->modelSampler(),
            $params
        );
        if ($material->castShadow) {
            // the depth programs only discard with a cutoff, so every other caster is opaque
            $gpu->shadowBucket = SCENE_BUCKET_OPAQUE as int32;
            if ($material->alphaCutoff > 0.0f) {
                $gpu->shadowBucket = SCENE_BUCKET_ALPHA as int32;
            }
        }

        $this->materials[$material->id] = $gpu;
        $this->byIndex[] = $gpu;
        $this->tableRow($gpu);
        return $gpu;
    }

    /**
     * Give `$gpu` its material table row (and its maps their table slots), at a load step. The
     * table buffer grows by doubling from the CPU rows, so a frame in flight keeps the rows it
     * saw. Nothing on a device without bindless textures.
     */
    private function tableRow(MaterialGpu $gpu) : void
    {
        if (!$this->device->limits()->bindless) {
            return;
        }

        if ($this->table == null) {
            TextureTable $fresh = TextureTable($this->device);
            $fresh->setSampler(0, $this->modelSampler());
            $this->table = $fresh;
        }

        ModelMaterialData $p = $gpu->params;
        ModelMaterialGpu $row = ModelMaterialGpu(
            $baseColor: $p->baseColor,
            $factors: $p->factors,
            $uvScale: $p->uvScale,
            $emissive: $p->emissive,
            $albedo: $this->tableSlot($gpu->albedo),
            $normal: $this->tableSlot($gpu->normal),
            $roughness: $this->tableSlot($gpu->roughness),
            $metallic: $this->tableSlot($gpu->metallic),
            $ao: $this->tableSlot($gpu->ao),
            $alpha: $this->tableSlot($gpu->alpha),
            $emissiveMap: $this->tableSlot($gpu->emissive),
            $height: $this->tableSlot($gpu->height)
        );
        assert(($gpu->index as usize) == $this->materialRows->count(), 'bank: material rows follow the dense index');
        $this->materialRows[] = $row;
        uint64 $rowBytes = mem::size<ModelMaterialGpu>() as uint64;
        uint64 $need = ($this->materialRows->count() as uint64) * $rowBytes;
        Buffer? $have = $this->materialBuffer;
        bool $grow = true;
        if ($have != null) {
            Buffer $held = guard $have;
            $grow = $held->handle->bytes < $need;
        }

        if ($grow) {
            uint64 $cap = 64 as uint64;
            while ($cap * $rowBytes < $need) {
                $cap = $cap * 2;
            }

            dropBuffer($this->materialBuffer);
            Buffer $fresh = Buffer($this->device, BufferDesc(BUFFER_STORAGE, $cap * $rowBytes, 'bank.materials'));
            ptr<const ModelMaterialGpu> $all = ptr<const ModelMaterialGpu>(&$this->materialRows[0]);
            $fresh->upload(ptr<const uint8>($all:$), $need, 0 as uint64);
            $this->materialBuffer = $fresh;
            return;
        }

        Buffer $buffer = guard $this->materialBuffer;
        ptr<const ModelMaterialGpu> $src = ptr<const ModelMaterialGpu>(&$this->materialRows[$gpu->index as usize]);
        $buffer->upload(ptr<const uint8>($src:$), $rowBytes, ($gpu->index as uint64) * $rowBytes);
    }

    /**
     * `$texture`'s slot in the table, added on first use. A full table hands out the white
     * fallback's slot, which is never full: it was the first texture in.
     */
    private function tableSlot(Texture $texture) : uint32
    {
        string $key = $texture->desc->label;
        if ($this->tableSlots->has($key)) {
            return $this->tableSlots[$key] as uint32;
        }

        TextureTable $table = guard $this->table;
        int32 $slot = $table->add($texture);
        if ($slot == TEXTURE_TABLE_FULL) {
            info("model: texture table full; '{$key}' samples white");
            return $this->tableSlot($this->whiteTexture());
        }

        $this->tableSlots[$key] = $slot;
        return $slot as uint32;
    }

    private function dropTable() : void
    {
        TextureTable? $table = $this->table;
        if ($table != null) {
            TextureTable $held = guard $table;
            $held->destroy();
        }

        $this->table = null;
        $this->tableSlots->clear();
        $this->materialRows->clear();
        $this->materialBuffer = dropBuffer($this->materialBuffer);
    }

    /**
     * Move a model's arena form into the arena, each meshlet tagged with its slot's shadow
     * bucket, material and G-buffer class.
     */
    private function arenaAdd(Model $model) : void
    {
        ModelForm $form = guard $model->form else {
            return;
        }
        bool $skinned = $model->skinned();
        array<ArenaSlot> $slots = array<ArenaSlot>();
        int32 $slot = 0;
        while (($slot as usize) < $model->materials->count()) {
            MaterialGpu $m = $this->materialOf($model, $slot);
            uint32 $bucket = SCENE_BUCKET_NONE;
            if ($m->shadowBucket >= 0) {
                $bucket = $m->shadowBucket as uint32;
            }

            $slots[] = ArenaSlot($bucket, $m->index, $this->gbufferClass($m, $skinned), $m->doubleSided);
            $slot = $slot + 1;
        }

        $model->arena = $this->arena->add($form, $slots, $skinned);
        $model->form = null;
    }

    /**
     * The slot's live texture and its presence flag, or the fallback and no flag.
     */
    private function mapOr(AssetRef? $slot, Texture $fallback, int32 $flag, int32& $flags) : Texture
    {
        Texture? $found = $this->mapTexture($slot);
        Texture $tex = guard $found else {
            return $fallback;
        }
        $flags = $flags | $flag;
        return $tex;
    }

    /**
     * The live texture behind a slot, or null when the slot is empty or its blob fails to decode.
     */
    private function mapTexture(AssetRef? $slot) : Texture?
    {
        AssetRef $ref = guard $slot else {
            return null;
        }
        result<Texture, AssetError> $r = $ref->load<Texture>();
        if ($r->failed()) {
            string $why = $r->failure()->message();
            info("model: map '{$ref->id}' could not be loaded: {$why}");
            return null;
        }

        return $r->or($this->whiteTexture());
    }

    private function whiteTexture() : Texture
    {
        Texture? $have = $this->white;
        Texture $tex = guard $have else {
            Texture $fresh = onePixel($this->device, 'model.white', 255, 255, 255, 255);
            $this->white = $fresh;
            return $fresh;
        }
        return $tex;
    }

    private function flatNormalTexture() : Texture
    {
        Texture? $have = $this->flatNormal;
        Texture $tex = guard $have else {
            Texture $fresh = onePixel($this->device, 'model.flatnormal', 128, 128, 255, 255);
            $this->flatNormal = $fresh;
            return $fresh;
        }
        return $tex;
    }

    private function modelSampler() : Sampler
    {
        Sampler? $have = $this->sampler;
        Sampler $sampler = guard $have else {
            SamplerDesc $desc = SamplerDesc();
            $desc->min = Filter::linearMipmapLinear;
            $desc->mag = Filter::linear;
            $desc->wrapS = Wrap::repeat;
            $desc->wrapT = Wrap::repeat;
            $desc->anisotropic = true;
            Sampler $fresh = $this->device->createSampler($desc);
            $this->sampler = $fresh;
            return $fresh;
        }
        return $sampler;
    }
}

internal function rememberMap(array<string>& $ids, AssetRef? $slot) : void
{
    AssetRef $ref = guard $slot else {
        return;
    }
    $ids[] = $ref->id;
}

/**
 * A 1x1 rgba8 texture, the stand-in for an absent map.
 */
internal function onePixel(Device $device, string $name, uint8 $r, uint8 $g, uint8 $b, uint8 $a) : Texture
{
    array<uint8> $rgba = array<uint8>();
    $rgba[] = $r;
    $rgba[] = $g;
    $rgba[] = $b;
    $rgba[] = $a;
    return Texture($device, $name, Pixels(1, 1, $rgba));
}
