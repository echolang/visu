/**
 * Distance LOD, stateless: the last level whose switch distance the biased distance has passed.
 * Same rule as BetaBrain's `ModelObject::get_meshes_lod_dist`; no hysteresis, so a pinned
 * camera draws the same level every frame.
 */

namespace visu::graphics;

use visu::asset::ModelLodDesc;

public function lodIndex(const array<ModelLodDesc>& $lods, float32 $distance, float32 $bias) : int32
{
    int32 $n = $lods->count() as int32;
    if ($n <= 1) {
        return 0;
    }

    float32 $d = $distance * $bias;
    int32 $level = 0;
    int32 $i = 1;
    while ($i < $n) {
        if ($d < $lods[$i as usize]->distance) {
            break;
        }

        $level = $i;
        $i = $i + 1;
    }

    return $level;
}
