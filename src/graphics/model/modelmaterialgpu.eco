/**
 * One material row of the bank's material table (std430 `ModelMaterial`, 96 bytes,
 * `visu/material_table.glsl`): the four vectors of `ModelMaterialData`, then the `TextureTable`
 * slot of each map, the fallback's slot for a map the material lacks (its flag in `factors.z`
 * stays off). The GPU-driven programs read a meshlet's material here instead of binding it.
 */

namespace visu::graphics;

use visu::math::Vec4;

/**
 * Shadow bucket of every opaque caster, and of every alpha-tested one: the depth views draw the
 * cut-out bucket with the material table bound, so two buckets cover every material.
 */
public const uint32 SCENE_BUCKET_OPAQUE = 0;
public const uint32 SCENE_BUCKET_ALPHA = 1;
public const int32 SCENE_SHADOW_BUCKETS = 2;

public struct ModelMaterialGpu
{
    public Vec4 $baseColor;
    public Vec4 $factors;
    public Vec4 $uvScale;
    public Vec4 $emissive;
    public uint32 $albedo;
    public uint32 $normal;
    public uint32 $roughness;
    public uint32 $metallic;
    public uint32 $ao;
    public uint32 $alpha;
    public uint32 $emissiveMap;
    public uint32 $height;
}
