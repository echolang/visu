/**
 * Bind + upload + draw. Program + layout + raster + topology.
 * Distinct from the render-graph Pipeline. Slot is the payload identity; there is no uniform-block name.
 */

namespace visu::graphics;

/**
 * Metal tessellation partition mode. Vulkan ignores this; the `tesse` layout qualifier must agree
 * (`equal_spacing` with `.integer`, `fractional_even_spacing` / `fractional_odd_spacing` with the
 * matching fractional case).
 */
public enum TessellationSpacing
{
    case integer;
    case fractionalEven;
    case fractionalOdd;
    case pow2;
}

public struct GpuPass
{
    public ShaderProgram $program;
    public VertexLayout $layout;
    public Raster $raster;
    public Topology $topology;
    public uint32 $slot;
    public int32 $patchControlPoints;
    public TessellationSpacing $spacing;
    private string $key;

    public constructor(
        ShaderProgram $program,
        VertexLayout $layout,
        Raster $raster,
        topology: Topology $topology = .triangles,
        slot: uint32 $slot = 0,
        patchControlPoints: int32 $patchControlPoints = 0,
        spacing: TessellationSpacing $spacing = .integer
    )
    {
        $this->program = $program;
        $this->layout = $layout;
        $this->raster = $raster;
        $this->topology = $topology;
        $this->slot = $slot;
        $this->patchControlPoints = $patchControlPoints;
        $this->spacing = $spacing;
        if ($this->program->tessellated && $this->patchControlPoints < 1) {
            $this->patchControlPoints = 4;
        }
        if ($this->program->tessellated && $this->topology != Topology::patches) {
            $this->topology = .patches;
        }
    }

    init
    {
        int32 $blend = blendCode($this->raster->blend);
        int32 $write = 0;

        if ($this->raster->colorWrite) {
            $write = 1;
        }

        int32 $topo = topologyCode($this->topology);
        int32 $patches = $this->patchControlPoints;
        int32 $cull = cullCode($this->raster->cull);
        int32 $fill = fillCode($this->raster->fill);
        int32 $front = 0;

        if ($this->raster->front == FrontFace::cw) {
            $front = 1;
        }

        int32 $depth = compareCode($this->raster->depthCompare);
        int32 $dtest = 0;
        int32 $dwrite = 0;

        if ($this->raster->depthTest) {
            $dtest = 1;
        }

        if ($this->raster->depthWrite) {
            $dwrite = 1;
        }

        int32 $space = spacingCode($this->spacing);
        $this->key = "{$this->program->id}|{$this->layout->fingerprint()}|{$blend}|{$write}|{$topo}|{$cull}|{$fill}|{$front}|{$dtest}|{$dwrite}|{$depth}|{$patches}|{$space}";
    }

    public const function key() : string
    {
        return $this->key;
    }

    public function bind(RenderEncoder $enc) : void
    {
        $enc->setGpuPass($this);
    }

    public function draw<T>(RenderEncoder $enc, Mesh $mesh, const T& $params) : void
    {
        $mesh->checkLayout($this->layout);
        $this->bind($enc);
        $enc->upload($params, slot: $this->slot);
        $mesh->draw($enc);
    }
}

internal function blendCode(BlendMode $blend) : int32
{
    return match ($blend) {
        BlendMode::none => 0,
        BlendMode::alpha => 1,
        BlendMode::premultiplied => 2,
        BlendMode::additive => 3,
    };
}

internal function topologyCode(Topology $topology) : int32
{
    return match ($topology) {
        Topology::points => 0,
        Topology::lines => 1,
        Topology::lineStrip => 2,
        Topology::triangles => 3,
        Topology::triangleStrip => 4,
        Topology::patches => 5,
    };
}

internal function cullCode(CullMode $cull) : int32
{
    return match ($cull) {
        CullMode::none => 0,
        CullMode::front => 1,
        CullMode::back => 2,
    };
}

internal function fillCode(FillMode $fill) : int32
{
    return match ($fill) {
        FillMode::fill => 0,
        FillMode::lines => 1,
    };
}

internal function spacingCode(TessellationSpacing $spacing) : int32
{
    return match ($spacing) {
        TessellationSpacing::integer => 0,
        TessellationSpacing::fractionalEven => 1,
        TessellationSpacing::fractionalOdd => 2,
        TessellationSpacing::pow2 => 3,
    };
}

internal function compareCode(Compare $op) : int32
{
    return match ($op) {
        Compare::never => 0,
        Compare::less => 1,
        Compare::equal => 2,
        Compare::lessEqual => 3,
        Compare::greater => 4,
        Compare::notEqual => 5,
        Compare::greaterEqual => 6,
        Compare::always => 7,
    };
}
