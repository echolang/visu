/**
 * How one highlight slot looks. The renderer keeps `OUTLINE_STYLES` of them; a caster tags each
 * instance with a slot index, so a hover and a selection can glow in different colours at once.
 */

namespace visu::graphics;

use visu::math::Vec4;

/**
 * Highlight slots the mask and the composite know about.
 */
public const int32 OUTLINE_STYLES = 4;

public struct OutlineStyle
{
    /**
     * Glow colour, alpha its peak opacity next to the silhouette.
     */
    public Vec4 $color;

    /**
     * How far the glow reaches past the silhouette, in points. Device pixels follow the target's
     * content scale.
     */
    public float32 $width;

    /**
     * Strength of the glow where something stands in front of the object, 0 to hide it there,
     * 1 to show it as bright as the visible edge.
     */
    public float32 $hidden;

    /**
     * How strongly the silhouette itself is tinted with `color`, 0 to leave the object as lit.
     * A placement ghost, drawn only into the outline mask, is nothing but this tint and the glow.
     */
    public float32 $fill;

    /**
     * A warm gold glow, four points wide, a third as strong behind an occluder.
     */
    public constructor()
    {
        $this->color = Vec4(1.0f, 0.8f, 0.3f, 0.9f);
        $this->width = 4.0f;
        $this->hidden = 0.35f;
        $this->fill = 0.0f;
    }

    public constructor(Vec4 $color, float32 $width = 4.0f, float32 $hidden = 0.35f, float32 $fill = 0.0f)
    {
        $this->color = $color;
        $this->width = $width;
        $this->hidden = $hidden;
        $this->fill = $fill;
    }
}
