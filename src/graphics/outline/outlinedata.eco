/**
 * The outline mailbox for this frame. The renderer publishes it before `fill`; casters add
 * themselves and the world box of what they highlight. After fill the renderer adds the mask
 * and composite passes only if a caster came, so a frame with nothing highlighted costs nothing.
 * One object lives on the renderer and is reset each frame, so the caster list keeps its room.
 */

namespace visu::graphics;

use visu::geo::AABB;
use visu::math::Vec3;

public class OutlineData
{
    public array<OutlineCaster> $casters;

    /**
     * Union of every caster's box this frame. Meaningless while `casters` is empty.
     */
    public AABB $bounds;

    public constructor()
    {
        $this->casters = arr::room<OutlineCaster>(4);
        $this->bounds = AABB(Vec3(0.0f), Vec3(0.0f));
    }

    public function reset() : void
    {
        $this->casters->clear();
    }

    public const function active() : bool
    {
        return $this->casters->count() > 0;
    }

    /**
     * Opt `$caster` into this frame's mask. `$bounds` covers everything it will draw; the
     * composite only shades the screen rect of the union.
     */
    public function add(OutlineCaster $caster, const AABB& $bounds) : void
    {
        if ($this->casters->count() == 0) {
            $this->bounds = $bounds;
        } else {
            $this->bounds = $this->bounds->union($bounds);
        }

        $this->casters[] = $caster;
    }
}

/**
 * The mask the casters drew: r coverage, g visible (not behind the scene), b the style slot.
 */
public class OutlineMaskData
{
    public const TargetRef $target;
    public const TextureRef $mask;

    public constructor(TargetRef $target, TextureRef $mask)
    {
        $this->target = $target;
        $this->mask = $mask;
    }
}
