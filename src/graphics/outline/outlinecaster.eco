/**
 * Draws its highlighted instances into the outline mask. Implementations are classes; only a
 * class can be stored as an interface value. A system decides what to highlight during its own
 * fill, then `OutlineData.add`s itself with the world box of what it will draw. The encoder is
 * open on the mask target with the camera at slot 1 and the scene depth at
 * `OUTLINE_DEPTH_SLOT`; `mask` must not begin or end it.
 */

namespace visu::graphics;

public interface OutlineCaster
{
    function mask(RenderContext $ctx, RenderEncoder $enc) : void;
}
