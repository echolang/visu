/**
 * Draws its highlighted instances into the outline mask. Implementations are classes; only a
 * class can be stored as an interface value. A drawer decides what to highlight in its
 * `prepare` and answers `SCENE_VIEW_OUTLINE`; the renderer then joins it with `outlineBounds`.
 * The encoder is open on the mask target with the camera at slot 1 and the scene depth at
 * `OUTLINE_DEPTH_SLOT`; `mask` must not begin or end it.
 */

namespace visu::graphics;

use visu::geo::AABB;

public interface OutlineCaster
{
    function mask(RenderContext $ctx, RenderEncoder $enc) : void;

    /**
     * The world box of everything `mask` will draw this frame; the composite only shades the
     * screen rect of the union.
     */
    function outlineBounds() : AABB;
}
