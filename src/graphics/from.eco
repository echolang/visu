/**
 * `str::from` so `"{$e}"` works. Own file because a namespace is a
 * property of the file.
 */

namespace str;

public function from(const visu::graphics::PoolError& $e) : string
{
    return $e->message();
}

public function from(const visu::graphics::PipelineError& $e) : string
{
    return $e->message();
}
