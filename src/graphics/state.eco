/**
 * Compile-time GPU device.
 *
 * OpenGL is a state machine. Reading state back from the GPU is a
 * sync point, so the app owns one `Gpu` whose cache skips redundant
 * binds. The concrete type is selected by `#[if:]` (OpenGL default;
 * Metal is a later arm with the same name). Pass it as `Gpu&`.
 */

namespace visu::graphics;

public enum FramebufferTarget
{
    case read;
    case draw;
    case readDraw;
}

/**
 * GPU object the pool can destroy. Texture, Framebuffer,
 * QuadVertexArray, ShaderStage, ShaderProgram.
 */
public interface GpuObject
{
    function destroy(Gpu& $state) : void;
}
