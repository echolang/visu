/**
 * Compile-time GPU device.
 *
 * OpenGL is a state machine. Reading state back from the GPU is a
 * sync point, so the app owns one `Gpu` whose cache skips redundant
 * binds. The concrete type is selected by `#[if:]` (OpenGL default;
 * `--define VISU_BACKEND_METAL` for Metal). Both backends implement
 * `GpuProtocol` so a missing method fails at the class. GPU objects
 * store the class handle.
 */

namespace visu::graphics;

public enum FramebufferTarget
{
    case read;
    case draw;
    case readDraw;
}

/**
 * GPU object the pool can destroy. Texture, Framebuffer,
 * Mesh, GpuBuffer, UniformBuffer, ShaderStage, ShaderProgram.
 */
public interface GpuObject
{
    function destroy() : void;
}

/**
 * Shared Gpu surface. Slot is the payload identity. Both
 * backends write `: GpuProtocol` so a missing method fails at
 * the class, not at a call site. Not a runtime switch — call
 * sites still hold Gpu. `load`, Metal `connect` / `present` /
 * `resizeDrawable`, and GL `set` / `bindUniformBlock` stay on
 * the concrete class.
 */
public interface GpuProtocol
{
    // lifetime
    function lose() : void;
    const function lost() : bool;
    function reset() : void;

    // program / raster
    function useProgram(uint32 $program) : void;
    function applyRaster(const Raster& $raster) : void;

    // framebuffer bind
    function bindFramebuffer(FramebufferTarget $target, uint32 $id) : bool;
    function unbindFramebuffer(uint32 $id) : void;
    function viewport(int32 $x, int32 $y, int32 $width, int32 $height) : void;
    function clearColor(float32 $r, float32 $g, float32 $b, float32 $a) : void;
    function clear(uint32 $mask) : void;

    // vertex / index / uniform binds
    function bindVertexArray(uint32 $vao) : void;
    function bindVertexBuffer(uint32 $vbo) : void;
    function bindIndexBuffer(uint32 $ibo) : void;
    function bindUniformBuffer(uint32 $ubo) : void;
    function bindUniformSlot(uint32 $slot, uint32 $id) : void;
    function pushUniform(uint32 $slot, ptr<const uint8> $ptr, isize $bytes) : void;

    // buffers / attribs
    function createVertexArray() : uint32;
    function deleteVertexArray(uint32 $id) : void;
    function createBuffer() : uint32;
    function deleteBuffer(uint32 $id) : void;
    function uploadBytes(BufferUse $use, uint32 $id, ptr<const uint8> $ptr, isize $bytes) : void;
    function uploadFloats(BufferUse $use, uint32 $id, array<float32>& $data) : void;
    function applyLayout(uint32 $vao, const VertexLayout& $layout, uint32 $vertexBuf, uint32 $instanceBuf) : void;

    // draw
    function drawArrays(DrawMode $mode, int32 $first, int32 $count) : void;
    function drawInstanced(DrawMode $mode, int32 $first, int32 $count, int32 $instances) : void;

    // textures
    function bindTexture(uint32 $unit, TextureTarget $target, uint32 $texture) : void;
    const function boundTexture(uint32 $unit, TextureTarget $target) : uint32;
    function forgetTexture(uint32 $texture) : void;
    function createTexture() : uint32;
    function deleteTexture(uint32 $id) : void;
    function texImage2D(TextureTarget $target, PixelFormat $format, int32 $width, int32 $height) : void;
    function texFilter(TextureTarget $target, Filter $min, Filter $mag) : void;
    function texWrap(TextureTarget $target, Wrap $s, Wrap $t) : void;
    function generateMipmap(TextureTarget $target) : void;

    // framebuffer objects
    function createFramebuffer() : uint32;
    function deleteFramebuffer(uint32 $id) : void;
    function createRenderbuffer() : uint32;
    function deleteRenderbuffer(uint32 $id) : void;
    function bindRenderbuffer(uint32 $id) : void;
    function renderbufferStorage(PixelFormat $format, int32 $width, int32 $height) : void;
    function framebufferRenderbuffer(Attachment $point, uint32 $renderbuffer) : void;
    function framebufferTexture2D(Attachment $point, TextureTarget $target, uint32 $texture, int32 $level) : void;
    function framebufferStatus() : FramebufferStatus;
    function drawBuffers(const array<Attachment>& $colors) : void;
    function drawBuffers(ColorSpan $colors) : void;

    // shaders
    function createShader(ShaderKind $kind) : uint32;
    function deleteShader(uint32 $id) : void;
    function shaderSource(uint32 $id, string $source) : void;
    function compileShader(uint32 $id) : void;
    function shaderCompiled(uint32 $id) : bool;
    function shaderInfoLog(uint32 $id) : string;
    function createProgram() : uint32;
    function deleteProgram(uint32 $id) : void;
    function attachShader(uint32 $program, uint32 $shader) : void;
    function linkProgram(uint32 $id) : void;
    function programLinked(uint32 $id) : bool;
    function programInfoLog(uint32 $id) : string;
}

// named: stored in map<uint32, UniformScratch> on GpuBinds
internal struct UniformScratch
{
    public uint32 $id = 0;
    public isize $bytes = 0;
}

/**
 * CPU bind cache shared by both Gpu arms. Texture maps stay on
 * the concrete class (GL is unit×target; Metal is unit).
 */
internal class GpuBinds
{
    public uint32 $program = 0;
    public uint32 $readFramebuffer = 0;
    public uint32 $drawFramebuffer = 0;
    public uint32 $vertexArray = 0;
    public uint32 $vertexBuffer = 0;
    public uint32 $indexBuffer = 0;
    public uint32 $uniformBuffer = 0;
    public uint32 $renderbuffer = 0;
    public uint32 $textureUnit = 0;
    public map<uint32, UniformScratch> $uniformScratch;
    public map<uint32, uint32> $boundSlots;
    public bool $viewportSet = false;
    public int32 $viewportX = 0;
    public int32 $viewportY = 0;
    public int32 $viewportWidth = 0;
    public int32 $viewportHeight = 0;
    public bool $clearColorSet = false;
    public float32 $clearR = 0.0f;
    public float32 $clearG = 0.0f;
    public float32 $clearB = 0.0f;
    public float32 $clearA = 0.0f;
    public bool $rasterSet = false;
    public bool $depthTest = false;
    public bool $depthWrite = true;
    public CullMode $cull = .none;
    public BlendMode $blend = .none;
    public bool $colorWrite = true;

    public constructor()
    {
        $this->uniformScratch = map<uint32, UniformScratch>();
        $this->boundSlots = map<uint32, uint32>();
        $this->clear();
    }

    public function clear() : void
    {
        $this->program = 0;
        $this->readFramebuffer = 0;
        $this->drawFramebuffer = 0;
        $this->vertexArray = 0;
        $this->vertexBuffer = 0;
        $this->indexBuffer = 0;
        $this->uniformBuffer = 0;
        $this->renderbuffer = 0;
        $this->textureUnit = 0;
        $this->boundSlots->clear();
        $this->viewportSet = false;
        $this->viewportX = 0;
        $this->viewportY = 0;
        $this->viewportWidth = 0;
        $this->viewportHeight = 0;
        $this->clearColorSet = false;
        $this->clearR = 0.0f;
        $this->clearG = 0.0f;
        $this->clearB = 0.0f;
        $this->clearA = 0.0f;
        $this->rasterSet = false;
        $this->depthTest = false;
        $this->depthWrite = true;
        $this->cull = .none;
        $this->blend = .none;
        $this->colorWrite = true;
    }

    public function sameRaster(const Raster& $raster) : bool
    {
        return $this->rasterSet
            && $this->depthTest == $raster->depthTest
            && $this->depthWrite == $raster->depthWrite
            && $this->cull == $raster->cull
            && $this->blend == $raster->blend
            && $this->colorWrite == $raster->colorWrite;
    }

    public function rememberRaster(const Raster& $raster) : void
    {
        $this->depthTest = $raster->depthTest;
        $this->depthWrite = $raster->depthWrite;
        $this->cull = $raster->cull;
        $this->blend = $raster->blend;
        $this->colorWrite = $raster->colorWrite;
        $this->rasterSet = true;
    }

    public function dropBuffer(uint32 $id) : void
    {
        if ($this->vertexBuffer == $id) {
            $this->vertexBuffer = 0;
        }

        if ($this->indexBuffer == $id) {
            $this->indexBuffer = 0;
        }

        if ($this->uniformBuffer == $id) {
            $this->uniformBuffer = 0;
        }

        array<uint32> $bound = $this->boundSlots->keys();

        foreach ($bound as $slot) {
            if ($this->boundSlots[$slot] == $id) {
                $this->boundSlots->remove($slot);
            }
        }

        array<uint32> $scratch = $this->uniformScratch->keys();

        foreach ($scratch as $slot) {
            UniformScratch $held = $this->uniformScratch[$slot];

            if ($held->id == $id) {
                $this->uniformScratch->remove($slot);
            }
        }
    }
}

/**
 * Per-draw scratch UBO at `$slot`. Both backends call this from
 * pushUniform. GL vec4-array fallback lives on ShaderProgram.
 */
internal function fillUniformScratch(
    Gpu $gpu,
    GpuBinds $binds,
    uint32 $slot,
    ptr<const uint8> $ptr,
    isize $bytes
) : void
{
    assert($bytes > 0, 'uniform payload size');
    uint32 $id = 0;

    if ($binds->uniformScratch->has($slot)) {
        UniformScratch $held = $binds->uniformScratch[$slot];
        $id = $held->id;

        if ($bytes > $held->bytes) {
            $binds->uniformScratch[$slot] = UniformScratch($id, $bytes);
        }
    } else {
        $id = $gpu->createBuffer();
        $binds->uniformScratch[$slot] = UniformScratch($id, $bytes);
    }

    UniformScratch $scratch = $binds->uniformScratch[$slot];
    $gpu->uploadBytes(.uniform, $scratch->id, $ptr, $bytes);
    $gpu->bindUniformSlot($slot, $scratch->id);
}

/**
 * Primitive for drawArrays / drawInstanced. App code writes
 * `.triangles`, never gl::TRIANGLES.
 */
public enum DrawMode
{
    case points;
    case lines;
    case lineLoop;
    case lineStrip;
    case triangles;
    case triangleStrip;
    case triangleFan;
}

/**
 * Shader file suffix for this backend. Register
 * `quad.vert.{shaderSuffix()}` so the same call loads GLSL or MSL.
 */
public function shaderSuffix() : string
{
    #[if: VISU_BACKEND_METAL]
    return 'metal';
    #[else]
    return 'glsl';
    #[end]
}
