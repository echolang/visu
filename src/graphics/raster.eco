/**
 * Per-pipeline raster state. Blend and colorWrite are PSO state;
 * viewport, scissor, cull, front face, and depth are dynamic.
 */

namespace visu::graphics;

public enum CullMode
{
    case none;
    case front;
    case back;
}

public enum BlendMode
{
    case none;
    case alpha;
    case premultiplied;
    case additive;
}

public enum Compare
{
    case never;
    case less;
    case equal;
    case lessEqual;
    case greater;
    case notEqual;
    case greaterEqual;
    case always;
}

public enum FrontFace
{
    case ccw;
    case cw;
}

public struct Raster
{
    public bool $depthTest = false;
    public bool $depthWrite = true;
    public Compare $depthCompare = .less;
    public CullMode $cull = .none;
    public FrontFace $front = .ccw;
    public BlendMode $blend = .none;
    public bool $colorWrite = true;

    public static function opaque() : Raster
    {
        Raster $r = Raster();
        $r->depthTest = true;
        $r->depthWrite = true;
        $r->cull = .back;
        return $r;
    }

    public static function alpha() : Raster
    {
        Raster $r = Raster();
        $r->depthTest = true;
        $r->depthWrite = false;
        $r->blend = .alpha;
        return $r;
    }

    public static function none() : Raster
    {
        return Raster();
    }
}
