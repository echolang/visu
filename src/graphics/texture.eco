/**
 * Graph-side texture create-info. `desc` / `sampler` feed the
 * device types; identity for the pool fingerprint is `key()`.
 */

namespace visu::graphics;

public struct TextureOptions
{
    public PixelFormat $format = .rgba8;
    public Filter $min = .linear;
    public Filter $mag = .linear;
    public Wrap $wrapS = .clampToEdge;
    public Wrap $wrapT = .clampToEdge;
    public int32 $mips = 1;

    /**
     * Depth attachment defaults: depth32f, nearest, clamp, one mip.
     */
    public static function depth() : TextureOptions
    {
        return TextureOptions($format: .depth32f, $min: .nearest, $mag: .nearest);
    }

    public const function desc(int32 $width, int32 $height) : TextureDesc
    {
        TextureDesc $d = TextureDesc($format: $this->format, $width: $width, $height: $height);
        $d->mips = $this->mips;
        return $d;
    }

    public const function sampler() : SamplerDesc
    {
        SamplerDesc $s = SamplerDesc();
        $s->min = $this->min;
        $s->mag = $this->mag;
        $s->wrapS = $this->wrapS;
        $s->wrapT = $this->wrapT;
        return $s;
    }

    public const function key() : string
    {
        int32 $fmt = pixelCode($this->format);
        int32 $min = filterCode($this->min);
        int32 $mag = filterCode($this->mag);
        int32 $ws = wrapCode($this->wrapS);
        int32 $wt = wrapCode($this->wrapT);
        return "{$fmt}|{$min}|{$mag}|{$ws}|{$wt}|{$this->mips}";
    }
}
