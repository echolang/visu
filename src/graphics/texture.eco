/**
 * Graph-side texture create-info. Size and usage are filled when the pool allocates;
 * identity for the pool fingerprint is `key()`.
 */

namespace visu::graphics;

public struct TextureOptions
{
    public PixelFormat $format = .rgba8;
    public TextureKind $kind = .texture2D;
    public int32 $mips = 1;

    /**
     * Depth attachment defaults: depth32f, one mip.
     */
    public static function depth() : TextureOptions
    {
        return TextureOptions($format: .depth32f);
    }

    /**
     * Graph options for an already-created GPU texture.
     */
    public static function from(const TextureDesc& $desc) : TextureOptions
    {
        return TextureOptions($format: $desc->format, $kind: $desc->kind, $mips: $desc->mips);
    }

    public const function desc(int32 $width, int32 $height) : TextureDesc
    {
        TextureDesc $d = TextureDesc($format: $this->format, $width: $width, $height: $height);
        $d->kind = $this->kind;
        $d->mips = $this->mips;
        return $d;
    }

    public const function key() : string
    {
        int32 $fmt = pixelCode($this->format);
        int32 $kind = kindCode($this->kind);
        return "{$fmt}|{$this->mips}|{$kind}";
    }
}
