/**
 * GL enum maps for the OpenGL Gpu. Call sites write `.rgba` /
 * `ColorAttachment(0)`; this file is the only place those become
 * `gl::` constants.
 */

namespace visu::graphics;

internal function glAttachment(Attachment $a) : uint32
{
    return match ($a) {
        Attachment::color($slot) => gl::COLOR_ATTACHMENT0 + $slot->index,
        Attachment::depth => gl::DEPTH_ATTACHMENT,
        Attachment::stencil => gl::STENCIL_ATTACHMENT,
        Attachment::depthStencil => gl::DEPTH_STENCIL_ATTACHMENT,
    };
}

internal function glPixelFormat(PixelFormat $format) : uint32
{
    return match ($format) {
        PixelFormat::rgba => gl::RGBA,
        PixelFormat::r32f => gl::R32F,
        PixelFormat::depthComponent => gl::DEPTH_COMPONENT,
        PixelFormat::depthStencil => gl::DEPTH24_STENCIL8,
    };
}

internal function glTextureTarget(TextureTarget $target) : uint32
{
    return match ($target) {
        TextureTarget::texture2D => gl::TEXTURE_2D,
        TextureTarget::cubeMap => gl::TEXTURE_CUBE_MAP,
    };
}

internal function glPixelDataFormat(PixelFormat $format) : uint32
{
    return match ($format) {
        PixelFormat::rgba => gl::RGBA,
        PixelFormat::r32f => gl::RED,
        PixelFormat::depthComponent => gl::DEPTH_COMPONENT,
        PixelFormat::depthStencil => gl::DEPTH_STENCIL,
    };
}

internal function glPixelDataType(PixelFormat $format) : uint32
{
    return match ($format) {
        PixelFormat::rgba => gl::UNSIGNED_BYTE,
        PixelFormat::r32f => gl::FLOAT,
        PixelFormat::depthComponent => gl::FLOAT,
        PixelFormat::depthStencil => gl::UNSIGNED_INT_24_8,
    };
}

internal function glFilter(Filter $filter) : uint32
{
    return match ($filter) {
        Filter::nearest => gl::NEAREST,
        Filter::linear => gl::LINEAR,
        Filter::nearestMipmapNearest => gl::NEAREST_MIPMAP_NEAREST,
        Filter::nearestMipmapLinear => gl::NEAREST_MIPMAP_LINEAR,
        Filter::linearMipmapNearest => gl::LINEAR_MIPMAP_NEAREST,
        Filter::linearMipmapLinear => gl::LINEAR_MIPMAP_LINEAR,
    };
}

internal function glWrap(Wrap $wrap) : uint32
{
    return match ($wrap) {
        Wrap::repeat => gl::REPEAT,
        Wrap::mirroredRepeat => gl::MIRRORED_REPEAT,
        Wrap::clampToEdge => gl::CLAMP_TO_EDGE,
        Wrap::clampToBorder => gl::CLAMP_TO_BORDER,
    };
}

internal function framebufferStatusFrom(uint32 $code) : FramebufferStatus
{
    if ($code == gl::FRAMEBUFFER_COMPLETE) {
        return .complete;
    }

    if ($code == gl::FRAMEBUFFER_UNDEFINED) {
        return .undefined;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_ATTACHMENT) {
        return .incompleteAttachment;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT) {
        return .incompleteMissingAttachment;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_DRAW_BUFFER) {
        return .incompleteDrawBuffer;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_READ_BUFFER) {
        return .incompleteReadBuffer;
    }

    if ($code == gl::FRAMEBUFFER_UNSUPPORTED) {
        return .unsupported;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_MULTISAMPLE) {
        return .incompleteMultisample;
    }

    if ($code == gl::FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS) {
        return .incompleteLayerTargets;
    }

    return .unknown($code);
}
