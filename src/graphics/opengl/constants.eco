/**
 * GPU constants for this backend. Same names on every arm; the values
 * are OpenGL's here. App code writes visu::graphics::COLOR_BUFFER_BIT,
 * never gl::.
 */

namespace visu::graphics;

public const uint32 COLOR_BUFFER_BIT = gl::COLOR_BUFFER_BIT;
public const uint32 DEPTH_BUFFER_BIT = gl::DEPTH_BUFFER_BIT;
public const uint32 STENCIL_BUFFER_BIT = gl::STENCIL_BUFFER_BIT;
public const uint32 TEXTURE0 = gl::TEXTURE0;
