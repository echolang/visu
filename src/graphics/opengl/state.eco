/**
 * OpenGL `Gpu`. A class so GPU objects share one cache handle.
 * The app constructs one; everyone else stores it. Call lose()
 * when the GL context dies so late destroy() skips GL deletes.
 */

namespace visu::graphics;

use visu::math::Mat4;

public class Gpu : GpuProtocol
{
    private GpuBinds $binds;
    private map<uint32, map<uint32, uint32>> $textures;
    private bool $lost;

    public constructor()
    {
        $this->lost = false;
        $this->binds = GpuBinds();
        $this->clearCache();
    }

    /**
     * The GL context is gone. Later destroy() on GPU objects
     * skips deletes.
     */
    public function lose() : void
    {
        $this->lost = true;
    }

    public const function lost() : bool
    {
        return $this->lost;
    }

    /**
     * Load the GL table. `$getProc` is os's address lookup (GLFW
     * `getProcAddress` in the default backend). Call after the
     * context is current.
     */
    public function load(extern function<ptr<uint8>(ptr<const uint8>)> $getProc) : bool
    {
        $this->lost = false;
        usize $n = gl::load($getProc);
        return $n != 0;
    }

    public function reset() : void
    {
        $this->unbindAllTextures();
        $this->clearCache();

        gl::UseProgram(0);
        gl::BindFramebuffer(gl::READ_FRAMEBUFFER, 0);
        gl::BindFramebuffer(gl::DRAW_FRAMEBUFFER, 0);
        gl::BindVertexArray(0);
        gl::BindBuffer(gl::ARRAY_BUFFER, 0);
        gl::BindBuffer(gl::ELEMENT_ARRAY_BUFFER, 0);
        gl::BindBuffer(gl::UNIFORM_BUFFER, 0);
        gl::Disable(gl::BLEND);
        gl::Disable(gl::DEPTH_TEST);
        gl::Disable(gl::CULL_FACE);
        gl::DepthMask(1);
        gl::ColorMask(1, 1, 1, 1);
        gl::ActiveTexture(gl::TEXTURE0);
        gl::BindRenderbuffer(gl::RENDERBUFFER, 0);
    }

    private function unbindAllTextures() : void
    {
        array<uint32> $units = $this->textures->keys();

        foreach ($units as $unit) {
            gl::ActiveTexture($unit);
            map<uint32, uint32> $bound = $this->textures[$unit];
            array<uint32> $targets = $bound->keys();

            foreach ($targets as $target) {
                gl::BindTexture($target, 0);
            }
        }

        gl::ActiveTexture(gl::TEXTURE0);
        gl::BindTexture(gl::TEXTURE_2D, 0);
        gl::BindTexture(gl::TEXTURE_CUBE_MAP, 0);
    }

    private function clearCache() : void
    {
        $this->binds->clear();
        $this->textures = map<uint32, map<uint32, uint32>>();
        $this->binds->textureUnit = gl::TEXTURE0;
    }

    public function useProgram(uint32 $program) : void
    {
        if ($this->binds->program == $program) {
            return;
        }

        $this->binds->program = $program;
        gl::UseProgram($program);
    }

    public function bindFramebuffer(FramebufferTarget $target, uint32 $id) : bool
    {
        return match ($target) {
            FramebufferTarget::readDraw => $this->bindReadDraw($id),
            FramebufferTarget::read => $this->bindRead($id),
            FramebufferTarget::draw => $this->bindDraw($id),
        };
    }

    private function bindReadDraw(uint32 $id) : bool
    {
        if ($this->binds->readFramebuffer == $id && $this->binds->drawFramebuffer == $id) {
            return false;
        }

        gl::BindFramebuffer(gl::FRAMEBUFFER, $id);
        $this->binds->readFramebuffer = $id;
        $this->binds->drawFramebuffer = $id;
        return true;
    }

    private function bindRead(uint32 $id) : bool
    {
        if ($this->binds->readFramebuffer == $id) {
            return false;
        }

        gl::BindFramebuffer(gl::READ_FRAMEBUFFER, $id);
        $this->binds->readFramebuffer = $id;
        return true;
    }

    private function bindDraw(uint32 $id) : bool
    {
        if ($this->binds->drawFramebuffer == $id) {
            return false;
        }

        gl::BindFramebuffer(gl::DRAW_FRAMEBUFFER, $id);
        $this->binds->drawFramebuffer = $id;
        return true;
    }

    public function bindVertexArray(uint32 $vao) : void
    {
        if ($this->binds->vertexArray == $vao) {
            return;
        }

        $this->binds->vertexArray = $vao;
        gl::BindVertexArray($vao);
    }

    public function bindVertexBuffer(uint32 $vbo) : void
    {
        if ($this->binds->vertexBuffer == $vbo) {
            return;
        }

        $this->binds->vertexBuffer = $vbo;
        gl::BindBuffer(gl::ARRAY_BUFFER, $vbo);
    }

    public function bindIndexBuffer(uint32 $ibo) : void
    {
        if ($this->binds->indexBuffer == $ibo) {
            return;
        }

        $this->binds->indexBuffer = $ibo;
        gl::BindBuffer(gl::ELEMENT_ARRAY_BUFFER, $ibo);
    }

    public function bindUniformBuffer(uint32 $ubo) : void
    {
        if ($this->binds->uniformBuffer == $ubo) {
            return;
        }

        $this->binds->uniformBuffer = $ubo;
        gl::BindBuffer(gl::UNIFORM_BUFFER, $ubo);
    }

    public function bindUniformSlot(uint32 $slot, uint32 $id) : void
    {
        if ($this->binds->boundSlots->has($slot) && $this->binds->boundSlots[$slot] == $id) {
            return;
        }

        $this->bindUniformBuffer($id);
        gl::BindBufferBase(gl::UNIFORM_BUFFER, $slot, $id);
        $this->binds->boundSlots[$slot] = $id;
    }

    public function pushUniform(uint32 $slot, ptr<const uint8> $ptr, isize $bytes) : void
    {
        fillUniformScratch($this, $this->binds, $slot, $ptr, $bytes);
    }

    public function uploadBytes(BufferUse $use, uint32 $id, ptr<const uint8> $ptr, isize $bytes) : void
    {
        if ($use == BufferUse::vertex) {
            $this->bindVertexBuffer($id);
        } else if ($use == BufferUse::index) {
            $this->bindIndexBuffer($id);
        } else {
            $this->bindUniformBuffer($id);
        }

        gl::BufferData(glBufferTarget($use), $bytes, $ptr, gl::DYNAMIC_DRAW);
    }

    private function uniformBlockIndex(uint32 $program, string $name) : uint32
    {
        string $term = $name;

        if (!$term->terminated()) {
            $term = $name->clone();
        }

        return gl::GetUniformBlockIndex($program, $term->cstr());
    }

    private function uniformBlockBinding(uint32 $program, uint32 $index, uint32 $slot) : void
    {
        gl::UniformBlockBinding($program, $index, $slot);
    }

    public function bindUniformBlock(uint32 $program, string $name, uint32 $slot) : bool
    {
        $this->useProgram($program);
        uint32 $index = $this->uniformBlockIndex($program, $name);

        if ($index == gl::INVALID_INDEX) {
            return false;
        }

        $this->uniformBlockBinding($program, $index, $slot);
        return true;
    }

    public function applyRaster(const Raster& $raster) : void
    {
        if ($this->binds->sameRaster($raster)) {
            return;
        }

        if ($raster->depthTest) {
            gl::Enable(gl::DEPTH_TEST);
        } else {
            gl::Disable(gl::DEPTH_TEST);
        }

        uint8 $depthWrite = 0;

        if ($raster->depthWrite) {
            $depthWrite = 1;
        }

        gl::DepthMask($depthWrite);

        if ($raster->cull == CullMode::none) {
            gl::Disable(gl::CULL_FACE);
        } else {
            gl::Enable(gl::CULL_FACE);

            if ($raster->cull == CullMode::front) {
                gl::CullFace(gl::FRONT);
            } else {
                gl::CullFace(gl::BACK);
            }
        }

        if ($raster->blend == BlendMode::alpha) {
            gl::Enable(gl::BLEND);
            gl::BlendFunc(gl::SRC_ALPHA, gl::ONE_MINUS_SRC_ALPHA);
        } else {
            gl::Disable(gl::BLEND);
        }

        uint8 $color = 0;

        if ($raster->colorWrite) {
            $color = 1;
        }

        gl::ColorMask($color, $color, $color, $color);
        $this->binds->rememberRaster($raster);
    }

    public function bindTexture(uint32 $unit, TextureTarget $target, uint32 $texture) : void
    {
        $this->bindTextureGl($unit, glTextureTarget($target), $texture);
    }

    private function bindTextureGl(uint32 $unit, uint32 $target, uint32 $texture) : void
    {
        if ($this->binds->textureUnit != $unit) {
            gl::ActiveTexture($unit);
            $this->binds->textureUnit = $unit;
        }

        if (!$this->textures->has($unit)) {
            $this->textures[$unit] = map<uint32, uint32>();
        }

        map<uint32, uint32>& $bound = $this->textures->at($unit);

        if ($bound->has($target) && $bound[$target] == $texture) {
            return;
        }

        gl::BindTexture($target, $texture);
        $bound[$target] = $texture;
    }

    public const function boundTexture(uint32 $unit, TextureTarget $target) : uint32
    {
        uint32 $glTarget = glTextureTarget($target);

        if (!$this->textures->has($unit)) {
            return 0;
        }

        map<uint32, uint32> $bound = $this->textures[$unit];

        if (!$bound->has($glTarget)) {
            return 0;
        }

        return $bound[$glTarget];
    }

    public function forgetTexture(uint32 $texture) : void
    {
        array<uint32> $units = $this->textures->keys();

        foreach ($units as $unit) {
            map<uint32, uint32>& $bound = $this->textures->at($unit);
            array<uint32> $targets = $bound->keys();

            foreach ($targets as $target) {
                if ($bound[$target] == $texture) {
                    $bound[$target] = 0;
                }
            }
        }
    }

    public function createVertexArray() : uint32
    {
        uint32 $id = 0;
        gl::GenVertexArrays(1, &$id);
        return $id;
    }

    public function deleteVertexArray(uint32 $id) : void
    {
        uint32 $name = $id;
        gl::DeleteVertexArrays(1, &$name);

        if ($this->binds->vertexArray == $id) {
            $this->binds->vertexArray = 0;
        }
    }

    public function createBuffer() : uint32
    {
        uint32 $id = 0;
        gl::GenBuffers(1, &$id);
        return $id;
    }

    public function deleteBuffer(uint32 $id) : void
    {
        uint32 $name = $id;
        gl::DeleteBuffers(1, &$name);
        $this->binds->dropBuffer($id);
    }

    private function bufferFloatsAt(uint32 $target, array<float32>& $data) : void
    {
        usize $n = $data->count();
        isize $bytes = ($n * mem::size<float32>()) as isize;
        ptr<const uint8> $ptr = null;

        if ($n > 0) {
            $ptr:$ = ptr<const uint8>(&$data[0]);
        }

        gl::BufferData($target, $bytes, $ptr, gl::STATIC_DRAW);
    }

    public function uploadFloats(BufferUse $use, uint32 $id, array<float32>& $data) : void
    {
        uint32 $target = glBufferTarget($use);

        if ($use == BufferUse::vertex) {
            $this->bindVertexBuffer($id);
        } else if ($use == BufferUse::index) {
            $this->bindIndexBuffer($id);
        } else {
            $this->bindUniformBuffer($id);
        }

        $this->bufferFloatsAt($target, $data);
    }

    public function applyLayout(uint32 $vao, const VertexLayout& $layout, uint32 $vertexBuf, uint32 $instanceBuf) : void
    {
        $this->bindVertexArray($vao);
        uint32 $i = 0;

        while ($i < 16) {
            gl::DisableVertexAttribArray($i);
            $i = $i + 1;
        }

        foreach ($layout->attrs as $attr) {
            uint32 $buf = $vertexBuf;

            if ($attr->divisor != 0) {
                assert($instanceBuf != 0, 'mesh: instance attrib without instance buffer');
                $buf = $instanceBuf;
            }

            $this->bindVertexBuffer($buf);
            ptr<const uint8> $offset = null;

            if ($attr->offset != 0) {
                $offset:$ = $offset:$ + ($attr->offset as isize);
            }

            gl::VertexAttribPointer($attr->location, $attr->components, gl::FLOAT, 0, $attr->stride, $offset);
            gl::EnableVertexAttribArray($attr->location);
            gl::VertexAttribDivisor($attr->location, $attr->divisor);
        }
    }

    public function drawArrays(DrawMode $mode, int32 $first, int32 $count) : void
    {
        glDrawArrays(glDrawMode($mode), $first, $count);
    }

    public function drawInstanced(DrawMode $mode, int32 $first, int32 $count, int32 $instances) : void
    {
        glDrawInstanced(glDrawMode($mode), $first, $count, $instances);
    }

    public function createTexture() : uint32
    {
        uint32 $id = 0;
        gl::GenTextures(1, &$id);
        return $id;
    }

    public function deleteTexture(uint32 $id) : void
    {
        uint32 $name = $id;
        gl::DeleteTextures(1, &$name);
        $this->forgetTexture($id);
    }

    public function texImage2D(TextureTarget $target, PixelFormat $format, int32 $width, int32 $height) : void
    {
        uint32 $glTarget = glTextureTarget($target);
        ptr<const uint8> $pixels = null;
        gl::TexImage2D(
            $glTarget,
            0,
            glPixelFormat($format) as int32,
            $width,
            $height,
            0,
            glPixelDataFormat($format),
            glPixelDataType($format),
            $pixels
        );
    }

    public function texFilter(TextureTarget $target, Filter $min, Filter $mag) : void
    {
        uint32 $glTarget = glTextureTarget($target);
        gl::TexParameteri($glTarget, gl::TEXTURE_MIN_FILTER, glFilter($min) as int32);
        gl::TexParameteri($glTarget, gl::TEXTURE_MAG_FILTER, glFilter($mag) as int32);
    }

    public function texWrap(TextureTarget $target, Wrap $s, Wrap $t) : void
    {
        uint32 $glTarget = glTextureTarget($target);
        gl::TexParameteri($glTarget, gl::TEXTURE_WRAP_S, glWrap($s) as int32);
        gl::TexParameteri($glTarget, gl::TEXTURE_WRAP_T, glWrap($t) as int32);
    }

    public function generateMipmap(TextureTarget $target) : void
    {
        gl::GenerateMipmap(glTextureTarget($target));
    }

    /**
     * Drop `$id` from the bind cache and unbind it on the GPU if it is
     * currently bound. Read and draw are independent.
     */
    public function unbindFramebuffer(uint32 $id) : void
    {
        if ($this->binds->readFramebuffer == $id && $this->binds->drawFramebuffer == $id) {
            gl::BindFramebuffer(gl::FRAMEBUFFER, 0);
            $this->binds->readFramebuffer = 0;
            $this->binds->drawFramebuffer = 0;
            return;
        }

        if ($this->binds->readFramebuffer == $id) {
            gl::BindFramebuffer(gl::READ_FRAMEBUFFER, 0);
            $this->binds->readFramebuffer = 0;
        }

        if ($this->binds->drawFramebuffer == $id) {
            gl::BindFramebuffer(gl::DRAW_FRAMEBUFFER, 0);
            $this->binds->drawFramebuffer = 0;
        }
    }

    public function viewport(int32 $x, int32 $y, int32 $width, int32 $height) : void
    {
        if ($this->binds->viewportSet && $this->binds->viewportX == $x && $this->binds->viewportY == $y && $this->binds->viewportWidth == $width && $this->binds->viewportHeight == $height) {
            return;
        }

        $this->binds->viewportSet = true;
        $this->binds->viewportX = $x;
        $this->binds->viewportY = $y;
        $this->binds->viewportWidth = $width;
        $this->binds->viewportHeight = $height;
        gl::Viewport($x, $y, $width, $height);
    }

    public function clearColor(float32 $r, float32 $g, float32 $b, float32 $a) : void
    {
        if ($this->binds->clearColorSet && $this->binds->clearR == $r && $this->binds->clearG == $g && $this->binds->clearB == $b && $this->binds->clearA == $a) {
            return;
        }

        $this->binds->clearColorSet = true;
        $this->binds->clearR = $r;
        $this->binds->clearG = $g;
        $this->binds->clearB = $b;
        $this->binds->clearA = $a;
        gl::ClearColor($r, $g, $b, $a);
    }

    public function clear(uint32 $mask) : void
    {
        gl::Clear($mask);
    }

    public function createFramebuffer() : uint32
    {
        uint32 $id = 0;
        gl::GenFramebuffers(1, &$id);
        return $id;
    }

    public function deleteFramebuffer(uint32 $id) : void
    {
        uint32 $name = $id;
        gl::DeleteFramebuffers(1, &$name);
        $this->unbindFramebuffer($id);
    }

    public function createRenderbuffer() : uint32
    {
        uint32 $id = 0;
        gl::GenRenderbuffers(1, &$id);
        return $id;
    }

    public function deleteRenderbuffer(uint32 $id) : void
    {
        uint32 $name = $id;
        gl::DeleteRenderbuffers(1, &$name);

        if ($this->binds->renderbuffer == $id) {
            $this->binds->renderbuffer = 0;
        }
    }

    public function bindRenderbuffer(uint32 $id) : void
    {
        if ($this->binds->renderbuffer == $id) {
            return;
        }

        $this->binds->renderbuffer = $id;
        gl::BindRenderbuffer(gl::RENDERBUFFER, $id);
    }

    public function renderbufferStorage(PixelFormat $format, int32 $width, int32 $height) : void
    {
        gl::RenderbufferStorage(gl::RENDERBUFFER, glPixelFormat($format), $width, $height);
    }

    public function framebufferRenderbuffer(Attachment $point, uint32 $renderbuffer) : void
    {
        gl::FramebufferRenderbuffer(gl::FRAMEBUFFER, glAttachment($point), gl::RENDERBUFFER, $renderbuffer);
    }

    public function framebufferTexture2D(Attachment $point, TextureTarget $target, uint32 $texture, int32 $level) : void
    {
        gl::FramebufferTexture2D(gl::FRAMEBUFFER, glAttachment($point), glTextureTarget($target), $texture, $level);
    }

    public function framebufferStatus() : FramebufferStatus
    {
        uint32 $code = gl::CheckFramebufferStatus(gl::FRAMEBUFFER);
        return framebufferStatusFrom($code);
    }

    public function drawBuffers(const array<Attachment>& $colors) : void
    {
        array<uint32> $bufs = array<uint32>();

        foreach ($colors as $a) {
            $bufs->push(glAttachment($a));
        }

        $this->applyDrawBuffers($bufs);
    }

    public function drawBuffers(ColorSpan $colors) : void
    {
        array<uint32> $bufs = array<uint32>();

        uint32 $i = $colors->from;

        while ($i < $colors->toExclusive) {
            $bufs->push(gl::COLOR_ATTACHMENT0 + $i);
            $i = $i + 1;
        }

        $this->applyDrawBuffers($bufs);
    }

    private function applyDrawBuffers(array<uint32> $bufs) : void
    {
        int32 $n = $bufs->count() as int32;

        if ($n == 0) {
            gl::DrawBuffer(gl::NONE);
            return;
        }

        gl::DrawBuffers($n, &$bufs[0]);
    }

    public function createShader(ShaderKind $kind) : uint32
    {
        return gl::CreateShader(glShaderKind($kind));
    }

    public function deleteShader(uint32 $id) : void
    {
        gl::DeleteShader($id);
    }

    public function shaderSource(uint32 $id, string $source) : void
    {
        string $term = $source;

        if (!$term->terminated()) {
            $term = $source->clone();
        }

        ptr<const uint8> $cstr = $term->cstr();
        int32 $len = $term->size() as int32;
        gl::ShaderSource($id, 1, &$cstr, &$len);
    }

    public function compileShader(uint32 $id) : void
    {
        gl::CompileShader($id);
    }

    internal function shaderIv(uint32 $id, uint32 $pname) : int32
    {
        int32 $value = 0;
        gl::GetShaderiv($id, $pname, &$value);
        return $value;
    }

    public function shaderCompiled(uint32 $id) : bool
    {
        return $this->shaderIv($id, gl::COMPILE_STATUS) == (gl::TRUE as int32);
    }

    public function shaderInfoLog(uint32 $id) : string
    {
        return glShaderInfoLog($id);
    }

    public function createProgram() : uint32
    {
        return gl::CreateProgram();
    }

    public function deleteProgram(uint32 $id) : void
    {
        gl::DeleteProgram($id);

        if ($this->binds->program == $id) {
            $this->binds->program = 0;
        }
    }

    public function attachShader(uint32 $program, uint32 $shader) : void
    {
        gl::AttachShader($program, $shader);
    }

    public function linkProgram(uint32 $id) : void
    {
        gl::LinkProgram($id);
    }

    internal function programIv(uint32 $id, uint32 $pname) : int32
    {
        int32 $value = 0;
        gl::GetProgramiv($id, $pname, &$value);
        return $value;
    }

    public function programLinked(uint32 $id) : bool
    {
        return $this->programIv($id, gl::LINK_STATUS) == (gl::TRUE as int32);
    }

    public function programInfoLog(uint32 $id) : string
    {
        return glProgramInfoLog($id);
    }

    public function uniformLocation(uint32 $program, string $name) : int32
    {
        string $term = $name;

        if (!$term->terminated()) {
            $term = $name->clone();
        }

        return gl::GetUniformLocation($program, $term->cstr());
    }

    public function uniform1f(int32 $location, float32 $v) : void
    {
        gl::Uniform1f($location, $v);
    }

    public function uniform1i(int32 $location, int32 $v) : void
    {
        gl::Uniform1i($location, $v);
    }

    public function uniform2f(int32 $location, float32 $a, float32 $b) : void
    {
        gl::Uniform2f($location, $a, $b);
    }

    public function uniform3f(int32 $location, float32 $a, float32 $b, float32 $c) : void
    {
        gl::Uniform3f($location, $a, $b, $c);
    }

    public function uniform4f(int32 $location, float32 $a, float32 $b, float32 $c, float32 $d) : void
    {
        gl::Uniform4f($location, $a, $b, $c, $d);
    }

    public function uniform2i(int32 $location, int32 $a, int32 $b) : void
    {
        gl::Uniform2i($location, $a, $b);
    }

    public function uniform3i(int32 $location, int32 $a, int32 $b, int32 $c) : void
    {
        gl::Uniform3i($location, $a, $b, $c);
    }

    public function uniform4i(int32 $location, int32 $a, int32 $b, int32 $c, int32 $d) : void
    {
        gl::Uniform4i($location, $a, $b, $c, $d);
    }

    public function uniform4fv(int32 $location, int32 $count, ptr<const float32> $ptr) : void
    {
        gl::Uniform4fv($location, $count, $ptr);
    }

    public function uniformMat4(int32 $location, bool $transpose, const Mat4& $m) : void
    {
        uint8 $t = 0;

        if ($transpose) {
            $t = 1;
        }

        gl::UniformMatrix4fv($location, 1, $t, &$m->c0->x);
    }
}

internal function glDrawArrays(uint32 $mode, int32 $first, int32 $count) : void
{
    // copy the proc off the commands struct first. calling
    // DrawArrays through that field drops the draw
    extern function<void(uint32, int32, int32)> $draw = gl::state::$commands->DrawArrays;
    $draw($mode, $first, $count);
}

internal function glDrawInstanced(uint32 $mode, int32 $first, int32 $count, int32 $instances) : void
{
    extern function<void(uint32, int32, int32, int32)> $draw = gl::state::$commands->DrawArraysInstanced;
    $draw($mode, $first, $count, $instances);
}
