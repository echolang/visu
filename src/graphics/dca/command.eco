/**
 * What `DrawCallAssembler.build` produces: a mesh range plus the slice of the instance stream that draws it.
 */

namespace visu::graphics;

use visu::geo::AABB;
use visu::math::Vec3;

/**
 * Index into the assembler's mesh table.
 */
public struct MeshHandle
{
    public const int32 $index;

    public static function none() : MeshHandle
    {
        return MeshHandle(-1);
    }

    public const function valid() : bool
    {
        return $this->index >= 0;
    }
}

/**
 * Mesh list one or more assemblers submit against. Arrays copy on assignment, so the table
 * is a class: `shareMeshes` hands out this handle and later `register`s stay visible.
 */
internal class MeshTable
{
    private array<RegisteredMesh> $meshes;

    /**
     * Slots `remove` gave back, reused by the next `add` so a scene that keeps rebuilding
     * runtime models never walks the mesh index out of its sort-key bits.
     */
    private array<int32> $free;

    /**
     * Every slot in sort-key order (material, then slot), rebuilt by `order` after a change.
     * A depth-free list buckets its submissions in this order instead of sorting them.
     */
    private array<uint32> $sorted;
    private array<uint64> $sortKeys;
    private array<uint32> $sortScratch;
    private bool $dirty;

    public constructor()
    {
        $this->meshes = array<RegisteredMesh>();
        $this->free = array<int32>();
        $this->sorted = array<uint32>();
        $this->sortKeys = array<uint64>();
        $this->sortScratch = array<uint32>();
        $this->dirty = true;
    }

    public function add(RegisteredMesh $mesh) : int32
    {
        if ($this->free->count() > 0) {
            usize $last = $this->free->count() - 1;
            int32 $reused = $this->free[$last];
            $this->free->pop();
            $this->meshes[$reused as usize] = $mesh;
            $this->dirty = true;
            return $reused;
        }

        int32 $index = $this->meshes->count() as int32;
        // sortKey gives the mesh 16 bits (20..35); past that it would bleed into the material
        assert($index < DCA_MESH_MAX, 'dca: mesh table full');
        $this->meshes[] = $mesh;
        $this->dirty = true;
        return $index;
    }

    /**
     * Give a slot back. Nothing may submit its handle afterwards; the stale entry is overwritten
     * by the next `add`.
     */
    public function remove(int32 $index) : void
    {
        assert($index >= 0 && $index < ($this->meshes->count() as int32), 'dca: remove handle');
        $this->free[] = $index;
        $this->dirty = true;
    }

    public const function freeCount() : int32
    {
        return $this->free->count() as int32;
    }

    public const function get(int32 $index) : RegisteredMesh
    {
        return $this->meshes[$index as usize];
    }

    /**
     * Borrow a registered range. Valid until the next `add` or `remove`.
     */
    public const function at(int32 $index) : const RegisteredMesh&
    {
        return $this->meshes[$index as usize];
    }

    public const function count() : int32
    {
        return $this->meshes->count() as int32;
    }

    public function clear() : void
    {
        $this->meshes->clear();
        $this->free->clear();
        $this->dirty = true;
    }

    /**
     * Slots ordered by `sortKey(material, slot, 0)`. Freed slots stay in; nothing submits them.
     * Rebuilt only after an `add`, `remove` or `clear`, so a steady scene never sorts here.
     */
    public function order() : const array<uint32>&
    {
        if (!$this->dirty) {
            return $this->sorted;
        }

        usize $n = $this->meshes->count();
        $this->sorted->clear();
        $this->sortKeys->clear();
        $this->sorted->reserve($n);
        $this->sortKeys->reserve($n);
        usize $i = 0;
        while ($i < $n) {
            $this->sorted[] = $i as uint32;
            $this->sortKeys[] = sortKey($this->meshes[$i]->material, $i as int32, 0);
            $i = $i + 1;
        }

        sortByKey($this->sorted, $this->sortKeys, $this->sortScratch);
        $this->dirty = false;
        return $this->sorted;
    }
}

/**
 * A registered range of one mesh: a vertex range, or an index range when `$indexed`.
 * `$material` is the caller's batch key; commands never merge across it and the sort puts it above the mesh.
 * `$radius` is the bounding-sphere radius of `$bounds` around its centre, precomputed because culling reads it once per submission.
 */
public class RegisteredMesh
{
    public Mesh $mesh;
    public int32 $first;
    public int32 $count;
    public bool $indexed;
    public int32 $material;
    public AABB $bounds;
    public Vec3 $centre;
    public float32 $radius;

    public constructor(Mesh $mesh, int32 $first, int32 $count, bool $indexed, int32 $material, const AABB& $bounds)
    {
        $this->mesh = $mesh;
        $this->first = $first;
        $this->count = $count;
        $this->indexed = $indexed;
        $this->material = $material;
        $this->bounds = $bounds;
        $this->centre = $bounds->center();
        Vec3 $half = ($bounds->max - $bounds->min) * 0.5f;
        $this->radius = visu::math::length($half);
    }
}

/**
 * One draw: `$instanceCount` copies of a mesh range. `$material` is the registered mesh's batch key.
 */
public struct DrawCommand
{
    public int32 $mesh;
    public int32 $material;
    public int32 $first;
    public int32 $count;
    public int32 $instanceOffset;
    public int32 $instanceCount;
}

/**
 * One `submit`, before culling and sorting.
 */
public struct Submission<P>
{
    public int32 $mesh;
    public visu::math::Mat4 $model;
    public P $payload;
    public float32 $sortBias;
}
