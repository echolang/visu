/**
 * CPU-side rgba8 image, top-left origin. Swizzle of Device.readbackTexture
 * bytes, then PNG write / load for dump.
 */

namespace visu::graphics;

use std::io;

public struct Pixels
{
    public const int32 $width;
    public const int32 $height;
    public array<uint8> $rgba;

    /**
     * Native readback bytes → packed rgba8. rgba8 / rgba8Srgb
     * identity, bgra8 swaps R/B, r8 expands to gray. Float formats
     * clamp to 0..1 — enough to eyeball a GBuffer or an IBL bake,
     * not a tone mapper.
     */
    public static function from(
        PixelFormat $format,
        int32 $width,
        int32 $height,
        const array<uint8>& $raw
    ) : result<Pixels, DumpError>
    {
        if ($width <= 0 || $height <= 0) {
            return .error(.empty);
        }

        uint64 $want = pixelsRawSize($format, $width, $height);
        if ($want == 0) {
            return .error(.unsupported($format));
        }

        if ($raw->count() != $want as usize) {
            return .error(.sizeMismatch($raw->count() as uint64, $want));
        }

        array<uint8> $rgba = guard pixelsSwizzle($format, $raw) else ($e) {
            return .error($e);
        }
        return .ok(Pixels($width, $height, $rgba));
    }

    public static function load(const string& $path) : result<Pixels, DumpError>
    {
        int32 $w = 0;
        int32 $h = 0;
        ptr<uint8> $data = null;
        string $cpath = $path->clone();
        int32 $ok = visu_png_load(pixelsCstr($cpath), &$w, &$h, &$data);

        if ($ok == 0 || $data:$ == null || $w <= 0 || $h <= 0) {
            return .error(.io($path, 'png load failed'));
        }

        uint64 $n = (($w as uint64) * ($h as uint64)) * 4;
        array<uint8> $rgba = pixelsFilled($n);
        mem::copy<uint8>(ptr<uint8>(&$rgba[0]), $data, $n);
        visu_png_free($data);
        return .ok(Pixels($w, $h, $rgba));
    }

    public const function write(const string& $path) : status<DumpError>
    {
        if ($this->width <= 0 || $this->height <= 0 || $this->rgba->empty()) {
            return .error(.empty);
        }

        guard pixelsEnsureParent($path) else ($e) {
            return .error($e);
        }
        string $cpath = $path->clone();
        int32 $ok = visu_png_write(
            pixelsCstr($cpath),
            $this->width,
            $this->height,
            ptr<const uint8>(&$this->rgba[0])
        );

        if ($ok == 0) {
            return .error(.io($path, 'png write failed'));
        }

        return .ok;
    }
}

internal function pixelsRawSize(PixelFormat $format, int32 $width, int32 $height) : uint64
{
    if ($format->isDepth()) {
        return 0;
    }

    uint32 $bpp = pixelByteCount($format);

    if ($bpp == 0) {
        return 0;
    }

    return (($width as uint64) * ($height as uint64)) * ($bpp as uint64);
}

internal function pixelsSwizzle(
    PixelFormat $format,
    const array<uint8>& $raw
) : result<array<uint8>, DumpError>
{
    // channel order is the one thing the format accessors do not carry
    if ($format == PixelFormat::bgra8) {
        return .ok(pixelsSwapRb($raw));
    }

    usize $channels = $format->channels() as usize;

    if ($format->component() == Component::unorm8) {
        if ($channels == 4) {
            return .ok($raw->clone());
        }

        return .ok(pixelsExpandR8($raw));
    }

    if ($format->component() == Component::float32) {
        return .ok(pixelsFromFloat32($raw, $channels));
    }

    if ($format->component() == Component::half) {
        return .ok(pixelsFromFloat16($raw, $channels));
    }

    return .error(.unsupported($format));
}

/** 0..1 clamp then 8-bit quantize; missing channels read black, alpha opaque */
internal function pixelsChannelByte(float32 $value) : uint8
{
    if ($value <= 0.0f) {
        return 0;
    }

    if ($value >= 1.0f) {
        return 255;
    }

    return ($value * 255.0f) as uint8;
}

internal function pixelsFromFloat32(const array<uint8>& $raw, usize $channels) : array<uint8>
{
    usize $texels = $raw->count() / ($channels * 4);
    array<uint8> $out = pixelsFilled(($texels * 4) as uint64);
    ptr<const float32> $src = ptr<const float32>(&$raw[0]);
    usize $i = 0;

    while ($i < $texels) {
        usize $o = $i * 4;
        usize $s = $i * $channels;
        usize $c = 0;

        while ($c < $channels && $c < 4) {
            $out[$o + $c] = pixelsChannelByte($src:$[$s + $c]);
            $c = $c + 1;
        }

        if ($channels < 4) {
            $out[$o + 3] = 255;
        }

        $i = $i + 1;
    }

    return $out;
}

internal function pixelsFromFloat16(const array<uint8>& $raw, usize $channels) : array<uint8>
{
    usize $texels = $raw->count() / ($channels * 2);
    array<uint8> $out = pixelsFilled(($texels * 4) as uint64);
    ptr<const uint16> $src = ptr<const uint16>(&$raw[0]);
    usize $i = 0;

    while ($i < $texels) {
        usize $o = $i * 4;
        usize $s = $i * $channels;
        usize $c = 0;

        while ($c < $channels && $c < 4) {
            $out[$o + $c] = pixelsChannelByte(pixelsHalfToFloat($src:$[$s + $c]));
            $c = $c + 1;
        }

        if ($channels < 4) {
            $out[$o + 3] = 255;
        }

        $i = $i + 1;
    }

    return $out;
}

/**
 * IEEE float to half, truncating the mantissa. Subnormals flush to
 * zero and anything above the half range saturates at 65504, which is
 * what radiance data wants anyway.
 */
internal function pixelsFloatToHalf(float32 $value) : uint16
{
    float32 $local = $value;
    ptr<const uint32> $word = ptr<const uint32>(&$local);
    uint32 $bits = $word:$[0];
    uint32 $sign = ($bits >> 16) & 32768;
    uint32 $rest = $bits & 2147483647;

    // >= 2^16 in float32 exponent terms: saturate rather than make an inf
    if ($rest >= 1199570944) {
        return ($sign | 31743) as uint16;
    }

    // below the smallest half normal
    if ($rest < 947912704) {
        return $sign as uint16;
    }

    uint32 $exponent = (($rest >> 23) - 112) << 10;
    uint32 $mantissa = ($rest >> 13) & 1023;
    return ($sign | $exponent | $mantissa) as uint16;
}

/** IEEE half to float; denormals and NaN land on 0, which is fine for a dump */
internal function pixelsHalfToFloat(uint16 $half) : float32
{
    uint32 $exponent = (($half as uint32) >> 10) & 31;
    uint32 $mantissa = ($half as uint32) & 1023;
    bool $negative = (($half as uint32) & 32768) != 0;

    if ($exponent == 0) {
        return 0.0f;
    }

    if ($exponent == 31) {
        if ($negative) {
            return 0.0f;
        }

        return 65504.0f;
    }

    float32 $value = 1.0f + ($mantissa as float32) / 1024.0f;
    int32 $power = ($exponent as int32) - 15;

    while ($power > 0) {
        $value = $value * 2.0f;
        $power = $power - 1;
    }

    while ($power < 0) {
        $value = $value * 0.5f;
        $power = $power + 1;
    }

    if ($negative) {
        return -$value;
    }

    return $value;
}

internal function pixelsSwapRb(const array<uint8>& $raw) : array<uint8>
{
    array<uint8> $out = $raw->clone();
    usize $n = $out->count();
    usize $i = 0;

    while ($i + 3 < $n) {
        uint8 $r = $out[$i];
        $out[$i] = $out[$i + 2];
        $out[$i + 2] = $r;
        $i = $i + 4;
    }

    return $out;
}

internal function pixelsExpandR8(const array<uint8>& $raw) : array<uint8>
{
    usize $n = $raw->count();
    array<uint8> $out = pixelsFilled(($n * 4) as uint64);
    usize $i = 0;

    while ($i < $n) {
        uint8 $v = $raw[$i];
        usize $o = $i * 4;
        $out[$o] = $v;
        $out[$o + 1] = $v;
        $out[$o + 2] = $v;
        $out[$o + 3] = 255;
        $i = $i + 1;
    }

    return $out;
}

internal function pixelsCstr(string& $path) : ptr<const uint8>
{
    $path->reserve($path->size() + 1);
    ptr<uint8> $tail = $path->spare();
    $tail:$[0] = 0;
    return ptr<const uint8>($path->data());
}

internal function pixelsFilled(uint64 $n) : array<uint8>
{
    array<uint8> $out = array<uint8>();
    $out->reserve($n as usize);
    uint64 $i = 0;

    while ($i < $n) {
        $out[] = 0;
        $i = $i + 1;
    }

    return $out;
}

internal function pixelsEnsureParent(const string& $path) : status<DumpError>
{
    usize $n = $path->size();
    usize $i = $n;
    usize $slash = $n;

    while ($i > 0) {
        $i = $i - 1;
        uint8 $b = $path->byte($i);

        if ($b == 47) {
            $slash = $i;
            break;
        }
    }

    if ($slash == $n || $slash == 0) {
        return .ok;
    }

    string $dir = $path->sub(0, $slash)->clone();
    guard io::mkdir($dir) else ($e) {
        if ($e->exists()) {
            return .ok;
        }

        return .error(.io($path, $e->message()));
    }

    return .ok;
}
