/**
 * This frame's GBuffer fillers, a mailbox the renderer publishes before the fill callback and
 * drains in one `GeometryPass`. Owned by the renderer and reset every frame, so joining never
 * allocates once the list has grown to the scene's systems.
 */

namespace visu::graphics;

public class GeometryFillers
{
    public array<GeometryFiller> $list;

    public constructor()
    {
        $this->list = arr::room<GeometryFiller>(8);
    }

    public function reset() : void
    {
        $this->list->clear();
    }

    /**
     * Join this frame's geometry fill. Fillers record in the order they join.
     */
    public function add(GeometryFiller $filler) : void
    {
        $this->list[] = $filler;
    }
}
