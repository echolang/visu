/**
 * The environment cube and the image-based-lighting states baked from it.
 * An HDRI or a handed-in cube has one state. A procedural probe has one state per prebaked sun
 * position and reuses the cube as scratch while it renders them. `DeferredRenderer.setEnvironment`
 * constructs one and takes ownership of the source texture.
 */

namespace visu::graphics;

use visu::math::Vec3;

/**
 * How the environment cube is produced. HDRI unwraps once then becomes `cube` after the
 * source texture is released; a probe re-renders the cube per sun state.
 */
internal enum EnvironmentSource
{
    case hdri(Texture $equirect);
    case cube;
    case probe(
        Vec3 $position,
        Texture $depth,
        function<void(RenderContext, RenderEncoder, ProbeCapture)> $capture
    );
}

/**
 * One baked lighting state: the sun it was captured under and its two convolved cubes.
 */
internal class IblState
{
    public Vec3 $direction;
    public Texture $irradiance;
    public Texture $prefilter;

    /**
     * The maps hold a finished bake. Stays true while `$dirty`, so the stale maps keep lighting the
     * scene until the fresh bake lands instead of dropping back to sun-only shading.
     */
    public bool $ready;

    /**
     * The atmosphere changed since this state was baked.
     */
    public bool $dirty;

    public constructor(Device $device, Vec3 $direction, int32 $index, const IblQuality& $ibl)
    {
        uint32 $usage = TEXTURE_SAMPLED | TEXTURE_RENDER_TARGET | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
        string $irradianceName = "ibl.irradiance.{$index}";
        TextureDesc $irradiance = TextureDesc(
            $format: .rgba16f,
            $width: $ibl->irradianceSize,
            $height: $ibl->irradianceSize
        );
        $irradiance->kind = .cube;
        $irradiance->usage = $usage;
        $irradiance->label = $irradianceName;
        string $prefilterName = "ibl.prefilter.{$index}";
        TextureDesc $prefilter = TextureDesc(
            $format: .rgba16f,
            $width: $ibl->prefilterSize,
            $height: $ibl->prefilterSize
        );
        $prefilter->kind = .cube;
        $prefilter->mips = $ibl->prefilterMips;
        $prefilter->usage = $usage;
        $prefilter->label = $prefilterName;
        $this->direction = $direction;
        $this->irradiance = Texture($device, $irradianceName, $irradiance);
        $this->prefilter = Texture($device, $prefilterName, $prefilter);
        $this->ready = false;
        $this->dirty = false;
    }

    /**
     * Needs a bake, first or fresh.
     */
    public const function pending() : bool
    {
        return !$this->ready || $this->dirty;
    }

    public function destroy() : void
    {
        $this->irradiance->destroy();
        $this->prefilter->destroy();
    }
}

internal class Environment
{
    public Texture $cube;

    /**
     * The cube holds `$cubeState`. False while it waits for its first render or a fresh one.
     */
    public bool $ready;
    public int32 $cubeState;
    public array<IblState> $states;
    public Texture $brdf;
    public bool $brdfReady;

    /**
     * Prefilter mips already convolved for `$cubeState`; irradiance goes with the first batch.
     */
    public int32 $iblStep;
    public IblQuality $ibl;

    public EnvironmentSource $source;
    public Sky $sky;
    public IblBlend $blend;
    private uint64 $cubeFrame;

    /**
     * Equirectangular HDRI: the cube is allocated empty and filled on the next frame.
     * Takes ownership of `$equirect`.
     */
    public constructor(hdri: Device $device, Texture $equirect, int32 $size, IblQuality $ibl)
    {
        assert($size > 0, 'environment size');
        $this->cube = environmentCube($device, $size);
        $this->ready = false;
        $this->cubeState = 0;
        $this->states = singleState($device, $ibl);
        $this->brdf = brdfTexture($device, $ibl);
        $this->brdfReady = false;
        $this->iblStep = 0;
        $this->ibl = $ibl;
        $this->source = .hdri($equirect);
        $this->sky = Sky();
        $this->blend = IblBlend();
        $this->cubeFrame = 0;
    }

    /**
     * An already-baked cube. Takes ownership of `$cube`.
     */
    public constructor(Device $device, Texture $cube, IblQuality $ibl)
    {
        assert($cube->cube(), 'Environment needs a cube texture');
        $this->cube = $cube;
        $this->ready = true;
        $this->cubeState = 0;
        $this->states = singleState($device, $ibl);
        $this->brdf = brdfTexture($device, $ibl);
        $this->brdfReady = false;
        $this->iblStep = 0;
        $this->ibl = $ibl;
        $this->source = .cube;
        $this->sky = Sky();
        $this->blend = IblBlend();
        $this->cubeFrame = 0;
    }

    /**
     * Probe at `$position`: one state per sun travel direction in `$suns`, each rendered from the
     * sky plus whatever `$capture` draws, then convolved. The cube is scratch shared by all.
     */
    public constructor(
        probe: Device $device,
        Sky $sky,
        Vec3 $position,
        const array<Vec3>& $suns,
        function<void(RenderContext, RenderEncoder, ProbeCapture)> $capture,
        int32 $size,
        IblQuality $ibl
    )
    {
        assert($size > 0, 'environment size');
        assert($suns->count() > 0, 'probe needs at least one sun');
        $this->cube = environmentCube($device, $size);
        $this->ready = false;
        $this->cubeState = 0;
        array<IblState> $states = array<IblState>();
        int32 $i = 0;
        int32 $n = $suns->count() as int32;

        while ($i < $n) {
            $states[] = IblState($device, $suns[$i as usize], $i, $ibl);
            $i = $i + 1;
        }

        $this->states = $states;
        $this->brdf = brdfTexture($device, $ibl);
        $this->brdfReady = false;
        $this->iblStep = 0;
        $this->ibl = $ibl;
        $this->source = .probe($position, makeProbeDepth($device, $size), $capture);
        $this->sky = $sky;
        $this->blend = IblBlend();
        $this->cubeFrame = 0;
    }

    internal const function isProbe() : bool
    {
        return match ($this->source) {
            EnvironmentSource::probe($position, $depth, $capture) => true,
            else => false,
        };
    }

    internal const function count() : int32
    {
        return $this->states->count() as int32;
    }

    /**
     * A blend index clamped into the state list, so a stale blend cannot index past it.
     */
    internal const function clampState(int32 $index) : int32
    {
        if ($index < 0) {
            return 0;
        }

        int32 $last = $this->count() - 1;

        if ($index > $last) {
            return $last;
        }

        return $index;
    }

    internal const function lighting() : Lighting
    {
        IblState $from = $this->states[$this->clampState($this->blend->from) as usize];
        IblState $to = $this->states[$this->clampState($this->blend->to) as usize];

        if ($from->ready && $to->ready) {
            return .ibl;
        }

        if (!$this->isProbe() && $this->ready) {
            return .environment;
        }

        return .sun;
    }

    /**
     * The state whose cube should be rendered next: the two blended ones first, then ring order.
     * Negative when every state is baked.
     */
    internal const function nextState() : int32
    {
        int32 $from = $this->clampState($this->blend->from);
        int32 $to = $this->clampState($this->blend->to);

        if ($this->states[$from as usize]->pending()) {
            return $from;
        }

        if ($this->states[$to as usize]->pending()) {
            return $to;
        }

        int32 $i = 0;
        int32 $n = $this->count();

        while ($i < $n) {
            if ($this->states[$i as usize]->pending()) {
                return $i;
            }

            $i = $i + 1;
        }

        return -1;
    }

    /**
     * True when this frame should render the cube: the first HDRI unwrap, or a probe state whose
     * cube is not the one currently held.
     */
    internal const function wantsCubeBake() : bool
    {
        if (!$this->isProbe()) {
            return !$this->ready;
        }

        int32 $next = $this->nextState();

        if ($next < 0) {
            return false;
        }

        return !$this->ready || $this->cubeState != $next;
    }

    /**
     * The state the held cube still has to be convolved into, or negative.
     */
    internal const function pendingState() : int32
    {
        if (!$this->ready) {
            return -1;
        }

        if (!$this->states[$this->cubeState as usize]->pending()) {
            return -1;
        }

        return $this->cubeState;
    }

    internal function equirect() : Texture
    {
        EnvironmentSource $src = $this->source;
        match ($src) {
            EnvironmentSource::hdri($tex) => {
                return $tex;
            },
            else => {
                assert(false, 'environment: equirect only on an HDRI source');
                return $this->cube;
            },
        };
    }

    internal function cubeDone(int32 $state) : void
    {
        $this->ready = true;
        $this->cubeState = $state;
        $this->cubeFrame = $this->cube->device->frameIndex();
        $this->iblStep = 0;
    }

    /**
     * The cube was written this frame; give the GPU a frame before sampling it.
     */
    internal const function cubeJustBaked(uint64 $frame) : bool
    {
        return $this->ready && $this->cubeFrame == $frame;
    }

    internal function stateDone(int32 $state) : void
    {
        IblState $done = $this->states[$state as usize];
        $done->ready = true;
        $done->dirty = false;
        $this->iblStep = 0;
    }

    /**
     * Adopts the renderer's sky. A changed atmosphere invalidates every state; a moved sun does not,
     * the states carry their own directions.
     */
    internal function updateSky(const Sky& $sky) : void
    {
        if (!$this->sky->sameAtmosphere($sky)) {
            $this->invalidate();
        }

        $this->sky = $sky;
    }

    /**
     * Re-seat the prebaked sun travel directions and queue a fresh bake of every state.
     * For a sky whose sun moves with the season: the directions a probe set was baked for go
     * stale as declination drifts, and re-supplying them through `setEnvironment` would destroy
     * textures the frames in flight still reference. Ready maps stay bound while these re-bake,
     * so the scene never drops to sun-only shading.
     * False when this is not a procedural probe set, or the count does not match.
     */
    internal function updateSuns(const array<Vec3>& $suns) : bool
    {
        if (!$this->isProbe() || $suns->count() != $this->states->count()) {
            return false;
        }

        int32 $i = 0;
        int32 $n = $this->count();

        while ($i < $n) {
            // IblState is a class, so this writes through the handle the array holds
            IblState $state = $this->states[$i as usize];
            $state->direction = $suns[$i as usize];
            $i = $i + 1;
        }

        $this->invalidate();
        return true;
    }

    /**
     * Re-bake every state. Ready maps stay bound until their replacement lands.
     */
    internal function invalidate() : void
    {
        foreach ($this->states as $state) {
            $state->dirty = true;
        }

        if ($this->isProbe()) {
            $this->ready = false;
        }

        $this->iblStep = 0;
    }

    /**
     * Frees the equirectangular source once every frame that sampled it is off the GPU.
     * Destroying a texture the current command buffer still references is a use-after-free on Vulkan.
     */
    internal function releaseEquirect() : void
    {
        if (!$this->ready) {
            return;
        }

        if ($this->cube->device->frameIndex() <= $this->cubeFrame + (FRAMES_IN_FLIGHT as uint64)) {
            return;
        }

        EnvironmentSource $src = $this->source;
        match ($src) {
            EnvironmentSource::hdri($tex) => {
                dropTexture($tex);
                $this->source = .cube;
            },
            else => {
            },
        };
    }

    internal function destroy() : void
    {
        $this->cube->destroy();

        foreach ($this->states as $state) {
            $state->destroy();
        }

        $this->brdf->destroy();
        match ($this->source) {
            EnvironmentSource::hdri($tex) => {
                dropTexture($tex);
            },
            EnvironmentSource::probe($position, $depth, $capture) => {
                $depth->destroy();
            },
            EnvironmentSource::cube => {
            },
        };
        $this->source = .cube;
        $this->ready = false;
        $this->brdfReady = false;
        $this->iblStep = 0;
    }
}

internal function environmentCube(Device $device, int32 $size) : Texture
{
    TextureDesc $desc = TextureDesc($format: .rgba16f, $width: $size, $height: $size);
    $desc->kind = .cube;
    $desc->mips = 1;
    if ($device->limits()->layeredMipgen) {
        $desc->mips = mipCount($size, $size);
    }

    $desc->usage = TEXTURE_SAMPLED | TEXTURE_RENDER_TARGET | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
    $desc->label = 'deferred.environment';
    return Texture($device, 'deferred.environment', $desc);
}

/**
 * Depth the probe faces render with, so geometry occludes itself inside the cube.
 */
internal function makeProbeDepth(Device $device, int32 $size) : Texture
{
    TextureDesc $desc = TextureDesc($format: .depth32f, $width: $size, $height: $size);
    $desc->usage = TEXTURE_RENDER_TARGET | TEXTURE_SAMPLED;
    $desc->label = 'deferred.probeDepth';
    return Texture($device, 'deferred.probeDepth', $desc);
}

internal function brdfTexture(Device $device, const IblQuality& $ibl) : Texture
{
    TextureDesc $brdf = TextureDesc($format: .rgba16f, $width: $ibl->brdfSize, $height: $ibl->brdfSize);
    $brdf->usage = TEXTURE_SAMPLED | TEXTURE_RENDER_TARGET | TEXTURE_TRANSFER_SRC | TEXTURE_TRANSFER_DST;
    $brdf->label = 'ibl.brdf';
    return Texture($device, 'ibl.brdf', $brdf);
}

/**
 * The one state an HDRI or a handed-in cube gets. Its direction is nominal.
 */
internal function singleState(Device $device, const IblQuality& $ibl) : array<IblState>
{
    array<IblState> $states = array<IblState>();
    $states[] = IblState($device, Vec3(0.0f, -1.0f, 0.0f), 0, $ibl);
    return $states;
}


