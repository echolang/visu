/**
 * Bind a pooled texture by graph ref. Shared by the light and SSAO passes;
 * a missing pool entry is a wiring bug surfaced as PipelineError.
 */

namespace visu::graphics;

internal function bindPooled(
    RenderContext $ctx,
    RenderEncoder $enc,
    uint32 $slot,
    TextureRef $ref,
    Sampler $sampler
) : status<PipelineError>
{
    Texture $texture = guard $ctx->pool->getTexture($ref) else ($e) {
        return .error(.pool($e));
    }
    $enc->bindTexture($slot, $texture, $sampler);
    return .ok;
}
