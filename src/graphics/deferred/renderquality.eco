/**
 * What a settings screen chooses for the renderer: the cost tiers, not the look. Ambient
 * occlusion, the sun's cascades, the god rays' march and the HDR display end's two switches (auto
 * exposure and the local operator). `DeferredRenderer.applyQuality` takes it and touches only
 * what changed, so a graphics apply that leaves these alone rebuilds nothing, and a console look
 * tweak (fog, shafts' scatter, tone contrast) survives an apply.
 */

namespace visu::graphics;

public struct RenderQuality
{
    public bool $ssao = true;
    public SsaoLevel $ssaoLevel = .medium;
    public float32 $ssaoRadius = 0.4f;
    public float32 $ssaoStrength = 2.0f;
    public bool $shadows = true;
    public int32 $shadowResolution = 2048;

    /**
     * Metres the cascades reach.
     */
    public float32 $shadowDistance = 4000.0f;
    public bool $shadowStabilize = true;
    public bool $godRays = true;

    /**
     * The god rays' march: its target scale against the scene, and its steps.
     */
    public float32 $godRayScale = 0.5f;
    public int32 $godRaySteps = 12;

    /**
     * Auto exposure and the local tone operator together. The curve runs either way.
     */
    public bool $toneMapping = false;
}
