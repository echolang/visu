/**
 * The two SSAO passes: sample the hemisphere into a single-channel buffer, then blur the noise out of it.
 * The light pass multiplies sun and ambient by the result, not emissive.
 */

namespace visu::graphics;

public class SsaoPass : Pass
{
    private DeferredGpu $gpu;
    private SsaoQuality $quality;

    public constructor(DeferredGpu $gpu, SsaoQuality $quality)
    {
        $this->gpu = $gpu;
        $this->quality = $quality;
    }

    public function name() : string
    {
        return 'deferred.ssao';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        GBufferData $gbuffer = $frame->get<GBufferData>();
        $io->reads($gbuffer->position);
        $io->reads($gbuffer->normal);
        $io->reads($gbuffer->id);
        int32 $width = ($gbuffer->target->width as float32 * $this->quality->scale) as int32;
        int32 $height = ($gbuffer->target->height as float32 * $this->quality->scale) as int32;

        if ($width < 1) {
            $width = 1;
        }

        if ($height < 1) {
            $height = 1;
        }

        TargetRef $target = $pipeline->createTarget('ssao', $width, $height);
        TextureRef $output = $pipeline->createColor($target, 'output', occlusionOptions());
        $frame->set(SsaoRawData($target, $output));
        $io->writes($target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        SsaoRawData $data = $ctx->frame->get<SsaoRawData>();
        GBufferData $gbuffer = $ctx->frame->get<GBufferData>();
        ShaderProgram $program = guard $this->gpu->shaders->program('ssao') else ($e) {
            return .error(.shader($e));
        }

        RenderEncoder $enc = guard $ctx->beginRender($data->target, overwrite: true) else ($e) {
            return .error($e);
        }
        Mesh $mesh = $this->gpu->quad;
        GpuPass $pass = $this->gpu->quadPass($program, Raster::none());
        $pass->bind($enc);
        $this->gpu->camera->bind($enc);
        $enc->upload($this->gpu->ssaoUniforms($this->quality, $data->target->width, $data->target->height), slot: 0);

        guard bindPooled($ctx, $enc, 0, $gbuffer->position, $this->gpu->point) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        guard bindPooled($ctx, $enc, 1, $gbuffer->normal, $this->gpu->point) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        guard bindPooled($ctx, $enc, 3, $gbuffer->id, $this->gpu->point) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        $enc->bindTexture(2, $this->gpu->noise, $this->gpu->noiseRepeat);
        $mesh->draw($enc);
        $enc->endRender();
        return .ok;
    }
}

public class SsaoBlurPass : Pass
{
    private DeferredGpu $gpu;

    public constructor(DeferredGpu $gpu)
    {
        $this->gpu = $gpu;
    }

    public function name() : string
    {
        return 'deferred.ssao.blur';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        SsaoRawData $raw = $frame->get<SsaoRawData>();
        $io->reads($raw->output);
        // full float between the halves, so the two passes sum like the 7 x 7 box did
        TargetRef $target = $pipeline->createTarget('ssaoBlurH', $raw->target->width, $raw->target->height);
        TextureRef $output = $pipeline->createColor($target, 'output', TextureOptions($format: .r32f));
        $frame->set(SsaoAcrossData($target, $output));
        $io->writes($target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        SsaoRawData $raw = $ctx->frame->get<SsaoRawData>();
        SsaoAcrossData $data = $ctx->frame->get<SsaoAcrossData>();
        return ssaoBlur($ctx, $this->gpu, 'ssao_blur', $data->target, $raw->output);
    }
}

/**
 * The vertical half of the separable blur: the horizontal result in, the occlusion the light
 * pass reads out.
 */
public class SsaoBlurVerticalPass : Pass
{
    private DeferredGpu $gpu;

    public constructor(DeferredGpu $gpu)
    {
        $this->gpu = $gpu;
    }

    public function name() : string
    {
        return 'deferred.ssao.blur.v';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        SsaoAcrossData $across = $frame->get<SsaoAcrossData>();
        $io->reads($across->output);
        TargetRef $target = $pipeline->createTarget('ssaoBlur', $across->target->width, $across->target->height);
        TextureRef $output = $pipeline->createColor($target, 'output', occlusionOptions());
        $frame->set(SsaoData($target, $output));
        $io->writes($target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        SsaoAcrossData $across = $ctx->frame->get<SsaoAcrossData>();
        SsaoData $data = $ctx->frame->get<SsaoData>();
        return ssaoBlur($ctx, $this->gpu, 'ssao_blur+vertical', $data->target, $across->output);
    }
}

/**
 * The horizontal half of the SSAO blur, before the vertical pass.
 */
internal class SsaoAcrossData
{
    public const TargetRef $target;
    public const TextureRef $output;

    public constructor(TargetRef $target, TextureRef $output)
    {
        $this->target = $target;
        $this->output = $output;
    }
}

/**
 * One 7-tap half of the box blur: `$source` into `$target`, every pixel written.
 */
internal function ssaoBlur(
    RenderContext $ctx,
    DeferredGpu $gpu,
    const string& $name,
    TargetRef $target,
    TextureRef $source
) : status<PipelineError>
{
    ShaderProgram $program = guard $gpu->shaders->program($name) else ($e) {
        return .error(.shader($e));
    }

    RenderEncoder $enc = guard $ctx->beginRender($target, overwrite: true) else ($e) {
        return .error($e);
    }
    Mesh $mesh = $gpu->quad;
    GpuPass $pass = $gpu->quadPass($program, Raster::none());
    $pass->bind($enc);

    guard bindPooled($ctx, $enc, 0, $source, $gpu->linear) else ($e) {
        $enc->endRender();
        return .error($e);
    }
    $mesh->draw($enc);
    $enc->endRender();
    return .ok;
}

/**
 * Single channel, linear so the blur reads between texels.
 */
internal function occlusionOptions() : TextureOptions
{
    return TextureOptions($format: .r16f);
}
