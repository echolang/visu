/**
 * Draws the procedural atmosphere behind the shaded scene. Same depth-borrow as `SkyboxPass`:
 * geometry still occludes the sky. The atmosphere is read from the sky-view table
 * (`SkyViewLut`); only the disc, the moon and the stars are evaluated per pixel.
 */

namespace visu::graphics;

internal const float32 SKY_VIEW_SAMPLES = 16.0f;
internal const float32 SKY_LIGHT_SAMPLES = 8.0f;

public class SkyPass : Pass
{
    private DeferredGpu $gpu;
    private Sky $sky;
    private HeightFog $fog;
    private DirectionalLight $sun;
    private Moon $moon;
    private TextureRef $view;
    private TextureRef? $fogSky;
    private FogLighting $fogLighting;

    public constructor(
        DeferredGpu $gpu,
        Sky $sky,
        HeightFog $fog,
        DirectionalLight $sun,
        Moon $moon,
        TextureRef $view,
        FogLighting $fogLighting,
        TextureRef? $fogSky = null
    )
    {
        $this->gpu = $gpu;
        $this->sky = $sky;
        $this->fog = $fog;
        $this->sun = $sun;
        $this->moon = $moon;
        $this->view = $view;
        $this->fogSky = $fogSky;
        $this->fogLighting = $fogLighting;
    }

    public function name() : string
    {
        return 'deferred.sky';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        LightPassData $light = $frame->get<LightPassData>();
        GBufferData $gbuffer = $frame->get<GBufferData>();
        // ordering only: the depth is an attachment here, not a sampler
        $io->reads($gbuffer->depth);
        readGodRays($io, $frame);
        readSkyView($io, $this->view);
        readFogSky($io, $this->fogSky);
        $io->writes($light->target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        ShaderProgram $program = guard $this->gpu->shaders->program('sky') else ($e) {
            return .error(.shader($e));
        }
        RenderEncoder $enc = guard beginSkyPass($ctx) else ($e) {
            return .error($e);
        }
        Device $device = $ctx->device;
        Mesh $mesh = $ctx->pool->cache<Mesh>('cube', function() : Mesh {
            return .cube($device);
        });
        GpuPass $pass = GpuPass($program, VertexLayout::pos3(), skyRaster());
        $pass->bind($enc);
        $this->gpu->camera->bind($enc);
        CameraData $camera = $ctx->frame->get<CameraData>();
        FogUniforms $fog = fogUniforms($this->fog, $camera->position, $this->fogLighting);
        SkyUniforms $sky = skyUniforms(
            $this->sky,
            $camera->position,
            true,
            SKY_VIEW_SAMPLES,
            SKY_LIGHT_SAMPLES,
            $this->moon
        );
        $enc->upload($sky, slot: 2);
        guard bindGodRays($ctx, $enc, $this->gpu, $fog, true) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        $enc->upload($fog, slot: 3);
        guard bindSkyView($ctx, $enc, $this->gpu, $this->view) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        guard bindFogSky($ctx, $enc, $this->gpu, FOG_SKY_SKY_SLOT, $this->fogSky) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        $mesh->draw($enc);
        $enc->endRender();
        return .ok;
    }
}

/**
 * Declares the sky-view table as a read when the pass has one.
 */
internal function readSkyView(IoSink $io, TextureRef? $view) : void
{
    TextureRef $held = guard $view else {
        return;
    }
    $io->reads($held);
}

/**
 * Binds the sky-view table at `SKY_VIEW_SLOT` when the pass has one; `skybox` has none.
 */
internal function bindSkyView(RenderContext $ctx, RenderEncoder $enc, DeferredGpu $gpu, TextureRef? $view) : status<PipelineError>
{
    TextureRef $held = guard $view else {
        return .ok;
    }
    return bindPooled($ctx, $enc, SKY_VIEW_SLOT, $held, $gpu->skyView);
}
