/**
 * Linked programs, fallback textures, and the four samplers the deferred passes share.
 * Constructed wholly by `load`; nothing on it is nullable.
 */

namespace visu::graphics;

use visu::math::Vec4;

/**
 * PBR programs and the deferred blit for one Device.
 * Releasing an MTLLibrary and compiling the same MSL again smashes the AGX compiler heap
 * (Play, Menu, Play). The device owns this and drops it in shutdown.
 */
internal class DeferredCache
{
    private BakedShaderCache $programs;
    private FullscreenTextureRenderer? $blit;
    private bool $warmed;

    public constructor()
    {
        $this->programs = BakedShaderCache();
        $this->blit = null;
        $this->warmed = false;
    }

    public function drop() : void
    {
        $this->programs->drop();
        $this->warmed = false;
        $this->dropBlit();
    }

    public function shaders(Device $device) : result<BakedShaders, ShaderError>
    {
        if ($this->warmed) {
            return .ok($this->programs->shaders($device, function(string $name, ShaderKind $kind) : string? {
                return pbrBytes($name, $kind);
            }));
        }

        return $this->makeShaders($device);
    }

    public function blit(Device $device) : result<FullscreenTextureRenderer, ShaderError>
    {
        FullscreenTextureRenderer $have = guard $this->blit else {
            FullscreenTextureRenderer $blit = FullscreenTextureRenderer();
            guard $blit->load($device) else ($e) {
                return .error($e);
            }
            $this->blit = $blit;
            return .ok($blit);
        }
        return .ok($have);
    }

    private function dropBlit() : void
    {
        FullscreenTextureRenderer $blit = guard $this->blit else {
            return;
        }
        $blit->destroy();
        $this->blit = null;
    }

    private function makeShaders(Device $device) : result<BakedShaders, ShaderError>
    {
        BakedShaders $shaders = $this->programs->shaders($device, function(string $name, ShaderKind $kind) : string? {
            return pbrBytes($name, $kind);
        });
        // every baked program, so none links on its first frame: the outline when something is
        // first hovered, a spot variant when a car's headlamps first light at dusk, the shaft and
        // tone-map stages when a setting or a console verb asks for them mid-play
        array<string> $programs = pbrPrograms();
        foreach ($programs as $name) {
            guard $shaders->program($name) else ($e) {
                $this->programs->drop();
                return .error($e);
            }
        }

        // the GPU-driven kernels and depth programs, which the first lamp, shadow page or
        // scene cull would otherwise compile mid-frame
        guard $device->gpuShaders->warm($device) else ($e) {
            $this->programs->drop();
            return .error($e);
        }
        $this->warmed = true;
        $shaders->warmed = true;
        return .ok($shaders);
    }
}

internal class DeferredGpu
{
    public Device $device;
    public BakedShaders $shaders;
    public UniformBuffer $camera;
    public FullscreenTextureRenderer $blit;
    public Texture $white;
    public Texture $noise;
    public Sampler $point;
    public Sampler $linear;
    public Sampler $noiseRepeat;
    public Sampler $cube;

    /**
     * The sky-view table: linear, wrapped around the azimuth, clamped at the zenith and nadir.
     */
    public Sampler $skyView;
    public Sampler $shadow;
    public Texture $shadowDummy;

    /**
     * Zeroed storage the light and water passes bind at every point-light slot before the
     * frame's clusters, so a frame without point lights never draws with one unbound.
     */
    public Buffer $noLights;
    public array<Vec4> $kernel;

    /**
     * The fullscreen quad and the sky cube (`skyCube`) every pass draws, built once.
     */
    public Mesh $quad;
    public Mesh $skyCube;

    /**
     * The water surface's quad (`waterQuad`).
     */
    public Mesh $waterSurface;

    /**
     * Each program's pass over `quad` / `cube`, built the first frame it draws: a GpuPass
     * builds its pipeline key string, so a pass that draws every frame takes it from here.
     */
    private map<uint32, GpuPass> $quadPasses = map<uint32, GpuPass>();
    private map<uint32, GpuPass> $cubePasses = map<uint32, GpuPass>();

    public static function load(Device $device) : result<DeferredGpu, ShaderError>
    {
        BakedShaders $shaders = guard $device->deferred->shaders($device) else ($e) {
            return .error($e);
        }
        FullscreenTextureRenderer $blit = guard $device->deferred->blit($device) else ($e) {
            return .error($e);
        }

        SamplerDesc $cubeDesc = SamplerDesc();
        $cubeDesc->min = .linearMipmapLinear;
        $cubeDesc->mag = .linear;
        return .ok(DeferredGpu(
            $device,
            $shaders,
            UniformBuffer($device, 1),
            $blit,
            whitePixel($device),
            Texture($device, 'deferred.ssaoNoise', ssaoNoise()),
            $device->createSampler(SamplerDesc($min: .nearest, $mag: .nearest)),
            $device->createSampler(SamplerDesc()),
            $device->createSampler(SamplerDesc(
                $min: .nearest,
                $mag: .nearest,
                $wrapS: .repeat,
                $wrapT: .repeat
            )),
            $device->createSampler($cubeDesc),
            $device->createSampler(SamplerDesc($wrapS: .repeat)),
            $device->createSampler(SamplerDesc()),
            shadowDummy($device),
            noLightsBuffer($device),
            ssaoKernel(SSAO_MAX_SAMPLES),
            Mesh::quad($device),
            Mesh::cube($device),
            waterQuad($device)
        ));
    }

    /**
     * Packs SSAO uniforms for this resolution. The kernel is built once; only the screen size changes.
     */
    public const function ssaoUniforms(const SsaoQuality& $quality, int32 $width, int32 $height) : SsaoUniforms
    {
        SsaoUniforms $uniforms = SsaoUniforms();
        int32 $count = $quality->samples;

        if ($count > SSAO_MAX_SAMPLES) {
            $count = SSAO_MAX_SAMPLES;
        }

        $uniforms->params = Vec4(
            $quality->radius,
            $quality->biasRatio,
            $quality->strength,
            $count as float32
        );
        $uniforms->screen = Vec4(
            $width as float32,
            $height as float32,
            ($width as float32) / (SSAO_NOISE_SIZE as float32),
            ($height as float32) / (SSAO_NOISE_SIZE as float32)
        );
        int32 $i = 0;

        while ($i < SSAO_MAX_SAMPLES) {
            $uniforms->samples[$i] = $this->kernel[$i as usize];
            $i = $i + 1;
        }

        return $uniforms;
    }

    /**
     * `$program` over the fullscreen quad with `$raster`.
     */
    public function quadPass(ShaderProgram $program, Raster $raster) : GpuPass
    {
        return keptPass($this->quadPasses, $program, VertexLayout::pos3uv2(), $raster);
    }

    /**
     * `$program` over the sky cube with `$raster`.
     */
    public function cubePass(ShaderProgram $program, Raster $raster) : GpuPass
    {
        return keptPass($this->cubePasses, $program, VertexLayout::pos3(), $raster);
    }

    public function destroy() : void
    {
        $this->quad->destroy();
        $this->skyCube->destroy();
        $this->waterSurface->destroy();
        $this->white->destroy();
        $this->noise->destroy();
        $this->shadowDummy->destroy();
        $this->noLights->destroy();
    }
}

/**
 * The pass `$kept` holds for `$program`, or a fresh one when it has none or holds another raster.
 * The layout is only read on a miss.
 */
internal function keptPass(map<uint32, GpuPass>& $kept, ShaderProgram $program, VertexLayout $layout, Raster $raster) : GpuPass
{
    if ($kept->has($program->id)) {
        GpuPass $have = $kept[$program->id];
        if (sameRaster($have->raster, $raster)) {
            return $have;
        }
    }

    GpuPass $made = GpuPass($program, $layout, $raster);
    $kept[$program->id] = $made;
    return $made;
}

internal function sameRaster(const Raster& $a, const Raster& $b) : bool
{
    return $a->depthTest == $b->depthTest
        && $a->depthWrite == $b->depthWrite
        && $a->depthCompare == $b->depthCompare
        && $a->cull == $b->cull
        && $a->fill == $b->fill
        && $a->front == $b->front
        && $a->blend == $b->blend
        && $a->colorWrite == $b->colorWrite
        && $a->depthBias == $b->depthBias
        && $a->depthSlope == $b->depthSlope;
}

/**
 * Destroys an owned texture if there is one; always returns null.
 */
internal function dropTexture(Texture? $texture) : Texture?
{
    Texture $held = guard $texture else {
        return null;
    }

    $held->destroy();
    return null;
}

/**
 * Opaque white, the stand-in for an absent ambient-occlusion map.
 */
internal function whitePixel(Device $device) : Texture
{
    array<uint8> $rgba = [255, 255, 255, 255];
    return Texture($device, 'deferred.white', Pixels(1, 1, $rgba));
}

internal function noLightsBuffer(Device $device) : Buffer
{
    array<uint8> $zero = arr::room<uint8>(64);
    int32 $i = 0;
    while ($i < 64) {
        $zero[] = 0;
        $i = $i + 1;
    }
    return Buffer($device, BUFFER_STORAGE, ptr<const uint8>(&$zero[0]), 64 as uint64);
}

internal function shadowDummy(Device $device) : Texture
{
    TextureDesc $desc = TextureDesc($format: .depth32f, $width: 1, $height: 1);
    $desc->kind = .array2D;
    $desc->arrayLength = 1;
    $desc->usage = TEXTURE_SAMPLED | TEXTURE_RENDER_TARGET;
    $desc->label = 'deferred.shadowDummy';
    return Texture($device, 'deferred.shadowDummy', $desc);
}

/**
 * Depth is device-private, so the dummy cannot be CPU-uploaded. One 1x1 clear to 1.0
 * (unshadowed) then a shaderRead transition, the same dance as a real cascade.
 * Load cannot do this: beginRender needs an open frame.
 */
internal function ensureShadowDummy(Device $device, Texture $dummy) : void
{
    if ($dummy->state == ResourceState::shaderRead) {
        return;
    }

    DepthTarget $depth = DepthTarget($dummy);
    $depth->load = .clear;
    $depth->store = .store;
    $depth->clearDepth = 1.0f;
    RenderPassDesc $desc = RenderPassDesc();
    $desc->depth = $depth;
    RenderEncoder $enc = $device->beginRender($desc);
    $enc->endRender();
    $device->transitionTexture($dummy, .shaderRead);
}
