/**
 * Deferred PBR: fill a packed GBuffer, shade it once, blit the result.
 * Not an ECS system; the app owns one and calls `render` with the geometry it wants in the buffer, so the same renderer serves an ECS scene and a hand-rolled one.
 *
 * Programs come from the module bake (`tools/shaders.php --bake`), so nothing has to ship shader files.
 */

namespace visu::graphics;

use visu::math::{Vec3, Vec4};

public class DeferredRenderer
{
    public DirectionalLight $sun;

    /**
     * The procedural sky: drawn per pixel behind the scene and, with `setEnvironment(probe:)`, the
     * atmosphere every probe state is rendered under. Only read when the environment is a probe.
     */
    public Sky $sky;

    /**
     * Exponential height fog applied to lit pixels and the sky, not to the probe bake. Sun-only
     * frames with `renderSkybox = false` leave the cleared background unfogged.
     */
    public HeightFog $fog;

    /**
     * Which two probe states light the scene and how far towards the second. Apps that drive a
     * time of day set this every frame; a single-state environment ignores it.
     */
    public IblBlend $iblBlend;

    /**
     * Shows wherever no geometry drew, until a skybox covers it.
     */
    public Vec4 $background;

    /**
     * Draw the environment cube behind the scene.
     */
    public bool $renderSkybox;

    /**
     * Null quality means off.
     */
    public SsaoQuality? $ssao;
    public IblQuality $ibl;

    /**
     * `.scene` runs light + skybox. Any other case skips shading and blits that buffer.
     */
    public DeferredView $view;
    public Device $device;
    private DeferredGpu? $gpu;
    private Environment? $environment;

    public constructor(Device $device)
    {
        $this->sun = DirectionalLight();
        $this->sky = Sky();
        $this->fog = HeightFog();
        $this->iblBlend = IblBlend();
        $this->background = Vec4(0.05f, 0.05f, 0.06f, 1.0f);
        $this->renderSkybox = true;
        $this->ssao = SsaoQuality::ultra();
        $this->ibl = IblQuality();
        $this->view = .scene;
        $this->device = $device;
        $this->gpu = null;
        $this->environment = null;
    }

    /**
     * Links the programs and builds the fallback textures.
     */
    public function load() : status<ShaderError>
    {
        DeferredGpu $gpu = guard DeferredGpu::load($this->device) else ($e) {
            return .error($e);
        }
        $this->gpu = $gpu;
        return .ok;
    }

    /**
     * Takes an equirectangular HDRI and bakes it into a cubemap on the next frame.
     * Takes ownership of `$equirect`; it is released once the bake has retired from the GPU.
     */
    public function setEnvironment(hdri: Texture $equirect, int32 $size = 1024) : void
    {
        assert($this->gpu != null, 'setEnvironment before load');
        $this->dropEnvironment();
        $this->environment = Environment(hdri: $this->device, $equirect, $size, $this->ibl);
    }

    /**
     * An already-baked cube. Takes ownership of `$cube`; the renderer will destroy it.
     */
    public function setEnvironment(Texture $cube) : void
    {
        assert($this->gpu != null, 'setEnvironment before load');
        $this->dropEnvironment();
        $this->environment = Environment($this->device, $cube, $this->ibl);
    }

    /**
     * A probe at `$position`: one lighting state per sun travel direction in `$suns`, prebaked over
     * the next frames from `$this->sky` plus whatever `$capture` draws into each face. The callback
     * gets an open encoder with the face camera at slot 1 and the sky at slot 2; it must not end the
     * pass. `$this->iblBlend` then picks the two states that light the scene.
     */
    public function setEnvironment(
        probe: Vec3 $position,
        const array<Vec3>& $suns,
        function<void(RenderContext, RenderEncoder, ProbeCapture)> $capture,
        int32 $size = 256
    ) : void
    {
        assert($this->gpu != null, 'setEnvironment before load');
        $this->dropEnvironment();
        $this->environment = Environment(probe: $this->device, $this->sky, $position, $suns, $capture, $size, $this->ibl);
    }

    /**
     * Move the prebaked suns of an existing probe set and re-bake it over the next frames.
     * `setEnvironment` would work too, but it drops the old environment first and destroying a
     * texture the frames in flight still reference is a use-after-free; this keeps the current
     * maps lighting the scene until the fresh bake lands.
     * False when there is no procedural environment, or `$suns` is not the same length as the
     * list it was built with.
     */
    public function updateEnvironmentSuns(const array<Vec3>& $suns) : bool
    {
        Environment $env = guard $this->environment else {
            return false;
        }
        return $env->updateSuns($suns);
    }

    /**
     * Re-bake every lighting state over the next frames. The current maps stay bound meanwhile.
     */
    public function invalidateIbl() : void
    {
        Environment $env = guard $this->environment else {
            return;
        }
        $env->invalidate();
    }

    public const function hasEnvironment() : bool
    {
        return $this->environment != null;
    }

    public const function iblReady() : bool
    {
        Environment $env = guard $this->environment else {
            return false;
        }
        return $env->lighting() == Lighting::ibl;
    }

    /**
     * Adds the deferred passes for this frame. `$fill` runs between the GBuffer allocation and the shading pass;
     * add the geometry passes there, writing `$gbuffer->target`.
     */
    public function render(
        RenderContext $ctx,
        TargetRef $output,
        function<void(RenderContext, GBufferData)> $fill
    ) : void
    {
        assert($this->gpu != null, 'DeferredRenderer.render before load');
        DeferredGpu $gpu = guard $this->gpu;
        Environment? $env = $this->environment;
        Environment $held = guard $env else {
            $this->addScene($ctx, $output, $fill, $gpu, null);
            return;
        }
        $held->releaseEquirect();

        if ($held->isProbe()) {
            $held->updateSky($this->sky);
            $held->blend = $this->iblBlend;
        }

        $this->addScene($ctx, $output, $fill, $gpu, $held);
    }

    private function addScene(
        RenderContext $ctx,
        TargetRef $output,
        function<void(RenderContext, GBufferData)> $fill,
        DeferredGpu $gpu,
        Environment? $env
    ) : void
    {
        Pipeline $pipeline = $ctx->pipeline;
        $pipeline->add(GBufferPass($gpu->camera, $output->width, $output->height));
        GBufferData $gbuffer = $ctx->frame->get<GBufferData>();
        $fill($ctx, $gbuffer);

        DeferredView $view = $this->view;
        bool $runSsao = $this->ssao != null && ($view->isScene() || $view->needsSsao());

        if ($runSsao) {
            SsaoQuality $quality = guard $this->ssao;
            $pipeline->add(SsaoPass($gpu, $quality));
            $pipeline->add(SsaoBlurPass($gpu));
        }

        if ($env != null) {
            Environment $environment = guard $env;
            $pipeline->add(EnvironmentPass($gpu, $environment));
            $pipeline->add(IblPass($gpu, $environment));
        }

        if ($view->isScene()) {
            $pipeline->add(LightPass($gpu, $env, $this->sun, $this->sky, $this->fog, $this->background));

            if ($this->renderSkybox && $env != null) {
                Environment $environment = guard $env;
                if ($environment->isProbe()) {
                    $pipeline->add(SkyPass($gpu, $this->sky, $this->fog, $this->sun));
                } else {
                    $pipeline->add(SkyboxPass($gpu, $this->sky, $this->fog, $this->sun));
                }
            }

            LightPassData $light = $ctx->frame->get<LightPassData>();
            $gpu->blit->pass($pipeline, $output, $light->output);
            return;
        }

        $pipeline->add(DeferredViewPass($gpu, $output, $view->params()));
    }

    /**
     * The common fill: cull/sort the assembler and draw it into the GBuffer with the instanced geometry program.
     */
    public function draw<P>(
        RenderContext $ctx,
        GBufferData $gbuffer,
        DrawCallAssembler<P> $dca,
        const VertexLayout& $layout
    ) : void
    {
        assert($this->gpu != null, 'DeferredRenderer.draw before load');
        VertexLayout $joined = $layout;
        DrawCallAssembler<P> $assembler = $dca;
        DeferredRenderer $renderer = $this;
        $ctx->pipeline->add(CallbackPass(
            'deferred.geometry',
            setup: function(Pipeline $pipeline, Frame $frame, IoSink $io) : void {
                $io->writes($gbuffer->target);
            },
            execute: function(RenderContext $pass) : status<PipelineError> {
                CameraData $camera = $pass->frame->get<CameraData>();
                $assembler->build($camera->frustum, $camera->position);

                if ($assembler->commandCount() == 0) {
                    return .ok;
                }

                RenderEncoder $enc = guard $pass->beginRender($gbuffer->target) else ($e) {
                    return .error($e);
                }
                GpuPass $gpuPass = $renderer->geometryPass($joined);
                $gpuPass->bind($enc);
                $renderer->bindCamera($enc);
                $assembler->execute($enc, $gpuPass);
                $enc->endRender();
                return .ok;
            }
        ));
    }

    /**
     * Fetches a linked program by its baked name, e.g. 'skybox' or 'hdri_to_cubemap'.
     */
    public function program(string $name) : result<ShaderProgram, ShaderError>
    {
        assert($this->gpu != null, 'DeferredRenderer.program before load');
        DeferredGpu $gpu = guard $this->gpu;
        return $gpu->shaders->program($name);
    }

    /**
     * The pass a geometry filler draws with, joined to its own layout.
     */
    public function geometryPass(const VertexLayout& $layout) : GpuPass
    {
        assert($this->gpu != null, 'DeferredRenderer.geometryPass before load');
        DeferredGpu $gpu = guard $this->gpu;
        ShaderProgram $program = guard $gpu->shaders->program('gbuffer_instanced');
        return GpuPass($program, $layout, Raster::opaque());
    }

    public function bindCamera(RenderEncoder $enc) : void
    {
        assert($this->gpu != null, 'DeferredRenderer.bindCamera before load');
        DeferredGpu $gpu = guard $this->gpu;
        $gpu->camera->bind($enc);
    }

    private function dropEnvironment() : void
    {
        Environment $env = guard $this->environment else {
            return;
        }
        $env->destroy();
        $this->environment = null;
    }

    public function destroy() : void
    {
        $this->dropEnvironment();
        DeferredGpu $gpu = guard $this->gpu else {
            return;
        }
        $gpu->destroy();
        $this->gpu = null;
    }
}
