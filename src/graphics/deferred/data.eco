/**
 * Frame facts the deferred passes hand each other. One producer per type per frame;
 * every field is written once at `setup`.
 */

namespace visu::graphics;

/**
 * The packed GBuffer. Position carries coverage in alpha, albedo carries metallic, emissive carries roughness;
 * four attachments is the render-pass cap.
 */
public class GBufferData
{
    public const TargetRef $target;
    public const TextureRef $position;
    public const TextureRef $normal;
    public const TextureRef $albedo;
    public const TextureRef $emissive;
    public const TextureRef $depth;

    public constructor(
        TargetRef $target,
        TextureRef $position,
        TextureRef $normal,
        TextureRef $albedo,
        TextureRef $emissive,
        TextureRef $depth
    )
    {
        $this->target = $target;
        $this->position = $position;
        $this->normal = $normal;
        $this->albedo = $albedo;
        $this->emissive = $emissive;
        $this->depth = $depth;
    }
}

/**
 * The noisy occlusion buffer, before the blur.
 */
public class SsaoRawData
{
    public const TargetRef $target;
    public const TextureRef $output;

    public constructor(TargetRef $target, TextureRef $output)
    {
        $this->target = $target;
        $this->output = $output;
    }
}

/**
 * Blurred ambient occlusion; absent when SSAO is off.
 */
public class SsaoData
{
    public const TargetRef $target;
    public const TextureRef $blurred;

    public constructor(TargetRef $target, TextureRef $blurred)
    {
        $this->target = $target;
        $this->blurred = $blurred;
    }
}

/**
 * The environment cubemap and how many mips it carries.
 */
public class EnvironmentData
{
    public const TextureRef $cubemap;
    public const int32 $mips;

    public constructor(TextureRef $cubemap, int32 $mips)
    {
        $this->cubemap = $cubemap;
        $this->mips = $mips;
    }
}

/**
 * The three baked image-based-lighting maps.
 */
public class IblData
{
    public const TextureRef $irradiance;
    public const TextureRef $prefilter;
    public const TextureRef $brdfLut;
    public const int32 $prefilterMips;

    public constructor(
        TextureRef $irradiance,
        TextureRef $prefilter,
        TextureRef $brdfLut,
        int32 $prefilterMips
    )
    {
        $this->irradiance = $irradiance;
        $this->prefilter = $prefilter;
        $this->brdfLut = $brdfLut;
        $this->prefilterMips = $prefilterMips;
    }
}

/**
 * Shaded scene before the skybox and the final blit.
 */
public class LightPassData
{
    public const TargetRef $target;
    public const TextureRef $output;

    public constructor(TargetRef $target, TextureRef $output)
    {
        $this->target = $target;
        $this->output = $output;
    }
}
