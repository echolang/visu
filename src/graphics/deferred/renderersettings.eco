/**
 * The renderer's switches that are not the look: the display end's starting curve, local
 * operator and auto exposure, the profiling split of the G-buffer pass, and the GPU scene's cull.
 * The app maps its flags onto these (`visu::app::rendererSettings`); a console or a settings
 * screen changes them through `DeferredRenderer.apply`.
 */

namespace visu::graphics;

public struct RendererSettings
{
    /**
     * The tone map's local operator.
     */
    public bool $toneLocal = false;

    /**
     * The tone map's curve.
     */
    public ToneCurve $toneCurve = .aces;

    /**
     * Auto exposure, metered from the light falling on the ground.
     */
    public bool $exposureAuto = false;

    /**
     * One GBuffer encoder per filler instead of one for all, so each system gets its own GPU
     * time. A profiling aid; the merged pass is the fast one.
     */
    public bool $splitGeometry = false;
    public GpuSceneSettings $scene = GpuSceneSettings();
}
