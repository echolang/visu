/**
 * Point lights given by value rather than by an entity (the console's debug lamps), and the
 * shadow offsets every light's table row carries. Lights live on the GPU: `LightTable` rows,
 * culled into clusters by `LightCull`, shadowed through the `ShadowAtlas`.
 */

namespace visu::graphics;

use visu::math::Vec3;

/**
 * Metres a shadow lookup moves along the surface normal before it projects.
 */
public const float32 POINT_NORMAL_OFFSET = 0.02f;

/**
 * The slope bias floor of a point-light shadow compare.
 */
public const float32 POINT_SHADOW_BIAS = 0.002f;

/**
 * A lamp by value, world position in metres.
 */
public struct PointLamp
{
    public Vec3 $position;
    public float32 $radius;
    public Vec3 $color;
    public float32 $intensity;
    public float32 $sourceRadius;
    public bool $castShadow;
}
