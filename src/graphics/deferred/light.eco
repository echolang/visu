/**
 * Scene lighting the deferred renderer owns. One directional sun for
 * now; point and spot lights land with a light-volume pass.
 */

namespace visu::graphics;

use visu::math::{Mat4, Vec3, Vec4, normalize};

/** which lightpass variant runs; computed at execute after the bakes */
internal enum Lighting
{
    case sun;
    case environment;
    case ibl;
}

internal function lightingOf(Environment? $env) : Lighting
{
    Environment $held = guard $env else {
        return .sun;
    }

    return $held->lighting();
}

internal function lightProgram(DeferredGpu $gpu, Lighting $mode) : result<ShaderProgram, ShaderError>
{
    return match ($mode) {
        Lighting::ibl => $gpu->shaders->program('lightpass+ibl'),
        Lighting::environment => $gpu->shaders->program('lightpass+env_cubemap'),
        Lighting::sun => $gpu->shaders->program('lightpass'),
    };
}

internal function lightUniforms(const DirectionalLight& $sun, Environment? $env) : LightUniforms
{
    Vec3 $direction = normalize($sun->direction);
    Environment $held = guard $env else {
        return LightUniforms(
            Vec4($direction->x, $direction->y, $direction->z, $sun->intensity),
            Vec4($sun->color->x, $sun->color->y, $sun->color->z, 1.0f),
            Vec4(IBL_PREFILTER_MIPS as float32, 1.0f, 0.0f, 0.0f)
        );
    }
    float32 $environmentMips = $held->cube->mips as float32;
    return LightUniforms(
        Vec4($direction->x, $direction->y, $direction->z, $sun->intensity),
        Vec4($sun->color->x, $sun->color->y, $sun->color->z, 1.0f),
        Vec4(IBL_PREFILTER_MIPS as float32, $environmentMips, 0.0f, 0.0f)
    );
}

public struct DirectionalLight
{
    /** the direction light travels, so straight down is (0, -1, 0) */
    public Vec3 $direction;
    public Vec3 $color;
    public float32 $intensity;

    public constructor()
    {
        $this->direction = Vec3(0.0f, -1.0f, 0.0f);
        $this->color = Vec3(1.0f, 1.0f, 1.0f);
        $this->intensity = 1.0f;
    }

    public constructor(Vec3 $direction, Vec3 $color, float32 $intensity)
    {
        $this->direction = $direction;
        $this->color = $color;
        $this->intensity = $intensity;
    }
}

/**
 * Mirrors LightUniforms in resources/shaders/pbr/lightpass.frag at
 * uniform slot 2. std140 with vec4 members only.
 */
public struct LightUniforms
{
    /** xyz sun direction, w intensity */
    public Vec4 $sunDirection;
    public Vec4 $sunColor;
    /** x prefiltered mip count, y environment mip count */
    public Vec4 $ibl;
}

/**
 * Mirrors CaptureUniforms in resources/shaders/include/visu/capture.glsl
 * at uniform slot 0, used by every cube bake.
 */
public struct CaptureUniforms
{
    public Mat4 $projection;
    public Mat4 $view;
    /** x roughness, y source face resolution */
    public Vec4 $params;
}
