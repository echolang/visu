/**
 * Scene lighting the deferred renderer owns. A directional sun and moon, the brighter
 * of them owning the shadow cascades, and the night hemisphere ambient. Point lights are
 * GPU table rows culled into clusters (`LightClusterData`); the light pass reads them there.
 */

namespace visu::graphics;

use visu::math::{Mat4, Vec3, Vec4, normalize};

/**
 * Which lightpass variant runs; computed at execute after the bakes.
 */
internal enum Lighting
{
    case sun;
    case environment;
    case ibl;
}

internal function lightingOf(Environment? $env) : Lighting
{
    Environment $held = guard $env else {
        return .sun;
    }

    return $held->lighting();
}

/**
 * The light-pass program for `$mode`, with the spot cone when the light table holds a lit spot.
 */
internal function lightProgram(DeferredGpu $gpu, Lighting $mode, bool $spots) : result<ShaderProgram, ShaderError>
{
    if ($spots) {
        return match ($mode) {
            Lighting::ibl => $gpu->shaders->program('lightpass+ibl_spot'),
            Lighting::environment => $gpu->shaders->program('lightpass+env_cubemap_spot'),
            Lighting::sun => $gpu->shaders->program('lightpass+spot'),
        };
    }

    return match ($mode) {
        Lighting::ibl => $gpu->shaders->program('lightpass+ibl'),
        Lighting::environment => $gpu->shaders->program('lightpass+env_cubemap'),
        Lighting::sun => $gpu->shaders->program('lightpass'),
    };
}

/**
 * Whether this frame's light table holds a lit spot.
 */
internal function frameSpots(LightClusterData? $clusters) : bool
{
    LightClusterData $held = guard $clusters else {
        return false;
    }

    return $held->table->spots > 0;
}

internal function iblParams(Environment? $env) : Vec4
{
    Environment $held = guard $env else {
        IblQuality $fallback = IblQuality();
        return Vec4($fallback->prefilterMips as float32, 1.0f, 0.0f, 0.0f);
    }
    float32 $environmentMips = $held->cube->desc->mips as float32;
    // never lod into 1x1 env mips: that paints cube faces on the spheres
    return Vec4($held->ibl->prefilterMips as float32, $environmentMips, $held->blend->weight, 0.0f);
}

internal function lightUniforms(
    const DirectionalLight& $sun,
    const Moon& $moon,
    const Sky& $sky,
    Environment? $env,
    ShadowMapData? $shadows = null
) : LightUniforms
{
    Vec3 $direction = normalize($sun->direction);
    LightUniforms $u = LightUniforms(
        Vec4($direction->x, $direction->y, $direction->z, $sun->intensity),
        Vec4($sun->color->x, $sun->color->y, $sun->color->z, 1.0f),
        iblParams($env)
    );
    DirectionalLight $moonLight = $moon->light;
    Vec3 $moonDirection = normalize($moonLight->direction);
    float32 $moonOwns = 0.0f;

    if (moonKeyed($sun, $moon)) {
        $moonOwns = 1.0f;
    }

    $u->moonDirection = Vec4($moonDirection->x, $moonDirection->y, $moonDirection->z, $moonLight->intensity);
    $u->moonColor = Vec4($moonLight->color->x, $moonLight->color->y, $moonLight->color->z, $moonOwns);
    $u->nightAmbient = nightAmbient($moon, $sky);
    ShadowMapData $held = guard $shadows else {
        return $u;
    }
    ShadowCascade[5] $cascades = $held->cascades;
    int32 $i = 0;
    while ($i < SHADOW_CASCADES) {
        $u->lightSpace[$i] = $cascades[$i]->lightSpace;
        $i = $i + 1;
    }

    $u->splits = Vec4(
        $cascades[0]->splitViewZ,
        $cascades[1]->splitViewZ,
        $cascades[2]->splitViewZ,
        $cascades[3]->splitViewZ
    );
    float32 $debug = 0.0f;
    if ($held->debug) {
        $debug = 1.0f;
    }

    $u->shadow = Vec4($cascades[4]->splitViewZ, 1.0f, $debug, 0.0f);
    return $u;
}

public struct DirectionalLight
{

    /**
     * The direction light travels, so straight down is (0, -1, 0).
     */
    public Vec3 $direction;
    public Vec3 $color;
    public float32 $intensity;

    public constructor()
    {
        $this->direction = Vec3(0.0f, -1.0f, 0.0f);
        $this->color = Vec3(1.0f, 1.0f, 1.0f);
        $this->intensity = 1.0f;
    }

    public constructor(Vec3 $direction, Vec3 $color, float32 $intensity)
    {
        $this->direction = $direction;
        $this->color = $color;
        $this->intensity = $intensity;
    }
}

/**
 * Mirrors LightUniforms in resources/shaders/pbr/lightpass.frag (and water.frag) at uniform
 * slot 2. std140: the sun block (three vec4s, five mat4s, splits, shadow), the moon block
 * (direction, colour, night ambient), then the clustered lights' head, bins and atlas.
 */
public struct LightUniforms
{

    /**
     * Sun direction in xyz, intensity in w.
     */
    public Vec4 $sunDirection;
    public Vec4 $sunColor;

    /**
     * Prefiltered mip count in x, environment mip count in y, blend towards the second IBL state in z.
     */
    public Vec4 $ibl;
    public Mat4[5] $lightSpace;

    /**
     * First four cascade splits as view-space Z.
     */
    public Vec4 $splits;

    /**
     * Fifth split in x, enabled in y, cascade tint in z.
     */
    public Vec4 $shadow;

    /**
     * Moon direction in xyz, intensity in w.
     */
    public Vec4 $moonDirection;

    /**
     * Moon colour in rgb, 1 in w when the moon owns the shadow cascades.
     */
    public Vec4 $moonColor;

    /**
     * Night hemisphere ambient from above in rgb, ground bounce share in w.
     */
    public Vec4 $nightAmbient;

    /**
     * Clustered lights: anything culled, tile pixels, tiles across, mask words. Zero (no
     * `LightClusterData` this frame) skips every point-light read.
     */
    public Vec4 $clusterHead;

    /**
     * Clustered lights: bin near, slices per log2 metre, slices, flicker seconds.
     */
    public Vec4 $clusterZ;

    /**
     * Clustered lights' shadow atlas (`ShadowAtlas.lookup`): 1 in x when bound, the mip bias
     * in y, 1 in z for the debug paint, the shadow distance in w.
     */
    public Vec4 $vsm;

    public constructor(Vec4 $sunDirection, Vec4 $sunColor, Vec4 $ibl)
    {
        $this->sunDirection = $sunDirection;
        $this->sunColor = $sunColor;
        $this->ibl = $ibl;
        Mat4[5] $space;
        int32 $i = 0;
        while ($i < SHADOW_CASCADES) {
            $space[$i] = Mat4();
            $i = $i + 1;
        }

        $this->lightSpace = $space;
        $this->splits = Vec4(0.0f);
        $this->shadow = Vec4(0.0f);
        $this->moonDirection = Vec4(0.0f, -1.0f, 0.0f, 0.0f);
        $this->moonColor = Vec4(0.0f);
        $this->nightAmbient = Vec4(0.0f);
        $this->clusterHead = Vec4(0.0f);
        $this->clusterZ = Vec4(1.0f);
        $this->vsm = Vec4(0.0f);
    }
}

/**
 * Mirrors CaptureUniforms in resources/shaders/include/visu/capture.glsl at uniform slot 0, used by every cube bake.
 */
public struct CaptureUniforms
{
    public Mat4 $projection;
    public Mat4 $view;

    /**
     * Roughness in x, source face resolution in y, convolution samples in z.
     */
    public Vec4 $params;
}
