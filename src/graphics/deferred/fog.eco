/**
 * Exponential height fog the deferred renderer applies to lit pixels and the sky: a medium lit
 * by the sun, the moon and the sky's ambient, with the aerial perspective (`aerial.eco`) on
 * top. `HeightFog` is the artist-facing knob set; `FogLighting` is what the frame's lights make
 * of it, solved once a frame; `FogUniforms` is their GPU mirror. Density at the camera is
 * collapsed on the CPU, the same way Unreal packs `RayOriginTerms`. The probe bake does not
 * include fog.
 */

namespace visu::graphics;

use std::math;
use visu::math::{Vec3, Vec4, length, normalize};

/**
 * Height fog parameters. Copied on assignment, like `Sky`. Metres, Unreal 4.27
 * semantics. Off until `enabled` is set.
 */
public struct HeightFog
{
    /**
     * Master switch. `FogDensity` is still packed when this is off; the shader
     * early-outs so a disabled frame is pixel-identical to no fog.
     */
    public bool $enabled;

    /**
     * Fog density at `height`, per metre. Unreal `FogDensity`.
     */
    public float32 $density;

    /**
     * Height falloff `k` (1/m). Unreal `FogHeightFalloff`.
     */
    public float32 $heightFalloff;

    /**
     * World Y the density is quoted at. Unreal `FogHeightOffset`.
     */
    public float32 $height;

    /**
     * The medium's single-scattering albedo: the share of the light it catches that it sends
     * on rather than absorbs. Mist is a little under white.
     */
    public Vec3 $albedo;

    /**
     * Anisotropy of the medium's forward lobe (Henyey-Greenstein g): how tightly it glows
     * around a light it is seen against.
     */
    public float32 $anisotropy;

    /**
     * Share of the forward lobe in the phase; the rest scatters evenly, the multiple
     * scattering of a thick mist, so it never goes black looking away from the light.
     */
    public float32 $forward;

    /**
     * Light the medium sends on after scattering more than once, as a factor on its single
     * scattering, the height fog's twin of the sky's stand-in. A haze a few kilometres deep is
     * lit from every side by itself; without this it hangs grey against the sky behind it.
     */
    public float32 $multipleScattering;

    /**
     * Legacy (`--flag fog.model=legacy`): inscattering colour, or a tint on the sky when
     * `fromSky`. Unreal `FogInscatteringColor`.
     */
    public Vec3 $color;

    /**
     * Legacy: multiply `color` by the sky's own radiance at the horizon in the pixel's azimuth (the
     * fog's sky table, `FogSkyLut`), so the haze takes the sky's colour. Unreal's cubemap
     * inscattering, pointed at our sky.
     */
    public bool $fromSky;

    /**
     * Caps how opaque the fog can get: transmittance never drops below
     * `1 - maxOpacity`. Unreal `FogMaxOpacity`.
     */
    public float32 $maxOpacity;

    /**
     * Metres from the camera that stay clear. Unreal `StartDistance`.
     */
    public float32 $startDistance;

    /**
     * Metres beyond which the pixel is left untouched. Zero means no cutoff.
     * Unreal `FogCutoffDistance`.
     */
    public float32 $cutoffDistance;

    /**
     * Ray length used for sky and skybox pixels, so the integral has a far
     * plane. Not an Unreal knob; 100 km is past any map we draw.
     */
    public float32 $skyDistance;

    /**
     * Legacy: directional inscattering colour, tinted engine-side by the current sun.
     * Unreal `DirectionalInscatteringColor`.
     */
    public Vec3 $sunColor;

    /**
     * Legacy: tightness of the sun glow. Unreal `DirectionalInscatteringExponent`.
     */
    public float32 $sunExponent;

    /**
     * Legacy: extra metres on top of `startDistance` before the sun glow starts.
     * Unreal `DirectionalInscatteringStartDistance`.
     */
    public float32 $sunStartDistance;

    public constructor()
    {
        $this->enabled = false;
        $this->density = 0.00012f;
        $this->heightFalloff = 0.008f;
        $this->height = 0.0f;
        $this->albedo = Vec3(0.9f, 0.9f, 0.9f);
        $this->anisotropy = 0.6f;
        $this->forward = 0.5f;
        $this->multipleScattering = 1.7f;
        $this->color = Vec3(1.0f, 1.0f, 1.0f);
        $this->fromSky = false;
        $this->maxOpacity = 1.0f;
        $this->startDistance = 0.0f;
        $this->cutoffDistance = 0.0f;
        $this->skyDistance = 100000.0f;
        $this->sunColor = Vec3(0.4f, 0.3f, 0.18f);
        $this->sunExponent = 8.0f;
        $this->sunStartDistance = 0.0f;
    }
}

operator (HeightFog $a) == (HeightFog $b) : bool
{
    return $a->enabled == $b->enabled
        && $a->density == $b->density
        && $a->heightFalloff == $b->heightFalloff
        && $a->height == $b->height
        && $a->albedo == $b->albedo
        && $a->anisotropy == $b->anisotropy
        && $a->forward == $b->forward
        && $a->multipleScattering == $b->multipleScattering
        && $a->color == $b->color
        && $a->fromSky == $b->fromSky
        && $a->maxOpacity == $b->maxOpacity
        && $a->startDistance == $b->startDistance
        && $a->cutoffDistance == $b->cutoffDistance
        && $a->skyDistance == $b->skyDistance
        && $a->sunColor == $b->sunColor
        && $a->sunExponent == $b->sunExponent
        && $a->sunStartDistance == $b->sunStartDistance;
}

operator (HeightFog $a) != (HeightFog $b) : bool
{
    return !($a == $b);
}

/**
 * Mirrors FogUniforms in resources/shaders/include/visu/fog.glsl at uniform slot 3; std140 with vec4 members only.
 */
public struct FogUniforms
{

    /**
     * Density at the camera in x (D0, 1/m), height falloff k in y, max opacity in z, 1 enabled in w.
     */
    public Vec4 $density;

    /**
     * Inscattering colour or tint in rgb, 1 in w multiplies the fog's sky table.
     */
    public Vec4 $color;

    /**
     * Start distance in x, cutoff in y (0 none), sky distance in z, directional start in w.
     */
    public Vec4 $params;

    /**
     * Directional inscattering colour (already sun tinted) in rgb, exponent in w.
     */
    public Vec4 $sun;

    /**
     * Added to the sky table's colour in rgb: the starlight the table has no stars for.
     */
    public Vec4 $floor;

    /**
     * Directional inscattering towards the moon (already moon tinted) in rgb, exponent in w.
     */
    public Vec4 $moon;

    /**
     * Light shafts: scatter in x, glow occlusion in y, 1 in w when the resolved shafts are
     * bound. Zero leaves `fog_apply_rays` on the plain fog path.
     */
    public Vec4 $shafts;

    /**
     * Key light radiance for the shafts in rgb, 1 in w when the moon is the key light.
     */
    public Vec4 $shaftLight;

    /**
     * Shaft phase: core anisotropy in x, wide anisotropy in y, wide lobe share in z.
     */
    public Vec4 $shaftPhase;

    /**
     * Unit vector towards the sun in xyz, 1 in w for the lit medium and the aerial perspective
     * (0 the legacy fog).
     */
    public Vec4 $model;

    /**
     * Unit vector towards the moon in xyz, the forward lobe's share in w.
     */
    public Vec4 $toMoon;

    /**
     * Sun irradiance at the fog in rgb, the forward lobe's anisotropy in w.
     */
    public Vec4 $sunLight;

    /**
     * Moon irradiance at the fog in rgb, 1 in w while it casts any.
     */
    public Vec4 $moonLight;

    /**
     * The sky's radiance the medium scatters evenly in rgb.
     */
    public Vec4 $ambient;

    /**
     * The medium's albedo in rgb, its multiple scattering stand-in in w.
     */
    public Vec4 $albedo;

    /**
     * Aerial perspective: the sky's Mie anisotropy in z, the distance scale in w (0 off).
     */
    public Vec4 $aerial;

    /**
     * Rayleigh scattering in rgb and Mie extinction in w (1/m): the transmittance of an aerial
     * path from its optical depths.
     */
    public Vec4 $aerialExtinction;
}

/**
 * What this frame's lights make of the fog, solved once a frame by the renderer and handed to
 * every pass that fogs, so none of them works it out again.
 */
public struct FogLighting
{
    /**
     * Unit vectors towards the sun and the moon: the sky's (the moon's is straight down while it
     * is disabled).
     */
    public Vec3 $toSun;
    public Vec3 $toMoon;

    /**
     * Irradiance the sun and the moon bring to the fog: the lights the light pass shades with.
     */
    public Vec3 $sun;
    public Vec3 $moon;

    /**
     * The sky's radiance the medium scatters evenly: `fogAmbient`.
     */
    public Vec3 $ambient;

    /**
     * The sky's Mie anisotropy, Rayleigh scattering and Mie extinction, for the aerial lookup.
     */
    public float32 $mieAnisotropy;
    public Vec3 $rayleigh;
    public float32 $mieExtinction;

    /**
     * Distance scale every aerial lookup reads at; 0 turns the aerial perspective off.
     */
    public float32 $aerialScale;

    /**
     * The legacy fog (`--flag fog.model=legacy`) and its tints: `fogSunTint`, `fogMoonTint`,
     * `fogLight` and `fogSkyFloor`.
     */
    public bool $legacy;
    public Vec3 $legacySun;
    public Vec3 $legacyMoon;
    public Vec3 $legacyScale;
    public Vec3 $legacyFloor;

    public constructor()
    {
        Vec3 $zero = Vec3(0.0f, 0.0f, 0.0f);
        $this->toSun = Vec3(0.0f, 1.0f, 0.0f);
        $this->toMoon = Vec3(0.0f, -1.0f, 0.0f);
        $this->sun = $zero;
        $this->moon = $zero;
        $this->ambient = $zero;
        $this->mieAnisotropy = 0.0f;
        $this->rayleigh = $zero;
        $this->mieExtinction = 0.0f;
        $this->aerialScale = 0.0f;
        $this->legacy = false;
        $this->legacySun = $zero;
        $this->legacyMoon = $zero;
        $this->legacyScale = Vec3(1.0f, 1.0f, 1.0f);
        $this->legacyFloor = $zero;
    }
}

/**
 * The fog's lighting this frame. `$ambient` is `fogAmbient`, which the renderer caches;
 * `$legacy` packs the fog visu had before and turns the aerial perspective off.
 */
public function fogLighting(
    const DirectionalLight& $sun,
    const Moon& $moon,
    const Sky& $sky,
    const AerialPerspective& $aerial,
    Vec3 $ambient,
    bool $legacy
) : FogLighting
{
    FogLighting $lit = FogLighting();
    $lit->toSun = normalize(-$sky->direction);
    $lit->sun = $sun->color * $sun->intensity;
    $lit->ambient = $ambient;
    $lit->mieAnisotropy = $sky->mieAnisotropy;
    $lit->rayleigh = Vec3(SKY_RAYLEIGH_R, SKY_RAYLEIGH_G, SKY_RAYLEIGH_B) * $sky->rayleighScale;
    $lit->mieExtinction = SKY_MIE_EXTINCTION * $sky->mieScale;

    if ($moon->enabled) {
        DirectionalLight $light = $moon->light;
        $lit->toMoon = normalize(-$moon->direction);
        $lit->moon = $light->color * $light->intensity;
    }

    if ($aerial->enabled && !$legacy) {
        $lit->aerialScale = $aerial->scale;
    }

    $lit->legacy = $legacy;
    $lit->legacySun = fogSunTint($sun, $sky);
    $lit->legacyMoon = fogMoonTint($moon, $sky);
    $lit->legacyScale = fogLight($moon, $sky);
    $lit->legacyFloor = fogSkyFloor($moon, $sky);
    return $lit;
}

/**
 * The radiance the sky sends into the fog from every side, for its even scattering: half the
 * sphere is the sunlit dome (`$dome`, `skyDomeRadiance`), the other half the ground lit by the
 * sun and that dome. The ground's brightness counts, not its colour: the grass would tint a
 * white mist green. The night hemisphere (moonlit sky and starlight) comes on top, from above
 * and off the ground the same way.
 */
public function fogAmbient(Vec3 $dome, const DirectionalLight& $sun, const Moon& $moon, const Sky& $sky) : Vec3
{
    float32 $albedo = luminance($sky->groundAlbedo);
    float32 $up = -normalize($sun->direction)->y;

    if ($up < 0.0f) {
        $up = 0.0f;
    }

    Vec3 $ground = ($sun->color * ($sun->intensity * $up / math::PI_F32) + $dome) * $albedo;
    Vec4 $night = nightAmbient($moon, $sky);
    Vec3 $below = Vec3($night->x, $night->y, $night->z);
    return ($dome + $ground + $below * (1.0f + $albedo)) * 0.5f;
}

/**
 * Packs fog for one draw. `$camera` is where the viewer stands; `$lit` is the frame's
 * `fogLighting`.
 */
public function fogUniforms(const HeightFog& $fog, Vec3 $camera, const FogLighting& $lit) : FogUniforms
{
    float32 $enabled = 0.0f;

    if ($fog->enabled) {
        $enabled = 1.0f;
    }

    float32 $fromSky = 0.0f;

    if ($fog->fromSky) {
        $fromSky = 1.0f;
    }

    Vec3 $sun = $fog->sunColor * $lit->legacySun;
    Vec3 $color = $fog->color;
    Vec3 $lift = Vec3(0.0f, 0.0f, 0.0f);

    // the sky already carries the light; only a constant colour is scaled
    if (!$fog->fromSky) {
        $color = $color * $lit->legacyScale;
    } else {
        $lift = $lit->legacyFloor;
    }

    // the fog's warm sun colour would turn the moon amber; keep only its strength
    float32 $glow = ($fog->sunColor->x + $fog->sunColor->y + $fog->sunColor->z) / 3.0f;
    Vec3 $moon = $lit->legacyMoon * $glow;
    float32 $model = 1.0f;

    if ($lit->legacy) {
        $model = 0.0f;
    }

    float32 $moonUp = 0.0f;

    if ($lit->moon->x + $lit->moon->y + $lit->moon->z > 0.0f) {
        $moonUp = 1.0f;
    }

    return FogUniforms(
        Vec4(fogDensityAtCamera($fog, $camera), $fog->heightFalloff, $fog->maxOpacity, $enabled),
        Vec4($color->x, $color->y, $color->z, $fromSky),
        Vec4($fog->startDistance, $fog->cutoffDistance, $fog->skyDistance, $fog->sunStartDistance),
        Vec4($sun->x, $sun->y, $sun->z, $fog->sunExponent),
        Vec4($lift->x, $lift->y, $lift->z, 0.0f),
        Vec4($moon->x, $moon->y, $moon->z, $fog->sunExponent),
        Vec4(0.0f),
        Vec4(0.0f),
        Vec4(0.0f),
        Vec4($lit->toSun->x, $lit->toSun->y, $lit->toSun->z, $model),
        Vec4($lit->toMoon->x, $lit->toMoon->y, $lit->toMoon->z, $fog->forward),
        Vec4($lit->sun->x, $lit->sun->y, $lit->sun->z, $fog->anisotropy),
        Vec4($lit->moon->x, $lit->moon->y, $lit->moon->z, $moonUp),
        Vec4($lit->ambient->x, $lit->ambient->y, $lit->ambient->z, 0.0f),
        Vec4($fog->albedo->x, $fog->albedo->y, $fog->albedo->z, $fog->multipleScattering),
        Vec4(0.0f, 0.0f, $lit->mieAnisotropy, $lit->aerialScale),
        Vec4($lit->rayleigh->x, $lit->rayleigh->y, $lit->rayleigh->z, $lit->mieExtinction)
    );
}

/**
 * Sun colour scaled by how much of the sky's noon intensity is still up.
 * Zero below the horizon; matches the directional light `Sky.sunLight` writes.
 */
public function fogSunTint(const DirectionalLight& $sun, const Sky& $sky) : Vec3
{
    float32 $denom = $sky->sunIntensity;

    if ($denom < 0.001f) {
        $denom = 0.001f;
    }

    float32 $scale = $sun->intensity / $denom;

    if ($scale < 0.0f) {
        $scale = 0.0f;
    }

    if ($scale > 1.0f) {
        $scale = 1.0f;
    }

    return $sun->color * $scale;
}

/**
 * CPU twin of the shader's transmittance `T`: start, cutoff, opacity floor,
 * Taylor branch. 1 when fog is off.
 */
public function fogTransmittance(const HeightFog& $fog, Vec3 $camera, Vec3 $relative) : float32
{
    if (!$fog->enabled) {
        return 1.0f;
    }

    float32 $len = length($relative);

    if ($len < 0.001f) {
        return 1.0f;
    }

    if ($fog->cutoffDistance > 0.0f && $len > $fog->cutoffDistance) {
        return 1.0f;
    }

    float32 $d0 = fogDensityAtCamera($fog, $camera);
    float32 $dy = $relative->y / $len;
    float32 $k = $fog->heightFalloff;
    float32 $optical = fogIntegral($d0, $k, $dy, $len);
    float32 $start = $fog->startDistance;

    if ($start > $len) {
        $start = $len;
    }

    float32 $t = math::exp(-($optical - fogIntegral($d0, $k, $dy, $start)));
    float32 $floor = 1.0f - $fog->maxOpacity;

    if ($t < $floor) {
        $t = $floor;
    }

    return $t;
}

/**
 * Density at the camera: `density * exp(-clamp(k * (yc - height), -30, 30))`.
 */
internal function fogDensityAtCamera(const HeightFog& $fog, Vec3 $camera) : float32
{
    float32 $arg = $fog->heightFalloff * ($camera->y - $fog->height);

    if ($arg > 30.0f) {
        $arg = 30.0f;
    }

    if ($arg < -30.0f) {
        $arg = -30.0f;
    }

    return $fog->density * math::exp(-$arg);
}

/**
 * Optical depth along a ray. Clamps `k * dy * len` at -60 so exp stays finite.
 */
internal function fogIntegral(float32 $d0, float32 $k, float32 $dy, float32 $len) : float32
{
    float32 $x = $k * $dy * $len;

    if ($x < -60.0f) {
        $x = -60.0f;
    }

    float32 $ax = $x;

    if ($ax < 0.0f) {
        $ax = -$ax;
    }

    if ($ax < 0.0001f) {
        return $d0 * $len * (1.0f - 0.5f * $x);
    }

    return $d0 * (1.0f - math::exp(-$x)) / ($k * $dy);
}
