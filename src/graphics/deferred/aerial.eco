/**
 * The aerial perspective: the atmosphere of `Sky` between the eye and every lit pixel, read
 * from a table instead of marched per pixel, so a far ridge fades into the sky behind it per
 * channel. Like the sky-view table it depends only on the sun, the moon, the atmosphere and
 * the eye height, so it is refilled only when one of those moved; a paused clock and a still
 * eye cost nothing. Layout and mapping live in resources/shaders/include/visu/aerial.glsl.
 */

namespace visu::graphics;

use visu::math::Vec3;

/**
 * Table size: world azimuth texels per slice, the slice's width with its two wrap gutters,
 * elevation rows over the whole sphere, and distance slices out to `AERIAL_DISTANCE` metres.
 * Mirrors AERIAL_* in aerial.glsl.
 */
public const int32 AERIAL_AZIMUTH = 64;
public const int32 AERIAL_SLICE_WIDTH = 66;
public const int32 AERIAL_ELEVATION = 32;
public const int32 AERIAL_SLICES = 32;
public const int32 AERIAL_WIDTH = 2112;
public const float32 AERIAL_DISTANCE = 64000.0f;

/**
 * Layers of the table: the light but for the sun's Mie lobe with the Rayleigh depth, and the
 * sun's Mie light without its phase with the Mie depth.
 */
internal const int32 AERIAL_LAYERS = 2;

/**
 * The march per texel. A texel's path is at most `AERIAL_DISTANCE` of air near the ground, so
 * it wants far fewer steps than a sky ray to the edge of the atmosphere.
 */
internal const float32 AERIAL_VIEW_SAMPLES = 8.0f;
internal const float32 AERIAL_LIGHT_SAMPLES = 4.0f;

/**
 * The table's binding in each program that fogs a surface.
 */
internal const uint32 AERIAL_LIGHT_SLOT = 14;
internal const uint32 AERIAL_WATER_SLOT = 4;

/**
 * How far the sun's sine may climb or sink, and the eye rise or fall in metres, before the
 * fog's sky dome is solved again. The dome is soft: 0.002 is about a tenth of a degree.
 */
internal const float32 FOG_AMBIENT_SUN_STEP = 0.002f;
internal const float32 FOG_AMBIENT_ALTITUDE_STEP = 50.0f;

/**
 * The aerial perspective's switch and its one artistic lever. `scale` multiplies the distance
 * every lookup reads the table at: 1 is the air as `Sky` describes it, 2 makes the estate look
 * twice as deep. The sky is not touched; turbidity stays `Sky.mieScale`.
 */
public struct AerialPerspective
{
    public bool $enabled;
    public float32 $scale;

    public constructor()
    {
        $this->enabled = true;
        $this->scale = 1.0f;
    }
}

/**
 * Declares the aerial table as a read.
 */
internal function readAerial(IoSink $io, TextureRef? $table) : void
{
    TextureRef $held = guard $table else {
        return;
    }
    $io->reads($held);
}

/**
 * Binds the aerial table at `$slot`. Every program that fogs a surface declares it, so a pass
 * without one (a view that never built it) cannot draw; the renderer always hands one over.
 */
internal function bindAerial(
    RenderContext $ctx,
    RenderEncoder $enc,
    DeferredGpu $gpu,
    uint32 $slot,
    TextureRef $table
) : status<PipelineError>
{
    return bindPooled($ctx, $enc, $slot, $table, $gpu->linear);
}
