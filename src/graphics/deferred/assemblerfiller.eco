/**
 * A draw-call assembler as a scene drawer: culls and sorts it, then records it with the
 * instanced geometry program (`DeferredRenderer.geometryPass`). Attach one per assembler.
 */

namespace visu::graphics;

public class AssemblerFiller<P> : SceneDrawer, GeometryFiller
{
    private DrawCallAssembler<P> $dca;
    private GpuPass $pass;

    public constructor(DrawCallAssembler<P> $dca, GpuPass $pass)
    {
        $this->dca = $dca;
        $this->pass = $pass;
    }

    public function name() : string
    {
        return 'assembler';
    }

    public function prepare(RenderContext $ctx, SceneViews $views) : int32
    {
        return SCENE_VIEW_GBUFFER;
    }

    public function record(RenderContext $ctx, RenderEncoder $enc) : status<PipelineError>
    {
        CameraData $camera = $ctx->frame->get<CameraData>();
        $this->dca->build($camera->cullFrustum, $camera->cullPosition);
        if ($this->dca->commandCount() == 0) {
            return .ok;
        }

        $this->pass->bind($enc);
        $this->dca->execute($enc, $this->pass);
        return .ok;
    }
}
