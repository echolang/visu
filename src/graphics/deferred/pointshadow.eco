/**
 * Point-light shadow cubes. Four lamps, six perspective faces each, one depth
 * array. The pass runs after the sun cascades and before the light pass.
 * Casters prepare during fill, the same moment as the sun lists, then draw
 * into an already-open face encoder.
 */

namespace visu::graphics;

use visu::math::{Mat4, Vec3};

public const uint32 POINT_TILE_SLOT = 13;
public const uint32 POINT_SHADOW_SLOT = 14;

/**
 * Draw one face. Implementations are classes. `castPoint` must not begin or
 * end the encoder.
 */
public interface PointShadowCaster
{
    function castPoint(RenderContext $ctx, RenderEncoder $enc, int32 $layer, const PointFace& $face) : void;
}

/**
 * This frame's point-shadow mailbox. Absent when no lamp casts.
 * `$casters` is appended during fill; the pass only calls `castPoint`.
 */
public class PointShadowData
{
    public const TextureRef $map;
    public const int32 $layers;
    public array<PointShadowCaster> $casters;

    public constructor(TextureRef $map, int32 $layers, array<PointShadowCaster> $casters)
    {
        $this->map = $map;
        $this->layers = $layers;
        $this->casters = $casters;
    }

    public function add(PointShadowCaster $caster) : void
    {
        $this->casters[] = $caster;
    }
}

/**
 * The packed lamps and the tile texture for this frame. `PointLightSystem`
 * writes it before `DeferredRenderer.render`. Count zero means the light pass
 * binds the dummies and skips the tile lookup.
 */
public class PointLightFrame
{
    public int32 $count;
    public PointPack $pack;
    public int32 $tilesX;
    public int32 $tilesY;
    public Texture? $tiles;
    public PointFace[24] $cameras;
    public Mat4[24] $space;
    public Texture? $shadowMap;

    public constructor()
    {
        $this->count = 0;
        $this->pack = PointPack();
        $this->tilesX = 0;
        $this->tilesY = 0;
        $this->tiles = null;
        $this->shadowMap = null;
        PointFace $blank = pointFace(0, Vec3(0.0f, 0.0f, 0.0f), POINT_SHADOW_NEAR, 1.0f, POINT_SHADOW_RES);
        PointFace[24] $cameras;
        Mat4[24] $space;
        int32 $i = 0;
        while ($i < POINT_SHADOW_LAYERS) {
            $cameras[$i] = $blank;
            $space[$i] = Mat4();
            $i = $i + 1;
        }

        $this->cameras = $cameras;
        $this->space = $space;
    }
}

public class PointShadowPass : Pass
{
    private Texture $map;
    private array<PointShadowCaster> $casters;

    public constructor(Texture $map)
    {
        $this->map = $map;
        $this->casters = arr::room<PointShadowCaster>(4);
    }

    public function name() : string
    {
        return 'deferred.pointshadow';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        PointLightFrame $lights = $frame->get<PointLightFrame>();
        int32 $layers = $lights->pack->shadows * CUBE_FACE_COUNT;
        $this->casters->clear();
        TextureRef $ref = $pipeline->importTexture('pointshadow.map', $this->map);
        $frame->set(PointShadowData($ref, $layers, $this->casters));
        $io->writes($ref);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        PointShadowData $data = $ctx->frame->get<PointShadowData>();
        PointLightFrame $lights = $ctx->frame->get<PointLightFrame>();
        Device $device = $ctx->device;
        Texture $map = $this->map;
        array<PointShadowCaster> $casters = $data->casters;
        int32 $i = 0;
        while ($i < $data->layers) {
            PointFace $face = $lights->cameras[$i];
            DepthTarget $depth = DepthTarget($map, face: $i);
            $depth->load = .clear;
            $depth->store = .store;
            $depth->clearDepth = 1.0f;
            RenderPassDesc $desc = RenderPassDesc();
            $desc->depth = $depth;
            RenderEncoder $enc = $device->beginRender($desc);
            visu::profile::begin('face');
            foreach ($casters as $caster) {
                $caster->castPoint($ctx, $enc, $i, $face);
            }

            visu::profile::end();
            $enc->endRender();
            $i = $i + 1;
        }

        $device->transitionTexture($map, .shaderRead);
        return .ok;
    }
}
