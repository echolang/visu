/**
 * Shades the GBuffer into an offscreen colour target.
 * Which shader variant runs depends on what is baked this frame: image-based lighting, a plain environment cubemap, or the sun alone.
 */

namespace visu::graphics;

use visu::math::Vec4;

public class LightPass : Pass
{
    internal DeferredGpu $gpu;
    internal Environment? $environment;
    internal DirectionalLight $sun;
    internal Sky $sky;
    internal Moon $moon;
    internal HeightFog $fog;

    /**
     * The clear colour in scene radiance: the renderer's background already mapped back through
     * the curve (`sceneBackground`), so the pass never solves it per frame.
     */
    internal Vec4 $clear;

    /**
     * This frame's fog sky table (`FogSkyLut`) when the fog takes the sky's colour, which the
     * sky and the water read too.
     */
    internal TextureRef? $fogSky;

    /**
     * This frame's fog lighting (`fogLighting`), which the sky and the water pack too.
     */
    internal FogLighting $fogLighting;

    /**
     * This frame's aerial table (`AerialLut`), bound whether or not it is read.
     */
    internal TextureRef $aerial;

    public constructor(
        DeferredGpu $gpu,
        Environment? $environment,
        DirectionalLight $sun,
        Sky $sky,
        Moon $moon,
        HeightFog $fog,
        Vec4 $clear,
        FogLighting $fogLighting,
        TextureRef $aerial,
        TextureRef? $fogSky = null
    )
    {
        $this->gpu = $gpu;
        $this->environment = $environment;
        $this->sun = $sun;
        $this->sky = $sky;
        $this->moon = $moon;
        $this->fog = $fog;
        $this->clear = $clear;
        $this->fogSky = $fogSky;
        $this->fogLighting = $fogLighting;
        $this->aerial = $aerial;
    }

    public function name() : string
    {
        return 'deferred.light';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        GBufferData $gbuffer = $frame->get<GBufferData>();
        readGBuffer($io, $gbuffer);
        readSsao($io, $frame);
        readGodRays($io, $frame);
        readFogSky($io, $this->fogSky);
        readAerial($io, $this->aerial);

        EnvironmentData? $environment = $frame->find<EnvironmentData>();

        if ($environment != null) {
            EnvironmentData $found = guard $environment;
            $io->reads($found->cubemap);
        }

        IblData? $ibl = $frame->find<IblData>();

        if ($ibl != null) {
            IblData $found = guard $ibl;
            $io->reads($found->irradiance);
            $io->reads($found->prefilter);
            $io->reads($found->irradianceB);
            $io->reads($found->prefilterB);
            $io->reads($found->brdfLut);
        }

        ShadowMapData? $shadows = $frame->find<ShadowMapData>();
        if ($shadows != null) {
            ShadowMapData $found = guard $shadows;
            $io->reads($found->map);
        }

        TargetRef $target = $pipeline->createTarget(
            'lightpass',
            $gbuffer->target->width,
            $gbuffer->target->height
        );
        // linear radiance: the tone-map pass at the end of the frame is the one display encode
        TextureRef $output = $pipeline->createColor($target, 'output', TextureOptions($format: .rgba16f));
        $frame->set(LightPassData($target, $output));
        $io->writes($target);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        LightPassData $data = $ctx->frame->get<LightPassData>();
        GBufferData $gbuffer = $ctx->frame->get<GBufferData>();
        CameraData $camera = $ctx->frame->get<CameraData>();
        return $this->shade($ctx, $data->target, $gbuffer, $camera, $this->fog, $this->fogLighting, false, true, $this->clear, $godRays: true);
    }

    /**
     * Shade `$gbuffer` into `$target` with the light-pass program.
     * `$uploadCamera` writes `$camera` at slot 1. Otherwise the shared camera buffer is bound,
     * which the G-buffer pass already pushed for the main view.
     * `$cull` is the view's cull of the light table; the main view's when null.
     * `$sampleSsao` is the play-view occlusion. A mirror leaves it off and binds white.
     * `$worldCascades` picks the sun cascade from the receiver's place in each map.
     * `$godRays` composites this frame's light shafts; only the main view has them.
     */
    public function shade(
        RenderContext $ctx,
        TargetRef $target,
        GBufferData $gbuffer,
        CameraData $camera,
        HeightFog $fog,
        FogLighting $fogLighting,
        bool $uploadCamera,
        bool $doClear,
        Vec4 $clear,
        bool $sampleSsao = true,
        bool $worldCascades = false,
        bool $godRays = false,
        cull: LightCull? $cull = null
    ) : status<PipelineError>
    {
        if ($doClear) {
            $ctx->pipeline->requestClear($target, ClearPassOptions(color: $clear));
        }

        Lighting $mode = lightingOf($this->environment);
        ShaderProgram $program = guard lightProgram($this->gpu, $mode) else ($e) {
            return .error(.shader($e));
        }

        // the 1x1 depth clear opens its own encoder, so it has to run before this pass
        if ($ctx->frame->find<ShadowMapData>() == null) {
            ensureShadowDummy($ctx->device, $this->gpu->shadowDummy);
        }

        RenderEncoder $enc = guard $ctx->beginRender($target) else ($e) {
            return .error($e);
        }
        Device $device = $ctx->device;
        Mesh $mesh = $ctx->pool->cache<Mesh>('quad', function() : Mesh {
            return .quad($device);
        });
        GpuPass $pass = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
        $pass->bind($enc);
        if ($uploadCamera) {
            $enc->upload($camera->uniforms(), slot: 1);
        } else {
            $this->gpu->camera->bind($enc);
        }

        LightUniforms $lights = lightUniforms($this->sun, $this->moon, $this->sky, $this->environment, $ctx->frame->find<ShadowMapData>());
        if ($worldCascades) {
            $lights->shadow = Vec4(
                $lights->shadow->x,
                $lights->shadow->y,
                $lights->shadow->z,
                1.0f
            );
        }

        bindClusters($enc, $this->gpu, $ctx->frame->find<LightClusterData>(), $cull, $lights);

        $enc->upload($lights, slot: 2);
        FogUniforms $fogUniforms = fogUniforms($fog, $camera->position, $fogLighting);
        guard bindGodRays($ctx, $enc, $this->gpu, $fogUniforms, $godRays) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        $enc->upload($fogUniforms, slot: 3);
        // a view without fog (the mirror) binds white in the table's place
        TextureRef? $fogSky = null;
        if ($fog->enabled) {
            $fogSky = $this->fogSky;
        }
        guard bindFogSky($ctx, $enc, $this->gpu, FOG_SKY_LIGHT_SLOT, $fogSky) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        guard bindAerial($ctx, $enc, $this->gpu, AERIAL_LIGHT_SLOT, $this->aerial) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        Sampler $point = $this->gpu->point;

        guard bindGBuffer($ctx, $enc, $gbuffer, $point) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        if ($sampleSsao) {
            guard bindSsaoOrWhite($ctx, $enc, $this->gpu, $point) else ($e) {
                $enc->endRender();
                return .error($e);
            }
        } else {
            $enc->bindTexture(LIGHT_SSAO_SLOT, $this->gpu->white, $point);
        }
        guard $this->bindEnvironment($ctx, $enc, $mode) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        guard bindShadowOrDummy($ctx, $enc, $this->gpu) else ($e) {
            $enc->endRender();
            return .error($e);
        }
        $mesh->draw($enc);
        $enc->endRender();
        return .ok;
    }

    /**
     * Binds slots 6..10. IBL: irradiance, prefiltered specular, BRDF LUT, then the second state's
     * irradiance and prefiltered specular. Environment cube at slot 6.
     */
    private function bindEnvironment(RenderContext $ctx, RenderEncoder $enc, Lighting $mode) : status<PipelineError>
    {
        if ($mode == Lighting::sun) {
            return .ok;
        }

        if ($mode == Lighting::ibl) {
            return $this->bindIbl($ctx, $enc);
        }

        return $this->bindCube($ctx, $enc);
    }

    private function bindIbl(RenderContext $ctx, RenderEncoder $enc) : status<PipelineError>
    {
        IblData $maps = $ctx->frame->get<IblData>();
        // irradiance is a single mip; a mip-linear cube sampler reads
        // garbage on iOS when lod > 0
        guard bindPooled($ctx, $enc, 6, $maps->irradiance, $this->gpu->linear) else ($e) {
            return .error($e);
        }
        guard bindPooled($ctx, $enc, 7, $maps->prefilter, $this->gpu->cube) else ($e) {
            return .error($e);
        }
        guard bindPooled($ctx, $enc, 8, $maps->brdfLut, $this->gpu->linear) else ($e) {
            return .error($e);
        }
        guard bindPooled($ctx, $enc, 9, $maps->irradianceB, $this->gpu->linear) else ($e) {
            return .error($e);
        }
        return bindPooled($ctx, $enc, 10, $maps->prefilterB, $this->gpu->cube);
    }

    private function bindCube(RenderContext $ctx, RenderEncoder $enc) : status<PipelineError>
    {
        EnvironmentData $environment = $ctx->frame->get<EnvironmentData>();
        Texture $cube = guard $ctx->pool->getTexture($environment->cubemap) else ($e) {
            return .error(.pool($e));
        }
        $enc->bindTexture(6, $cube, $this->gpu->cube);
        return .ok;
    }
}
