/**
 * How point lights shadow through the virtual shadow atlas, as the app configures it.
 */

namespace visu::graphics;

public struct PointShadowSettings
{
    /**
     * Point lights cast shadows at all.
     */
    public bool $enabled = true;

    /**
     * Levels coarser a light that moved this frame asks its pages at; 0 asks the wanted level.
     */
    public float32 $movingBias = 0.0f;

    /**
     * Metres past which a light shades without a shadow and takes no pages; the shadow fades
     * over the last 15%.
     */
    public float32 $shadowDistance = 60.0f;

    /**
     * Paint each shadowed pixel by what the atlas held for it: red no page, magenta stale,
     * green lit, blue shadowed.
     */
    public bool $debug = false;
}
