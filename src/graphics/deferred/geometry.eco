/**
 * Extra deferred geometry. PHP `GBufferGeometryPassInterface`.
 * `DeferredRenderer.render`'s `$fill` is the list of these; each adds passes that write `$gbuffer->target`.
 */

namespace visu::graphics;

use visu::ecs::Entities;

public interface GBufferGeometry
{
    function fill(Entities $entities, RenderContext $ctx, GBufferData $gbuffer) : void;
}
