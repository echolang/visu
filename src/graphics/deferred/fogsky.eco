/**
 * The fog's sky: the atmosphere's radiance over the upper hemisphere, phase and lights applied,
 * one texel per direction. With `HeightFog.fromSky` every fogged pixel mixes toward it, so the
 * haze takes the colour of the sky behind it instead of a constant. Like the sky-view table it
 * depends only on the sun, the moon, the atmosphere and the eye height, so it is refilled only
 * when one of those moved: 2048 texels. Layout and mapping live in
 * resources/shaders/include/visu/fog_sky.glsl.
 */

namespace visu::graphics;

use std::math;
use visu::math::{Vec2, Vec3};

/**
 * Table size in texels: azimuth by elevation above the horizon. Mirrors FOG_SKY_WIDTH /
 * FOG_SKY_HEIGHT in fog_sky.glsl.
 */
public const int32 FOG_SKY_WIDTH = 64;
public const int32 FOG_SKY_HEIGHT = 32;

/**
 * The march per texel. The fog colour is soft and 2048 texels leave the GPU mostly idle, so a
 * long march is latency: 8 x 4 is the per-pixel fog march this table replaced.
 */
internal const float32 FOG_SKY_VIEW_SAMPLES = 8.0f;
internal const float32 FOG_SKY_LIGHT_SAMPLES = 4.0f;

/**
 * The table's binding in each program that fogs. The light pass takes 13, which the packed
 * point lights used to hold.
 */
internal const uint32 FOG_SKY_LIGHT_SLOT = 13;
internal const uint32 FOG_SKY_SKY_SLOT = 2;
internal const uint32 FOG_SKY_SKYBOX_SLOT = 1;
internal const uint32 FOG_SKY_WATER_SLOT = 3;

/**
 * The fog's sky table and the atmosphere it was last filled under. The renderer keeps one for
 * the main view; the mirror draws no fog.
 */
internal class FogSkyLut
{
    private Texture $texture;
    private bool $filled;
    private SkyUniforms $built;

    public constructor(Device $device)
    {
        TextureDesc $desc = TextureDesc($format: .rgba16f, $width: FOG_SKY_WIDTH, $height: FOG_SKY_HEIGHT);
        // transfer so dcapture can read the table back; the play path never copies it
        $desc->usage = TEXTURE_SAMPLED | TEXTURE_RENDER_TARGET | TEXTURE_TRANSFER_SRC;
        $desc->label = 'fog.sky';
        $this->texture = Texture($device, 'fog.sky', $desc);
        $this->filled = false;
        // a placeholder until the first fill; `filled` false never compares against it
        $this->built = skyUniforms(Sky(), Vec3(0.0f, 0.0f, 0.0f), false, 0.0f, 0.0f);
    }

    /**
     * Imports the table into this frame's graph and, when the atmosphere moved since it was
     * last filled, adds the pass that refills it ahead of every pass that fogs.
     */
    public function prepare(Pipeline $pipeline, DeferredGpu $gpu, const SkyUniforms& $uniforms) : TextureRef
    {
        TextureRef $ref = $pipeline->importTexture('fog.sky', $this->texture);
        SkyUniforms $key = skyViewKey($uniforms);

        if ($this->filled && $key == $this->built) {
            return $ref;
        }

        $this->built = $key;
        $this->filled = true;
        $pipeline->add(FogSkyPass($gpu, $this->texture, $ref, $key));
        return $ref;
    }

    public function destroy() : void
    {
        $this->texture->destroy();
    }
}

/**
 * Fills the fog's sky table in one draw, one march per texel.
 */
internal class FogSkyPass : Pass
{
    private DeferredGpu $gpu;
    private Texture $texture;
    private TextureRef $ref;
    private SkyUniforms $sky;

    public constructor(DeferredGpu $gpu, Texture $texture, TextureRef $ref, SkyUniforms $sky)
    {
        $this->gpu = $gpu;
        $this->texture = $texture;
        $this->ref = $ref;
        $this->sky = $sky;
    }

    public function name() : string
    {
        return 'deferred.fog.sky';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
        $io->writes($this->ref);
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        ShaderProgram $program = guard $this->gpu->shaders->program('fog_sky') else ($e) {
            return .error(.shader($e));
        }
        ColorTarget $color = ColorTarget($this->texture);
        // every texel is written
        $color->load = .dontCare;
        $color->store = .store;
        RenderPassDesc $desc = RenderPassDesc();
        $desc->colors[] = $color;
        RenderEncoder $enc = $ctx->device->beginRender($desc);
        Device $device = $ctx->device;
        Mesh $mesh = $ctx->pool->cache<Mesh>('quad', function() : Mesh {
            return .quad($device);
        });
        GpuPass $pass = GpuPass($program, VertexLayout::pos3uv2(), Raster::none());
        $pass->bind($enc);
        $enc->upload($this->sky, slot: 2);
        $mesh->draw($enc);
        $enc->endRender();
        return .ok;
    }
}

/**
 * Declares the fog's sky table as a read when this frame has one.
 */
internal function readFogSky(IoSink $io, TextureRef? $table) : void
{
    TextureRef $held = guard $table else {
        return;
    }
    $io->reads($held);
}

/**
 * Binds the fog's sky table at `$slot`, or white when this frame has none (constant fog, fog
 * off, the mirror), so the program's sampler is always valid.
 */
internal function bindFogSky(
    RenderContext $ctx,
    RenderEncoder $enc,
    DeferredGpu $gpu,
    uint32 $slot,
    TextureRef? $table
) : status<PipelineError>
{
    TextureRef $held = guard $table else {
        $enc->bindTexture($slot, $gpu->white, $gpu->skyView);
        return .ok;
    }
    return bindPooled($ctx, $enc, $slot, $held, $gpu->skyView);
}

/**
 * `fog_sky_uv` on the CPU: the table coordinate of an upper-hemisphere direction.
 */
public function fogSkyUv(Vec3 $dir) : Vec2
{
    float64 $y = $dir->y as float64;
    if ($y < 0.0) {
        $y = 0.0;
    }
    if ($y > 1.0) {
        $y = 1.0;
    }

    float64 $v = math::sqrt(math::asin($y) / (0.5 * math::PI));
    float64 $half = 0.5 / (FOG_SKY_HEIGHT as float64);
    if ($v < $half) {
        $v = $half;
    }
    if ($v > 1.0 - $half) {
        $v = 1.0 - $half;
    }

    float64 $u = math::atan2($dir->z as float64, $dir->x as float64) / (2.0 * math::PI) + 0.5;
    return Vec2($u as float32, $v as float32);
}

/**
 * `fog_sky_dir` on the CPU: the direction a table texel stands for.
 */
public function fogSkyDir(Vec2 $uv) : Vec3
{
    float64 $v = $uv->y as float64;
    float64 $elevation = $v * $v * 0.5 * math::PI;
    float64 $azimuth = (($uv->x as float64) - 0.5) * 2.0 * math::PI;
    float64 $c = math::cos($elevation);
    return Vec3(
        ($c * math::cos($azimuth)) as float32,
        math::sin($elevation) as float32,
        ($c * math::sin($azimuth)) as float32
    );
}
