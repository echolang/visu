/**
 * A system that draws into the GBuffer. The renderer opens one encoder on the GBuffer for the
 * whole geometry fill and hands it to every filler in the order they joined, so the seven
 * attachments are loaded and stored once per frame, not once per system.
 */

namespace visu::graphics;

public interface GeometryFiller
{
    /**
     * Profile scope for this filler's work inside the geometry pass. A literal, so frames fold.
     */
    function name() : string;

    /**
     * Record this frame's draws into `$enc`, already open on the GBuffer with the camera bound
     * at slot 1. Bind every pipeline, buffer and texture the draws read: the previous filler's
     * state is still on the encoder. Never end the encoder.
     */
    function record(RenderContext $ctx, RenderEncoder $enc) : status<PipelineError>;
}
