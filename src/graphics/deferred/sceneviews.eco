/**
 * The views a scene frame draws, as the drawers see them in `prepare`. One object lives on the
 * renderer and is refilled every frame.
 */

namespace visu::graphics;

public class SceneViews
{
    /**
     * This frame's G-buffer.
     */
    public GBufferData? $gbuffer;

    /**
     * The key light's cascades; null when no key light is up or shadows are off.
     */
    public ShadowMapData? $shadows;

    /**
     * The water mirror; null when no surface reflects this frame.
     */
    public WaterFrame? $mirror;

    /**
     * The outline mask can be drawn this frame (a scene view, not a debug one).
     */
    public bool $outline;

    public constructor()
    {
        $this->gbuffer = null;
        $this->shadows = null;
        $this->mirror = null;
        $this->outline = false;
    }
}
