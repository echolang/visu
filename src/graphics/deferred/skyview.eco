/**
 * The sky-view LUT: the procedural atmosphere marched once per table texel instead of once
 * per sky pixel. The table depends only on the sun, the moon, the atmosphere knobs and the
 * observer height, so it is refilled only when one of those moved; a paused clock and a still
 * eye cost nothing. Layout and mapping live in resources/shaders/include/visu/sky_view.glsl.
 */

namespace visu::graphics;

use visu::math::{Vec3, Vec4};

/**
 * Table size in texels: azimuth by elevation, the elevation split at the horizon. Mirrors
 * SKY_VIEW_WIDTH / SKY_VIEW_HEIGHT in sky_view.glsl.
 */
public const int32 SKY_VIEW_WIDTH = 256;
public const int32 SKY_VIEW_HEIGHT = 128;

/**
 * Slices of the table: sun Rayleigh, sun Mie, moon Rayleigh, moon Mie, lit ground.
 */
internal const int32 SKY_VIEW_LAYERS = 5;

/**
 * Texture binding the table sits at in the `sky` program.
 */
internal const uint32 SKY_VIEW_SLOT = 1;

/**
 * The part of a packed sky the table depends on: the observer height and not where it stands
 * on the map, and no disc switches, which only the per-pixel lights read.
 */
internal function skyViewKey(const SkyUniforms& $sky) : SkyUniforms
{
    SkyUniforms $key = $sky;
    $key->origin = Vec4(0.0f, $sky->origin->y, 0.0f, 0.0f);
    $key->moonColor = Vec4($sky->moonColor->x, $sky->moonColor->y, $sky->moonColor->z, 0.0f);
    return $key;
}

operator (SkyUniforms $a) == (SkyUniforms $b) : bool
{
    return $a->sun == $b->sun
        && $a->origin == $b->origin
        && $a->rayleigh == $b->rayleigh
        && $a->mie == $b->mie
        && $a->ground == $b->ground
        && $a->params == $b->params
        && $a->moon == $b->moon
        && $a->moonParams == $b->moonParams
        && $a->moonColor == $b->moonColor
        && $a->ozone == $b->ozone;
}
