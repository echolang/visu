/**
 * A place to draw: pixel size, content scale, and a Framebuffer.
 * Class so the pool, window, and callers share one identity.
 */

namespace visu::graphics;

use visu::math::Vec2;

public class RenderTarget
{
    public int32 $width;
    public int32 $height;

    /**
     * Pixel density on the x axis (high-dpi).
     */
    public float32 $contentScaleX;

    /**
     * Pixel density on the y axis (high-dpi).
     */
    public float32 $contentScaleY;

    /**
     * The render target's framebuffer.
     */
    public Framebuffer $framebuffer;

    public constructor(int32 $width, int32 $height, Framebuffer $framebuffer)
    {
        $this->width = $width;
        $this->height = $height;
        $this->contentScaleX = 1.0f;
        $this->contentScaleY = 1.0f;
        $this->framebuffer = $framebuffer;
    }

    /**
     * Logical width in points.
     */
    public const function effectiveWidth() : int32
    {
        return ($this->width as float32 / $this->contentScaleX) as int32;
    }

    /**
     * Logical height in points.
     */
    public const function effectiveHeight() : int32
    {
        return ($this->height as float32 / $this->contentScaleY) as int32;
    }

    public const function effectiveSize() : Vec2
    {
        return Vec2($this->effectiveWidth() as float32, $this->effectiveHeight() as float32);
    }

    public const function isOffscreen() : bool
    {
        return $this->framebuffer->owned;
    }

    public function updateViewport() : void
    {
        $this->framebuffer->gpu()->viewport(0, 0, $this->width, $this->height);
    }

    /**
     * Bind the framebuffer and set the viewport. The verb for "I
     * will draw here".
     */
    public function preparePass() : void
    {
        $this->framebuffer->bind(.readDraw);
        $this->updateViewport();
    }

    public function bindForRead() : bool
    {
        return $this->framebuffer->bind(.read);
    }

    /**
     * New size in pixels. Updates viewport and renderbuffer
     * attachments; texture attachments are left as-is.
     */
    public function resize(int32 $width, int32 $height) : void
    {
        $this->width = $width;
        $this->height = $height;
        $this->framebuffer->bind(.readDraw);
        $this->updateViewport();

        if ($this->framebuffer->owned) {
            $this->framebuffer->resize($width, $height);
        }
    }
}
