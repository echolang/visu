/**
 * A place to draw: pixel size, content scale, color and depth
 * textures. Constructible without a device (scheduler tests).
 */

namespace visu::graphics;

use visu::math::Vec2;

public class RenderTarget
{
    public int32 $width;
    public int32 $height;
    public float32 $contentScaleX = 1.0f;
    public float32 $contentScaleY = 1.0f;
    public array<Texture> $colors;
    public Texture? $depth = null;

    public constructor(int32 $width, int32 $height)
    {
        $this->width = $width;
        $this->height = $height;
        $this->contentScaleX = 1.0f;
        $this->contentScaleY = 1.0f;
        $this->colors = array<Texture>();
    }

    public const function effectiveWidth() : int32
    {
        return ($this->width as float32 / $this->contentScaleX) as int32;
    }

    public const function effectiveHeight() : int32
    {
        return ($this->height as float32 / $this->contentScaleY) as int32;
    }

    public const function effectiveSize() : Vec2
    {
        return Vec2($this->effectiveWidth() as float32, $this->effectiveHeight() as float32);
    }

    public const function formats() : TargetFormats
    {
        TargetFormats $out = TargetFormats();
        uint32 $i = 0;
        array<Texture> $colors = $this->colors;

        foreach ($colors as $tex) {
            assert($i < 4, 'render target color count');
            $out->colors[$i] = $tex->desc->format;
            $i = $i + 1;
        }

        $out->colorCount = $i;
        Texture $depth = guard $this->depth else {
            return $out;
        }
        $out->depth = $depth->desc->format;
        $out->hasDepth = true;
        return $out;
    }

    public const function pass(load: LoadOp $load = .load) : RenderPassDesc
    {
        RenderPassDesc $desc = RenderPassDesc();
        array<Texture> $colors = $this->colors;

        foreach ($colors as $tex) {
            ColorTarget $slot = ColorTarget($tex);
            $slot->load = $load;
            $slot->store = .store;
            $desc->colors[] = $slot;
        }

        Texture $depth = guard $this->depth else {
            return $desc;
        }
        DepthTarget $d = DepthTarget($depth);
        $d->load = $load;
        $d->store = .store;
        $desc->depth = $d;
        return $desc;
    }

    /**
     * Color attachment `$color` as rgba8. After endFrame; stalls.
     */
    public function capture(int32 $color = 0) : result<Pixels, DumpError>
    {
        Texture $tex = guard $this->colorAt($color) else ($e) {
            return .error($e);
        }
        return $tex->capture();
    }

    /**
     * Capture color `$color` then write a PNG. After endFrame.
     */
    public function dump(const string& $path, int32 $color = 0) : status<DumpError>
    {
        Texture $tex = guard $this->colorAt($color) else ($e) {
            return .error($e);
        }
        return $tex->dump($path);
    }

    /**
     * Owned rgba8 copy of color `$color`. Caller destroy()s.
     */
    public function snapshot(int32 $color = 0) : result<Texture, DumpError>
    {
        Texture $tex = guard $this->colorAt($color) else ($e) {
            return .error($e);
        }
        return $tex->snapshot();
    }

    private const function colorAt(int32 $index) : result<Texture, DumpError>
    {
        array<Texture> $colors = $this->colors;

        if ($index < 0 || ($index as usize) >= $colors->count()) {
            return .error(.noColor);
        }

        return .ok($colors[$index as usize]);
    }
}
