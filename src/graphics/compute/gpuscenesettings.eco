/**
 * How the GPU scene culls, as the app configures it. The renderer hands it to `GpuScene` at
 * construction and on every `DeferredRenderer.apply`; nothing in graphics reads a flag.
 */

namespace visu::graphics;

public struct GpuSceneSettings
{
    /**
     * Shadow-map texels a sun caster's bounding radius has to reach to be drawn in a cascade;
     * smaller casters cover a texel or less, which the filter would blur away. 0 draws every
     * caster.
     */
    public float32 $minCasterTexels = 1.0f;

    /**
     * Record each cull stage in its own compute encoder under its own profile scope, so every
     * stage gets a GPU row under `deferred.scene`. A profiling aid: the split loses the shared
     * barriers.
     */
    public bool $splitCull = false;

    /**
     * Pixels an instance's bounding radius has to cover in the camera and the mirror to be
     * drawn (0 draws all). A chunk whose largest member cannot reach it is skipped whole.
     */
    public float32 $minPixels = 0.0f;

    /**
     * Tint every meshlet the camera and the mirror draw a colour hashed from its id, so the
     * cuts show. A debug view.
     */
    public bool $showMeshlets = false;
}
