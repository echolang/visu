internal function gpuWorkgroup(string $program) : visu::graphics::WorkgroupSize?
{
    if ($program == 'bitonic_global') {
        return visu::graphics::WorkgroupSize($x: 256, $y: 1, $z: 1);
    }

    if ($program == 'bitonic_local') {
        return visu::graphics::WorkgroupSize($x: 512, $y: 1, $z: 1);
    }

    if ($program == 'light_args') {
        return visu::graphics::WorkgroupSize($x: 1, $y: 1, $z: 1);
    }

    if ($program == 'light_bins') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'light_visible') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'scan_add') {
        return visu::graphics::WorkgroupSize($x: 1024, $y: 1, $z: 1);
    }

    if ($program == 'scan_args') {
        return visu::graphics::WorkgroupSize($x: 1, $y: 1, $z: 1);
    }

    if ($program == 'scan_block') {
        return visu::graphics::WorkgroupSize($x: 1024, $y: 1, $z: 1);
    }

    if ($program == 'scene_args') {
        return visu::graphics::WorkgroupSize($x: 128, $y: 1, $z: 1);
    }

    if ($program == 'scene_chunks') {
        return visu::graphics::WorkgroupSize($x: 256, $y: 1, $z: 1);
    }

    if ($program == 'scene_members') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'scene_meshlets') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'scene_resolve') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'scene_scatter') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'scene_triangles') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_alloc') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_coarse') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_copy') {
        return visu::graphics::WorkgroupSize($x: 256, $y: 1, $z: 1);
    }

    if ($program == 'vsm_free') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_invalidate') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_mark') {
        return visu::graphics::WorkgroupSize($x: 64, $y: 1, $z: 1);
    }

    if ($program == 'vsm_request') {
        return visu::graphics::WorkgroupSize($x: 8, $y: 8, $z: 1);
    }

    return null;
}

internal function gpuKernels() : array<string>
{
    array<string> $names = ['bitonic_global', 'bitonic_local', 'light_args', 'light_bins', 'light_visible', 'scan_add', 'scan_args', 'scan_block', 'scene_args', 'scene_chunks', 'scene_members', 'scene_meshlets', 'scene_resolve', 'scene_scatter', 'scene_triangles', 'vsm_alloc', 'vsm_coarse', 'vsm_copy', 'vsm_free', 'vsm_invalidate', 'vsm_mark', 'vsm_request'];
    return $names;
}

internal function gpuPrograms() : array<string>
{
    array<string> $names = ['depth_pull', 'depth_pull+alpha', 'depth_pull+vsm', 'depth_pull+vsm_alpha', 'model_pull', 'model_pull+parallax', 'model_pull+prepass', 'model_pull+skinned', 'model_pull+skinned_parallax', 'model_pull+skinned_prepass', 'outline_pull', 'outline_pull+skinned'];
    return $names;
}
