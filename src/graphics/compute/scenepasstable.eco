/**
 * The pipelines a main-set draw (`GpuScene.drawMain`) records with, one per G-buffer class and
 * list. The owner of the classes' programs implements it; the scene only asks.
 */

namespace visu::graphics;

/**
 * Which of a class's pipelines a main-set draw wants: the camera's cut-out depth pre-pass, the
 * camera's shading, the water mirror's shading, or the outline mask.
 */
public enum SceneDrawList
{
    case cameraDepth;
    case camera;
    case mirror;
    case outline;
}

public interface ScenePassTable
{
    /**
     * Class `$class`'s pipeline for `$list`; null skips the class.
     */
    function pass(SceneDrawList $list, int32 $class) : GpuPass?;
}
