/**
 * The GPU scene's cull for this frame, one compute pass ahead of the shadow pass: the table
 * scatters, instance and cluster culling against every view, and the scan that writes the
 * indirect draws the depth passes then record. No texture I/O; it runs where it was added.
 */

namespace visu::graphics;

public class SceneCullPass : Pass
{
    private GpuScene $scene;

    public constructor(GpuScene $scene)
    {
        $this->scene = $scene;
    }

    public function name() : string
    {
        return 'deferred.scene';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        $this->scene->cullCascades($ctx);
        return .ok;
    }
}
