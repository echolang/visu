/**
 * The GPU scene's cull for this frame, one compute pass ahead of the shadow and geometry passes:
 * the table scatters, then the sun cascades and the main views culled together (chunks, members,
 * meshlets, triangles), which writes the indirect draws the depth, G-buffer, mirror and outline
 * passes record. No texture I/O; it runs where it was added.
 */

namespace visu::graphics;

public class SceneCullPass : Pass
{
    private GpuScene $scene;

    public constructor(GpuScene $scene)
    {
        $this->scene = $scene;
    }

    public function name() : string
    {
        return 'deferred.scene';
    }

    public function setup(Pipeline $pipeline, Frame $frame, IoSink $io) : void
    {
    }

    public function execute(RenderContext $ctx) : status<PipelineError>
    {
        $this->scene->cullFrame($ctx);
        return .ok;
    }
}
