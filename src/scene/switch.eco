/**
 * Queue a scene switch.
 * The Director listens; Host.adopt seats `$next` after present. Last write wins if several fire in one frame.
 * A built scene (the loader's target, after its plan) is unloaded when a later signal discards it.
 */

namespace visu::scene;

public struct SwitchSignal
{
    public const Scene $next;

    /**
     * The scene already owns GPU resources. Director unloads it if a later switch discards it before apply.
     */
    public const bool $built = false;
}
