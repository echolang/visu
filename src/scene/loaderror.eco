/**
 * Recoverable failure of a load job. The runner surfaces the first one and stops the plan.
 */

namespace visu::scene;

public enum LoadError
{
    case job(string $label, string $message);
    case io(string $path, string $message);
    case shader(string $message);
    case asset(string $message);
    case cancelled;

    public const function message() : string
    {
        return match ($this) {
            LoadError::job($label, $message) => "{$label}: {$message}",
            LoadError::io($path, $message) => "{$path}: {$message}",
            LoadError::shader($message) => $message,
            LoadError::asset($message) => $message,
            LoadError::cancelled => 'loading cancelled',
        };
    }
}
