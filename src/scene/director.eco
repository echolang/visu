/**
 * One live scene and an optional pending replacement.
 * switch() queues; Host.adopt() unloads, reaps GPU, then loads after present.
 * apply() is the same adopt without GPU (tests).
 * Never auto-ticks bound systems; the scene calls them in the order it wants.
 */

namespace visu::scene;

use visu::app::info;
use visu::graphics::RenderContext;
use visu::signal::{Dispatcher, Flow};
use visu::ui::Ui;

public class Director
{
    private Scene $current;
    private ScenePending $pending;
    private Dispatcher? $dispatcher;
    private int32? $switchId;
    private bool $loaded;

    public constructor(Scene $initial)
    {
        $this->current = $initial;
        $this->pending = .none;
        $this->dispatcher = null;
        $this->switchId = null;
        $this->loaded = false;
    }

    destructor()
    {
        assert(!$this->loaded, 'Director dropped while loaded');
        $this->silence();
    }

    public const function current() : Scene
    {
        return $this->current;
    }

    /**
     * Dispatch of SwitchSignal queues a replacement.
     * Safe to call once; a second call replaces the listener.
     */
    public function listen(Dispatcher $dispatcher) : void
    {
        $this->silence();
        Director $director = $this;
        $this->dispatcher = $dispatcher;
        $this->switchId = $dispatcher->register<SwitchSignal>(function(const SwitchSignal& $signal) : Flow {
            $director->switch($signal->next, $signal->built);
            return .proceed;
        });
    }

    /**
     * Queue `$scene`. `$built` means it already owns GPU resources (a loader target) even though
     * load() has not run. Replacing a built pending scene unloads it. A scene that was only
     * constructed has nothing to free.
     */
    public function switch(Scene $scene, bool $built = false) : void
    {
        $this->discardPending();
        if ($built) {
            $this->pending = .built($scene);
        } else {
            $this->pending = .constructed($scene);
        }
    }

    public const function pending() : bool
    {
        return match ($this->pending) {
            ScenePending::none => false,
            else => true,
        };
    }

    public function load() : void
    {
        if ($this->loaded) {
            return;
        }

        $this->current->load();
        $this->loaded = true;
        string $name = $this->current->name();
        info("scene: {$name}");
    }

    public function update() : void
    {
        $this->current->update();
    }

    public function render(RenderContext $ctx) : void
    {
        $this->current->render($ctx);
    }

    public function ui(Ui $ui) : void
    {
        $this->current->ui($ui);
    }

    /**
     * Unload the live scene. Leaves the queued scene in place so loadIncoming can adopt it.
     * No-op when nothing is pending.
     */
    public function unloadOutgoing() : void
    {
        if (!$this->pending()) {
            return;
        }

        if (!$this->loaded) {
            return;
        }

        $this->current->unload();
        $this->loaded = false;
    }

    /**
     * Seat the queued scene and load it. No-op when nothing is pending.
     */
    public function loadIncoming() : void
    {
        ScenePending $held = $this->pending;
        $this->pending = .none;
        match ($held) {
            ScenePending::none => {
                return;
            },
            ScenePending::constructed($scene) => {
                $this->current = $scene;
            },
            ScenePending::built($scene) => {
                $this->current = $scene;
            },
        };
        $this->load();
    }

    /**
     * Unload the live scene, adopt the queued one, load it.
     * Tests call this. The play path is Host.adopt, which reaps GPU between unload and load.
     */
    public function apply() : void
    {
        $this->unloadOutgoing();
        $this->loadIncoming();
    }

    public function unload() : void
    {
        $this->discardPending();
        if (!$this->loaded) {
            return;
        }

        $this->current->unload();
        $this->loaded = false;
    }

    /**
     * Drop a queued scene. Unload it only when it was flagged built.
     */
    private function discardPending() : void
    {
        ScenePending $held = $this->pending;
        $this->pending = .none;
        match ($held) {
            ScenePending::none => {
            },
            ScenePending::constructed($scene) => {
            },
            ScenePending::built($scene) => {
                $scene->unload();
            },
        };
    }

    private function silence() : void
    {
        Dispatcher $dispatcher = guard $this->dispatcher else {
            return;
        }
        int32 $id = guard $this->switchId else {
            $this->dispatcher = null;
            return;
        }
        $dispatcher->unregister<SwitchSignal>($id);
        $this->switchId = null;
        $this->dispatcher = null;
    }
}
