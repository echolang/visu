/**
 * Baked loading-screen shaders. Programs: loading. Generated by
 * `php tools/shaders.php --bake`. Do not edit.
 */

namespace visu::scene;

#[if: (os == darwin || os == ios) && !VISU_BACKEND_VULKAN]
internal function loadingBytes(string $program, visu::graphics::ShaderKind $kind) : string?
{
    if ($program == 'loading' && $kind == visu::graphics::ShaderKind::fragment) {
        return '// generated by tools/shaders.php — do not edit
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct LoadingData
{
    float4 u_time;
};

struct fs_out
{
    float4 FragColor [[color(0)]];
};

struct fs_in
{
    float2 v_uv [[user(locn0)]];
};

fragment fs_out fs(fs_in in [[stage_in]], constant LoadingData& _12 [[buffer(2)]])
{
    fs_out out = {};
    float t = _12.u_time.x;
    float2 uv = in.v_uv;
    float2 p = (uv * 2.0) - float2(1.0);
    p.x *= 1.77777779102325439453125;
    float v = length(p);
    float3 dusk = float3(0.070000000298023223876953125, 0.0500000007450580596923828125, 0.039999999105930328369140625);
    float3 clay = float3(0.180000007152557373046875, 0.10999999940395355224609375, 0.070000000298023223876953125);
    float3 leaf = float3(0.100000001490116119384765625, 0.20000000298023223876953125, 0.119999997317790985107421875);
    float wave = 0.5 + (0.5 * sin((t * 0.3499999940395355224609375) + (uv.y * 3.2000000476837158203125)));
    float3 col = mix(dusk, clay, float3(uv.y));
    col = mix(col, leaf, float3((0.180000007152557373046875 * wave) * (1.0 - uv.y)));
    col *= (1.0 - (0.4799999892711639404296875 * smoothstep(0.3499999940395355224609375, 1.4500000476837158203125, v)));
    float2 blob = p - float2(sin(t * 0.2800000011920928955078125) * 0.4199999868869781494140625, cos(t * 0.2199999988079071044921875) * 0.180000007152557373046875);
    col += (float3(0.100000001490116119384765625, 0.070000000298023223876953125, 0.02999999932944774627685546875) * exp((-dot(blob, blob)) * 3.7999999523162841796875));
    out.FragColor = float4(col, 1.0);
    return out;
}

';
    }

    if ($program == 'loading' && $kind == visu::graphics::ShaderKind::vertex) {
        return '// generated by tools/shaders.php — do not edit
#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct vs_out
{
    float2 v_uv [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vs_in
{
    float3 a_position [[attribute(0)]];
    float2 a_uv [[attribute(1)]];
};

vertex vs_out vs(vs_in in [[stage_in]])
{
    vs_out out = {};
    out.gl_Position = float4(in.a_position, 1.0);
    out.v_uv = float2(in.a_uv.x, 1.0 - in.a_uv.y);
    return out;
}

';
    }

    return null;
}
#[else]
internal function loadingBytes(string $program, visu::graphics::ShaderKind $kind) : string?
{
    if ($program == 'loading' && $kind == visu::graphics::ShaderKind::fragment) {
        return visu::graphics::hexBytes('');
    }

    if ($program == 'loading' && $kind == visu::graphics::ShaderKind::vertex) {
        return visu::graphics::hexBytes('');
    }

    return null;
}
#[end]
