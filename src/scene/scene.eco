/**
 * A loadable level, menu, or other exclusive app mode.
 * Each scene owns its own entities and systems.
 * Construct is cheap; no GPU and no listeners, so a scene can be queued as the next one without paying load.
 * Host.adopt() unloads the old scene after present, reaps GPU, then loads the new.
 */

namespace visu::scene;

use visu::graphics::RenderContext;
use visu::ui::Ui;

public interface Scene
{
    const function name() : string;
    function load() : void;
    function unload() : void;
    function update() : void;
    function render(RenderContext $ctx) : void;
    function ui(Ui $ui) : void;
}
