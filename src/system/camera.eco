/**
 * Picks the active camera entity and publishes `CameraData` for the frame.
 * Controllers (`FlyingCamera`, `OrbitCamera`) live on the entity and are driven by their own systems.
 * An entity with only `Camera` + `Transform` is static or scripted; this system still publishes it, and does not move it.
 *
 * Bind this before any system that reads `CameraData`.
 */

namespace visu::system;

use visu::ecs::{Entities, Entity, System};
use visu::geo::{Pose, Transform};
use visu::graphics::{
    Backbuffer, Camera, CameraData, Context, SceneTarget, TargetRef
};

public class CameraSystem : System
{
    public Entity $activeCamera;

    public constructor()
    {
        $this->activeCamera = Entity::none();
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function update(Entities $entities) : void
    {
        Entity $active = $this->activeCamera;

        if (!$this->valid($entities, $active)) {
            return;
        }

        // snapshot before this tick moves anything, so render interpolates from where the camera actually was
        Transform& $transform = $entities->get<Transform>($active);
        $transform->storePrevious();
    }

    public function render(Entities $entities, const Context& $ctx) : void
    {
        Entity $active = $this->activeCamera;

        if (!$this->valid($entities, $active)) {
            return;
        }

        // the borrow is const; the handles inside are not
        Context $frameCtx = $ctx;
        TargetRef $target = $this->target($frameCtx);
        Camera& $camera = $entities->get<Camera>($active);
        Transform& $transform = $entities->get<Transform>($active);
        Pose $pose = $transform->mix($frameCtx->compensation);
        $frameCtx->frame->set($camera->data(
            $pose,
            $target->width,
            $target->height,
            $target->contentScaleX,
            $target->contentScaleY,
            $ctx->compensation
        ));
    }

    public const function valid(Entities $entities, Entity $entity) : bool
    {
        if (!$entities->valid($entity)) {
            return false;
        }

        return $entities->has<Camera>($entity) && $entities->has<Transform>($entity);
    }

    private const function target(Context $ctx) : TargetRef
    {
        SceneTarget $scene = guard $ctx->frame->find<SceneTarget>() else {
            return $ctx->frame->get<Backbuffer>()->target;
        }
        return $scene->target;
    }
}
