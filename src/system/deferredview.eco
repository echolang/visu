/**
 * Console verb `view` that picks which deferred buffer the renderer blits.
 * Holds the renderer; does not draw.
 */

namespace visu::system;

use visu::ecs::{Entities, Schedule, System};
use visu::graphics::{DeferredRenderer, DeferredView, RenderContext};
use visu::runtime::{ConsoleCommandHandler, ConsoleCommandRegistry, DebugConsole};
use visu::signal::ConsoleCommandSignal;

internal const VIEW_USAGE = 'usage: view [scene|albedo|normal|roughness|metallic|ao|emissive|position|ssao]';

public class DeferredViewSystem : System, ConsoleCommandHandler
{
    public DeferredRenderer $renderer;

    public constructor(DeferredRenderer $renderer)
    {
        $this->renderer = $renderer;
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->update = false;
        $schedule->render = false;
    }

    public function update(Entities $entities) : void
    {
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
    }

    public function registerConsoleCommands(ConsoleCommandRegistry $registry) : array<string>
    {
        $registry->add('view', $this);
        array<string> $names = array<string>();
        $names[] = 'view';
        return $names;
    }

    public function onConsoleCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void
    {
        if ($cmd->parts->count() < 2) {
            string $name = $this->renderer->view->label();
            $console->writeLine("view: {$name}");
            return;
        }

        string $part = $cmd->parts[1];
        DeferredView $view = guard DeferredView::parse($part) else {
            $console->writeLine(VIEW_USAGE);
            return;
        }
        $this->renderer->view = $view;
        string $name = $view->label();
        if ($view->needsSsao() && $this->renderer->ssao == null) {
            $console->writeLine("view: {$name} (ssao is off)");
            return;
        }

        $console->writeLine("view: {$name}");
    }
}
