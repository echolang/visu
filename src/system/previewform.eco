/**
 * A model or an assembly posed for `ModelSystem.preview`: each drawn part's model id and its pose
 * under the root, composed once when the form is built. A placement ghost is one form submitted
 * at a root matrix each frame, so the frame never walks an assembly's node tree or its strings.
 *
 * A form belongs to the `ModelSystem` that built it: `handles` are that system's handle slots,
 * resolved in its first `fill` after the form is built. Skinned parts are left out; a ghost does
 * not pose.
 */

namespace visu::system;

use visu::math::Mat4;

public class PreviewForm
{
    internal array<string> $models;
    internal array<Mat4> $locals;

    /**
     * Handle slot per part: `PREVIEW_UNRESOLVED` until the first fill, -1 when the model failed.
     */
    internal array<int32> $handles;

    public constructor()
    {
        $this->models = array<string>();
        $this->locals = array<Mat4>();
        $this->handles = array<int32>();
    }

    /**
     * Parts the form draws.
     */
    public const function count() : int32
    {
        return $this->models->count() as int32;
    }

    internal function add(string $model, Mat4 $local) : void
    {
        $this->models[] = $model;
        $this->locals[] = $local;
        $this->handles[] = PREVIEW_UNRESOLVED;
    }
}

/**
 * A part whose handle slot the owning `ModelSystem` has not looked up yet.
 */
internal const int32 PREVIEW_UNRESOLVED = -2;
