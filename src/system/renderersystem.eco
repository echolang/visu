/**
 * Renders the frame from the ECS render phase: `DeferredRenderer.render` into the scene target,
 * after every system bound before it has published (the camera, the lights, the water). Bind it
 * after them; what draws the scene is attached to the renderer, not called from here.
 */

namespace visu::system;

use visu::ecs::{Entities, Schedule, System};
use visu::graphics::{DeferredRenderer, RenderContext, SceneTargetData};

public class RendererSystem : System
{
    private DeferredRenderer $renderer;

    public constructor(DeferredRenderer $renderer)
    {
        $this->renderer = $renderer;
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->update = false;
    }

    public function update(Entities $entities) : void
    {
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
        $this->renderer->render($ctx, $ctx->frame->get<SceneTargetData>()->target);
    }
}
