/**
 * Draws every `StaticModel`, `DynamicModel` and `SkinnedModel` into the GBuffer and the shadow
 * cascades. Statics are placed once into an octree with a baked world matrix and culled by it;
 * dynamics and skins read their `Transform` every frame and are culled per instance by the
 * draw-call assembler. All pick a LOD by distance and batch by material. Rigid models go through
 * one `ModelLane`, skinned ones through a second whose programs read the frame's joint palette
 * at slot 2: `fill` packs every posed skin within reach into one array, and the first pass that
 * draws a skin copies it into the frame's ring once. Models and textures come from the
 * `ModelBank`, which outlives the scene; the assemblers' mesh handles are this system's and die
 * with it.
 * `highlight` marks entities for the renderer's outline: `fill` resubmits just those into each
 * lane's outline assembler and opts the system into `OutlineData`, so nothing highlighted costs
 * nothing.
 * GPU acquisition happens in `fill`, never inside the pass: an open encoder allows no uploads.
 * `fill` is the only graph entry: Quickstart runs `$opt->render` before `Systems.render`, so this
 * system opts out of the render phase.
 */

namespace visu::system;

use visu::app::{FlagValue, Flags, flags, info};
use visu::asset::MODEL_MAX_LODS;
use visu::components::{AssemblyInstance, DynamicModel, SkinPose, SkinnedModel, StaticModel};
use visu::ecs::{Entities, Entity, Schedule, System};
use visu::geo::{AABB, Frustum, Transform};
use visu::graphics::{
    CallbackPass, CameraData, DebugLines, DeferredRenderer, DrawCallAssembler, Frame, GBufferData,
    GpuPass, IoSink, Model, ModelBank, ModelInstanceData, OUTLINE_STYLES, OutlineCaster, OutlineData,
    Pipeline, PipelineError, RenderContext, RenderEncoder, SHADOW_CASCADES, SKIN_PALETTE_ROWS, SKIN_PALETTE_SLOT, ShaderProgram,
    ShadowCascade, ShadowCaster, ShadowMapData, SkinInstanceData, TransientSlice, debugLinePass,
    lodIndex, modelLayout, skinnedLayout
};
use visu::console::lodColor;
use visu::math::{Mat4, Vec3, Vec4, length};
use visu::runtime::DebugConsole;

/**
 * One model's assembler handles, lod-major: level `l` is `$handles[$lodStart[l] .. $lodStart[l + 1])`.
 */
internal class ModelHandles
{
    public Model $model;
    public array<visu::graphics::MeshHandle> $handles;
    public array<int32> $lodStart;

    public constructor(Model $model)
    {
        $this->model = $model;
        $this->handles = array<visu::graphics::MeshHandle>();
        $this->lodStart = array<int32>();
    }
}

/**
 * One skin this frame: where it stands and where its joints start in the frame palette.
 * `fill` writes these; the GBuffer pass and every cascade read the same list.
 */
internal struct SkinDraw
{
    public Entity $entity;
    public int32 $handles;
    public Mat4 $world;
    public AABB $bounds;
    public Vec4 $tint;
    public float32 $lodBias;
    public float32 $base;
}

/**
 * Model entities `highlight` may hold at once. An assembly root counts each part it expands to.
 */
public const int32 MODEL_HIGHLIGHTS = 16;

/**
 * One highlighted model entity and the outline style slot it glows in.
 */
internal struct ModelHighlight
{
    public Entity $entity;
    public int32 $style;
}

public class ModelSystem : System, ShadowCaster, OutlineCaster
{
    public ModelBank $bank;
    public DeferredRenderer $renderer;

    /**
     * Global LOD distance multiplier. Console `model lod <bias>` or the `model.lod` flag;
     * below 1 keeps detail further out.
     */
    public float32 $lodBias;
    public bool $wireframe;

    /**
     * Draw each submitted instance's world bounds, coloured by the LOD level it drew at.
     * Console `model bounds on`, or the `model.bounds` flag.
     */
    public bool $showBounds;

    /**
     * Draw the octree cells that still hold something, brighter the deeper they sit.
     * Console `model octree on`, or the `model.octree` flag.
     */
    public bool $showOctree;

    /**
     * `Flags.version` last applied, so a flag set at runtime lands without fighting the console verb.
     */
    private int32 $flagsSeen;

    /**
     * Counts from the last draw, for the console and tests.
     */
    public int32 $dynamicCount;
    public int32 $skinnedCount;

    /**
     * Palette rows packed this frame, and skins left out because the palette was full.
     */
    public int32 $paletteRows;
    public int32 $paletteDropped;
    public int32 $submitted;
    public int32 $distanceCulled;
    public array<int32> $lodHistogram;
    private StaticSet $statics;
    private ModelLane<ModelInstanceData> $rigid;
    private ModelLane<SkinInstanceData> $skinned;
    private map<string, int32> $modelIndex;
    private array<ModelHandles> $models;
    private map<Entity, int32> $dynamicOf;
    private map<Entity, int32> $skinnedOf;

    /**
     * This frame's skins and their palette rows, kept across frames so the capacity survives.
     */
    private array<SkinDraw> $skinDraws;
    private array<Vec4> $palette;

    /**
     * Highlighted model entities, room for `MODEL_HIGHLIGHTS` taken at construction.
     */
    private array<ModelHighlight> $highlights;

    /**
     * The palette's slice in this frame's ring, copied by the first pass that draws a skin.
     * `packSkins` clears it every frame.
     */
    private TransientSlice? $paletteSlice;
    private bool $paletteWarned;
    private DebugLines $lines;
    private GpuPass? $linePass;
    private int32 $detachStatic;
    private int32 $detachDynamic;
    private int32 $detachSkinned;

    public constructor(ModelBank $bank, DeferredRenderer $renderer, const AABB& $world)
    {
        $this->bank = $bank;
        $this->renderer = $renderer;
        $this->lodBias = flags()->float('model.lod', 1.0) as float32;
        $this->wireframe = flags()->bool('model.wire', false);
        $this->showBounds = flags()->bool('model.bounds', false);
        $this->showOctree = flags()->bool('model.octree', false);
        $this->flagsSeen = flags()->version;
        $this->dynamicCount = 0;
        $this->skinnedCount = 0;
        $this->paletteRows = 0;
        $this->paletteDropped = 0;
        $this->submitted = 0;
        $this->distanceCulled = 0;
        $this->lodHistogram = array<int32>();
        int32 $i = 0;
        while ($i < MODEL_MAX_LODS) {
            $this->lodHistogram[] = 0;
            $i = $i + 1;
        }

        $this->statics = StaticSet($world);
        $this->rigid = ModelLane<ModelInstanceData>(
            $bank->device,
            modelLayout(),
            'model',
            'model+parallax',
            'shadow',
            'outline_mask'
        );
        $this->skinned = ModelLane<SkinInstanceData>(
            $bank->device,
            skinnedLayout(),
            'model+skinned',
            'model+skinned_parallax',
            'shadow+skinned',
            'outline_mask+skinned'
        );
        $this->modelIndex = map<string, int32>();
        $this->models = array<ModelHandles>();
        $this->dynamicOf = map<Entity, int32>();
        $this->skinnedOf = map<Entity, int32>();
        $this->skinDraws = array<SkinDraw>();
        $this->palette = array<Vec4>();
        $this->palette->reserve(SKIN_PALETTE_ROWS as usize);
        $this->highlights = arr::room<ModelHighlight>(MODEL_HIGHLIGHTS as usize);
        $this->paletteSlice = null;
        $this->paletteWarned = false;
        $this->lines = DebugLines($bank->device);
        $this->linePass = null;
        $this->detachStatic = -1;
        $this->detachDynamic = -1;
        $this->detachSkinned = -1;
    }

    /**
     * Live static records this frame.
     */
    public const function staticCount() : int32
    {
        return $this->statics->count;
    }

    /**
     * A detached static leaves the octree at once, before its entity is reused.
     */
    public function register(Entities $entities) : void
    {
        ModelSystem $sys = $this;
        $this->detachStatic = $entities->onDetach<StaticModel>(function(Entities $w, Entity $e, const StaticModel& $c) : void {
            $sys->release($e);
            $sys->dropHighlight($e);
        });
        $this->detachDynamic = $entities->onDetach<DynamicModel>(function(Entities $w, Entity $e, const DynamicModel& $c) : void {
            $sys->forgetDynamic($e);
            $sys->dropHighlight($e);
        });
        $this->detachSkinned = $entities->onDetach<SkinnedModel>(function(Entities $w, Entity $e, const SkinnedModel& $c) : void {
            $sys->forgetSkinned($e);
            $sys->dropHighlight($e);
        });
    }

    /**
     * Drop handles, octree and statics. The bank keeps the models. Caller waitIdle first.
     */
    public function unregister(Entities $entities) : void
    {
        if ($this->detachStatic >= 0) {
            $entities->releaseOnDetach($this->detachStatic);
            $this->detachStatic = -1;
        }

        if ($this->detachDynamic >= 0) {
            $entities->releaseOnDetach($this->detachDynamic);
            $this->detachDynamic = -1;
        }

        if ($this->detachSkinned >= 0) {
            $entities->releaseOnDetach($this->detachSkinned);
            $this->detachSkinned = -1;
        }

        $this->rigid->clear();
        $this->skinned->clear();
        $this->models->clear();
        $this->modelIndex->clear();
        $this->statics->clear();
        $this->dynamicOf->clear();
        $this->skinnedOf->clear();
        $this->skinDraws->clear();
        $this->palette->clear();
        $this->highlights->clear();
        $this->lines->clear();
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->render = false;
    }

    public function update(Entities $entities) : void
    {
        Flags $bag = flags();
        if ($bag->version == $this->flagsSeen) {
            return;
        }

        $this->flagsSeen = $bag->version;
        if ($bag->has('model.lod')) {
            $this->lodBias = $bag->float('model.lod', $this->lodBias as float64) as float32;
        }

        if ($bag->has('model.wire')) {
            bool $wire = $bag->bool('model.wire', $this->wireframe);
            if ($wire != $this->wireframe) {
                $this->wireframe = $wire;
                $this->rigid->reset();
                $this->skinned->reset();
            }
        }

        if ($bag->has('model.bounds')) {
            $this->showBounds = $bag->bool('model.bounds', $this->showBounds);
        }

        if ($bag->has('model.octree')) {
            $this->showOctree = $bag->bool('model.octree', $this->showOctree);
        }
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
    }

    /**
     * Outline `$root` in style slot `$style` until `unhighlight`. An assembly root (the windmill)
     * expands to every part that carries a model, once, here; the frame never walks the nodes.
     * Highlighting again only changes the style. Past `MODEL_HIGHLIGHTS` entities the rest are
     * left out. Call it on a change (hover in, hover out), not every frame.
     */
    public function highlight(Entities $entities, Entity $root, int32 $style) : void
    {
        assert($style >= 0 && $style < OUTLINE_STYLES, 'highlight style slot out of range');
        if (!$entities->valid($root)) {
            return;
        }

        if ($entities->has<AssemblyInstance>($root)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                if ($this->drawsModel($entities, $node)) {
                    $this->mark($node, $style);
                }
            }
        }

        if ($this->drawsModel($entities, $root)) {
            $this->mark($root, $style);
        }
    }

    /**
     * Stop outlining `$root` and, for an assembly, each of its parts.
     */
    public function unhighlight(Entities $entities, Entity $root) : void
    {
        if ($entities->valid($root) && $entities->has<AssemblyInstance>($root)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                $this->dropHighlight($node);
            }
        }

        $this->dropHighlight($root);
    }

    public function clearHighlights() : void
    {
        $this->highlights->clear();
    }

    /**
     * Model entities outlined now, assembly parts counted one by one.
     */
    public const function highlightCount() : int32
    {
        return $this->highlights->count() as int32;
    }

    public const function highlighted(Entity $e) : bool
    {
        foreach ($this->highlights as $h) {
            if ($h->entity == $e) {
                return true;
            }
        }

        return false;
    }

    /**
     * Draw the outline lists `prepareOutline` built into the open mask encoder.
     */
    public function mask(RenderContext $ctx, RenderEncoder $enc) : void
    {
        $this->rigid->outline($enc, $this->bank);
        if ($this->skinned->outlines()) {
            $this->bindPalette($enc);
            $this->skinned->outline($enc, $this->bank);
        }
    }

    /**
     * Re-place a static whose Transform moved. It rejoins the octree on the next fill. An
     * assembly root (a moved prop) re-places every part node under it, so the caller never walks
     * the tree; a dynamic or skinned part reads its Transform each frame and is left alone.
     */
    public function restatic(Entities $entities, Entity $e) : void
    {
        if ($entities->valid($e) && $entities->has<AssemblyInstance>($e)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($e);
            foreach ($inst->nodes as $name => $node) {
                $this->release($node);
            }
        }

        $this->release($e);
    }

    /**
     * Acquire new components, then one pass that writes the GBuffer with every visible instance.
     */
    public function fill(Entities $entities, RenderContext $ctx, GBufferData $gbuffer) : void
    {
        $this->ensurePasses();
        $this->acquireAll($entities);
        $this->packSkins($entities, $ctx);
        ModelSystem $sys = $this;
        Entities $world = $entities;
        $ctx->pipeline->add(CallbackPass(
            'models',
            setup: function(Pipeline $pipe, Frame $frame, IoSink $io) : void {
                $io->writes($gbuffer->target);
            },
            execute: function(RenderContext $inner) : status<PipelineError> {
                return $sys->draw($world, $inner, $gbuffer);
            }
        ));
        ShadowMapData? $shadows = $ctx->frame->find<ShadowMapData>();
        if ($shadows != null) {
            ShadowMapData $data = guard $shadows;
            $this->prepareShadows($entities, $ctx, $data->cascades);
            $data->add($this);
        }

        if ($this->highlights->count() > 0) {
            OutlineData? $outline = $ctx->frame->find<OutlineData>();
            if ($outline != null) {
                OutlineData $mailbox = guard $outline;
                $this->prepareOutline($entities, $ctx, $mailbox);
            }
        }
    }

    /**
     * Submit each highlighted entity into its lane's outline assembler at the LOD the main pass
     * picks, so the mask traces the same surface the scene depth holds. O(highlighted); statics
     * resolve through the set's entity map, skins through this frame's short skin list.
     */
    private function prepareOutline(Entities $entities, RenderContext $ctx, OutlineData $mailbox) : void
    {
        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return;
        }
        visu::profile::begin('outline');
        $this->rigid->outlineDca->clearInstances();
        $this->skinned->outlineDca->clearInstances();
        Vec3 $eye = $view->cullPosition;
        float32 $alpha = $ctx->compensation;
        bool $any = false;
        AABB $box = AABB(Vec3(0.0f), Vec3(0.0f));
        foreach ($this->highlights as $mark) {
            // the mask program reads the style slot from the tint's red channel
            Vec4 $tag = Vec4($mark->style as float32, 0.0f, 0.0f, 1.0f);
            Entity $e = $mark->entity;
            int32 $slot = $this->statics->find($e);
            if ($slot >= 0) {
                StaticInstance $inst = $this->statics->get($slot as uint32);
                if ($inst->live) {
                    ModelHandles $h = $this->models[$inst->handles as usize];
                    $this->submitVisible($this->rigid->outlineDca, $h, $inst->world, $inst->bounds, ModelInstanceData($tag), $inst->lodBias, $eye, false);
                    $box = outlineUnion($box, $inst->bounds, $any);
                    $any = true;
                }

                continue;
            }

            if ($this->dynamicOf->has($e) && $entities->has<DynamicModel>($e)) {
                ModelHandles $h = $this->models[$this->dynamicOf[$e] as usize];
                DynamicModel& $dynamic = $entities->get<DynamicModel>($e);
                Transform& $t = $entities->get<Transform>($e);
                Mat4 $world = $t->world($entities, $alpha);
                AABB $bounds = $h->model->bounds->transformed($world);
                $this->submitVisible($this->rigid->outlineDca, $h, $world, $bounds, ModelInstanceData($tag), $dynamic->lodBias, $eye, false);
                $box = outlineUnion($box, $bounds, $any);
                $any = true;
                continue;
            }

            foreach ($this->skinDraws as $skin) {
                if ($skin->entity != $e) {
                    continue;
                }

                ModelHandles $h = $this->models[$skin->handles as usize];
                SkinInstanceData $payload = SkinInstanceData($tag, Vec4($skin->base, 0.0f, 0.0f, 0.0f));
                $this->submitVisible($this->skinned->outlineDca, $h, $skin->world, $skin->bounds, $payload, $skin->lodBias, $eye, false);
                $box = outlineUnion($box, $skin->bounds, $any);
                $any = true;
            }
        }

        $this->rigid->buildOutline($view->cullFrustum, $eye);
        $this->skinned->buildOutline($view->cullFrustum, $eye);
        visu::profile::end();
        if ($any && ($this->rigid->outlines() || $this->skinned->outlines())) {
            $mailbox->add($this, $box);
        }
    }

    /**
     * Cull, pick LODs, build the batches and record them. No-op before CameraSystem published.
     */
    public function draw(Entities $entities, RenderContext $ctx, GBufferData $gbuffer) : status<PipelineError>
    {
        CameraData $camera = guard $ctx->frame->find<CameraData>() else {
            return .ok;
        }
        if (!$this->rigid->ready()) {
            return .ok;
        }

        visu::profile::begin('cull');
        $this->submitAll($entities, $camera->cullFrustum, $camera->cullPosition, $ctx->compensation);
        $this->rigid->dca->build($camera->cullFrustum, $camera->cullPosition);
        $this->skinned->dca->build($camera->cullFrustum, $camera->cullPosition);
        if ($camera->cullFrozen) {
            $this->lines->frustum($camera->cullCorners(), Vec4(1.00f, 0.85f, 0.15f, 1.0f));
            $this->lines->cross($camera->cullPosition, 4.0f);
        }

        visu::profile::end();
        bool $geometry = $this->rigid->dca->commandCount() > 0;
        bool $skins = $this->skinned->dca->commandCount() > 0;
        if (!$geometry && !$skins && $this->lines->empty()) {
            return .ok;
        }

        visu::profile::begin('draw');
        RenderEncoder $enc = guard $ctx->beginRender($gbuffer->target) else ($e) {
            visu::profile::end();
            return .error($e);
        }
        $this->renderer->bindCamera($enc);
        if ($geometry) {
            $this->rigid->draw($enc, $this->bank);
        }

        if ($skins) {
            visu::profile::begin('skinned');
            $this->bindPalette($enc);
            $this->skinned->draw($enc, $this->bank);
            visu::profile::end();
        }

        $this->drawLines($enc);
        $enc->endRender();
        visu::profile::end();
        return .ok;
    }

    /**
     * Cull against each cascade frustum, pick LODs from the play camera. The light eye sits far
     * up the sun ray, so distance from there would put every model at its coarsest level.
     * Statics are octree-queried per cascade; dynamics are walked once.
     */
    public function prepareShadows(
        Entities $entities,
        RenderContext $ctx,
        const ShadowCascade[5]& $cascades
    ) : void
    {
        $this->ensurePasses();
        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return;
        }
        visu::profile::begin('cull');
        $this->rigid->clearShadows();
        $this->skinned->clearShadows();
        Vec3 $eye = $view->cullPosition;
        float32 $alpha = $ctx->compensation;
        int32 $i = 0;
        while ($i < SHADOW_CASCADES) {
            ShadowCascade $cascade = $cascades[$i];
            DrawCallAssembler<ModelInstanceData> $dca = $this->rigid->shadowDca[$i as usize];
            $this->statics->query($cascade->frustum);
            array<uint32> $ids = $this->statics->visible();
            foreach ($ids as $id) {
                StaticInstance $inst = $this->statics->get($id);
                if (!$inst->live) {
                    continue;
                }

                ModelHandles $h = $this->models[$inst->handles as usize];
                $this->submitVisible($dca, $h, $inst->world, $inst->bounds, ModelInstanceData($inst->tint), $inst->lodBias, $eye, false);
            }

            $i = $i + 1;
        }

        foreach ($entities->view<DynamicModel>() as $id => &$dynamic) {
            if (!$this->dynamicOf->has($id)) {
                continue;
            }

            ModelHandles $h = $this->models[$this->dynamicOf[$id] as usize];
            Transform& $t = $entities->get<Transform>($id);
            Mat4 $world = $t->world($entities, $alpha);
            AABB $bounds = $h->model->bounds->transformed($world);
            $i = 0;
            while ($i < SHADOW_CASCADES) {
                if ($cascades[$i]->frustum->contains($bounds)) {
                    $this->submitVisible(
                        $this->rigid->shadowDca[$i as usize],
                        $h,
                        $world,
                        $bounds,
                        ModelInstanceData($dynamic->tint),
                        $dynamic->lodBias,
                        $eye,
                        false
                    );
                }

                $i = $i + 1;
            }
        }

        foreach ($this->skinDraws as $skin) {
            ModelHandles $h = $this->models[$skin->handles as usize];
            SkinInstanceData $payload = SkinInstanceData($skin->tint, Vec4($skin->base, 0.0f, 0.0f, 0.0f));
            $i = 0;
            while ($i < SHADOW_CASCADES) {
                if ($cascades[$i]->frustum->contains($skin->bounds)) {
                    $this->submitVisible(
                        $this->skinned->shadowDca[$i as usize],
                        $h,
                        $skin->world,
                        $skin->bounds,
                        $payload,
                        $skin->lodBias,
                        $eye,
                        false
                    );
                }

                $i = $i + 1;
            }
        }

        $this->rigid->buildShadows($cascades, $eye);
        $this->skinned->buildShadows($cascades, $eye);
        visu::profile::end();
    }

    /**
     * Draw the list `prepareShadows` built into an open cascade encoder.
     */
    public function cast(RenderContext $ctx, RenderEncoder $enc, const ShadowCascade& $cascade) : void
    {
        int32 $index = $cascade->index;
        bool $rigid = $this->rigid->casts($index);
        bool $skins = $this->skinned->casts($index);
        if (!$rigid && !$skins) {
            return;
        }

        $enc->upload($cascade->uniforms, slot: 1);
        if ($rigid) {
            $this->rigid->cast($enc, $this->bank, $index);
        }

        if ($skins) {
            $this->bindPalette($enc);
            $this->skinned->cast($enc, $this->bank, $index);
        }
    }

    /**
     * Copy this frame's palette into the ring the first time a pass needs it, then bind that
     * slice at slot 2. Later passes of the frame rebind the same slice.
     */
    private function bindPalette(RenderEncoder $enc) : void
    {
        if ($this->palette->count() == 0) {
            return;
        }

        TransientSlice $slice = guard $this->paletteSlice else {
            uint64 $bytes = ($this->palette->count() as uint64) * (mem::size<Vec4>() as uint64);
            TransientSlice $fresh = $this->bank->device->allocTransient($bytes, $this->bank->device->limits()->uniformAlign);
            ptr<const uint8> $src = ptr<const uint8>(&$this->palette[0]);
            mem::copy<uint8>(ptr<uint8>($fresh->data:$), ptr<uint8>($src:$), $bytes);
            $this->paletteSlice = $fresh;
            $enc->bindUniform(SKIN_PALETTE_SLOT, $fresh);
            return;
        }
        $enc->bindUniform(SKIN_PALETTE_SLOT, $slice);
    }

    /**
     * The overlay shares the model pass: same target, same camera, so it depth-tests against the
     * geometry it describes. The vertices go through the frame's transient ring, not a buffer.
     */
    private function drawLines(RenderEncoder $enc) : void
    {
        if ($this->lines->empty()) {
            return;
        }

        GpuPass $pass = guard $this->linePass else {
            return;
        }
        $pass->bind($enc);
        $this->lines->draw($enc);
    }

    public const function commandCount() : int32
    {
        return $this->rigid->dca->commandCount() + $this->skinned->dca->commandCount();
    }

    public const function frustumCulled() : int32
    {
        return $this->rigid->dca->culledCount() + $this->skinned->dca->culledCount();
    }

    /**
     * Last frame's counts for the `model` verb.
     */
    internal function printStatus(DebugConsole $console) : void
    {
        int32 $commands = $this->commandCount();
        int32 $culled = $this->frustumCulled();
        int32 $models = $this->models->count() as int32;
        int32 $statics = $this->statics->count;
        $console->writeLine("model: {$models} models, {$statics} static, {$this->dynamicCount} dynamic, {$this->skinnedCount} skinned");
        int32 $rowCap = SKIN_PALETTE_ROWS;
        $console->writeLine("model: palette {$this->paletteRows}/{$rowCap} rows, {$this->paletteDropped} skins dropped");
        $console->writeLine("model: {$this->submitted} submitted, {$this->distanceCulled} past cull distance, {$culled} frustum culled, {$commands} draws");
        string $hist = '';
        int32 $i = 0;
        while ($i < MODEL_MAX_LODS) {
            int32 $n = $this->lodHistogram[$i as usize];
            $hist->append(" lod{$i}={$n}");
            $i = $i + 1;
        }

        $console->writeLine("model: bias {$this->lodBias}{$hist}");
        int32 $segments = $this->lines->count();
        int32 $cells = $this->statics->nodeCount();
        $console->writeLine("model: octree {$cells} cells, overlay {$segments} segments");
    }

    internal function setBounds(DebugConsole $console, bool $on) : void
    {
        $this->showBounds = $on;
        flags()->set('model.bounds', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: bounds on, green lod0 through magenta lod4');
            return;
        }

        $console->writeLine('model: bounds off');
    }

    internal function setOctree(DebugConsole $console, bool $on) : void
    {
        $this->showOctree = $on;
        flags()->set('model.octree', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: octree on');
            return;
        }

        $console->writeLine('model: octree off');
    }

    internal function setLodBias(DebugConsole $console, float32 $bias) : void
    {
        if ($bias <= 0.0f) {
            $console->writeLine('model: lod bias must be positive');
            return;
        }

        $this->lodBias = $bias;
        flags()->set('model.lod', FlagValue::floating($bias as float64));
        $this->flagsSeen = flags()->version;
        $console->writeLine("model: lod bias {$bias}");
    }

    internal function setWireframe(DebugConsole $console, bool $on) : void
    {
        $this->wireframe = $on;
        $this->rigid->reset();
        $this->skinned->reset();
        flags()->set('model.wire', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: wire');
            return;
        }

        $console->writeLine('model: fill');
    }

    /**
     * Load models for components that arrived since last fill, and place new statics.
     */
    private function acquireAll(Entities $entities) : void
    {
        foreach ($entities->view<StaticModel>() as $id => &$static) {
            if ($this->statics->has($id)) {
                continue;
            }

            int32 $handles = $this->acquire($static->model);
            if ($handles < 0) {
                continue;
            }

            Transform& $t = $entities->get<Transform>($id);
            ModelHandles $h = $this->models[$handles as usize];
            Mat4 $world = $t->world($entities);
            $this->statics->place(
                $id,
                $handles,
                $world,
                $h->model->bounds->transformed($world),
                $static->tint,
                $static->lodBias
            );
        }

        foreach ($entities->view<DynamicModel>() as $id => &$dynamic) {
            if ($this->dynamicOf->has($id)) {
                continue;
            }

            int32 $handles = $this->acquire($dynamic->model);
            if ($handles < 0) {
                continue;
            }

            $this->dynamicOf[$id] = $handles;
        }

        foreach ($entities->view<SkinnedModel>() as $id => &$skin) {
            if ($this->skinnedOf->has($id)) {
                continue;
            }

            int32 $handles = $this->acquire($skin->model);
            if ($handles < 0) {
                continue;
            }

            if (!$this->models[$handles as usize]->model->skinned()) {
                info("model: '{$skin->model}' has no skeleton; a SkinnedModel needs one");
                $this->skinnedOf[$id] = -1;
                continue;
            }

            $this->skinnedOf[$id] = $handles;
        }
    }

    /**
     * This frame's skins: interpolated world, distance cull, and each posed palette appended to
     * the frame palette. Both the GBuffer pass and the cascades draw from the list, so a skin
     * outside the camera still casts. O(skinned instances x joints); nothing allocates, the
     * arrays keep their capacity.
     */
    private function packSkins(Entities $entities, RenderContext $ctx) : void
    {
        $this->skinDraws->clear();
        $this->palette->clear();
        $this->paletteSlice = null;
        $this->skinnedCount = 0;
        $this->paletteDropped = 0;
        $this->paletteRows = 0;
        if ($this->skinnedOf->count() == 0) {
            return;
        }

        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return;
        }
        visu::profile::begin('palette');
        Vec3 $eye = $view->cullPosition;
        float32 $alpha = $ctx->compensation;
        foreach ($entities->view<SkinnedModel>() as $id => &$skin) {
            if (!$this->skinnedOf->has($id)) {
                continue;
            }

            int32 $handles = $this->skinnedOf[$id];
            if ($handles < 0) {
                continue;
            }

            SkinPose $pose = guard $skin->pose else {
                continue;
            }
            ModelHandles $h = $this->models[$handles as usize];
            Transform& $t = $entities->get<Transform>($id);
            Mat4 $world = $t->world($entities, $alpha);
            AABB $bounds = $h->model->bounds->transformed($world);
            if ($h->model->cullDistance > 0.0f && length($bounds->closest($eye) - $eye) > $h->model->cullDistance) {
                continue;
            }

            int32 $rows = $pose->palette->count() as int32;
            int32 $base = $this->palette->count() as int32;
            if ($base + $rows > SKIN_PALETTE_ROWS) {
                $this->paletteDropped = $this->paletteDropped + 1;
                if (!$this->paletteWarned) {
                    int32 $cap = SKIN_PALETTE_ROWS;
                    info("model: skin palette full ({$cap} rows); further skins are skipped this frame");
                    $this->paletteWarned = true;
                }

                continue;
            }

            foreach ($pose->palette as $row) {
                $this->palette[] = $row;
            }

            $this->skinDraws[] = SkinDraw($id, $handles, $world, $bounds, $skin->tint, $skin->lodBias, $base as float32);
            $this->skinnedCount = $this->skinnedCount + 1;
        }

        $this->paletteRows = $this->palette->count() as int32;
        visu::profile::end();
    }

    /**
     * Query the octree for statics inside `$frustum`, walk the dynamics, submit each at the LOD
     * its distance from `$eye` earns. Records console counters and debug lines.
     */
    private function submitAll(
        Entities $entities,
        const Frustum& $frustum,
        Vec3 $eye,
        float32 $alpha
    ) : void
    {
        $this->rigid->dca->clearInstances();
        $this->skinned->dca->clearInstances();
        $this->submitted = 0;
        $this->distanceCulled = 0;
        $this->dynamicCount = 0;
        int32 $i = 0;
        while ($i < MODEL_MAX_LODS) {
            $this->lodHistogram[$i as usize] = 0;
            $i = $i + 1;
        }

        $this->lines->clear();
        if ($this->showOctree) {
            $this->statics->draw($this->lines);
        }

        $this->statics->query($frustum);
        array<uint32> $ids = $this->statics->visible();
        foreach ($ids as $id) {
            StaticInstance $inst = $this->statics->get($id);
            if (!$inst->live) {
                continue;
            }

            ModelHandles $h = $this->models[$inst->handles as usize];
            $this->submitVisible($this->rigid->dca, $h, $inst->world, $inst->bounds, ModelInstanceData($inst->tint), $inst->lodBias, $eye, true);
        }

        foreach ($entities->view<DynamicModel>() as $id => &$dynamic) {
            if (!$this->dynamicOf->has($id)) {
                continue;
            }

            $this->dynamicCount = $this->dynamicCount + 1;
            ModelHandles $h = $this->models[$this->dynamicOf[$id] as usize];
            Transform& $t = $entities->get<Transform>($id);
            Mat4 $world = $t->world($entities, $alpha);
            AABB $bounds = $h->model->bounds->transformed($world);
            $this->submitVisible($this->rigid->dca, $h, $world, $bounds, ModelInstanceData($dynamic->tint), $dynamic->lodBias, $eye, true);
        }

        foreach ($this->skinDraws as $skin) {
            ModelHandles $h = $this->models[$skin->handles as usize];
            SkinInstanceData $payload = SkinInstanceData($skin->tint, Vec4($skin->base, 0.0f, 0.0f, 0.0f));
            $this->submitVisible($this->skinned->dca, $h, $skin->world, $skin->bounds, $payload, $skin->lodBias, $eye, true);
        }
    }

    private function submitVisible<P>(
        DrawCallAssembler<P> $dca,
        ModelHandles $h,
        const Mat4& $world,
        const AABB& $bounds,
        P $payload,
        float32 $lodBias,
        Vec3 $eye,
        bool $record
    ) : void
    {
        float32 $dist = length($bounds->closest($eye) - $eye);
        if ($h->model->cullDistance > 0.0f && $dist > $h->model->cullDistance) {
            if ($record) {
                $this->distanceCulled = $this->distanceCulled + 1;
            }

            return;
        }

        int32 $lod = lodIndex($h->model->lods, $dist, $h->model->lodBias * $lodBias * $this->lodBias);
        if ($record && $this->showBounds) {
            $this->lines->box($bounds, lodColor($lod));
        }

        int32 $last = ($h->lodStart->count() as int32) - 2;
        if ($last < 0) {
            return;
        }

        int32 $level = $lod;
        if ($level < 0) {
            $level = 0;
        }

        if ($level > $last) {
            $level = $last;
        }

        if ($record) {
            $this->lodHistogram[$level as usize] = $this->lodHistogram[$level as usize] + 1;
            $this->submitted = $this->submitted + 1;
        }

        int32 $start = $h->lodStart[$level as usize];
        int32 $end = $h->lodStart[($level + 1) as usize];
        int32 $n = $start;
        while ($n < $end) {
            $dca->submit($h->handles[$n as usize], $world, $payload, 0.0f);
            $n = $n + 1;
        }
    }

    /**
     * The handle table for a model id: the bank's model registered into this scene's assembler.
     * -1 when the model cannot be loaded; the failure is logged once.
     */
    private function acquire(const string& $id) : int32
    {
        if ($this->modelIndex->has($id)) {
            return $this->modelIndex[$id];
        }

        Model $model = guard $this->bank->acquire($id) else ($e) {
            string $why = $e->message();
            info("model: '{$id}' could not be loaded: {$why}");
            $this->modelIndex[$id] = -1;
            return -1;
        }
        ModelHandles $h = ModelHandles($model);
        if ($model->skinned()) {
            $this->skinned->register($this->bank, $model, $h);
        } else {
            $this->rigid->register($this->bank, $model, $h);
        }

        int32 $index = $this->models->count() as int32;
        $this->models[] = $h;
        $this->modelIndex[$id] = $index;
        return $index;
    }

    internal function release(Entity $e) : void
    {
        $this->statics->release($e);
    }

    internal function forgetDynamic(Entity $e) : void
    {
        if ($this->dynamicOf->has($e)) {
            $this->dynamicOf->remove($e);
        }
    }

    /**
     * Add or restyle one model entity. Full room leaves it out.
     */
    private function mark(Entity $e, int32 $style) : void
    {
        usize $i = 0;
        usize $n = $this->highlights->count();
        while ($i < $n) {
            if ($this->highlights[$i]->entity == $e) {
                $this->highlights->at($i)->style = $style;
                return;
            }

            $i = $i + 1;
        }

        if ($n >= MODEL_HIGHLIGHTS as usize) {
            return;
        }

        $this->highlights[] = ModelHighlight($e, $style);
    }

    /**
     * Take `$e` off the highlight list; order is not kept.
     */
    internal function dropHighlight(Entity $e) : void
    {
        usize $i = 0;
        usize $n = $this->highlights->count();
        while ($i < $n) {
            if ($this->highlights[$i]->entity == $e) {
                $this->highlights[$i] = $this->highlights[$n - 1];
                $this->highlights->truncate($n - 1);
                return;
            }

            $i = $i + 1;
        }
    }

    private const function drawsModel(Entities $entities, Entity $e) : bool
    {
        return $entities->has<StaticModel>($e)
            || $entities->has<DynamicModel>($e)
            || $entities->has<SkinnedModel>($e);
    }

    internal function forgetSkinned(Entity $e) : void
    {
        if ($this->skinnedOf->has($e)) {
            $this->skinnedOf->remove($e);
        }
    }

    /**
     * Each lane's passes once the renderer has linked its programs, and the overlay pass.
     */
    private function ensurePasses() : void
    {
        $this->rigid->ensure($this->renderer, $this->wireframe);
        $this->skinned->ensure($this->renderer, $this->wireframe);
        if ($this->linePass != null) {
            return;
        }

        ShaderProgram $lines = guard $this->renderer->program('debug_lines') else {
            return;
        }
        $this->linePass = debugLinePass($lines);
    }
}

/**
 * `$box` grown by `$add`, or `$add` itself while nothing has been added yet.
 */
internal function outlineUnion(const AABB& $box, const AABB& $add, bool $started) : AABB
{
    if (!$started) {
        return $add;
    }

    return $box->union($add);
}
