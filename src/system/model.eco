/**
 * Draws every `StaticModel`, `DynamicModel` and `SkinnedModel` into the GBuffer and the shadow
 * cascades. Every model instance holds one GPU scene row for its whole life, written only when
 * what it shows changes: components that arrive are queued by their attach hook and acquired in
 * `fill` (at most `MODEL_ACQUIRE_BUDGET` a frame, so a million statics ramp in rather than
 * flood one frame), a hand move or an edit (`changed<Transform>`, `changed<StaticModel>`) is
 * rewritten exactly, and a per-update mover comes from the move log (`Entities.move`): its row
 * gets the previous and the current pose once per update it moved and the GPU resolves between
 * them, and one exact write once an update runs without it. A still or resting model costs
 * nothing per frame. Statics also sit in an octree the CPU main view culls through; dynamics in
 * a dense draw list whose worlds are recomputed only while they move. All pick a LOD by distance
 * and batch by material. Rigid models go through
 * one `ModelLane`, skinned ones through a second whose programs read the frame's joint palette
 * at slot 2: `fill` packs every posed skin within reach into one array, and the first pass that
 * draws a skin copies it into the frame's ring once. Models and textures come from the
 * `ModelBank`, which outlives the scene; the assemblers' mesh handles are this system's and die
 * with it.
 * `highlight` marks entities for the renderer's outline: `fill` resubmits just those into each
 * lane's outline assembler and opts the system into `OutlineData`, so nothing highlighted costs
 * nothing. `preview` draws a `PreviewForm` into the same outline mask for one frame, and nowhere
 * else: no GBuffer, no shadow, no GPU scene row, no entity. A placement ghost is one.
 * GPU acquisition happens in `fill`, never inside the pass: an open encoder allows no uploads.
 * `fill` is the only graph entry: Quickstart runs `$opt->render` before `Systems.render`, so this
 * system opts out of the render phase.
 */

namespace visu::system;

use visu::app::{FlagValue, Flags, flags, info};
use visu::asset::{Assembly, AssemblyNode, AssemblyPart, MODEL_MAX_LODS};
use visu::components::{AssemblyInstance, DynamicModel, SkinPose, SkinnedModel, StaticModel, assemblyRootOf};
use visu::ecs::{Entities, Entity, EntityHook, Schedule, System, View};
use std::time;
use visu::geo::{AABB, Frustum, Plane, Pose, Transform, decomposePose, poseBounds};
use visu::graphics::{
    SCENE_CHUNK_METRES, SCENE_PASS_CAMERA, SCENE_PASS_MIRROR, SCENE_PASS_OUTLINE,
    CallbackPass, CameraData, DebugLines, DeferredRenderer, DrawCallAssembler, Frame, GBufferData, GeometryFiller, GeometryFillers,
    GpuPass, GpuScene, IoSink, Model, ModelBank, ModelInstanceData, OUTLINE_STYLES, OutlineCaster, OutlineData,
    SceneRow,
    Pipeline, PipelineError, RenderContext,
    RenderEncoder, SHADOW_CASCADES, SKIN_PALETTE_ROWS, SKIN_PALETTE_SLOT, ShaderProgram,
    ReflectionCaster, SCENE_VIEW_CASCADES, SCENE_VIEW_GBUFFER, SCENE_VIEW_MIRROR, SCENE_VIEW_OUTLINE, SceneDrawer,
    SceneViews, ShadowCascade, ShadowCaster, ShadowMapData, SkinInstanceData, TransientSlice,
    WaterDraw, WaterFrame, debugLinePass, lodIndex, modelLayout, shadowReach, skinnedLayout,
    waterAbove
};
use visu::console::lodColor;
use visu::math::{Mat4, Quat, Vec3, Vec4, length, scale, translate};
use visu::runtime::DebugConsole;

public class ModelSystem : System, SceneDrawer, GeometryFiller, ShadowCaster, OutlineCaster, ReflectionCaster
{
    public ModelBank $bank;

    /**
     * The world `fill` saw this frame, drawn when the geometry pass reaches `record`.
     */
    private Entities? $filling;

    /**
     * The world `register` bound, which `prepare` works over.
     */
    private Entities? $world;

    /**
     * The world box of what this frame's outline mask draws (`outlineBounds`).
     */
    private AABB $outlined;
    public DeferredRenderer $renderer;

    /**
     * Global LOD distance multiplier. Console `model lod <bias>` or the `model.lod` flag;
     * below 1 keeps detail further out.
     */
    public float32 $lodBias;
    public bool $wireframe;

    /**
     * Draw each submitted instance's world bounds, coloured by the LOD level it drew at.
     * Console `model bounds on`, or the `model.bounds` flag.
     */
    public bool $showBounds;

    /**
     * Draw the octree cells that still hold something, brighter the deeper they sit.
     * Console `model octree on`, or the `model.octree` flag.
     */
    public bool $showOctree;

    /**
     * `Flags.version` last applied, so a flag set at runtime lands without fighting the console verb.
     */
    private int32 $flagsSeen;

    /**
     * Skins posed in the last fill, for the console and tests.
     */
    public int32 $skinnedCount;

    /**
     * Palette rows packed this frame, and skins left out because the palette was full.
     */
    public int32 $paletteRows;
    public int32 $paletteDropped;
    private map<string, int32> $modelIndex;

    /**
     * The handle slots, the dynamic draw list and this frame's skins, shared with the CPU main
     * views when they draw.
     */
    private ModelTables $tables;

    /**
     * Handle slots an eviction freed, reused by the next `acquire`.
     */
    private array<int32> $freeModels;

    /**
     * Model ids `evict` queued. Drained at the top of the next `fill`: this frame's cascade and
     * outline lists, built in `fill`, still name their handles until the pipeline has run.
     */
    private array<string> $evictions;

    /**
     * One record per acquired model entity, paged by entity index.
     */
    private View<ModelRecord> $records;

    /**
     * Model components attached since the last fill, in order, and entities whose component or
     * transform was edited (`changed<T>`); both read in `fill`. A skinned model is acquired
     * once and stays in `skinned`.
     */
    private array<Entity> $arrivals;
    private usize $arrivalsRead;
    private array<Entity> $refreshes;
    private array<Entity> $skins;

    /**
     * The move log reader, what it read this fill, and the entities whose rows are resolving on
     * the GPU.
     */
    private int32 $moveReader;
    private array<Entity> $moved;
    private array<Entity> $movingRecords;

    /**
     * The update each moving list entry last moved in, beside it: the rest check reads this array
     * alone.
     */
    private array<uint32> $movingUpdates;

    /**
     * The fill each assembly root was last expanded in, so an assembly with many moving nodes
     * (a windmill's hub and sails) walks its parts once a fill.
     */
    private View<int32> $expanded;

    /**
     * This frame's skins and their palette rows, kept across frames so the capacity survives.
     */
    private array<Vec4> $palette;

    /**
     * Highlighted model entities, room for `MODEL_HIGHLIGHTS` taken at construction.
     */
    private array<ModelHighlight> $highlights;

    /**
     * This frame's `preview` calls, room for `MODEL_PREVIEWS` taken at construction. Emptied at
     * the end of every `fill`, so a ghost nobody submits is gone the next frame.
     */
    private array<ModelPreview> $previews;

    private bool $paletteWarned;
    private DebugLines $lines;
    private GpuPass? $linePass;
    private array<EntityHook> $hooks;

    /**
     * The renderer's GPU scene: model rows on acquire, static rows on place and release, and
     * this frame's movers. The shadow cascades draw every model from it (culled, levelled and
     * batched on the GPU).
     */
    private GpuScene $scene;

    /**
     * Each casting mover's shadow bookkeeping, paged by entity index, so a still one changes no
     * shadow and a moving one hashes nothing.
     */
    private View<MoverTrack> $tracks;
    private int32 $moverFrame;

    /**
     * The CPU main views (`CpuModelViews`): null when the main views come from the GPU scene
     * (`--flag models.gpu`, on by default where the device has bindless textures), so the camera,
     * the mirror and the outline are culled and drawn on the GPU and no CPU structure is kept for
     * them. Decided once, at construction.
     */
    private CpuModelViews? $cpu;
    private ScenePasses $passes;

    /**
     * Rows the GPU main views draw previews with, pinned to the active set; the first
     * `previewRowsUsed` are this frame's, the rest wait hidden.
     */
    private array<int32> $previewRows;
    private int32 $previewRowsUsed;

    /**
     * Static model entities acquired, for the console in GPU mode (the octree counts its own).
     */
    private int32 $staticRecords;

    public constructor(ModelBank $bank, DeferredRenderer $renderer, const AABB& $world)
    {
        $this->bank = $bank;
        $this->renderer = $renderer;
        $this->scene = $renderer->scene;
        $this->tracks = View<MoverTrack>();
        $this->moverFrame = 0;
        // a bank that already dropped its classic meshes can only feed GPU views
        bool $wanted = flags()->bool('models.gpu', true) || !$bank->keepsClassicMeshes();
        bool $gpuViews = $wanted && $bank->device->limits()->bindless;
        $this->scene->own($bank, $gpuViews);
        if ($this->scene->rowCount() == 0) {
            $this->scene->layout($world, flags()->float('scene.chunk', SCENE_CHUNK_METRES as float64) as float32);
        }

        $this->passes = ScenePasses($bank->device);
        $this->previewRows = arr::room<int32>((MODEL_PREVIEWS * 8) as usize);
        $this->previewRowsUsed = 0;
        $this->staticRecords = 0;
        $this->filling = null;
        $this->world = null;
        $this->outlined = AABB(Vec3(0.0f), Vec3(0.0f));
        $this->lodBias = flags()->float('model.lod', 1.0) as float32;
        $this->wireframe = flags()->bool('model.wire', false);
        $this->showBounds = flags()->bool('model.bounds', false);
        $this->showOctree = flags()->bool('model.octree', false);
        $this->flagsSeen = flags()->version;
        $this->skinnedCount = 0;
        $this->paletteRows = 0;
        $this->paletteDropped = 0;
        $this->modelIndex = map<string, int32>();
        $this->tables = ModelTables();
        $this->freeModels = array<int32>();
        $this->evictions = arr::room<string>(MODEL_EVICT_RESERVE as usize);
        $this->records = View<ModelRecord>();
        $this->arrivals = array<Entity>();
        $this->arrivalsRead = 0;
        $this->refreshes = array<Entity>();
        $this->skins = array<Entity>();
        $this->moveReader = -1;
        $this->moved = array<Entity>();
        $this->movingRecords = array<Entity>();
        $this->movingUpdates = array<uint32>();
        $this->expanded = View<int32>();
        $this->palette = array<Vec4>();
        $this->palette->reserve(SKIN_PALETTE_ROWS as usize);
        $this->highlights = arr::room<ModelHighlight>(MODEL_HIGHLIGHTS as usize);
        $this->previews = arr::room<ModelPreview>(MODEL_PREVIEWS as usize);
        $this->paletteWarned = false;
        $this->lines = DebugLines($bank->device);
        $this->linePass = null;
        $this->hooks = array<EntityHook>();
        $this->cpu = cpuViewsFor($gpuViews, $bank, $world, $this->tables);
        if ($gpuViews) {
            // the GPU scene reads only the arena: the classic meshes would be a second, unread copy
            $bank->dropClassicMeshes();
        }
    }

    /**
     * Live static records this frame.
     */
    public const function staticCount() : int32
    {
        CpuModelViews $cpu = guard $this->cpu else {
            return $this->staticRecords;
        }
        return $cpu->statics->count;
    }

    /**
     * Whether the main views come from the GPU scene.
     */
    public const function gpuViews() : bool
    {
        return $this->cpu == null;
    }

    /**
     * Arrivals queue from the attach hooks (and one sweep here of what was attached before the
     * system was bound), edits from the change hooks; a detach releases at once, before the
     * entity is reused. Continuous movers come from the move log. An arrival outside a frame
     * (the sweep, a scene's load-time spawns) decodes its model there, so the first frames only
     * place rows.
     */
    public function register(Entities $entities) : void
    {
        $this->world = $entities;
        ModelSystem $sys = $this;
        $this->hooks[] = $entities->onAttach<StaticModel>(function(Entities $w, Entity $e, const StaticModel& $c) : void {
            $sys->arrive($e, $c->model);
        });
        $this->hooks[] = $entities->onAttach<DynamicModel>(function(Entities $w, Entity $e, const DynamicModel& $c) : void {
            $sys->arrive($e, $c->model);
        });
        $this->hooks[] = $entities->onAttach<SkinnedModel>(function(Entities $w, Entity $e, const SkinnedModel& $c) : void {
            $sys->arrive($e, $c->model);
        });
        $this->hooks[] = $entities->onChange<Transform>(function(Entities $w, Entity $e, const Transform& $t) : void {
            $sys->refresh($e);
        });
        $this->hooks[] = $entities->onChange<StaticModel>(function(Entities $w, Entity $e, const StaticModel& $c) : void {
            $sys->refresh($e);
        });
        $this->hooks[] = $entities->onChange<DynamicModel>(function(Entities $w, Entity $e, const DynamicModel& $c) : void {
            $sys->refresh($e);
        });
        $this->hooks[] = $entities->onChange<SkinnedModel>(function(Entities $w, Entity $e, const SkinnedModel& $c) : void {
            $sys->refresh($e);
        });
        $this->hooks[] = $entities->onDetach<StaticModel>(function(Entities $w, Entity $e, const StaticModel& $c) : void {
            $sys->release($e);
            $sys->dropHighlight($e);
        });
        $this->hooks[] = $entities->onDetach<DynamicModel>(function(Entities $w, Entity $e, const DynamicModel& $c) : void {
            $sys->release($e);
            $sys->dropHighlight($e);
        });
        $this->hooks[] = $entities->onDetach<SkinnedModel>(function(Entities $w, Entity $e, const SkinnedModel& $c) : void {
            $sys->release($e);
            $sys->dropHighlight($e);
        });
        $this->moveReader = $entities->moveReader();

        foreach ($entities->view<StaticModel>() as $id => &$static) {
            $this->arrive($id, $static->model);
        }

        foreach ($entities->view<DynamicModel>() as $id => &$dynamic) {
            $this->arrive($id, $dynamic->model);
        }

        foreach ($entities->view<SkinnedModel>() as $id => &$skin) {
            $this->arrive($id, $skin->model);
        }
    }

    /**
     * Room for `$models` model entities and `$movers` moving at once, so the queues, the records
     * and the GPU scene's rows are sized at load.
     */
    public function reserve(int32 $models, int32 $movers) : void
    {
        $this->records->reserve($models as usize);
        $this->arrivals->reserve($models as usize);
        $this->refreshes->reserve($models as usize);
        $this->moved->reserve(($movers * 2) as usize);
        $this->movingRecords->reserve($movers as usize);
        $this->movingUpdates->reserve($movers as usize);
        $this->tables->dynamics->reserve($movers as usize);
        CpuModelViews? $cpu = $this->cpu;
        if ($cpu != null) {
            CpuModelViews $views = guard $cpu;
            $views->statics->reserve($models as usize);
        }

        $this->scene->reserve($models, $movers);
    }

    /**
     * Drop handles, octree and statics. The bank keeps the models. Caller waitIdle first.
     */
    public function unregister(Entities $entities) : void
    {
        $this->world = null;
        foreach ($this->hooks as $hook) {
            $entities->release($hook);
        }

        $this->hooks->clear();
        $entities->releaseMoveReader($this->moveReader);
        $this->moveReader = -1;

        $this->scene->clear();
        $this->tracks = View<MoverTrack>();
        $this->previewRows->clear();
        $this->previewRowsUsed = 0;
        $this->staticRecords = 0;
        $this->cpu?->clear();
        $this->tables->models->clear();
        $this->freeModels->clear();
        $this->evictions->clear();
        $this->modelIndex->clear();
        $this->records = View<ModelRecord>();
        $this->arrivals->clear();
        $this->arrivalsRead = 0;
        $this->refreshes->clear();
        $this->skins->clear();
        $this->moved->clear();
        $this->movingRecords->clear();
        $this->movingUpdates->clear();
        $this->expanded = View<int32>();
        $this->tables->skins->clear();
        $this->tables->dynamics->clear();
        $this->palette->clear();
        $this->highlights->clear();
        $this->previews->clear();
        $this->lines->clear();
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->render = false;
    }

    public function update(Entities $entities) : void
    {
        Flags $bag = flags();
        if ($bag->version == $this->flagsSeen) {
            return;
        }

        $this->flagsSeen = $bag->version;
        if ($bag->has('model.lod')) {
            $this->lodBias = $bag->float('model.lod', $this->lodBias as float64) as float32;
        }

        if ($bag->has('model.wire')) {
            bool $wire = $bag->bool('model.wire', $this->wireframe);
            if ($wire != $this->wireframe) {
                $this->wireframe = $wire;
                $this->cpu?->reset();
                $this->passes->reset($wire);
            }
        }

        if ($bag->has('model.bounds')) {
            $this->showBounds = $bag->bool('model.bounds', $this->showBounds);
        }

        if ($bag->has('model.octree')) {
            $this->showOctree = $bag->bool('model.octree', $this->showOctree);
        }
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
    }

    /**
     * Outline `$root` in style slot `$style` until `unhighlight`. An assembly root (the windmill)
     * expands to every part that carries a model, once, here; the frame never walks the nodes.
     * Highlighting again only changes the style. Past `MODEL_HIGHLIGHTS` entities the rest are
     * left out. Call it on a change (hover in, hover out), not every frame.
     */
    public function highlight(Entities $entities, Entity $root, int32 $style) : void
    {
        assert($style >= 0 && $style < OUTLINE_STYLES, 'highlight style slot out of range');
        if (!$entities->valid($root)) {
            return;
        }

        if ($entities->has<AssemblyInstance>($root)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                if ($this->drawsModel($entities, $node)) {
                    $this->mark($node, $style);
                }
            }
        }

        if ($this->drawsModel($entities, $root)) {
            $this->mark($root, $style);
        }
    }

    /**
     * Stop outlining `$root` and, for an assembly, each of its parts.
     */
    public function unhighlight(Entities $entities, Entity $root) : void
    {
        if ($entities->valid($root) && $entities->has<AssemblyInstance>($root)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                $this->dropHighlight($node);
            }
        }

        $this->dropHighlight($root);
    }

    public function clearHighlights() : void
    {
        while ($this->highlights->count() > 0) {
            $this->dropHighlight($this->highlights[0]->entity);
        }
    }

    /**
     * Model entities outlined now, assembly parts counted one by one.
     */
    public const function highlightCount() : int32
    {
        return $this->highlights->count() as int32;
    }

    public const function highlighted(Entity $e) : bool
    {
        foreach ($this->highlights as $h) {
            if ($h->entity == $e) {
                return true;
            }
        }

        return false;
    }

    /**
     * Draw the outline lists `prepareOutline` built into the open mask encoder.
     */
    public function mask(RenderContext $ctx, RenderEncoder $enc) : void
    {
        CpuModelViews $cpu = guard $this->cpu else {
            $this->scene->drawMain($enc, SCENE_PASS_OUTLINE, $this->passes, .outline);
            return;
        }
        $cpu->mask($enc, $this->bank, $this->scene->palette);
    }

    /**
     * An editor starts moving `$root` (and, for an assembly, every part): their rows leave their
     * chunks for the active set and stay there through every exact rewrite of the drag, so no
     * chunk is touched while it lasts. O(parts). Pair with `endEdit`, also after a cancel that put
     * the old transform back.
     */
    public function beginEdit(Entities $entities, Entity $root) : void
    {
        $this->editParts($entities, $root, true);
    }

    /**
     * The edit of `$root` is over: each part's row rests in the chunk of where it now stands, so
     * only that chunk and the one it left changed. O(parts).
     */
    public function endEdit(Entities $entities, Entity $root) : void
    {
        $this->editParts($entities, $root, false);
    }

    /**
     * Rows held in the active set by an edit now.
     */
    public function editing(Entity $e) : bool
    {
        return $this->records->contains($e) && $this->records->get($e)->editing;
    }

    private function editParts(Entities $entities, Entity $root, bool $on) : void
    {
        if (!$entities->valid($root)) {
            return;
        }

        $this->editPart($root, $on);
        if ($entities->has<AssemblyInstance>($root)) {
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                $this->editPart($node, $on);
            }
        }
    }

    private function editPart(Entity $e, bool $on) : void
    {
        if (!$this->records->contains($e)) {
            return;
        }

        ModelRecord& $rec = $this->records->get($e);
        if ($rec->kind == ModelKind::skinned || $rec->editing == $on) {
            return;
        }

        $rec->editing = $on;
        $this->scene->pin($rec->row, $on);
        // the next fill rewrites it exactly, which places it by the pin
        $this->queueRefresh($e);
    }

    /**
     * Stop drawing a model and give its mesh ranges back, so the bank may drop it. Detach every
     * component that draws it first. Queued until the next `fill`, which is also when a model
     * adopted under a fresh id is picked up, so a rebuilt road chunk swaps in one frame. A model
     * that still has users stays queued; an id that failed to load forgets its cached miss.
     */
    public function evict(const string& $id) : void
    {
        $this->evictions[] = $id;
    }

    /**
     * Ids evicted but not yet drained. The bank must not drop these yet.
     */
    public const function evicting() : int32
    {
        return $this->evictions->count() as int32;
    }

    /**
     * Acquire what arrived, apply edits and moves to the GPU scene rows, then one pass that
     * writes the GBuffer with every visible instance.
     */
    public function prepare(RenderContext $ctx, SceneViews $views) : int32
    {
        Entities $entities = guard $this->world else {
            return 0;
        }
        $this->ensurePasses();
        $this->drainEvictions();
        $this->moverFrame = $this->moverFrame + 1;
        $this->scene->frameInputs($this->lodBias, $ctx->compensation);
        Vec3 $eye = Vec3(0.0f);
        CameraData? $view = $ctx->frame->find<CameraData>();
        if ($view != null) {
            CameraData $held = guard $view;
            $eye = $held->cullPosition;
        }

        visu::profile::begin('acquire');
        $this->acquireArrivals($entities);
        $this->applyRefreshes($entities);
        visu::profile::end();
        visu::profile::begin('dynamics');
        visu::profile::begin('moves');
        $this->applyMoves($entities, $eye);
        visu::profile::end();
        if ($this->cpu != null) {
            visu::profile::begin('interpolate');
            $this->interpolateMoving($entities, $ctx->compensation, $eye);
            visu::profile::end();
        }

        visu::profile::end();
        $this->packSkins($entities, $ctx);
        $this->packMovers($ctx, $eye);
        if ($this->cpu == null) {
            $this->passes->ensure($this->bank);
            $this->writePreviews();
            $this->scene->outlines($this->highlights->count() > 0 || $this->previewRowsUsed > 0);
        }
        $this->filling = $entities;
        int32 $wants = SCENE_VIEW_GBUFFER | SCENE_VIEW_CASCADES;
        WaterFrame? $water = $views->mirror;
        if ($water != null) {
            WaterFrame $mirror = guard $water;
            $this->prepareReflection($entities, $ctx, $mirror);
            $wants = $wants | SCENE_VIEW_MIRROR;
        }

        if ($views->outline && ($this->highlights->count() > 0 || $this->previews->count() > 0)) {
            if ($this->prepareOutline($entities, $ctx)) {
                $wants = $wants | SCENE_VIEW_OUTLINE;
            }
        }

        $this->previews->clear();
        return $wants;
    }

    public function outlineBounds() : AABB
    {
        return $this->outlined;
    }

    /**
     * Pose `$assembly` for `preview`: every non-skinned part's model and its pose under the root,
     * composed through the node parents. Warms each model in the bank, so a load step, never the
     * displayed frame, pays for a model the scene has not drawn yet.
     */
    public function previewForm(Assembly $assembly) : PreviewForm
    {
        PreviewForm $form = PreviewForm();

        foreach ($assembly->nodes as $node) {
            if ($node->part->empty()) {
                continue;
            }

            AssemblyPart $part = guard $assembly->findPart($node->part) else {
                continue;
            }

            if ($part->skinned) {
                continue;
            }

            $this->bank->acquire($part->model);
            $form->add($part->model, previewPose($assembly, $node));
        }

        return $form;
    }

    /**
     * `previewForm` for one model at the root.
     */
    public function previewForm(model: string $id) : PreviewForm
    {
        PreviewForm $form = PreviewForm();
        $this->bank->acquire($id);
        $form->add($id, Mat4(1.0f));
        return $form;
    }

    /**
     * Draw `$form` at `$root` into the outline mask for this frame only, in style slot `$style`
     * (a style with a `fill` tints its silhouette). Call it every frame the ghost should show;
     * past `MODEL_PREVIEWS` a call is dropped. O(parts) in the next `fill`.
     */
    public function preview(PreviewForm $form, const Mat4& $root, int32 $style) : void
    {
        assert($style >= 0 && $style < OUTLINE_STYLES, 'preview style slot out of range');

        if (($this->previews->count() as int32) >= MODEL_PREVIEWS) {
            return;
        }

        $this->previews[] = ModelPreview($form, $root, $style);
    }

    /**
     * Submit each highlighted entity into its lane's outline assembler at the LOD the main pass
     * picks, so the mask traces the same surface the scene depth holds. O(highlighted); statics
     * resolve through the set's entity map, skins through this frame's short skin list.
     */
    private function prepareOutline(Entities $entities, RenderContext $ctx) : bool
    {
        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return false;
        }
        CpuModelViews $cpu = guard $this->cpu else {
            return $this->outlineBox($entities);
        }

        visu::profile::begin('outline');
        $cpu->outlineBegin();
        CpuDrawTuning $tuning = $this->tuning();
        Vec3 $eye = $view->cullPosition;
        float32 $alpha = $ctx->compensation;
        bool $any = false;
        AABB $box = AABB(Vec3(0.0f), Vec3(0.0f));
        foreach ($this->highlights as $mark) {
            // the mask program reads the style slot from the tint's red channel
            Vec4 $tag = Vec4($mark->style as float32, 0.0f, 0.0f, 1.0f);
            Entity $e = $mark->entity;
            int32 $slot = $cpu->statics->find($e);
            if ($slot >= 0) {
                StaticInstance $inst = $cpu->statics->get($slot as uint32);
                if ($inst->live) {
                    ModelHandles $h = $this->tables->models[$inst->handles as usize];
                    $cpu->outlineRigid($h, $inst->world, $inst->bounds, ModelInstanceData($tag), $inst->lodBias, $eye, $tuning);
                    $box = outlineUnion($box, $inst->bounds, $any);
                    $any = true;
                }

                continue;
            }

            if ($this->records->contains($e) && $this->records->get($e)->kind == ModelKind::dynamic) {
                ModelRecord $rec = $this->records->get($e);
                DynamicDraw $dyn = $this->tables->dynamics[$rec->slot as usize];
                if (!$dyn->hidden) {
                    ModelHandles $h = $this->tables->models[$rec->handles as usize];
                    $cpu->outlineRigid($h, $dyn->world, $dyn->bounds, ModelInstanceData($tag), $dyn->lodBias, $eye, $tuning);
                    $box = outlineUnion($box, $dyn->bounds, $any);
                    $any = true;
                }

                continue;
            }

            foreach ($this->tables->skins as $skin) {
                if ($skin->entity != $e) {
                    continue;
                }

                ModelHandles $h = $this->tables->models[$skin->handles as usize];
                SkinInstanceData $payload = SkinInstanceData($tag, Vec4($skin->base, 0.0f, 0.0f, 0.0f));
                $cpu->outlineSkinned($h, $skin->world, $skin->bounds, $payload, $skin->lodBias, $eye, $tuning);
                $box = outlineUnion($box, $skin->bounds, $any);
                $any = true;
            }
        }

        foreach ($this->previews as $ghost) {
            Vec4 $tag = Vec4($ghost->style as float32, 0.0f, 0.0f, 1.0f);
            int32 $n = $ghost->form->count();
            int32 $i = 0;

            while ($i < $n) {
                int32 $handles = $this->previewHandles($ghost->form, $i);
                $i = $i + 1;

                if ($handles < 0) {
                    continue;
                }

                ModelHandles $h = $this->tables->models[$handles as usize];

                if ($h->model->skinned()) {
                    continue;
                }

                Mat4 $world = $ghost->root * $ghost->form->locals[($i - 1) as usize];
                AABB $bounds = $h->model->bounds->transformed($world);
                $cpu->outlineRigid($h, $world, $bounds, ModelInstanceData($tag), 1.0f, $eye, $tuning);
                $box = outlineUnion($box, $bounds, $any);
                $any = true;
            }
        }

        bool $drawn = $cpu->outlineBuild($view->cullFrustum, $eye);
        visu::profile::end();
        if ($any && $drawn) {
            $this->outlined = $box;
            return true;
        }

        return false;
    }

    /**
     * Part `$i`'s handle slot, looked up once per form. Called in `fill`, after `ensurePasses`,
     * where `acquire` may register a model; the bank already holds it from `previewForm`.
     */
    private function previewHandles(PreviewForm $form, int32 $i) : int32
    {
        int32 $h = $form->handles[$i as usize];

        if ($h != PREVIEW_UNRESOLVED) {
            return $h;
        }

        $h = $this->acquire($form->models[$i as usize]);
        $form->handles[$i as usize] = $h;
        return $h;
    }

    public function name() : string
    {
        return 'models';
    }

    /**
     * Cull, pick LODs, build the batches and record them into the geometry pass's encoder.
     * No-op before CameraSystem published.
     */
    public function record(RenderContext $ctx, RenderEncoder $enc) : status<PipelineError>
    {
        CameraData $camera = guard $ctx->frame->find<CameraData>() else {
            return .ok;
        }
        CpuModelViews? $views = $this->cpu;
        if ($views != null) {
            CpuModelViews $cpu = guard $views;
            if (!$cpu->rigid->ready()) {
                return .ok;
            }

            $this->lines->clear();
            $cpu->record($enc, $this->bank, $camera, $this->lines, $this->tuning(), $this->scene->palette);
            $this->drawLines($enc);
            return .ok;
        }

        $this->lines->clear();
        if ($camera->cullFrozen) {
            $this->lines->frustum($camera->cullCorners(), Vec4(1.00f, 0.85f, 0.15f, 1.0f));
            $this->lines->cross($camera->cullPosition, 4.0f);
        }

        if ($this->scene->showChunks) {
            $this->drawChunks();
        }

        visu::profile::begin('draw');
        // the cut-out classes' depth first, then every class shades
        $this->scene->drawMain($enc, SCENE_PASS_CAMERA, $this->passes, .cameraDepth);
        $this->scene->drawMain($enc, SCENE_PASS_CAMERA, $this->passes, .camera);
        $this->drawLines($enc);
        visu::profile::end();
        return .ok;
    }

    /**
     * The CPU views' knobs as this system holds them.
     */
    private const function tuning() : CpuDrawTuning
    {
        return CpuDrawTuning($this->lodBias, $this->showBounds, $this->showOctree);
    }

    /**
     * The CPU views' mirror lists for `$water`; the GPU views cull the mirror themselves.
     */
    public function prepareReflection(Entities $entities, RenderContext $ctx, WaterFrame $water) : void
    {
        CpuModelViews $cpu = guard $this->cpu else {
            return;
        }
        $this->ensurePasses();
        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return;
        }
        $cpu->prepareReflection($view, $water, $this->tuning());
    }

    /**
     * Draw the lists `prepareReflection` built. The mirror camera is already at slot 1.
     */
    public function reflect(RenderContext $ctx, RenderEncoder $enc) : void
    {
        CpuModelViews $cpu = guard $this->cpu else {
            $this->scene->drawMain($enc, SCENE_PASS_MIRROR, $this->passes, .mirror);
            return;
        }
        $cpu->reflect($enc, $this->bank, $this->scene->palette);
    }

    /**
     * Draw this cascade's casters from the GPU scene into an open cascade encoder.
     */
    public function cast(RenderContext $ctx, RenderEncoder $enc, const ShadowCascade& $cascade) : void
    {
        $enc->upload($cascade->uniforms, slot: 1);
        $this->scene->drawCascade($enc, $cascade->index);
    }

    /**
     * The overlay shares the model pass: same target, same camera, so it depth-tests against the
     * geometry it describes. The vertices go through the frame's transient ring, not a buffer.
     */
    private function drawLines(RenderEncoder $enc) : void
    {
        if ($this->lines->empty()) {
            return;
        }

        GpuPass $pass = guard $this->linePass else {
            return;
        }
        $pass->bind($enc);
        $this->lines->draw($enc);
    }

    public const function commandCount() : int32
    {
        CpuModelViews $cpu = guard $this->cpu else {
            return 0;
        }
        return $cpu->commandCount();
    }

    public const function frustumCulled() : int32
    {
        CpuModelViews $cpu = guard $this->cpu else {
            return 0;
        }
        return $cpu->frustumCulled();
    }

    /**
     * Last frame's counts for the `model` verb.
     */
    internal function printStatus(DebugConsole $console) : void
    {
        int32 $models = $this->tables->models->count() as int32;
        int32 $statics = $this->staticCount();
        int32 $rowCap = SKIN_PALETTE_ROWS;
        CpuModelViews? $views = $this->cpu;
        if ($views == null) {
            int32 $rows = $this->scene->rowCount();
            int32 $active = $this->scene->activeCount();
            int32 $moving = $this->scene->moverCount();
            $console->writeLine("model: {$models} models, {$statics} static, {$this->tables->dynamics->count()} dynamic, {$this->skinnedCount} skinned");
            $console->writeLine("model: gpu views, {$rows} scene rows, {$active} active, {$moving} moving (see `scene`)");
            $console->writeLine("model: palette {$this->paletteRows}/{$rowCap} rows, {$this->paletteDropped} skins dropped");
            $console->writeLine("model: bias {$this->lodBias}, overlay {$this->lines->count()} segments");
            $console->writeLine("model: {$this->bank->lateModels} models decoded in a displayed frame");
            return;
        }

        CpuModelViews $cpu = guard $views;
        int32 $commands = $cpu->commandCount();
        int32 $culled = $cpu->frustumCulled();
        $console->writeLine("model: {$models} models, {$statics} static, {$cpu->dynamicCount} dynamic, {$this->skinnedCount} skinned");
        $console->writeLine("model: palette {$this->paletteRows}/{$rowCap} rows, {$this->paletteDropped} skins dropped");
        $console->writeLine("model: {$cpu->submitted} submitted, {$cpu->distanceCulled} past cull distance, {$culled} frustum culled, {$commands} draws");
        string $hist = '';
        int32 $i = 0;
        while ($i < MODEL_MAX_LODS) {
            int32 $n = $cpu->lodHistogram[$i as usize];
            $hist->append(" lod{$i}={$n}");
            $i = $i + 1;
        }

        $console->writeLine("model: bias {$this->lodBias}{$hist}");
        int32 $segments = $this->lines->count();
        int32 $cells = $cpu->statics->nodeCount();
        $console->writeLine("model: octree {$cells} cells, overlay {$segments} segments");
    }

    internal function setBounds(DebugConsole $console, bool $on) : void
    {
        $this->showBounds = $on;
        flags()->set('model.bounds', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: bounds on, green lod0 through magenta lod4');
            return;
        }

        $console->writeLine('model: bounds off');
    }

    internal function setOctree(DebugConsole $console, bool $on) : void
    {
        $this->showOctree = $on;
        flags()->set('model.octree', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: octree on');
            return;
        }

        $console->writeLine('model: octree off');
    }

    internal function setLodBias(DebugConsole $console, float32 $bias) : void
    {
        if ($bias <= 0.0f) {
            $console->writeLine('model: lod bias must be positive');
            return;
        }

        $this->lodBias = $bias;
        flags()->set('model.lod', FlagValue::floating($bias as float64));
        $this->flagsSeen = flags()->version;
        $console->writeLine("model: lod bias {$bias}");
    }

    internal function setWireframe(DebugConsole $console, bool $on) : void
    {
        $this->wireframe = $on;
        $this->cpu?->reset();
        $this->passes->reset($on);
        flags()->set('model.wire', FlagValue::boolean($on));
        $this->flagsSeen = flags()->version;
        if ($on) {
            $console->writeLine('model: wire');
            return;
        }

        $console->writeLine('model: fill');
    }

    /**
     * `$e` gained a model component drawing `$model`: its row is placed at the next fill. Outside a
     * frame the model is decoded now (a map hit after the first); inside one it waits for the
     * fill, where the bank logs it as a late decode.
     */
    internal function arrive(Entity $e, const string& $model) : void
    {
        $this->arrivals[] = $e;
        if (!$this->bank->device->inFrame()) {
            $this->acquire($model);
        }
    }

    /**
     * `$e`'s transform or model component was edited: its row is rewritten exactly at the next
     * fill. A burst of edits of one entity is one rewrite.
     */
    internal function refresh(Entity $e) : void
    {
        $this->queueRefresh($e);
    }

    /**
     * Queue `$e` for an exact rewrite at the next fill, once. An entity not acquired yet is
     * queued without the mark; `applyRefreshes` skips it if it never arrives.
     */
    private function queueRefresh(Entity $e) : void
    {
        if ($this->records->contains($e)) {
            ModelRecord& $rec = $this->records->get($e);
            if ($rec->refreshQueued) {
                return;
            }

            $rec->refreshQueued = true;
        }

        $this->refreshes[] = $e;
    }

    /**
     * Acquire up to `MODEL_ACQUIRE_BUDGET` arrivals: a row, the model's handles, and the static
     * set or the dynamic draw list. An arrival that is gone, or already acquired, is skipped.
     */
    private function acquireArrivals(Entities $entities) : void
    {
        usize $n = $this->arrivals->count();
        if ($this->arrivalsRead >= $n) {
            return;
        }

        int32 $taken = 0;
        bool $timed = !visu::runtime::clockPinned();
        time::instant $start = time::instant::now();
        while ($this->arrivalsRead < $n && $taken < MODEL_ACQUIRE_BUDGET) {
            Entity $e = $this->arrivals[$this->arrivalsRead];
            $this->arrivalsRead = $this->arrivalsRead + 1;
            if ($entities->valid($e) && !$this->records->contains($e)) {
                $this->acquireEntity($entities, $e);
                $taken = $taken + 1;
                if ($timed && ($taken % MODEL_ACQUIRE_CHECK) == 0) {
                    time::instant $now = time::instant::now();
                    float64 $ms = (($now - $start)->as_nanos() as float64) / 1000000.0;
                    if ($ms > MODEL_ACQUIRE_MS) {
                        break;
                    }
                }
            }
        }

        if ($this->arrivalsRead >= $n) {
            $this->arrivals->clear();
            $this->arrivalsRead = 0;
        }
    }

    private function acquireEntity(Entities $entities, Entity $e) : void
    {
        if ($entities->has<StaticModel>($e)) {
            StaticModel& $static = $entities->get<StaticModel>($e);
            int32 $handles = $this->acquire($static->model);
            if ($handles < 0) {
                return;
            }

            ModelHandles $h = $this->tables->models[$handles as usize];
            $this->addUser($handles);
            Mat4 $world = $entities->get<Transform>($e)->world($entities);
            AABB $bounds = $h->model->bounds->transformed($world);
            int32 $slot = -1;
            CpuModelViews? $cpu = $this->cpu;
            if ($cpu != null) {
                CpuModelViews $views = guard $cpu;
                $slot = $views->statics->place($e, $handles, $world, $bounds, $static->tint, $static->lodBias);
            }

            int32 $row = $this->scene->acquire();
            ModelRecord $rec = ModelRecord($row, $handles, ModelKind::statics, $slot, 0, false, true, 0, $this->outlineOf($e));
            $this->scene->write($row, $this->rowFor($rec, $bounds, $static->lodBias, $static->tint, 0.0f, $h->anyCast, false, true), $world);
            $this->scene->change($bounds);
            $this->records->attach($e, $rec);
            $this->staticRecords = $this->staticRecords + 1;
            return;
        }

        if ($entities->has<DynamicModel>($e)) {
            DynamicModel& $dynamic = $entities->get<DynamicModel>($e);
            int32 $handles = $this->acquire($dynamic->model);
            if ($handles < 0) {
                return;
            }

            ModelHandles $h = $this->tables->models[$handles as usize];
            $this->addUser($handles);
            Mat4 $world = $entities->get<Transform>($e)->world($entities);
            AABB $bounds = $h->model->bounds->transformed($world);
            int32 $slot = $this->tables->dynamics->count() as int32;
            $this->tables->dynamics[] = DynamicDraw($e, $handles, $world, $bounds, $dynamic->tint, $dynamic->lodBias, $dynamic->hidden);
            int32 $row = $this->scene->acquire();
            ModelRecord $rec = ModelRecord($row, $handles, ModelKind::dynamic, $slot, 0, false, !$dynamic->hidden, 0, $this->outlineOf($e));
            $rec->linked = $entities->get<Transform>($e)->parent != Entity::none() || $entities->has<AssemblyInstance>($e);
            $this->scene->write($row, $this->rowFor($rec, $bounds, $dynamic->lodBias, $dynamic->tint, 0.0f, $h->anyCast, false, !$dynamic->hidden), $world);
            $this->records->attach($e, $rec);
            if (!$dynamic->hidden && $h->anyCast) {
                $this->scene->change($bounds);
            }

            return;
        }

        if ($entities->has<SkinnedModel>($e)) {
            SkinnedModel& $skin = $entities->get<SkinnedModel>($e);
            int32 $handles = $this->acquire($skin->model);
            if ($handles < 0) {
                return;
            }

            if (!$this->tables->models[$handles as usize]->model->skinned()) {
                info("model: '{$skin->model}' has no skeleton; a SkinnedModel needs one");
                return;
            }

            $this->addUser($handles);
            int32 $row = $this->scene->acquire();
            // a skin is posed every frame: it lives in the active set
            $this->scene->pin($row, true);
            $this->records->attach($e, ModelRecord($row, $handles, ModelKind::skinned, $this->skins->count() as int32, 0, false, false, 0, $this->outlineOf($e)));
            $this->skins[] = $e;
        }
    }

    /**
     * Rewrite each edited entity's row exactly: a changed model id reacquires, a teleport or a
     * retint rewrites in place. O(edits).
     */
    private function applyRefreshes(Entities $entities) : void
    {
        if ($this->refreshes->count() == 0) {
            return;
        }

        foreach ($this->refreshes as $e) {
            if (!$entities->valid($e)) {
                continue;
            }

            if (!$this->records->contains($e)) {
                continue;
            }

            ModelRecord& $rec = $this->records->get($e);
            $rec->refreshQueued = false;
            if ($rec->kind == ModelKind::statics) {
                $this->refreshStatic($entities, $e);
            } else if ($rec->kind == ModelKind::dynamic) {
                $this->refreshDynamic($entities, $e);
            }
        }

        $this->refreshes->clear();
    }

    private function refreshStatic(Entities $entities, Entity $e) : void
    {
        ModelRecord $rec = $this->records->get($e);
        StaticModel& $static = $entities->get<StaticModel>($e);
        ModelHandles $h = $this->tables->models[$rec->handles as usize];
        if (!$h->model->id->equals($static->model)) {
            $this->release($e);
            $this->acquireEntity($entities, $e);
            return;
        }

        Mat4 $world = $entities->get<Transform>($e)->world($entities);
        AABB $bounds = $h->model->bounds->transformed($world);
        AABB $old = $bounds;
        int32 $slot = -1;
        CpuModelViews? $cpu = $this->cpu;
        if ($cpu == null) {
            $old = $this->scene->homeBox($rec->row);
        } else {
            CpuModelViews $views = guard $cpu;
            $old = $views->statics->get($rec->slot as uint32)->bounds;
            $views->statics->release($e);
            $slot = $views->statics->place($e, $rec->handles, $world, $bounds, $static->tint, $static->lodBias);
        }

        $this->scene->write($rec->row, $this->rowFor($rec, $bounds, $static->lodBias, $static->tint, 0.0f, $h->anyCast, false, true), $world);
        $this->scene->change($old);
        $this->scene->change($bounds);
        ModelRecord& $held = $this->records->get($e);
        $held->slot = $slot;
    }

    private function refreshDynamic(Entities $entities, Entity $e) : void
    {
        ModelRecord $rec = $this->records->get($e);
        DynamicModel& $dynamic = $entities->get<DynamicModel>($e);
        ModelHandles $h = $this->tables->models[$rec->handles as usize];
        if (!$h->model->id->equals($dynamic->model)) {
            $this->release($e);
            $this->acquireEntity($entities, $e);
            return;
        }

        Mat4 $world = $entities->get<Transform>($e)->world($entities);
        AABB $bounds = $h->model->bounds->transformed($world);
        DynamicDraw& $draw = $this->tables->dynamics->at($rec->slot as usize);
        bool $wasShown = !$draw->hidden;
        AABB $old = $draw->bounds;
        $draw->world = $world;
        $draw->bounds = $bounds;
        $draw->tint = $dynamic->tint;
        $draw->lodBias = $dynamic->lodBias;
        $draw->hidden = $dynamic->hidden;
        SceneRow $row = $this->rowFor($rec, $bounds, $dynamic->lodBias, $dynamic->tint, 0.0f, $h->anyCast, false, !$dynamic->hidden);
        $this->scene->write($rec->row, $row, $world);
        $this->leaveMovingList($e);
        // an exact move: every shadow it cast where it was and where it is now changes
        $this->forgetMover($e);
        if ($h->anyCast && $wasShown) {
            $this->scene->change($old);
        }

        if ($h->anyCast && !$dynamic->hidden) {
            $this->scene->change($bounds);
        }
    }

    /**
     * The move log since the last fill: each dynamic that moved in the latest update gets its
     * row's previous and current world pose, once; one that moved only in an earlier update, and
     * every moving row an update has run without, gets its exact pose and leaves the moving
     * list. A moved entity inside an assembly brings every part of that assembly, since a part
     * moves with any node above it (a sail with its hub). O(moved + parts of moved assemblies +
     * stopped).
     */
    private function applyMoves(Entities $entities, Vec3 $eye) : void
    {
        $this->moved->clear();
        $entities->moves($this->moveReader, $this->moved);
        uint32 $update = $entities->updateIndex();
        foreach ($this->moved as $e) {
            if (!$entities->valid($e)) {
                continue;
            }

            // a body or a car root (no parent, no assembly) is the whole move
            if (!$this->movePart($entities, $e, $update, $eye)) {
                continue;
            }

            Entity $root = assemblyRootOf($entities, $e);
            if ($root == Entity::none()) {
                continue;
            }

            if (!$this->expanded->contains($root)) {
                $this->expanded->attach($root, -1);
            }

            int32& $seen = $this->expanded->get($root);
            if ($seen == $this->moverFrame) {
                continue;
            }

            $seen = $this->moverFrame;
            $this->movePart($entities, $root, $update, $eye);
            AssemblyInstance& $inst = $entities->get<AssemblyInstance>($root);
            foreach ($inst->nodes as $name => $node) {
                $this->movePart($entities, $node, $update, $eye);
            }
        }

        // a row that moved in an older update than the one that just ran has come to rest
        usize $i = 0;
        while ($i < $this->movingUpdates->count()) {
            if ($this->movingUpdates[$i] >= $update) {
                $i = $i + 1;
                continue;
            }

            $this->stopMoving($entities, $this->movingRecords[$i]);
            $this->dropMoving($i);
        }
    }

    /**
     * One entity the log names, or a part of an assembly root it names: a dynamic that is
     * shown takes its row's two poses. Statics and skins are written elsewhere.
     */
    private function movePart(Entities $entities, Entity $e, uint32 $update, Vec3 $eye) : bool
    {
        if (!$this->records->contains($e)) {
            return true;
        }

        ModelRecord& $rec = $this->records->get($e);
        if ($rec->kind != ModelKind::dynamic || $rec->movedIn == $update) {
            return $rec->linked;
        }

        DynamicDraw& $draw = $this->tables->dynamics->at($rec->slot as usize);
        if ($draw->hidden) {
            return $rec->linked;
        }

        Transform& $t = $entities->get<Transform>($e);
        ModelHandles $h = $this->tables->models[$rec->handles as usize];
        // a root's world pose is its own; only a part under a parent needs the chain and a
        // decomposition
        Pose $wasPose = $t->previousPose();
        Pose $nowPose = $t->pose();
        AABB $bounds = poseBounds($h->model->bounds, $wasPose);
        if ($t->parent != Entity::none()) {
            Mat4 $was = $t->world($entities, 0.0f);
            Mat4 $now = $t->world($entities);
            $wasPose = decomposePose($was);
            $nowPose = decomposePose($now);
            $bounds = $h->model->bounds->transformed($was);
            $bounds->extend($h->model->bounds->transformed($now));
        } else {
            $bounds->extend(poseBounds($h->model->bounds, $nowPose));
        }
        SceneRow $row = $this->rowFor($rec, $bounds, $draw->lodBias, $draw->tint, 0.0f, $h->anyCast, false, true);
        $this->scene->write($rec->row, $row, moving: $wasPose, $nowPose);
        $rec->movedIn = $update;
        if ($this->cpu == null) {
            // the GPU views read the swept box; the shadows change where the row was rewritten
            $draw->bounds = $bounds;
            $this->noteMover($e, $bounds, $h->anyCast, $eye);
        }

        if (!$rec->moving) {
            $rec->moving = true;
            $rec->movingAt = $this->movingRecords->count() as int32;
            $this->movingRecords[] = $e;
            $this->movingUpdates[] = $update;
        } else {
            $this->movingUpdates[$rec->movingAt as usize] = $update;
        }

        return $rec->linked;
    }

    /**
     * A moving row comes to rest: its exact pose, one last shadow change where it stopped.
     */
    private function stopMoving(Entities $entities, Entity $e) : void
    {
        ModelRecord& $rec = $this->records->get($e);
        $rec->moving = false;
        ModelHandles $h = $this->tables->models[$rec->handles as usize];
        Mat4 $world = $entities->get<Transform>($e)->world($entities);
        AABB $bounds = $h->model->bounds->transformed($world);
        DynamicDraw& $draw = $this->tables->dynamics->at($rec->slot as usize);
        $draw->world = $world;
        $draw->bounds = $bounds;
        $this->scene->write($rec->row, $this->rowFor($rec, $bounds, $draw->lodBias, $draw->tint, 0.0f, $h->anyCast, false, !$draw->hidden), $world);
        $this->settleMover($e, $bounds, $h->anyCast);
    }

    /**
     * Take `$e` off the moving list, if it is on it (an exact rewrite overtook its motion).
     */
    private function leaveMovingList(Entity $e) : void
    {
        ModelRecord& $rec = $this->records->get($e);
        if (!$rec->moving) {
            return;
        }

        $rec->moving = false;
        $this->dropMoving($rec->movingAt as usize);
    }

    /**
     * Swap-remove moving list entry `$i`, whose record has already left it; the entry moved into
     * its place learns its new index. O(1).
     */
    private function dropMoving(usize $i) : void
    {
        Entity $gone = $this->movingRecords[$i];
        $this->records->get($gone)->movingAt = -1;
        usize $last = $this->movingRecords->count() - 1;
        if ($i != $last) {
            Entity $kept = $this->movingRecords[$last];
            $this->movingRecords[$i] = $kept;
            $this->movingUpdates[$i] = $this->movingUpdates[$last];
            $this->records->get($kept)->movingAt = $i as int32;
        }

        $this->movingRecords->pop();
        $this->movingUpdates->pop();
    }

    /**
     * The CPU main view's worlds for the dynamics that are moving, at this frame's alpha, and
     * their shadow change boxes. A resting dynamic keeps the world it was left with. O(moving).
     */
    private function interpolateMoving(Entities $entities, float32 $alpha, Vec3 $eye) : void
    {
        foreach ($this->movingRecords as $e) {
            ModelRecord $rec = $this->records->get($e);
            ModelHandles $h = $this->tables->models[$rec->handles as usize];
            Mat4 $world = $entities->get<Transform>($e)->world($entities, $alpha);
            AABB $bounds = $h->model->bounds->transformed($world);
            DynamicDraw& $draw = $this->tables->dynamics->at($rec->slot as usize);
            $draw->world = $world;
            $draw->bounds = $bounds;
            $this->noteMover($e, $bounds, $h->anyCast, $eye);
        }
    }

    /**
     * This frame's palette in the ring, and each posed skin's row. O(skins).
     */
    private function packMovers(RenderContext $ctx, Vec3 $eye) : void
    {
        visu::profile::begin('movers');
        $this->scene->palette = null;
        if ($this->palette->count() > 0) {
            uint64 $bytes = ($this->palette->count() as uint64) * (mem::size<Vec4>() as uint64);
            TransientSlice $slice = $this->bank->device->allocTransient($bytes, $this->bank->device->limits()->uniformAlign);
            ptr<const uint8> $src = ptr<const uint8>(&$this->palette[0]);
            mem::copy<uint8>(ptr<uint8>($slice->data:$), ptr<uint8>($src:$), $bytes);
            $this->scene->palette = $slice;
        }

        foreach ($this->tables->skins as $skin) {
            ModelHandles $h = $this->tables->models[$skin->handles as usize];
            ModelRecord& $rec = $this->records->get($skin->entity);
            SceneRow $row = $this->rowFor($rec, $skin->bounds, $skin->lodBias, $skin->tint, $skin->base, $h->anyCast, true, true);
            $this->scene->write($rec->row, $row, $skin->world);
            $rec->shown = true;
            $rec->frame = $this->moverFrame;
            $this->noteMover($skin->entity, $skin->bounds, $h->anyCast, $eye);
        }

        // a skin that dropped out of the palette this frame draws nothing until it is back
        foreach ($this->skins as $e) {
            ModelRecord& $rec = $this->records->get($e);
            if (!$rec->shown || $rec->frame == $this->moverFrame) {
                continue;
            }

            $rec->shown = false;
            ModelHandles $h = $this->tables->models[$rec->handles as usize];
            $this->scene->restyle($rec->row, SceneRow($rec->handles, AABB(Vec3(0.0f), Vec3(0.0f)), 1.0f, Vec4(1.0f), 0.0f, $h->anyCast, true, false));
            $this->forgetMover($e);
        }

        visu::profile::end();
    }

    /**
     * A caster that moved changes the point-light shadows under where it was drawn and where
     * it is: at once near the eye, every `MOVER_SHADOW_EVERY` frames farther out (the flame
     * flicker hides the lag), then over the whole sweep so no stale shadow is left. O(1) a mover.
     */
    private function noteMover(Entity $e, const AABB& $bounds, bool $casts, Vec3 $eye) : void
    {
        if (!$casts) {
            return;
        }

        if (!$this->tracks->contains($e)) {
            $this->scene->change($bounds);
            $this->tracks->attach($e, MoverTrack($bounds, $bounds, false));
            return;
        }

        MoverTrack& $track = $this->tracks->get($e);
        if (!$track->moved) {
            if ($track->drawn == $bounds) {
                return;
            }

            $track->swept = $track->drawn;
            $track->moved = true;
        }

        $track->swept->extend($bounds);

        // each mover takes its turn on its own frame of the cycle, so the redraws spread out
        bool $turn = (($this->moverFrame + ($e->fold() as int32)) % MOVER_SHADOW_EVERY) == 0;
        if ($turn || length($bounds->center() - $eye) < MOVER_SHADOW_NEAR) {
            $this->scene->change($track->swept);
            $track->drawn = $bounds;
            $track->swept = $bounds;
            $track->moved = false;
        }
    }

    /**
     * This frame's skins: interpolated world, distance cull, and each posed palette appended to
     * the frame palette. Both the GBuffer pass and the cascades draw from the list, so a skin
     * outside the camera still casts. O(skinned instances x joints); nothing allocates, the
     * arrays keep their capacity.
     */
    private function packSkins(Entities $entities, RenderContext $ctx) : void
    {
        $this->tables->skins->clear();
        $this->palette->clear();
        $this->skinnedCount = 0;
        $this->paletteDropped = 0;
        $this->paletteRows = 0;
        if ($this->skins->count() == 0) {
            return;
        }

        CameraData $view = guard $ctx->frame->find<CameraData>() else {
            return;
        }
        visu::profile::begin('palette');
        Vec3 $eye = $view->cullPosition;
        float32 $alpha = $ctx->compensation;
        foreach ($this->skins as $id) {
            SkinnedModel& $skin = $entities->get<SkinnedModel>($id);
            // a hidden skin drops out like one past the palette: its row goes dark below
            if ($skin->hidden) {
                continue;
            }

            int32 $handles = $this->records->get($id)->handles;

            SkinPose $pose = guard $skin->pose else {
                continue;
            }
            ModelHandles $h = $this->tables->models[$handles as usize];
            Transform& $t = $entities->get<Transform>($id);
            Mat4 $world = $t->world($entities, $alpha);
            AABB $bounds = $h->model->bounds->transformed($world);
            if ($h->model->cullDistance > 0.0f && length($bounds->closest($eye) - $eye) > $h->model->cullDistance) {
                continue;
            }

            int32 $rows = $pose->palette->count() as int32;
            int32 $base = $this->palette->count() as int32;
            if ($base + $rows > SKIN_PALETTE_ROWS) {
                $this->paletteDropped = $this->paletteDropped + 1;
                if (!$this->paletteWarned) {
                    int32 $cap = SKIN_PALETTE_ROWS;
                    info("model: skin palette full ({$cap} rows); further skins are skipped this frame");
                    $this->paletteWarned = true;
                }

                continue;
            }

            foreach ($pose->palette as $row) {
                $this->palette[] = $row;
            }

            $this->tables->skins[] = SkinDraw($id, $handles, $world, $bounds, $skin->tint, $skin->lodBias, $base as float32);
            $this->skinnedCount = $this->skinnedCount + 1;
        }

        $this->paletteRows = $this->palette->count() as int32;
        visu::profile::end();
    }

    /**
     * The handle table for a model id: the bank's model registered into this scene's assembler.
     * -1 when the model cannot be loaded; the failure is logged once.
     */
    private function acquire(const string& $id) : int32
    {
        if ($this->modelIndex->has($id)) {
            return $this->modelIndex[$id];
        }

        Model $model = guard $this->bank->acquire($id) else ($e) {
            string $why = $e->message();
            info("model: '{$id}' could not be loaded: {$why}");
            $this->modelIndex[$id] = -1;
            return -1;
        }
        ModelHandles $h = ModelHandles($model);
        CpuModelViews? $cpu = $this->cpu;
        if ($cpu != null) {
            CpuModelViews $views = guard $cpu;
            $views->register($this->bank, $h);
        } else {
            $h->anyCast = modelCasts($this->bank, $model);
        }

        if ($this->freeModels->count() > 0) {
            usize $last = $this->freeModels->count() - 1;
            int32 $reused = $this->freeModels[$last];
            $this->freeModels->pop();
            $this->tables->models[$reused as usize] = $h;
            $this->modelIndex[$id] = $reused;
            $this->scene->setModel($reused, $model);
            return $reused;
        }

        int32 $index = $this->tables->models->count() as int32;
        $this->tables->models[] = $h;
        $this->modelIndex[$id] = $index;
        $this->scene->setModel($index, $model);
        return $index;
    }

    /**
     * Unregister each queued model with no users left and free its slot. O(queued); a model
     * still drawn by something stays queued for the next frame.
     */
    private function drainEvictions() : void
    {
        usize $n = $this->evictions->count();
        if ($n == 0) {
            return;
        }

        usize $keep = 0;
        usize $i = 0;
        while ($i < $n) {
            string $id = $this->evictions[$i];
            if (!$this->evictNow($id)) {
                $this->evictions[$keep] = $id;
                $keep = $keep + 1;
            }

            $i = $i + 1;
        }

        $this->evictions->truncate($keep);
    }

    /**
     * True once `$id` is gone (or was never here); false while something still draws it.
     */
    private function evictNow(const string& $id) : bool
    {
        if (!$this->modelIndex->has($id)) {
            return true;
        }

        int32 $index = $this->modelIndex[$id];
        if ($index < 0) {
            $this->modelIndex->remove($id);
            return true;
        }

        ModelHandles $h = $this->tables->models[$index as usize];
        if ($h->users > 0) {
            return false;
        }

        $this->cpu?->unregister($h);
        $h->dead = true;
        $this->modelIndex->remove($id);
        $this->freeModels[] = $index;
        return true;
    }

    private function addUser(int32 $handles) : void
    {
        if ($handles < 0) {
            return;
        }

        ModelHandles $h = $this->tables->models[$handles as usize];
        $h->users = $h->users + 1;
    }

    private function dropUser(int32 $handles) : void
    {
        if ($handles < 0) {
            return;
        }

        ModelHandles $h = $this->tables->models[$handles as usize];
        if ($h->users > 0) {
            $h->users = $h->users - 1;
        }
    }

    /**
     * `$e` stops drawing: its row goes back to the scene (its shadows change where it stood), it
     * leaves the static set, the dynamic draw list (the last entry moves into its place) or the
     * skin list, and its model loses a user. O(1) but for the moving list.
     */
    internal function release(Entity $e) : void
    {
        if (!$this->records->contains($e)) {
            return;
        }

        ModelRecord $rec = $this->records->get($e);
        $this->leaveMovingList($e);
        $this->forgetMover($e);
        if ($rec->kind == ModelKind::statics) {
            CpuModelViews? $cpu = $this->cpu;
            if ($cpu == null) {
                $this->scene->release($rec->row, $this->scene->homeBox($rec->row));
            } else {
                CpuModelViews $views = guard $cpu;
                $this->scene->release($rec->row, $views->statics->get($rec->slot as uint32)->bounds);
                $views->statics->release($e);
            }

            $this->staticRecords = $this->staticRecords - 1;
        } else if ($rec->kind == ModelKind::dynamic) {
            $this->scene->release($rec->row, $this->tables->dynamics[$rec->slot as usize]->bounds);
            usize $last = $this->tables->dynamics->count() - 1;
            if (($rec->slot as usize) != $last) {
                DynamicDraw $moved = $this->tables->dynamics[$last];
                $this->tables->dynamics[$rec->slot as usize] = $moved;
                $this->records->get($moved->entity)->slot = $rec->slot;
            }

            $this->tables->dynamics->pop();
        } else {
            $this->scene->release($rec->row, AABB(Vec3(0.0f), Vec3(0.0f)));
            usize $last = $this->skins->count() - 1;
            if (($rec->slot as usize) != $last) {
                Entity $moved = $this->skins[$last];
                $this->skins[$rec->slot as usize] = $moved;
                $this->records->get($moved)->slot = $rec->slot;
            }

            $this->skins->pop();
        }

        $this->dropUser($rec->handles);
        $this->records->erase($e);
    }

    /**
     * Add or restyle one model entity. Full room leaves it out.
     */
    private function mark(Entity $e, int32 $style) : void
    {
        usize $i = 0;
        usize $n = $this->highlights->count();
        while ($i < $n) {
            if ($this->highlights[$i]->entity == $e) {
                $this->highlights->at($i)->style = $style;
                $this->restyleOutline($e, $style);
                return;
            }

            $i = $i + 1;
        }

        if ($n >= MODEL_HIGHLIGHTS as usize) {
            return;
        }

        $this->highlights[] = ModelHighlight($e, $style);
        $this->restyleOutline($e, $style);
    }

    /**
     * In GPU mode the outline is a bit of `$e`'s row: record the style and rewrite the row at
     * the next fill (a skin's row is rewritten every fill anyway).
     */
    private function restyleOutline(Entity $e, int32 $style) : void
    {
        if ($this->cpu != null || !$this->records->contains($e)) {
            return;
        }

        ModelRecord& $rec = $this->records->get($e);
        if ($rec->outline == $style) {
            return;
        }

        $rec->outline = $style;
        if ($rec->kind != ModelKind::skinned) {
            $this->queueRefresh($e);
        }
    }

    /**
     * The style `$e` is highlighted in, -1 when it is not. O(highlights).
     */
    private const function outlineOf(Entity $e) : int32
    {
        foreach ($this->highlights as $h) {
            if ($h->entity == $e) {
                return $h->style;
            }
        }

        return -1;
    }

    /**
     * A row of `$rec`'s model with its outline style.
     */
    private const function rowFor(
        const ModelRecord& $rec,
        const AABB& $bounds,
        float32 $lodBias,
        Vec4 $tint,
        float32 $palette,
        bool $casts,
        bool $skinned,
        bool $live
    ) : SceneRow
    {
        SceneRow $row = SceneRow($rec->handles, $bounds, $lodBias, $tint, $palette, $casts, $skinned, $live);
        $row->outline = $rec->outline;
        return $row;
    }

    /**
     * GPU mode: the outline mailbox's box this frame, the union of what glows. Statics from their
     * transform, dynamics from their swept box, skins from this frame's list, previews from their
     * form. O(highlights + preview parts).
     */
    private function outlineBox(Entities $entities) : bool
    {
        bool $any = false;
        AABB $box = AABB(Vec3(0.0f), Vec3(0.0f));
        foreach ($this->highlights as $mark) {
            Entity $e = $mark->entity;
            if (!$this->records->contains($e) || !$entities->valid($e)) {
                continue;
            }

            ModelRecord $rec = $this->records->get($e);
            ModelHandles $h = $this->tables->models[$rec->handles as usize];
            AABB $bounds = $box;
            if ($rec->kind == ModelKind::statics) {
                $bounds = $h->model->bounds->transformed($entities->get<Transform>($e)->world($entities));
            } else if ($rec->kind == ModelKind::dynamic) {
                DynamicDraw $dyn = $this->tables->dynamics[$rec->slot as usize];
                if ($dyn->hidden) {
                    continue;
                }

                $bounds = $dyn->bounds;
            } else {
                bool $posed = false;
                foreach ($this->tables->skins as $skin) {
                    if ($skin->entity == $e) {
                        $bounds = $skin->bounds;
                        $posed = true;
                    }
                }

                if (!$posed) {
                    continue;
                }
            }

            $box = outlineUnion($box, $bounds, $any);
            $any = true;
        }

        foreach ($this->previews as $ghost) {
            int32 $n = $ghost->form->count();
            int32 $i = 0;
            while ($i < $n) {
                int32 $handles = $ghost->form->handles[$i as usize];
                if ($handles >= 0) {
                    Mat4 $world = $ghost->root * $ghost->form->locals[$i as usize];
                    $box = outlineUnion($box, $this->tables->models[$handles as usize]->model->bounds->transformed($world), $any);
                    $any = true;
                }

                $i = $i + 1;
            }
        }

        if ($any) {
            $this->outlined = $box;
        }

        return $any;
    }

    /**
     * GPU mode: this frame's `preview` calls as rows of their own, pinned to the active set,
     * drawn only into the outline view; rows a previous frame used and this one did not are
     * hidden. O(preview parts); rows are acquired once and kept.
     */
    private function writePreviews() : void
    {
        int32 $used = 0;
        foreach ($this->previews as $ghost) {
            int32 $n = $ghost->form->count();
            int32 $i = 0;
            while ($i < $n) {
                int32 $handles = $this->previewHandles($ghost->form, $i);
                $i = $i + 1;
                if ($handles < 0) {
                    continue;
                }

                ModelHandles $h = $this->tables->models[$handles as usize];
                if ($h->model->skinned()) {
                    continue;
                }

                if ($used == ($this->previewRows->count() as int32)) {
                    int32 $fresh = $this->scene->acquire();
                    $this->scene->pin($fresh, true);
                    $this->previewRows[] = $fresh;
                }

                Mat4 $world = $ghost->root * $ghost->form->locals[($i - 1) as usize];
                SceneRow $row = SceneRow($handles, $h->model->bounds->transformed($world), 1.0f, Vec4(1.0f), 0.0f, false, false, true);
                $row->main = false;
                $row->outline = $ghost->style;
                $this->scene->write($this->previewRows[$used as usize], $row, $world);
                $used = $used + 1;
            }
        }

        int32 $k = $used;
        while ($k < $this->previewRowsUsed) {
            SceneRow $gone = SceneRow(0, AABB(Vec3(0.0f), Vec3(0.0f)), 1.0f, Vec4(1.0f), 0.0f, false, false, false);
            $this->scene->restyle($this->previewRows[$k as usize], $gone);
            $k = $k + 1;
        }

        $this->previewRowsUsed = $used;
    }

    /**
     * Take `$e` off the highlight list; order is not kept.
     */
    internal function dropHighlight(Entity $e) : void
    {
        usize $i = 0;
        usize $n = $this->highlights->count();
        while ($i < $n) {
            if ($this->highlights[$i]->entity == $e) {
                $this->highlights[$i] = $this->highlights[$n - 1];
                $this->highlights->truncate($n - 1);
                $this->restyleOutline($e, -1);
                return;
            }

            $i = $i + 1;
        }
    }

    private const function drawsModel(Entities $entities, Entity $e) : bool
    {
        return $entities->has<StaticModel>($e)
            || $entities->has<DynamicModel>($e)
            || $entities->has<SkinnedModel>($e);
    }

    /**
     * A mover came to rest in `$bounds`: its shadows change once more over everything it swept
     * and where it stopped, then it stops being tracked. Nothing more is reported while it rests.
     */
    private function settleMover(Entity $e, const AABB& $bounds, bool $casts) : void
    {
        if (!$casts) {
            return;
        }

        if (!$this->tracks->contains($e)) {
            $this->scene->change($bounds);
            return;
        }

        MoverTrack $gone = $this->tracks->get($e);
        AABB $all = $gone->swept;
        $all->extend($gone->drawn);
        $all->extend($bounds);
        $this->scene->change($all);
        $this->tracks->erase($e);
    }

    /**
     * A mover that stops drawing changes the shadows everywhere it was last drawn and swept.
     */
    private function forgetMover(Entity $e) : void
    {
        if (!$this->tracks->contains($e)) {
            return;
        }

        MoverTrack $gone = $this->tracks->get($e);
        AABB $all = $gone->swept;
        $all->extend($gone->drawn);
        $this->scene->change($all);
        $this->tracks->erase($e);
    }

    /**
     * Every occupied chunk's box, green with a few members through magenta with thousands (the
     * LOD ramp by the log of the count). The `gpuscene chunks` view.
     */
    private function drawChunks() : void
    {
        visu::graphics::SceneChunks $c = $this->scene->chunks;
        int32 $n = $c->occupiedCount();
        int32 $i = 0;
        while ($i < $n) {
            int32 $row = $c->occupiedRow($i);
            int32 $members = $c->members($row);
            int32 $shade = 0;
            int32 $m = $members;
            while ($m > 4) {
                $m = $m / 4;
                $shade = $shade + 1;
            }

            $this->lines->box($c->box($row), lodColor($shade));
            $i = $i + 1;
        }
    }

    /**
     * Each lane's passes once the renderer has linked its programs, and the overlay pass.
     */
    private function ensurePasses() : void
    {
        $this->cpu?->ensure($this->renderer, $this->wireframe);
        if ($this->linePass != null) {
            return;
        }

        ShaderProgram $lines = guard $this->renderer->program('debug_lines') else {
            return;
        }
        $this->linePass = debugLinePass($lines);
    }
}

/**
 * `$box` grown by `$add`, or `$add` itself while nothing has been added yet.
 */
internal function outlineUnion(const AABB& $box, const AABB& $add, bool $started) : AABB
{
    if (!$started) {
        return $add;
    }

    return $box->union($add);
}

/**
 * `$node`'s pose under the assembly root: its TRS times each parent's up the chain. A node whose
 * parent is missing stops the walk there.
 */
internal function previewPose(Assembly $assembly, AssemblyNode $node) : Mat4
{
    Mat4 $pose = translate($node->position) * Mat4($node->orientation) * scale($node->scale);
    string $parent = $node->parent;
    int32 $guard = 0;
    int32 $n = $assembly->nodes->count() as int32;

    while (!$parent->empty() && $guard < $n) {
        AssemblyNode? $found = null;

        foreach ($assembly->nodes as $each) {
            if ($each->name->equals($parent)) {
                $found = $each;
                break;
            }
        }

        AssemblyNode $up = guard $found else {
            break;
        }
        $pose = translate($up->position) * Mat4($up->orientation) * scale($up->scale) * $pose;
        $parent = $up->parent;
        $guard = $guard + 1;
    }

    return $pose;
}

/**
 * Whether some material of `$model` casts a shadow: its GPU scene rows join the shadow views.
 */
internal function modelCasts(ModelBank $bank, Model $model) : bool
{
    foreach ($model->lods as $lod) {
        foreach ($lod->primitives as $prim) {
            if ($bank->materialOf($model, $prim->slot)->material->castShadow) {
                return true;
            }
        }
    }

    return false;
}

/**
 * The CPU main views when the main views do not come from the GPU scene; null when they do.
 */
internal function cpuViewsFor(bool $gpuViews, ModelBank $bank, const AABB& $world, ModelTables $tables) : CpuModelViews?
{
    if ($gpuViews) {
        return null;
    }

    return CpuModelViews($bank->device, $world, $tables);
}
