/**
 * Drives the `FlyingCamera` that also has `ActiveCamera`.
 * Bind after `CameraSystem`; only the marked camera consumes input.
 */

namespace visu::system;

use visu::components::{ActiveCamera, FlyingCamera};
use visu::ecs::{Entities, Entity, Schedule, System};
use visu::geo::Transform;
use visu::graphics::RenderContext;
use visu::math::Vec2;
use visu::os::CursorMode;
use visu::os::input::InputHub;

public class FlyingCameraSystem : System
{
    private InputHub $input;

    public constructor(InputHub $input)
    {
        $this->input = $input;
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->render = false;
    }

    public function update(Entities $entities) : void
    {
        Entity $active = guard $entities->firstWith<ActiveCamera>() else {
            return;
        }

        if (!$entities->has<FlyingCamera>($active) || !$entities->has<Transform>($active)) {
            return;
        }

        FlyingCamera& $fly = $entities->get<FlyingCamera>($active);
        Transform& $transform = $entities->get<Transform>($active);
        InputHub $input = $this->input;

        if (!$input->pointerDown()) {
            $input->setCursorMode(CursorMode::normal);
        }

        if (!$input->unclaimed()) {
            return;
        }

        if ($input->hasBeenPressed()) {
            $input->setCursorMode(CursorMode::disabled);
        }

        float32 $step = $fly->step($input->down(.leftShift) || $input->down(.rightShift));

        if ($input->down(.w)) {
            $transform->moveForward($step);
        }

        if ($input->down(.s)) {
            $transform->moveBackward($step);
        }

        if ($input->down(.a)) {
            $transform->moveLeft($step);
        }

        if ($input->down(.d)) {
            $transform->moveRight($step);
        }

        // the press poll carries the jump from wherever the pointer was
        if ($input->pointerDown() && !$input->hasBeenPressed() && $input->touches()->count() < 2) {
            Vec2 $delta = $input->pointerDelta();
            $fly->euler->x = $fly->euler->x - $delta->x * $fly->lookSpeed;
            $fly->euler->y = $fly->euler->y - $delta->y * $fly->lookSpeed;
        }

        $fly->aim($transform);
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
    }
}
