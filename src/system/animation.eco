/**
 * Samples `AnimationPlayer` clips onto the named child `Transform`s, blending a live
 * crossfade. Runs in update so the pose is ready before `ModelSystem.fill`. Dynamics pick the
 * interpolated world matrix. Skinned joints are `SkinSystem`'s; their tracks cost nothing here.
 */

namespace visu::system;

use visu::asset::{AnimTrack, Clip, blendTrack};
use visu::components::{AnimationLayers, AnimationPlayer, AssemblyInstance};
use visu::ecs::{Entities, Entity, Schedule, System};
use visu::geo::Transform;
use visu::graphics::RenderContext;

public class AnimationSystem : System
{
    /**
     * Seconds per update. Pass the game loop timestep; the default is 60 Hz.
     */
    public float32 $dt;

    public constructor(float32 $dt = 0.016666668f)
    {
        $this->dt = $dt;
    }

    public function register(Entities $entities) : void
    {
    }

    public function unregister(Entities $entities) : void
    {
    }

    public function schedule(Schedule& $schedule) : void
    {
        $schedule->render = false;
    }

    public function update(Entities $entities) : void
    {
        foreach ($entities->view<AnimationPlayer>() as $id => &$player) {
            samplePlayer($entities, $id, $player, $this->dt);
        }
    }

    public function render(Entities $entities, RenderContext $ctx) : void
    {
    }
}

internal function samplePlayer(Entities $entities, Entity $id, AnimationPlayer& $player, float32 $dt) : void
{
    if (!$entities->has<AssemblyInstance>($id)) {
        return;
    }

    AssemblyInstance& $inst = $entities->get<AssemblyInstance>($id);
    $player->advance($dt);
    if ($player->index < 0) {
        if (!$player->playing) {
            return;
        }

        int32 $c = 0;
        while (($c as usize) < $player->clips->count()) {
            applyClip($entities, $inst, $c, $player->clips[$c as usize], $player->time, 1.0f);
            $c = $c + 1;
        }

        return;
    }

    AnimationLayers $layers = guard $player->layers(0.0f) else {
        return;
    }
    if ($layers->fade >= 0) {
        applyClip($entities, $inst, $layers->fade, $player->clips[$layers->fade as usize], $layers->fadeTime, 1.0f);
    }

    applyClip($entities, $inst, $layers->index, $player->clips[$layers->index as usize], $layers->time, $layers->weight);
}

/**
 * Sample clip `$index` onto its node entities. The spawn-time `targets` row is the fast path;
 * a player whose clips are not the assembly's falls back to the name map. A clip that drives no
 * node at all (a skin's joint tracks) costs one comparison.
 */
internal function applyClip(
    Entities $entities,
    AssemblyInstance& $inst,
    int32 $index,
    const Clip& $clip,
    float32 $time,
    float32 $weight
) : void
{
    int32 $tracks = $clip->tracks->count() as int32;
    bool $bound = $index >= 0
        && ($index as usize) < $inst->targets->count()
        && ($inst->targets[$index as usize]->count() as int32) == $tracks;
    if ($bound && $inst->driven[$index as usize] == 0) {
        return;
    }

    int32 $t = 0;
    while ($t < $tracks) {
        AnimTrack $track = $clip->tracks[$t as usize];
        Entity $e = Entity::none();
        if ($bound) {
            $e = $inst->targets[$index as usize][$t as usize];
        } else {
            Entity? $named = $inst->node($track->node);
            $e = $named ?? Entity::none();
        }

        $t = $t + 1;
        if ($e == Entity::none() || !$entities->has<Transform>($e)) {
            continue;
        }

        Transform& $target = $entities->get<Transform>($e);
        $target->storePrevious();
        blendTrack($track, $time, $weight, $target);
    }
}
