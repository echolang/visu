/**
 * VG drawing for the instrument overlay HUD: compact line, tab chips, scroll.
 * Graph body paint lives in overlaygraph.eco. Overlay owns GPU state and sampling.
 */

namespace visu::instrument;

use visu::geo::AABB2D;
use visu::graphics::{Device, TargetRef, Texture, TextureDesc};
use visu::math::Vec2;
use visu::vg::{Canvas, Color, TextAlign};

internal function makeSparkAtlas(Device $device, string $name) : Texture
{
    TextureDesc $desc = TextureDesc($format: .rgba8, $width: SPARK_ATLAS_W, $height: SPARK_H);
    $desc->label = $name;
    return Texture($device, $name, $desc);
}

internal function measureSparkSlots(
    Canvas $vg,
    TargetRef $target,
    const array<HudRow>& $hud
) : array<SparkSlot>
{
    array<SparkSlot> $slots = array<SparkSlot>();
    Vec2 $size = hudSize($target);
    $vg->begin($size->x, $size->y, hudScale($target->contentScaleX));
    guard $vg->fontFace('debug') else {
        $vg->cancel();
        return $slots;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $sepW = $vg->textAdvance(Vec2(HUD_X, HUD_Y), HUD_SEP);
    float32 $x = HUD_X;
    usize $i = 0;
    usize $n = $hud->count();

    while ($i < $n) {
        HudRow $row = $hud[$i];
        float32 $tw = $vg->textAdvance(Vec2(HUD_X, HUD_Y), $row->text);

        if ($row->spark) {
            SparkSlot $slot = SparkSlot($row->key, $x, $tw, $tw, $row->higherWorse);
            $slot->axisMax = $row->axisMax;
            $slots[] = $slot;
        }

        $x = $x + $tw;

        if ($i + 1 < $n) {
            $x = $x + $sepW;
        }

        $i = $i + 1;
    }

    $vg->cancel();
    return $slots;
}

internal function sparkStripWidth(const array<SparkSlot>& $slots) : int32
{
    float32 $right = HUD_X;

    foreach ($slots as $slot) {
        float32 $end = $slot->x + $slot->colW;

        if ($end > $right) {
            $right = $end;
        }
    }

    int32 $w = sparkRound($right - HUD_X);

    if ($w < 1) {
        return 0;
    }

    return $w;
}

internal function paintHud(
    Canvas $vg,
    const array<HudRow>& $lines,
    const array<string>& $extra,
    const array<SparkSlot>& $slots
) : float32
{
    guard $vg->fontFace('debug') else {
        return 0.0f;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $x = HUD_X;
    float32 $y = HUD_Y;
    float32 $lh = HUD_LH;
    float32 $pad = HUD_PAD;
    AABB2D $box = AABB2D(Vec2($x, $y), Vec2($x, $y));
    bool $any = false;
    string $line = hudJoin($lines);
    float32 $lineW = $vg->textAdvance(Vec2($x, $y), $line);
    AABB2D $cell = AABB2D(Vec2($x, $y), Vec2($x + $lineW, $y + $lh));
    $box = hudExtend($box, $cell, $any);
    $any = true;

    int32 $atlasW = sparkStripWidth($slots);

    if ($atlasW > 0) {
        Vec2 $sparkPos = sparkStripOrigin();
        AABB2D $chart = AABB2D(
            $sparkPos,
            $sparkPos + Vec2($atlasW as float32, SPARK_H as float32),
        );
        $box = hudExtend($box, $chart, $any);
        $any = true;
    }

    float32 $ey = $y + $lh;

    if ($atlasW > 0) {
        $ey = $ey + SPARK_GAP + (SPARK_H as float32) + SPARK_GAP;
    }

    foreach ($extra as $more) {
        $eb = $vg->textBounds(Vec2($x, $ey), $more);
        $box = hudExtend($box, $eb, $any);
        $any = true;
        $ey = $ey + $lh;
    }

    if ($any && $box->width() > 0.0f && $box->height() > 0.0f) {
        Vec2 $padV = Vec2($pad, $pad);
        $vg->fillColor(Color(0.08f, 0.08f, 0.10f, 0.78f));
        $vg->fillRounded(
            $box->min - $padV,
            Vec2($box->width(), $box->height()) + $padV * 2.0f,
            4.0f,
        );
    }

    $vg->fillColor(Color::white());
    $vg->text(Vec2($x, $y), $line);

    $ey = $y + $lh;

    if ($atlasW > 0) {
        $ey = $ey + SPARK_GAP + (SPARK_H as float32) + SPARK_GAP;
    }

    foreach ($extra as $more) {
        $vg->text(Vec2($x, $ey), $more);
        $ey = $ey + $lh;
    }

    if (!$any) {
        return $y;
    }

    return $box->max->y + $pad;
}

internal function hudJoin(const array<HudRow>& $rows) : string
{
    string $out = '';
    bool $first = true;

    foreach ($rows as $row) {
        if ($first) {
            $out = $row->text;
            $first = false;
        } else {
            $out->append(HUD_SEP);
            $out->append($row->text);
        }
    }

    return $out;
}

internal function hudExtend(AABB2D $box, const AABB2D& $b, bool $any) : AABB2D
{
    if (!$any) {
        return $b;
    }

    $box->extend($b);
    return $box;
}

internal function lineBox(Canvas $vg, float32 $x, float32 $y, string $text) : AABB2D
{
    return $vg->textBounds(Vec2($x, $y), $text);
}

/**
 * Chips plus the selected tab's body under the HUD. `$scroll` is the first body item drawn; the
 * body is cut to what fits above `$viewH` and the clamped scroll comes back so the wheel cannot run
 * past the last row.
 */
internal function paintTabs(
    Canvas $vg,
    const array<Tab>& $tabs,
    string $selected,
    int32 $graphDepth,
    int32 $scroll,
    float32 $top,
    float32 $viewH
) : int32
{
    if ($tabs->empty()) {
        return 0;
    }

    guard $vg->fontFace('debug') else {
        return $scroll;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $x = HUD_X;
    float32 $y = $top + TAB_GAP;
    float32 $lh = HUD_LH;
    float32 $pad = HUD_PAD;
    AABB2D $box = AABB2D(Vec2($x, $y), Vec2($x, $y));
    bool $any = false;
    float32 $chipY = $y;
    float32 $chipH = $lh + CHIP_PAD_Y * 2.0f;
    float32 $cx = $x;
    foreach ($tabs as $tab) {
        float32 $tw = $vg->textAdvance(Vec2($cx, $chipY), $tab->title);
        float32 $cw = $tw + CHIP_PAD_X * 2.0f;
        AABB2D $chip = AABB2D(Vec2($cx, $chipY), Vec2($cx + $cw, $chipY + $chipH));
        $box = hudExtend($box, $chip, $any);
        $any = true;
        $cx = $cx + $cw + CHIP_GAP;
    }

    Tab $body = $tabs[0];
    bool $haveBody = false;
    foreach ($tabs as $tab) {
        if ($tab->id == $selected) {
            $body = $tab;
            $haveBody = true;
        }
    }

    if (!$haveBody) {
        $body = $tabs[0];
    }

    array<PassTiming> $passes = $body->passes;
    float64 $maxNs = passBarMax($passes);
    array<TabBodyItem> $all = tabBodyItems($body, $passes, $maxNs, $graphDepth);
    float32 $by = $chipY + $chipH + SPARK_GAP;
    float32 $room = $viewH - $by - $pad;
    int32 $first = clampTabScroll($all, $scroll, $room, $lh);
    array<TabBodyItem> $items = visibleTabItems($all, $first, $room, $lh);
    $box = measureTabBody($vg, $box, $any, $x, $by, $lh, $items);
    $any = true;

    if ($any && $box->width() > 0.0f && $box->height() > 0.0f) {
        Vec2 $padV = Vec2($pad, $pad);
        $vg->fillColor(Color(0.08f, 0.08f, 0.10f, 0.78f));
        $vg->fillRounded(
            $box->min - $padV,
            Vec2($box->width(), $box->height()) + $padV * 2.0f,
            4.0f,
        );
    }

    $cx = $x;
    foreach ($tabs as $tab) {
        float32 $tw = $vg->textAdvance(Vec2($cx, $chipY), $tab->title);
        float32 $cw = $tw + CHIP_PAD_X * 2.0f;
        if ($tab->id == $body->id) {
            $vg->fillColor(Color(0.22f, 0.24f, 0.30f, 0.95f));
            $vg->fillRounded(Vec2($cx, $chipY), Vec2($cw, $chipH), 3.0f);
            $vg->fillColor(Color::white());
        } else {
            $vg->fillColor(Color(0.65f, 0.66f, 0.70f, 1.0f));
        }

        $vg->text(Vec2($cx + CHIP_PAD_X, $chipY + CHIP_PAD_Y), $tab->title);
        $cx = $cx + $cw + CHIP_GAP;
    }

    paintTabBody($vg, $x, $by, $lh, $items, $maxNs);
    return $first;
}

/**
 * Clamp the first drawn item so the body never scrolls past its last row: 0 when everything fits,
 * else at most the first index from which the rest still fills the room.
 */
internal function clampTabScroll(
    const array<TabBodyItem>& $items,
    int32 $scroll,
    float32 $room,
    float32 $lh
) : int32
{
    if ($scroll <= 0) {
        return 0;
    }

    int32 $max = maxTabScroll($items, $room, $lh);

    if ($scroll > $max) {
        return $max;
    }

    return $scroll;
}

internal function maxTabScroll(const array<TabBodyItem>& $items, float32 $room, float32 $lh) : int32
{
    float32 $total = 0.0f;
    foreach ($items as $item) {
        $total = $total + tabBodyItemHeight($item, $lh);
    }

    if ($total <= $room) {
        return 0;
    }

    // a scrolled body spends one line on the "above" marker
    float32 $left = $room - $lh;
    float32 $used = 0.0f;
    usize $i = $items->count();

    while ($i > 0) {
        float32 $h = tabBodyItemHeight($items[$i - 1], $lh);

        if ($used + $h > $left) {
            return $i as int32;
        }

        $used = $used + $h;
        $i = $i - 1;
    }

    return 0;
}

/**
 * The slice of `$items` from `$first` that fits in `$room`, with a marker line for the rows
 * hidden above and one for those hidden below.
 */
internal function visibleTabItems(
    const array<TabBodyItem>& $items,
    int32 $first,
    float32 $room,
    float32 $lh
) : array<TabBodyItem>
{
    // `$first` comes from clampTabScroll, so it already lies in [0, count]
    array<TabBodyItem> $out = array<TabBodyItem>();
    usize $n = $items->count();
    usize $start = $first as usize;
    float32 $left = $room;

    if ($start > 0) {
        TabBodyItem $above = .line("^ {$start} more");
        $out[] = $above;
        $left = $left - $lh;
    }

    usize $end = fitTabItems($items, $start, $left, $lh);

    if ($end < $n) {
        // make room for the "below" marker and refit
        $end = fitTabItems($items, $start, $left - $lh, $lh);
    }

    usize $i = $start;

    while ($i < $end) {
        $out[] = $items[$i];
        $i = $i + 1;
    }

    if ($end < $n) {
        usize $hidden = $n - $end;
        TabBodyItem $below = .line("v {$hidden} more");
        $out[] = $below;
    }

    return $out;
}

/**
 * Index one past the last item from `$start` that fits in `$room`.
 */
internal function fitTabItems(
    const array<TabBodyItem>& $items,
    usize $start,
    float32 $room,
    float32 $lh
) : usize
{
    float32 $used = 0.0f;
    usize $i = $start;
    usize $n = $items->count();

    while ($i < $n) {
        float32 $h = tabBodyItemHeight($items[$i], $lh);

        if ($used + $h > $room) {
            break;
        }

        $used = $used + $h;
        $i = $i + 1;
    }

    return $i;
}

/**
 * A content scale the HUD can divide by: the target's, or 1 when it reports none.
 */
internal function hudScale(float32 $scale) : float32
{
    if ($scale < 0.0001f) {
        return 1.0f;
    }

    return $scale;
}

/**
 * Backbuffer size in HUD points.
 */
internal function hudSize(TargetRef $target) : Vec2
{
    return Vec2(
        ($target->width as float32) / hudScale($target->contentScaleX),
        ($target->height as float32) / hudScale($target->contentScaleY),
    );
}
