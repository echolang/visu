/**
 * Overlay line helpers.
 * Numbers are padded to a fixed width so the HUD does not jump when FPS, units, or byte sizes change.
 * Shared with tests so the string is checked without a GPU.
 */

namespace visu::instrument;

public function formatNs(float64 $ns) : string
{
    if ($ns < 0.0) {
        $ns = 0.0;
    }

    // 2-decimal round-up to 1000.00 needs the next unit
    if ($ns < 999.995) {
        return formatDuration($ns, 'ns');
    }

    if ($ns < 999995.0) {
        return formatDuration($ns / 1000.0, 'us');
    }

    if ($ns < 999995000.0) {
        return formatDuration($ns / 1000000.0, 'ms');
    }

    return formatDuration($ns / 1000000000.0, 's');
}

public function formatBytes(uint64 $n) : string
{
    if ($n < 1024 as uint64) {
        string $unit = 'B';
        return "{$n:>6} {$unit:<3}";
    }

    float64 $kib = ($n as float64) / 1024.0;

    if ($n < 1048576 as uint64) {
        return formatSize($kib, 'KiB');
    }

    float64 $mib = $kib / 1024.0;

    if ($n < 1073741824 as uint64) {
        return formatSize($mib, 'MiB');
    }

    return formatSize($mib / 1024.0, 'GiB');
}

public function formatRows(const Sample& $sample) : array<HudRow>
{
    float64 $fpsRaw = $sample->loop->fps;

    if ($fpsRaw < 0.0) {
        $fpsRaw = 0.0;
    }

    float64 $fpsRound = $fpsRaw + 0.5;
    int32 $fps = $fpsRound as int32;
    float64 $tc = $sample->loop->tickCount;
    string $ut = formatNs($sample->loop->tickNs);
    string $ft = formatNs($sample->loop->frameNs);
    string $rt = formatNs($sample->loop->renderNs);
    string $gpu = formatGpu($sample->loop->gpuNs, $sample->loop->gpuNs > 0.0);
    string $vram = formatVram($sample->memory->used, $sample->memory->budget);
    array<HudRow> $rows = array<HudRow>();
    $rows[] = HudRow("FPS: {$fps:>4}", 'fps', $fpsRaw as float32, true, false);
    $rows[] = HudRow("TC: {$tc:>5.2f}", 'tc', $tc as float32, true, true);
    HudRow $utRow = HudRow("UT: {$ut}", 'ut', $sample->loop->tickNs as float32, true, true);
    $utRow->axisMax = HUD_TIME_BUDGET_NS;
    $rows[] = $utRow;
    HudRow $ftRow = HudRow("FT: {$ft}", 'ft', $sample->loop->frameNs as float32, true, true);
    $ftRow->axisMax = HUD_TIME_BUDGET_NS;
    $rows[] = $ftRow;
    HudRow $rtRow = HudRow("RT: {$rt}", 'rt', $sample->loop->renderNs as float32, true, true);
    $rtRow->axisMax = HUD_TIME_BUDGET_NS;
    $rows[] = $rtRow;
    HudRow $gpuRow = HudRow("GPU: {$gpu}", 'gpu', $sample->loop->gpuNs as float32, true, true);
    $gpuRow->axisMax = HUD_TIME_BUDGET_NS;
    $rows[] = $gpuRow;
    $rows[] = HudRow("VRAM: {$vram}", 'vram', $sample->memory->used as float32, true, true);
    usize $allocs = $sample->allocations;

    if ($allocs > 0) {
        $rows[] = HudRow("ALLOC: {$allocs:>6}", 'alloc', $allocs as float32, true, true);
    }

    return $rows;
}

/**
 * One tab as overlay lines: notes, section headers, metrics, then the pass tree in its own order,
 * showing pass rows down to `$maxDepth` only. The default shows every row a profile can hold.
 */
public function formatTab(const Tab& $tab, int32 $maxDepth = visu::profile::MAX_DEPTH) : array<string>
{
    array<string> $lines = array<string>();
    array<TabBodyItem> $items = tabBodyItems($tab, $tab->passes, 0.0, $maxDepth);
    foreach ($items as $item) {
        match ($item) {
            TabBodyItem::line($text) => {
                $lines[] = $text;
            },
            TabBodyItem::row($p, $text, $bars) => {
                appendPassLines($lines, $p);
            },
        };
    }

    return $lines;
}

internal function appendPassLines(array<string>& $lines, PassTiming $p) : void
{
    $lines[] = formatPass($p);
    array<Metric> $extras = $p->extras;
    foreach ($extras as $m) {
        string $extra = formatMetric($m);
        $lines[] = "    {$extra}";
    }
}

public function formatMetric(const Metric& $m) : string
{
    string $value = formatMetricValue($m->value, $m->unit);
    if ($m->of > 0.0) {
        string $right = formatMetricValue($m->of, $m->unit);
        return "{$m->name}: {$value} / {$right}";
    }

    return "{$m->name}: {$value}";
}

/**
 * One tree row: name behind its tree connectors (plain indent when `$tree` is false and the panel
 * draws the lines itself), the rolling average when the window has data (else the last frame), a
 * dash for GPU when no encoder ran under the scope, `xN` for folded siblings.
 */
public function formatPass(const PassTiming& $p, bool $tree = true) : string
{
    string $name = padPassName(indentPassName($p, $tree));
    string $cpu = formatNs(shownCpu($p));
    string $gpu = formatGpu(shownGpu($p), $p->gpuKnown);
    string $draws = formatCount($p->draw->draws as float64);
    string $tri = formatGeom($p->draw->triangles);
    string $calls = formatCalls($p->calls);
    return "{$name}  CPU: {$cpu}  GPU: {$gpu}  draws: {$draws}  tri: {$tri}{$calls}";
}

/**
 * Console row: avg / max for CPU and GPU over the window.
 */
public function formatPassWindow(const PassTiming& $p) : string
{
    string $name = padPassName(indentPassName($p, true));
    string $cpuAvg = formatNs(shownCpu($p));
    string $cpuMax = formatNs(shownMax($p->maxCpuNs, $p->cpuNs));
    string $gpuAvg = formatGpu(shownGpu($p), $p->gpuKnown);
    string $gpuMax = formatGpu(shownMax($p->maxGpuNs, $p->gpuNs), $p->gpuKnown);
    string $calls = formatCalls($p->calls);
    string $pct = formatGpuPct($p);
    return "{$name}  CPU: {$cpuAvg} / {$cpuMax}  GPU: {$gpuAvg} / {$gpuMax}{$pct}{$calls}";
}

/**
 * Rolling average when the window has data, else the last frame.
 */
public function shownCpu(const PassTiming& $p) : float64
{
    if ($p->avgCpuNs > 0.0) {
        return $p->avgCpuNs;
    }

    return $p->cpuNs;
}

public function shownGpu(const PassTiming& $p) : float64
{
    if (!$p->gpuKnown) {
        return 0.0;
    }

    if ($p->avgGpuNs > 0.0) {
        return $p->avgGpuNs;
    }

    return $p->gpuNs;
}

public function findTab(const Sample& $sample, string $id) : Tab?
{
    array<Tab> $tabs = $sample->tabs;
    foreach ($tabs as $tab) {
        if ($tab->id == $id) {
            return $tab;
        }
    }

    return null;
}

public function formatLine(const Sample& $sample) : string
{
    array<HudRow> $rows = formatRows($sample);
    string $out = '';
    bool $first = true;

    foreach ($rows as $row) {
        if ($first) {
            $out = $row->text;
            $first = false;
        } else {
            $out->append(HUD_SEP);
            $out->append($row->text);
        }
    }

    return $out;
}

public function formatGauge(const Gauge& $g) : string
{
    string $value = match ($g->unit) {
        Unit::fps => formatWhole($g->value),
        Unit::ns => formatNs($g->value),
        Unit::bytes => formatBytes(($g->value as uint64)),
        Unit::count => formatWhole($g->value),
        Unit::ratio => formatRatio($g->value),
    };
    return "{$g->name}: {$value}";
}

internal function formatVram(uint64 $used, uint64 $budget) : string
{
    string $left = formatBytes($used);

    if ($budget == 0) {
        return $left;
    }

    string $right = formatBytes($budget);
    return "{$left} / {$right}";
}

internal function formatWhole(float64 $n) : string
{
    float64 $round = $n + 0.5;
    int32 $v = $round as int32;
    return "{$v:>4}";
}

internal function formatRatio(float64 $n) : string
{
    return "{$n:>5.2f}";
}

internal function formatDuration(float64 $v, string $unit) : string
{
    return "{$v:>6.2f} {$unit:<2}";
}

internal function formatSize(float64 $v, string $unit) : string
{
    return "{$v:>6.1f} {$unit:<3}";
}

internal function formatMetricValue(float64 $n, Unit $unit) : string
{
    return match ($unit) {
        Unit::fps => formatWhole($n),
        Unit::ns => formatNs($n),
        Unit::bytes => formatBytes(($n as uint64)),
        Unit::count => formatCount($n),
        Unit::ratio => formatRatio($n),
    };
}

internal function formatCount(float64 $n) : string
{
    float64 $round = $n + 0.5;
    int64 $v = $round as int64;
    return "{$v:>8}";
}

internal function formatGeom(int64 $n) : string
{
    if ($n <= 0) {
        return '       —';
    }

    return "{$n:>8}";
}

internal function formatGpu(float64 $ns, bool $known) : string
{
    if (!$known || $ns <= 0.0) {
        return '       —  ';
    }

    return formatNs($ns);
}

internal function shownMax(float64 $max, float64 $last) : float64
{
    if ($max > 0.0) {
        return $max;
    }

    return $last;
}

internal function formatCalls(int32 $calls) : string
{
    if ($calls <= 1) {
        return '';
    }

    return "  x{$calls}";
}

/**
 * Frame % is this row's GPU elapsed over the window average of `render` GPU busy, not a sum of passes.
 */
internal function formatGpuPct(const PassTiming& $p) : string
{
    if (!$p->gpuKnown || $p->gpuPct <= 0.0) {
        return '';
    }

    float64 $pct = $p->gpuPct * 100.0;
    return "  {$pct:>3.0f}%";
}

/**
 * Characters one tree level takes in front of a name; the panel's bars and guide lines use the
 * same cell so they line up with the text.
 */
public const int32 TREE_CELL = 3;
internal const usize PASS_NAME_W = 26;

/**
 * `render` stays flush; a child gets `|  ` under every ancestor that continues, then `|- ` or
 * `` `- `` for its own connector. Without `$tree` the same columns are blank.
 */
internal function indentPassName(const PassTiming& $p, bool $tree) : string
{
    if ($p->depth <= 0) {
        return $p->name;
    }

    string $prefix = '';
    array<bool> $guides = $p->guides;
    int32 $k = 1;

    while ($k < $p->depth) {
        bool $on = false;

        if (($k as usize) < $guides->count()) {
            $on = $guides[$k as usize];
        }

        if ($tree && $on) {
            $prefix->append('|  ');
        } else {
            $prefix->append('   ');
        }

        $k = $k + 1;
    }

    if (!$tree) {
        $prefix->append('   ');
    } else if ($p->last) {
        $prefix->append('`- ');
    } else {
        $prefix->append('|- ');
    }

    return "{$prefix}{$p->name}";
}

internal function padPassName(string $name) : string
{
    if ($name->size() > PASS_NAME_W) {
        return $name->sub(0, PASS_NAME_W);
    }

    return str::rpad($name, PASS_NAME_W, 32 as uint8);
}
