/**
 * Overlay line helpers.
 * Numbers are padded to a fixed width so the HUD does not jump when FPS, units, or byte sizes change.
 * Shared with tests so the string is checked without a GPU.
 */

namespace visu::instrument;

public function formatNs(float64 $ns) : string
{
    if ($ns < 0.0) {
        $ns = 0.0;
    }

    // 2-decimal round-up to 1000.00 needs the next unit
    if ($ns < 999.995) {
        return formatDuration($ns, 'ns');
    }

    if ($ns < 999995.0) {
        return formatDuration($ns / 1000.0, 'us');
    }

    if ($ns < 999995000.0) {
        return formatDuration($ns / 1000000.0, 'ms');
    }

    return formatDuration($ns / 1000000000.0, 's');
}

public function formatBytes(uint64 $n) : string
{
    if ($n < 1024 as uint64) {
        string $unit = 'B';
        return "{$n:>6} {$unit:<3}";
    }

    float64 $kib = ($n as float64) / 1024.0;

    if ($n < 1048576 as uint64) {
        return formatSize($kib, 'KiB');
    }

    float64 $mib = $kib / 1024.0;

    if ($n < 1073741824 as uint64) {
        return formatSize($mib, 'MiB');
    }

    return formatSize($mib / 1024.0, 'GiB');
}

public function formatRows(const Sample& $sample) : array<HudRow>
{
    float64 $fpsRaw = $sample->loop->fps;

    if ($fpsRaw < 0.0) {
        $fpsRaw = 0.0;
    }

    float64 $fpsRound = $fpsRaw + 0.5;
    int32 $fps = $fpsRound as int32;
    float64 $tc = $sample->loop->tickCount;
    string $ut = formatNs($sample->loop->tickNs);
    string $ft = formatNs($sample->loop->frameNs);
    string $rt = formatNs($sample->loop->renderNs);
    string $vram = formatVram($sample->memory->used, $sample->memory->budget);
    array<HudRow> $rows = array<HudRow>();
    $rows[] = HudRow("FPS: {$fps:>4}", 'fps', $fpsRaw as float32, true, false);
    $rows[] = HudRow("TC: {$tc:>5.2f}", 'tc', $tc as float32, true, true);
    $rows[] = HudRow("UT: {$ut}", 'ut', $sample->loop->tickNs as float32, true, true);
    $rows[] = HudRow("FT: {$ft}", 'ft', $sample->loop->frameNs as float32, true, true);
    $rows[] = HudRow("RT: {$rt}", 'rt', $sample->loop->renderNs as float32, true, true);
    $rows[] = HudRow("VRAM: {$vram}", 'vram', $sample->memory->used as float32, true, true);
    usize $allocs = $sample->allocations;

    if ($allocs > 0) {
        $rows[] = HudRow("ALLOC: {$allocs:>6}", 'alloc', $allocs as float32, true, true);
    }

    return $rows;
}

/**
 * One tab as overlay lines: section headers, metrics, then pass rows.
 */
public function formatTab(const Tab& $tab) : array<string>
{
    array<string> $lines = array<string>();
    array<Section> $sections = $tab->sections;
    foreach ($sections as $sec) {
        if (!$sec->id->empty()) {
            $lines[] = $sec->id;
        }

        array<Metric> $metrics = $sec->metrics;
        foreach ($metrics as $m) {
            string $line = formatMetric($m);
            if ($sec->id->empty()) {
                $lines[] = $line;
            } else {
                $lines[] = "  {$line}";
            }
        }
    }

    array<PassTiming> $passes = sortPasses($tab->passes);
    foreach ($passes as $p) {
        $lines[] = formatPass($p);
        array<Metric> $extras = $p->extras;
        foreach ($extras as $m) {
            string $extra = formatMetric($m);
            $lines[] = "    {$extra}";
        }
    }

    return $lines;
}

public function formatMetric(const Metric& $m) : string
{
    string $value = formatMetricValue($m->value, $m->unit);
    if ($m->of > 0.0) {
        string $right = formatMetricValue($m->of, $m->unit);
        return "{$m->name}: {$value} / {$right}";
    }

    return "{$m->name}: {$value}";
}

public function formatPass(const PassTiming& $p) : string
{
    string $name = padPassName($p->name);
    string $cpu = formatNs($p->cpuNs);
    string $gpu = formatGpu($p->gpuNs);
    string $draws = formatCount($p->draw->draws as float64);
    string $tri = formatGeom($p->draw->triangles);
    return "{$name}  CPU: {$cpu}  GPU: {$gpu}  draws: {$draws}  tri: {$tri}";
}

public function sortPasses(array<PassTiming> $passes) : array<PassTiming>
{
    array<PassTiming> $out = array<PassTiming>();
    foreach ($passes as $p) {
        $out = insertPass($out, $p);
    }

    return $out;
}

public function findTab(const Sample& $sample, string $id) : Tab?
{
    array<Tab> $tabs = $sample->tabs;
    foreach ($tabs as $tab) {
        if ($tab->id == $id) {
            return $tab;
        }
    }

    return null;
}

public function formatLine(const Sample& $sample) : string
{
    array<HudRow> $rows = formatRows($sample);
    string $out = '';
    bool $first = true;

    foreach ($rows as $row) {
        if ($first) {
            $out = $row->text;
            $first = false;
        } else {
            $out->append(HUD_SEP);
            $out->append($row->text);
        }
    }

    return $out;
}

public function formatGauge(const Gauge& $g) : string
{
    string $value = match ($g->unit) {
        Unit::fps => formatWhole($g->value),
        Unit::ns => formatNs($g->value),
        Unit::bytes => formatBytes(($g->value as uint64)),
        Unit::count => formatWhole($g->value),
        Unit::ratio => formatRatio($g->value),
    };
    return "{$g->name}: {$value}";
}

internal function formatVram(uint64 $used, uint64 $budget) : string
{
    string $left = formatBytes($used);

    if ($budget == 0) {
        return $left;
    }

    string $right = formatBytes($budget);
    return "{$left} / {$right}";
}

internal function formatWhole(float64 $n) : string
{
    float64 $round = $n + 0.5;
    int32 $v = $round as int32;
    return "{$v:>4}";
}

internal function formatRatio(float64 $n) : string
{
    return "{$n:>5.2f}";
}

internal function formatDuration(float64 $v, string $unit) : string
{
    return "{$v:>6.2f} {$unit:<2}";
}

internal function formatSize(float64 $v, string $unit) : string
{
    return "{$v:>6.1f} {$unit:<3}";
}

internal function formatMetricValue(float64 $n, Unit $unit) : string
{
    return match ($unit) {
        Unit::fps => formatWhole($n),
        Unit::ns => formatNs($n),
        Unit::bytes => formatBytes(($n as uint64)),
        Unit::count => formatCount($n),
        Unit::ratio => formatRatio($n),
    };
}

internal function formatCount(float64 $n) : string
{
    float64 $round = $n + 0.5;
    int64 $v = $round as int64;
    return "{$v:>8}";
}

internal function formatGeom(int64 $n) : string
{
    if ($n <= 0) {
        return '       —';
    }

    return "{$n:>8}";
}

internal function formatGpu(float64 $ns) : string
{
    if ($ns <= 0.0) {
        return '       —  ';
    }

    return formatNs($ns);
}

internal function padPassName(string $name) : string
{
    if ($name->size() > 16) {
        return $name->sub(0, 16);
    }

    return str::rpad($name, 16, 32 as uint8);
}

internal function insertPass(array<PassTiming> $passes, PassTiming $p) : array<PassTiming>
{
    array<PassTiming> $out = array<PassTiming>();
    bool $placed = false;
    foreach ($passes as $have) {
        if (!$placed && passBefore($p, $have)) {
            $out[] = $p;
            $placed = true;
        }

        $out[] = $have;
    }

    if (!$placed) {
        $out[] = $p;
    }

    return $out;
}

internal function passBefore(const PassTiming& $a, const PassTiming& $b) : bool
{
    if ($a->gpuNs != $b->gpuNs) {
        return $a->gpuNs > $b->gpuNs;
    }

    return $a->cpuNs > $b->cpuNs;
}
