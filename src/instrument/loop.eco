/**
 * GameLoop averages as a Source.
 */

namespace visu::instrument;

use visu::runtime::GameLoop;

public class LoopSource : Source
{
    private GameLoop $loop;

    public constructor(GameLoop $loop)
    {
        $this->loop = $loop;
    }

    public function collect(Sink $sink) : void
    {
        LoopStats $stats = LoopStats();
        $stats->fps = $this->loop->averageFps();
        $stats->frameNs = $this->loop->lastFrameTime();
        $stats->tickNs = $this->loop->averageTickTime();
        $stats->tickCount = $this->loop->averageTickCount();
        $stats->compensation = $this->loop->compensation;
        $sink->loop($stats);
    }
}
