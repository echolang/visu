/**
 * Graph-tab rows from the profiler's StatsBook: every scope seen inside the window, depth-first,
 * siblings sorted by average GPU then average CPU (descending, name as the tie break). Averages are
 * per frame over the window, so the order and the bars move slowly instead of flickering with the
 * frame that happened to complete last. The frame root is skipped, so `update`, `build`, `render`
 * and `present` sit at depth 0 and passes under `render` at depth 1.
 */

namespace visu::instrument;

use visu::profile::{ScopeSnap, StatsBook};

public function rowsFromStats(const StatsBook& $stats) : array<PassTiming>
{
    array<ScopeSnap> $all = $stats->snaps();
    array<PassTiming> $out = array<PassTiming>();
    appendStatRows($all, '', array<bool>(), $out);
    return $out;
}

/**
 * `$guides` carries one flag per ancestor level, true where that ancestor has later siblings; the
 * row keeps it for the tree connectors and its children get it extended by the row's own flag.
 */
internal function appendStatRows(
    const array<ScopeSnap>& $all,
    const string& $parentPath,
    const array<bool>& $guides,
    array<PassTiming>& $out
) : void
{
    array<ScopeSnap> $siblings = array<ScopeSnap>();
    foreach ($all as $s) {
        if ($s->parentPath == $parentPath) {
            $siblings = insertByAverage($siblings, $s);
        }
    }

    usize $count = $siblings->count();
    usize $i = 0;
    float64 $busy = renderBusy($all);

    while ($i < $count) {
        ScopeSnap $s = $siblings[$i];
        $i = $i + 1;
        PassTiming $row = PassTiming();
        $row->name = $s->name;
        $row->guides = $guides;
        $row->last = $i == $count;
        $row->path = $s->path;
        $row->depth = $s->depth - 1;
        $row->calls = $s->lastCalls;
        $row->childCount = childStatCount($all, $s->path);
        $row->cpuNs = $s->cpuLast;
        $row->avgCpuNs = $s->cpuAvg;
        $row->maxCpuNs = $s->cpuMax;
        $row->gpuKnown = $s->gpuKnown;

        if ($row->gpuKnown) {
            $row->gpuNs = $s->gpuLast;
            $row->avgGpuNs = $s->gpuAvg;
            $row->maxGpuNs = $s->gpuMax;
            $row->emaGpuNs = $s->gpuEma;

            if ($busy > 0.0) {
                $row->gpuPct = $s->gpuAvg / $busy;
            }
        }

        $row->draw = $s->lastDraw;
        $out[] = $row;
        array<bool> $below = $guides;
        $below[] = !$row->last;
        appendStatRows($all, $s->path, $below, $out);
    }
}

internal function renderBusy(const array<ScopeSnap>& $all) : float64
{
    foreach ($all as $s) {
        if ($s->path == 'render') {
            return $s->gpuAvg;
        }
    }

    return 0.0;
}

internal function childStatCount(const array<ScopeSnap>& $all, const string& $path) : int32
{
    int32 $n = 0;
    foreach ($all as $s) {
        if ($s->parentPath == $path) {
            $n = $n + 1;
        }
    }

    return $n;
}

internal function insertByAverage(array<ScopeSnap> $list, ScopeSnap $s) : array<ScopeSnap>
{
    array<ScopeSnap> $out = array<ScopeSnap>();
    bool $placed = false;
    foreach ($list as $have) {
        if (!$placed && snapBefore($s, $have)) {
            $out[] = $s;
            $placed = true;
        }

        $out[] = $have;
    }

    if (!$placed) {
        $out[] = $s;
    }

    return $out;
}

internal function snapBefore(const ScopeSnap& $a, const ScopeSnap& $b) : bool
{
    if ($a->gpuAvg != $b->gpuAvg) {
        return $a->gpuAvg > $b->gpuAvg;
    }

    if ($a->cpuAvg != $b->cpuAvg) {
        return $a->cpuAvg > $b->cpuAvg;
    }

    return nameBefore($a->name, $b->name);
}

/**
 * Byte-wise ordering of two names; Echo strings have `==` but no `<`.
 */
internal function nameBefore(const string& $a, const string& $b) : bool
{
    ptr<const uint8> $pa = $a->cstr();
    ptr<const uint8> $pb = $b->cstr();
    usize $n = $a->size();

    if ($b->size() < $n) {
        $n = $b->size();
    }

    usize $i = 0;

    while ($i < $n) {
        if ($pa:$[$i] != $pb:$[$i]) {
            return $pa:$[$i] < $pb:$[$i];
        }

        $i = $i + 1;
    }

    return $a->size() < $b->size();
}
