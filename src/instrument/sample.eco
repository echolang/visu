/**
 * Immutable snapshot of one Instruments.sample() call.
 */

namespace visu::instrument;

use visu::graphics::{AdapterInfo, MemoryStats};

public class Sample
{
    public const LoopStats $loop;
    public const MemoryStats $memory;
    public const AdapterInfo $adapter;
    public const array<Gauge> $gauges;
    public const usize $allocations;
    public const array<Tab> $tabs;

    public constructor(
        LoopStats $loop,
        MemoryStats $memory,
        AdapterInfo $adapter,
        array<Gauge> $gauges,
        usize $allocations = 0
    )
    {
        $this->loop = $loop;
        $this->memory = $memory;
        $this->adapter = $adapter;
        $this->gauges = $gauges;
        $this->allocations = $allocations;
        $this->tabs = array<Tab>();
    }

    public constructor(
        LoopStats $loop,
        MemoryStats $memory,
        AdapterInfo $adapter,
        array<Gauge> $gauges,
        usize $allocations,
        array<Tab> $tabs
    )
    {
        $this->loop = $loop;
        $this->memory = $memory;
        $this->adapter = $adapter;
        $this->gauges = $gauges;
        $this->allocations = $allocations;
        $this->tabs = $tabs;
    }
}
