/**
 * VG HUD on the backbuffer.
 * Compact: one horizontal line, white on a dark panel, with a sparkline under each section.
 * F1 toggles visibility. F2 expands a tab panel underneath. `[` `]` cycle tabs.
 * Extra rows drain even when hidden.
 * Sampling lives on Instruments, not here.
 */

namespace visu::instrument;

use visu::geo::AABB2D;
use visu::graphics::{
    Device, Filter, FullscreenTextureRenderer, Pipeline, Sampler, SamplerDesc,
    Texture, TextureDesc, TargetRef
};
use visu::math::Vec2;
use visu::os::input;
use visu::os::input::KeyPhase;
use visu::runtime::{ConsoleCommandHandler, ConsoleCommandRegistry, DebugConsole};
use visu::signal::{ConsoleCommandSignal, Dispatcher, Flow, KeySignal};
use visu::vg::{Canvas, Color, TextAlign, VgError, VgRenderer};

public class Overlay : ConsoleCommandHandler
{
    public bool $enabled = true;
    public bool $expanded = false;
    public string $selected = 'rendering';

    private VgRenderer $vg;
    private FullscreenTextureRenderer $blit;
    private Texture? $spark0;
    private Texture? $spark1;
    private Sampler? $nearest;
    private array<uint8> $pixels;
    private map<string, array<float32>> $rings;
    private array<string> $rows;
    private bool $loaded;
    private bool $dead;
    private Sample? $lastSample;

    public constructor(Device $device)
    {
        $this->vg = VgRenderer($device);
        $this->blit = FullscreenTextureRenderer();
        $this->spark0 = null;
        $this->spark1 = null;
        $this->nearest = null;
        $this->pixels = array<uint8>();
        $this->rings = map<string, array<float32>>();
        $this->rows = array<string>();
        $this->loaded = false;
        $this->dead = false;
        $this->lastSample = null;
    }

    destructor()
    {
        $this->destroy();
    }

    public function load() : status<VgError>
    {
        Device $device = $this->vg->canvas->device;
        guard $this->vg->load() else ($e) {
            return .error($e);
        }
        string $bytes = debugFontBytes();
        guard $this->vg->canvas->createFont(name: 'debug', bytes: $bytes) else ($e) {
            return .error($e);
        }
        guard $this->blit->load($device) else ($e) {
            return .error(.shader($e->message()));
        }
        SamplerDesc $sd = SamplerDesc();
        $sd->min = Filter::nearest;
        $sd->mag = Filter::nearest;
        $this->nearest = $device->createSampler($sd);
        $this->pixels = sparkFilled(SPARK_ATLAS_W, SPARK_H);
        $this->spark0 = makeSparkAtlas($device, 'overlay-spark-0');
        $this->spark1 = makeSparkAtlas($device, 'overlay-spark-1');
        $this->loaded = true;
        return .ok;
    }

    public function listen(Dispatcher $dispatcher) : void
    {
        Overlay $overlay = $this;
        $dispatcher->register(function(const KeySignal& $key) : Flow {
            if ($key->phase != KeyPhase::press) {
                return .proceed;
            }

            if ($key->key == input::Key::f1) {
                $overlay->enabled = !$overlay->enabled;
                return .proceed;
            }

            if ($key->key == input::Key::f2) {
                $overlay->expanded = !$overlay->expanded;
                return .proceed;
            }

            if (!$overlay->expanded) {
                return .proceed;
            }

            if ($key->key == input::Key::leftBracket) {
                $overlay->cycle(-1);
                return .proceed;
            }

            if ($key->key == input::Key::rightBracket) {
                $overlay->cycle(1);
                return .proceed;
            }

            int32 $n1 = input::Key::num1->value();
            int32 $n9 = input::Key::num9->value();
            int32 $v = $key->key->value();
            if ($v >= $n1 && $v <= $n9) {
                $overlay->selectIndex($v - $n1);
            }

            return .proceed;
        });
    }

    public function registerConsoleCommands(ConsoleCommandRegistry $registry) : array<string>
    {
        $registry->add('metrics', $this);
        array<string> $names = array<string>();
        $names[] = 'metrics';
        return $names;
    }

    public function onConsoleCommand(const ConsoleCommandSignal& $cmd, DebugConsole $console) : void
    {
        if (!$cmd->isAction('metrics')) {
            return;
        }

        if ($cmd->parts->count() < 2) {
            $this->writeStatus($console);
            return;
        }

        string $arg = $cmd->parts[1];
        if ($arg == 'on') {
            $this->enabled = true;
            $console->writeLine('metrics: on');
            return;
        }

        if ($arg == 'off') {
            $this->enabled = false;
            $console->writeLine('metrics: off');
            return;
        }

        if ($arg == 'toggle') {
            $this->enabled = !$this->enabled;
            $this->writeStatus($console);
            return;
        }

        if ($arg == 'expand') {
            if ($cmd->parts->count() >= 3) {
                string $on = $cmd->parts[2];
                if ($on == 'on') {
                    $this->expanded = true;
                } else if ($on == 'off') {
                    $this->expanded = false;
                } else {
                    $console->writeLine('usage: metrics expand [on|off]');
                    return;
                }
            } else {
                $this->expanded = !$this->expanded;
            }

            $this->writeStatus($console);
            return;
        }

        if ($arg == 'tab') {
            if ($cmd->parts->count() < 3) {
                $console->writeLine('usage: metrics tab <id>');
                return;
            }

            $this->selected = $cmd->parts[2];
            $this->expanded = true;
            $this->writeStatus($console);
            return;
        }

        $console->writeLine('usage: metrics [on|off|toggle|expand|tab <id>]');
    }

    private function writeStatus(DebugConsole $console) : void
    {
        string $vis = 'off';
        if ($this->enabled) {
            $vis = 'on';
        }

        string $exp = 'compact';
        if ($this->expanded) {
            $exp = 'expanded';
        }

        $console->writeLine("metrics: {$vis} {$exp} tab {$this->selected}");
        Sample $sample = guard $this->lastSample else {
            return;
        }
        $console->writeLine(formatLine($sample));
        Tab $tab = guard findTab($sample, $this->selected) else {
            return;
        }
        array<string> $lines = formatTab($tab);
        foreach ($lines as $line) {
            $console->writeLine($line);
        }
    }

    public function cycle(int32 $delta) : void
    {
        Sample $sample = guard $this->lastSample else {
            return;
        }
        array<Tab> $tabs = $sample->tabs;
        usize $n = $tabs->count();
        if ($n == 0) {
            return;
        }

        int32 $i = 0;
        int32 $found = 0;
        while ($i < ($n as int32)) {
            if ($tabs[$i as usize]->id == $this->selected) {
                $found = $i;
            }

            $i = $i + 1;
        }

        int32 $next = $found + $delta;
        int32 $wrap = $n as int32;
        while ($next < 0) {
            $next = $next + $wrap;
        }

        $next = $next % $wrap;
        $this->selected = $tabs[$next as usize]->id;
    }

    public function selectIndex(int32 $index) : void
    {
        Sample $sample = guard $this->lastSample else {
            return;
        }
        array<Tab> $tabs = $sample->tabs;
        if ($index < 0 || ($index as usize) >= $tabs->count()) {
            return;
        }

        $this->selected = $tabs[$index as usize]->id;
    }

    public function row(string $line) : void
    {
        $this->rows[] = $line;
    }

    public function pass(Pipeline $pipeline, TargetRef $target, Sample $sample) : void
    {
        $this->lastSample = $sample;
        array<HudRow> $hud = formatRows($sample);
        array<string> $extra = $this->rows;
        $this->rows->clear();
        $this->pushRows($hud);

        if (!$this->enabled || !$this->loaded) {
            return;
        }

        array<HudRow> $drawn = $hud;
        array<string> $below = $extra;
        array<SparkSlot> $slots = $this->measureSlots($target, $drawn);
        bool $expanded = $this->expanded;
        string $selected = $this->selected;
        array<Tab> $tabs = $sample->tabs;
        $this->vg->pass($pipeline, $target, function(Canvas $vg) : void {
            float32 $bottom = paintHud($vg, $drawn, $below, $slots);
            if ($expanded) {
                paintTabs($vg, $tabs, $selected, $bottom);
            }
        });
        $this->stampSpark($pipeline, $target, $slots);
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->loaded = false;
        $this->dropSpark();
        $this->nearest = null;
        $this->blit->destroy();
        $this->vg->destroy();
    }

    private function pushRows(const array<HudRow>& $hud) : void
    {
        foreach ($hud as $row) {
            if (!$row->spark) {
                continue;
            }

            string $key = $row->key;

            if (!$this->rings->has($key)) {
                $this->rings[$key] = array<float32>();
            }

            array<float32>& $ring = $this->rings->at($key);
            pushSpark($ring, $row->value, SPARK_W);
        }
    }

    private function measureSlots(TargetRef $target, const array<HudRow>& $hud) : array<SparkSlot>
    {
        array<SparkSlot> $slots = array<SparkSlot>();
        Canvas $vg = $this->vg->canvas;
        float32 $scale = $target->contentScaleX;

        if ($scale < 0.0001f) {
            $scale = 1.0f;
        }

        float32 $pw = ($target->width as float32) / $scale;
        float32 $ph = ($target->height as float32) / $scale;
        $vg->begin($pw, $ph, $scale);
        guard $vg->fontFace('debug') else {
            $vg->cancel();
            return $slots;
        }
        $vg->fontSize(14.0f);
        $vg->textAlign(TextAlign(.left, .top));
        float32 $sepW = $vg->textAdvance(Vec2(HUD_X, HUD_Y), HUD_SEP);
        float32 $x = HUD_X;
        usize $i = 0;
        usize $n = $hud->count();

        while ($i < $n) {
            HudRow $row = $hud[$i];
            float32 $tw = $vg->textAdvance(Vec2(HUD_X, HUD_Y), $row->text);

            if ($row->spark) {
                $slots[] = SparkSlot($row->key, $x, $tw, $tw, $row->higherWorse);
            }

            $x = $x + $tw;

            if ($i + 1 < $n) {
                $x = $x + $sepW;
            }

            $i = $i + 1;
        }

        $vg->cancel();
        return $slots;
    }

    private function stampSpark(
        Pipeline $pipeline,
        TargetRef $target,
        const array<SparkSlot>& $slots
    ) : void
    {
        if ($slots->empty()) {
            return;
        }

        Texture $tex = guard $this->sparkTex() else {
            return;
        }
        Sampler $samp = guard $this->nearest else {
            return;
        }
        clearSpark($this->pixels);

        foreach ($slots as $slot) {
            if (!$this->rings->has($slot->key)) {
                continue;
            }

            int32 $x0 = sparkRound($slot->x - HUD_X);
            int32 $dw = sparkRound($slot->w);

            if ($dw < 1) {
                continue;
            }

            array<float32> $ring = $this->rings[$slot->key];
            rasterizeSpark(
                $this->pixels,
                $ring,
                SPARK_ATLAS_W,
                SPARK_H,
                0,
                $slot->higherWorse,
                false,
                $x0,
                $dw,
            );
        }

        usize $n = $this->pixels->count();

        if ($n == 0) {
            return;
        }

        int32 $stripW = sparkStripWidth($slots);
        int32 $stripH = SPARK_H;
        float32 $sx = $target->contentScaleX;
        float32 $sy = $target->contentScaleY;

        if ($sx < 0.0001f) {
            $sx = 1.0f;
        }

        if ($sy < 0.0001f) {
            $sy = 1.0f;
        }

        Vec2 $origin = sparkStripOrigin();
        int32 $capW = sparkRound(($target->width as float32) / $sx - $origin->x);
        int32 $capH = sparkRound(($target->height as float32) / $sy - $origin->y);

        if ($capW < 1 || $capH < 1) {
            return;
        }

        if ($stripW > $capW) {
            $stripW = $capW;
        }

        if ($stripH > $capH) {
            $stripH = $capH;
        }

        if ($stripW > SPARK_ATLAS_W) {
            $stripW = SPARK_ATLAS_W;
        }

        if ($stripW < 1 || $stripH < 1) {
            return;
        }

        $tex->upload(0, $this->pixels->data(), $n as uint64, SPARK_ATLAS_W * 4);
        $this->blit->stamp(
            $pipeline,
            $target,
            $tex,
            $samp,
            $origin,
            Vec2($stripW as float32, $stripH as float32),
            Vec2(
                ($stripW as float32) / (SPARK_ATLAS_W as float32),
                ($stripH as float32) / (SPARK_H as float32),
            ),
        );
    }

    private function sparkTex() : Texture?
    {
        uint32 $slot = $this->vg->canvas->device->frameSlot() % 2;

        if ($slot == 0) {
            return $this->spark0;
        }

        return $this->spark1;
    }

    private function dropSpark() : void
    {
        Texture? $a = $this->spark0;

        if ($a != null) {
            Texture $tex = guard $a;
            $tex->destroy();
            $this->spark0 = null;
        }

        Texture? $b = $this->spark1;

        if ($b != null) {
            Texture $tex = guard $b;
            $tex->destroy();
            $this->spark1 = null;
        }

        $this->pixels = array<uint8>();
    }
}

internal function makeSparkAtlas(Device $device, string $name) : Texture
{
    TextureDesc $desc = TextureDesc($format: .rgba8, $width: SPARK_ATLAS_W, $height: SPARK_H);
    $desc->label = $name;
    return Texture($device, $name, $desc);
}

internal function sparkStripWidth(const array<SparkSlot>& $slots) : int32
{
    float32 $right = HUD_X;

    foreach ($slots as $slot) {
        float32 $end = $slot->x + $slot->colW;

        if ($end > $right) {
            $right = $end;
        }
    }

    int32 $w = sparkRound($right - HUD_X);

    if ($w < 1) {
        return 0;
    }

    return $w;
}

internal function paintHud(
    Canvas $vg,
    const array<HudRow>& $lines,
    const array<string>& $extra,
    const array<SparkSlot>& $slots
) : float32
{
    guard $vg->fontFace('debug') else {
        return 0.0f;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $x = HUD_X;
    float32 $y = HUD_Y;
    float32 $lh = HUD_LH;
    float32 $pad = HUD_PAD;
    AABB2D $box = AABB2D(Vec2($x, $y), Vec2($x, $y));
    bool $any = false;
    string $line = hudJoin($lines);
    float32 $lineW = $vg->textAdvance(Vec2($x, $y), $line);
    AABB2D $cell = AABB2D(Vec2($x, $y), Vec2($x + $lineW, $y + $lh));
    $box = hudExtend($box, $cell, $any);
    $any = true;

    int32 $atlasW = sparkStripWidth($slots);

    if ($atlasW > 0) {
        Vec2 $sparkPos = sparkStripOrigin();
        AABB2D $chart = AABB2D(
            $sparkPos,
            $sparkPos + Vec2($atlasW as float32, SPARK_H as float32),
        );
        $box = hudExtend($box, $chart, $any);
        $any = true;
    }

    float32 $ey = $y + $lh;

    if ($atlasW > 0) {
        $ey = $ey + SPARK_GAP + (SPARK_H as float32) + SPARK_GAP;
    }

    foreach ($extra as $more) {
        $eb = $vg->textBounds(Vec2($x, $ey), $more);
        $box = hudExtend($box, $eb, $any);
        $any = true;
        $ey = $ey + $lh;
    }

    if ($any && $box->width() > 0.0f && $box->height() > 0.0f) {
        Vec2 $padV = Vec2($pad, $pad);
        $vg->fillColor(Color(0.08f, 0.08f, 0.10f, 0.78f));
        $vg->fillRounded(
            $box->min - $padV,
            Vec2($box->width(), $box->height()) + $padV * 2.0f,
            4.0f,
        );
    }

    $vg->fillColor(Color::white());
    $vg->text(Vec2($x, $y), $line);

    $ey = $y + $lh;

    if ($atlasW > 0) {
        $ey = $ey + SPARK_GAP + (SPARK_H as float32) + SPARK_GAP;
    }

    foreach ($extra as $more) {
        $vg->text(Vec2($x, $ey), $more);
        $ey = $ey + $lh;
    }

    if (!$any) {
        return $y;
    }

    return $box->max->y + $pad;
}

internal function hudJoin(const array<HudRow>& $rows) : string
{
    string $out = '';
    bool $first = true;

    foreach ($rows as $row) {
        if ($first) {
            $out = $row->text;
            $first = false;
        } else {
            $out->append(HUD_SEP);
            $out->append($row->text);
        }
    }

    return $out;
}

internal function hudExtend(AABB2D $box, const AABB2D& $b, bool $any) : AABB2D
{
    if (!$any) {
        return $b;
    }

    $box->extend($b);
    return $box;
}

internal function paintTabs(
    Canvas $vg,
    const array<Tab>& $tabs,
    string $selected,
    float32 $top
) : void
{
    if ($tabs->empty()) {
        return;
    }

    guard $vg->fontFace('debug') else {
        return;
    }
    $vg->fontSize(14.0f);
    $vg->textAlign(TextAlign(.left, .top));
    float32 $x = HUD_X;
    float32 $y = $top + TAB_GAP;
    float32 $lh = HUD_LH;
    float32 $pad = HUD_PAD;
    AABB2D $box = AABB2D(Vec2($x, $y), Vec2($x, $y));
    bool $any = false;
    float32 $chipY = $y;
    float32 $chipH = $lh + CHIP_PAD_Y * 2.0f;
    float32 $cx = $x;
    foreach ($tabs as $tab) {
        float32 $tw = $vg->textAdvance(Vec2($cx, $chipY), $tab->title);
        float32 $cw = $tw + CHIP_PAD_X * 2.0f;
        AABB2D $chip = AABB2D(Vec2($cx, $chipY), Vec2($cx + $cw, $chipY + $chipH));
        $box = hudExtend($box, $chip, $any);
        $any = true;
        $cx = $cx + $cw + CHIP_GAP;
    }

    Tab $body = $tabs[0];
    bool $haveBody = false;
    foreach ($tabs as $tab) {
        if ($tab->id == $selected) {
            $body = $tab;
            $haveBody = true;
        }
    }

    if (!$haveBody) {
        $body = $tabs[0];
    }

    array<PassTiming> $passes = sortPasses($body->passes);
    float64 $maxNs = passBarMax($passes);
    float32 $by = $chipY + $chipH + SPARK_GAP;
    $box = measureTabBody($vg, $box, $any, $x, $by, $lh, $body, $passes, $maxNs);
    $any = true;

    if ($any && $box->width() > 0.0f && $box->height() > 0.0f) {
        Vec2 $padV = Vec2($pad, $pad);
        $vg->fillColor(Color(0.08f, 0.08f, 0.10f, 0.78f));
        $vg->fillRounded(
            $box->min - $padV,
            Vec2($box->width(), $box->height()) + $padV * 2.0f,
            4.0f,
        );
    }

    $cx = $x;
    foreach ($tabs as $tab) {
        float32 $tw = $vg->textAdvance(Vec2($cx, $chipY), $tab->title);
        float32 $cw = $tw + CHIP_PAD_X * 2.0f;
        if ($tab->id == $body->id) {
            $vg->fillColor(Color(0.22f, 0.24f, 0.30f, 0.95f));
            $vg->fillRounded(Vec2($cx, $chipY), Vec2($cw, $chipH), 3.0f);
            $vg->fillColor(Color::white());
        } else {
            $vg->fillColor(Color(0.65f, 0.66f, 0.70f, 1.0f));
        }

        $vg->text(Vec2($cx + CHIP_PAD_X, $chipY + CHIP_PAD_Y), $tab->title);
        $cx = $cx + $cw + CHIP_GAP;
    }

    paintTabBody($vg, $x, $by, $lh, $body, $passes, $maxNs);
}

internal function measureTabBody(
    Canvas $vg,
    AABB2D $box,
    bool $any,
    float32 $x,
    float32 $y,
    float32 $lh,
    const Tab& $body,
    const array<PassTiming>& $passes,
    float64 $maxNs
) : AABB2D
{
    float32 $cy = $y;
    array<Section> $sections = $body->sections;
    foreach ($sections as $sec) {
        if (!$sec->id->empty()) {
            $box = hudExtend($box, $vg->textBounds(Vec2($x, $cy), $sec->id), $any);
            $any = true;
            $cy = $cy + $lh;
        }

        array<Metric> $metrics = $sec->metrics;
        foreach ($metrics as $m) {
            string $line = formatMetric($m);
            if (!$sec->id->empty()) {
                $line = "  {$line}";
            }

            $box = hudExtend($box, $vg->textBounds(Vec2($x, $cy), $line), $any);
            $any = true;
            $cy = $cy + $lh;
        }
    }

    foreach ($passes as $p) {
        string $line = formatPass($p);
        $box = hudExtend($box, $vg->textBounds(Vec2($x, $cy), $line), $any);
        $any = true;
        $cy = $cy + $lh;
        array<Metric> $extras = $p->extras;
        foreach ($extras as $m) {
            string $extra = formatMetric($m);
            $extra = "    {$extra}";
            $box = hudExtend($box, $vg->textBounds(Vec2($x, $cy), $extra), $any);
            $any = true;
            $cy = $cy + $lh;
        }

        if ($maxNs > 0.0) {
            float32 $stack = passBarStack($p);
            AABB2D $bars = AABB2D(Vec2($x, $cy), Vec2($x + BAR_W, $cy + $stack));
            $box = hudExtend($box, $bars, $any);
            $any = true;
            $cy = $cy + $stack + SPARK_GAP;
        }
    }

    return $box;
}

internal function paintTabBody(
    Canvas $vg,
    float32 $x,
    float32 $y,
    float32 $lh,
    const Tab& $body,
    const array<PassTiming>& $passes,
    float64 $maxNs
) : void
{
    float32 $cy = $y;
    array<Section> $sections = $body->sections;
    foreach ($sections as $sec) {
        $vg->fillColor(Color::white());
        if (!$sec->id->empty()) {
            $vg->text(Vec2($x, $cy), $sec->id);
            $cy = $cy + $lh;
        }

        array<Metric> $metrics = $sec->metrics;
        foreach ($metrics as $m) {
            string $line = formatMetric($m);
            if (!$sec->id->empty()) {
                $line = "  {$line}";
            }

            $vg->text(Vec2($x, $cy), $line);
            $cy = $cy + $lh;
        }
    }

    foreach ($passes as $p) {
        $vg->fillColor(Color::white());
        $vg->text(Vec2($x, $cy), formatPass($p));
        $cy = $cy + $lh;
        array<Metric> $extras = $p->extras;
        foreach ($extras as $m) {
            string $extra = formatMetric($m);
            $vg->text(Vec2($x, $cy), "    {$extra}");
            $cy = $cy + $lh;
        }

        if ($maxNs > 0.0) {
            $cy = paintPassBars($vg, $x, $cy, $p, $maxNs);
            $cy = $cy + SPARK_GAP;
        }
    }
}

internal function paintPassBars(
    Canvas $vg,
    float32 $x,
    float32 $y,
    const PassTiming& $p,
    float64 $maxNs
) : float32
{
    float32 $cy = $y;
    float32 $cpuW = ((($p->cpuNs / $maxNs) as float32) * BAR_W);
    $vg->fillColor(Color(0.35f, 0.85f, 0.45f, 0.85f));
    if ($cpuW > 1.0f) {
        $vg->fillRect(Vec2($x, $cy), Vec2($cpuW, BAR_H));
    }

    $cy = $cy + BAR_H;
    if ($p->gpuNs > 0.0) {
        $cy = $cy + BAR_GAP;
        float32 $gpuW = ((($p->gpuNs / $maxNs) as float32) * BAR_W);
        $vg->fillColor(Color(0.40f, 0.65f, 0.95f, 0.85f));
        if ($gpuW > 1.0f) {
            $vg->fillRect(Vec2($x, $cy), Vec2($gpuW, BAR_H));
        }

        $cy = $cy + BAR_H;
    }

    return $cy;
}

internal function passBarMax(const array<PassTiming>& $passes) : float64
{
    float64 $maxNs = 0.0;
    foreach ($passes as $p) {
        if ($p->cpuNs > $maxNs) {
            $maxNs = $p->cpuNs;
        }

        if ($p->gpuNs > $maxNs) {
            $maxNs = $p->gpuNs;
        }
    }

    return $maxNs;
}

internal function passBarStack(const PassTiming& $p) : float32
{
    if ($p->gpuNs > 0.0) {
        return BAR_H + BAR_GAP + BAR_H;
    }

    return BAR_H;
}
