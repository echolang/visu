/**
 * Typed built-in samples.
 * Loop numbers come from GameLoop; memory / adapter live on Device.
 * Tabs are the expandable overlay; compact HUD still uses HudRow.
 */

namespace visu::instrument;

use visu::graphics::DrawStats;

public struct LoopStats
{
    public float64 $fps = 0.0;
    public float64 $frameNs = 0.0;
    public float64 $tickNs = 0.0;
    public float64 $tickCount = 0.0;
    public float64 $renderNs = 0.0;
    public float32 $compensation = 0.0f;
}

/**
 * One overlay line plus the value its sparkline plots.
 * `$higherWorse` is false for FPS (drops are red).
 */
public struct HudRow
{
    public string $text;
    public string $key;
    public float32 $value = 0.0f;
    public bool $spark = true;
    public bool $higherWorse = true;
}

public struct Gauge
{
    public string $name;
    public float64 $value;
    public Unit $unit;
}

/**
 * One named value on a tab. `$of` > 0 formats as `n / of` (quads drawn of leaves).
 */
public struct Metric
{
    public string $name;
    public float64 $value;
    public Unit $unit;
    public float64 $of = 0.0;
}

public struct TabSpec
{
    public string $id;
    public string $title;
    public int32 $order = 100;
}

public struct Section
{
    public string $id;
    public array<Metric> $metrics;
}

/**
 * One render-graph pass. `$gpuNs` is 0 when the backend has no timestamp (overlay prints —).
 */
public struct PassTiming
{
    public string $name = '';
    public float64 $cpuNs = 0.0;
    public float64 $gpuNs = 0.0;
    public DrawStats $draw = DrawStats();
    public array<Metric> $extras = array<Metric>();
}

/**
 * One overlay tab. Fact: written at sample(), Overlay only reads.
 */
public class Tab
{
    public const string $id;
    public const string $title;
    public const int32 $order;
    public const array<Section> $sections;
    public const array<PassTiming> $passes;

    public constructor(
        string $id,
        string $title,
        int32 $order,
        array<Section> $sections,
        array<PassTiming> $passes
    )
    {
        $this->id = $id;
        $this->title = $title;
        $this->order = $order;
        $this->sections = $sections;
        $this->passes = $passes;
    }
}
