/**
 * Typed built-in samples.
 * Loop numbers come from GameLoop; memory / adapter live on Device.
 * Tabs are the expandable overlay; compact HUD still uses HudRow.
 */

namespace visu::instrument;

use visu::graphics::DrawStats;

public struct LoopStats
{
    public float64 $fps = 0.0;
    public float64 $frameNs = 0.0;
    public float64 $tickNs = 0.0;
    public float64 $tickCount = 0.0;
    public float64 $renderNs = 0.0;
    /** whole-submit GPU time of the last completed profile frame; 0 when unknown */
    public float64 $gpuNs = 0.0;
    public float32 $compensation = 0.0f;
}

/**
 * One overlay line plus the value its sparkline plots.
 * `$higherWorse` is false for FPS (drops are red).
 */
public struct HudRow
{
    public string $text;
    public string $key;
    public float32 $value = 0.0f;
    public bool $spark = true;
    public bool $higherWorse = true;
}

public struct Gauge
{
    public string $name;
    public float64 $value;
    public Unit $unit;
}

/**
 * One named value on a tab. `$of` > 0 formats as `n / of` (quads drawn of leaves).
 */
public struct Metric
{
    public string $name;
    public float64 $value;
    public Unit $unit;
    public float64 $of = 0.0;
}

public struct TabSpec
{
    public string $id;
    public string $title;
    public int32 $order = 100;
}

public struct Section
{
    public string $id;
    public array<Metric> $metrics;
}

/**
 * One row of the graph tab: a profile scope, flattened depth-first. `$gpuNs` is 0 and `$gpuKnown`
 * false when no encoder ran under the scope (overlay prints —). Avg / max are the rolling window.
 */
public struct PassTiming
{
    public string $name = '';
    /** scope path such as `render/deferred.ssao/blur`; empty for push-path rows */
    public string $path = '';
    /** 0 for `update` / `render` / `present`, 1 for passes, 2 for pass sub-scopes */
    public int32 $depth = 0;
    public int32 $calls = 1;
    public int32 $childCount = 0;
    public float64 $cpuNs = 0.0;
    public float64 $gpuNs = 0.0;
    public bool $gpuKnown = false;
    public float64 $avgCpuNs = 0.0;
    public float64 $avgGpuNs = 0.0;
    public float64 $maxCpuNs = 0.0;
    public float64 $maxGpuNs = 0.0;
    public DrawStats $draw = DrawStats();
    public array<Metric> $extras = array<Metric>();
    /** one flag per ancestor level: true when that ancestor has later siblings, so its guide continues */
    public array<bool> $guides = array<bool>();
    /** last among its siblings: the connector closes instead of continuing down */
    public bool $last = true;
}

/**
 * One overlay tab. Fact: written at sample(), Overlay only reads.
 */
public class Tab
{
    public const string $id;
    public const string $title;
    public const int32 $order;
    public const array<Section> $sections;
    public const array<PassTiming> $passes;
    /** free lines above the sections, such as `profiling compiled out (VISU_RELEASE)` */
    public const array<string> $notes;

    public constructor(
        string $id,
        string $title,
        int32 $order,
        array<Section> $sections,
        array<PassTiming> $passes,
        array<string> $notes = array<string>()
    )
    {
        $this->id = $id;
        $this->title = $title;
        $this->order = $order;
        $this->sections = $sections;
        $this->passes = $passes;
        $this->notes = $notes;
    }
}
