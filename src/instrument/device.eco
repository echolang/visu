/**
 * Device adapter + memory as a Source.
 */

namespace visu::instrument;

use visu::graphics::Device;

public class DeviceSource : Source
{
    private Device $device;

    public constructor(Device $device)
    {
        $this->device = $device;
    }

    public function collect(Sink $sink) : void
    {
        $sink->adapter($this->device->adapterInfo());
        $sink->memory($this->device->memoryStats());
    }
}
