/**
 * Embedded debug TTF (Inconsolata Regular).
 * Overlay loads this so a vendor copy does not have to hunt for a font file.
 */

namespace visu::instrument;

internal extern {
    function visu_debug_font_ptr() : ptr<const uint8>;
    function visu_debug_font_size() : uint32;
}

public function debugFontBytes() : string
{
    uint32 $n = visu_debug_font_size();
    ptr<const uint8> $src = visu_debug_font_ptr();
    string $out = '';
    $out->reserve($n as usize);
    uint32 $i = 0;

    while ($i < $n) {
        $out->push($src:$[$i]);
        $i = $i + 1;
    }

    return $out;
}
