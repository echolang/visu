/**
 * Console grammar for the instrument overlay. The overlay remains the handler; this file is
 * the parser so the draw path does not carry it.
 */

namespace visu::instrument;

use visu::signal::ConsoleCommandSignal;

internal enum MetricsAction
{
    case status;
    case usage;
    case on;
    case off;
    case toggle;
    case expand(bool $on);
    case expandToggle;
    case tab(string $id);
}

/**
 * `metrics` alone is status; `metrics on|off|toggle`; `metrics expand [on|off]`; `metrics tab <id>`.
 */
internal function parseMetricsConsole(const ConsoleCommandSignal& $cmd) : MetricsAction
{
    if (!$cmd->isAction('metrics')) {
        return .usage;
    }

    if ($cmd->parts->count() < 2) {
        return .status;
    }

    string $arg = $cmd->parts[1];
    if ($arg == 'on') {
        return .on;
    }

    if ($arg == 'off') {
        return .off;
    }

    if ($arg == 'toggle') {
        return .toggle;
    }

    if ($arg == 'expand') {
        if ($cmd->parts->count() >= 3) {
            string $on = $cmd->parts[2];
            if ($on == 'on') {
                return .expand(true);
            }

            if ($on == 'off') {
                return .expand(false);
            }

            return .usage;
        }

        return .expandToggle;
    }

    if ($arg == 'tab') {
        if ($cmd->parts->count() < 3) {
            return .usage;
        }

        return .tab($cmd->parts[2]);
    }

    return .usage;
}
