/**
 * A model that deforms by a skeleton. It follows its entity's `Transform` like a
 * `DynamicModel`, and `SkinSystem` poses it every frame from the `AnimationPlayer` on
 * `$animator` (the assembly root that `spawnAssembly` fills in). `$pose` is null until the
 * system has prepared the instance.
 */

namespace visu::components;

use visu::ecs::Entity;
use visu::math::Vec4;

public struct SkinnedModel
{
    /**
     * Catalog id of the cooked model. It must carry a skeleton.
     */
    public string $model;

    /**
     * Multiplies the albedo. Alpha is reserved for a LOD fade.
     */
    public Vec4 $tint;

    /**
     * Per-instance LOD distance multiplier, on top of the model's own and the system's.
     */
    public float32 $lodBias;

    /**
     * The entity whose `AnimationPlayer` drives this skin. `Entity::none()` holds the rest pose.
     */
    public Entity $animator;
    public SkinPose? $pose;

    public constructor(string $model, Entity $animator)
    {
        $this->model = $model;
        $this->tint = Vec4(1.0f);
        $this->lodBias = 1.0f;
        $this->animator = $animator;
        $this->pose = null;
    }
}
