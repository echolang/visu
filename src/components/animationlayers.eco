/**
 * What a pose samples from an `AnimationPlayer` at one moment: the fading clip at full weight
 * when a fade is live, then the current clip over it by `weight`. `AnimationSystem` lays it on
 * node transforms and `SkinSystem` on skin joints, so both blend the same crossfade.
 */

namespace visu::components;

public struct AnimationLayers
{
    /**
     * The clip fading out, or -1 when the current clip plays alone.
     */
    public int32 $fade;
    public float32 $fadeTime;
    public int32 $index;
    public float32 $time;

    /**
     * Weight of the current clip over the fading one. 1 when `fade` is -1.
     */
    public float32 $weight;
}
