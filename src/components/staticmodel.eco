/**
 * A model placed once. `ModelSystem` bakes the entity's world matrix and bounds when it first sees
 * the component and keeps them in its octree; moving the entity afterwards changes nothing until
 * `ModelSystem.restatic` re-places it. PHP VISU's `LPStaticModel`.
 */

namespace visu::components;

use visu::math::Vec4;

public struct StaticModel
{
    /**
     * Catalog id of the cooked model, e.g. `foliage/bush_01/bush_01`.
     */
    public string $model;

    /**
     * Multiplies the albedo. Alpha is reserved for a LOD fade.
     */
    public Vec4 $tint;

    /**
     * Per-instance LOD distance multiplier, on top of the model's own and the system's.
     */
    public float32 $lodBias;

    public constructor(string $model)
    {
        $this->model = $model;
        $this->tint = Vec4(1.0f);
        $this->lodBias = 1.0f;
    }
}
