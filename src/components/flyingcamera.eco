/**
 * WASD + hold-pointer look tunables.
 * An ECS component on a camera entity; `FlyingCameraSystem` drives the one that also has `ActiveCamera`.
 * Shift multiplies `$speed` by `$sprint`. `aim` writes yaw/pitch onto the entity's `Transform`.
 */

namespace visu::components;

use visu::geo::Transform;
use visu::math::{Quat, Vec2, radians};

public struct FlyingCamera
{

    /**
     * World units per fixed update tick.
     */
    public float32 $speed = 0.5f;

    /**
     * Times `$speed` while either shift key is held.
     */
    public float32 $sprint = 50.0f;

    /**
     * Degrees of yaw / pitch per cursor pixel.
     */
    public float32 $lookSpeed = 0.1f;

    /**
     * Degrees; x is yaw about world up, y is pitch.
     */
    public Vec2 $euler;

    init
    {
        $this->euler = Vec2(0.0f, 0.0f);
    }

    /**
     * World units this tick. Shift multiplies `$speed` by `$sprint`.
     */
    public const function step(bool $sprinting) : float32
    {
        if ($sprinting) {
            return $this->speed * $this->sprint;
        }

        return $this->speed;
    }

    /**
     * Yaw about world up then pitch about local right.
     * No roll, no clamp.
     */
    public function aim(Transform& $transform) : void
    {
        Quat $yaw = Quat(angleAxis: radians($this->euler->x), Transform::worldUp());
        Quat $pitch = Quat(angleAxis: radians($this->euler->y), Transform::worldRight());
        $transform->orientation = $yaw * $pitch;
    }
}
