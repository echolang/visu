/**
 * A model that follows its entity's `Transform` every frame, interpolated by the render
 * compensation. Culled per instance by the draw-call assembler, not the octree. PHP VISU's
 * `LPDynamicModel`.
 */

namespace visu::components;

use visu::math::Vec4;

public struct DynamicModel
{
    /**
     * Catalog id of the cooked model.
     */
    public string $model;

    /**
     * Multiplies the albedo. Alpha is reserved for a LOD fade.
     */
    public Vec4 $tint;

    /**
     * Per-instance LOD distance multiplier, on top of the model's own and the system's.
     */
    public float32 $lodBias;

    public constructor(string $model)
    {
        $this->model = $model;
        $this->tint = Vec4(1.0f);
        $this->lodBias = 1.0f;
    }
}
