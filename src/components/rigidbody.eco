/**
 * Makes an entity's `Collider` move. A dynamic body is moved by the simulation and the physics
 * system writes its `Transform` each step (pair it with a `DynamicModel`, which follows the
 * transform without being told); a kinematic one is moved by its owner and read each step. Only
 * a root entity can carry one: the system writes a world pose into the local `Transform`.
 */

namespace visu::components;

use visu::physics::BodyKind;

public struct RigidBody
{
    public BodyKind $kind;

    /**
     * Kilograms. Read for a dynamic body only.
     */
    public float32 $mass;

    public float32 $linearDamping;
    public float32 $angularDamping;

    /**
     * Continuous collision for a small fast body that would otherwise step through a thin wall.
     */
    public bool $ccd;

    /**
     * Lock rotation: the body slides and falls but never tips. A crate on a cart, a walker.
     */
    public bool $upright;

    /**
     * Never let the body sleep. It then costs a step and a pose every pass even at rest.
     */
    public bool $alwaysAwake;

    public constructor(BodyKind $kind = BodyKind::dynamic, float32 $mass = 1.0f)
    {
        $this->kind = $kind;
        $this->mass = $mass;
        $this->linearDamping = 0.05f;
        $this->angularDamping = 0.1f;
        $this->ccd = false;
        $this->upright = false;
        $this->alwaysAwake = false;
    }
}
