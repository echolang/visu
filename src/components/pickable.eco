/**
 * Something a click, a key or a placement check can find: a world box, the pick layers it is
 * on (`PICK_*`, app bits from `PICK_APP`) and a free tag for the owner. The owner keeps the box
 * current and reports `Entities.changed<Pickable>`; `PickSystem` indexes it, so a query costs
 * the log of the population plus what it finds, never a walk over every pickable.
 */

namespace visu::components;

use visu::geo::AABB;

/**
 * Layers visu knows; a game's own start at `PICK_APP`.
 */
public const uint32 PICK_DEFAULT = 1;
public const uint32 PICK_APP = 256;

/**
 * Every layer: a query that takes whatever it meets.
 */
public const uint32 PICK_ALL = 0xFFFFFFFF;

public struct Pickable
{
    public AABB $box;
    public uint32 $layers;
    public int32 $tag;

    public constructor(const AABB& $box, uint32 $layers = PICK_DEFAULT, int32 $tag = 0)
    {
        $this->box = $box;
        $this->layers = $layers;
        $this->tag = $tag;
    }
}
