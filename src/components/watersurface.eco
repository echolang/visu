/**
 * A flat water surface on an entity. The plane and the quad come from the entity `Transform`:
 * local up is the normal, local XZ from -0.5 to 0.5 is the quad, and scale is the size in metres.
 * `mesh` is the hook a later lake or river sets. Null draws the unit quad.
 * `flow` only scrolls the ripple. Motion, later, writes it and displaces vertices.
 */

namespace visu::components;

use visu::graphics::Mesh;
use visu::math::{Vec2, Vec3};

public struct WaterSurface
{
    /**
     * Beer coefficients, one per channel. Red higher than blue reads as teal.
     */
    public Vec3 $absorption;

    /**
     * How fast the bed disappears, per metre.
     */
    public float32 $density;

    /**
     * Colour the water body scatters back, as an albedo: what deep water looks like whatever
     * lies under it. Lit by the same sun, moon and sky as the surface.
     */
    public Vec3 $scatter;

    /**
     * How fast the body colour takes over from the bed, per metre. Zero is perfectly clear
     * water: the bed alone, only tinted by `absorption`.
     */
    public float32 $turbidity;

    /**
     * GGX roughness. Low keeps the mirror readable.
     */
    public float32 $roughness;

    /**
     * Wavelength of the main ripple, in metres.
     */
    public float32 $rippleScale;

    /**
     * Ripple scroll, cycles per second.
     */
    public float32 $rippleSpeed;

    /**
     * Slope of the main ripple. Zero is a flat mirror.
     */
    public float32 $normalStrength;

    /**
     * Ripple direction in local XZ. Not a current.
     */
    public Vec2 $flow;

    /**
     * How far refraction and the mirror sample slide, in screen uv.
     */
    public float32 $distortion;

    /**
     * Mirror cull radius in metres. The reflected far plane is this distance.
     */
    public float32 $radius;

    /**
     * Discard the quad outside a unit circle, for a round basin.
     */
    public bool $round;

    /**
     * Replacement for the unit quad. Same position and uv layout. Null uses the quad.
     */
    public Mesh? $mesh;

    public constructor()
    {
        $this->absorption = Vec3(0.45f, 0.14f, 0.08f);
        $this->density = 0.55f;
        $this->scatter = Vec3(0.03f, 0.2f, 0.24f);
        $this->turbidity = 1.1f;
        $this->roughness = 0.08f;
        $this->rippleScale = 1.6f;
        $this->rippleSpeed = 0.08f;
        $this->normalStrength = 0.12f;
        $this->flow = Vec2(0.8f, 0.35f);
        $this->distortion = 0.012f;
        $this->radius = 40.0f;
        $this->round = false;
        $this->mesh = null;
    }
}
