/**
 * A volume that collides with nothing but answers queries: a ray with its layer in the mask
 * meets it, an overlap finds it. Separate from `Collider`, so one entity can be solid in one
 * shape and pickable or watched in a larger one. Static: it follows `changed<Transform>`.
 */

namespace visu::components;

use visu::math::Vec3;
use visu::physics::{ColliderShape, PhysicsLayer};

public struct Sensor
{
    public ColliderShape $shape;

    /**
     * Where the shape's centre sits in the entity's local space, before its scale.
     */
    public Vec3 $offset;

    public PhysicsLayer $layer;

    /**
     * The layers whose bodies the sensor reports touching. Null is its own layer only: a volume
     * that answers queries and pairs with nothing, so it costs no step at all.
     */
    public PhysicsLayer? $mask;

    public constructor(
        ColliderShape $shape,
        offset: Vec3 $offset = Vec3(0.0f, 0.0f, 0.0f),
        layer: PhysicsLayer $layer = PhysicsLayer::sensor(),
        mask: PhysicsLayer? $mask = null
    )
    {
        $this->shape = $shape;
        $this->offset = $offset;
        $this->layer = $layer;
        $this->mask = $mask;
    }
}
