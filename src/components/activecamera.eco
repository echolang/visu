/**
 * Marker on the camera entity `CameraSystem` publishes this frame.
 * Controllers join on it so they do not take a system handle.
 * `activateCamera` detaches any other marker first; attach without it is not exclusive.
 */

namespace visu::components;

use visu::ecs::{Entities, Entity};

public struct ActiveCamera
{
    /**
     * Game-loop tick when this camera became active. Zero if activated before the first update.
     */
    public int32 $tick = 0;
}

/**
 * Make `$entity` the only `ActiveCamera`.
 * Detach every other marker, then attach this one with `$tick`.
 * Not a method on `ActiveCamera`: a static that calls `ids`/`detach` of Self does not land on the type (echoc 4096).
 */
public function activateCamera(Entities $world, Entity $entity, int32 $tick = 0) : void
{
    array<Entity> $held = $world->ids<ActiveCamera>();
    foreach ($held as $e) {
        if ($e != $entity) {
            $world->detach<ActiveCamera>($e);
        }
    }

    $world->attach($entity, ActiveCamera($tick));
}
