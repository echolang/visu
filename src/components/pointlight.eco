/**
 * A colored lamp on an entity. World position is the entity transform times
 * `$offset`. Radius or intensity at or below zero contributes nothing.
 * `PointLightSystem` packs the ones the camera can see.
 */

namespace visu::components;

use visu::math::Vec3;

public struct PointLight
{
    /**
     * Linear rgb.
     */
    public Vec3 $color;
    public float32 $intensity;
    public float32 $radius;

    /**
     * Flame radius in metres. Specular uses a point on this sphere.
     */
    public float32 $sourceRadius;

    /**
     * Local offset from the entity origin to the flame.
     */
    public Vec3 $offset;
    public bool $castShadow;

    /**
     * Flame flicker on the clustered path: the intensity swings this far either side of
     * `intensity` at `flickerSpeed` radians a second, evaluated on the GPU. The light's
     * position, and so its shadow, never moves with it. Zero is a steady light.
     */
    public float32 $flicker = 0.0f;
    public float32 $flickerSpeed = 0.0f;
}
