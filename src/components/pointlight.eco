/**
 * A colored lamp on an entity. World position is the entity transform times
 * `$offset`. Radius or intensity at or below zero contributes nothing: its table row goes dark,
 * so it is culled, shades nothing and takes no shadow pages. With a `direction` it is a spot.
 * `PointLightSystem` keeps a row for each, and follows the ones riding something that moves.
 */

namespace visu::components;

use visu::math::Vec3;

public struct PointLight
{
    /**
     * Linear rgb.
     */
    public Vec3 $color;
    public float32 $intensity;
    public float32 $radius;

    /**
     * Flame radius in metres. Specular uses a point on this sphere.
     */
    public float32 $sourceRadius;

    /**
     * Local offset from the entity origin to the flame.
     */
    public Vec3 $offset;
    public bool $castShadow;

    /**
     * Flame flicker on the clustered path: the intensity swings this far either side of
     * `intensity` at `flickerSpeed` radians a second, evaluated on the GPU. The light's
     * position, and so its shadow, never moves with it. Zero is a steady light.
     */
    public float32 $flicker = 0.0f;
    public float32 $flickerSpeed = 0.0f;

    /**
     * A spot's axis in the entity's frame; zero is a light that shines every way. The spot is
     * full inside `innerAngle` of the axis and dark past `outerAngle` (half-angles, radians),
     * and its shadow takes pages only where the cone reaches.
     */
    public Vec3 $direction = Vec3(0.0f, 0.0f, 0.0f);
    public float32 $innerAngle = 0.0f;
    public float32 $outerAngle = 0.0f;
}
