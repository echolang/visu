/**
 * A solid shape on an entity. Alone it is static scenery; with a `RigidBody` it moves. The
 * physics system builds the body when this is attached, re-places it when the entity reports
 * `changed<Transform>`, rebuilds it on `changed<Collider>` and drops it on detach. Holds no
 * backend handle, so a copy is only data.
 */

namespace visu::components;

use visu::math::Vec3;
use visu::physics::{ColliderShape, PhysicsLayer};

public struct Collider
{
    public ColliderShape $shape;

    /**
     * Where the shape's centre sits in the entity's local space, before its scale. A box that
     * stands on the entity's origin is offset by half its height.
     */
    public Vec3 $offset;

    /**
     * The layer the body sits in. Null picks one from the body: `world` for a static collider,
     * `dynamic` or `kinematic` for a rigid body.
     */
    public PhysicsLayer? $layer;

    /**
     * The layers this body collides with.
     */
    public PhysicsLayer $mask;

    public float32 $friction;
    public float32 $restitution;

    /**
     * How well a tyre holds on this surface, 1 for the ground a vehicle's tyre curves were drawn
     * for. A wheel ray that lands here hands it to the tyre solve (`PhysicsHit.grip`).
     */
    public float32 $grip;

    public constructor(
        ColliderShape $shape,
        offset: Vec3 $offset = Vec3(0.0f, 0.0f, 0.0f),
        layer: PhysicsLayer? $layer = null,
        mask: PhysicsLayer $mask = PhysicsLayer::all()
    )
    {
        $this->shape = $shape;
        $this->offset = $offset;
        $this->layer = $layer;
        $this->mask = $mask;
        $this->friction = 0.5f;
        $this->restitution = 0.0f;
        $this->grip = 1.0f;
    }
}
