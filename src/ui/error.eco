/**
 * Recoverable FlyUI failures.
 * Layout / stack misuse is an assert.
 */

namespace visu::ui;

use visu::graphics::ShaderError;
use visu::vg::VgError;

public enum UiError
{
    case vg(VgError $inner);
    case shader(ShaderError $inner);

    public const function message() : string
    {
        return match ($this) {
            .vg($inner) => $inner->message(),
            .shader($inner) => $inner->message(),
        };
    }
}
