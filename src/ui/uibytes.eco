/**
 * SPIR-V / MSL bytes for the baked ui program.
 */

namespace visu::ui;

#[if: os == darwin && !VISU_BACKEND_VULKAN]
internal function uiVertexBytes() : string
{
    return uiVertexSource();
}

internal function uiFragmentBytes() : string
{
    return uiFragmentSource();
}
#[else]
internal function uiVertexBytes() : string
{
    return visu::graphics::hexBytes(uiVertexSpvHex());
}

internal function uiFragmentBytes() : string
{
    return visu::graphics::hexBytes(uiFragmentSpvHex());
}
#[end]
