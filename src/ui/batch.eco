/**
 * Packed UI mesh: SDF boxes and atlas glyphs with vertex colour so mixed-colour chrome is a handful of draws.
 */

namespace visu::ui;

use visu::graphics::{
    Device, GpuPass, IndexType, Raster, RenderEncoder, ResourceState,
    Sampler, SamplerDesc, TransientSlice, ShaderProgram, Texture, TextureDesc,
    VertexBuilder, VertexLayout
};
use visu::math::{Vec2, Vec4};
use visu::vg::{Canvas, Color, Font};

internal struct UiVertex
{
    public Vec2 $pos;
    public Vec2 $uv;
    public Vec4 $shape;
    public Vec4 $color;
    public Vec4 $clip;
    /**
     * Source rect (u, v, w, h) a tiled quad wraps inside. Zero for every other shape.
     */
    public Vec4 $region;
}

internal struct UiFrag
{
    public Vec4 $view = Vec4(0.0f);
}

internal struct UiDraw
{
    public int32 $first;
    public int32 $count;
    public Texture? $texture;
    public bool $nearest = false;
}

internal class UiBatch
{
    public array<UiVertex> $verts;
    public array<uint32> $indices;
    public array<UiDraw> $draws;
    internal int32 $runFirst;
    internal Texture? $runTex;
    internal bool $runNearest;
    /**
     * Opacity applied to every quad; below 1 while a disabled node emits.
     */
    internal float32 $fade = 1.0f;

    public constructor()
    {
        $this->verts = array<UiVertex>();
        $this->indices = array<uint32>();
        $this->draws = array<UiDraw>();
        $this->runFirst = 0;
        $this->runTex = null;
        $this->runNearest = false;
        $this->fade = 1.0f;
    }

    public function clear() : void
    {
        $this->verts->clear();
        $this->indices->clear();
        $this->draws->clear();
        $this->runFirst = 0;
        $this->runTex = null;
        $this->runNearest = false;
    }
}

internal function emitBox(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    float32 $r,
    Color $color,
    Vec4 $clip,
    float32 $pad
) : void
{
    emitShapedBox($b, $pos, $size, $r, $color, $clip, $pad, 1.0f);
}

internal function emitStrokeBox(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    float32 $r,
    Color $color,
    Vec4 $clip,
    float32 $pad
) : void
{
    emitShapedBox($b, $pos, $size, $r, $color, $clip, $pad + 1.0f, 3.0f);
}

internal function emitShapedBox(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    float32 $r,
    Color $color,
    Vec4 $clip,
    float32 $pad,
    float32 $kind
) : void
{
    if ($size->x <= 0.0f || $size->y <= 0.0f || $color->a <= 0.0f) {
        return;
    }

    float32 $rr = $r;
    float32 $lim = $size->x;

    if ($size->y < $lim) {
        $lim = $size->y;
    }

    $lim = $lim * 0.5f;

    if ($rr > $lim) {
        $rr = $lim;
    }

    if ($rr < 0.0f) {
        $rr = 0.0f;
    }

    float32 $x0 = $pos->x - $pad;
    float32 $y0 = $pos->y - $pad;
    float32 $x1 = $pos->x + $size->x + $pad;
    float32 $y1 = $pos->y + $size->y + $pad;
    float32 $cx = $pos->x + $size->x * 0.5f;
    float32 $cy = $pos->y + $size->y * 0.5f;
    Vec4 $shape = Vec4($size->x * 0.5f, $size->y * 0.5f, $rr, $kind);
    Vec4 $col = $color->premultiplied();
    pushQuad(
        $b,
        Vec2($x0, $y0),
        Vec2($x1, $y0),
        Vec2($x1, $y1),
        Vec2($x0, $y1),
        Vec2($x0 - $cx, $y0 - $cy),
        Vec2($x1 - $cx, $y0 - $cy),
        Vec2($x1 - $cx, $y1 - $cy),
        Vec2($x0 - $cx, $y1 - $cy),
        $shape,
        $col,
        $clip
    );
}

internal function emitImageQuad(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    Vec2 $uv0,
    Vec2 $uv1,
    Color $tint,
    Vec4 $clip
) : void
{
    emitTexturedQuad($b, $pos, $size, $uv0, $uv1, 4.0f, $tint, $clip, Vec4(0.0f));
}

/**
 * One quad that repeats a source rect. `$tiles` is how many copies fit along each axis; the
 * shader wraps inside `$region`, so any box is still four vertices.
 */
internal function emitTiledQuad(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    Vec2 $tiles,
    Vec4 $region,
    Color $tint,
    Vec4 $clip
) : void
{
    emitTexturedQuad($b, $pos, $size, Vec2(0.0f), $tiles, 5.0f, $tint, $clip, $region);
}

/**
 * Axis-aligned textured quad from `$uv0` (top-left) to `$uv1`; `$shape` is the shader's
 * sampling mode (4 plain image, 5 tiled inside `$region`).
 */
internal function emitTexturedQuad(
    UiBatch $b,
    Vec2 $pos,
    Vec2 $size,
    Vec2 $uv0,
    Vec2 $uv1,
    float32 $shape,
    Color $tint,
    Vec4 $clip,
    Vec4 $region
) : void
{
    if ($size->x <= 0.0f || $size->y <= 0.0f || $tint->a <= 0.0f) {
        return;
    }

    float32 $x0 = $pos->x;
    float32 $y0 = $pos->y;
    float32 $x1 = $pos->x + $size->x;
    float32 $y1 = $pos->y + $size->y;
    pushQuad(
        $b,
        Vec2($x0, $y0),
        Vec2($x1, $y0),
        Vec2($x1, $y1),
        Vec2($x0, $y1),
        $uv0,
        Vec2($uv1->x, $uv0->y),
        $uv1,
        Vec2($uv0->x, $uv1->y),
        Vec4(0.0f, 0.0f, 0.0f, $shape),
        $tint->premultiplied(),
        $clip,
        $region
    );
}

internal function emitGlyph(
    UiBatch $b,
    float32 $x0,
    float32 $y0,
    float32 $x1,
    float32 $y1,
    float32 $u0,
    float32 $v0,
    float32 $u1,
    float32 $v1,
    Vec4 $color,
    Vec4 $clip
) : void
{
    Vec4 $shape = Vec4(0.0f, 0.0f, 0.0f, 2.0f);
    pushQuad(
        $b,
        Vec2($x0, $y0),
        Vec2($x1, $y0),
        Vec2($x1, $y1),
        Vec2($x0, $y1),
        Vec2($u0, $v0),
        Vec2($u1, $v0),
        Vec2($u1, $v1),
        Vec2($u0, $v1),
        $shape,
        $color,
        $clip
    );
}

internal function pushQuad(
    UiBatch $b,
    Vec2 $p0,
    Vec2 $p1,
    Vec2 $p2,
    Vec2 $p3,
    Vec2 $t0,
    Vec2 $t1,
    Vec2 $t2,
    Vec2 $t3,
    Vec4 $shape,
    Vec4 $color,
    Vec4 $clip,
    Vec4 $region = Vec4(0.0f)
) : void
{
    uint32 $base = $b->verts->count() as uint32;

    if ($b->fade < 1.0f) {
        // colours are premultiplied, so fading scales all four
        $color = $color * $b->fade;
    }

    $b->verts[] = UiVertex($p0, $t0, $shape, $color, $clip, $region);
    $b->verts[] = UiVertex($p1, $t1, $shape, $color, $clip, $region);
    $b->verts[] = UiVertex($p2, $t2, $shape, $color, $clip, $region);
    $b->verts[] = UiVertex($p3, $t3, $shape, $color, $clip, $region);
    $b->indices[] = $base;
    $b->indices[] = ($base + 1) as uint32;
    $b->indices[] = ($base + 2) as uint32;
    $b->indices[] = $base;
    $b->indices[] = ($base + 2) as uint32;
    $b->indices[] = ($base + 3) as uint32;
}

internal function closeDraw(UiBatch $b, int32 $first, Texture? $tex, bool $nearest = false) : void
{
    int32 $count = ($b->indices->count() as int32) - $first;

    if ($count <= 0) {
        return;
    }

    $b->draws[] = UiDraw($first, $count, $tex, $nearest);
}

/**
 * Open a run. SDF boxes never sample, so until a quad binds a texture the run takes
 * whichever texture comes next and a flat box costs no draw split.
 */
internal function beginRun(UiBatch $b) : void
{
    $b->runFirst = $b->indices->count() as int32;
    $b->runTex = null;
    $b->runNearest = false;
}

internal function bindAtlas(UiBatch $b, Texture? $tex, bool $nearest = false) : void
{
    if ($tex == null) {
        return;
    }

    if ($b->runTex != null && ($tex != $b->runTex || $nearest != $b->runNearest)) {
        closeDraw($b, $b->runFirst, $b->runTex, $b->runNearest);
        $b->runFirst = $b->indices->count() as int32;
    }

    $b->runTex = $tex;
    $b->runNearest = $nearest;
}

internal function endRun(UiBatch $b) : void
{
    closeDraw($b, $b->runFirst, $b->runTex, $b->runNearest);
    $b->runTex = null;
    $b->runNearest = false;
}

internal class UiGpu
{
    public ShaderProgram $program;
    public GpuPass $pass;
    public Texture $white;
    public Sampler $sampler;
    public Sampler $nearest;
    public Canvas $canvas;
    public Font $regular;
    public Font $semibold;

    public constructor(
        ShaderProgram $program,
        GpuPass $pass,
        Texture $white,
        Sampler $sampler,
        Sampler $nearest,
        Canvas $canvas,
        Font $regular,
        Font $semibold
    )
    {
        $this->program = $program;
        $this->pass = $pass;
        $this->white = $white;
        $this->sampler = $sampler;
        $this->nearest = $nearest;
        $this->canvas = $canvas;
        $this->regular = $regular;
        $this->semibold = $semibold;
    }

    public function destroy() : void
    {
        $this->canvas->destroy();
        $this->program->destroy();
        $this->white->destroy();
    }
}

internal function uiMakeGpu(
    Device $device,
    Canvas $canvas,
    Font $regular,
    Font $semibold
) : result<UiGpu, UiError>
{
    ShaderProgram $prog = guard visu::graphics::bakedProgram(
        $device,
        'ui',
        function(string $name, visu::graphics::ShaderKind $kind) : string? {
            return uiBytes($name, $kind);
        },
        label: 'ui'
    ) else ($e) {
        return .error(.shader($e));
    }
    Raster $raster = Raster();
    $raster->blend = .premultiplied;
    $raster->depthTest = false;
    $raster->depthWrite = false;
    GpuPass $pass = GpuPass($prog, VertexLayout::of<UiVertex>(function(VertexBuilder $b) : void {
        ptr<UiVertex> $v = $b->vertex<UiVertex>();
        $b->attr(0, &$v->pos);
        $b->attr(1, &$v->uv);
        $b->attr(2, &$v->shape);
        $b->attr(3, &$v->color);
        $b->attr(4, &$v->clip);
        $b->attr(5, &$v->region);
    }), $raster);
    TextureDesc $desc = TextureDesc($format: .rgba8, $width: 1, $height: 1);
    Texture $tex = Texture($device, 'ui-white', $desc);
    array<uint8> $px = array<uint8>();
    $px[] = 255;
    $px[] = 255;
    $px[] = 255;
    $px[] = 255;
    $tex->upload(0, $px->data(), 4, 4);
    $device->transitionTexture($tex, ResourceState::shaderRead);
    SamplerDesc $point = SamplerDesc();
    $point->min = .nearest;
    $point->mag = .nearest;
    return .ok(UiGpu(
        $prog,
        $pass,
        $tex,
        $device->createSampler(SamplerDesc()),
        $device->createSampler($point),
        $canvas,
        $regular,
        $semibold,
    ));
}

internal function uiFont(Ui $ui, bool $bold) : Font?
{
    UiGpu $g = guard $ui->gpu else {
        return null;
    }

    if ($bold) {
        return $g->semibold;
    }

    return $g->regular;
}

internal function flushBatch(Ui $ui, RenderEncoder $enc) : void
{
    UiBatch $batch = $ui->batch;

    if ($batch->draws->count() == 0 || $batch->indices->count() == 0) {
        return;
    }

    UiGpu $gpu = guard $ui->gpu else {
        return;
    }
    GpuPass $pass = $gpu->pass;
    $pass->bind($enc);
    Texture $white = $gpu->white;
    Sampler $samp = $gpu->sampler;
    usize $nv = $batch->verts->count();
    usize $ni = $batch->indices->count();
    uint64 $vb = ($nv as uint64) * (mem::size<UiVertex>() as uint64);
    uint64 $ib = ($ni as uint64) * (mem::size<uint32>() as uint64);
    TransientSlice $vs = $ui->device->allocTransient($vb, 16);
    TransientSlice $is = $ui->device->allocTransient($ib, 4);
    mem::copy<UiVertex>(ptr<UiVertex>($vs->data:$), $batch->verts->data(), $nv);
    mem::copy<uint32>(ptr<uint32>($is->data:$), $batch->indices->data(), $ni);
    $enc->setVertexTransient(0, $vs);
    $enc->setIndexTransient($is, .uint32);
    $enc->setViewport(0, 0, $enc->width(), $enc->height());
    UiFrag $frag = UiFrag();
    $frag->view = Vec4($ui->frame->x, $ui->frame->y, 0.0f, 0.0f);
    $enc->upload($frag, slot: 0);
    Texture $bound = $white;
    bool $boundNearest = false;
    $enc->bindTexture(0, $white, $samp);

    foreach ($batch->draws as $draw) {
        if ($draw->count <= 0) {
            continue;
        }

        Texture $tex = $white;
        Texture? $maybe = $draw->texture;

        if ($maybe != null) {
            Texture $callTex = guard $maybe;
            $tex = $callTex;
        }

        if ($tex != $bound || $draw->nearest != $boundNearest) {
            Sampler $use = $samp;

            if ($draw->nearest) {
                $use = $gpu->nearest;
            }

            $enc->bindTexture(0, $tex, $use);
            $bound = $tex;
            $boundNearest = $draw->nearest;
        }

        $enc->drawIndexed($draw->first, $draw->count);
    }
}
