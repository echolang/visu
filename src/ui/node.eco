/**
 * Packed UI node.
 * Widget calls append these; layout walks by index.
 * A borrow into the array is invalid after append.
 */

namespace visu::ui;

use visu::math::Vec2;
use visu::vg::Color;

public const int32 NODE_NONE = -1;

public enum Kind
{
    case layout;
    case text;
    case label;
    case space;
    case button;
    case checkbox;
    case group;
    case select;
    case slider;
    case image;
    case progress;
    case spinner;
    case field;
    case separator;
    case scroll;
    case iconButton;
}

public enum Flow
{
    case vertical;
    case horizontal;
}

public enum Sizing
{
    case fit;
    case fill;
    case fixed;
}

public enum Align
{
    case topLeft;
    case topCenter;
    case topRight;
    case centerLeft;
    case center;
    case centerRight;
    case bottomLeft;
    case bottomCenter;
    case bottomRight;
}

public enum ButtonKind
{
    case primary;
    case secondary;
}

public enum CardKind
{
    case card;
    case panel;
}

/**
 * Config for `Ui.begin`.
 * Field defaults; assign what you need.
 */
public struct Layout
{
    public Flow $flow = .vertical;
    public Sizing $h = .fill;
    public Sizing $v = .fit;
    public Align $align = .topLeft;
    public Edges $pad = Edges();
    public float32 $spacing = 0.0f;
    public float32 $width = 0.0f;
    public float32 $height = 0.0f;
    public Color $bg;
    public float32 $radius = 0.0f;
    /**
     * 9-slice drawn in place of `bg`. The texture is shared, not owned by the layout.
     */
    public NineSlice? $skin = null;
    /**
     * The layout's rect takes the pointer, so clicks and the wheel over a panel's padding or
     * labels never reach the world. Null means solid when the layout paints a `bg` or a `skin`.
     */
    public bool? $solid = null;

    init
    {
        $this->bg = Color::transparent();
    }

    public const function blocks() : bool
    {
        bool? $explicit = $this->solid;

        if ($explicit != null) {
            bool $on = guard $explicit;
            return $on;
        }

        return $this->bg->a > 0.0f || $this->skin != null;
    }
}

public struct Node
{
    public Kind $kind = .layout;
    public int32 $parent = NODE_NONE;
    public int32 $firstChild = NODE_NONE;
    public int32 $lastChild = NODE_NONE;
    public int32 $next = NODE_NONE;
    public int32 $childCount = 0;
    public Flow $flow = .vertical;
    public Sizing $h = .fit;
    public Sizing $v = .fit;
    public Align $align = .topLeft;
    public Edges $pad = Edges();
    public float32 $spacing = 0.0f;
    public float32 $prefW = 0.0f;
    public float32 $prefH = 0.0f;
    public float32 $radius = 0.0f;
    public Color $bg;
    public Vec2 $measured = Vec2(0.0f);
    public Vec2 $size = Vec2(0.0f);
    public Vec2 $pos = Vec2(0.0f);
    public uint64 $id = 0 as uint64;
    public int32 $payload = NODE_NONE;
    /**
     * Index into `Ui.skins` for this frame, or `NODE_NONE`. An index keeps the texture
     * refcount off every node copy.
     */
    public int32 $skin = NODE_NONE;
    /**
     * A layout that takes the pointer (`Layout.blocks`).
     */
    public bool $solid = false;
    /**
     * Pushed inside `beginDisabled(true)`: drawn faded, never clicks.
     */
    public bool $dim = false;

    init
    {
        $this->bg = Color::transparent();
    }
}

internal function interactive(Kind $kind) : bool
{
    return $kind == Kind::button
        || $kind == Kind::checkbox
        || $kind == Kind::group
        || $kind == Kind::select
        || $kind == Kind::slider
        || $kind == Kind::field
        || $kind == Kind::iconButton;
}

internal function appendNode(array<Node>& $nodes, int32 $parent, Node $n) : int32
{
    $n->parent = $parent;
    int32 $i = $nodes->count() as int32;
    $nodes[] = $n;

    if ($parent < 0) {
        return $i;
    }

    Node& $p = $nodes->at($parent as usize);

    if ($p->firstChild < 0) {
        $p->firstChild = $i;
        $p->lastChild = $i;
    } else {
        int32 $last = $p->lastChild;
        $nodes->at($last as usize)->next = $i;
        $p->lastChild = $i;
    }

    $p->childCount = $p->childCount + 1;
    return $i;
}
