/**
 * One cell of an icon atlas: the texture and the sub-rect in texels. Build once at load; an
 * `Icon` copy is a texture refcount bump, never an allocation.
 */

namespace visu::ui;

use visu::graphics::Texture;
use visu::math::{Vec2, Vec4};

public struct Icon
{
    public Texture $texture;
    /**
     * x, y, width, height in texels.
     */
    public Vec4 $rect;
    /**
     * Top-left and bottom-right of `rect` in normalised texture coordinates, derived once when
     * the icon is built so drawing never divides by the texture size.
     */
    public Vec2 $uv0;
    public Vec2 $uv1;

    public constructor(Texture $texture, Vec4 $rect)
    {
        $this->texture = $texture;
        $this->rect = $rect;
        $this->deriveUv();
    }

    /**
     * Cell `$index` of a square-celled atlas, row-major from the top-left.
     */
    public constructor(Texture $texture, cell: int32 $index, size: int32 $size)
    {
        $this->texture = $texture;
        int32 $cols = $texture->desc->width / $size;

        if ($cols < 1) {
            $cols = 1;
        }

        int32 $cx = $index % $cols;
        int32 $cy = $index / $cols;
        $this->rect = Vec4(
            ($cx * $size) as float32,
            ($cy * $size) as float32,
            $size as float32,
            $size as float32
        );
        $this->deriveUv();
    }

    private function deriveUv() : void
    {
        float32 $tw = $this->texture->desc->width as float32;
        float32 $th = $this->texture->desc->height as float32;

        if ($tw < 1.0f || $th < 1.0f) {
            $this->uv0 = Vec2(0.0f);
            $this->uv1 = Vec2(0.0f);
            return;
        }

        $this->uv0 = Vec2($this->rect->x / $tw, $this->rect->y / $th);
        $this->uv1 = Vec2(($this->rect->x + $this->rect->z) / $tw, ($this->rect->y + $this->rect->w) / $th);
    }
}
