/**
 * One labelled option for `select` / `buttonGroup`.
 * Echo has no map literals, so PHP's key => label list is an array of these.
 */

namespace visu::ui;

public struct Choice
{
    public string $id;
    public string $label;

    public constructor(string $id, string $label)
    {
        $this->id = $id;
        $this->label = $label;
    }

    public constructor(string $both)
    {
        $this->id = $both;
        $this->label = $both;
    }
}
