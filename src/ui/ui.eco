/**
 * Immediate-mode FlyUI.
 * Widget calls append a packed node table; endFrame lays out, then last-frame rects feed the next frame's hits.
 * Window-scoped; the app constructs one, like InputHub.
 */

namespace visu::ui;

use visu::graphics::{Device, Pipeline, TargetRef, Texture};
use visu::math::{Vec2, Vec4};
use visu::os::input::{ClaimScope, InputHub, Key};
use visu::vg::{Canvas, Color, Font};

public const string UI_CLAIM = 'flyui';

internal struct FrameInput
{
    public Vec2 $pointer = Vec2(0.0f);
    public bool $leftPressed = false;
    public bool $leftReleased = false;
    public bool $leftDown = false;
    public bool $hovering = false;
    public bool $consumed = false;
    public array<int32> $chars;
    public Vec2 $scroll = Vec2(0.0f);
    public Key? $key = null;

    init
    {
        $this->chars = array<int32>();
    }
}

public class Ui
{
    public Theme $theme;
    internal Device $device;
    internal array<Node> $nodes;
    internal array<TextRun> $texts;
    /**
     * Per-frame bytes for number text (`number`, slider readouts). Cleared, never freed.
     */
    internal string $arena;
    internal array<ButtonRun> $buttons;
    internal array<CheckRun> $checks;
    internal array<ListRun> $lists;
    internal array<GroupRun> $groups;
    /**
     * Per-frame copies of every group's options. Cleared, never freed.
     */
    internal array<Choice> $choicePool;
    internal array<SliderRun> $sliders;
    internal array<ImageRun> $images;
    internal array<IconRun> $iconButtons;
    internal TooltipState $tip;
    /**
     * Open `beginDisabled` scopes, innermost last; `disabledDepth` counts the ones that disable.
     */
    internal array<bool> $disabledStack;
    internal int32 $disabledDepth;
    internal array<NineSlice> $skins;
    internal array<ProgressRun> $bars;
    internal array<FieldRun> $fields;
    internal array<uint64> $focusables;
    internal uint64 $focusId;
    internal Vec4 $clip;
    internal array<int32> $parents;
    internal array<uint64> $ids;
    internal map<uint64, Slot> $slots;
    internal FrameInput $io;
    internal array<int32> $overlays;
    internal array<int32> $animated;
    internal bool $open;
    internal bool $hoverAny;
    internal bool $holdsClaim;
    /**
     * A drag owned the pointer this frame. The claim holds for the whole drag, even once the
     * pointer leaves the widget.
     */
    internal bool $dragging;
    internal Vec2 $frame;
    internal float32 $scale;
    internal float64 $tick;
    internal int32 $stamp;
    internal array<uint64> $stale;
    internal InputHub? $input;
    internal UiBatch $batch;
    internal UiGpu? $gpu;
    /**
     * Stroke every placed node. `--flag ui.outline=true`.
     */
    public bool $outline;
    private bool $dead;

    public constructor(Device $device, InputHub? $input = null)
    {
        $this->device = $device;
        $this->input = $input;
        $this->theme = Theme();
        $this->nodes = array<Node>();
        $this->texts = array<TextRun>();
        $this->arena = '';
        $this->arena->reserve(4096);
        $this->buttons = array<ButtonRun>();
        $this->checks = array<CheckRun>();
        $this->lists = array<ListRun>();
        $this->groups = array<GroupRun>();
        $this->choicePool = array<Choice>();
        $this->choicePool->reserve(256);
        $this->sliders = array<SliderRun>();
        $this->images = array<ImageRun>();
        $this->iconButtons = array<IconRun>();
        $this->tip = TooltipState();
        $this->disabledStack = array<bool>();
        $this->disabledStack->reserve(8);
        $this->disabledDepth = 0;
        $this->skins = array<NineSlice>();
        $this->bars = array<ProgressRun>();
        $this->fields = array<FieldRun>();
        $this->focusables = array<uint64>();
        $this->focusId = 0 as uint64;
        $this->clip = Vec4(0.0f);
        $this->parents = array<int32>();
        $this->ids = array<uint64>();
        $this->slots = map<uint64, Slot>();
        $this->io = FrameInput();
        $this->overlays = array<int32>();
        $this->animated = array<int32>();
        $this->open = false;
        $this->hoverAny = false;
        $this->holdsClaim = false;
        $this->dragging = false;
        $this->frame = Vec2(1.0f);
        $this->scale = 1.0f;
        $this->tick = 0.0;
        $this->stamp = 0;
        $this->stale = array<uint64>();
        $this->dead = false;
        $this->outline = false;
        $this->batch = UiBatch();
        $this->gpu = null;
        $this->nodes->reserve(256);
        $this->skins->reserve(32);
        $this->iconButtons->reserve(32);
        $this->fields->reserve(16);
        $this->focusables->reserve(16);
        $this->batch->verts->reserve(4096);
        $this->batch->indices->reserve(6144);
    }

    destructor()
    {
        $this->destroy();
    }

    public function destroy() : void
    {
        if ($this->dead) {
            return;
        }

        $this->dead = true;
        $this->releaseClaim();
        $this->nodes->clear();
        $this->slots->clear();
        UiGpu? $maybe = $this->gpu;

        if ($maybe != null) {
            UiGpu $g = guard $maybe;
            $g->destroy();
            $this->gpu = null;
        }
    }

    /**
     * Test hook: inject mouse before widget calls.
     */
    public function seed(Vec2 $mouse, bool $pressed, bool $released, bool $down = false) : void
    {
        $this->io->pointer = $mouse;
        $this->io->leftPressed = $pressed;
        $this->io->leftReleased = $released;
        $this->io->leftDown = $down;
        $this->io->hovering = true;
    }

    public function seedChars(array<int32> $chars) : void
    {
        $this->io->chars = $chars;
    }

    public function seedScroll(Vec2 $delta) : void
    {
        $this->io->scroll = $delta;
    }

    public function seedKey(Key $key) : void
    {
        $this->io->key = $key;
    }

    /**
     * True while a dropdown (or anything else that steals keys) is open.
     * Escape must not also close a panel sitting under that widget.
     */
    public const function capturesKeyboard() : bool
    {
        if ($this->focusId != (0 as uint64)) {
            return true;
        }

        foreach ($this->slots as $s) {
            if (selectIsOpen($s)) {
                return true;
            }
        }

        return false;
    }

    /**
     * `$framebuffer` is the scene target in pixels. Layout space is framebuffer / dpi / uiScale.
     * Draw scale is dpi × uiScale. The pointer is window pixels and divides by uiScale only.
     */
    public function beginFrame(Vec2 $framebuffer, float32 $dpi = 1.0f, float32 $uiScale = 1.0f) : void
    {
        assert(!$this->dead, 'ui beginFrame after destroy');

        if ($dpi < 0.0001f) {
            $dpi = 1.0f;
        }

        if ($uiScale < 0.0001f) {
            $uiScale = 1.0f;
        }

        $this->frame = Vec2($framebuffer->x / $dpi / $uiScale, $framebuffer->y / $dpi / $uiScale);
        $this->scale = $dpi * $uiScale;
        $this->outline = visu::app::flags()->bool('ui.outline', false);

        InputHub? $maybe = $this->input;

        if ($maybe != null) {
            InputHub $in = guard $maybe;
            $this->io->pointer = scalePointer($in->pointer(), $uiScale);
            $this->io->leftPressed = $in->hasBeenPressedThisFrame();
            $this->io->leftReleased = $in->hasBeenReleasedThisFrame();
            $this->io->leftDown = $in->pointerDown();
            $this->io->hovering = $in->hovering();
            $this->io->chars = $in->frameChars();
            $this->io->scroll = $in->frameScroll();
            $this->io->key = null;
        } else if ($uiScale != 1.0f) {
            $this->io->pointer = scalePointer($this->io->pointer, $uiScale);
        }

        $this->io->consumed = false;
        $this->stamp = $this->stamp + 1;
        $this->nodes->clear();
        $this->texts->clear();
        $this->arena->clear();
        $this->buttons->clear();
        $this->checks->clear();
        $this->lists->clear();
        $this->groups->clear();
        $this->choicePool->clear();
        $this->sliders->clear();
        $this->images->clear();
        $this->iconButtons->clear();
        $this->tip->seen = false;
        $this->tip->show = false;
        $this->disabledStack->clear();
        $this->disabledDepth = 0;
        $this->skins->clear();
        $this->bars->clear();
        $this->fields->clear();
        $this->focusables->clear();
        $this->clip = Vec4(0.0f);
        $this->parents->clear();
        $this->ids->clear();
        $this->overlays->clear();
        $this->animated->clear();

        Node $root = Node();
        $root->kind = .layout;
        $root->h = .fill;
        $root->v = .fill;
        $root->flow = .vertical;
        appendNode($this->nodes, NODE_NONE, $root);
        $this->parents[] = 0;
        $this->ids[] = 0 as uint64;
        $this->open = true;
        $this->hoverAny = false;
        $this->dragging = false;
    }

    public function endFrame() : void
    {
        assert($this->open, 'ui endFrame without beginFrame');
        assert($this->parents->count() == 1, 'ui endFrame with unclosed begin');
        assert($this->disabledStack->count() == 0, 'ui endFrame with unclosed beginDisabled');
        layoutTree($this->nodes, $this->frame);
        applyScroll($this);
        writeRects($this);
        advanceFocus($this);
        float64 $now = visu::runtime::seconds();
        float32 $dt = 1.0f / 60.0f;

        if ($this->tick > 0.0) {
            $dt = ($now - $this->tick) as float32;

            if ($dt < 0.0f) {
                $dt = 0.0f;
            }

            if ($dt > 0.1f) {
                $dt = 0.1f;
            }
        }

        $this->tick = $now;
        animatePills($this, $dt);
        placeTooltip($this);
        dropUnseen($this->slots, $this->stamp, $this->stale);
        $this->claimHover();
        $this->open = false;
        $this->io->chars->clear();
        $this->io->scroll = Vec2(0.0f);
        $this->io->key = null;
    }

    public function load(string $fontDir) : status<UiError>
    {
        assert(!$this->dead, 'ui load after destroy');
        UiGpu? $prev = $this->gpu;

        if ($prev != null) {
            UiGpu $old = guard $prev;
            $old->destroy();
            $this->gpu = null;
        }

        Canvas $vg = Canvas($this->device);
        guard $vg->load() else ($e) {
            $vg->destroy();
            return .error(.vg($e));
        }
        string $ds = std::env::DS;
        Theme $t = $this->theme;
        Font $regular = guard $vg->createFont($t->regularFont, "{$fontDir}{$ds}Inter-Regular.ttf") else ($e) {
            $vg->destroy();
            return .error(.vg($e));
        }
        Font $semibold = guard $vg->createFont($t->semiBoldFont, "{$fontDir}{$ds}Inter-SemiBold.ttf") else ($e) {
            $vg->destroy();
            return .error(.vg($e));
        }
        guard $vg->createFont($t->monospaceFont, "{$fontDir}{$ds}Inconsolata-Regular.ttf") else ($e) {
            $vg->destroy();
            return .error(.vg($e));
        }
        UiGpu $gpu = guard uiMakeGpu($this->device, $vg, $regular, $semibold) else ($e) {
            $vg->destroy();
            return .error($e);
        }
        $this->gpu = $gpu;
        // new fonts measure differently
        $this->tip->measuredScale = 0.0f;
        return .ok;
    }

    public function pass(Pipeline $pipeline, TargetRef $target) : void
    {
        $pipeline->add(UiPass($this, $target));
    }

    public function begin(Layout $layout = Layout()) : void
    {
        assert($this->open, 'ui begin outside frame');
        Node $n = Node();
        $n->kind = .layout;
        $n->flow = $layout->flow;
        $n->h = $layout->h;
        $n->v = $layout->v;
        $n->align = $layout->align;
        $n->pad = $layout->pad;
        $n->spacing = $layout->spacing;
        $n->prefW = $layout->width;
        $n->prefH = $layout->height;
        $n->radius = $layout->radius;
        $n->bg = $layout->bg;
        $n->solid = $layout->blocks();

        if ($layout->skin != null) {
            NineSlice $skin = guard $layout->skin;
            $n->skin = $this->skins->count() as int32;
            $this->skins[] = $skin;
        }

        if ($layout->width > 0.0f) {
            $n->h = .fixed;
        }

        if ($layout->height > 0.0f) {
            $n->v = .fixed;
        }

        int32 $parent = $this->peekParent();
        int32 $i = $this->push($n);
        int32 $sib = $this->nodes[$parent as usize]->childCount;
        $this->parents[] = $i;
        uint64 $pid = $this->peekId();
        $this->ids[] = layoutId($pid, $sib);
    }

    public function beginRow(float32? $spacing = null) : void
    {
        Layout $l = Layout();
        $l->flow = .horizontal;
        $l->h = .fit;
        $l->v = .fit;
        $l->spacing = $spacing ?? $this->theme->spacing;
        $this->begin($l);
    }

    public function beginColumn(float32? $spacing = null) : void
    {
        Layout $l = Layout();
        $l->flow = .vertical;
        $l->h = .fill;
        $l->v = .fit;
        $l->spacing = $spacing ?? $this->theme->spacing;
        $this->begin($l);
    }

    public function beginCard(float32 $width = 0.0f, style: CardKind $style = .card) : void
    {
        CardStyle $st = $this->theme->card;
        if ($style == CardKind::panel) {
            $st = $this->theme->panel;
        }

        Layout $l = Layout();
        $l->flow = .vertical;
        $l->h = .fit;
        $l->v = .fit;
        $l->pad = $st->pad;
        $l->spacing = $st->spacing;
        $l->bg = $st->bg;
        $l->radius = $st->radius;
        $l->skin = $st->skin;
        $l->width = $width;
        $this->begin($l);
    }

    public function beginSection(string $title) : void
    {
        Theme $t = $this->theme;
        Layout $l = Layout();
        $l->flow = .vertical;
        $l->h = .fill;
        $l->v = .fit;
        $l->spacing = $t->sectionSpacing;
        $l->pad = Edges(0.0f, 0.0f, 0.0f, $t->sectionBottomSpace);
        $this->begin($l);
        // upper case is drawn per glyph, so the title is never copied
        $this->pushText(
            TextRun($title, $t->sectionHeaderFontSize, $t->sectionHeaderTextColor, true, $upper: true)
        );
    }

    public function end() : void
    {
        assert($this->open, 'ui end outside frame');
        assert($this->parents->count() > 1, 'ui end of root');
        usize $n = $this->parents->count();
        $this->parents->truncate($n - 1);
        $this->ids->truncate($this->ids->count() - 1);
    }

    public function space(float32 $w = 0.0f, float32 $h = 0.0f) : void
    {
        Node $n = Node();
        $n->kind = .space;
        $n->measured = Vec2($w, $h);
        $this->push($n);
    }

    /**
     * One child that takes leftover space on the parent's flow axis.
     */
    public function spacer() : void
    {
        Node $n = Node();
        $n->kind = .space;
        int32 $parent = $this->peekParent();
        Node $p = $this->nodes[$parent as usize];

        if ($p->flow == Flow::horizontal) {
            $n->h = .fill;
        } else {
            $n->v = .fill;
        }

        $this->push($n);
    }

    public function beginSettingRow(string $label) : void
    {
        Layout $l = Layout();
        $l->flow = .horizontal;
        $l->h = .fill;
        $l->v = .fit;
        $l->align = Align::center;
        $l->spacing = $this->theme->spacing;
        $this->begin($l);
        $this->label($label);
        $this->spacer();
    }

    public function endSettingRow() : void
    {
        $this->end();
    }

    public function text(
        string $s,
        size: float32 $size = 0.0f,
        color: Color? $color = null,
        bold: bool $bold = false
    ) : void
    {
        float32 $sz = $size;

        if ($sz <= 0.0f) {
            $sz = $this->theme->fontSize;
        }

        $this->pushText(TextRun($s, $sz, $color ?? $this->theme->textColor, $bold));
    }

    /**
     * A number as text, `$decimals` after the point, then `$unit` verbatim (`' m'`). Formats
     * into the frame arena: no string per call, so a live readout costs nothing on the heap.
     */
    public function number(
        float32 $v,
        decimals: int32 $decimals = 0,
        unit: string $unit = '',
        size: float32 $size = 0.0f,
        color: Color? $color = null,
        bold: bool $bold = false
    ) : void
    {
        float32 $sz = $size;

        if ($sz <= 0.0f) {
            $sz = $this->theme->fontSize;
        }

        usize $from = $this->arena->size();
        appendFixed($this->arena, $v, $decimals);
        $this->arena->append($unit);
        $this->pushText(
            TextRun('', $sz, $color ?? $this->theme->textColor, $bold, true, $from, $this->arena->size())
        );
    }

    public function label(string $s) : void
    {
        Theme $t = $this->theme;
        int32 $p = $this->texts->count() as int32;
        $this->texts[] = TextRun($s, $t->labelFontSize, $t->labelTextColor, true);
        Node $n = Node();
        $n->kind = .label;
        $n->payload = $p;
        Vec2 $ts = $this->measureText($s, $t->labelFontSize, true);
        $n->measured = Vec2($ts->x, $t->labelHeight);
        $this->push($n);
    }

    public function button(
        string $label,
        id: string $id = '',
        fill: bool $fill = false,
        style: ButtonKind $kind = .primary
    ) : bool
    {
        return uiButton($this, $label, $id, $fill, $kind);
    }

    /**
     * Square atlas icon button. `$selected` draws the tool-strip active state; `$size` 0 uses
     * `theme.iconButton.size`. `$id` is required: an icon has no label to fall back on.
     */
    public function iconButton(
        const Icon& $icon,
        id: string $id,
        selected: bool $selected = false,
        size: float32 $size = 0.0f
    ) : bool
    {
        return uiIconButton($this, $icon, $id, $selected, $size);
    }

    /**
     * Tooltip for the widget just pushed, shown after the pointer rests on it. `$shortcut` draws
     * bold after the text (`'Ctrl+S'`). Pass cached or literal strings.
     */
    public function tooltip(string $text, shortcut: string $shortcut = '') : void
    {
        uiTooltip($this, $text, $shortcut);
    }

    /**
     * Widgets until `endDisabled` draw faded and never click when `$on`. Nests; `false` is a
     * no-op scope so call sites stay balanced.
     */
    public function beginDisabled(bool $on = true) : void
    {
        $this->disabledStack[] = $on;

        if ($on) {
            $this->disabledDepth = $this->disabledDepth + 1;
        }
    }

    public function endDisabled() : void
    {
        usize $n = $this->disabledStack->count();
        assert($n > 0, 'ui endDisabled without beginDisabled');
        bool $on = $this->disabledStack[$n - 1];
        $this->disabledStack->truncate($n - 1);

        if ($on) {
            $this->disabledDepth = $this->disabledDepth - 1;
        }
    }

    public function checkbox(string $label, bool& $on, id: string $id = '') : bool
    {
        return uiCheckbox($this, $label, $on, $id);
    }

    public function buttonGroup(
        string $name,
        const array<Choice>& $choices,
        string& $selected,
        id: string $id = ''
    ) : bool
    {
        return uiButtonGroup($this, $name, $choices, $selected, $id, $this->theme->buttonGroup);
    }

    public function tabBar(
        string $name,
        const array<Choice>& $choices,
        string& $selected,
        id: string $id = ''
    ) : bool
    {
        bool $changed = uiButtonGroup($this, $name, $choices, $selected, $id, $this->theme->tabBar);
        usize $n = $this->nodes->count();
        $this->nodes->at($n - 1)->h = Sizing::fill;
        return $changed;
    }

    /**
     * `$readout` draws the value right of the label with that many decimals (-1 hides it),
     * then `$unit`. `$fill` stretches the track across the parent instead of the theme width.
     */
    public function slider(
        string $label,
        float32& $value,
        min: float32 $min,
        max: float32 $max,
        step: float32 $step = 0.0f,
        id: string $id = '',
        readout: int32 $readout = -1,
        unit: string $unit = '',
        fill: bool $fill = false
    ) : bool
    {
        return uiSlider($this, $label, $value, $min, $max, $step, $id, $readout, $unit, $fill);
    }

    public function slider(
        string $label,
        int32& $value,
        min: int32 $min,
        max: int32 $max,
        id: string $id = '',
        readout: bool $readout = false,
        unit: string $unit = '',
        fill: bool $fill = false
    ) : bool
    {
        int32 $cur = $value;
        float32 $f = $cur as float32;
        int32 $digits = -1;

        if ($readout) {
            $digits = 0;
        }

        bool $changed = uiSlider(
            $this, $label, $f, $min as float32, $max as float32, 1.0f, $id, $digits, $unit, $fill
        );
        int32 $n = std::math::round($f as float64) as int32;
        if ($n != $value) {
            $value = $n;
            return true;
        }

        return $changed;
    }

    /**
     * `$decimals` is how an idle field shows the value; typing edits the raw text.
     */
    public function numberField(
        string $label,
        float32& $value,
        id: string $id = '',
        decimals: int32 $decimals = 2
    ) : bool
    {
        return uiNumberField($this, $label, $value, $id, $decimals);
    }

    public function textField(string $label, string& $value, id: string $id = '') : bool
    {
        return uiTextField($this, $label, $value, $id);
    }

    public function beginModal(string $title, bool& $open) : bool
    {
        return uiBeginModal($this, $title, $open);
    }

    public function endModal() : void
    {
        uiEndModal($this);
    }

    public function beginScroll(float32 $maxHeight, id: string $id = '') : void
    {
        uiBeginScroll($this, $maxHeight, $id);
    }

    public function endScroll() : void
    {
        uiEndScroll($this);
    }

    public function separator() : void
    {
        uiSeparator($this);
    }

    public function select(
        string $name,
        const array<Choice>& $choices,
        string& $selected,
        id: string $id = ''
    ) : bool
    {
        return uiSelect($this, $name, $choices, $selected, $id);
    }

    /**
     * Textured rect. `$height` 0 uses the texture aspect; a missing texture still occupies the box.
     * `$border` paints a filled frame around the image.
     */
    public function image(
        Texture? $tex,
        float32 $width,
        float32 $height = 0.0f,
        border: Color? $border = null,
        radius: float32 $radius = 0.0f
    ) : void
    {
        uiImage($this, $tex, $width, $height, $border, $radius);
    }

    /**
     * Read-only bar. `$value` is 0..1.
     */
    public function progress(float32 $value, id: string $id = '') : void
    {
        uiProgress($this, $value, $id);
    }

    /**
     * Dot-ring spinner. Phase comes from `seconds()`, no per-node state.
     */
    public function spinner(id: string $id = '') : void
    {
        uiSpinner($this, $id);
    }

    internal function tessellate() : void
    {
        emitUi($this);
    }

    internal function flush(visu::graphics::RenderEncoder $enc) : void
    {
        flushBatch($this, $enc);
    }

    internal function sync() : void
    {
        UiGpu $g = guard $this->gpu else {
            return;
        }
        $g->canvas->sync();
    }

    internal function push(Node $n) : int32
    {
        if ($this->disabledDepth > 0) {
            $n->dim = true;
        }

        return appendNode($this->nodes, $this->peekParent(), $n);
    }

    /**
     * Push a `.text` node for `$run`, measured over its own bytes or its arena range.
     */
    private function pushText(mv TextRun $run) : void
    {
        Node $n = Node();
        $n->kind = .text;
        $n->payload = $this->texts->count() as int32;

        if ($run->arena) {
            $n->measured = $this->measureTextRange($this->arena, $run->from, $run->to, $run->size, $run->bold);
        } else {
            $n->measured = $this->measureTextRange(
                $run->text, 0, $run->text->size(), $run->size, $run->bold, upper: $run->upper
            );
        }

        $this->texts[] = mv $run;
        $this->push($n);
    }

    internal function peekParent() : int32
    {
        usize $n = $this->parents->count();
        assert($n > 0, 'ui parent stack empty');
        return $this->parents[$n - 1];
    }

    internal function peekId() : uint64
    {
        usize $n = $this->ids->count();
        assert($n > 0, 'ui id stack empty');
        return $this->ids[$n - 1];
    }

    internal function makeId(const string& $explicit, const string& $fallback) : uint64
    {
        string $label = $explicit;

        if ($label->empty()) {
            $label = $fallback;
        }

        assert(!$label->empty(), 'ui widget id empty');
        uint64 $id = mixId($this->peekId(), $label);
        touchSlot($this->slots, $id, $this->stamp);
        return $id;
    }

    internal function click(uint64 $id) : bool
    {
        if ($this->io->consumed || $this->disabledDepth > 0) {
            return false;
        }

        touchSlot($this->slots, $id, $this->stamp);
        Slot $s = $this->slots[$id];
        bool $over = contains($s->pos, $s->size, $this->io->pointer);
        bool $fire = false;

        if ($over && $this->io->leftDown) {
            $s->pressed = true;
            $s->pressAt = visu::runtime::seconds();
        }

        if ($s->pressed && $over && $this->io->leftReleased) {
            $fire = true;
            $s->pressed = false;
        } else if ($this->io->leftReleased) {
            $s->pressed = false;
        }

        $this->slots[$id] = $s;
        return $fire;
    }

    /**
     * True while this id owns the pointer: grab on the press edge over the rect, hold even if
     * the pointer leaves, release on up or a lost down.
     */
    internal function drag(uint64 $id) : bool
    {
        if ($this->io->consumed || $this->disabledDepth > 0) {
            return false;
        }

        touchSlot($this->slots, $id, $this->stamp);
        Slot $s = $this->slots[$id];
        bool $over = contains($s->pos, $s->size, $this->io->pointer);

        if ($over && $this->io->leftPressed) {
            $s->pressed = true;
            $s->pressAt = visu::runtime::seconds();
        }

        bool $held = $s->pressed;

        if ($s->pressed && ($this->io->leftReleased || !$this->io->leftDown)) {
            $s->pressed = false;
        }

        $this->slots[$id] = $s;

        if ($held) {
            $this->consume();
            $this->dragging = true;
        }

        return $held;
    }

    internal function consume() : void
    {
        $this->io->consumed = true;
    }

    internal function pressedKey(Key $code) : bool
    {
        Key $seeded = guard $this->io->key else {
            return $this->framePressedKey($code);
        }

        if ($seeded == $code) {
            return true;
        }

        return $this->framePressedKey($code);
    }

    private function framePressedKey(Key $code) : bool
    {
        InputHub? $maybe = $this->input;

        if ($maybe == null) {
            return false;
        }

        InputHub $in = guard $maybe;
        return $in->hasBeenPressedThisFrame($code);
    }

    internal const function measureText(const string& $s, float32 $size, bool $bold) : Vec2
    {
        return $this->measureTextRange($s, 0, $s->size(), $size, $bold);
    }

    internal const function measureTextRange(
        const string& $s,
        usize $from,
        usize $to,
        float32 $size,
        bool $bold,
        upper: bool $upper = false
    ) : Vec2
    {
        Font $font = guard uiFont($this, $bold) else {
            float32 $stub = (($to - $from) as float32) * $size * 0.5f;
            return Vec2($stub, $size * 1.2f);
        }
        float32 $px = visu::vg::quantizePx($size * $this->scale);
        float32 $inv = 1.0f / $this->scale;
        float32 $w = visu::vg::textWidthRange($font, $px, $s, $from, $to, $upper) * $inv;
        visu::vg::FontMetrics $m = visu::vg::fontMetrics($font, $px);
        return Vec2($w, $m->lineh * $inv);
    }

    /**
     * Claim the pointer while it is over a widget or a solid panel, or a drag is live; widen
     * to the keyboard while a field has focus. Released as soon as none holds.
     */
    internal function claimHover() : void
    {
        $this->hoverAny = $this->overlays->count() > 0 || $this->dragging;
        usize $n = $this->nodes->count();
        usize $i = 0;
        bool $pointerIn = $this->io->leftDown || $this->io->hovering;

        while (!$this->hoverAny && $pointerIn && $i < $n) {
            Node $node = $this->nodes[$i];

            if ((interactive($node->kind) || $node->solid) && contains($node, $this->io->pointer)) {
                $this->hoverAny = true;
            }

            $i = $i + 1;
        }

        bool $keys = $this->focusId != (0 as uint64);
        InputHub? $maybe = $this->input;

        if ($maybe == null) {
            return;
        }

        InputHub $in = guard $maybe;

        if (!$this->hoverAny && !$keys) {
            $this->releaseClaim();
            return;
        }

        ClaimScope $want = .pointer;

        if ($keys) {
            $want = .all;
        }

        if (!$in->holds(UI_CLAIM)) {
            // someone else (the console) holds it; retry next frame once they let go
            guard $in->claim(UI_CLAIM, scope: $want) else {
                $this->holdsClaim = false;
                return;
            }
            $this->holdsClaim = true;
            return;
        }

        $this->holdsClaim = true;
        ClaimScope $held = guard $in->claimScope() else {
            return;
        }

        if ($held != $want) {
            guard $in->rescope(UI_CLAIM, $want) else {
                return;
            }
        }
    }

    internal function releaseClaim() : void
    {
        if (!$this->holdsClaim) {
            return;
        }

        InputHub? $maybe = $this->input;

        if ($maybe != null) {
            InputHub $in = guard $maybe;
            guard $in->release(UI_CLAIM) else {
                $this->holdsClaim = false;
                return;
            }
        }

        $this->holdsClaim = false;
    }
}

public function resolveFontDir(const string& $preferred) : string
{
    if (fontHere($preferred)) {
        return $preferred;
    }

    string $ds = std::env::DS;

    if (fontHere("resources{$ds}font")) {
        return "resources{$ds}font";
    }

    if (fontHere("..{$ds}resources{$ds}font")) {
        return "..{$ds}resources{$ds}font";
    }

    return $preferred;
}

internal function scalePointer(Vec2 $pointer, float32 $uiScale) : Vec2
{
    if ($uiScale == 1.0f) {
        return $pointer;
    }

    return Vec2($pointer->x / $uiScale, $pointer->y / $uiScale);
}

internal function fontHere(string $dir) : bool
{
    string $ds = std::env::DS;
    bool $ok = guard std::io::exists("{$dir}{$ds}Inter-Regular.ttf") else {
        return false;
    }

    return $ok;
}
