/**
 * Padding inset. Stored on nodes as left, right, top, bottom.
 */

namespace visu::ui;

public struct Edges
{
    public float32 $left = 0.0f;
    public float32 $right = 0.0f;
    public float32 $top = 0.0f;
    public float32 $bottom = 0.0f;

    public static function all(float32 $v) : Edges
    {
        return Edges($v, $v, $v, $v);
    }

    public static function xy(float32 $x, float32 $y) : Edges
    {
        return Edges($x, $x, $y, $y);
    }

    public const function width() : float32
    {
        return $this->left + $this->right;
    }

    public const function height() : float32
    {
        return $this->top + $this->bottom;
    }
}
