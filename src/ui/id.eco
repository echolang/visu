/**
 * Id stack mix and per-control persistent slots.
 * Rects written after place are the next frame's hit targets.
 * Widget extras live in Persist so buttons do not carry a search string.
 */

namespace visu::ui;

use visu::math::Vec2;

internal struct GroupPersist
{
    public bool $hasPill = false;
    public float32 $pillX = 0.0f;
    public float32 $pillW = 0.0f;
}

internal struct SelectPersist
{
    public bool $open = false;
    public string $query = '';
    public int32 $highlight = 0;
    public Vec2 $dropPos = Vec2(0.0f);
    public Vec2 $dropSize = Vec2(0.0f);
}

internal struct FieldPersist
{
    public string $edit = '';
    public bool $armed = false;
}

internal struct ScrollPersist
{
    public float32 $offset = 0.0f;
}

internal enum Persist
{
    case none;
    case group(GroupPersist $g);
    case select(SelectPersist $s);
    case field(FieldPersist $f);
    case scroll(ScrollPersist $s);
}

internal struct Slot
{
    public Vec2 $pos = Vec2(0.0f);
    public Vec2 $size = Vec2(0.0f);
    public int32 $stamp = -1;
    public bool $pressed = false;
    public float64 $pressAt = -99.0;
    public Persist $data = .none;
}

internal function mixId(uint64 $parent, const string& $label) : uint64
{
    return hash::combine($parent, hash::of($label));
}

/**
 * A layout's id from its parent and sibling index. Integer mix, no label string: `begin`
 * runs for every container every frame.
 */
internal function layoutId(uint64 $parent, int32 $sibling) : uint64
{
    return hash::combine($parent, hash::combine(0x6c61796f7574 as uint64, hash::of($sibling)));
}

internal function touchSlot(map<uint64, Slot>& $slots, uint64 $id, int32 $stamp) : void
{
    if (!$slots->has($id)) {
        $slots[$id] = Slot();
    }

    $slots->at($id)->stamp = $stamp;
}

internal function dropUnseen(map<uint64, Slot>& $slots, int32 $stamp, array<uint64>& $stale) : void
{
    $stale->clear();

    foreach ($slots as $k => $s) {
        if ($s->stamp != $stamp) {
            $stale[] = $k;
        }
    }

    foreach ($stale as $k) {
        $slots->remove($k);
    }
}

internal function groupData(const Slot& $s) : GroupPersist
{
    match ($s->data) {
        Persist::group($g) => {
            return $g;
        },
        else => {
            return GroupPersist();
        },
    };
}

internal function setGroup(Slot& $s, GroupPersist $g) : void
{
    $s->data = .group($g);
}

internal function selectData(const Slot& $s) : SelectPersist
{
    match ($s->data) {
        Persist::select($p) => {
            return $p;
        },
        else => {
            return SelectPersist();
        },
    };
}

internal function setSelect(Slot& $s, SelectPersist $p) : void
{
    $s->data = .select($p);
}

internal function fieldData(const Slot& $s) : FieldPersist
{
    match ($s->data) {
        Persist::field($f) => {
            return $f;
        },
        else => {
            return FieldPersist();
        },
    };
}

internal function setField(Slot& $s, FieldPersist $f) : void
{
    $s->data = .field($f);
}

internal function scrollData(const Slot& $s) : ScrollPersist
{
    match ($s->data) {
        Persist::scroll($p) => {
            return $p;
        },
        else => {
            return ScrollPersist();
        },
    };
}

internal function setScroll(Slot& $s, ScrollPersist $p) : void
{
    $s->data = .scroll($p);
}

internal function selectIsOpen(const Slot& $s) : bool
{
    return selectData($s)->open;
}
