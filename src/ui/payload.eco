/**
 * Kind-specific rows, parallel to the node table.
 * Strings and option lists stay off `Node`.
 */

namespace visu::ui;

use visu::graphics::Texture;
use visu::vg::Color;

internal struct TextRun
{
    public string $text;
    public float32 $size;
    public Color $color;
    public bool $bold;
    /**
     * Text is `Ui.arena[from, to)` instead of `$text`.
     */
    public bool $arena = false;
    public usize $from = 0;
    public usize $to = 0;
    /**
     * Draw ASCII letters upper case (section headers).
     */
    public bool $upper = false;
}

internal struct ButtonRun
{
    public string $label;
    public bool $fill;
    public ButtonKind $style;
}

internal struct CheckRun
{
    public string $label;
    public bool $on;
}

internal struct ListRun
{
    public string $name;
    public array<Choice> $choices;
    public string $selected;
    public array<int32> $shown;
}

internal struct GroupRun
{
    public string $name;
    /**
     * Options are `Ui.choicePool[first, first + count)`.
     */
    public usize $first;
    public usize $count;
    public string $selected;
    public GroupStyle $style;
}

internal struct SliderRun
{
    public string $label;
    public float32 $value;
    public float32 $min;
    public float32 $max;
    /**
     * Value readout in `Ui.arena[from, to)`; empty when `from == to`.
     */
    public usize $from = 0;
    public usize $to = 0;
}

internal struct ImageRun
{
    public Texture? $texture;
    public Color $border;
    public float32 $borderWidth;
}

internal struct ProgressRun
{
    public float32 $value;
}

internal struct FieldRun
{
    public string $label;
    public string $text;
    public bool $focused;
    /**
     * Shown text is `Ui.arena[from, to)` instead of `$text` (an idle number field).
     */
    public bool $arena = false;
    public usize $from = 0;
    public usize $to = 0;
}

internal struct IconRun
{
    public Icon $icon;
    public bool $selected;
}
