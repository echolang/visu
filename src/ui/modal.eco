/**
 * Full-frame dim + centered card. `beginModal` returns false when `$open` is false.
 */

namespace visu::ui;

use visu::math::Vec2;

internal function uiBeginModal(Ui $ui, const string& $title, bool& $open) : bool
{
    if (!$open) {
        return false;
    }

    ModalStyle $st = $ui->theme->modal;
    Layout $dim = Layout();
    $dim->h = .fill;
    $dim->v = .fill;
    $dim->align = Align::center;
    $dim->bg = $st->dim;
    $ui->begin($dim);
    $ui->beginCard($st->width);
    if (!$title->empty()) {
        $ui->text($title, size: $ui->theme->largeFontSize, bold: true);
        $ui->space(0.0f, $ui->theme->spacing);
    }

    return true;
}

internal function uiEndModal(Ui $ui) : void
{
    $ui->end();
    $ui->end();
}
