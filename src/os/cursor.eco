/**
 * Cursor visibility. Values are GLFW's, converted at the call.
 */

namespace visu::os;

public enum CursorMode
{
    case normal;
    case hidden;
    case disabled;
}

internal function glfwCursorMode(CursorMode $mode) : int32
{
    return match ($mode) {
        CursorMode::normal => glfw::CURSOR_NORMAL,
        CursorMode::hidden => glfw::CURSOR_HIDDEN,
        CursorMode::disabled => glfw::CURSOR_DISABLED,
    };
}
