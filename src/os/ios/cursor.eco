/**
 * No cursor on iOS.
 * InputHub still compiles: liveCursor is absence, warps are no-ops.
 */

namespace visu::os;

use visu::math::Vec2;

internal function liveCursor(Window $window) : Vec2?
{
    return null;
}

internal function warpCursor(Window $window, Vec2 $position) : void
{
}

internal function liveCursorMode(Window $window) : CursorMode
{
    return .normal;
}

internal function warpCursorMode(Window $window, CursorMode $mode) : void
{
}
