/**
 * UIView to Metal Surface.
 * The one site that names UIKit and the GPU together.
 */

namespace visu::os;

use visu::graphics::{Device, DeviceError, Surface};

internal function createSurface(Window $window, Device $device) : result<Surface, DeviceError>
{
    ptr<uint8> $view = $window->uiView();

    if ($view:$ == null) {
        return .error(.metal('createSurface', 'no ui view'));
    }

    return .ok(Surface($view));
}
