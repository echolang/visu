/**
 * Push WindowHints into GLFW.
 * Desktop only; mobile Window ignores hints.
 */

namespace visu::os;

internal function applyWindowHints(const WindowHints& $hints) : void
{
    glfw::defaultWindowHints();
    hintBool(glfw::RESIZABLE, $hints->resizable);
    hintBool(glfw::VISIBLE, $hints->visible);
    hintBool(glfw::DECORATED, $hints->decorated);
    hintBool(glfw::FOCUSED, $hints->focused);
    hintBool(glfw::AUTO_ICONIFY, $hints->autoIconify);
    hintBool(glfw::FLOATING, $hints->floating);
    hintBool(glfw::MAXIMIZED, $hints->maximized);
    hintBool(glfw::CENTER_CURSOR, $hints->centerCursor);
    hintBool(glfw::TRANSPARENT_FRAMEBUFFER, $hints->transparentFramebuffer);
    hintBool(glfw::FOCUS_ON_SHOW, $hints->focusOnShow);
    hintBool(glfw::SCALE_TO_MONITOR, $hints->scaleToMonitor);
    hintInt(glfw::SAMPLES, $hints->samples);
    hintInt(glfw::REFRESH_RATE, $hints->refreshRate);
    hintInt(glfw::CLIENT_API, $hints->clientAPI);
    hintBool(glfw::COCOA_RETINA_FRAMEBUFFER, $hints->cocoaRetinaFramebuffer);

    string $name = guard $hints->cocoaFrameName else {
        return;
    }
    glfw::windowHintString(glfw::COCOA_FRAME_NAME, $name);
}

internal function hintBool(int32 $hint, bool? $value) : void
{
    bool $flag = guard $value else {
        return;
    }
    glfw::windowHint($hint, glfwFlag($flag));
}

internal function hintInt(int32 $hint, int32? $value) : void
{
    int32 $n = guard $value else {
        return;
    }
    glfw::windowHint($hint, $n);
}
