/**
 * GLFW cursor mode conversion.
 * The enum lives in os/cursor.eco.
 * liveCursor / warp* are the InputHub helpers; iOS ships no-ops.
 */

namespace visu::os;

use visu::math::Vec2;

internal function liveCursor(Window $window) : Vec2?
{
    if (!$window->initialized()) {
        return null;
    }

    return $window->cursor();
}

internal function warpCursor(Window $window, Vec2 $position) : void
{
    if (!$window->initialized()) {
        return;
    }

    $window->setCursor($position);
}

internal function liveCursorMode(Window $window) : CursorMode
{
    if (!$window->initialized()) {
        return .normal;
    }

    return $window->cursorMode();
}

internal function warpCursorMode(Window $window, CursorMode $mode) : void
{
    if (!$window->initialized()) {
        return;
    }

    $window->setCursorMode($mode);
}

internal function glfwCursorMode(CursorMode $mode) : int32
{
    return match ($mode) {
        .normal => glfw::CURSOR_NORMAL,
        .hidden => glfw::CURSOR_HIDDEN,
        .disabled => glfw::CURSOR_DISABLED,
    };
}

internal function cursorModeFromGlfw(int32 $raw) : CursorMode
{
    if ($raw == glfw::CURSOR_NORMAL) {
        return .normal;
    }

    if ($raw == glfw::CURSOR_HIDDEN) {
        return .hidden;
    }

    if ($raw == glfw::CURSOR_DISABLED) {
        return .disabled;
    }

    assert(false, 'unknown glfw cursor mode');
    return .normal;
}
