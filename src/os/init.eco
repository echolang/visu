/**
 * GLFW lifetime. Call init before creating a window; terminate after
 * the last one is gone. Hands GLFW the Vulkan loader before glfwInit
 * so MoltenVK is found on Darwin.
 */

namespace visu::os;

use visu::graphics::{needsVulkanLoader, vulkanLoaderProc};

public function init() : status<OsError>
{
    if (needsVulkanLoader()) {
        ptr<uint8> $proc = vulkanLoaderProc();

        if ($proc:$ == null) {
            return .error(.noVulkanLoader);
        }

        glfw::initVulkanLoader($proc);
    }

    if (glfw::init() != glfw::TRUE) {
        return .error(.glfw(glfw::error_message()));
    }

    return .ok;
}

public function terminate() : void
{
    glfw::terminate();
}

internal function glfwFlag(bool $value) : int32
{
    if ($value) {
        return glfw::TRUE;
    }

    return glfw::FALSE;
}

internal function glfwAttrib(WindowAttrib $attribute) : int32
{
    return match ($attribute) {
        WindowAttrib::decorated => glfw::DECORATED,
        WindowAttrib::floating => glfw::FLOATING,
        WindowAttrib::resizable => glfw::RESIZABLE,
        WindowAttrib::visible => glfw::VISIBLE,
        WindowAttrib::autoIconify => glfw::AUTO_ICONIFY,
        WindowAttrib::focusOnShow => glfw::FOCUS_ON_SHOW,
    };
}
