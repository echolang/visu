/**
 * Named actions bound to a key, a mouse button, or a virtual click
 * (press then release without travelling far). A matching handle
 * consumes the signal (`Flow::stop`).
 */

namespace visu::os;

use visu::os::key;
use visu::signal::{Click, Flow, Key, MouseButton};

public enum Binding
{
    case key(int32 $code);
    case button(int32 $code);
    case click;

    public const function label() : string
    {
        return match ($this) {
            Binding::key($code) => "key {$code}",
            Binding::button($code) => "button {$code}",
            Binding::click => 'click',
        };
    }
}

public class ActionMap
{
    private map<int32, string> $keys;
    private map<int32, string> $buttons;
    private string? $click;
    private map<string, bool> $didPress;
    private map<string, bool> $didRelease;
    private map<string, int32> $state;

    public constructor()
    {
        $this->keys = map<int32, string>();
        $this->buttons = map<int32, string>();
        $this->click = null;
        $this->didPress = map<string, bool>();
        $this->didRelease = map<string, bool>();
        $this->state = map<string, int32>();
    }

    public function bind(string $action, Binding $binding) : status<InputError>
    {
        return match ($binding) {
            Binding::key($code) => $this->bindKey($action, $code),
            Binding::button($code) => $this->bindButton($action, $code),
            Binding::click => $this->bindClick($action),
        };
    }

    public const function pressed(string $action) : bool
    {
        return $this->didPress->has($action);
    }

    public const function released(string $action) : bool
    {
        return $this->didRelease->has($action);
    }

    public const function down(string $action) : bool
    {
        if (!$this->state->has($action)) {
            return false;
        }

        int32 $s = $this->state->get($action);
        return $s == key::PRESS || $s == key::REPEAT;
    }

    public const function up(string $action) : bool
    {
        return !$this->down($action);
    }

    /**
     * Drop per-tick edges. Held state stays.
     */
    public function reset() : void
    {
        $this->didPress->clear();
        $this->didRelease->clear();
    }

    public function handle(const Key& $signal) : Flow
    {
        if (!$this->keys->has($signal->key)) {
            return .proceed;
        }

        string $action = $this->keys->get($signal->key);
        $this->note($action, $signal->action);
        return .stop;
    }

    /**
     * Held state only, no press / release edge.
     */
    internal function track(const Key& $signal) : void
    {
        if (!$this->keys->has($signal->key)) {
            return;
        }

        string $action = $this->keys->get($signal->key);
        $this->state[$action] = $signal->action;
    }

    public function handle(const MouseButton& $signal) : Flow
    {
        if (!$this->buttons->has($signal->button)) {
            return .proceed;
        }

        string $action = $this->buttons->get($signal->button);
        $this->note($action, $signal->action);
        return .stop;
    }

    internal function track(const MouseButton& $signal) : void
    {
        if (!$this->buttons->has($signal->button)) {
            return;
        }

        string $action = $this->buttons->get($signal->button);
        $this->state[$action] = $signal->action;
    }

    public function handle(const Click& $signal) : Flow
    {
        string $action = guard $this->click else {
            return .proceed;
        }
        $this->didRelease[$action] = true;
        return .stop;
    }

    private function bindKey(string $action, int32 $code) : status<InputError>
    {
        if ($this->keys->has($code)) {
            return .error(.taken(.key($code), $this->keys->get($code)));
        }

        $this->keys[$code] = $action;
        return .ok;
    }

    private function bindButton(string $action, int32 $code) : status<InputError>
    {
        if ($this->buttons->has($code)) {
            return .error(.taken(.button($code), $this->buttons->get($code)));
        }

        $this->buttons[$code] = $action;
        return .ok;
    }

    private function bindClick(string $action) : status<InputError>
    {
        string $existing = guard $this->click else {
            $this->click = $action;
            return .ok;
        }

        return .error(.taken(.click, $existing));
    }

    private function note(string $action, int32 $actionCode) : void
    {
        if ($actionCode == key::PRESS) {
            $this->didPress[$action] = true;
        } else if ($actionCode == key::RELEASE) {
            $this->didRelease[$action] = true;
        }

        $this->state[$action] = $actionCode;
    }
}
