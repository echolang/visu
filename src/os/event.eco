/**
 * Host-to-window fact.
 * Both arms enqueue; poll() / flush() drain.
 * Geometry (size, framebuffer, moved) applies on the window; everything else goes to the handler.
 */

namespace visu::os;

use visu::os::input::{Key, KeyPhase, MouseButton, TouchPhase};

public enum HostEvent
{
    case key(Key $key, int32 $scancode, KeyPhase $phase, int32 $mods);
    case char(int32 $codepoint);
    case charMods(int32 $codepoint, int32 $mods);
    case button(MouseButton $button, KeyPhase $phase, int32 $mods);
    case cursor(float64 $x, float64 $y);
    case cursorEnter(bool $entered);
    case scroll(float64 $x, float64 $y);
    case file(string $path);
    case touch(int32 $id, TouchPhase $phase, float32 $x, float32 $y, float32 $force);
    case focus(bool $gained);
    case pause;
    case resume;
    case size(int32 $width, int32 $height);
    case framebuffer(int32 $width, int32 $height);
    case moved;
}

internal function applyHostEvent(
    Window $window,
    WindowEventHandler? $handler,
    const HostEvent& $event
) : void
{
    match ($event) {
        .size($width, $height) => {
            $window->noteSize($width, $height);
        },
        .framebuffer($width, $height) => {
            $window->noteFramebuffer($width, $height);
        },
        .moved => {
            $window->notePos();
        },
        else => {
            WindowEventHandler $to = guard $handler else {
                return;
            }
            $to->handle($window, $event);
        },
    }
}

internal class EventQueue
{
    private array<HostEvent> $items;

    public constructor()
    {
        $this->items = array<HostEvent>();
    }

    public function post(HostEvent $event) : void
    {
        $this->items[] = $event;
    }

    public function take() : array<HostEvent>
    {
        array<HostEvent> $batch = $this->items;
        $this->items = array<HostEvent>();
        return $batch;
    }

    public const function empty() : bool
    {
        return $this->items->empty();
    }

    public function clear() : void
    {
        $this->items = array<HostEvent>();
    }

    public function drain(Window $window, WindowEventHandler? $handler) : void
    {
        while (!$this->empty()) {
            array<HostEvent> $batch = $this->take();
            foreach ($batch as $event) {
                applyHostEvent($window, $handler, $event);
            }
        }
    }
}
