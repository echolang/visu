/**
 * Where the primary pointer currently comes from.
 * Pointer is a policy (cursor or first finger), not a fake left button.
 */

namespace visu::os::input;

public enum PointerSource
{
    case none;
    case cursor;
    case finger(int32 $id);

    public const function isMouse() : bool
    {
        return match ($this) {
            .cursor => true,
            else => false,
        };
    }

    public const function isTouch() : bool
    {
        return match ($this) {
            .finger($id) => $id >= 0,
            else => false,
        };
    }
}

/**
 * Two-finger span this poll.
 * `scale` is 1 on the first two-finger frame, then current / previous span.
 */
public struct Pinch
{
    public float32 $span = 0.0f;
    public float32 $scale = 1.0f;
}
