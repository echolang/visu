/**
 * Press / release / repeat at the window-handler boundary and on Key / MouseButton facts.
 * Desktop GLFW action ints go through the named map in glfw/key.eco.
 */

namespace visu::os::input;

public enum KeyPhase
{
    case release;
    case press;
    case repeat;

    public const function down() : bool
    {
        return match ($this) {
            .press => true,
            .repeat => true,
            .release => false,
        };
    }
}
