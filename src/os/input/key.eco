/**
 * Keyboard tokens.
 * Closed domain names; the int32 backing is a dense id (`value()`), not GLFW.
 * Desktop GLFW codes live in the named map in glfw/key.eco.
 * Other hosts construct these cases directly.
 */

namespace visu::os::input;

public const int32 MOD_SHIFT = 0x0001;
public const int32 MOD_CONTROL = 0x0002;
public const int32 MOD_ALT = 0x0004;
public const int32 MOD_SUPER = 0x0008;
public const int32 MOD_CAPS_LOCK = 0x0010;
public const int32 MOD_NUM_LOCK = 0x0020;

/**
 * The shortcut modifier: Command on macOS, Control elsewhere. Bind `.chord(.s, MOD_PRIMARY)`
 * for save, never a literal `MOD_CONTROL`.
 */
#[if: os == darwin]
public const int32 MOD_PRIMARY = 0x0008;
#[else]
public const int32 MOD_PRIMARY = 0x0002;
#[end]

/**
 * The modifier bits a chord matches on. Caps and num lock never change a binding.
 */
public const int32 MOD_CHORD_MASK = 0x000F;

public enum Key : int32
{
    case unknown;
    case space;
    case apostrophe;
    case comma;
    case minus;
    case period;
    case slash;
    case num0;
    case num1;
    case num2;
    case num3;
    case num4;
    case num5;
    case num6;
    case num7;
    case num8;
    case num9;
    case semicolon;
    case equal;
    case a;
    case b;
    case c;
    case d;
    case e;
    case f;
    case g;
    case h;
    case i;
    case j;
    case k;
    case l;
    case m;
    case n;
    case o;
    case p;
    case q;
    case r;
    case s;
    case t;
    case u;
    case v;
    case w;
    case x;
    case y;
    case z;
    case leftBracket;
    case backslash;
    case rightBracket;
    case graveAccent;
    case world1;
    case world2;
    case escape;
    case enter;
    case tab;
    case backspace;
    case insert;
    case delete;
    case right;
    case left;
    case down;
    case up;
    case pageUp;
    case pageDown;
    case home;
    case end;
    case capsLock;
    case scrollLock;
    case numLock;
    case printScreen;
    case pause;
    case f1;
    case f2;
    case f3;
    case f4;
    case f5;
    case f6;
    case f7;
    case f8;
    case f9;
    case f10;
    case f11;
    case f12;
    case f13;
    case f14;
    case f15;
    case f16;
    case f17;
    case f18;
    case f19;
    case f20;
    case f21;
    case f22;
    case f23;
    case f24;
    case f25;
    case kp0;
    case kp1;
    case kp2;
    case kp3;
    case kp4;
    case kp5;
    case kp6;
    case kp7;
    case kp8;
    case kp9;
    case kpDecimal;
    case kpDivide;
    case kpMultiply;
    case kpSubtract;
    case kpAdd;
    case kpEnter;
    case kpEqual;
    case leftShift;
    case leftControl;
    case leftAlt;
    case leftSuper;
    case rightShift;
    case rightControl;
    case rightAlt;
    case rightSuper;
    case menu;
}
