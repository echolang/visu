/**
 * Touch identity and phase.
 * Hosts translate platform fingers into these; InputHub tracks the live set.
 * Positions are window coordinates, same space as the cursor.
 */

namespace visu::os::input;

use visu::math::Vec2;

public enum TouchPhase
{
    case began;
    case moved;
    case ended;
    case cancelled;
}

public struct TouchState
{
    public int32 $id = 0;
    public Vec2 $position = Vec2(0.0f);
    public float32 $force = 0.0f;
}
