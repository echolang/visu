/**
 * `str::from` so `"{$e}"` works. Own file because a namespace is a
 * property of the file.
 */

namespace str;

public function from(const visu::os::OsError& $e) : string
{
    return $e->message();
}

public function from(const visu::os::WindowError& $e) : string
{
    return $e->message();
}

public function from(const visu::os::InputError& $e) : string
{
    return $e->message();
}
