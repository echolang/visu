/**
 * Edge insets in window coordinates (not pixels).
 * Desktop safe area is zeros; iOS fills from the view's safeAreaInsets.
 */

namespace visu::os;

public struct Insets
{
    public float32 $left = 0.0f;
    public float32 $top = 0.0f;
    public float32 $right = 0.0f;
    public float32 $bottom = 0.0f;
}
