/**
 * GLFW window hints. Null means "leave GLFW's default".
 *
 * Apply runs just before createWindow. Same fields and defaults as PHP
 * VISU (OpenGL 4.1 core, forward compatible).
 */

namespace visu::os;

public struct WindowHints
{
    public bool? $resizable = null;
    public bool? $visible = null;
    public bool? $decorated = null;
    public bool? $focused = null;
    public bool? $autoIconify = null;
    public bool? $floating = null;
    public bool? $maximized = null;
    public bool? $centerCursor = null;
    public bool? $transparentFramebuffer = null;
    public bool? $focusOnShow = null;
    public bool? $scaleToMonitor = null;
    public bool? $stereoscopic = null;
    public int32? $samples = null;
    public bool? $sRGBCapable = null;
    public bool? $doubleBuffer = null;
    public int32? $refreshRate = null;
    public int32? $clientAPI = null;
    public int32? $contextCreationAPI = null;
    public int32? $contextVersionMajor = null;
    public int32? $contextVersionMinor = null;
    public bool? $forwardCompatible = null;
    public bool? $debugContext = null;
    public GlProfile? $profile = null;
    public int32? $robustness = null;
    public int32? $releaseBehavior = null;
    public bool? $noError = null;
    public bool? $cocoaRetinaFramebuffer = null;
    public string? $cocoaFrameName = null;
    public bool? $cocoaGraphicsSwitching = null;

    public static function defaults() : WindowHints
    {
        return WindowHints(
            $contextVersionMajor: 4,
            $contextVersionMinor: 1,
            $forwardCompatible: true,
            $profile: .core
        );
    }

    public const function apply() : void
    {
        hintBool(glfw::RESIZABLE, $this->resizable);
        hintBool(glfw::VISIBLE, $this->visible);
        hintBool(glfw::DECORATED, $this->decorated);
        hintBool(glfw::FOCUSED, $this->focused);
        hintBool(glfw::AUTO_ICONIFY, $this->autoIconify);
        hintBool(glfw::FLOATING, $this->floating);
        hintBool(glfw::MAXIMIZED, $this->maximized);
        hintBool(glfw::CENTER_CURSOR, $this->centerCursor);
        hintBool(glfw::TRANSPARENT_FRAMEBUFFER, $this->transparentFramebuffer);
        hintBool(glfw::FOCUS_ON_SHOW, $this->focusOnShow);
        hintBool(glfw::SCALE_TO_MONITOR, $this->scaleToMonitor);
        hintBool(glfw::STEREO, $this->stereoscopic);
        hintInt(glfw::SAMPLES, $this->samples);
        hintBool(glfw::SRGB_CAPABLE, $this->sRGBCapable);
        hintBool(glfw::DOUBLEBUFFER, $this->doubleBuffer);
        hintInt(glfw::REFRESH_RATE, $this->refreshRate);
        hintInt(glfw::CLIENT_API, $this->clientAPI);
        hintInt(glfw::CONTEXT_CREATION_API, $this->contextCreationAPI);
        hintInt(glfw::CONTEXT_VERSION_MAJOR, $this->contextVersionMajor);
        hintInt(glfw::CONTEXT_VERSION_MINOR, $this->contextVersionMinor);
        hintBool(glfw::OPENGL_FORWARD_COMPAT, $this->forwardCompatible);
        hintBool(glfw::OPENGL_DEBUG_CONTEXT, $this->debugContext);
        hintProfile(glfw::OPENGL_PROFILE, $this->profile);
        hintInt(glfw::CONTEXT_ROBUSTNESS, $this->robustness);
        hintInt(glfw::CONTEXT_RELEASE_BEHAVIOR, $this->releaseBehavior);
        hintBool(glfw::CONTEXT_NO_ERROR, $this->noError);
        hintBool(glfw::COCOA_RETINA_FRAMEBUFFER, $this->cocoaRetinaFramebuffer);
        hintBool(glfw::COCOA_GRAPHICS_SWITCHING, $this->cocoaGraphicsSwitching);

        string $name = guard $this->cocoaFrameName else {
            return;
        }
        glfw::windowHintString(glfw::COCOA_FRAME_NAME, $name);
    }
}

internal function hintBool(int32 $hint, bool? $value) : void
{
    bool $flag = guard $value else {
        return;
    }
    glfw::windowHint($hint, glfwFlag($flag));
}

internal function hintInt(int32 $hint, int32? $value) : void
{
    int32 $n = guard $value else {
        return;
    }
    glfw::windowHint($hint, $n);
}

internal function hintProfile(int32 $hint, GlProfile? $value) : void
{
    GlProfile $profile = guard $value else {
        return;
    }
    glfw::windowHint($hint, glfwProfile($profile));
}

internal function glfwProfile(GlProfile $profile) : int32
{
    return match ($profile) {
        GlProfile::any => glfw::OPENGL_ANY_PROFILE,
        GlProfile::core => glfw::OPENGL_CORE_PROFILE,
        GlProfile::compat => glfw::OPENGL_COMPAT_PROFILE,
    };
}
