/**
 * Colour 0 is the backbuffer while a frame is open.
 * Both Window arms set size / scale then call this.
 */

namespace visu::os;

use visu::graphics::{Device, RenderTarget, Texture};

internal function presentBackbuffer(RenderTarget& $target, Device? $device) : void
{
    Device $held = guard $device else {
        return;
    }

    if (!$held->inFrame()) {
        return;
    }

    Texture $bb = $held->backbuffer();

    if ($target->colors->empty()) {
        $target->colors[] = $bb;
    } else {
        $target->colors[0] = $bb;
    }
}
