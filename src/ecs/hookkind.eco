/**
 * The three moments in a component's life a system can listen to. Attach and detach fire from
 * `Entities.attach` / `detach`; change fires only when a writer reports it with
 * `Entities.changed<T>`, so a system that caches a derived fact (an octree slot, a light row)
 * re-reads it then instead of polling every component each frame.
 */

namespace visu::ecs;

public enum HookKind
{
    case attach;
    case change;
    case detach;
}
