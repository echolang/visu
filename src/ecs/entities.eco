/**
 * Entity allocator plus a View<T> per component type.
 * Components are structs in a sparse set; this class is the shared registry.
 * Device is never stored here.
 * It also keeps the move log: `move` is the one call a per-update pose writer (a physics body,
 * a car, an animated node, the camera) makes before it writes a `Transform`. The first move of
 * an entity in an update keeps its previous pose for interpolation and appends it to the log;
 * `roll` starts the next update and settles whatever moved in the last one, so a still entity
 * reads back exactly where it stands. Readers (`moveReader`) take what moved since they last
 * looked, so a system that runs once a frame sees every update that ran in between, and the
 * log never grows past the slowest reader. Nothing is walked per update but what moved.
 */

namespace visu::ecs;

use visu::geo::Transform;

/**
 * A move log cursor that no reader holds.
 */
internal const uint64 MOVE_READER_FREE = 0xFFFFFFFFFFFFFFFF;

private class Slot<T>
{
    public T $value;

    public constructor(T $value)
    {
        $this->value = $value;
    }

    public function get() : T&
    {
        return &$this->value;
    }

    public function asPtr() : ptr<T>
    {
        return &$this->value;
    }
}

/**
 * Type-erased View<T> for destroy / listener release.
 * Built once per component type at register, never on the view/get/attach path.
 * View.remove already no-ops when the entity is absent.
 */
private class StoreBox
{
    public function<void(Entities, Entity)> $unbind;
    public function<bool(HookKind, int32)> $release;

    public constructor(
        function<void(Entities, Entity)> $unbind,
        function<bool(HookKind, int32)> $release
    )
    {
        $this->unbind = $unbind;
        $this->release = $release;
    }
}

public class Entities
{
    private array<uint32> $generations;
    private array<uint32> $freelist;
    private uint32 $nextIndex;
    private map<type_id, erased> $views;
    private array<StoreBox> $stores;
    private map<type_id, StoreBox> $storeOf;
    private map<type_id, erased> $singletons;
    private int32 $hookIndex;

    /**
     * The update each entity last moved in, for the ones that ever moved. Its own sparse set,
     * not a component: nothing attaches it but `move`.
     */
    private View<uint32> $moveStamp;
    private uint32 $update;

    /**
     * Entities that moved this update, once each.
     */
    private array<Entity> $moved;

    /**
     * Every first move per update since the slowest reader looked, and the sequence number of
     * its first entry.
     */
    private array<Entity> $moveLog;
    private uint64 $moveBase;
    private array<uint64> $moveReaders;

    public constructor()
    {
        $this->generations = array<uint32>();
        $this->freelist = array<uint32>();
        $this->nextIndex = 0;
        $this->views = map<type_id, erased>();
        $this->stores = array<StoreBox>();
        $this->storeOf = map<type_id, StoreBox>();
        $this->singletons = map<type_id, erased>();
        $this->hookIndex = 0;
        $this->moveStamp = View<uint32>();
        $this->update = 1;
        $this->moved = array<Entity>();
        $this->moveLog = array<Entity>();
        $this->moveBase = 0;
        $this->moveReaders = array<uint64>();
    }

    /**
     * Make room for `$more` entities past the ones already created, so a game that spawns
     * during play (a planted tree) pushes into capacity it took at load instead of growing the
     * generation table in the displayed frame. Pair it with `view<T>()->reserve` for each
     * component those entities carry.
     */
    public function reserve(usize $more) : void
    {
        usize $want = $this->generations->count() + $more;
        $this->generations->reserve($want);
        $this->freelist->reserve($want);
    }

    /**
     * Make room for `$more` entities that will carry `T`, as `reserve` does for the ids, plus the
     * view's dense storage and the sparse pages of exactly the indices the next `$more` creates
     * hand out (the free list's top, then fresh ones). A spawn in the displayed frame into that
     * room allocates nothing, as long as nothing else creates in between.
     */
    public function reserveFor<T>(usize $more) : void
    {
        $this->reserve($more);
        View<T> $view = $this->view<T>();
        $view->reserve($view->size() + $more);

        usize $left = $more;
        usize $i = $this->freelist->count();
        while ($left > 0 && $i > 0) {
            $i = $i - 1;
            uint32 $idx = $this->freelist[$i];
            $view->commit($idx, $idx + 1);
            $left = $left - 1;
        }

        if ($left > 0) {
            $view->commit($this->nextIndex, $this->nextIndex + ($left as uint32));
        }
    }

    /**
     * Create `$count` entities into `$into` in one pass (a scatter, a map load): the id tables
     * grow once, not per create. Recycled indices go first, as `create` would take them.
     */
    public function createMany(usize $count, array<Entity>& $into) : void
    {
        $this->reserve($count);
        $into->reserve($into->count() + $count);
        usize $i = 0;
        while ($i < $count) {
            $into->push($this->create());
            $i = $i + 1;
        }
    }

    public function create() : Entity
    {
        if (!$this->freelist->empty()) {
            uint32 $idx = $this->freelist->pop();
            uint32 $ver = $this->generations[$idx as usize];
            return Entity(index: $idx, version: $ver);
        }

        uint32 $idx = $this->nextIndex;
        $this->nextIndex = $this->nextIndex + 1;
        $this->generations->push(0);
        return Entity(index: $idx, version: 0);
    }

    public const function valid(Entity $e) : bool
    {
        if ($e == Entity::none()) {
            return false;
        }

        uint32 $idx = $e->index();
        if (($idx as usize) >= $this->generations->count()) {
            return false;
        }

        return $this->generations[$idx as usize] == $e->version();
    }

    public function destroy(Entity $e) : void
    {
        assert($this->valid($e), 'entities: destroy of invalid entity');
        $this->detachAll($e);
        $this->moveStamp->erase($e);

        uint32 $idx = $e->index();
        uint32 $ver = $this->generations[$idx as usize];
        if ($ver == ENTITY_VERSION_MAX) {
            $ver = 0;
        } else {
            $ver = $ver + 1;
        }
        $this->generations[$idx as usize] = $ver;
        $this->freelist->push($idx);
    }

    public function register<T>() : void
    {
        type_id $id = type_id<T>();
        if ($this->views->has($id)) {
            return;
        }

        View<T> $view = View<T>();
        $this->views[$id] = erased::from($view);
        StoreBox $store = StoreBox(
            function(Entities $world, Entity $e) : void {
                $view->remove($world, $e);
            },
            function(HookKind $kind, int32 $handle) : bool {
                return $view->release($kind, $handle);
            },
        );
        $this->stores->push($store);
        $this->storeOf[$id] = $store;
    }

    public function view<T>() : View<T>
    {
        $this->register<T>();
        erased $held = $this->views->get(type_id<T>());
        unsafe {
            return assume<View<T>>($held);
        }
    }

    public function attach<T>(Entity $e, T $component) : T&
    {
        assert($this->valid($e), 'entities: attach to invalid entity');
        View<T> $view = $this->view<T>();
        $view->attach($e, $component);
        $view->fire(.attach, $this, $e, $view->get($e));
        return $view->get($e);
    }

    public function detach<T>(Entity $e) : void
    {
        assert($this->valid($e), 'entities: detach from invalid entity');
        View<T> $view = $this->view<T>();
        assert($view->contains($e), 'entities: detach of missing component');
        $view->remove($this, $e);
    }

    public function detachAll(Entity $e) : void
    {
        foreach ($this->stores as $store) {
            function<void(Entities, Entity)> $unbind = $store->unbind;
            $unbind($this, $e);
        }
    }

    public function get<T>(Entity $e) : T&
    {
        assert($this->valid($e), 'entities: get on invalid entity');
        View<T> $view = $this->view<T>();
        return $view->get($e);
    }

    public function find<T>(Entity $e) : ptr<T>
    {
        View<T> $view = guard $this->findView<T>() else {
            return null;
        }

        return $view->find($e);
    }

    public function has<T>(Entity $e) : bool
    {
        if (!$this->valid($e)) {
            return false;
        }

        View<T> $view = guard $this->findView<T>() else {
            return false;
        }

        return $view->contains($e);
    }

    public function ids<T>() : array<Entity>
    {
        View<T> $view = guard $this->findView<T>() else {
            return array<Entity>();
        }

        return $view->ids();
    }

    public function idsWith<A, B>() : array<Entity>
    {
        array<Entity> $out = array<Entity>();
        View<A> $va = $this->view<A>();
        View<B> $vb = $this->view<B>();
        if ($va->size() <= $vb->size()) {
            foreach ($va as $e => &$a) {
                if ($vb->contains($e)) {
                    $out->push($e);
                }
            }
        } else {
            foreach ($vb as $e => &$b) {
                if ($va->contains($e)) {
                    $out->push($e);
                }
            }
        }
        return $out;
    }

    public function each<T>(function<void(Entity, T&)> $fn) : void
    {
        foreach ($this->view<T>() as $e => &$c) {
            $fn($e, $c);
        }
    }

    public function each<A, B>(function<void(Entity, A&, B&)> $fn) : void
    {
        View<A> $va = $this->view<A>();
        View<B> $vb = $this->view<B>();
        if ($va->size() <= $vb->size()) {
            foreach ($va as $e => &$a) {
                if (!$vb->contains($e)) {
                    continue;
                }
                $fn($e, $a, $vb->get($e));
            }
        } else {
            foreach ($vb as $e => &$b) {
                if (!$va->contains($e)) {
                    continue;
                }
                $fn($e, $va->get($e), $b);
            }
        }
    }

    public function each<A, B, C>(function<void(Entity, A&, B&, C&)> $fn) : void
    {
        View<A> $va = $this->view<A>();
        View<B> $vb = $this->view<B>();
        View<C> $vc = $this->view<C>();
        usize $na = $va->size();
        usize $nb = $vb->size();
        usize $nc = $vc->size();

        if ($na <= $nb && $na <= $nc) {
            foreach ($va as $e => &$a) {
                if (!$vb->contains($e) || !$vc->contains($e)) {
                    continue;
                }
                $fn($e, $a, $vb->get($e), $vc->get($e));
            }
        } else if ($nb <= $na && $nb <= $nc) {
            foreach ($vb as $e => &$b) {
                if (!$va->contains($e) || !$vc->contains($e)) {
                    continue;
                }
                $fn($e, $va->get($e), $b, $vc->get($e));
            }
        } else {
            foreach ($vc as $e => &$c) {
                if (!$va->contains($e) || !$vb->contains($e)) {
                    continue;
                }
                $fn($e, $va->get($e), $vb->get($e), $c);
            }
        }
    }

    public function first<T>() : ptr<T>
    {
        View<T> $view = guard $this->findView<T>() else {
            return null;
        }
        if ($view->empty()) {
            return null;
        }

        return $view->ptrAt(0);
    }

    public function firstWith<T>() : Entity?
    {
        View<T> $view = guard $this->findView<T>() else {
            return null;
        }
        if ($view->empty()) {
            return null;
        }

        return $view->entity(0);
    }

    public function setSingleton<T>(T $value) : void
    {
        Slot<T> $slot = Slot<T>($value);
        $this->singletons[type_id<T>()] = erased::from($slot);
    }

    public function getSingleton<T>() : T&
    {
        type_id $id = type_id<T>();
        assert($this->singletons->has($id), 'entities: singleton was never set');
        erased $held = $this->singletons->get($id);
        unsafe {
            Slot<T> $slot = assume<Slot<T>>($held);
            return $slot->get();
        }
    }

    public function findSingleton<T>() : ptr<T>
    {
        type_id $id = type_id<T>();
        if (!$this->singletons->has($id)) {
            return null;
        }

        erased $held = $this->singletons->get($id);
        unsafe {
            Slot<T> $slot = assume<Slot<T>>($held);
            return $slot->asPtr();
        }
    }

    public function hasSingleton<T>() : bool
    {
        return $this->singletons->has(type_id<T>());
    }

    public function removeSingleton<T>() : void
    {
        type_id $id = type_id<T>();
        if ($this->singletons->has($id)) {
            $this->singletons->remove($id);
        }
    }

    /**
     * Listen for `T` arriving on an entity, after it is stored.
     */
    public function onAttach<T>(function<void(Entities, Entity, const T&)> $fn) : EntityHook
    {
        return $this->listen<T>(.attach, $fn);
    }

    /**
     * Listen for a reported change of `T` (`changed<T>`): a system that caches what it derived
     * from `T` (a static's octree slot, a light's table row) re-reads it here instead of polling
     * every component per frame.
     */
    public function onChange<T>(function<void(Entities, Entity, const T&)> $fn) : EntityHook
    {
        return $this->listen<T>(.change, $fn);
    }

    /**
     * Listen for `T` leaving an entity (a detach or a destroy), before it is erased.
     */
    public function onDetach<T>(function<void(Entities, Entity, const T&)> $fn) : EntityHook
    {
        return $this->listen<T>(.detach, $fn);
    }

    /**
     * Stop a listener. O(listeners of that component and moment). `EntityHook::none()` is a
     * no-op; a hook this world never handed out, or one already released, is a wiring bug.
     */
    public function release(EntityHook $hook) : void
    {
        if (!$hook->valid()) {
            return;
        }

        assert($this->storeOf->has($hook->type), 'entities: release of a hook on an unknown component');
        StoreBox $store = $this->storeOf->get($hook->type);
        function<bool(HookKind, int32)> $release = $store->release;
        bool $found = $release($hook->kind, $hook->id);
        assert($found, 'entities: release of a hook that is not listening');
    }

    /**
     * Report that `T` on `$e` was written outside the per-frame paths that already read it (an
     * editor drag, a grown tree, a retinted model), so every `onChange<T>` listener re-reads it.
     * For `Transform` that means the world pose, a part whose parent moved included
     * (`changedAssembly`). O(listeners of `T`). An entity without `T` is a no-op.
     */
    public function changed<T>(Entity $e) : void
    {
        View<T> $view = guard $this->findView<T>() else {
            return;
        }
        if (!$view->contains($e)) {
            return;
        }

        $view->fire(.change, $this, $e, $view->get($e));
    }

    /**
     * `$e` is about to be moved: call it before writing its `Transform` in an update (a tick or
     * the update phase) and write the pose it returns. The first call in an update keeps the pose
     * as the previous one for interpolation and logs `$e`; later calls in the same update only
     * hand the Transform back. It fires no hooks: a continuous mover is not an edit, and
     * `changed<Transform>` stays for teleports and authored moves. O(1).
     */
    public function move(Entity $e) : Transform&
    {
        assert($this->valid($e), 'entities: move of invalid entity');
        if (!$this->moveStamp->contains($e)) {
            $this->moveStamp->attach($e, 0);
        }

        uint32& $stamp = $this->moveStamp->get($e);
        if ($stamp != $this->update) {
            $stamp = $this->update;
            $this->get<Transform>($e)->storePrevious();
            $this->moved[] = $e;
            $this->moveLog[] = $e;
        }

        return $this->get<Transform>($e);
    }

    /**
     * Start the next update: everything that moved in the last one takes its current pose as its
     * previous one, so an entity that stops moving reads back where it stands, and the log drops
     * what every reader has taken. `Systems` calls this once per update, before its first write.
     * O(moved last update).
     */
    public function roll() : void
    {
        foreach ($this->moved as $e) {
            if ($this->valid($e) && $this->has<Transform>($e)) {
                $this->get<Transform>($e)->storePrevious();
            }
        }

        $this->moved->clear();
        $this->update = $this->update + 1;
        $this->trimMoves();
    }

    /**
     * Room for `$movers` entities moving in one update and in the log, so a pile or a swarm
     * logs into capacity taken at load.
     */
    public function reserveMoves(usize $movers) : void
    {
        $this->moved->reserve($movers);
        $this->moveLog->reserve($movers * 2);
        $this->moveStamp->reserve($movers);
    }

    /**
     * A new move log reader, reading from now on. Release it with `releaseMoveReader`, or the log
     * keeps everything since it last read.
     */
    public function moveReader() : int32
    {
        uint64 $now = $this->moveBase + ($this->moveLog->count() as uint64);
        int32 $i = 0;
        while (($i as usize) < $this->moveReaders->count()) {
            if ($this->moveReaders[$i as usize] == MOVE_READER_FREE) {
                $this->moveReaders[$i as usize] = $now;
                return $i;
            }

            $i = $i + 1;
        }

        $this->moveReaders[] = $now;
        return ($this->moveReaders->count() as int32) - 1;
    }

    public function releaseMoveReader(int32 $reader) : void
    {
        if ($reader < 0 || ($reader as usize) >= $this->moveReaders->count()) {
            return;
        }

        $this->moveReaders[$reader as usize] = MOVE_READER_FREE;
    }

    /**
     * Append to `$into` every entity logged since `$reader` last read, oldest first, and move the
     * reader to the end. An entity that moved in several updates in between comes once per update:
     * the reader keeps its own stamp if it wants one entry. O(new entries).
     */
    public function moves(int32 $reader, array<Entity>& $into) : void
    {
        assert($reader >= 0 && ($reader as usize) < $this->moveReaders->count(), 'entities: unknown move reader');
        uint64 $from = $this->moveReaders[$reader as usize];
        assert($from != MOVE_READER_FREE, 'entities: read through a released move reader');
        usize $i = ($from - $this->moveBase) as usize;
        usize $n = $this->moveLog->count();
        while ($i < $n) {
            $into[] = $this->moveLog[$i];
            $i = $i + 1;
        }

        $this->moveReaders[$reader as usize] = $this->moveBase + ($n as uint64);
    }

    /**
     * The update in progress: `roll` counts one on. A reader that runs less often than updates
     * compares it to tell whether an update ran since it last looked.
     */
    public const function updateIndex() : uint32
    {
        return $this->update;
    }

    /**
     * Whether `$e` moved in this update.
     */
    public function movedNow(Entity $e) : bool
    {
        if (!$this->moveStamp->contains($e)) {
            return false;
        }

        return $this->moveStamp->get($e) == $this->update;
    }

    /**
     * Drop the log entries every reader has taken; with no reader, all of them.
     */
    private function trimMoves() : void
    {
        uint64 $end = $this->moveBase + ($this->moveLog->count() as uint64);
        uint64 $keepFrom = $end;
        foreach ($this->moveReaders as $cursor) {
            if ($cursor != MOVE_READER_FREE && $cursor < $keepFrom) {
                $keepFrom = $cursor;
            }
        }

        usize $drop = ($keepFrom - $this->moveBase) as usize;
        if ($drop == 0) {
            return;
        }

        if ($drop == $this->moveLog->count()) {
            $this->moveLog->clear();
        } else {
            usize $n = $this->moveLog->count();
            usize $i = $drop;
            while ($i < $n) {
                $this->moveLog[$i - $drop] = $this->moveLog[$i];
                $i = $i + 1;
            }

            $this->moveLog->truncate($n - $drop);
        }

        $this->moveBase = $keepFrom;
    }

    private function listen<T>(HookKind $kind, function<void(Entities, Entity, const T&)> $fn) : EntityHook
    {
        int32 $handle = $this->hookIndex;
        $this->hookIndex = $this->hookIndex + 1;
        $this->view<T>()->listen($kind, $handle, $fn);
        return EntityHook($kind, type_id<T>(), $handle);
    }

    private function findView<T>() : View<T>?
    {
        type_id $id = type_id<T>();
        if (!$this->views->has($id)) {
            return null;
        }

        erased $held = $this->views->get($id);
        unsafe {
            return assume<View<T>>($held);
        }
    }
}
