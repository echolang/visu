/**
 * A registered lifecycle listener: which component, which moment, which slot. Returned by
 * `Entities.onAttach<T>` / `onChange<T>` / `onDetach<T>` and handed back to `Entities.release`,
 * which goes straight to that one view.
 */

namespace visu::ecs;

public struct EntityHook
{
    public const HookKind $kind;
    public const type_id $type;
    public const int32 $id;

    public constructor(HookKind $kind, type_id $type, int32 $id)
    {
        $this->kind = $kind;
        $this->type = $type;
        $this->id = $id;
    }

    /**
     * No listener: what a system holds before `register` and after `unregister`. Releasing it
     * is a no-op.
     */
    public static function none() : EntityHook
    {
        return EntityHook(.attach, type_id<EntityHook>(), -1);
    }

    public const function valid() : bool
    {
        return $this->id >= 0;
    }
}
