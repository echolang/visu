/**
 * A dynamic body came to rest and fell asleep: it costs no step and no longer moves until
 * something wakes it. Dispatched by `PhysicsSystem` after the step that put it to sleep, when it
 * was given a dispatcher. A renderer can file a sleeping body with the still scenery.
 */

namespace visu::physics;

use visu::ecs::Entity;

public struct BodySlept
{
    public const Entity $entity;
}
