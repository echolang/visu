/**
 * One wheel of a vehicle as the last step left it: the contact, the spring, the spin, and the slip
 * and forces the tire model worked out. `VehicleSystem` writes it; a console, a HUD, a skid mark
 * or a sound reads it.
 */

namespace visu::physics;

use visu::math::Vec3;

public struct VehicleWheelState
{
    public bool $contact = false;
    public Vec3 $point = Vec3(0.0f, 0.0f, 0.0f);
    public Vec3 $normal = Vec3(0.0f, 1.0f, 0.0f);

    /**
     * Metres of compression, 0 at full droop, `restLength` fully compressed.
     */
    public float32 $compression = 0.0f;

    /**
     * Newtons the spring and damper push with this step, and the tire's load after the load
     * response.
     */
    public float32 $force = 0.0f;
    public float32 $load = 0.0f;

    /**
     * Radians per second about the axle, positive rolling forward, and the angle it has turned
     * through, kept within a turn.
     */
    public float32 $omega = 0.0f;
    public float32 $spin = 0.0f;

    /**
     * The slip ratio and the slip angle (radians) the curves were read at.
     */
    public float32 $slipRatio = 0.0f;
    public float32 $slipAngle = 0.0f;

    /**
     * Newtons along the tire's forward and its left after the clamps.
     */
    public float32 $fx = 0.0f;
    public float32 $fy = 0.0f;

    /**
     * The ground's grip under this wheel, 1 for the surface the curves were drawn for: the
     * `Collider.grip` its ray landed on this step. It keeps the last ground's while in the air.
     */
    public float32 $surface = 1.0f;
}
