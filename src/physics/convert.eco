/**
 * The edge between visu's math and the backend's. Both are plain float32 structs of the same
 * shape, so a crossing is a copy of three or four floats.
 */

namespace visu::physics;

use visu::math::{Quat, Vec3};

internal function toBt(Vec3 $v) : bt::Vec3
{
    return bt::Vec3($v->x, $v->y, $v->z);
}

internal function toBt(Quat $q) : bt::Quat
{
    return bt::Quat($q->x, $q->y, $q->z, $q->w);
}

internal function toBt(Vec3 $origin, Quat $rotation) : bt::Transform
{
    return bt::Transform(toBt($origin), toBt($rotation));
}

internal function fromBt(bt::Vec3 $v) : Vec3
{
    return Vec3($v->x, $v->y, $v->z);
}

internal function fromBt(bt::Quat $q) : Quat
{
    return Quat($q->x, $q->y, $q->z, $q->w);
}

internal function toBt(PhysicsLayer $layer) : bt::Layer
{
    return bt::Layer($layer->bits);
}
