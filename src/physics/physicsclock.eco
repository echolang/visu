/**
 * What a `PhysicsWorld` steps on. Read once, when `PhysicsSystem` is bound.
 */

namespace visu::physics;

public enum PhysicsClock
{
    /**
     * One step per simulation pass, capped per update by `PhysicsSettings.maxStepsPerUpdate`. An
     * app that runs more passes to run faster runs its physics faster too, and pays for it.
     */
    case pass;

    /**
     * One step per update, whatever the passes: the fixed wall rate of the game loop. Loose
     * bodies fall at the same speed and cost the same at any clock speed, and a time skip steps
     * them in real time.
     */
    case update;
}
