/**
 * One wheel of a `VehicleSpec` as it is authored: where it hangs, how big it is, how its spring
 * and damper behave, and what drives, brakes and steers it. Positions are in the chassis entity's
 * frame (+Z forward, +Y up, +X to the left), the frame its model is authored in.
 */

namespace visu::physics;

use visu::math::Vec3;

public struct VehicleWheel
{
    /**
     * The top of the suspension travel: where the wheel's centre sits fully compressed. The
     * wheel hangs `restLength` below it at full droop.
     */
    public Vec3 $mount;
    public float32 $radius;

    /**
     * Metres of suspension travel, from full compression to full droop.
     */
    public float32 $restLength;

    /**
     * Newtons per metre of compression.
     */
    public float32 $spring;

    /**
     * Newton seconds per metre while the spring compresses, and while it extends.
     */
    public float32 $bump;
    public float32 $rebound;

    /**
     * The last metres of compression, where the spring is four times as stiff: the rubber stop
     * that keeps a hard landing from bottoming out.
     */
    public float32 $bumpStop;

    public bool $steers;

    /**
     * This wheel's share of the engine's force and of the brake torque. The shares across the
     * wheels add up to one each.
     */
    public float32 $drive;
    public float32 $brake;

    /**
     * Locked by the handbrake, which also takes away some of its side grip.
     */
    public bool $handbrake;

    /**
     * A front wheel takes the front lateral grip and anti-roll bar, the rest the rear.
     */
    public bool $front;

    /**
     * The other wheel on this axle, for the anti-roll bar; -1 for none.
     */
    public int32 $pair;

    public constructor(Vec3 $mount, float32 $radius, front: bool $front)
    {
        $this->mount = $mount;
        $this->radius = $radius;
        $this->restLength = 0.3f;
        $this->spring = 30000.0f;
        $this->bump = 2200.0f;
        $this->rebound = 3800.0f;
        $this->bumpStop = 0.04f;
        $this->steers = $front;
        $this->drive = 0.0f;
        $this->brake = 0.0f;
        $this->handbrake = !$front;
        $this->front = $front;
        $this->pair = -1;
    }
}
