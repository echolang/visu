/**
 * How a `RigidBody` moves. An entity with a `Collider` and no `RigidBody` is static.
 */

namespace visu::physics;

public enum BodyKind
{
    /**
     * Moved by the simulation: gravity, contacts, forces. The system writes its `Transform`.
     */
    case dynamic;

    /**
     * Moved by its owner through its `Transform`, and pushes dynamic bodies out of its way. The
     * system reads its `Transform` every step.
     */
    case kinematic;
}
