/**
 * Code that pushes bodies itself, run by `PhysicsSystem` inside every step it takes: after the
 * kinematic bodies were driven to this update's pose and before the world advances. A vehicle's
 * suspension and tires, buoyancy, a magnet. It runs exactly as often as the world steps (never
 * while paused, never past `maxStepsPerUpdate`, once a pass or once an update as the clock says),
 * so an impulse given here is given once per step whatever the app's clock speed.
 */

namespace visu::physics;

use visu::ecs::Entities;

public interface PhysicsStepper
{
    /**
     * Push what this stepper owns for one step of `$dt` seconds. Read bodies through
     * `PhysicsWorld.body`, and query the world as the step sees it.
     */
    function beforeStep(Entities $entities, PhysicsWorld $world, float32 $dt) : void;
}
