/**
 * What a ray or a sweep found: the entity whose collider or sensor it met, where, the surface
 * normal there pointing back at the query, how far along the query that was, and the grip of the
 * collider it met (1 for a sensor).
 */

namespace visu::physics;

use visu::ecs::Entity;
use visu::math::Vec3;

public struct PhysicsHit
{
    public const Entity $entity;
    public const Vec3 $point;
    public const Vec3 $normal;

    /**
     * World units from the query's start to the hit.
     */
    public const float32 $distance;

    /**
     * The `Collider.grip` of what was met.
     */
    public const float32 $grip;
}
