/**
 * A dynamic body is awake and moving: newly built, or woken by a push, a contact or a move.
 * Dispatched by `PhysicsSystem` after the step that first moved it, when it was given a
 * dispatcher. Every `BodySlept` is followed by one of these before the body moves again.
 */

namespace visu::physics;

use visu::ecs::Entity;

public struct BodyWoke
{
    public const Entity $entity;
}
