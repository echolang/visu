/**
 * Triangles a static collider is made of, in the entity's local units: positions, and three
 * indices per triangle into them. A class, so every copy of a `Collider` that wears it shares one
 * list. The backend copies it when the body is built; this one is kept for a rebuild.
 */

namespace visu::physics;

use visu::math::Vec3;

public class CollisionMesh
{
    public array<Vec3> $vertices;
    public array<int32> $indices;

    public constructor(array<Vec3> $vertices, array<int32> $indices)
    {
        $this->vertices = $vertices;
        $this->indices = $indices;
    }

    /**
     * How many triangles the mesh holds.
     */
    public const function triangles() : int32
    {
        return ($this->indices->count() / 3) as int32;
    }
}
