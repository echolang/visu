/**
 * What a driver asks of a vehicle this step. A player's keys, an AI's plan or a console override
 * write it; `VehicleSystem` reads it in the next physics step.
 */

namespace visu::physics;

public struct VehicleControls
{
    /**
     * -1 to 1. Positive drives forward, negative in reverse.
     */
    public float32 $throttle = 0.0f;

    /**
     * 0 to 1.
     */
    public float32 $brake = 0.0f;

    /**
     * -1 to 1. Positive turns right, negative left.
     */
    public float32 $steer = 0.0f;

    public bool $handbrake = false;
}
