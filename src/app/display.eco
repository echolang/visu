/**
 * The window a settings screen asks for: windowed or exclusive fullscreen at a size and refresh,
 * and vsync. `Host.display` applies it and remembers it, so asking again for the same display
 * (a graphics-only apply) never re-enters fullscreen or rebuilds the swapchain.
 */

namespace visu::app;

public struct Display
{
    public bool $fullscreen = false;
    public int32 $width = 1280;
    public int32 $height = 720;

    /**
     * Hz of the fullscreen mode; 0 picks the monitor's highest.
     */
    public int32 $refresh = 0;
    public bool $vsync = false;

    public const function same(const Display& $other) : bool
    {
        return $this->fullscreen == $other->fullscreen
            && $this->width == $other->width
            && $this->height == $other->height
            && $this->refresh == $other->refresh
            && $this->vsync == $other->vsync;
    }
}
