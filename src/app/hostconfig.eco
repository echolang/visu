/**
 * Knobs for the windowed GPU session. Public fields, no fluent
 * chain. Quickstart copies these from Options; a class-based
 * app fills them by hand.
 */

namespace visu::app;

use visu::math::{Vec2, Vec4};

public class HostConfig
{
    public string $title = 'visu';
    public int32 $width = 1280;
    public int32 $height = 720;
    public bool $vsync = true;
    public bool $headless = false;
    public bool $instrumentOverlay = true;
    public bool $debugConsole = false;
    public bool $ui = false;
    public int32? $maxFrames = null;
    public Vec4 $clearColor;
    public bool $fixedResolution = false;
    public Vec2 $renderSize;
    public string $targetName = 'scene';
    public string $colorName = 'color';

    public constructor()
    {
        $this->clearColor = Vec4(0.25f, 0.25f, 0.25f, 1.0f);
        $this->renderSize = Vec2(0.0f, 0.0f);
        $this->maxFrames = visu::finiteFrames();
    }
}
