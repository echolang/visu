/**
 * Knobs for the windowed GPU session.
 * Public fields, no fluent chain.
 * Quickstart copies these from Options; a class-based app fills them by hand.
 */

namespace visu::app;

use visu::math::{Vec2, Vec4};

public class HostConfig
{
    public string $title = 'visu';
    public int32 $width = 1280;
    public int32 $height = 720;
    public bool $vsync = true;
    public float32 $uiScale = 1.0f;
    public bool $headless = false;
    public bool $instrumentOverlay = true;
    public bool $debugConsole = false;

    /**
     * Load FlyUI. Headless sessions still load it when this is set: dcapture dumps the
     * scene target the UI pass composites onto, so font files must be present.
     */
    public bool $ui = false;

    /**
     * Stop `initialize()` after the window, blit, overlay, FlyUI, and console.
     * The app then schedules `scanShaders()` / `mountAssets()` itself, so a
     * loading screen can draw before those finish. Default keeps today's path.
     */
    public bool $deferAssets = false;

    /**
     * Worker-lane load jobs. Off by default: `echoc run` JITs on first call and
     * LLVM's JIT is not thread-safe. Native `echoc build` (VISU_RELEASE) turns
     * this on. `--flag loading.workers` overrides.
     */
    public bool $loadWorkers = false;
    public int32? $maxFrames = null;
    public Vec4 $clearColor;
    public bool $fixedResolution = false;
    public Vec2 $renderSize;
    public string $targetName = 'scene';
    public string $colorName = 'color';

    public constructor()
    {
        $this->clearColor = Vec4(0.25f, 0.25f, 0.25f, 1.0f);
        $this->renderSize = Vec2(0.0f, 0.0f);
        $this->maxFrames = visu::finiteFrames();
    }
}
