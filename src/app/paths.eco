/**
 * Application filesystem roots. Replaces VISU_PATH_* constants;
 * derived from one root.
 */

namespace visu::app;

use std::env;

public class Paths
{
    public const string $root;
    public const string $cache;
    public const string $store;
    public const string $resources;
    public const string $resourcesShader;

    public constructor(root: string $root)
    {
        $ds = env::DS;
        $this->root = $root;
        $this->cache = "{$root}{$ds}var{$ds}cache";
        $this->store = "{$root}{$ds}var{$ds}storage";
        $this->resources = "{$root}{$ds}resources";
        $this->resourcesShader = "{$root}{$ds}resources{$ds}shader";
    }
}
