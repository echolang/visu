/**
 * Session-edge failures: window, shaders, graph execute, FlyUI, overlay.
 * Missing main EventLoop is a wiring bug (assert), not a case here.
 */

namespace visu::app;

use visu::asset::AssetError;
use visu::graphics::{PipelineError, ShaderError};
use visu::os::WindowError;
use visu::ui::UiError;
use visu::vg::VgError;

public enum HostError
{
    case none;
    case window(WindowError $inner);
    case shader(ShaderError $inner);
    case pipeline(PipelineError $inner);
    case ui(UiError $inner);
    case vg(VgError $inner);
    case asset(AssetError $inner);

    public const function failed() : bool
    {
        return match ($this) {
            HostError::none => false,
            else => true,
        };
    }

    public const function message() : string
    {
        return match ($this) {
            HostError::none => '',
            HostError::window($inner) => $inner->message(),
            HostError::shader($inner) => $inner->message(),
            HostError::pipeline($inner) => $inner->message(),
            HostError::ui($inner) => $inner->message(),
            HostError::vg($inner) => $inner->message(),
            HostError::asset($inner) => $inner->message(),
        };
    }
}
