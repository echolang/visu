/**
 * Trailing-slash a directory so relative joins are prefix matches.
 * Internal to the module; shader scan and audio playlist naming both use it.
 */

namespace visu::app;

internal function slashDir(string $path) : string
{
    if ($path->empty()) {
        return './';
    }

    if ($path->ends('/') || $path->ends('\\')) {
        return $path;
    }

    string $out = $path;
    $out->append('/');
    return $out;
}

internal function isPathSep(uint8 $b) : bool
{
    return $b == 47 || $b == 92;
}
