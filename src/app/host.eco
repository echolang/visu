/**
 * Windowed GPU session.
 * The app constructs one; Device stays off Services.
 * Construct fills the bag; initialize brings the window up; destroy tears it down.
 * Quickstart and a class-based app each own a Host and stay GameLoopDelegate.
 * Dump-after-present is always on (`DumpQueue` on Services). A `DCapture` on Services (only when
 * `--dcapture` was given) is the script driver: advance, camera override, skipped-step finish.
 */

namespace visu::app;

use visu::profile::{FrameProfile, Profiler, profiler};

use std::env;
use std::io;
use visu::asset::{
    Assembly, AssetError, Assets, AudioClip, Blob, DirectoryStore, KIND_ASSEMBLY, KIND_BYTES,
    KIND_MODEL, KIND_SOUND, KIND_TEXTURE, KIND_VMAT, PackStore, Vmat, decodeAssembly, decodeBytes,
    decodeGpuTexture, decodeSound, decodeVmat
};
use visu::graphics::{
    BackbufferData, CameraOverrideData, ClearPass, ClearPassOptions, RenderContext, Device, DeviceError,
    Frame, FrameStatus, FullscreenTextureRenderer, Model, Pipeline, PipelineError, decodeModel,
    Pool, RenderTarget, SceneTargetData, ShaderCollection, TargetRef, Texture,
    TextureOptions, TextureRef
};
use visu::console::{DCaptureConsole, FlagConsole, OverlayConsole, ProfileConsole};
use visu::dcapture::{DCapture, DumpQueue};
use visu::instrument::{DrawSource, Instruments, Overlay, Sample};
use visu::math::Vec2;
use visu::os::{Window, WindowHints};
use visu::os::input::{ContextMap, InputHub};
use visu::runtime::{DebugConsole, EventLoop};
use visu::signal::Dispatcher;
use visu::ui::Ui;

public class Host
{
    public const HostConfig $config;
    public Device $device;
    public Window $window;
    public Pool $pool;
    public Dispatcher $dispatcher;
    public InputHub $input;
    public ContextMap $inputContext;
    public ShaderCollection $shaders;
    public Assets $assets;
    public Services $services;
    public EventLoop $events;
    public Instruments $instruments;
    public Ui? $ui;
    public DebugConsole? $console;
    public int32 $frameIndex;

    /**
     * Update ticks polled so far; DCapture addresses steps by it.
     */
    public int32 $tickIndex;
    public HostError $fail;
    public DumpQueue $dumps;
    public float32 $uiScale;
    private DCapture? $script;
    private FullscreenTextureRenderer $blit;
    private Overlay? $overlay;

    public constructor(HostConfig $config, Services $services)
    {
        $this->script = $services->find<DCapture>();
        DCapture? $maybeScript = $this->script;
        if ($maybeScript != null) {
            DCapture $dcapture = guard $maybeScript;
            $dcapture->configure($config);
        }

        $services->once(function(Services $s) : DumpQueue {
            return DumpQueue('var/dcapture');
        });
        $this->dumps = $services->get<DumpQueue>();
        $this->tickIndex = 0;
        $this->config = $config;
        $this->uiScale = $config->uiScale;
        $this->services = $services;
        $this->device = Device();
        $this->window = Window(
            $config->title,
            $config->width,
            $config->height,
            hostHints($config)
        );
        $this->pool = Pool($this->device);
        $this->dispatcher = Dispatcher();
        $this->input = InputHub($this->window, $this->dispatcher);
        $this->inputContext = ContextMap($this->dispatcher, $this->input);
        $this->window->setHandler($this->input);
        $this->shaders = ShaderCollection($this->device, hostShaderDir($services));
        $this->assets = Assets($this->device);
        $this->events = EventLoop();
        $this->instruments = Instruments();
        $this->instruments->add(id: 'draw', DrawSource($this->device));
        profiler()->attach($this->device->draws, $this->device->gpuProfiler);
        $this->ui = null;
        $this->frameIndex = 0;
        $this->fail = .none;
        $this->blit = FullscreenTextureRenderer();
        $this->overlay = null;
        $this->console = null;
    }

    public function initialize() : status<HostError>
    {
        if ($this->fail->failed()) {
            return .error($this->fail);
        }

        $this->window->setVsync($this->config->vsync);
        guard $this->window->initialize($this->device) else ($e) {
            return .error(.window($e));
        }

        guard $this->blit->load($this->device) else ($e) {
            return .error(.shader($e));
        }

        $this->bootOverlay();
        $this->bootUi();
        $this->bootConsole();
        guard $this->scanShaders() else ($e) {
            return .error($e);
        }

        guard $this->mountAssets() else ($e) {
            return .error($e);
        }

        if ($this->fail->failed()) {
            return .error($this->fail);
        }

        return .ok;
    }

    public function poll() : void
    {
        $this->inputContext->reset();
        $this->window->poll();
        $this->events->tick();
        $this->tickIndex = $this->tickIndex + 1;
        $this->advanceDCapture();
    }

    public const function overlayEnabled() : bool
    {
        Overlay $overlay = guard $this->overlay else {
            return false;
        }

        return $overlay->enabled;
    }

    public function setOverlayEnabled(bool $on) : void
    {
        Overlay $overlay = guard $this->overlay else {
            return;
        }

        $overlay->enabled = $on;
    }

    public function renderFrame(
        float32 $compensation,
        function<void(RenderContext, TargetRef)> $scene,
        function<void(Ui)>? $ui = null,
        function<void()>? $afterPresent = null,
    ) : void
    {
        if ($this->window->shouldClose()) {
            return;
        }

        // a step due this frame lands even when no update tick ran since the last present
        $this->advanceDCapture();
        int32 $w = $this->window->framebufferWidth();
        int32 $h = $this->window->framebufferHeight();
        FrameStatus $status = guard $this->device->beginFrame($w, $h) else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    $this->window->setShouldClose(true);
                    return;
                },
                else => {
                    $this->fail = .pipeline(.device($e));
                    return;
                },
            }
        }

        if ($status == FrameStatus::skipped) {
            return;
        }

        profiler()->bindFrame($this->device->frameIndex(), $this->frameIndex);
        visu::profile::begin('build');
        Frame $frame = Frame();
        Pipeline $scenePipe = Pipeline($this->pool, $frame);
        RenderContext $ctx = RenderContext($this->device, $scenePipe, $frame, $this->pool, $compensation);
        TargetRef $sceneTarget = $this->sceneTarget($scenePipe);
        $sceneTarget->depthStencil = true;
        TextureRef $color = $scenePipe->createColor($sceneTarget, $this->config->colorName, TextureOptions());
        $frame->set(HostPassData($sceneTarget, $color));
        $frame->set(SceneTargetData($sceneTarget));
        $this->publishCameraOverride($frame);
        $scenePipe->add(ClearPass($sceneTarget, ClearPassOptions(color: $this->config->clearColor)));
        $scene($ctx, $sceneTarget);
        $this->addUi($scenePipe, $sceneTarget, $ui);
        visu::profile::end();
        $this->finishFrame($scenePipe, $frame, $color, $compensation, $afterPresent);
    }

    public const function shouldStop() : bool
    {
        if ($this->fail->failed()) {
            return true;
        }

        int32 $cap = guard $this->config->maxFrames else {
            return $this->window->shouldClose();
        }
        if ($this->frameIndex >= $cap) {
            return true;
        }

        return $this->window->shouldClose();
    }

    public function destroy() : void
    {
        $this->device->waitIdle();
        // frames still waiting for GPU spans complete without them so a dcapture profile step is never lost
        Profiler $prof = profiler();
        $prof->mergeGpu();
        $prof->abandon();
        $this->publishProfiles();
        DCapture? $maybeScript = $this->script;
        if ($maybeScript != null) {
            DCapture $dcapture = guard $maybeScript;
            $dcapture->finish($this->frameIndex);
        } else {
            $this->dumps->finish($this->frameIndex, $this->tickIndex, false);
        }

        Ui? $maybeUi = $this->ui;

        if ($maybeUi != null) {
            Ui $ui = guard $maybeUi;
            $ui->destroy();
            $this->ui = null;
        }

        Overlay? $maybeOverlay = $this->overlay;

        if ($maybeOverlay != null) {
            Overlay $overlay = guard $maybeOverlay;
            $overlay->destroy();
            $this->overlay = null;
        }

        DebugConsole? $maybeConsole = $this->console;

        if ($maybeConsole != null) {
            DebugConsole $console = guard $maybeConsole;
            $console->destroy();
            $this->console = null;
        }

        $this->assets->destroy();
        $this->shaders->destroy();
        $this->blit->destroy();
        $this->pool->destroy();
        $this->window->destroy();
        $this->device->shutdown();
    }

    private function sceneTarget(Pipeline $pipeline) : TargetRef
    {
        if ($this->config->fixedResolution) {
            Vec2 $fixed = $this->config->renderSize;
            return $pipeline->createTarget($this->config->targetName, $fixed->x as int32, $fixed->y as int32);
        }

        int32 $w = $this->window->framebufferWidth();
        int32 $h = $this->window->framebufferHeight();
        TargetRef $ref = $pipeline->createTarget($this->config->targetName, $w, $h);
        float32 $s = $this->device->contentsScale() as float32;
        $ref->contentScaleX = $s;
        $ref->contentScaleY = $s;
        return $ref;
    }

    private function addUi(Pipeline $pipeline, TargetRef $scene, function<void(Ui)>? $cb) : void
    {
        function<void(Ui)> $fn = guard $cb else {
            return;
        }
        Ui $ui = guard $this->ui else {
            return;
        }
        float32 $dpi = $scene->contentScaleX;
        $ui->beginFrame(
            Vec2($scene->width as float32, $scene->height as float32),
            $dpi,
            $this->uiScale
        );
        $fn($ui);
        $ui->endFrame();
        $ui->pass($pipeline, $scene);
    }

    private function finishFrame(
        Pipeline $scenePipe,
        Frame $frame,
        TextureRef $color,
        float32 $compensation,
        function<void()>? $afterPresent,
    ) : void
    {
        visu::profile::begin('render');
        float64 $t0 = visu::runtime::seconds();
        status<PipelineError> $exec = $scenePipe->execute($this->frameIndex, $compensation, collect: false);
        visu::profile::end();
        guard $exec else {
            $this->instruments->noteRender((visu::runtime::seconds() - $t0) * 1000000000.0);
            $this->finishPresent($frame, $exec, $afterPresent, false);
            return;
        }

        RenderTarget $windowRt = $this->window->renderTarget();
        Pipeline $presentPipe = Pipeline($this->pool, $frame, $windowRt);
        BackbufferData $back = $frame->get<BackbufferData>();
        Texture $sceneColor = guard $this->pool->getTexture($color) else ($e) {
            $this->instruments->noteRender((visu::runtime::seconds() - $t0) * 1000000000.0);
            $this->finishPresent($frame, .error(.pool($e)), $afterPresent, false);
            return;
        }
        TextureRef $src = $presentPipe->importTexture($color->name, $sceneColor);
        $presentPipe->add(ClearPass($back->target, ClearPassOptions()));
        $this->blit->pass($presentPipe, $back->target, $src);
        Sample $sample = $this->instruments->sample();
        Overlay? $maybeOverlay = $this->overlay;

        if ($maybeOverlay != null) {
            Overlay $overlay = guard $maybeOverlay;
            $overlay->pass($presentPipe, $back->target, $sample);
        }

        DebugConsole? $maybeConsole = $this->console;

        if ($maybeConsole != null) {
            DebugConsole $console = guard $maybeConsole;
            $console->attachPass($presentPipe, $back->target);
        }

        visu::profile::begin('present');
        status<PipelineError> $presentExec = $presentPipe->execute($this->frameIndex, $compensation);
        $this->instruments->noteRender((visu::runtime::seconds() - $t0) * 1000000000.0);
        $this->finishPresent($frame, $presentExec, $afterPresent, true);
    }

    private function finishPresent(
        Frame $frame,
        status<PipelineError> $exec,
        function<void()>? $afterPresent,
        bool $presentOpen,
    ) : void
    {
        if (!$presentOpen) {
            visu::profile::begin('present');
        }

        bool $presented = $this->present();
        visu::profile::end();
        $this->publishProfiles();
        guard $exec else ($e) {
            if (!$this->fail->failed()) {
                $this->fail = .pipeline($e);
            }

            return;
        }

        if (!$presented) {
            return;
        }

        $this->input->endFrame();
        $this->frameIndex = $this->frameIndex + 1;
        // dumps before the app closure: a scene switch there may destroy what was drawn
        $this->dumps->afterPresent($frame, $this->pool, $this->window, $this->frameIndex - 1, $this->tickIndex);

        function<void()> $after = guard $afterPresent else {
            return;
        }
        $after();
    }

    /**
     * Fold the device's resolved GPU spans in and hand every completed frame to the instruments and dumps.
     */
    private function publishProfiles() : void
    {
        Profiler $prof = profiler();
        $prof->mergeGpu();
        FrameProfile? $done = $prof->complete();

        while ($done != null) {
            FrameProfile $f = guard $done;
            $this->instruments->noteProfile($f, $prof->stats);
            $this->dumps->noteProfile($f, $prof->stats);
            $done = $prof->complete();
        }
    }

    private function advanceDCapture() : void
    {
        DCapture $dcapture = guard $this->script else {
            return;
        }
        $dcapture->advance($this->frameIndex, $this->tickIndex, $this->console);
    }

    private function publishCameraOverride(Frame $frame) : void
    {
        DCapture $dcapture = guard $this->script else {
            return;
        }
        CameraOverrideData $override = guard $dcapture->cameraOverride() else {
            return;
        }
        $frame->set($override);
    }

    private function present() : bool
    {
        guard $this->window->swap() else ($e) {
            match ($e) {
                DeviceError::surfaceLost => {
                    $this->window->setShouldClose(true);
                    return false;
                },
                else => {
                    $this->fail = .pipeline(.device($e));
                    return false;
                },
            }
        }

        return true;
    }

    /**
     * Headless still loads FlyUI when `$config->ui` is set: dcapture dumps the scene
     * target the UI pass composites onto, so font files must be present.
     */
    private function bootUi() : void
    {
        if (!$this->config->ui) {
            return;
        }

        Ui $ui = Ui($this->device, $this->input);
        Paths $paths = $this->services->get<Paths>();
        string $dir = visu::ui::resolveFontDir($paths->resourcesFont);
        guard $ui->load($dir) else ($e) {
            $ui->destroy();
            $this->fail = .ui($e);
            return;
        }
        $this->ui = $ui;
    }

    private function bootOverlay() : void
    {
        if (!$this->config->instrumentOverlay || $this->config->headless) {
            return;
        }

        Overlay $overlay = Overlay($this->device);
        guard $overlay->load() else ($e) {
            info("instrument overlay: {$e->message()}");
            $overlay->destroy();
            return;
        }
        $overlay->listen($this->dispatcher);
        $this->overlay = $overlay;
    }

    private function bootConsole() : void
    {
        if (!$this->config->debugConsole) {
            return;
        }

        DebugConsole $console = DebugConsole($this->dispatcher, $this->input);
        if (!$this->config->headless) {
            loadConsoleOverlay($console, $this->device);
        }

        FlagConsole $flagVerbs = FlagConsole();
        $flagVerbs->registerConsoleCommands($console->registry);
        DCaptureConsole $verbs = DCaptureConsole($this->dumps, $this->script);
        $verbs->registerConsoleCommands($console->registry);
        ProfileConsole $profileVerbs = ProfileConsole(profiler(), $this->dumps);
        $profileVerbs->registerConsoleCommands($console->registry);
        Overlay? $maybeOverlay = $this->overlay;
        if ($maybeOverlay != null) {
            Overlay $hud = guard $maybeOverlay;
            OverlayConsole $metrics = OverlayConsole($hud);
            $metrics->registerConsoleCommands($console->registry);
        }

        $this->console = $console;
    }

    private function scanShaders() : status<HostError>
    {
        string $dir = $this->shaders->loader->directory;
        bool $here = guard io::exists($dir) else ($e) {
            return .error(.shader(.scan($dir, $e->message())));
        }

        if (!$here) {
            return .ok;
        }

        guard $this->shaders->scan() else ($e) {
            return .error(.shader($e));
        }

        return .ok;
    }

    private function mountAssets() : status<HostError>
    {
        $this->assets->register(KIND_BYTES, function(Assets $a, Blob $b) : result<Blob, AssetError> {
            return decodeBytes($a, $b);
        });
        $this->assets->register(KIND_SOUND, function(Assets $a, Blob $b) : result<AudioClip, AssetError> {
            return decodeSound($a, $b);
        });
        $this->assets->register(KIND_TEXTURE, function(Assets $a, Blob $b) : result<Texture, AssetError> {
            return decodeGpuTexture($a, $b);
        });
        $this->assets->register(KIND_VMAT, function(Assets $a, Blob $b) : result<Vmat, AssetError> {
            return decodeVmat($a, $b);
        });
        $this->assets->register(KIND_ASSEMBLY, function(Assets $a, Blob $b) : result<Assembly, AssetError> {
            return decodeAssembly($a, $b);
        });
        $this->assets->register(KIND_MODEL, function(Assets $a, Blob $b) : result<Model, AssetError> {
            return decodeModel($a, $b);
        });
        Paths? $paths = $this->services->find<Paths>();
        Paths $p = guard $paths else {
            return .ok;
        }

        guard $this->mountPackDir($p->resourcesPack) else ($e) {
            return .error($e);
        }
        guard $this->mountCookedDir($p->cache) else ($e) {
            return .error($e);
        }
        return .ok;
    }

    private function mountPackDir(const string& $dir) : status<HostError>
    {
        bool $here = guard io::exists($dir) else ($e) {
            return .error(.asset(.io($dir, $e->message())));
        }
        if (!$here) {
            return .ok;
        }

        io::dir $d = guard io::opendir($dir) else ($e) {
            return .error(.asset(.io($dir, $e->message())));
        }

        foreach ($d as $entry) {
            if ($entry->is_directory()) {
                continue;
            }

            if (!$entry->name()->ends('.vpack')) {
                continue;
            }

            PackStore $pack = guard PackStore::open($entry->path()) else ($e) {
                return .error(.asset($e));
            }
            guard $this->assets->mount($pack) else ($e) {
                return .error(.asset($e));
            }
        }

        return .ok;
    }

    private function mountCookedDir(const string& $cache) : status<HostError>
    {
        string $ds = env::DS;
        string $dir = "{$cache}{$ds}asset";
        string $cat = "{$dir}{$ds}catalog.vcat";
        bool $here = guard io::exists($cat) else ($e) {
            return .error(.asset(.io($cat, $e->message())));
        }
        if (!$here) {
            return .ok;
        }

        DirectoryStore $store = guard DirectoryStore::open($dir) else ($e) {
            return .error(.asset($e));
        }
        guard $this->assets->mount($store) else ($e) {
            return .error(.asset($e));
        }
        return .ok;
    }
}

internal function loadConsoleOverlay(DebugConsole $console, Device $device) : void
{
    guard $console->load($device) else ($e) {
        info("debug console overlay: {$e->message()}");
        return;
    }
}

internal function hostHints(HostConfig $config) : WindowHints
{
    WindowHints $hints = WindowHints::defaults();
    if ($config->headless) {
        $hints->visible = false;
        $hints->resizable = false;
        $hints->focusOnShow = false;
        $hints->cocoaRetinaFramebuffer = false;
        $hints->scaleToMonitor = false;
    } else {
        $hints->focusOnShow = true;
        $hints->resizable = true;
    }

    return $hints;
}

internal function hostShaderDir(Services $services) : string
{
    Paths $paths = guard $services->find<Paths>() else {
        return env::cwd();
    }
    return $paths->resourcesShader;
}
