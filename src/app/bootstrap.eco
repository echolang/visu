/**
 * Build the process Services: app definitions first, then framework defaults so the app can occupy a slot.
 * Device is never stored here.
 * This is the process edge: `--dcapture` / `--flag` are read from argv here, and a script that does
 * not parse ends the process with exit code 2 and the reason on the logger.
 */

namespace visu::app;

use std::env;
use visu::dcapture::{DCapture, DCaptureError};

public function bootstrap(Paths $paths, function<void(Services)> $define) : Services
{
    $s = Services();
    $s->set($paths);
    $define($s);
    defaults($s);
    announceVersion();
    installDCapture($s, programArguments());
    return $s;
}

/**
 * The program's arguments, or just the program name when nothing else was passed.
 * `env::argv()` is only touched when there is a tail to read: with a lone program name the
 * owned copy faults under `echoc test`, and there is nothing to parse anyway.
 */
internal function programArguments() : array<string>
{
    if (env::argc() > 1) {
        return env::argv();
    }

    array<string> $lone = array<string>();
    $lone[] = '';
    return $lone;
}

/**
 * Parse `--dcapture` onto Services and apply `--flag`. A bad script or flag is a user error
 * at the process edge: log it and exit 2 so the agent that launched the run sees a clear failure.
 * DumpQueue is left unset when there is no script; Host once()s a default.
 */
public function installDCapture(Services $s, const array<string>& $argv) : void
{
    result<DCapture?, DCaptureError> $parsed = DCapture::fromArgs($argv);
    if ($parsed->failed()) {
        DCaptureError $e = $parsed->failure();
        error("dcapture: {$e->message()}");
        env::exit(2);
        return;
    }

    DCapture? $maybe = $parsed->unwrap();
    if ($maybe != null) {
        DCapture $dcapture = guard $maybe;
        $dcapture->applyFlags(flags());
        $s->set($dcapture->dumps);
        $s->set($dcapture);
    }

    guard applyArgvFlags(flags(), $argv) else ($e) {
        error("flag: {$e->message()}");
        env::exit(2);
        return;
    }
}

/**
 * Framework fill-if-absent.
 * App once()/set()/create() that ran first wins.
 */
public function defaults(Services $s) : void
{
    $s->once(function(Services $s) : Flags {
        return Flags();
    });
    installFlags($s->get<Flags>());
    $s->once(function(Services $s) : Logger {
        Logger $log = Logger();
        $log->attach(StdoutConduit());
        return $log;
    });
    installLogger($s->get<Logger>());
}
