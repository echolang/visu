/**
 * Build the process Services: app definitions first, then framework
 * defaults so the app can occupy a slot. Gpu is never stored here.
 */

namespace visu::app;

public function bootstrap(Paths $paths, function<void(Services)> $define) : Services
{
    $s = Services();
    $s->set($paths);
    $define($s);
    defaults($s);
    return $s;
}

/**
 * Framework fill-if-absent. App once()/set()/create() that ran first wins.
 */
public function defaults(Services $s) : void
{
    $s->once(function(Services $s) : Logger {
        Logger $log = Logger();
        $log->attach(StdoutConduit());
        return $log;
    });
    installLogger($s->get<Logger>());
}
